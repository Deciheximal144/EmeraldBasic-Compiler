  DIM unsignedFormatLiteralIdx AS LONG
  DIM floatFormatLiteralIdx AS LONG
  DIM exponentFormatLiteralIdx AS LONG
  DIM sprintfFuncIdx AS LONG
  DIM printStrFuncIdx AS LONG

  tira_Start
  tiraRT_PrologueId

  ff = resolveSymbol("IAT_SPRINTF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  sprintfFuncIdx = returnedData2

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrFuncIdx = returnedData2

  argFormatIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId argFormatIdx, 1

  argStatePtrIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId argStatePtrIdx, 2

  argKindIdx = tiraDimVarId&("ARG3", TYPE_LONG)
  tiraAbiReadArgId argKindIdx, 3

  argIntegerIdx = tiraDimVarId&("ARG4", TYPE_INTEGER64)
  tiraAbiReadArgId argIntegerIdx, 4

  argNumberIdx = tiraDimVarId&("ARG5", TYPE_DOUBLE)
  tiraAbiReadArgId argNumberIdx, 5

  argStringIdx = tiraDimVarId&("ARG6", TYPE_INTEGER64)
  tiraAbiReadArgId argStringIdx, 6

  formatDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFormatIdx)
  formatLengthIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFormatIdx)

  startPositionIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId startPositionIdx, TIRA_ARG_SYMBOL, argStatePtrIdx

  scanPositionIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId scanPositionIdx, TIRA_ARG_SYMBOL, startPositionIdx

  itemDoneIdx = tiraDimVarId&("T", TYPE_LONG)
