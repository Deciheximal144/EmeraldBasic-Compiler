END FUNCTION ' parse_DESKTOPWIDTH$

''''''''''''''''''''''''
FUNCTION parse_DEST (startIdx)

  DIM endIdx AS LONG
  DIM pageVar$
  DIM lblDest0$
  DIM lblDest1$
  DIM lblDest2$
  DIM lblDest3$
  DIM lblDestEnd$

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_DEST REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED PAGE NUMBER AFTER _DEST", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  pageVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "PAGE MUST BE NUMERIC")
  IF pageVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  lblDest0$ = tiraLabelCreateNew$("DEST_0")
  lblDest1$ = tiraLabelCreateNew$("DEST_1")
  lblDest2$ = tiraLabelCreateNew$("DEST_2")
  lblDest3$ = tiraLabelCreateNew$("DEST_3")
  lblDestEnd$ = tiraLabelCreateNew$("DEST_END")

  tiraJmpCond "JE", pageVar$, "0", lblDest0$
  tiraJmpCond "JE", pageVar$, "1", lblDest1$
  tiraJmpCond "JE", pageVar$, "2", lblDest2$
  tiraJmpCond "JE", pageVar$, "3", lblDest3$
  tiraJmp lblDestEnd$

  tiraLabel lblDest0$
  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraJmp lblDestEnd$

  tiraLabel lblDest1$
  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE1"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE1"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE1", ""
  tiraJmp lblDestEnd$

  tiraLabel lblDest2$
  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE2"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE2", ""
  tiraJmp lblDestEnd$

  tiraLabel lblDest3$
  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE3"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE3", ""

  tiraLabel lblDestEnd$
  tiraAssign "!G_GFX_VAL_DEST_PAGE", pageVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_DEST = 1

END FUNCTION ' parse_DEST

''''''''''''''''''''''''
FUNCTION parse_DEST_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DEST", ASIS, 0
    parse_DEST_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("DEST", "_VAL")
  IF scratchName$ = "" THEN
    parse_DEST_FUNC$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "!G_GFX_VAL_DEST_PAGE"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEST_FUNC$ = scratchName$

END FUNCTION ' parse_DEST_FUNC$

''''''''''''''''''''''''
FUNCTION parse_ELSEIF (startIdx)

  DIM endIdx AS LONG
  DIM hasThen AS LONG
  DIM thenIdx AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG
  DIM new_ifID AS LONG
  DIM exprVar$
  DIM ff AS LONG
  DIM falseLbl$
  DIM endLbl$
  DIM trueLbl$
  DIM newFalseLbl$

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "ELSEIF WITHOUT IF", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).Type <> CTRL_IF THEN
    throwCompilerError "ELSEIF WITHOUT IF", ASIS, 0
    EXIT FUNCTION
  END IF

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  IF hasThen = 0 THEN
    throwCompilerError "MISSING THEN", ASIS, 0
    EXIT FUNCTION
  END IF

  ifID_end = ctrls(ctrlCount - 1).Patch1
  ifID_false = ctrls(ctrlCount - 1).Patch2

  falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
  endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

  new_ifID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  ' Keep user-side IF-chain labels below the generated-ID range reserved for runtime helpers.
  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_ELSEIF = 0
    EXIT FUNCTION
  END IF

  trueLbl$ = "@IF_TRUE_" + LTRIM$(RTRIM$(STR$(new_ifID)))
  newFalseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(new_ifID)))

  tira_Start

  ' Jump to end of IF block because the previous block just finished executing successfully
  tiraScheduleHeapReset
  tiraJmp endLbl$

  ' The previous IF/ELSEIF conditions will skip to right here if they evaluated to false
  tiraLabel falseLbl$

  tira_EndAndProcess

  ' Hoist intrinsics strictly AFTER control flow labels are anchored
  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  ' Re-evaluate token boundaries in case intrinsic hoisting collapsed tokens on the line
  endIdx = lineTokenCount - 1

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  tira_Start

  exprVar$ = tiraParseExpressionNumeric$(startIdx + 1, thenIdx - 1, ALIM, "TYPE MISMATCH IN CONDITION")
  IF exprVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraJmpCond "JNE", exprVar$, "0", trueLbl$
  tiraScheduleHeapReset
  tiraJmp newFalseLbl$

  tiraLabel trueLbl$
  tiraScheduleHeapReset

  tira_EndAndProcess

  ff = verifyNoExtraTokens(endIdx, thenIdx, "THEN")
  IF ff = 0 THEN EXIT FUNCTION

  ' Update the active false block ID to link with subsequent ELSEIF chains
  ctrls(ctrlCount - 1).Patch2 = new_ifID

  parse_ELSEIF = 1

END FUNCTION ' parse_ELSEIF

''''''''''''''''''''''''
FUNCTION parse_EOF$ (startIdx, endIdx, allowImplicit)

  ' Checks if the end of an open file has been reached

  DIM fileNumStart AS LONG
  DIM fileNumVar$
  DIM scratchName$
  DIM baseArr$
  DIM slotAddr$
  DIM handleVar$
  DIM resVar$
  DIM sizeVar$
  DIM posVar$
  DIM lblEof$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "EOF", 3) = 0 THEN
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  fileNumStart = startIdx + 2

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    END IF
  END IF

  fileNumVar$ = tiraParseExpressionInt$(fileNumStart, endIdx - 1, allowImplicit, "FILENUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("EOF", "_VAL")
  IF scratchName$ = "" THEN
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  ' Request the overall file size cleanly from the Windows API
  tiraCall "IAT_GETFILESIZE", 2, handleVar$ + ", 0"
  sizeVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, sizeVar$

  ' Set file pointer with a movement delta of 0 and FILE_CURRENT (1) to retrieve the actual OS position
  tiraCall "IAT_SETFILEPOINTER", 4, handleVar$ + ", 0, 0, 1"
  posVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, posVar$

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  lblEof$ = tiraLabelCreateNew$("EOF_TRUE")
  lblEnd$ = tiraLabelCreateNew$("EOF_END")

  ' Check if the current pointer position is equal to or exceeds the overall file size
  tiraJmpCond "JGE", posVar$, sizeVar$, lblEof$
  tiraJmp lblEnd$

  tiraLabel lblEof$
  tiraAssign resVar$, "-1"

  tiraLabel lblEnd$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_EOF$ = scratchName$

END FUNCTION ' parse_EOF$

''''''''''''''''''''''''
FUNCTION parse_EXIT (startIdx)

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM isCtrlFound AS LONG
  DIM foundCtrlIdx AS LONG
  DIM endIdx AS LONG
  DIM tok2 AS LONG
  DIM cIdx AS LONG
  DIM selID AS LONG
  DIM loopID AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED SUB OR FUNCTION", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "EXIT")
  IF ff = 0 THEN EXIT FUNCTION

  tok2 = lineTokenVals(startIdx + 1)

  SELECT CASE tok2

    CASE TOK_SUB, TOK_FUNCTION
      IF tok2 = TOK_SUB AND insideSub <> 1 THEN
        throwCompilerError "EXIT SUB OUTSIDE SUB", ASIS, 0
        EXIT FUNCTION
      END IF
      IF tok2 = TOK_FUNCTION AND insideSub <> 2 THEN
        throwCompilerError "EXIT FUNCTION OUTSIDE FUNCTION", ASIS, 0
        EXIT FUNCTION
      END IF

      ' Route control flow to the subroutine epilogue via a forward jump
      ' This jump targets the end routine label defined and placed by parse_END
      ' This ensures early exits execute unified garbage collection and stack restoration

      ff = findSubIndex(currentSubName$)
      IF ff = 1 THEN
        subIdx = returnedData2
        IF subIdx > 0 THEN
          tira_Start
          tiraScheduleHeapReset
          tiraJmp "@END_ROUTINE_" + currentSubName$
          tira_EndAndProcess
        END IF
      END IF

    CASE TOK_CASE, TOK_SELECT
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).Type = CTRL_SELECT THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT CASE OUTSIDE SELECT", ASIS, 0
        EXIT FUNCTION
      END IF

      selID = ctrls(foundCtrlIdx).Patch1

      tira_Start
      tiraScheduleHeapReset
      tiraJmp "@SEL_END_" + LTRIM$(RTRIM$(STR$(selID)))
      tira_EndAndProcess

    CASE TOK_DO
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).Type = CTRL_DO THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT DO OUTSIDE DO LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      ' Native TIRA integration completely negates the need to walk raw machine code patches
      tira_Start
      tiraScheduleHeapReset
      tiraJmp "@DO_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))
      tira_EndAndProcess

    CASE TOK_FOR
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).Type = CTRL_FOR THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT FOR OUTSIDE FOR LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      ' Native TIRA integration handles the forward jump via the symbol table
      tira_Start
      tiraScheduleHeapReset
      tiraJmp "@FOR_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))
      tira_EndAndProcess

    CASE TOK_WHILE
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).Type = CTRL_WHILE THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT WHILE OUTSIDE WHILE LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      tira_Start
      tiraScheduleHeapReset
      tiraJmp "@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))
      tira_EndAndProcess

    CASE ELSE
      throwCompilerError "UNRECOGNIZED EXIT", ASIS, 0
      EXIT FUNCTION

  END SELECT ' tok2

  parse_EXIT = 1

END FUNCTION ' parse_EXIT

''''''''''''''''''''''''
FUNCTION parse_FILEEXISTS$ (startIdx, endIdx, allowImplicit)

' Checks if a specific file exists on the disk

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM strDataPtr$
  DIM attrVal$
  DIM isDir$
  DIM skipDirLbl$
  DIM jmpDoneLbl$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_FILEEXISTS", 3) = 0 THEN
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_FILEEXISTS REQUIRES STRING ARGUMENT", ASIS, 0
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("FEXISTS", "_VAL")
  IF scratchName$ = "" THEN
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  strDataPtr$ = tiraGetStringData$(arg1$)

  tiraCall "IAT_GETFILEATTRIBUTESA", 1, strDataPtr$
  attrVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, attrVal$

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  skipDirLbl$ = tiraLabelCreateNew$("FEXISTS_SKIP")
  jmpDoneLbl$ = tiraLabelCreateNew$("FEXISTS_DONE")

  ' If returned -1 (INVALID_FILE_ATTRIBUTES), file does not exist
  tiraJmpCond "JE", attrVal$, "-1", jmpDoneLbl$

  ' Check if it is a directory (FILE_ATTRIBUTE_DIRECTORY = 16)
  isDir$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, isDir$, attrVal$, "16"
  tiraJmpCond "JNE", isDir$, "0", skipDirLbl$

  ' File exists and is not a directory
  tiraAssign resVar$, "-1"
  tiraJmp jmpDoneLbl$

  tiraLabel skipDirLbl$

  tiraLabel jmpDoneLbl$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FILEEXISTS$ = scratchName$

END FUNCTION ' parse_FILEEXISTS$

''''''''''''''''''''''''
FUNCTION parse_FIX$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM floatArg$
  DIM floatTrunc$
  DIM negativeLbl$
  DIM doneLbl$

  IF checkIntrinsicSyntax(startIdx, endIdx, "FIX", 3) = 0 THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("FIX", "_VAL")
  IF scratchName$ = "" THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, arg1$

  floatArg$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign floatArg$, arg1$

  floatTrunc$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign floatTrunc$, resVar$

  negativeLbl$ = tiraLabelCreateNew$("FIX_NEGATIVE")
  doneLbl$ = tiraLabelCreateNew$("FIX_DONE")

  ' Correct round-to-nearest conversion so FIX truncates toward zero
  tiraJmpCond "JL", floatArg$, "0", negativeLbl$
  tiraJmpCond "JGE", floatArg$, floatTrunc$, doneLbl$
  tiraOp TC_SUB, resVar$, resVar$, "1"
  tiraJmp doneLbl$

  tiraLabel negativeLbl$
  tiraJmpCond "JLE", floatArg$, floatTrunc$, doneLbl$
  tiraOp TC_ADD, resVar$, resVar$, "1"

  tiraLabel doneLbl$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FIX$ = scratchName$

END FUNCTION ' parse_FIX$

''''''''''''''''''''''''
FUNCTION parse_FONT (startIdx)

  DIM endIdx AS LONG
  DIM fontValue AS DOUBLE
  DIM fontFirst AS STRING * 1
  DIM fontIsNumeric AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx <> startIdx + 1 THEN
    throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 0 THEN
    throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  fontToken$ = lineTokens$(startIdx + 1)
  fontFirst = LEFT$(fontToken$, 1)
  fontIsNumeric = 0

  IF fontFirst >= "0" AND fontFirst <= "9" THEN fontIsNumeric = 1
  IF fontFirst = "-" OR fontFirst = "." THEN fontIsNumeric = 1
  IF fontFirst = "&" THEN
    IF UCASE$(MID$(fontToken$, 2, 1)) = "H" OR UCASE$(MID$(fontToken$, 2, 1)) = "O" THEN
      fontIsNumeric = 1
    END IF
  END IF

  IF fontIsNumeric = 0 THEN
    IF (fontFirst >= "A" AND fontFirst <= "Z") OR (fontFirst >= "a" AND fontFirst <= "z") OR fontFirst = "_" OR fontFirst = "!" THEN
      throwCompilerError "_FONT DOES NOT ACCEPT VARIABLES", ASIS, 0
    ELSE
      throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    END IF
    EXIT FUNCTION
  END IF

  fontValue = VAL(fontToken$)

  IF fontValue <> 8 AND fontValue <> 14 AND fontValue <> 16 THEN
    throwCompilerError "_FONT ONLY SUPPORTS 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FONT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  tiraAssign "!G_GFX_V32_FONTHEIGHT", LTRIM$(RTRIM$(STR$(fontValue)))

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_FONT = 1

END FUNCTION ' parse_FONT

''''''''''''''''''''''''
FUNCTION parse_FREEFILE$ (startIdx, endIdx, allowImplicit)

' Returns the next available open file number from the operating system

  DIM scratchName$
  DIM idxVar$
  DIM baseArr$
  DIM loopTop$
  DIM loopDone$
  DIM slotAddr$
  DIM handleVar$
  DIM skipLimitLbl$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED FREEFILE", ASIS, 0
    parse_FREEFILE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("FREEFILE", "_VAL")
  IF scratchName$ = "" THEN
    parse_FREEFILE$ = ""
    EXIT FUNCTION
  END IF

  idxVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign idxVar$, "1"

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  loopTop$ = tiraLabelCreateNew$("FF_TOP")
  loopDone$ = tiraLabelCreateNew$("FF_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JG", idxVar$, "255", loopDone$

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, idxVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  ' If the handle is 0, this slot is completely unused
  tiraJmpCond "JE", handleVar$, "0", loopDone$

  tiraOp TC_ADD, idxVar$, idxVar$, "1"
  tiraJmp loopTop$

  tiraLabel loopDone$

  ' Gracefully zero out the return variable if we exceeded 255 (no free files available)
  skipLimitLbl$ = tiraLabelCreateNew$("FF_LIMIT")
  tiraJmpCond "JLE", idxVar$, "255", skipLimitLbl$
  tiraAssign idxVar$, "0"
  tiraLabel skipLimitLbl$

  tiraAssign scratchName$, idxVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FREEFILE$ = scratchName$

END FUNCTION ' parse_FREEFILE$

''''''''''''''''''''''''
FUNCTION parse_FREEIMAGE (startIdx)

  DIM endIdx AS LONG
  DIM handleVar$
  DIM lblCheck2$
  DIM lblCheck3$
  DIM lblError$
  DIM lblDone$
  DIM fbClearSize$
  DIM lblSkipDest$
  DIM lblSkipSrc$
  DIM endFreeLbl$

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FREEIMAGE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF endIdx >= startIdx + 1 THEN
    handleVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "HANDLE MUST BE NUMERIC")
    IF handleVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  ELSE
    handleVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign handleVar$, "!G_GFX_VAL_DEST_PAGE"
  END IF

  lblCheck2$ = tiraLabelCreateNew$("FREE_CHK2")
  lblCheck3$ = tiraLabelCreateNew$("FREE_CHK3")
  lblError$ = tiraLabelCreateNew$("FREE_ERR")
  lblDone$ = tiraLabelCreateNew$("FREE_DONE")
  endFreeLbl$ = tiraLabelCreateNew$("FREE_END")

  tiraJmpCond "JE", handleVar$, "2", lblCheck2$
  tiraJmpCond "JE", handleVar$, "3", lblCheck3$
  tiraJmp lblError$

  tiraLabel lblCheck2$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE2", "0"
  fbClearSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign fbClearSize$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY)))
  tiraMemSet "!G_GFX_PTR_FRMB_PAGE2", "0", fbClearSize$
  tiraJmp lblDone$

  tiraLabel lblCheck3$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE3", "0"
  fbClearSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign fbClearSize$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY)))
  tiraMemSet "!G_GFX_PTR_FRMB_PAGE3", "0", fbClearSize$

  tiraLabel lblDone$

  ' Reset DEST to 0 if it was the freed handle
  lblSkipDest$ = tiraLabelCreateNew$("FREE_SKIP_DEST")
  tiraJmpCond "JNE", "!G_GFX_VAL_DEST_PAGE", handleVar$, lblSkipDest$
  tiraAssign "!G_GFX_VAL_DEST_PAGE", "0"
  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraLabel lblSkipDest$

  ' Reset SOURCE to 0 if it was the freed handle
  lblSkipSrc$ = tiraLabelCreateNew$("FREE_SKIP_SRC")
  tiraJmpCond "JNE", "!G_GFX_VAL_SRC_PAGE", handleVar$, lblSkipSrc$
  tiraAssign "!G_GFX_VAL_SRC_PAGE", "0"
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraLabel lblSkipSrc$

  tiraJmp endFreeLbl$

  tiraLabel lblError$
  tiraFatalError "ILLEGAL FUNCTION CALL IN _FREEIMAGE"

  tiraLabel endFreeLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_FREEIMAGE = 1

END FUNCTION ' parse_FREEIMAGE

''''''''''''''''''''''''
FUNCTION parse_FULLSCREEN (startIdx)

  DIM endIdx AS LONG
  DIM fullscreenMode$
  DIM optionName$

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FULLSCREEN REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  fullscreenMode$ = "1"

  IF endIdx > startIdx THEN
    optionName$ = UCASE$(lineTokens$(startIdx + 1))

    IF optionName$ = "OFF" THEN
      fullscreenMode$ = "0"
    END IF
  END IF

  ' _STRETCH, _SQUAREPIXELS and _SMOOTH currently use the standard fullscreen path
  tira_Start

  tiraCall "RT_FULLSCREEN", 1, fullscreenMode$
  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_FULLSCREEN = 1

END FUNCTION ' parse_FULLSCREEN

''''''''''''''''''''''''
FUNCTION parse_GDOUBLE (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GDOUBLE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx > startIdx THEN
    throwCompilerError "GDOUBLE DOES NOT TAKE ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  tiraCall "RT_GDOUBLE", 0, ""
  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_GDOUBLE = 1

END FUNCTION ' parse_GDOUBLE

''''''''''''''''''''''''
FUNCTION parse_GOTO (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "GOTO NEEDS LABEL", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "GOTO")
  IF ff = 0 THEN EXIT FUNCTION

  targetTok$ = lineTokens$(startIdx + 1)
  targetLabelName$ = "%" + UCASE$(targetTok$)

  expectedSymType = TYPE_LABEL
  ff = resolveSymbol(targetLabelName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  tira_Start

  tiraScheduleHeapReset
  tiraJmpUser targetLabelName$

  tira_EndAndProcess

  parse_GOTO = 1

END FUNCTION ' parse_GOTO

''''''''''''''''''''''''
FUNCTION parse_HEIGHT$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM resHeight AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED _HEIGHT", ASIS, 0
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED _HEIGHT", ASIS, 0
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("HEIGHT", "_VAL")
  IF scratchName$ = "" THEN
    parse_HEIGHT$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resHeight = 25
  IF cm.HasGraphics = 1 THEN resHeight = gfxConfig.SizeY

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, LTRIM$(STR$(resHeight))

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_HEIGHT$ = scratchName$

END FUNCTION ' parse_HEIGHT$

''''''''''''''''''''''''
FUNCTION parse_INP$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "INP", 3) = 0 THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerErrorAndCancelTira "INP REQUIRES #GRAPHICS", ASIS, 0
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "PORT MUST BE NUMERIC")
  IF arg1$ = "" THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("INP", "_VAL")
  IF scratchName$ = "" THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraCall "RT_INP", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INP$ = scratchName$

END FUNCTION ' parse_INP$

''''''''''''''''''''''''
FUNCTION parse_INSTR$ (startIdx, endIdx, allowImplicit)

  ' Returns the position of the first occurrence of a substring within a string

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM argStart$
  DIM argStr1$
  DIM argStr2$
  DIM scratchName$
  DIM resVar$
  DIM str1Len$
  DIM str1Data$
  DIM str2Len$
  DIM str2Data$
  DIM safeStart$
  DIM idx$
  DIM maxIdx$
  DIM subIdx$
  DIM addr1$
  DIM char1$
  DIM addr2$
  DIM char2$
  DIM lblEmptyStr2$
  DIM lblStartCheck$
  DIM lblLoopTop$
  DIM lblLoopDone$
  DIM lblMatchFound$
  DIM lblSubTop$
  DIM lblSubDone$
  DIM lblSubFail$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "INSTR", 4) = 0 THEN
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "INSTR REQUIRES 2 OR 3 ARGUMENTS", ASIS, 0
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  IF comma2 > 0 THEN
    argStart$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "INSTR START MUST BE NUMERIC")
    IF argStart$ = "" THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF

    argStr1$ = tiraParseExpression$(comma1 + 1, comma2 - 1, allowImplicit)
    IF argStr1$ = "" THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 2 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF

    argStr2$ = tiraParseExpression$(comma2 + 1, endIdx - 1, allowImplicit)
    IF argStr2$ = "" THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 3 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    argStart$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign argStart$, "1"

    argStr1$ = tiraParseExpression$(startIdx + 2, comma1 - 1, allowImplicit)
    IF argStr1$ = "" THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 1 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF

    argStr2$ = tiraParseExpression$(comma1 + 1, endIdx - 1, allowImplicit)
    IF argStr2$ = "" THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 2 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("INSTR", "_VAL")
  IF scratchName$ = "" THEN
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  str1Len$ = tiraGetStringLen$(argStr1$)
  str1Data$ = tiraGetStringData$(argStr1$)

  str2Len$ = tiraGetStringLen$(argStr2$)
  str2Data$ = tiraGetStringData$(argStr2$)

  safeStart$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign safeStart$, argStart$
  tiraClamp safeStart$, "1", ""

  idx$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, idx$, safeStart$, "1"

  maxIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, maxIdx$, str1Len$, str2Len$

  lblEnd$ = tiraLabelCreateNew$("INSTR_END")

  lblEmptyStr2$ = tiraLabelCreateNew$("INSTR_MT2")
  tiraJmpCond "JG", str2Len$, "0", lblEmptyStr2$

  lblStartCheck$ = tiraLabelCreateNew$("INSTR_CHKSTART")
  tiraJmpCond "JLE", safeStart$, str1Len$, lblStartCheck$
  tiraAssign resVar$, "0"
  tiraJmp lblEnd$
  tiraLabel lblStartCheck$
  tiraAssign resVar$, safeStart$
  tiraJmp lblEnd$

  tiraLabel lblEmptyStr2$

  lblLoopTop$ = tiraLabelCreateNew$("INSTR_TOP")
  lblLoopDone$ = tiraLabelCreateNew$("INSTR_DONE")
  lblMatchFound$ = tiraLabelCreateNew$("INSTR_MATCH")

  tiraLabel lblLoopTop$
  tiraJmpCond "JG", idx$, maxIdx$, lblLoopDone$

  subIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign subIdx$, "0"

  lblSubTop$ = tiraLabelCreateNew$("INSTR_SUBTOP")
  lblSubDone$ = tiraLabelCreateNew$("INSTR_SUBDONE")
  lblSubFail$ = tiraLabelCreateNew$("INSTR_SUBFAIL")

  tiraLabel lblSubTop$
  tiraJmpCond "JGE", subIdx$, str2Len$, lblSubDone$

  addr1$ = tiraDimVar$("T", TYPE_INTEGER64)
  char1$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraOp TC_ADD, addr1$, str1Data$, idx$
  tiraOp TC_ADD, addr1$, addr1$, subIdx$
  tiraNew TC_READ_MEM, char1$ + ", " + addr1$

  addr2$ = tiraDimVar$("T", TYPE_INTEGER64)
  char2$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraOp TC_ADD, addr2$, str2Data$, subIdx$
  tiraNew TC_READ_MEM, char2$ + ", " + addr2$

  tiraJmpCond "JNE", char1$, char2$, lblSubFail$

  tiraOp TC_ADD, subIdx$, subIdx$, "1"
  tiraJmp lblSubTop$

  tiraLabel lblSubDone$
  tiraJmp lblMatchFound$

  tiraLabel lblSubFail$
  tiraOp TC_ADD, idx$, idx$, "1"
  tiraJmp lblLoopTop$

  tiraLabel lblMatchFound$
  tiraOp TC_ADD, resVar$, idx$, "1"

  tiraLabel lblLoopDone$
  tiraLabel lblEnd$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INSTR$ = scratchName$

END FUNCTION ' parse_INSTR$

''''''''''''''''''''''''
FUNCTION parse_KEY (startIdx)

  ' Enables, disables, or suspends a numbered ON KEY event trap

  DIM endIdx AS LONG
  DIM closeParen AS LONG
  DIM modeVal AS _UNSIGNED LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 4 THEN
    throwCompilerError "MALFORMED KEY STATEMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_OP_LPAREN THEN
    throwCompilerError "KEY REQUIRES (n)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(startIdx + 1, endIdx)
  IF ff = 0 THEN
    throwCompilerError "KEY MISSING )", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParen = returnedData2

  IF closeParen <= startIdx + 2 THEN
    throwCompilerError "KEY REQUIRES EVENT NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  IF closeParen >= endIdx THEN
    throwCompilerError "KEY EXPECTS ON, OFF, OR STOP", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, closeParen + 1, "KEY")
  IF ff = 0 THEN EXIT FUNCTION

  modeName$ = UCASE$(retTokenText$(lineTokens$(closeParen + 1)))
  modeVal = KEY_EVENT_MODE_OFF

  SELECT CASE modeName$

    CASE "ON"
      modeVal = KEY_EVENT_MODE_ON

    CASE "OFF"
      modeVal = KEY_EVENT_MODE_OFF

    CASE "STOP"
      modeVal = KEY_EVENT_MODE_STOP

    CASE ELSE
      throwCompilerError "KEY EXPECTS ON, OFF, OR STOP", ASIS, 0
      EXIT FUNCTION

  END SELECT ' modeName$

  ensureKeyEventSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  rtIsUsed(RT_KEY_EVENT) = 1

  tira_Start

  eventNumber$ = tiraParseExpressionInt$(startIdx + 2, closeParen - 1, ALIM, "KEY EVENT NUMBER MUST BE NUMERIC")
  IF eventNumber$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  invalidKeyLbl$ = tiraLabelCreateNew$("KEY_NUMBER_INVALID")
  validKeyLbl$ = tiraLabelCreateNew$("KEY_NUMBER_VALID")

  tiraJmpCond "JL", eventNumber$, "1", invalidKeyLbl$
  tiraJmpCond "JLE", eventNumber$, LTRIM$(STR$(KEY_EVENT_COUNT)), validKeyLbl$

  tiraLabel invalidKeyLbl$
  tiraFatalError "ILLEGAL FUNCTION CALL"

  tiraLabel validKeyLbl$

  eventIndex$ = tiraDimVar$("T", TYPE_UINT64)
  tiraAssign eventIndex$, eventNumber$
  tiraOp TC_SUB, eventIndex$, eventIndex$, "1"

  stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateBase$, "!G_INO_ARR_KEYSTATE", ""

  stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB stateSlot$, stateBase$, eventIndex$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))

  IF modeVal = KEY_EVENT_MODE_OFF THEN
    tiraWriteMem stateSlot$, "0", LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
  ELSE
    stateValue$ = tiraDimVar$("T", TYPE_UINT64)
    tiraNew TC_READ_MEM, stateValue$ + ", " + stateSlot$
    tiraOp TC_AND, stateValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_STATE_MASK))
    tiraOp TC_OR, stateValue$, stateValue$, LTRIM$(STR$(modeVal))
    tiraWriteMem stateSlot$, stateValue$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
    tiraAssign "!G_INO_FLG_KEYANY", "1"
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_KEY = 1

END FUNCTION ' parse_KEY

''''''''''''''''''''''''
FUNCTION parse_KEYCLEAR (startIdx)

  DIM endIdx AS LONG
  DIM tailPtr$
  DIM headPtr$
  DIM headVal$

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "_KEYCLEAR")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  IF cm.HasGraphics = 1 THEN
    tailPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, tailPtr$, "!G_INO_VAL_KBD_TAIL", ""

    headPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, headPtr$, "!G_INO_VAL_KBD_HEAD", ""

    headVal$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, headVal$ + ", " + headPtr$

    tiraWriteMem tailPtr$, headVal$, "4"
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_KEYCLEAR = 1

END FUNCTION ' parse_KEYCLEAR

''''''''''''''''''''''''
FUNCTION parse_KILL (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED FILENAME AFTER KILL", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  fileNameVar$ = tiraParseExpression$(startIdx + 1, endIdx, ALIM)
  IF fileNameVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  strDataPtr$ = tiraGetStringData$(fileNameVar$)

  tiraCall "IAT_DELETEFILEA", 1, strDataPtr$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_KILL = 1

END FUNCTION ' parse_KILL

''''''''''''''''''''''''
FUNCTION parse_LIMIT (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "_LIMIT REQUIRES NUMERIC ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  argVar$ = tiraParseExpressionNumeric$(startIdx + 1, endIdx, ALIM, "_LIMIT REQUIRES NUMERIC ARGUMENT")
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)

  IF exprIs.DataType <> TYPE_DOUBLE THEN
    tiraOp TC_CAST, argFloat$, argVar$, LTRIM$(STR$(TYPE_DOUBLE))
  ELSE
    tiraAssign argFloat$, argVar$
  END IF

  tiraCall "RT_LIMIT", 1, argFloat$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_LIMIT = 1

END FUNCTION ' parse_LIMIT

''''''''''''''''''''''''
FUNCTION parse_LEFT$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM srcPtr$
  DIM strLen$
  DIM safeLen$
  DIM dataPtr$
  DIM descPtr$
  DIM comma1 AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LEFT$", 5) = 0 THEN
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "LEFT$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, comma1 - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LEFT$ ARG 1 MUST BE STRING", ASIS, 0
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "LEFT$ ARG 2 MUST BE NUMERIC")
  IF arg2$ = "" THEN
    tira_Cancel
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("LEFT", "_DSC")
  IF scratchName$ = "" THEN
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  srcPtr$ = tiraGetStringData$(arg1$)
  strLen$ = tiraGetStringLen$(arg1$)

  safeLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign safeLen$, arg2$
  tiraClamp safeLen$, "0", strLen$

  tiraAssign strLen$, safeLen$

  dataPtr$ = tiraAllocTempMem$(strLen$)

  tiraMemcpy dataPtr$, srcPtr$, strLen$

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, strLen$, "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LEFT$ = scratchName$

END FUNCTION ' parse_LEFT$

''''''''''''''''''''''''
FUNCTION parse_LOF$ (startIdx, endIdx, allowImplicit)

' Returns the total length of an open file in bytes

  DIM fileNumStart AS LONG
  DIM fileNumVar$
  DIM scratchName$
  DIM baseArr$
  DIM slotAddr$
  DIM handleVar$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "LOF", 3) = 0 THEN
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF

  ensureFileWriteBufferSymbols

  tira_Start

  fileNumStart = startIdx + 2

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    END IF
  END IF

  fileNumVar$ = tiraParseExpressionInt$(fileNumStart, endIdx - 1, allowImplicit, "FILENUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("LOF", "_VAL")
  IF scratchName$ = "" THEN
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  ' Flush buffered PUT data so LOF observes the current file size
  tiraFlushFileWriteBuffer

  tiraCall "IAT_GETFILESIZE", 2, handleVar$ + ", 0"
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LOF$ = scratchName$

END FUNCTION ' parse_LOF$

''''''''''''''''''''''''
FUNCTION parse_MEMFILL (startIdx)

  ' Fills a validated portion of a _MEM block with a converted numeric value

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM asIdx AS LONG
  DIM valueEndIdx AS LONG
  DIM typeEndIdx AS LONG
  DIM memUdtIndex AS LONG
  DIM fillType AS LONG
  DIM valueType AS LONG
  DIM fillTypeSize AS LONG
  DIM trailingByte AS LONG
  DIM memDescAddr$
  DIM memBlockOffset$
  DIM memBlockSize$
  DIM fillOffset$
  DIM fillBytes$
  DIM fillValue$
  DIM convertedValue$
  DIM rawValue$
  DIM valueAddr$
  DIM blockDelta$
  DIM blockRemaining$
  DIM fullValueCount$
  DIM fullValueBytes$
  DIM trailingBytes$
  DIM trailingAddr$
  DIM wideRawValue$
  DIM trailingValue$
  DIM trailingSkipLbl$
  DIM validDeltaLbl$
  DIM validLengthLbl$
  DIM valueName$
  DIM valueTokenIdx AS LONG
  DIM valueCloseParen AS LONG
  DIM valueSymbolIdx AS LONG
  DIM valueIsName AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma3 = findComma(comma2 + 1, endIdx)
  IF comma3 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma4 = findComma(comma3 + 1, endIdx)
  IF comma4 > 0 THEN
    throwCompilerError "_MEMFILL ACCEPTS FOUR ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 <= startIdx + 1 OR comma2 <= comma1 + 1 OR comma3 <= comma2 + 1 OR comma3 >= endIdx THEN
    throwCompilerError "_MEMFILL HAS A MISSING ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  asIdx = 0
  ff = findNextTokenAtDepth0(comma3 + 1, endIdx, TOK_AS)
  IF ff = 1 THEN asIdx = returnedData2

  valueEndIdx = endIdx
  fillType = TYPE_UNDEFINED

  IF asIdx > 0 THEN
    IF asIdx <= comma3 + 1 OR asIdx >= endIdx THEN
      throwCompilerError "_MEMFILL REQUIRES A VALUE AND TYPE AROUND AS", ASIS, 0
      EXIT FUNCTION
    END IF

    valueEndIdx = asIdx - 1
    typeEndIdx = parseTypeClause(asIdx + 1, endIdx, 0)
    fillType = returnedData2

    IF fillType = TYPE_UNDEFINED OR compileError = 1 THEN EXIT FUNCTION

    IF typeEndIdx <> endIdx + 1 THEN
      throwCompilerError "UNEXPECTED TOKENS AFTER _MEMFILL TYPE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF fillType = TYPE_STRING OR fillType = TYPE_UDT OR fillType = TYPE_ANY THEN
      throwCompilerError "_MEMFILL TYPE MUST BE NUMERIC", ASIS, 0
      EXIT FUNCTION
    END IF
  ELSE
    ' QB64 requires an untyped fill value to be a named scalar or array element
    valueIsName = 0
    valueTokenIdx = comma3 + 1

    IF lineTokenVals(valueTokenIdx) = 0 THEN
      valueName$ = UCASE$(lineTokens$(valueTokenIdx))
      ff = findSymbol(valueName$)

      IF ff = 1 THEN
        valueSymbolIdx = returnedData2

        IF symbols(valueSymbolIdx).SubIndex = 0 THEN
          valueTokenIdx = valueTokenIdx + 1

          IF symbols(valueSymbolIdx).IsArray = 0 THEN
            valueIsName = 1
          ELSE
            IF valueTokenIdx <= valueEndIdx THEN
              IF lineTokenVals(valueTokenIdx) = 256 + ASC("(") THEN
                ff = findMatchingParen(valueTokenIdx, valueEndIdx)
                IF ff = 1 THEN
                  valueCloseParen = returnedData2
                  IF valueCloseParen > valueTokenIdx + 1 THEN
                    valueTokenIdx = valueCloseParen + 1
                    valueIsName = 1
                  END IF
                END IF
              END IF
            END IF
          END IF

          IF valueIsName = 1 THEN
            DO WHILE valueTokenIdx <= valueEndIdx
              IF lineTokenVals(valueTokenIdx) = 256 + ASC(".") THEN
                IF valueTokenIdx + 1 <= valueEndIdx THEN
                  valueTokenIdx = valueTokenIdx + 2
                ELSE
                  valueIsName = 0
                  EXIT DO
                END IF
              ELSE
                valueIsName = 0
                EXIT DO
              END IF
            LOOP
          END IF
        END IF
      END IF
    END IF

    IF valueIsName = 0 THEN
      throwCompilerError "EXPECTED NAME/ARRAY ELEMENT", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  ff = findUdtIndex("_MEM")
  IF ff = 0 THEN
    throwCompilerError "INTERNAL _MEM TYPE NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF
  memUdtIndex = returnedData2

  tira_Start

  memDescAddr$ = tiraParseRhsUdtBase$(startIdx + 1, comma1 - 1, memUdtIndex)
  IF memDescAddr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  fillOffset$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, ALIM, "_MEMFILL OFFSET MUST BE NUMERIC")
  IF fillOffset$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  fillBytes$ = tiraParseExpressionInt$(comma2 + 1, comma3 - 1, ALIM, "_MEMFILL BYTE COUNT MUST BE NUMERIC")
  IF fillBytes$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  fillValue$ = tiraParseExpression$(comma3 + 1, valueEndIdx, ALIM)
  IF fillValue$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valueType = exprIs.DataType

  IF valueType = TYPE_STRING OR valueType = TYPE_UDT OR valueType = TYPE_ANY THEN
    throwCompilerErrorAndCancelTira "_MEMFILL VALUE MUST BE NUMERIC", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fillType = TYPE_UNDEFINED THEN fillType = valueType

  fillTypeSize = 0

  SELECT CASE fillType

    CASE TYPE_BYTE, TYPE_UBYTE
      fillTypeSize = 1

    CASE TYPE_INTEGER, TYPE_UINTEGER
      fillTypeSize = 2

    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE
      fillTypeSize = 4

    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE
      fillTypeSize = 8

  END SELECT ' fillType

  IF fillTypeSize = 0 THEN
    throwCompilerErrorAndCancelTira "UNSUPPORTED _MEMFILL TYPE", ASIS, 0
    EXIT FUNCTION
  END IF

  convertedValue$ = tiraDimVar$("T", fillType)
  tiraOp TC_CAST, convertedValue$, fillValue$, LTRIM$(STR$(fillType))
  rawValue$ = convertedValue$

  IF fillType = TYPE_SINGLE OR fillType = TYPE_DOUBLE THEN
    valueAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, valueAddr$, convertedValue$, ""

    IF fillType = TYPE_SINGLE THEN
      rawValue$ = tiraDimVar$("T", TYPE_ULONG)
    ELSE
      rawValue$ = tiraDimVar$("T", TYPE_UINT64)
    END IF

    tiraNew TC_READ_MEM, rawValue$ + ", " + valueAddr$
  END IF

  memBlockOffset$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, memBlockOffset$ + ", " + memDescAddr$

  memBlockSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM_OFFSET, memBlockSize$ + ", " + memDescAddr$ + ", 8"

  validDeltaLbl$ = tiraLabelCreateNew$("MEMFILL_DELTA_VALID")
  tiraJmpCond "JGE", fillOffset$, memBlockOffset$, validDeltaLbl$
  tiraFatalError "_MEMFILL OFFSET OUTSIDE MEMORY BLOCK"
  tiraLabel validDeltaLbl$

  blockDelta$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_SUB, blockDelta$, fillOffset$, memBlockOffset$

  validLengthLbl$ = tiraLabelCreateNew$("MEMFILL_LENGTH_VALID")
  tiraJmpCond "JGE", memBlockSize$, "0", validLengthLbl$
  tiraFatalError "INVALID _MEM BLOCK SIZE"
  tiraLabel validLengthLbl$

  blockRemaining$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_SUB, blockRemaining$, memBlockSize$, blockDelta$

  validLengthLbl$ = tiraLabelCreateNew$("MEMFILL_RANGE_VALID")
  tiraJmpCond "JGE", blockRemaining$, "0", validLengthLbl$
  tiraFatalError "_MEMFILL OFFSET OUTSIDE MEMORY BLOCK"
  tiraLabel validLengthLbl$

  validLengthLbl$ = tiraLabelCreateNew$("MEMFILL_BYTES_NONNEGATIVE")
  tiraJmpCond "JGE", fillBytes$, "0", validLengthLbl$
  tiraFatalError "_MEMFILL BYTE COUNT CANNOT BE NEGATIVE"
  tiraLabel validLengthLbl$

  validLengthLbl$ = tiraLabelCreateNew$("MEMFILL_BYTES_VALID")
  tiraJmpCond "JLE", fillBytes$, blockRemaining$, validLengthLbl$
  tiraFatalError "_MEMFILL RANGE EXCEEDS MEMORY BLOCK"
  tiraLabel validLengthLbl$

  IF fillTypeSize = 1 THEN
    tiraMemSet fillOffset$, rawValue$, fillBytes$
  ELSE
    fullValueCount$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_IDIV, fullValueCount$, fillBytes$, LTRIM$(STR$(fillTypeSize))

    trailingBytes$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_MOD, trailingBytes$, fillBytes$, LTRIM$(STR$(fillTypeSize))

    tiraMemSetEx fillOffset$, rawValue$, fullValueCount$, LTRIM$(STR$(fillTypeSize))

    fullValueBytes$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_MUL, fullValueBytes$, fullValueCount$, LTRIM$(STR$(fillTypeSize))

    trailingAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, trailingAddr$, fillOffset$, fullValueBytes$

    wideRawValue$ = tiraDimVar$("T", TYPE_UINT64)
    tiraAssign wideRawValue$, rawValue$

    FOR trailingByte = 0 TO fillTypeSize - 2
      trailingSkipLbl$ = tiraLabelCreateNew$("MEMFILL_TRAILING_SKIP")
      tiraJmpCond "JLE", trailingBytes$, LTRIM$(STR$(trailingByte)), trailingSkipLbl$

      trailingValue$ = tiraDimVar$("T", TYPE_UINT64)
      tiraAssign trailingValue$, wideRawValue$
      IF trailingByte > 0 THEN tiraOp TC_SHR, trailingValue$, trailingValue$, LTRIM$(STR$(trailingByte * 8))
      tiraOp TC_AND, trailingValue$, trailingValue$, "255"
      tiraNew TC_WRITE_MEM_OFFSET, trailingAddr$ + ", " + LTRIM$(STR$(trailingByte)) + ", " + trailingValue$ + ", 1"

      tiraLabel trailingSkipLbl$
    NEXT
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_MEMFILL = 1

END FUNCTION ' parse_MEMFILL

''''''''''''''''''''''''
FUNCTION parse_MEMFREE (startIdx)

  ' Invalidates a non-owning _MEM descriptor without freeing its referenced storage

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM memUdtIndex AS LONG
  DIM memDescAddr$

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "_MEMFREE REQUIRES A MEMORY BLOCK", ASIS, 0
    EXIT FUNCTION
  END IF

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx > 0 THEN
    throwCompilerError "_MEMFREE ACCEPTS ONE MEMORY BLOCK", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findUdtIndex("_MEM")
  IF ff = 0 THEN
    throwCompilerError "INTERNAL _MEM TYPE NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF
  memUdtIndex = returnedData2

  tira_Start

  memDescAddr$ = tiraParseRhsUdtBase$(startIdx + 1, endIdx, memUdtIndex)
  IF memDescAddr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraMemSet memDescAddr$, "0", LTRIM$(STR$(udts(memUdtIndex).TotalSize))

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_MEMFREE = 1

END FUNCTION ' parse_MEMFREE

''''''''''''''''''''''''
FUNCTION parse_MKD$ (startIdx, endIdx, allowImplicit)

' Converts a double-precision number into an 8-byte string representation

  DIM arg1$
  DIM scratchName$
  DIM dataPtr$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKD$", 3) = 0 THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("MKD", "_DSC")
  IF scratchName$ = "" THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF

  dataPtr$ = tiraAllocTempMem$("8")

  ' Have the TIRA backend natively coerce the numeric expression into a 64-bit hardware DOUBLE precision value and save it to the allocated heap string block
  tiraWriteMem dataPtr$, arg1$, "DOUBLE"

  ' Build the string descriptor pointing to our 8-byte temporary string
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, "8", "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKD$ = scratchName$

END FUNCTION ' parse_MKD$

''''''''''''''''''''''''
FUNCTION parse_MKI$ (startIdx, endIdx, allowImplicit)

' Converts an integer into a 2-byte string representation

  DIM arg1$
  DIM scratchName$
  DIM dataPtr$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKI$", 3) = 0 THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("MKI", "_DSC")
  IF scratchName$ = "" THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF

  dataPtr$ = tiraAllocTempMem$("2")

  ' Write the 2-byte integer payload to the heap natively
  tiraWriteMem dataPtr$, arg1$, "2"

  ' Build the String Descriptor directly on the Scratchpad memory
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  ' Ensure Flags are set to 0 (No Free Required on Temp Heap)
  tiraBuildStrDesc descPtr$, dataPtr$, "2", "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKI$ = scratchName$

END FUNCTION ' parse_MKI$

''''''''''''''''''''''''
FUNCTION parse_MKL$ (startIdx, endIdx, allowImplicit)

' Converts a long integer into a 4-byte string representation

  DIM arg1$
  DIM scratchName$
  DIM dataPtr$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKL$", 3) = 0 THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("MKL", "_DSC")
  IF scratchName$ = "" THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF

  dataPtr$ = tiraAllocTempMem$("4")

  ' Have the TIRA backend natively coerce the numeric expression into a 32-bit hardware LONG integer value and save it to the allocated heap string block
  tiraWriteMem dataPtr$, arg1$, "4"

  ' Build the string descriptor pointing to our 4-byte temporary string
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, "4", "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKL$ = scratchName$

END FUNCTION ' parse_MKL$

''''''''''''''''''''''''
FUNCTION parse_MKS$ (startIdx, endIdx, allowImplicit)

' Converts a single-precision number into a 4-byte string representation

  DIM arg1$
  DIM scratchName$
  DIM dataPtr$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKS$", 3) = 0 THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("MKS", "_DSC")
  IF scratchName$ = "" THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF

  dataPtr$ = tiraAllocTempMem$("4")

  ' Have the TIRA backend natively coerce the numeric expression into a 32-bit hardware SINGLE precision value and save it to the allocated heap string block
  tiraWriteMem dataPtr$, arg1$, "SINGLE"

  ' Build the string descriptor pointing to our 4-byte temporary string
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, "4", "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
