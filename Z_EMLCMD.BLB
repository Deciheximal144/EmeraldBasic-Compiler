END SUB ' emitRuntimePrintUsing

''''''''''''''''''''''''
SUB emitRuntimeRead

  DIM targetAddrIdx AS LONG
  DIM isStrVarIdx AS LONG
  DIM tgtDataTypeIdx AS LONG
  DIM dataIndexIdx AS LONG
  DIM dataCountIdx AS LONG
  DIM skipErrLblIdx AS LONG
  DIM errStrIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM endProgramIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM dataListIdx AS LONG
  DIM descPtrAddrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM notStrLblIdx AS LONG
  DIM actualDescPtrIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM endReadLblIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM bufLenIdx AS LONG
  DIM resVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipLoopIdx AS LONG
  DIM skipDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpcLblIdx AS LONG
  DIM signDoneIdx AS LONG
  DIM numLoopTopIdx AS LONG
  DIM numLoopDoneIdx AS LONG
  DIM applySignDoneIdx AS LONG
  DIM lblSingleIdx AS LONG
  DIM lblDoubleIdx AS LONG
  DIM lblByteIdx AS LONG
  DIM lblIntIdx AS LONG
  DIM lblLongIdx AS LONG
  DIM lblWriteDoneIdx AS LONG

  rtOffset(RT_READ) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAbiReadArgId targetAddrIdx, 1

  isStrVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId isStrVarIdx, 2

  tgtDataTypeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId tgtDataTypeIdx, 3

  ff = resolveSymbol("!G_SYS_VAL_DATAINDEX")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  dataIndexIdx = returnedData2

  ff = resolveSymbol("!G_SYS_VAL_DATA_COUNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  dataCountIdx = returnedData2

  skipErrLblIdx = tiraLabelCreateNewId&("READ_SKIP_ERR")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, dataIndexIdx, TIRA_ARG_SYMBOL, dataCountIdx, skipErrLblIdx

  ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  errStrIdx = returnedData2
  strVarData$(errStrIdx) = "OUT OF DATA ERROR ON READ"

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errStrIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId skipErrLblIdx

  ff = resolveSymbol("!G_SYS_ARR_DATA_LIST")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  dataListIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, dataListIdx

  descPtrAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, descPtrAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, dataIndexIdx, TIRA_ARG_LITERAL, 8

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, descPtrAddrIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataIndexIdx, TIRA_ARG_SYMBOL, dataIndexIdx, TIRA_ARG_LITERAL, 1

  notStrLblIdx = tiraLabelCreateNewId&("READ_NOT_STR")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isStrVarIdx, TIRA_ARG_LITERAL, 0, notStrLblIdx

  ' Dereference the pointer slot to obtain the actual descriptor address
  actualDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId actualDescPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx

  ' Allocate a descriptor if the slot is still null
  tiraEnsureStringAllocId actualDescPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx

  ff = resolveSymbol("RT_STR_ASSIGN")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  strAssignIdx = returnedData2
  tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, actualDescPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx

  endReadLblIdx = tiraLabelCreateNewId&("READ_END")
  tiraJmpId endReadLblIdx

  tiraLabelId notStrLblIdx

  bufPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
  bufLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipLoopIdx = tiraLabelCreateNewId&("READ_NSKIP")
  skipDoneIdx = tiraLabelCreateNewId&("READ_NSKIP_DN")

  tiraLabelId skipLoopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, skipDoneIdx
  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx

  isSpcLblIdx = tiraLabelCreateNewId&("READ_ISSPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpcLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 13, isSpcLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 10, isSpcLblIdx
  tiraJmpId skipDoneIdx

  tiraLabelId isSpcLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipLoopIdx

  tiraLabelId skipDoneIdx

  signDoneIdx = tiraLabelCreateNewId&("READ_SGN_DONE")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, signDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, signDoneIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId signDoneIdx

  numLoopTopIdx = tiraLabelCreateNewId&("READ_NUM_LOOP")
  numLoopDoneIdx = tiraLabelCreateNewId&("READ_NUM_DONE")

  tiraLabelId numLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, numLoopDoneIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId numLoopDoneIdx

  applySignDoneIdx = tiraLabelCreateNewId&("READ_SGN_APP")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, applySignDoneIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId applySignDoneIdx

  lblSingleIdx = tiraLabelCreateNewId&("READ_IS_SNG")
  lblDoubleIdx = tiraLabelCreateNewId&("READ_IS_DBL")
  lblByteIdx = tiraLabelCreateNewId&("READ_IS_BYT")
  lblIntIdx = tiraLabelCreateNewId&("READ_IS_INT")
  lblLongIdx = tiraLabelCreateNewId&("READ_IS_LNG")
  lblWriteDoneIdx = tiraLabelCreateNewId&("READ_WR_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_SINGLE, lblSingleIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE, lblDoubleIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_BYTE, lblByteIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_UBYTE, lblByteIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_INTEGER, lblIntIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_UINTEGER, lblIntIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_LONG, lblLongIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeIdx, TIRA_ARG_LITERAL, TYPE_ULONG, lblLongIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 8
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblSingleIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_STR_LITERAL, 32
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblDoubleIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_STR_LITERAL, 64
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblByteIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblIntIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblLongIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 4

  tiraLabelId lblWriteDoneIdx

  tiraLabelId endReadLblIdx

  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeRead

''''''''''''''''''''''''
SUB emitRuntimeSwapBuffers

  DIM renderLockIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM spinLblIdx AS LONG
  DIM acquiredLblIdx AS LONG
  DIM spinValIdx AS LONG
  DIM frameSizeIdx AS LONG
  DIM textSizeIdx AS LONG
  DIM pagingFlagIdx AS LONG
  DIM frameFrontIdx AS LONG
  DIM frameDisplayIdx AS LONG
  DIM bufferFrontIdx AS LONG
  DIM bufferDisplayIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM bufferCountFrontIdx AS LONG
  DIM bufferCountBackIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM bufferCountPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM bufferCountPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM bufferCountPage3Idx AS LONG
  DIM pagingLblIdx AS LONG
  DIM visual0LblIdx AS LONG
  DIM visual1LblIdx AS LONG
  DIM visual2LblIdx AS LONG
  DIM visual3LblIdx AS LONG
  DIM presentationReadyLblIdx AS LONG
  DIM destPageIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM destBufferIdx AS LONG
  DIM destCountIdx AS LONG
  DIM dest0LblIdx AS LONG
  DIM dest1LblIdx AS LONG
  DIM dest2LblIdx AS LONG
  DIM dest3LblIdx AS LONG
  DIM destEndLblIdx AS LONG
  DIM srcPageIdx AS LONG
  DIM srcFrameIdx AS LONG
  DIM srcBufferIdx AS LONG
  DIM srcCountIdx AS LONG
  DIM src0LblIdx AS LONG
  DIM src1LblIdx AS LONG
  DIM src2LblIdx AS LONG
  DIM src3LblIdx AS LONG
  DIM srcEndLblIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM invalidateRectIdx AS LONG
  DIM updateWindowIdx AS LONG

  rtOffset(RT_SWAP_BUFFERS) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
  renderLockIdx = returnedData2

  ff = resolveSymbol("IAT_SLEEP")
  sleepFuncIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  pagingFlagIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
  frameFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_DISPLAY")
  frameDisplayIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
  bufferFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_DISPLAY")
  bufferDisplayIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  frameBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  bufferBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
  bufferCountFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  bufferCountBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
  visualPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  framePage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
  bufferPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
  bufferCountPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  framePage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
  bufferPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  bufferCountPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  framePage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
  bufferPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  bufferCountPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  destPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
  destBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
  destCountIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
  srcPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
  srcFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
  srcBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
  srcCountIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  windowHandleIdx = returnedData2

  ff = resolveSymbol("IAT_INVALIDATERECT")
  invalidateRectIdx = returnedData2

  ff = resolveSymbol("IAT_UPDATEWINDOW")
  updateWindowIdx = returnedData2

  ' Acquire Spinlock safely using hardware XCHG
  spinLblIdx = tiraLabelCreateNewId&("SWAP_SPIN")
  acquiredLblIdx = tiraLabelCreateNewId&("SWAP_ACQ")
  tiraLabelId spinLblIdx
  spinValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId spinValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_XCHG, TIRA_ARG_SYMBOL, renderLockIdx, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 0, acquiredLblIdx
  tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId spinLblIdx
  tiraLabelId acquiredLblIdx

  ' Swap Pointers
  ' Stable logical pages replace pointer exchange during presentation
  frameSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId frameSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  textSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId textSizeIdx, TIRA_ARG_LITERAL, GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize

  pagingLblIdx = tiraLabelCreateNewId&("SWAP_PAGING")
  visual0LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_0")
  visual1LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_1")
  visual2LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_2")
  visual3LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_3")
  presentationReadyLblIdx = tiraLabelCreateNewId&("SWAP_PRESENT_READY")

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, pagingFlagIdx, TIRA_ARG_LITERAL, 0, pagingLblIdx

  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameDisplayIdx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferDisplayIdx

  tiraMemcpyId TIRA_ARG_SYMBOL, frameDisplayIdx, TIRA_ARG_SYMBOL, frameBackIdx, TIRA_ARG_SYMBOL, frameSizeIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, bufferDisplayIdx, TIRA_ARG_SYMBOL, bufferBackIdx, TIRA_ARG_SYMBOL, textSizeIdx

  ' Synchronize snapshot counts
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId presentationReadyLblIdx

  tiraLabelId pagingLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 0, visual0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 1, visual1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 2, visual2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 3, visual3LblIdx
  tiraJmpId visual0LblIdx

  tiraLabelId visual0LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual1LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual2LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual3LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId presentationReadyLblIdx

  ' Reconnect the selected _DEST page after the front and back pointers move
  ' Stable page pointers keep these mappings valid for both presentation paths
  dest0LblIdx = tiraLabelCreateNewId&("SWAP_DEST_0")
  dest1LblIdx = tiraLabelCreateNewId&("SWAP_DEST_1")
  dest2LblIdx = tiraLabelCreateNewId&("SWAP_DEST_2")
  dest3LblIdx = tiraLabelCreateNewId&("SWAP_DEST_3")
  destEndLblIdx = tiraLabelCreateNewId&("SWAP_DEST_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 0, dest0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 1, dest1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 2, dest2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 3, dest3LblIdx
  tiraJmpId destEndLblIdx

  tiraLabelId dest0LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId destEndLblIdx

  tiraLabelId dest1LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId destEndLblIdx

  tiraLabelId dest2LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId destEndLblIdx

  tiraLabelId dest3LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId destEndLblIdx

  ' Reconnect the selected _SOURCE page after the front and back pointers move
  ' Stable page pointers keep POINT and GET attached to the selected source page
  src0LblIdx = tiraLabelCreateNewId&("SWAP_SRC_0")
  src1LblIdx = tiraLabelCreateNewId&("SWAP_SRC_1")
  src2LblIdx = tiraLabelCreateNewId&("SWAP_SRC_2")
  src3LblIdx = tiraLabelCreateNewId&("SWAP_SRC_3")
  srcEndLblIdx = tiraLabelCreateNewId&("SWAP_SRC_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 0, src0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 1, src1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 2, src2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 3, src3LblIdx
  tiraJmpId srcEndLblIdx

  tiraLabelId src0LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId srcEndLblIdx

  tiraLabelId src1LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId srcEndLblIdx

  tiraLabelId src2LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId srcEndLblIdx

  tiraLabelId src3LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId srcEndLblIdx

  ' Release Spinlock
  tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0

  ' Instruct Windows to repaint the window using the newly swapped Front buffer
  ' FRONT now identifies either the completed snapshot or the selected visual page
  tiraCallId3 invalidateRectIdx, TIRA_ARG_SYMBOL, windowHandleIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  ' Complete the pending paint before Page 1 can modify the Front buffer
  ' The selected visual page remains unchanged throughout the completed paint
  tiraCallId1 updateWindowIdx, TIRA_ARG_SYMBOL, windowHandleIdx

  ' Copy the new Front Buffer memory into the new Back Buffer memory to preserve
  ' persistence so the user thread continues drawing on top of existing graphics
  ' Stable logical buffers already retain this state without a restoration copy

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeSwapBuffers

''''''''''''''''''''''''
SUB emitRuntimeVehHandler

  DIM arg1VarIdx AS LONG
  DIM curThreadIdx AS LONG
  DIM getCurrentThreadIdx AS LONG
  DIM wrongThreadLblIdx AS LONG
  DIM userThreadIdx AS LONG
  DIM excPtrIdx AS LONG
  DIM excRecPtrIdx AS LONG
  DIM excCodeIdx AS LONG
  DIM matchDivZeroLblIdx AS LONG
  DIM matchAccessLblIdx AS LONG
  DIM matchStackLblIdx AS LONG
  DIM prepareRestoreLblIdx AS LONG
  DIM endLblIdx AS LONG
  DIM targetRipIdx AS LONG
  DIM nativeDivZeroIdx AS LONG
  DIM nativeBoundsIdx AS LONG
  DIM nativeMemAccessIdx AS LONG
  DIM nativeStackIdx AS LONG
  DIM userHandlerIdx AS LONG
  DIM hasHandlerLblIdx AS LONG
  DIM ctxPtrAddrIdx AS LONG
  DIM ctxPtrIdx AS LONG
  DIM rspPtrIdx AS LONG
  DIM safeRspIdx AS LONG
  DIM rbpPtrIdx AS LONG
  DIM ripPtrIdx AS LONG
  DIM crashRipIdx AS LONG
  DIM lastErrorPtrIdx AS LONG

  '''' RT_VEH_HANDLER
  rtOffset(RT_VEH_HANDLER) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  ff = resolveSymbol("IAT_GETCURRENTTHREADID")
  getCurrentThreadIdx = returnedData2
  tiraCallId0 getCurrentThreadIdx
  curThreadIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId curThreadIdx

  wrongThreadLblIdx = tiraLabelCreateNewId&("VEH_WRONG_THREAD")
  ff = resolveSymbol("!G_SYS_VAL_USER_THREAD_ID")
  userThreadIdx = returnedData2
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, curThreadIdx, TIRA_ARG_SYMBOL, userThreadIdx, wrongThreadLblIdx

  excPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId excPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  ' Read ExceptionRecord pointer (offset 0)
  excRecPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId excRecPtrIdx, TIRA_ARG_SYMBOL, excPtrIdx

  ' Read ExceptionCode from the ExceptionRecord structure
  excCodeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId excCodeIdx, TIRA_ARG_SYMBOL, excRecPtrIdx

  matchDivZeroLblIdx = tiraLabelCreateNewId&("VEH_MATCH_DZ")
  matchAccessLblIdx = tiraLabelCreateNewId&("VEH_MATCH_AV")
  matchStackLblIdx = tiraLabelCreateNewId&("VEH_MATCH_SO")
  prepareRestoreLblIdx = tiraLabelCreateNewId&("VEH_PREP_RESTORE")
  endLblIdx = tiraLabelCreateNewId&("VEH_END")

  targetRipIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ' Check for integer divide by zero (0xC0000094 -> -1073741676)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741676, matchDivZeroLblIdx

  ' Check for float divide by zero (0xC000008E -> -1073741682)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741682, matchDivZeroLblIdx

  ' Check for Access Violation (0xC0000005 -> -1073741819)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741819, matchAccessLblIdx

  ' Check for Stack Overflow (0xC00000FD -> -1073741571)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741571, matchStackLblIdx

  ' Not a recognized exception, gracefully pass it back to Windows returning EXCEPTION_CONTINUE_SEARCH (0) in RAX
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId endLblIdx

  tiraLabelId matchDivZeroLblIdx
  ff = resolveSymbol("@NATIVE_DIV_ZERO_HANDLER")
  nativeDivZeroIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeDivZeroIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId matchAccessLblIdx
  ff = resolveSymbol("@NATIVE_MEM_ACCESS_HANDLER")
  nativeMemAccessIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeMemAccessIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId matchStackLblIdx
  ff = resolveSymbol("@NATIVE_STACK_HANDLER")
  nativeStackIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeStackIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId prepareRestoreLblIdx

  ' Check for user handler override
  ff = resolveSymbol("!G_ERR_PTR_HANDLER")
  userHandlerIdx = returnedData2
  hasHandlerLblIdx = tiraLabelCreateNewId&("VEH_HAS_HDL")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, userHandlerIdx, TIRA_ARG_LITERAL, 0, hasHandlerLblIdx
  tiraAssignId targetRipIdx, TIRA_ARG_SYMBOL, userHandlerIdx
  tiraLabelId hasHandlerLblIdx

  ' Start modifying the CPU CONTEXT struct to safely route execution into our basic program space by reading ContextRecord pointer (offset 8)
  ctxPtrAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ctxPtrAddrIdx, TIRA_ARG_SYMBOL, excPtrIdx, TIRA_ARG_LITERAL, 8

  ctxPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId ctxPtrIdx, TIRA_ARG_SYMBOL, ctxPtrAddrIdx

  ' Navigate to Context.Rsp to reset the dirty execution stack (offset 152)
  rspPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rspPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 152
  ff = resolveSymbol("!G_SYS_PTR_SAFE_RSP")
  safeRspIdx = returnedData2
  tiraWriteMemId TIRA_ARG_SYMBOL, rspPtrIdx, TIRA_ARG_SYMBOL, safeRspIdx, TIRA_ARG_LITERAL, 8

  ' Write it into Context.Rbp to pull the base pointer out of any deep subroutine frames (offset 160)
  rbpPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rbpPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 160
  tiraWriteMemId TIRA_ARG_SYMBOL, rbpPtrIdx, TIRA_ARG_SYMBOL, safeRspIdx, TIRA_ARG_LITERAL, 8

  ' Redirect the instruction pointer (offset 248)
  ripPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ripPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 248

  ' Save the crashing instruction address for the RESUME keyword
  crashRipIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId crashRipIdx, TIRA_ARG_SYMBOL, ripPtrIdx
  ff = resolveSymbol("!G_ERR_PTR_LAST")
  lastErrorPtrIdx = returnedData2
  tiraAssignId lastErrorPtrIdx, TIRA_ARG_SYMBOL, crashRipIdx

  ' Write the target address into Context.Rip
  tiraWriteMemId TIRA_ARG_SYMBOL, ripPtrIdx, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LITERAL, 8

  ' Return EXCEPTION_CONTINUE_EXECUTION (-1) so Windows allows the thread to seamlessly continue
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId endLblIdx

  tiraLabelId wrongThreadLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId endLblIdx

  tiraAbiWriteRetId arg1VarIdx
  tiraRT_EpilogueId

  '''' Append the native error handler to the compiled output space immediately following the VEH handler

  tiraLabelId nativeDivZeroIdx
  tiraFatalErrorId "UNHANDLED DIVISION BY ZERO"

  ff = resolveSymbol("@NATIVE_BOUNDS_HANDLER")
  nativeBoundsIdx = returnedData2
  tiraLabelId nativeBoundsIdx
  tiraFatalErrorId "ARRAY OUT OF BOUNDS"

  tiraLabelId nativeMemAccessIdx
  tiraFatalErrorId "MEMORY ACCESS VIOLATION"

  tiraLabelId nativeStackIdx
  tiraFatalErrorId "STACK CORRUPTION DETECTED"

  tira_EndAndProcess

END SUB ' emitRuntimeVehHandler

''''''''''''''''''''''''
SUB emitRuntimeWheel

  DIM arg1VarIdx AS LONG
  DIM resVarIdx AS LONG

  rtOffset(RT_WHEEL) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1VarIdx, 1

  ' XInput controllers do not expose wheel inputs
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeWheel

''''''''''''''''''''''''
FUNCTION parse_ABS$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM argDataType AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ABS", 3) = 0 THEN
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  argDataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("ABS", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Override the default string/single nature dynamically so the temporary variable perfectly matches the supplied argument's byte size and precision
  symbols(scratchIdx).DataType = argDataType

  resVarIdx = tiraDimVarId&("T", argDataType)

  tiraAssignId resVarIdx, arg1Type, arg1Val

  skipLblIdx = tiraLabelCreateNewId&("SKIP_ABS")

  ' If resVar$ >= 0, skip to the end. Since TC_JMP_COND fully supports floating point checks internally via UCOMI, we can safely run this generically
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId skipLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = argDataType
  exprIs.IsTemp = 1
  parse_ABS$ = scratchName$


END FUNCTION ' parse_ABS$

''''''''''''''''''''''''
FUNCTION parse_ATN$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM singleResIdx AS LONG
  DIM argFloatIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ATN", 3) = 0 THEN
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("ATN", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly override the integer prefix rule to safely route as float
  symbols(scratchIdx).DataType = TYPE_SINGLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, argFloatIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, TYPE_DOUBLE
    arg1Type = TIRA_ARG_SYMBOL
    arg1Val = argFloatIdx
  END IF

  ff = resolveSymbol("IAT_ATAN")
  IF ff = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_ATN$ = scratchName$

END FUNCTION ' parse_ATN$

''''''''''''''''''''''''
FUNCTION parse_AXIS$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_AXIS", 3) = 0 THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("AXIS", "_VAL")
  IF scratchIdx = 0 THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_SINGLE

  ff = resolveSymbol("RT_AXIS")
  IF ff = 0 THEN
    tira_Cancel
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_AXIS$ = scratchName$

END FUNCTION ' parse_AXIS$

''''''''''''''''''''''''
FUNCTION parse_BEEP (startIdx)

  DIM endIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "BEEP")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  ff = resolveSymbol("IAT_BEEP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, TIRA_ARG_LITERAL, 800, TIRA_ARG_LITERAL, 250

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BEEP = 1

END FUNCTION ' parse_BEEP

''''''''''''''''''''''''
FUNCTION parse_BLOAD (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM fileEndIdx AS LONG
  DIM hasOffset AS LONG
  DIM fileVarType AS LONG
  DIM fileVarVal AS _INTEGER64
  DIM offsetVarType AS LONG
  DIM offsetVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "BLOAD REQUIRES FILENAME", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    fileEndIdx = endIdx
    hasOffset = 0
  ELSE
    fileEndIdx = comma1 - 1
    hasOffset = 1
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, fileEndIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileVarType = tiraParsedArgType
  fileVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "BLOAD FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasOffset = 0 THEN
    offsetVarType = TIRA_ARG_LITERAL
    offsetVarVal = 0
  ELSE
    ff = tiraParseExpressionIntId(comma1 + 1, endIdx, ALIM, "OFFSET MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    offsetVarType = tiraParsedArgType
    offsetVarVal = tiraParsedArgVal
  END IF

  ff = resolveSymbol("RT_BLOAD")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId3 callFuncIdx, fileVarType, fileVarVal, offsetVarType, offsetVarVal, TIRA_ARG_LITERAL, hasOffset
  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BLOAD = 1

END FUNCTION ' parse_BLOAD

''''''''''''''''''''''''
FUNCTION parse_BLUE32$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_BLUE32", 3) = 0 THEN
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "_BLUE32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("BLU32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_BLUE32$ = scratchName$

END FUNCTION ' parse_BLUE32$

''''''''''''''''''''''''
FUNCTION parse_BSAVE (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM fileVarType AS LONG
  DIM fileVarVal AS _INTEGER64
  DIM offsetVarType AS LONG
  DIM offsetVarVal AS _INTEGER64
  DIM lenVarType AS LONG
  DIM lenVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "BSAVE REQUIRES FILENAME, OFFSET, LENGTH", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    throwCompilerError "BSAVE REQUIRES FILENAME, OFFSET, LENGTH", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, comma1 - 1, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileVarType = tiraParsedArgType
  fileVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "BSAVE FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, ALIM, "OFFSET MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  offsetVarType = tiraParsedArgType
  offsetVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma2 + 1, endIdx, ALIM, "LENGTH MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  lenVarType = tiraParsedArgType
  lenVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_BSAVE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId3 callFuncIdx, fileVarType, fileVarVal, offsetVarType, offsetVarVal, lenVarType, lenVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BSAVE = 1

END FUNCTION ' parse_BSAVE

''''''''''''''''''''''''
FUNCTION parse_BUTTON$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_BUTTON", 3) = 0 THEN
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("BUTTON", "_VAL")
  IF scratchIdx = 0 THEN
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("RT_BUTTON")
  IF ff = 0 THEN
    tira_Cancel
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
