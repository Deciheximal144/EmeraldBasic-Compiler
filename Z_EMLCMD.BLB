''''''''''''''''''''''''
FUNCTION parse_OFFSET$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM addrVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_OFFSET", 3) = 0 THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Support dot variable syntax gracefully to map cleanly with older structural integrations
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF compileClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN _OFFSET", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2
  targetType = returnedData3

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0
      FOR iField = 0 TO udts(uIdx).FieldCount - 1
        IF RTRIM$(udtFields(uIdx, iField).FieldName) = udtFieldNames$(iDot) THEN
          udtOffset = udtOffset + udtFields(uIdx, iField).Offset
          targetType = udtFields(uIdx, iField).DataType
          tempUdtIndex = udtFields(uIdx, iField).UDTIndex
          tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
          fieldFound = 1
          EXIT FOR
        END IF
      NEXT

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  indicesStr$ = ""
  numParsedIndices = 0
  IF hasIndex = 1 THEN
    indicesStr$ = tiraParseArrayArgs$(parenStartIdx, closeParenIdx, 0)
    IF indicesStr$ = "" AND compileError = 1 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("OFFSET", "_PTR")
  IF scratchName$ = "" THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF hasIndex = 0 AND hasField = 0 THEN
    tiraOp TC_ADDRESS_OF, resVar$, "#" + LTRIM$(STR$(vIdx)), ""
  ELSE
    addrVar$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
    IF addrVar$ = "" THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    tiraAssign resVar$, addrVar$
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_OFFSET$ = scratchName$

END FUNCTION ' parse_OFFSET$


''''''''''''''''''''''''
FUNCTION parse_NEWIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM arg3$
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM resVar$
  DIM isScreenImage AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_NEWIMAGE", 5) = 0 THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_NEWIMAGE REQUIRES AT LEAST 2 ARGUMENTS", ASIS, 0
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
  arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "WIDTH MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg2$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF

    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg3$ = tiraParseExpressionInt$(comma2 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF arg3$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("NEWIMG", "_VAL")
  IF scratchName$ = "" THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  isScreenImage = 0
  IF startIdx > 0 THEN
    IF lineTokenVals(startIdx - 1) = TOK_SCREEN THEN isScreenImage = 1
  END IF

  ' Page 2 is the current backing surface used for independently created images
  ' Preserve its requested dimensions unless this image is being handed directly to SCREEN
  IF isScreenImage = 0 THEN
    tiraAssign "!G_GFX_V32_PAGE2W", arg1$
    tiraAssign "!G_GFX_V32_PAGE2H", arg2$
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "2"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_NEWIMAGE$ = scratchName$

END FUNCTION ' parse_NEWIMAGE$

''''''''''''''''''''''''
FUNCTION parse_OPEN (startIdx)

  DIM hasFor AS LONG
  DIM forIdx AS LONG
  DIM asIdx AS LONG
  DIM fileNameStart AS LONG
  DIM fileNameEnd AS LONG
  DIM fileNumStart AS LONG
  DIM fileNameVar$
  DIM fileNumVar$
  DIM tokVal AS LONG
  DIM accessVal$
  DIM dispVal$
  DIM strDataPtr$
  DIM argList$
  DIM handleVar$
  DIM baseArr$
  DIM slotAddr$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  hasFor = 0
  forIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_FOR)
  IF ff = 1 THEN
    hasFor = 1
    forIdx = returnedData2
  END IF

  asIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_AS)
  IF ff = 1 THEN
    asIdx = returnedData2
  ELSE
    throwCompilerError "OPEN MISSING AS", ASIS, 0
    EXIT FUNCTION
  END IF

  fileNameStart = startIdx + 1
  fileNameEnd = asIdx - 1
  IF hasFor = 1 THEN fileNameEnd = forIdx - 1

  IF hasFor = 1 THEN
    IF forIdx + 1 < asIdx THEN
      tokVal = lineTokenVals(forIdx + 1)
      SELECT CASE tokVal
        CASE TOK_BINARY, TOK_RANDOM, TOK_INPUT
        CASE ELSE
          throwCompilerError "INVALID FILE MODE (ONLY BINARY/RANDOM/INPUT SUPPORTED)", ASIS, 0
          EXIT FUNCTION
      END SELECT
    ELSE
      throwCompilerError "OPEN MISSING MODE AFTER FOR", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  fileNumStart = asIdx + 1
  IF fileNumStart <= endIdx THEN
    ' Strip the # symbol so the expression evaluates properly
    IF lineTokens$(fileNumStart) = "#" THEN
      fileNumStart = fileNumStart + 1
    ELSE
      IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
        lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
      END IF
    END IF
  END IF

  tira_Start

  fileNameVar$ = tiraParseExpression$(fileNameStart, fileNameEnd, ALIM)
  IF fileNameVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  fileNumVar$ = tiraParseExpressionInt$(fileNumStart, endIdx, ALIM, "FILENUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  ' Setup generic OS constants mapping to the required behavior natively to bypass CPU register constraints
  IF tokVal = TOK_INPUT THEN
    accessVal$ = "-2147483648" ' read only access
    dispVal$ = "3" ' opens an existing file
  ELSE
    accessVal$ = "-1073741824" ' GENERIC_READ OR GENERIC_WRITE
    dispVal$ = "4" ' OPEN_ALWAYS
  END IF

  ' String arrays naturally track null terminators so it resolves seamlessly here to map directly into OS requirements
  strDataPtr$ = tiraGetStringData$(fileNameVar$)

  ' Execute the CreateFileA procedure and allow the OS to perform file locking tracking
  ' ShareMode = 3 (FILE_SHARE_READ OR FILE_SHARE_WRITE)
  argList$ = strDataPtr$ + ", " + accessVal$ + ", 3, 0, " + dispVal$ + ", 128, 0"
  tiraCall "IAT_CREATEFILEA", 7, argList$

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, handleVar$

  ' Push OS Pointer Handle directly into the corresponding layout array index utilizing the provided File Number
  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  tiraWriteMem slotAddr$, handleVar$, "8"

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_OPEN = 1

END FUNCTION ' parse_OPEN

''''''''''''''''''''''''
FUNCTION parse_PAINT (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM fillEnd AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  hasStep = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      hasStep = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "PAINT REQUIRES FILL COLOR", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)

  cComma = retCoordinateBoundaries(tokIdx, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "PAINT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  xVar$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF xVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  yVar$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF yVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    tiraOp TC_ADD, xVar$, xVar$, "!G_GFX_VAL_CUR_X"
    tiraOp TC_ADD, yVar$, yVar$, "!G_GFX_VAL_CUR_Y"
  END IF

  fillEnd = endIdx
  IF comma2 > 0 THEN fillEnd = comma2 - 1

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  fillVar$ = tiraParseExpression$(comma1 + 1, fillEnd, ALIM)
  IF fillVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  fillIsStr$ = tiraDimVar$("T", TYPE_LONG)
  IF exprIs.DataType = TYPE_STRING THEN
    tiraAssign fillIsStr$, "1"
  ELSE
    tiraAssign fillIsStr$, "0"
  END IF

  IF comma2 > 0 THEN
    borderVar$ = tiraParseExpressionInt$(comma2 + 1, endIdx, ALIM, "BORDER COLOR MUST BE NUMERIC")
    IF borderVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  ELSE
    borderVar$ = tiraDimVar$("T", TYPE_LONG)
    lblDefBorder$ = tiraLabelCreateNew$("DEF_BORDER")
    lblBorderDone$ = tiraLabelCreateNew$("BORDER_DONE")

    tiraJmpCond "JE", fillIsStr$, "1", lblDefBorder$
    tiraAssign borderVar$, fillVar$
    tiraJmp lblBorderDone$
    tiraLabel lblDefBorder$
    tiraAssign borderVar$, "!G_GFX_VAL_FG"
    tiraLabel lblBorderDone$
  END IF

  ' Update graphics tracking coordinates to match standard execution rules
  tiraAssign "!G_GFX_VAL_CUR_X", xVar$
  tiraAssign "!G_GFX_VAL_CUR_Y", yVar$

  tiraCall "RT_PAINT", 5, xVar$ + ", " + yVar$ + ", " + fillVar$ + ", " + fillIsStr$ + ", " + borderVar$

  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PAINT = 1

END FUNCTION ' parse_PAINT

''''''''''''''''''''''''
FUNCTION parse_PALETTE (startIdx)

  DIM comma1 AS LONG
  DIM idxVar$
  DIM colorVar$
  DIM mappedColor$
  DIM skipLbl$
  DIM srcDescPtr$
  DIM srcDataAddr$
  DIM srcOffsetVar$
  DIM srcAddr$
  DIM destDescPtr$
  DIM destDataAddr$
  DIM destOffsetVar$
  DIM destAddr$
  DIM colorVal$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    parse_PALETTE = 1
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "PALETTE REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  idxVar$ = tiraParseExpressionInt$(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF idxVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  colorVar$ = tiraParseExpressionInt$(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF colorVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  skipLbl$ = tiraLabelCreateNew$("SKIP_PAL")

  tiraJmpCond "JL", idxVar$, "0", skipLbl$
  tiraJmpCond "JG", idxVar$, "255", skipLbl$

  ' Mask the source color to 0-15 to map EGA colors to our standard VGA palette block
  mappedColor$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, mappedColor$, colorVar$, "15"

  ' Read from the pristine default palette to prevent cumulative mapping corruption bugs
  srcDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign srcDescPtr$, "!G_GFX_DSC_DEFPAL"

  srcDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, srcDataAddr$ + ", " + srcDescPtr$

  srcOffsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, srcOffsetVar$, mappedColor$, "4"

  srcAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, srcAddr$, srcDataAddr$, srcOffsetVar$

  destDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign destDescPtr$, "!G_GFX_DSC_PALETTE"

  destDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, destDataAddr$ + ", " + destDescPtr$

  destOffsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, destOffsetVar$, idxVar$, "4"

  destAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, destAddr$, destDataAddr$, destOffsetVar$

  colorVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, colorVal$ + ", " + srcAddr$

  tiraWriteMem destAddr$, colorVal$, "4"

  tiraTriggerAutoDisplay

  tiraLabel skipLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PALETTE = 1

END FUNCTION ' parse_PALETTE

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR (startIdx)

  DIM comma1 AS LONG
  DIM idxVar$
  DIM colorVar$
  DIM skipLbl$
  DIM palDescPtr$
  DIM palDataAddr$
  DIM offsetVar$
  DIM targetAddr$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF compileHasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  idxVar$ = tiraParseExpressionInt$(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF idxVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  colorVar$ = tiraParseExpressionInt$(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF colorVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  skipLbl$ = tiraLabelCreateNew$("SKIP_PAL")

  tiraJmpCond "JL", idxVar$, "0", skipLbl$
  tiraJmpCond "JG", idxVar$, "255", skipLbl$

  palDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign palDescPtr$, "!G_GFX_DSC_PALETTE"

  palDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, palDataAddr$ + ", " + palDescPtr$

  offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, offsetVar$, idxVar$, "4"

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palDataAddr$, offsetVar$

  tiraWriteMem targetAddr$, colorVar$, "4"

  tiraTriggerAutoDisplay

  tiraLabel skipLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PALETTECOLOR = 1

END FUNCTION ' parse_PALETTECOLOR

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM palDescPtr$
  DIM palDataAddr$
  DIM offsetVar$
  DIM targetAddr$
  DIM skipLbl$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_PALETTECOLOR", 3) = 0 THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  IF compileHasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INDEX MUST BE NUMERIC")
  IF arg1$ = "" THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("PALCOL", "_VAL")
  IF scratchName$ = "" THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  skipLbl$ = tiraLabelCreateNew$("SKIP_PALCOL")

  tiraJmpCond "JL", arg1$, "0", skipLbl$
  tiraJmpCond "JG", arg1$, "255", skipLbl$

  palDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign palDescPtr$, "!G_GFX_DSC_PALETTE"

  palDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, palDataAddr$ + ", " + palDescPtr$

  offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, offsetVar$, arg1$, "4"

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palDataAddr$, offsetVar$

  tiraNew TC_READ_MEM, resVar$ + ", " + targetAddr$

  tiraLabel skipLbl$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_PALETTECOLOR_FUNC$ = scratchName$

END FUNCTION ' parse_PALETTECOLOR_FUNC$

''''''''''''''''''''''''
FUNCTION parse_POINT$ (startIdx, endIdx, allowImplicit)

  DIM comma1 AS LONG
  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM resVar$
  DIM skipLbl$
  DIM offsetVar$
  DIM targetAddr$
  DIM colorByte$
  DIM lblX$
  DIM lblY$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "POINT", 3) = 0 THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  IF compileHasGraphics = 0 THEN
    throwCompilerError "POINT REQUIRES #GRAPHICS", ASIS, 0
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  scratchName$ = tiraResolveHoistVar$("POINT", "_VAL")
  IF scratchName$ = "" THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "-1"

  IF comma1 = 0 THEN
    ' 1 argument: POINT(n)
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "POINT ARGUMENT MUST BE NUMERIC")
    IF arg1$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    lblX$ = tiraLabelCreateNew$("PT_X")
    lblY$ = tiraLabelCreateNew$("PT_Y")
    lblEnd$ = tiraLabelCreateNew$("PT_END")

    tiraJmpCond "JE", arg1$, "0", lblX$
    tiraJmpCond "JE", arg1$, "2", lblX$
    tiraJmpCond "JE", arg1$, "1", lblY$
    tiraJmpCond "JE", arg1$, "3", lblY$
    tiraJmp lblEnd$

    tiraLabel lblX$
    tiraAssign resVar$, "!G_GFX_VAL_CUR_X"
    tiraJmp lblEnd$

    tiraLabel lblY$
    tiraAssign resVar$, "!G_GFX_VAL_CUR_Y"
    tiraLabel lblEnd$

  ELSE
    ' 2 arguments: POINT(x, y)
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF arg2$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    skipLbl$ = tiraLabelCreateNew$("PT_SKIP")

    ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
    tiraJmpCond "JAE", arg1$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), skipLbl$
    tiraJmpCond "JAE", arg2$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), skipLbl$

    offsetVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, offsetVar$, arg2$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
    tiraOp TC_ADD, offsetVar$, offsetVar$, arg1$

    targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, targetAddr$, "!G_GFX_PTR_SRC_FRMB", offsetVar$

    colorByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, colorByte$ + ", " + targetAddr$

    tiraAssign resVar$, colorByte$

    tiraLabel skipLbl$
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_POINT$ = scratchName$

END FUNCTION ' parse_POINT$

''''''''''''''''''''''''
FUNCTION parse_POKE (startIdx)

  ' This function evaluates the poke command to write data into memory
  ' Rather than exposing direct memory access which would crash a modern operating system
  ' we specifically look for address 1047. In legacy dos systems, address 1047 holds
  ' the keyboard flags where the bit representing 32 controls the numlock state
  ' If the user script tries to write to 1047, we extract the requested numlock state
  ' and use the windows api to simulate physical key presses if the state needs to change

  DIM commaIdx AS LONG
  DIM addrVar$
  DIM valVar$
  DIM skipLbl$
  DIM desired$
  DIM current$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx = 0 THEN
    throwCompilerError "POKE MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Evaluate the address and value arguments provided by the user script
  addrVar$ = tiraParseExpressionInt$(startIdx + 1, commaIdx - 1, ALIM, "POKE ADDRESS MUST BE NUMERIC")
  IF addrVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  valVar$ = tiraParseExpressionInt$(commaIdx + 1, endIdx, ALIM, "POKE VALUE MUST BE NUMERIC")
  IF valVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  ' Create a jump label to skip the emulation block if the address is not exactly 1047
  skipLbl$ = tiraLabelCreateNew$("SKIP_POKE")
  tiraJmpCond "JNE", addrVar$, "1047", skipLbl$

  ' Extract the target state by masking out the thirty two bit and shifting it down to the lowest bit position
  desired$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, desired$, valVar$, "32"
  tiraOp TC_SHR, desired$, desired$, "5"

  ' Ask windows for the current hardware state of the numlock key using its virtual key code
  tiraCall "IAT_GETKEYSTATE", 1, "144"
  current$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, current$

  ' Mask the windows return value to isolate just the active toggle state bit
  tiraOp TC_AND, current$, current$, "1"

  ' Compare the requested state with the current hardware state and jump past the toggle event if they match
  tiraJmpCond "JE", desired$, current$, skipLbl$

  ' Fire down and up keyboard events to physically toggle the numlock key at the hardware level
  tiraCall "IAT_KEYBD_EVENT", 4, "144, 69, 1, 0"
  tiraCall "IAT_KEYBD_EVENT", 4, "144, 69, 3, 0"

  tiraLabel skipLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_POKE = 1

END FUNCTION ' parse_POKE

''''''''''''''''''''''''
FUNCTION parse_PUT (startIdx)

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM isFileIO AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vIdx AS LONG
  DIM elemSize AS LONG
  DIM statElems AS LONG
  DIM endIdx AS LONG
  DIM putMode AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM dimEnd AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)

  cComma = 0
  IF comma1 > 0 THEN
    cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  END IF

  isFileIO = 0
  IF cComma = 0 THEN
    isFileIO = 1
  END IF

  IF isFileIO = 1 THEN
    parse_PUT = parse_PUT_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  IF compileHasGraphics = 0 THEN
    throwCompilerError "GRAPHICS PUT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 = 0 THEN
    throwCompilerError "PUT MISSING ARRAY VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "PUT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  x$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF x$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  y$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF y$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)

  dimEnd = endIdx
  IF comma2 > 0 THEN dimEnd = comma2 - 1

  tokIdx = comma1 + 1
  vTok$ = lineTokens$(tokIdx)
  vName$ = UCASE$(vTok$)
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerErrorAndCancelTira "PUT TARGET MUST BE AN ARRAY", ASIS, 0
    EXIT FUNCTION
  END IF

  indicesStr$ = ""
  numParsedIndices = 0

  tokIdx = tokIdx + 1
  IF tokIdx <= dimEnd THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      indicesStr$ = tiraParseArrayArgs$(tokIdx, dimEnd, 0)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, 0)
  IF ptr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  elemSize = retElementByteSize(vIdx)

  descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

  numDims$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, numDims$ + ", " + descAddr$ + ", 12"

  totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign totalElems$, "1"

  dimItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign dimItr$, "0"
  lblDimTop$ = tiraLabelCreateNew$("DIM_TOP")
  lblDimDone$ = tiraLabelCreateNew$("DIM_DONE")

  tiraLabel lblDimTop$
  tiraJmpCond "JGE", dimItr$, numDims$, lblDimDone$

  offsetVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetVar$, dimItr$, "8"
  tiraOp TC_ADD, offsetVar$, offsetVar$, "16"

  dimLimitAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dimLimitAddr$, descAddr$, offsetVar$

  dimLimit$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, dimLimit$ + ", " + dimLimitAddr$

  tiraOp TC_MUL, totalElems$, totalElems$, dimLimit$
  tiraOp TC_ADD, dimItr$, dimItr$, "1"
  tiraJmp lblDimTop$

  tiraLabel lblDimDone$

  byteSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, byteSize$, totalElems$, LTRIM$(RTRIM$(STR$(elemSize)))

  baseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, baseAddr$ + ", " + descAddr$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, endPtr$, baseAddr$, byteSize$

  putMode = 1
  IF comma2 > 0 THEN
    SELECT CASE lineTokenVals(comma2 + 1)
      CASE TOK_PSET
        putMode = 0
      CASE TOK_XOR
        putMode = 1
      CASE TOK_AND
        putMode = 2
      CASE TOK_OR
        putMode = 3
      CASE TOK_PRESET
        putMode = 4
      CASE ELSE
        throwCompilerErrorAndCancelTira "UNSUPPORTED GRAPHIC STYLE FOR PUT", ASIS, 0
        EXIT FUNCTION
    END SELECT
  END IF

  tiraCall "RT_PUT", 5, x$ + ", " + y$ + ", " + ptr$ + ", " + endPtr$ + ", " + LTRIM$(STR$(putMode))

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PUT = 1

END FUNCTION ' parse_PUT

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_PUTIMAGE (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasCoords AS LONG
  DIM isStep1 AS LONG
  DIM isStep2 AS LONG
  DIM dashIdx AS LONG
  DIM cComma AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM commaSrcDest AS LONG
  DIM srcStart AS LONG
  DIM srcEnd AS LONG
  DIM destStart AS LONG
  DIM destEnd AS LONG
  DIM x1Var$
  DIM y1Var$
  DIM x2Var$
  DIM y2Var$
  DIM srcVar$
  DIM destVar$
  DIM newX1$
  DIM newY1$
  DIM newX2$
  DIM newY2$
  DIM cComma2 AS LONG

  endIdx = lineTokenCount - 1

  IF compileHasGraphics = 0 THEN
    throwCompilerError "_PUTIMAGE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  hasCoords = 0
  isStep1 = 0
  isStep2 = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP OR lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasCoords = 1
    END IF
  END IF

  tira_Start

  IF hasCoords = 1 THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      isStep1 = 1
      tokIdx = tokIdx + 1
    END IF

    IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
      throwCompilerErrorAndCancelTira "EXPECTED ( AFTER _PUTIMAGE", ASIS, 0
      EXIT FUNCTION
    END IF

    dashIdx = 0
    ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
    IF ff = 1 THEN dashIdx = returnedData2

    IF dashIdx > 0 THEN
      cComma = retCoordinateBoundaries(tokIdx, dashIdx - 1)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      x1Var$ = tiraParseExpressionInt$(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x1Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y1Var$ = tiraParseExpressionInt$(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y1Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      tokIdx = dashIdx + 1
      IF tokIdx <= endIdx THEN
        IF lineTokenVals(tokIdx) = TOK_STEP THEN
          isStep2 = 1
          tokIdx = tokIdx + 1
        END IF
      END IF

      IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
        throwCompilerErrorAndCancelTira "EXPECTED ( AFTER -", ASIS, 0
        EXIT FUNCTION
      END IF

      commaSrcDest = findComma(tokIdx, endIdx)
      cEnd2 = endIdx
      IF commaSrcDest > 0 THEN cEnd2 = commaSrcDest - 1

      cComma2 = retCoordinateBoundaries(tokIdx, cEnd2)
      IF cComma2 = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X2, Y2", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart2 = returnedData2
      cEnd2 = returnedData3

      x2Var$ = tiraParseExpressionInt$(cStart2, cComma2 - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x2Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y2Var$ = tiraParseExpressionInt$(cComma2 + 1, cEnd2, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y2Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      tokIdx = cEnd2 + 2
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    ELSE
      ff = findMatchingParen(tokIdx, endIdx)
      IF ff = 0 THEN
        throwCompilerErrorAndCancelTira "MALFORMED COORDINATES IN _PUTIMAGE", ASIS, 0
        EXIT FUNCTION
      END IF

      cComma = retCoordinateBoundaries(tokIdx, returnedData2)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      x1Var$ = tiraParseExpressionInt$(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x1Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y1Var$ = tiraParseExpressionInt$(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y1Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      x2Var$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, x2Var$, x1Var$, _TRIM$(STR$(gfxConfig.SizeX))
      tiraOp TC_SUB, x2Var$, x2Var$, "1"

      y2Var$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, y2Var$, y1Var$, _TRIM$(STR$(gfxConfig.SizeY))
      tiraOp TC_SUB, y2Var$, y2Var$, "1"

      tokIdx = returnedData2 + 1
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    END IF

    IF isStep1 = 1 THEN
      newX1$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newX1$, "!G_GFX_VAL_CUR_X", x1Var$
      x1Var$ = newX1$
      newY1$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newY1$, "!G_GFX_VAL_CUR_Y", y1Var$
      y1Var$ = newY1$
    END IF

    IF isStep2 = 1 THEN
      newX2$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newX2$, x1Var$, x2Var$
      x2Var$ = newX2$
      newY2$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newY2$, y1Var$, y2Var$
      y2Var$ = newY2$
    END IF
  ELSE
    x1Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign x1Var$, "0"
    y1Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign y1Var$, "0"
    x2Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, x2Var$, _TRIM$(STR$(gfxConfig.SizeX)), "1"
    y2Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, y2Var$, _TRIM$(STR$(gfxConfig.SizeY)), "1"
  END IF

  commaSrcDest = findComma(tokIdx, endIdx)
  IF commaSrcDest > 0 THEN
    srcStart = tokIdx
    srcEnd = commaSrcDest - 1
    destStart = commaSrcDest + 1
    destEnd = endIdx
  ELSE
    srcStart = tokIdx
    srcEnd = endIdx
    destStart = 0
    destEnd = 0
  END IF

  IF srcStart > 0 AND srcStart <= srcEnd THEN
    srcVar$ = tiraParseExpressionInt$(srcStart, srcEnd, ALIM, "SOURCE MUST BE NUMERIC")
    IF srcVar$ = "" THEN tira_Cancel: EXIT FUNCTION
  ELSE
    srcVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign srcVar$, "!G_GFX_VAL_SRC_PAGE"
  END IF

  IF destStart > 0 AND destStart <= destEnd THEN
    destVar$ = tiraParseExpressionInt$(destStart, destEnd, ALIM, "DEST MUST BE NUMERIC")
    IF destVar$ = "" THEN tira_Cancel: EXIT FUNCTION
  ELSE
    destVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign destVar$, "!G_GFX_VAL_DEST_PAGE"
  END IF

  tiraCall "RT_PUTIMAGE", 6, x1Var$ + ", " + y1Var$ + ", " + x2Var$ + ", " + y2Var$ + ", " + srcVar$ + ", " + destVar$

  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PUTIMAGE = 1

END FUNCTION ' parse_PUTIMAGE

''''''''''''''''''''''''
FUNCTION parse_RANDOMIZE (startIdx)

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED NUMERIC ARGUMENT AFTER RANDOMIZE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  argVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "RANDOMIZE REQUIRES NUMERIC ARGUMENT")
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraCall "IAT_SRAND", 1, argVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_RANDOMIZE = 1

END FUNCTION ' parse_RANDOMIZE

''''''''''''''''''''''''
FUNCTION parse_READ (startIdx)

  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM commaIdx AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM hasIndex AS LONG
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM fieldName$
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM ptr$
  DIM targetType AS LONG
  DIM isStrVar AS LONG
  DIM endIdx AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM currUdtIndex AS LONG
  DIM tempFieldSize AS LONG
  DIM tempIsDynamicString AS LONG
  DIM isFixedStr AS LONG
  DIM fixedLen AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "READ MISSING VARIABLES", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  itemStart = startIdx + 1
  DO WHILE itemStart <= endIdx
    itemEnd = endIdx
    commaIdx = findComma(itemStart, endIdx)
    IF commaIdx > 0 THEN itemEnd = commaIdx - 1

    tokIdx = itemStart
    vTok$ = lineTokens$(tokIdx)
    vName$ = UCASE$(vTok$)
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    targetType = symbols(vIdx).DataType

    tokIdx = tokIdx + 1

    hasIndex = 0
    indicesStr$ = ""
    numParsedIndices = 0

    IF tokIdx <= itemEnd THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        indicesStr$ = tiraParseArrayArgs$(tokIdx, itemEnd, 0)
        IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
        closeParen = returnedData2
        numParsedIndices = returnedData3
        tokIdx = closeParen + 1
      END IF
    END IF

    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF

    hasField = 0
    udtOffset = 0
    currUdtIndex = symbols(vIdx).UDTIndex
    tempFieldSize = 0
    tempIsDynamicString = 0

    DO WHILE tokIdx <= itemEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        tokIdx = tokIdx + 1
        fieldName$ = UCASE$(lineTokens$(tokIdx))
        tokIdx = tokIdx + 1

        IF targetType <> TYPE_UDT THEN
          throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF

        fieldFound = 0
        FOR iField = 0 TO udts(currUdtIndex).FieldCount - 1
          IF RTRIM$(udtFields(currUdtIndex, iField).FieldName) = fieldName$ THEN
            udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
            targetType = udtFields(currUdtIndex, iField).DataType
            tempFieldSize = udtFields(currUdtIndex, iField).Size
            tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
            currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
            fieldFound = 1
            EXIT FOR
          END IF
        NEXT

        IF fieldFound = 0 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, udtOffset)
    IF ptr$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    isStrVar = 0
    IF targetType = TYPE_STRING THEN isStrVar = 1

    isFixedStr = 0
    fixedLen = 0

    IF isStrVar = 1 THEN
      IF hasField = 1 THEN
        IF tempIsDynamicString = 0 THEN
          isFixedStr = 1
          fixedLen = tempFieldSize
        END IF
      ELSE
        fixedLen = retFixedStringLength(vIdx)
        IF fixedLen > 0 THEN
          isFixedStr = 1
        END IF
      END IF
    END IF

    IF isFixedStr = 1 THEN
      ' Read safely into a temporary dynamic string to respect raw character constraints
      tempDesc$ = tiraResolveHoistVar$("RDTMP", "_DSC")
      tiraAssign tempDesc$, "!G_SYS_DSC_EMPTY"

      tiraCall "RT_READ", 3, tempDesc$ + ", 1, " + LTRIM$(RTRIM$(STR$(TYPE_STRING)))

      ' Copy raw characters seamlessly into the fixed data buffer without memory corruption
      rhsDataPtr$ = tiraGetStringData$(tempDesc$)
      rhsLen$ = tiraGetStringLen$(tempDesc$)

      minLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign minLen$, rhsLen$
      tiraClamp minLen$, "", LTRIM$(STR$(fixedLen))

      tiraMemcpy ptr$, rhsDataPtr$, minLen$

      padLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_SUB, padLen$, LTRIM$(STR$(fixedLen)), minLen$
      skipPadLbl$ = tiraLabelCreateNew$("SKIP_PAD")
      tiraJmpCond "JLE", padLen$, "0", skipPadLbl$

      padAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADD, padAddr$, ptr$, minLen$
      tiraMemSet padAddr$, "32", padLen$
      tiraLabel skipPadLbl$

      ' Garbage collect the temporary dynamic string
      tiraCall "RT_STR_ASSIGN", 2, tempDesc$ + ", !G_SYS_DSC_EMPTY"
    ELSE
      tiraCall "RT_READ", 3, ptr$ + ", " + LTRIM$(RTRIM$(STR$(isStrVar))) + ", " + LTRIM$(RTRIM$(STR$(targetType)))
    END IF

    itemStart = itemEnd + 2
  LOOP

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_READ = 1

END FUNCTION ' parse_READ

''''''''''''''''''''''''
FUNCTION parse_RED32$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM shiftVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RED32", 3) = 0 THEN
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "_RED32 ARG MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("RED32", "_VAL")
  IF scratchName$ = "" THEN
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  shiftVar$ = tiraDimVar$("T", TYPE_LONG)

  tiraOp TC_SHR, shiftVar$, arg1$, "16"
  tiraOp TC_AND, resVar$, shiftVar$, "255"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RED32$ = scratchName$

END FUNCTION ' parse_RED32$

''''''''''''''''''''''''
FUNCTION parse_RESTORE (startIdx)

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx < startIdx + 1 THEN
    tiraAssign "!G_SYS_VAL_DATAINDEX", "0"
  ELSE
    lblTok$ = lineTokens$(startIdx + 1)
    lblName$ = "%" + UCASE$(lblTok$)
    expectedSymType = TYPE_LABEL
    ff = resolveSymbol(lblName$)
    IF ff = 1 THEN
      vIdx = returnedData2
      idxVal = symbols(vIdx).DataIndex
      tiraAssign "!G_SYS_VAL_DATAINDEX", LTRIM$(STR$(idxVal))
    ELSE
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_RESTORE = 1

END FUNCTION ' parse_RESTORE

''''''''''''''''''''''''
FUNCTION parse_RESUME (startIdx)

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start
  tiraScheduleHeapReset
  tiraNew TC_RESUME, ""
  tira_EndAndProcess

  parse_RESUME = 1

END FUNCTION ' parse_RESUME

''''''''''''''''''''''''
FUNCTION parse_RGB$ (startIdx, endIdx, allowImplicit)

  DIM argR$
  DIM argG$
  DIM argB$
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM maskR$
  DIM maskG$
  DIM maskB$
  DIM idx$
  DIM bestIdx$
  DIM minDist$
  DIM palDescPtr$
  DIM palDataAddr$
  DIM loopTop$
  DIM loopDone$
  DIM offsetVar$
  DIM targetAddr$
  DIM palB$
  DIM palG_addr$
  DIM palG$
  DIM palR_addr$
  DIM palR$
  DIM diffR$
  DIM diffG$
  DIM diffB$
  DIM sqR$
  DIM sqG$
  DIM sqB$
  DIM dist$
  DIM skipUpdate$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB", 7) = 0 THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  argR$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "_RGB RED ARG MUST BE NUMERIC")
  IF argR$ = "" THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  argG$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, allowImplicit, "_RGB GREEN ARG MUST BE NUMERIC")
  IF argG$ = "" THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  argB$ = tiraParseExpressionInt$(comma2 + 1, endIdx - 1, allowImplicit, "_RGB BLUE ARG MUST BE NUMERIC")
  IF argB$ = "" THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("RGB", "_VAL")
  IF scratchName$ = "" THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  ' Force incoming values to 0-255 limits cleanly before calculation
  maskR$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, maskR$, argR$, "255"

  maskG$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, maskG$, argG$, "255"

  maskB$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, maskB$, argB$, "255"

  idx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign idx$, "0"

  bestIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign bestIdx$, "0"

  minDist$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign minDist$, "9999999"

  ' Read directly from the internal compiler global palette block memory
  palDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign palDescPtr$, "!G_GFX_DSC_PALETTE"

  palDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, palDataAddr$ + ", " + palDescPtr$

  loopTop$ = tiraLabelCreateNew$("RGB_LOOP")
  loopDone$ = tiraLabelCreateNew$("RGB_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JG", idx$, "255", loopDone$

  offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, offsetVar$, idx$, "4"

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palDataAddr$, offsetVar$

  palB$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, palB$ + ", " + targetAddr$

  palG_addr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, palG_addr$, targetAddr$, "1"
  palG$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, palG$ + ", " + palG_addr$

  palR_addr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, palR_addr$, targetAddr$, "2"
  palR$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, palR$ + ", " + palR_addr$

  ' Calculate the numerical difference between the target pixel and the current index pixel
  diffR$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, diffR$, maskR$, palR$

  diffG$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, diffG$, maskG$, palG$

  diffB$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, diffB$, maskB$, palB$

  ' Square the differences internally to isolate purely positive vector distances
  sqR$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, sqR$, diffR$, diffR$

  sqG$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, sqG$, diffG$, diffG$

  sqB$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, sqB$, diffB$, diffB$

  dist$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, dist$, sqR$, sqG$
  tiraOp TC_ADD, dist$, dist$, sqB$

  ' Skip overriding the best match if this index is farther away than our currently held match
  skipUpdate$ = tiraLabelCreateNew$("RGB_SKIP_UPD")
  tiraJmpCond "JGE", dist$, minDist$, skipUpdate$
  tiraAssign minDist$, dist$
  tiraAssign bestIdx$, idx$

  ' Speed optimization: If exact perfect distance hit 0 is reached, terminate scan early
  tiraJmpCond "JE", dist$, "0", loopDone$
  tiraLabel skipUpdate$

  tiraOp TC_ADD, idx$, idx$, "1"
  tiraJmp loopTop$

  tiraLabel loopDone$

  tiraAssign scratchName$, bestIdx$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB$ = scratchName$

END FUNCTION ' parse_RGB$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_RGB32$ (startIdx, endIdx, allowImplicit)

  DIM argR$
  DIM argG$
  DIM argB$
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM maskR$
  DIM maskG$
  DIM maskB$
  DIM clampRMinDone$
  DIM clampRDone$
  DIM clampGMinDone$
  DIM clampGDone$
  DIM clampBMinDone$
  DIM clampBDone$
  DIM shiftG$
  DIM shiftR$
  DIM alphaVal$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB32", 7) = 0 THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  argR$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "_RGB32 RED ARG MUST BE NUMERIC")
  IF argR$ = "" THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  argG$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, allowImplicit, "_RGB32 GREEN ARG MUST BE NUMERIC")
  IF argG$ = "" THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  argB$ = tiraParseExpressionInt$(comma2 + 1, endIdx - 1, allowImplicit, "_RGB32 BLUE ARG MUST BE NUMERIC")
  IF argB$ = "" THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("RGB32", "_VAL")
  IF scratchName$ = "" THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  clampRMinDone$ = tiraLabelCreateNew$("RGB32_R_MIN_DONE")
  clampRDone$ = tiraLabelCreateNew$("RGB32_R_DONE")
  clampGMinDone$ = tiraLabelCreateNew$("RGB32_G_MIN_DONE")
  clampGDone$ = tiraLabelCreateNew$("RGB32_G_DONE")
  clampBMinDone$ = tiraLabelCreateNew$("RGB32_B_MIN_DONE")
  clampBDone$ = tiraLabelCreateNew$("RGB32_B_DONE")

  maskR$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign maskR$, argR$
  tiraJmpCond "JGE", maskR$, "0", clampRMinDone$
  tiraAssign maskR$, "0"
  tiraLabel clampRMinDone$
  tiraJmpCond "JLE", maskR$, "255", clampRDone$
  tiraAssign maskR$, "255"
  tiraLabel clampRDone$

  maskG$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign maskG$, argG$
  tiraJmpCond "JGE", maskG$, "0", clampGMinDone$
  tiraAssign maskG$, "0"
  tiraLabel clampGMinDone$
  tiraJmpCond "JLE", maskG$, "255", clampGDone$
  tiraAssign maskG$, "255"
  tiraLabel clampGDone$

  maskB$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign maskB$, argB$
  tiraJmpCond "JGE", maskB$, "0", clampBMinDone$
  tiraAssign maskB$, "0"
  tiraLabel clampBMinDone$
  tiraJmpCond "JLE", maskB$, "255", clampBDone$
  tiraAssign maskB$, "255"
  tiraLabel clampBDone$

  shiftG$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SHL, shiftG$, maskG$, "8"

  shiftR$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SHL, shiftR$, maskR$, "16"

  ' Default the missing alpha value safely to &HFF000000 (-16777216)
  alphaVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign alphaVal$, "-16777216"

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, resVar$, maskB$, shiftG$
  tiraOp TC_ADD, resVar$, resVar$, shiftR$
  tiraOp TC_ADD, resVar$, resVar$, alphaVal$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB32$ = scratchName$

END FUNCTION ' parse_RGB32$

''''''''''''''''''''''''
FUNCTION parse_RND$ (startIdx, endIdx, allowImplicit)

  ' Returns a random single-precision floating point number

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM dblRes$
  DIM maxVal$
  DIM finalDbl$
  DIM singleRes$

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
    IF arg1$ = "" THEN
      tira_Cancel
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType = TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES NUMERIC", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("RND", "_VAL")
  IF scratchName$ = "" THEN
    parse_RND$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  tiraCall "IAT_RAND", 0, ""
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resVar$

  dblRes$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_CAST, dblRes$, resVar$, LTRIM$(STR$(TYPE_DOUBLE))

  maxVal$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign maxVal$, "32767.0#"

  finalDbl$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_DIV, finalDbl$, dblRes$, maxVal$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, finalDbl$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_RND$ = scratchName$

END FUNCTION ' parse_RND$

''''''''''''''''''''''''
FUNCTION parse_SCREENEXISTS$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SCREENEXISTS", ASIS, 0
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("SCREX", "_VAL")
  IF scratchName$ = "" THEN
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  ' Evaluates the window readiness spinlock to determine if the screen exists
  ' Console windows are always considered ready
  IF compileHasGraphics = 1 THEN
    tiraOp TC_NEG, resVar$, "!G_WND_FLG_READY", ""
  ELSE
    tiraAssign resVar$, "-1"
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SCREENEXISTS$ = scratchName$

END FUNCTION ' parse_SCREENEXISTS$

''''''''''''''''''''''''
FUNCTION parse_SCREENICON (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF compileHasGraphics = 0 THEN
    throwCompilerError "_SCREENICON REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Parse the optional handle argument if provided to ensure syntax checking
  IF endIdx > startIdx THEN
    argVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "ICON HANDLE MUST BE NUMERIC")
    IF argVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SCREENICON = 1

END FUNCTION ' parse_SCREENICON

''''''''''''''''''''''''
FUNCTION parse_SGN$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM lblPos$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "SGN", 3) = 0 THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("SGN", "_VAL")
  IF scratchName$ = "" THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  lblPos$ = tiraLabelCreateNew$("SGN_POS")
  lblEnd$ = tiraLabelCreateNew$("SGN_END")

  ' TC_JMP_COND seamlessly handles float/integer mixed conditions safely using UCOMI
  tiraJmpCond "JE", arg1$, "0", lblEnd$
  tiraJmpCond "JG", arg1$, "0", lblPos$

  tiraAssign resVar$, "-1"
  tiraJmp lblEnd$

  tiraLabel lblPos$
  tiraAssign resVar$, "1"

  tiraLabel lblEnd$
  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SGN$ = scratchName$

END FUNCTION ' parse_SGN$

''''''''''''''''''''''''
FUNCTION parse_SHELL (startIdx)

  DIM endIdx AS LONG
  DIM hasHide AS LONG
  DIM hasDontWait AS LONG
  DIM cmdStart AS LONG
  DIM cmdStr$
  DIM strDataPtr$
  DIM strLen$
  DIM hideVal$
  DIM structRawPtr$
  DIM startupInfoPtr$
  DIM processInfoPtr$
  DIM cmdAllocSize$
  DIM cmdBuffer$
  DIM nullPtr$
  DIM createResult$
  DIM doneLbl$
  DIM processHandle$
  DIM threadHandle$
  DIM tokVal AS LONG

  endIdx = lineTokenCount - 1
  hasHide = 0
  hasDontWait = 0
  cmdStart = startIdx + 1

  DO WHILE cmdStart <= endIdx
    tokVal = lineTokenVals(cmdStart)

    SELECT CASE tokVal

      CASE TOK_HIDE
        hasHide = 1
        cmdStart = cmdStart + 1
      CASE TOK_DONTWAIT
        hasDontWait = 1
        cmdStart = cmdStart + 1
      CASE ELSE
        EXIT DO

    END SELECT ' tokVak

  LOOP

  IF cmdStart > endIdx THEN
    throwCompilerError "EXPECTED COMMAND STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_STRING

  cmdStr$ = tiraParseExpression$(cmdStart, endIdx, ALIM)
  IF cmdStr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "COMMAND MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Extract raw pointer to our seamlessly null-terminated C string in memory
  strDataPtr$ = tiraGetStringData$(cmdStr$)

  hideVal$ = tiraDimVar$("T", TYPE_LONG)
  IF hasHide = 1 THEN
    tiraAssign hideVal$, "0" ' SW_HIDE flag
  ELSE
    tiraAssign hideVal$, "1" ' SW_SHOWNORMAL flag
  END IF

  IF hasDontWait = 1 THEN
    ' WinExec remains the asynchronous path for SHELL _DONTWAIT
    tiraCall "IAT_WINEXEC", 2, strDataPtr$ + ", " + hideVal$
  ELSE
    strLen$ = tiraGetStringLen$(cmdStr$)

    ' Reserve one aligned block for STARTUPINFOA and PROCESS_INFORMATION before the variable-length command buffer
    structRawPtr$ = tiraAllocTempMem$("135")
    startupInfoPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, startupInfoPtr$, structRawPtr$, "7"
    tiraOp TC_AND, startupInfoPtr$, startupInfoPtr$, "-8"

    processInfoPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, processInfoPtr$, startupInfoPtr$, "104"

    tiraMemSet startupInfoPtr$, "0", "128"
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 0, 104, 4" ' STARTUPINFOA.cb
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 60, 1, 4" ' STARTF_USESHOWWINDOW
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 64, " + hideVal$ + ", 2" ' STARTUPINFOA.wShowWindow

    ' CreateProcessA requires a writable null-terminated command-line buffer
    cmdAllocSize$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, cmdAllocSize$, strLen$, "1"
    cmdBuffer$ = tiraAllocTempMem$(cmdAllocSize$)
    tiraMemcpy cmdBuffer$, strDataPtr$, strLen$

    nullPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, nullPtr$, cmdBuffer$, strLen$
    tiraWriteMem nullPtr$, "0", "1"

    tiraCall "IAT_CREATEPROCESSA", 10, "0, " + cmdBuffer$ + ", 0, 0, 0, 0, 0, 0, " + startupInfoPtr$ + ", " + processInfoPtr$
    createResult$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_GET_RET, createResult$

    doneLbl$ = tiraLabelCreateNew$("SHELL_DONE")
    tiraJmpCond "JE", createResult$, "0", doneLbl$

    processHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, processHandle$ + ", " + processInfoPtr$

    threadHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM_OFFSET, threadHandle$ + ", " + processInfoPtr$ + ", 8"

    tiraCall "IAT_WAITFORSINGLEOBJECT", 2, processHandle$ + ", -1"
    tiraCall "IAT_CLOSEHANDLE", 1, processHandle$
    tiraCall "IAT_CLOSEHANDLE", 1, threadHandle$

    tiraLabel doneLbl$
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SHELL = 1

END FUNCTION ' parse_SHELL

''''''''''''''''''''''''
FUNCTION parse_SIN$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM singleRes$
  DIM argFloat$

  IF checkIntrinsicSyntax(startIdx, endIdx, "SIN", 3) = 0 THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("SIN", "_VAL")
  IF scratchName$ = "" THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
    tiraAssign argFloat$, arg1$
    arg1$ = argFloat$
  END IF

  tiraCall "IAT_SIN", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_SIN$ = scratchName$

END FUNCTION ' parse_SIN$

''''''''''''''''''''''''
FUNCTION parse_SOURCE (startIdx)

  DIM endIdx AS LONG
  DIM pageVar$
  DIM lblSrc0$
  DIM lblSrc1$
  DIM lblSrc2$
  DIM lblSrc3$
  DIM lblSrcEnd$

  endIdx = lineTokenCount - 1

  IF compileHasGraphics = 0 THEN
    throwCompilerError "_SOURCE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED PAGE NUMBER AFTER _SOURCE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  pageVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "PAGE MUST BE NUMERIC")
  IF pageVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  tiraJmpCond "JE", pageVar$, "0", lblSrc0$
  tiraJmpCond "JE", pageVar$, "1", lblSrc1$
  tiraJmpCond "JE", pageVar$, "2", lblSrc2$
  tiraJmpCond "JE", pageVar$, "3", lblSrc3$
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc0$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_FRONT"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_FRONT"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_FRONT", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE2"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE2", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE3"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE3", ""

  tiraLabel lblSrcEnd$
  tiraAssign "!G_GFX_VAL_SRC_PAGE", pageVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SOURCE = 1

END FUNCTION ' parse_SOURCE

''''''''''''''''''''''''
FUNCTION parse_SOURCE_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SOURCE", ASIS, 0
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("SOURCE", "_VAL")
  IF scratchName$ = "" THEN
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "!G_GFX_VAL_SRC_PAGE"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SOURCE_FUNC$ = scratchName$

END FUNCTION ' parse_SOURCE_FUNC$

''''''''''''''''''''''''
FUNCTION parse_STRINGFUNC$ (startIdx, endIdx, allowImplicit)

  DIM comma1 AS LONG
  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM descPtr$
  DIM dataPtr$
  DIM charByte$
  DIM isStringChar AS LONG
  DIM strLen$
  DIM strData$
  DIM lblEmpty$
  DIM lblNotEmpty$
  DIM lblValidCount$
  DIM lblDoAlloc$
  DIM lblDone$
  DIM errStr$
  DIM tmpByte$

  IF checkIntrinsicSyntax(startIdx, endIdx, "STRING$", 5) = 0 THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "STRING$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
  arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "STRING$ ARG 1 MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  expectedSymType = TYPE_ANY
  arg2$ = tiraParseExpression$(comma1 + 1, endIdx - 1, allowImplicit)
  IF arg2$ = "" THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  isStringChar = 0
  IF exprIs.DataType = TYPE_STRING THEN isStringChar = 1

  scratchName$ = tiraResolveHoistVar$("STRF", "_DSC")
  IF scratchName$ = "" THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  lblValidCount$ = tiraLabelCreateNew$("STRF_VCNT")
  tiraJmpCond "JGE", arg1$, "0", lblValidCount$

  errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$ ON LINE " + retLineNumberStr$ + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel lblValidCount$

  charByte$ = tiraDimVar$("T", TYPE_LONG)

  IF isStringChar = 1 THEN
    strLen$ = tiraGetStringLen$(arg2$)

    lblEmpty$ = tiraLabelCreateNew$("STRF_MT")
    lblNotEmpty$ = tiraLabelCreateNew$("STRF_NMT")

    tiraJmpCond "JLE", strLen$, "0", lblEmpty$

    strData$ = tiraGetStringData$(arg2$)
    tmpByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, tmpByte$ + ", " + strData$
    tiraAssign charByte$, tmpByte$
    tiraJmp lblNotEmpty$

    tiraLabel lblEmpty$
    errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$ ON LINE " + retLineNumberStr$ + CHR$(34)
    tiraCall "RT_PRINT_STR", 1, errStr$
    tiraCall "RT_CRLF", 0, ""
    tiraJmp "@END_PROGRAM"

    tiraLabel lblNotEmpty$
  ELSE
    tiraOp TC_AND, charByte$, arg2$, "255"
  END IF

  lblDoAlloc$ = tiraLabelCreateNew$("STRF_ALLOC")
  lblDone$ = tiraLabelCreateNew$("STRF_DONE")

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  tiraJmpCond "JG", arg1$, "0", lblDoAlloc$

  tiraBuildStringDescriptor descPtr$, "0", "0", "0"
  tiraJmp lblDone$

  tiraLabel lblDoAlloc$
  dataPtr$ = tiraAllocTempMem$(arg1$)

  tiraMemSet dataPtr$, charByte$, arg1$

  tiraBuildStringDescriptor descPtr$, dataPtr$, arg1$, "0"

  tiraLabel lblDone$

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_STRINGFUNC$ = scratchName$

END FUNCTION ' parse_STRINGFUNC$

''''''''''''''''''''''''

''''''''''''''''''''''''
FUNCTION parse_SYSTEM (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx > startIdx THEN
    exprVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "SYSTEM REQUIRES NUMERIC")
    IF exprVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    ff = resolveSymbol("!G_SYS_VAL_EXIT")
    IF ff = 1 THEN
      tiraAssign "!G_SYS_VAL_EXIT", exprVar$
    END IF
  END IF

  tiraJmp "@END_PROGRAM"

  tira_EndAndProcess

  parse_SYSTEM = 1

END FUNCTION ' parse_SYSTEM

''''''''''''''''''''''''
FUNCTION parse_THROWERR (startIdx)

  ' This function evaluates the THROWERR command, which replaces the legacy MEMERROR command
  ' It intentionally triggers specific compiler or runtime errors for testing the error handler subsystems
  ' Because the internal symbol resolver operates strictly at compile-time, we evaluate the
  ' provided argument statically here in the frontend to determine which error state to trigger
  '
  ' Argument 0: Injects TC_MEMERROR into the TIRA queue to trigger a runtime memory access violation
  ' Argument 1: Triggers a compile-time fatal error by attempting to resolve an invalid
  '             internal variable (!G_ZZZ_VAL_TEST) to test the strict subsystem validation logic
  ' Argument 3: Triggers a very long compile-time error to test multi-line status bar clicking

  DIM endIdx AS LONG
  DIM argStr$
  DIM errCode AS LONG
  DIM ii AS LONG

  endIdx = lineTokenCount - 1

  ' Check to make sure the user provided an argument after the command
  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED ERROR CODE AFTER THROWERR", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Evaluate the argument text statically at compile time to branch the logic
  argStr$ = ""
  FOR ii = startIdx + 1 TO endIdx
    argStr$ = argStr$ + retTokenText$(lineTokens$(ii))
  NEXT

  argStr$ = evalMathConst$(argStr$)
  errCode = VAL(argStr$)

  IF errCode = 1 THEN
    ' Test the strict validation subsystem with an invalid ZZZ subsystem identifier
    ' This immediately triggers a fatal compiler error detailing the bad variable name
    ff = resolveInternalSymbol("!G_ZZZ_VAL_TEST", 0)

    ' We still start and end a TIRA block to maintain sequential structural integrity
    ' and ensure the internal tracking mechanism remains flawlessly synchronized
    tira_Start
    tiraScheduleHeapReset
    tira_EndAndProcess
  ELSE
    IF errCode = 3 THEN
      throwCompilerError "THIS IS A DELIBERATELY LONG ERROR MESSAGE DESIGNED SPECIFICALLY TO EXCEED THE WIDTH OF THE STATUS BAR SO IT WRAPS INTO MULTIPLE LINES FOR CLICK TESTING", ASIS, 0

      tira_Start
      tiraScheduleHeapReset
      tira_EndAndProcess
    ELSE
      ' Force an immediate runtime access violation by writing to a null pointer natively via TC_MEMERROR
      tira_Start

      tiraNew TC_MEMERROR, ""

      tiraScheduleHeapReset
      tira_EndAndProcess
    END IF
  END IF

  parse_THROWERR = 1

END FUNCTION ' parse_THROWERR

''''''''''''''''''''''''
FUNCTION parse_TIMER$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM tickVal$
  DIM tickDouble$
  DIM resVar$
  DIM singleRes$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED TIMER", ASIS, 0
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("TIMER", "_VAL")
  IF scratchName$ = "" THEN
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  tiraCall "IAT_GETTICKCOUNT", 0, ""

  tickVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, tickVal$

  tickDouble$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_CAST, tickDouble$, tickVal$, LTRIM$(STR$(TYPE_DOUBLE))

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_DIV, resVar$, tickDouble$, "1000.0#"

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_TIMER$ = scratchName$

END FUNCTION ' parse_TIMER$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_TRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM origPtr$
  DIM origLen$
  DIM dataPtr$
  DIM strLen$
  DIM endPtr$
  DIM loopLeftTop$
  DIM loopLeftDone$
  DIM loopRightTop$
  DIM loopRightDone$
  DIM byteVal$
  DIM isSpaceLLbl$
  DIM isSpaceRLbl$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_TRIM$", 3) = 0 THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_STRING
  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_TRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("TRIM", "_DSC")
  IF scratchName$ = "" THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  origPtr$ = tiraGetStringData$(arg1$)
  origLen$ = tiraGetStringLen$(arg1$)

  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign dataPtr$, origPtr$
  strLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign strLen$, origLen$

  loopLeftTop$ = tiraLabelCreateNew$("TRIM_L_LOOP")
  loopLeftDone$ = tiraLabelCreateNew$("TRIM_L_DONE")

  tiraLabel loopLeftTop$
  tiraJmpCond "JLE", strLen$, "0", loopLeftDone$

  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + dataPtr$

  isSpaceLLbl$ = tiraLabelCreateNew$("TRIM_L_IS_SPC")
  tiraJmpCond "JE", byteVal$, "32", isSpaceLLbl$
  tiraJmpCond "JNE", byteVal$, "9", loopLeftDone$
  tiraLabel isSpaceLLbl$

  tiraOp TC_ADD, dataPtr$, dataPtr$, "1"
  tiraOp TC_SUB, strLen$, strLen$, "1"
  tiraJmp loopLeftTop$

  tiraLabel loopLeftDone$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, endPtr$, dataPtr$, strLen$
  tiraOp TC_SUB, endPtr$, endPtr$, "1"

  loopRightTop$ = tiraLabelCreateNew$("TRIM_R_LOOP")
  loopRightDone$ = tiraLabelCreateNew$("TRIM_R_DONE")

  tiraLabel loopRightTop$
  tiraJmpCond "JLE", strLen$, "0", loopRightDone$

  tiraNew TC_READ_MEM, byteVal$ + ", " + endPtr$

  isSpaceRLbl$ = tiraLabelCreateNew$("TRIM_R_IS_SPC")
  tiraJmpCond "JE", byteVal$, "32", isSpaceRLbl$
  tiraJmpCond "JNE", byteVal$, "9", loopRightDone$
  tiraLabel isSpaceRLbl$

  tiraOp TC_SUB, endPtr$, endPtr$, "1"
  tiraOp TC_SUB, strLen$, strLen$, "1"
  tiraJmp loopRightTop$

  tiraLabel loopRightDone$

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStringDescriptor descPtr$, dataPtr$, strLen$, "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_TRIM$ = scratchName$

END FUNCTION ' parse_TRIM$

''''''''''''''''''''''''
FUNCTION parse_WHEEL$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_WHEEL", 3) = 0 THEN
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("WHEEL", "_VAL")
  IF scratchName$ = "" THEN
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraCall "RT_WHEEL", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WHEEL$ = scratchName$

END FUNCTION ' parse_WHEEL$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_WIDTH$ (startIdx, endIdx, allowImplicit)
  ' Func version, will need to change names later when WIDTH without underscore is supported

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM resWidth AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("WIDTH", "_VAL")
  IF scratchName$ = "" THEN
    parse_WIDTH$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resWidth = 120
  IF compileHasGraphics = 1 THEN resWidth = gfxConfig.SizeX

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, LTRIM$(STR$(resWidth))

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WIDTH$ = scratchName$

END FUNCTION ' parse_WIDTH$

''''''''''''''''''''''''
FUNCTION parse_WINDOWHANDLE$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _WINDOWHANDLE", ASIS, 0
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("WNDHND", "_VAL")
  IF scratchName$ = "" THEN
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly force the data type to 64-bit integer
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_INTEGER64

  resVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF compileHasGraphics = 1 THEN
    tiraAssign resVar$, "!G_WND_VAL_HWND"
  ELSE
    tiraCall "IAT_GETCONSOLEWINDOW", 0, ""
    tiraNew TC_GET_RET, resVar$
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_WINDOWHANDLE$ = scratchName$

END FUNCTION ' parse_WINDOWHANDLE$


''''''''''''''''''''''''
SUB waitKeyRelease (wKey$)

  DIM currentDest AS LONG

  currentDest = _DEST

  IF currentDest = logicalScreen THEN
    dispScreenFlushUpdate ' Logical-screen modals still require their normal scaled presentation
  ELSE
    _DISPLAY ' Physical screen content is already complete and must not be replaced by logicalScreen
  END IF

  DO
  LOOP UNTIL keyCheck(wKey$) = 0

END SUB ' waitKeyRelease

''''''''''''''''''''''''
SUB waitTimer (wSeconds)

  tGoal = TIMER + wSeconds
  DO WHILE TIMER < tGoal
  LOOP

END SUB ' waitTimer

