END SUB ' initKeyMapping

''''''''''''''''''''''''
SUB emitRuntimeAxis

  DIM arg1Idx AS LONG
  DIM resVarIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM calcLblIdx AS LONG
  DIM axis1LblIdx AS LONG
  DIM axis2LblIdx AS LONG
  DIM axis3LblIdx AS LONG
  DIM axis4LblIdx AS LONG
  DIM axis5LblIdx AS LONG
  DIM axis6LblIdx AS LONG
  DIM axisValIdx AS LONG
  DIM scaleValIdx AS LONG
  DIM axisSingleIdx AS LONG
  DIM gamepadValidIdx AS LONG
  DIM gamepadLXIdx AS LONG
  DIM gamepadLYIdx AS LONG
  DIM gamepadRXIdx AS LONG
  DIM gamepadRYIdx AS LONG
  DIM gamepadLTIdx AS LONG
  DIM gamepadRTIdx AS LONG

  rtOffset(RT_AXIS) = stream.emitPos

  ff = resolveSymbol("!G_INO_FLG_GAMEPAD_VALID")
  IF ff = 0 THEN EXIT SUB
  gamepadValidIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LX")
  IF ff = 0 THEN EXIT SUB
  gamepadLXIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LY")
  IF ff = 0 THEN EXIT SUB
  gamepadLYIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RX")
  IF ff = 0 THEN EXIT SUB
  gamepadRXIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RY")
  IF ff = 0 THEN EXIT SUB
  gamepadRYIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LT")
  IF ff = 0 THEN EXIT SUB
  gamepadLTIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RT")
  IF ff = 0 THEN EXIT SUB
  gamepadRTIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1Idx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1Idx, 1

  ' For now we will return 0 as a placeholder stub
  resVarIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  doneLblIdx = tiraLabelCreateNewId&("AXIS_DONE")
  calcLblIdx = tiraLabelCreateNewId&("AXIS_CALC")
  axis1LblIdx = tiraLabelCreateNewId&("AXIS_1")
  axis2LblIdx = tiraLabelCreateNewId&("AXIS_2")
  axis3LblIdx = tiraLabelCreateNewId&("AXIS_3")
  axis4LblIdx = tiraLabelCreateNewId&("AXIS_4")
  axis5LblIdx = tiraLabelCreateNewId&("AXIS_5")
  axis6LblIdx = tiraLabelCreateNewId&("AXIS_6")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gamepadValidIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 1, axis1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 2, axis2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 3, axis3LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 4, axis4LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 5, axis5LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 6, axis6LblIdx
  tiraJmpId doneLblIdx

  axisValIdx = tiraDimVarId&("T", TYPE_LONG)
  scaleValIdx = tiraDimVarId&("T", TYPE_SINGLE)

  tiraLabelId axis1LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadLXIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis2LblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, gamepadLYIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis3LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadRXIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis4LblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, gamepadRYIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis5LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadLTIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 255
  tiraJmpId calcLblIdx

  tiraLabelId axis6LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadRTIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 255

  tiraLabelId calcLblIdx
  axisSingleIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, axisSingleIdx, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, TYPE_SINGLE
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, axisSingleIdx, TIRA_ARG_SYMBOL, scaleValIdx

  tiraLabelId doneLblIdx
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeAxis

''''''''''''''''''''''''
SUB emitRuntimeBload

  DIM argFileDescIdx AS LONG
  DIM argOffsetIdx AS LONG
  DIM argHasOffsetIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM nullTermStrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM createFileIdx AS LONG
  DIM hFileIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM headerPtrIdx AS LONG
  DIM bytesReadIdx AS LONG
  DIM bytesReadPtrIdx AS LONG
  DIM readFileIdx AS LONG
  DIM lblCloseIdx AS LONG
  DIM firstByteIdx AS LONG
  DIM loadOffsetIdx AS LONG
  DIM offsetReadyLblIdx AS LONG
  DIM headerOffsetIdx AS LONG
  DIM loadPtrIdx AS LONG
  DIM directPtrLblIdx AS LONG
  DIM frameBufferIdx AS LONG
  DIM dataLength16Idx AS LONG
  DIM dataLengthIdx AS LONG
  DIM getFileSizeIdx AS LONG
  DIM fileSizeIdx AS LONG
  DIM skipLengthUpdateIdx AS LONG
  DIM closeHandleIdx AS LONG

  rtOffset(38) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  argFileDescIdx = tiraDimVarId&("FILE", TYPE_INTEGER64)
  tiraAbiReadArgId argFileDescIdx, 1

  argOffsetIdx = tiraDimVarId&("OFFSET", TYPE_INTEGER64)
  tiraAbiReadArgId argOffsetIdx, 2

  argHasOffsetIdx = tiraDimVarId&("HASOFFSET", TYPE_LONG)
  tiraAbiReadArgId argHasOffsetIdx, 3

  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFileDescIdx)
  strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFileDescIdx)

  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  nullTermStrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, allocSizeIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx

  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("IAT_CREATEFILEA")
  createFileIdx = returnedData2
  tiraCallId7 createFileIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_LITERAL, -2147483648, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 3, TIRA_ARG_LITERAL, 128, TIRA_ARG_LITERAL, 0
  hFileIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hFileIdx

  lblDoneIdx = tiraLabelCreateNewId&("BLOAD_DONE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, -1, lblDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  headerPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 7)
  bytesReadIdx = tiraDimVarId&("T", TYPE_LONG)
  bytesReadPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_SYMBOL, bytesReadIdx

  ff = resolveSymbol("IAT_READFILE")
  readFileIdx = returnedData2
  tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 7, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

  lblCloseIdx = tiraLabelCreateNewId&("BLOAD_CLOSE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, bytesReadIdx, TIRA_ARG_LITERAL, 7, lblCloseIdx

  firstByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId firstByteIdx, TIRA_ARG_SYMBOL, headerPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, firstByteIdx, TIRA_ARG_LITERAL, 253, lblCloseIdx

  loadOffsetIdx = tiraDimVarId&("LOADOFFSET", TYPE_INTEGER64)
  tiraAssignId loadOffsetIdx, TIRA_ARG_SYMBOL, argOffsetIdx

  offsetReadyLblIdx = tiraLabelCreateNewId&("BLOAD_OFFSET_READY")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, argHasOffsetIdx, TIRA_ARG_LITERAL, 0, offsetReadyLblIdx

  ' Use the stored legacy offset when the source omits the optional argument
  headerOffsetIdx = tiraDimVarId&("HEADEROFFSET", TYPE_UINTEGER)
  tiraReadMemOffsetId headerOffsetIdx, TIRA_ARG_SYMBOL, headerPtrIdx, 3
  tiraAssignId loadOffsetIdx, TIRA_ARG_SYMBOL, headerOffsetIdx

  tiraLabelId offsetReadyLblIdx

  loadPtrIdx = tiraDimVarId&("LOADPTR", TYPE_INTEGER64)
  tiraAssignId loadPtrIdx, TIRA_ARG_SYMBOL, loadOffsetIdx

  IF cm.HasGraphics = 1 THEN
    ' Low addresses are legacy offsets into the active framebuffer while VARPTR produces a real process address
    directPtrLblIdx = tiraLabelCreateNewId&("BLOAD_DIRECT_PTR")
    tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, loadOffsetIdx, TIRA_ARG_LITERAL, 65535, directPtrLblIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    frameBufferIdx = returnedData2
    tiraAssignId loadPtrIdx, TIRA_ARG_SYMBOL, frameBufferIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, loadOffsetIdx
    tiraLabelId directPtrLblIdx
  END IF

  ' Use a 16-bit extraction to ensure we strictly capture the standard legacy length bounds
  dataLength16Idx = tiraDimVarId&("T", TYPE_INTEGER)
  tiraReadMemOffsetId dataLength16Idx, TIRA_ARG_SYMBOL, headerPtrIdx, 5

  dataLengthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId dataLengthIdx, TIRA_ARG_SYMBOL, dataLength16Idx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_LITERAL, 65535

  ff = resolveSymbol("IAT_GETFILESIZE")
  getFileSizeIdx = returnedData2
  tiraCallId2 getFileSizeIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0
  fileSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId fileSizeIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fileSizeIdx, TIRA_ARG_SYMBOL, fileSizeIdx, TIRA_ARG_LITERAL, 7

  skipLengthUpdateIdx = tiraLabelCreateNewId&("BLOAD_SKIP_LEN")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_LITERAL, 0, skipLengthUpdateIdx
  tiraAssignId dataLengthIdx, TIRA_ARG_SYMBOL, fileSizeIdx
  tiraLabelId skipLengthUpdateIdx

  tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId lblCloseIdx

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  closeHandleIdx = returnedData2
  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, hFileIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeBload

''''''''''''''''''''''''
SUB emitRuntimeBsave

  DIM argFileDescIdx AS LONG
  DIM argOffsetIdx AS LONG
  DIM argLengthIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM nullTermStrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM createFileIdx AS LONG
  DIM hFileIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM headerPtrIdx AS LONG
  DIM headerLenIdx AS LONG
  DIM skipLenClampIdx AS LONG
  DIM bytesWrittenIdx AS LONG
  DIM bytesWrittenPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM closeHandleIdx AS LONG

  rtOffset(39) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  argFileDescIdx = tiraDimVarId&("FILE", TYPE_INTEGER64)
  tiraAbiReadArgId argFileDescIdx, 1

  argOffsetIdx = tiraDimVarId&("OFFSET", TYPE_INTEGER64)
  tiraAbiReadArgId argOffsetIdx, 2

  argLengthIdx = tiraDimVarId&("LENGTH", TYPE_LONG)
  tiraAbiReadArgId argLengthIdx, 3

  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFileDescIdx)
  strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFileDescIdx)

  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  nullTermStrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, allocSizeIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx

  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("IAT_CREATEFILEA")
  createFileIdx = returnedData2
  tiraCallId7 createFileIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_LITERAL, 1073741824, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 2, TIRA_ARG_LITERAL, 128, TIRA_ARG_LITERAL, 0
  hFileIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hFileIdx

  lblDoneIdx = tiraLabelCreateNewId&("BSAVE_DONE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, -1, lblDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  headerPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 7)
  tiraWriteMemId TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 253, TIRA_ARG_LITERAL, 1
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, headerPtrIdx, 1, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 4

  headerLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId headerLenIdx, TIRA_ARG_SYMBOL, argLengthIdx
  skipLenClampIdx = tiraLabelCreateNewId&("BSAVE_SKIP_CLAMP")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, headerLenIdx, TIRA_ARG_LITERAL, 65535, skipLenClampIdx
  tiraAssignId headerLenIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId skipLenClampIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, headerPtrIdx, 5, TIRA_ARG_SYMBOL, headerLenIdx, TIRA_ARG_LITERAL, 2

  bytesWrittenIdx = tiraDimVarId&("T", TYPE_LONG)
  bytesWrittenPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_SYMBOL, bytesWrittenIdx

  ff = resolveSymbol("IAT_WRITEFILE")
  writeFileIdx = returnedData2
  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 7, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_LITERAL, 0
  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, argOffsetIdx, TIRA_ARG_SYMBOL, argLengthIdx, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_LITERAL, 0

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  closeHandleIdx = returnedData2
  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, hFileIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeBsave

''''''''''''''''''''''''
SUB emitRuntimeButton

  DIM arg1Idx AS LONG
  DIM resVarIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM checkLblIdx AS LONG
  DIM button1LblIdx AS LONG
  DIM button2LblIdx AS LONG
  DIM button3LblIdx AS LONG
  DIM button4LblIdx AS LONG
  DIM button5LblIdx AS LONG
  DIM button6LblIdx AS LONG
  DIM button7LblIdx AS LONG
  DIM button8LblIdx AS LONG
  DIM button9LblIdx AS LONG
  DIM button10LblIdx AS LONG
  DIM button11LblIdx AS LONG
  DIM button12LblIdx AS LONG
  DIM button13LblIdx AS LONG
  DIM button14LblIdx AS LONG
  DIM maskValIdx AS LONG
  DIM pressedValIdx AS LONG
  DIM gamepadValidIdx AS LONG
  DIM gamepadButtonsIdx AS LONG

  rtOffset(RT_BUTTON) = stream.emitPos

  ff = resolveSymbol("!G_INO_FLG_GAMEPAD_VALID")
  IF ff = 0 THEN EXIT SUB
  gamepadValidIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_BUTTONS")
  IF ff = 0 THEN EXIT SUB
  gamepadButtonsIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1Idx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1Idx, 1

  ' For now we will return 0 as a placeholder stub
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  doneLblIdx = tiraLabelCreateNewId&("BUTTON_DONE")
  checkLblIdx = tiraLabelCreateNewId&("BUTTON_CHECK")
  button1LblIdx = tiraLabelCreateNewId&("BUTTON_1")
  button2LblIdx = tiraLabelCreateNewId&("BUTTON_2")
  button3LblIdx = tiraLabelCreateNewId&("BUTTON_3")
  button4LblIdx = tiraLabelCreateNewId&("BUTTON_4")
  button5LblIdx = tiraLabelCreateNewId&("BUTTON_5")
  button6LblIdx = tiraLabelCreateNewId&("BUTTON_6")
  button7LblIdx = tiraLabelCreateNewId&("BUTTON_7")
  button8LblIdx = tiraLabelCreateNewId&("BUTTON_8")
  button9LblIdx = tiraLabelCreateNewId&("BUTTON_9")
  button10LblIdx = tiraLabelCreateNewId&("BUTTON_10")
  button11LblIdx = tiraLabelCreateNewId&("BUTTON_11")
  button12LblIdx = tiraLabelCreateNewId&("BUTTON_12")
  button13LblIdx = tiraLabelCreateNewId&("BUTTON_13")
  button14LblIdx = tiraLabelCreateNewId&("BUTTON_14")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gamepadValidIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 1, button1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 2, button2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 3, button3LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 4, button4LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 5, button5LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 6, button6LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 7, button7LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 8, button8LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 9, button9LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 10, button10LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 11, button11LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 12, button12LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 13, button13LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 14, button14LblIdx
  tiraJmpId doneLblIdx

  maskValIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraLabelId button1LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 16384
  tiraJmpId checkLblIdx

  tiraLabelId button2LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 8192
  tiraJmpId checkLblIdx

  tiraLabelId button3LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 4096
  tiraJmpId checkLblIdx

  tiraLabelId button4LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId checkLblIdx

  tiraLabelId button5LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 256
  tiraJmpId checkLblIdx

  tiraLabelId button6LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 512
  tiraJmpId checkLblIdx

  tiraLabelId button7LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 64
  tiraJmpId checkLblIdx

  tiraLabelId button8LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 128
  tiraJmpId checkLblIdx

  tiraLabelId button9LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 32
  tiraJmpId checkLblIdx

  tiraLabelId button10LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 16
  tiraJmpId checkLblIdx

  tiraLabelId button11LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId checkLblIdx

  tiraLabelId button12LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId checkLblIdx

  tiraLabelId button13LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 4
  tiraJmpId checkLblIdx

  tiraLabelId button14LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 8

  tiraLabelId checkLblIdx
  pressedValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pressedValIdx, TIRA_ARG_SYMBOL, gamepadButtonsIdx, TIRA_ARG_SYMBOL, maskValIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pressedValIdx, TIRA_ARG_LITERAL, 0, doneLblIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId doneLblIdx
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeButton

''''''''''''''''''''''''
SUB emitRuntimeClipboardGet

  DIM descPtrIdx AS LONG
  DIM lblFailIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM isFormatAvailableIdx AS LONG
  DIM availIdx AS LONG
  DIM openClipboardIdx AS LONG
  DIM resOpenIdx AS LONG
  DIM getClipboardDataIdx AS LONG
  DIM hMemIdx AS LONG
  DIM globalLockIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM lenVarIdx AS LONG
  DIM lblLenTopIdx AS LONG
  DIM lblLenDoneIdx AS LONG
  DIM checkAddrIdx AS LONG
  DIM byteValIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM globalUnlockIdx AS LONG
  DIM closeClipboardIdx AS LONG

  rtOffset(RT_GET_CLIPBOARD) = stream.emitPos

  ff = resolveSymbol("IAT_ISCLIPBOARDFORMATAVAILABLE")
  IF ff = 0 THEN EXIT SUB
  isFormatAvailableIdx = returnedData2

  ff = resolveSymbol("IAT_OPENCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  openClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_GETCLIPBOARDDATA")
  IF ff = 0 THEN EXIT SUB
  getClipboardDataIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALLOCK")
  IF ff = 0 THEN EXIT SUB
  globalLockIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN EXIT SUB
  tempHeapIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALUNLOCK")
  IF ff = 0 THEN EXIT SUB
  globalUnlockIdx = returnedData2

  ff = resolveSymbol("IAT_CLOSECLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  closeClipboardIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  ' Retrieve pointer to the uninitialized descriptor struct requesting the copied string
  descPtrIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId descPtrIdx, 1

  lblFailIdx = tiraLabelCreateNewId&("CGET_FAIL")
  lblDoneIdx = tiraLabelCreateNewId&("CGET_DONE")

  ' Check if standard string text exists on the clipboard natively via IsClipboardFormatAvailable(CF_TEXT = 1)
  tiraCallId1 isFormatAvailableIdx, TIRA_ARG_LITERAL, 1
  availIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId availIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, availIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Request ownership of the clipboard hardware
  tiraCallId1 openClipboardIdx, TIRA_ARG_LITERAL, 0
  resOpenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resOpenIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, resOpenIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Retrieve Global Handle pointing to the clipboard's CF_TEXT memory
  tiraCallId1 getClipboardDataIdx, TIRA_ARG_LITERAL, 1
  hMemIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hMemIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hMemIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Lock hardware memory temporarily to safely read the bytes
  tiraCallId1 globalLockIdx, TIRA_ARG_SYMBOL, hMemIdx
  srcPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId srcPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  lenVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId lenVarIdx, TIRA_ARG_LITERAL, 0
  lblLenTopIdx = tiraLabelCreateNewId&("CGET_LENTOP")
  lblLenDoneIdx = tiraLabelCreateNewId&("CGET_LENDONE")

  ' Execute a high-speed manual strlen iteration to identify exactly where the clipboard data stops
  tiraLabelId lblLenTopIdx
  checkAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, checkAddrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx
  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, checkAddrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 0, lblLenDoneIdx ' Stop exactly when the hardware null terminator is found
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLenTopIdx
  tiraLabelId lblLenDoneIdx

  ' Safely allocate destination buffer internally using Temp Heap methodology to prevent memory leaks
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, lenVarIdx
  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  ' Transfer clipboard data into localized execution memory
  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx

  tiraCallId1 globalUnlockIdx, TIRA_ARG_SYMBOL, hMemIdx

  tiraCallId0 closeClipboardIdx

  ' Tie the returned address back up to the source descriptor cleanly. Flag is 0 because the string lives on the Temp Heap.
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId lblDoneIdx

  tiraLabelId lblFailIdx

  ' If format missing or extraction fails, cleanly fall back and return an empty string safely to avoid crashing
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraCallId0 closeClipboardIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardGet

''''''''''''''''''''''''
SUB emitRuntimeClipboardSet

  DIM arg1VarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM lblEmptyIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM openClipboardIdx AS LONG
  DIM resOpenIdx AS LONG
  DIM emptyClipboardIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM globalAllocIdx AS LONG
  DIM hMemIdx AS LONG
  DIM globalLockIdx AS LONG
  DIM destPtrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM globalUnlockIdx AS LONG
  DIM setClipboardDataIdx AS LONG
  DIM closeClipboardIdx AS LONG

  rtOffset(RT_SET_CLIPBOARD) = stream.emitPos

  ff = resolveSymbol("IAT_OPENCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  openClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_EMPTYCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  emptyClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALALLOC")
  IF ff = 0 THEN EXIT SUB
  globalAllocIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALLOCK")
  IF ff = 0 THEN EXIT SUB
  globalLockIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALUNLOCK")
  IF ff = 0 THEN EXIT SUB
  globalUnlockIdx = returnedData2

  ff = resolveSymbol("IAT_SETCLIPBOARDDATA")
  IF ff = 0 THEN EXIT SUB
  setClipboardDataIdx = returnedData2

  ff = resolveSymbol("IAT_CLOSECLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  closeClipboardIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  ' Read string descriptor argument directly from caller stack footprint
  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

  lblEmptyIdx = tiraLabelCreateNewId&("CLIP_EMPTY")
  lblDoneIdx = tiraLabelCreateNewId&("CLIP_DONE")

  ' Request ownership of the Clipboard hardware natively using parameter zero
  tiraCallId1 openClipboardIdx, TIRA_ARG_LITERAL, 0
  resOpenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resOpenIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, resOpenIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx ' Failed to open, gracefully abort

  ' We must successfully empty the clipboard before attempting to set new content
  tiraCallId0 emptyClipboardIdx

  ' If the length is empty, jump to the end where we close and return safely
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx

  ' Request Global Memory block ensuring we include space for the trailing null byte
  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  ' GlobalAlloc(GMEM_MOVEABLE = 2, allocSize)
  tiraCallId2 globalAllocIdx, TIRA_ARG_LITERAL, 2, TIRA_ARG_SYMBOL, allocSizeIdx
  hMemIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hMemIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hMemIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx ' Alloc failed, exit cleanly

  ' Lock memory block to retrieve the physical pointer handle
  tiraCallId1 globalLockIdx, TIRA_ARG_SYMBOL, hMemIdx
  destPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId destPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx ' Lock failed, exit cleanly

  ' Clone string data into the globally allocated structure
  tiraMemcpyId TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  ' Inject null terminator physically at the end to satisfy Windows CF_TEXT ABI
  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  tiraCallId1 globalUnlockIdx, TIRA_ARG_SYMBOL, hMemIdx

  ' Finalize data handoff to Windows via SetClipboardData(CF_TEXT = 1, hMem)
  tiraCallId2 setClipboardDataIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, hMemIdx

  tiraLabelId lblEmptyIdx

  ' We must always release the clipboard so other programs do not get frozen
  tiraCallId0 closeClipboardIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardSet

''''''''''''''''''''''''
SUB emitRuntimeFullscreen

  DIM modeArgIdx AS LONG
  DIM fullscreenOffLabelIdx AS LONG
  DIM fullscreenDoneLabelIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG
  DIM clientWidthIdx AS LONG
  DIM clientHeightIdx AS LONG
  DIM skipScaleLblIdx AS LONG
  DIM rectLowIdx AS LONG
  DIM rectHighIdx AS LONG
  DIM rectPtrIdx AS LONG
  DIM rectLeftIdx AS LONG
  DIM rectTopIdx AS LONG
  DIM rectRightIdx AS LONG
  DIM rectBottomIdx AS LONG
  DIM outerWidthIdx AS LONG
  DIM outerHeightIdx AS LONG
  DIM widthCorrectionIdx AS LONG
  DIM heightCorrectionIdx AS LONG

  DIM gDoubleIdx AS LONG
  DIM isFullscreenIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM windowHwndIdx AS LONG
  DIM screenLogicalWidthIdx AS LONG
  DIM screenLogicalHeightIdx AS LONG

  DIM getSystemMetricsIdx AS LONG
  DIM setWindowLongIdx AS LONG
  DIM setWindowPosIdx AS LONG
  DIM adjustWindowRectIdx AS LONG

  rtOffset(RT_FULLSCREEN) = stream.emitPos

  ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
  IF ff = 0 THEN EXIT SUB
  gDoubleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
  IF ff = 0 THEN EXIT SUB
  isFullscreenIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_WIDTH")
  IF ff = 0 THEN EXIT SUB
  windowWidthIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HEIGHT")
  IF ff = 0 THEN EXIT SUB
  windowHeightIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 0 THEN EXIT SUB
  windowHwndIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNW")
  IF ff = 0 THEN EXIT SUB
  screenLogicalWidthIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNH")
  IF ff = 0 THEN EXIT SUB
  screenLogicalHeightIdx = returnedData2

  ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
  IF ff = 0 THEN EXIT SUB
  getSystemMetricsIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWLONGA")
  IF ff = 0 THEN EXIT SUB
  setWindowLongIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWPOS")
  IF ff = 0 THEN EXIT SUB
  setWindowPosIdx = returnedData2

  ff = resolveSymbol("IAT_ADJUSTWINDOWRECTEX")
  IF ff = 0 THEN EXIT SUB
  adjustWindowRectIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  modeArgIdx = tiraDimVarId&("ARGMODE", TYPE_LONG)
  tiraAbiReadArgId modeArgIdx, 1

  fullscreenOffLabelIdx = tiraLabelCreateNewId&("FULLSCREEN_OFF")
  fullscreenDoneLabelIdx = tiraLabelCreateNewId&("FULLSCREEN_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, modeArgIdx, TIRA_ARG_LITERAL, 0, fullscreenOffLabelIdx

  ' GetSystemMetrics(SM_CXSCREEN = 0)
  tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 0
  screenWidthIdx = tiraDimVarId&("FSSCREENWIDTH", TYPE_LONG)
  tiraGetRetId screenWidthIdx

  ' GetSystemMetrics(SM_CYSCREEN = 1)
  tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 1
  screenHeightIdx = tiraDimVarId&("FSSCREENHEIGHT", TYPE_LONG)
  tiraGetRetId screenHeightIdx

  tiraAssignId gDoubleIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId isFullscreenIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId windowWidthIdx, TIRA_ARG_SYMBOL, screenWidthIdx
  tiraAssignId windowHeightIdx, TIRA_ARG_SYMBOL, screenHeightIdx

  ' SetWindowLongA(HWND, GWL_STYLE = -16, WS_POPUP | WS_VISIBLE = -1879048192)
  tiraCallId3 setWindowLongIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -16, TIRA_ARG_LITERAL, -1879048192

  ' SetWindowPos(HWND, HWND_TOP = 0, 0, 0, cx, cy, SWP_SHOWWINDOW | SWP_FRAMECHANGED = 96)
  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, screenWidthIdx, TIRA_ARG_SYMBOL, screenHeightIdx, TIRA_ARG_LITERAL, 96

  tiraJmpId fullscreenDoneLabelIdx

  tiraLabelId fullscreenOffLabelIdx

  ' Avoid disturbing custom RES, MED or MAX states when fullscreen is already off
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFullscreenIdx, TIRA_ARG_LITERAL, 0, fullscreenDoneLabelIdx

  clientWidthIdx = tiraDimVarId&("FSCLIENTWIDTH", TYPE_LONG)
  clientHeightIdx = tiraDimVarId&("FSCLIENTHEIGHT", TYPE_LONG)

  tiraAssignId clientWidthIdx, TIRA_ARG_SYMBOL, screenLogicalWidthIdx
  tiraAssignId clientHeightIdx, TIRA_ARG_SYMBOL, screenLogicalHeightIdx

  skipScaleLblIdx = tiraLabelCreateNewId&("FS_SKIP_SCALE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gDoubleIdx, TIRA_ARG_LITERAL, 0, skipScaleLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_LITERAL, 2
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_LITERAL, 2
  tiraLabelId skipScaleLblIdx

  ' Two adjacent 64-bit temporaries provide the required 16-byte RECT
  rectLowIdx = tiraDimVarId&("FSRECTLOW", TYPE_INTEGER64)
  rectHighIdx = tiraDimVarId&("FSRECTHIGH", TYPE_INTEGER64)
  tiraAssignId rectLowIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId rectHighIdx, TIRA_ARG_LITERAL, 0

  rectPtrIdx = tiraDimVarId&("FSRECTPTR", TYPE_INTEGER64)
  ' Runtime locals grow downward, so the second temporary is the RECT base
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_SYMBOL, rectHighIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 8, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 12, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_LITERAL, 4

  ' Restore WS_OVERLAPPEDWINDOW
  tiraCallId3 setWindowLongIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -16, TIRA_ARG_LITERAL, 13565952
  tiraCallId4 adjustWindowRectIdx, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_LITERAL, 13565952, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  rectLeftIdx = tiraDimVarId&("FSRECTLEFT", TYPE_LONG)
  tiraReadMemId rectLeftIdx, TIRA_ARG_SYMBOL, rectPtrIdx

  rectTopIdx = tiraDimVarId&("FSRECTTOP", TYPE_LONG)
  tiraReadMemOffsetId rectTopIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 4

  rectRightIdx = tiraDimVarId&("FSRECTRIGHT", TYPE_LONG)
  tiraReadMemOffsetId rectRightIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 8

  rectBottomIdx = tiraDimVarId&("FSRECTBOTTOM", TYPE_LONG)
  tiraReadMemOffsetId rectBottomIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 12

  outerWidthIdx = tiraDimVarId&("FSOUTERWIDTH", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, rectRightIdx, TIRA_ARG_SYMBOL, rectLeftIdx

  outerHeightIdx = tiraDimVarId&("FSOUTERHEIGHT", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, rectBottomIdx, TIRA_ARG_SYMBOL, rectTopIdx

  ' HWND_NOTOPMOST with SWP_NOMOVE, SWP_FRAMECHANGED and SWP_SHOWWINDOW
  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  ' Correct each outer dimension from the actual client size reported by WM_SIZE
  widthCorrectionIdx = tiraDimVarId&("FSWIDTHCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthCorrectionIdx, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, windowWidthIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, widthCorrectionIdx

  heightCorrectionIdx = tiraDimVarId&("FSHEIGHTCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, heightCorrectionIdx, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, windowHeightIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, heightCorrectionIdx

  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  tiraAssignId isFullscreenIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId fullscreenDoneLabelIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeFullscreen

''''''''''''''''''''''''
SUB emitRuntimeGDouble

  DIM gDoubleIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG
  DIM hwndIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM fullscreenIdx AS LONG
  DIM setWindowLongIdx AS LONG
  DIM adjustWindowRectExIdx AS LONG
  DIM setWindowPosIdx AS LONG
  DIM clientWidthIdx AS LONG
  DIM clientHeightIdx AS LONG
  DIM rectLowIdx AS LONG
  DIM rectHighIdx AS LONG
  DIM rectPtrIdx AS LONG
  DIM rectLeftIdx AS LONG
  DIM rectTopIdx AS LONG
  DIM rectRightIdx AS LONG
  DIM rectBottomIdx AS LONG
  DIM outerWidthIdx AS LONG
  DIM outerHeightIdx AS LONG
  DIM widthCorrectionIdx AS LONG
  DIM heightCorrectionIdx AS LONG

  rtOffset(RT_GDOUBLE) = stream.emitPos

  ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
  IF ff = 0 THEN EXIT SUB
  gDoubleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNW")
  IF ff = 0 THEN EXIT SUB
  screenWidthIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNH")
  IF ff = 0 THEN EXIT SUB
  screenHeightIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 0 THEN EXIT SUB
  hwndIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_WIDTH")
  IF ff = 0 THEN EXIT SUB
  windowWidthIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HEIGHT")
  IF ff = 0 THEN EXIT SUB
  windowHeightIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
  IF ff = 0 THEN EXIT SUB
  fullscreenIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWLONGA")
  IF ff = 0 THEN EXIT SUB
  setWindowLongIdx = returnedData2

  ff = resolveSymbol("IAT_ADJUSTWINDOWRECTEX")
  IF ff = 0 THEN EXIT SUB
  adjustWindowRectExIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWPOS")
  IF ff = 0 THEN EXIT SUB
  setWindowPosIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  tiraAssignId gDoubleIdx, TIRA_ARG_LITERAL, 1

  clientWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  clientHeightIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, screenWidthIdx, TIRA_ARG_LITERAL, 2
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, screenHeightIdx, TIRA_ARG_LITERAL, 2

  ' Two adjacent 64-bit temporaries provide the required 16-byte RECT for calculations
  rectLowIdx = tiraDimVarId&("GDRECTLOW", TYPE_INTEGER64)
  rectHighIdx = tiraDimVarId&("GDRECTHIGH", TYPE_INTEGER64)
  tiraAssignId rectLowIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId rectHighIdx, TIRA_ARG_LITERAL, 0

  rectPtrIdx = tiraDimVarId&("GDRECTPTR", TYPE_INTEGER64)
  ' Runtime locals grow downward, so the second temporary is the RECT base
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_SYMBOL, rectHighIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 8, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 12, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_LITERAL, 4

  ' GDOUBLE always establishes a normal windowed 2x presentation
  tiraCallId3 setWindowLongIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -16, TIRA_ARG_LITERAL, 13565952

  ' Adjust the rect geometry to accommodate the target windowed bounds overlay (WS_OVERLAPPEDWINDOW)
  tiraCallId4 adjustWindowRectExIdx, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_LITERAL, 13565952, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  rectLeftIdx = tiraDimVarId&("GDRECTLEFT", TYPE_LONG)
  tiraReadMemId rectLeftIdx, TIRA_ARG_SYMBOL, rectPtrIdx

  rectTopIdx = tiraDimVarId&("GDRECTTOP", TYPE_LONG)
  tiraReadMemOffsetId rectTopIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 4

  rectRightIdx = tiraDimVarId&("GDRECTRIGHT", TYPE_LONG)
  tiraReadMemOffsetId rectRightIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 8

  rectBottomIdx = tiraDimVarId&("GDRECTBOTTOM", TYPE_LONG)
  tiraReadMemOffsetId rectBottomIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 12

  outerWidthIdx = tiraDimVarId&("GDOUTERWIDTH", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, rectRightIdx, TIRA_ARG_SYMBOL, rectLeftIdx

  outerHeightIdx = tiraDimVarId&("GDOUTERHEIGHT", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, rectBottomIdx, TIRA_ARG_SYMBOL, rectTopIdx

  ' Request the actual scaling transition dynamically to process rendering changes
  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  ' Correct each outer dimension from the actual client size reported by WM_SIZE
  widthCorrectionIdx = tiraDimVarId&("GDWIDTHCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthCorrectionIdx, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, windowWidthIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, widthCorrectionIdx

  heightCorrectionIdx = tiraDimVarId&("GDHEIGHTCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, heightCorrectionIdx, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, windowHeightIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, heightCorrectionIdx

  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  tiraAssignId fullscreenIdx, TIRA_ARG_LITERAL, 0

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeGDouble

''''''''''''''''''''''''
SUB emitRuntimeGfxAppend

  DIM textRowHeight AS LONG
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM viewBottomIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM textYIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM lastBackgroundIdx AS LONG
  DIM textXIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM drawTextAbsoluteIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM botYIdx AS LONG
  DIM topYIdx AS LONG
  DIM textPtrIdx AS LONG
  DIM textLeftIdx AS LONG
  DIM lblTextLoopIdx AS LONG
  DIM lblTextDoneIdx AS LONG
  DIM lblScrollLoopIdx AS LONG
  DIM lblNoScreenScrollIdx AS LONG
  DIM lblLineReadyIdx AS LONG
  DIM lblChunkReadyIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM viewStartOffsetIdx AS LONG
  DIM destFbIdx AS LONG
  DIM fbRowBytesIdx AS LONG
  DIM srcFbIdx AS LONG
  DIM fbShiftRowsIdx AS LONG
  DIM fbShiftCountIdx AS LONG
  DIM botRowPtrIdx AS LONG
  DIM pixelsLeftIdx AS LONG
  DIM charsFitIdx AS LONG
  DIM chunkLenIdx AS LONG
  DIM totalWidthIdx AS LONG

  rtOffset(RT_GFX_APPEND) = stream.emitPos

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId arg2VarIdx, 2

  ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
  fontHeightGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
  viewBottomIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
  viewTopIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
  textYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
  lastBackgroundIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_TEXT_X")
  textXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_FG")
  foregroundIdx = returnedData2

  ff = resolveSymbol("RT_DRAW_TEXT_ABSOLUTE")
  drawTextAbsoluteIdx = returnedData2

  fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

  fontHeightReadyLblIdx = tiraLabelCreateNewId&("GFX_FONT_READY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
  tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
  tiraLabelId fontHeightReadyLblIdx

  '''' Check if !G_GFX_VAL_CUR_Y >= Bottom Row
  botYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId botYIdx, TIRA_ARG_SYMBOL, viewBottomIdx

  topYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId topYIdx, TIRA_ARG_SYMBOL, viewTopIdx

  textPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId textPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  textLeftIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId textLeftIdx, TIRA_ARG_SYMBOL, arg2VarIdx

  lblTextLoopIdx = tiraLabelCreateNewId&("GFX_TEXT_LOOP")
  lblTextDoneIdx = tiraLabelCreateNewId&("GFX_TEXT_DONE")
  lblScrollLoopIdx = tiraLabelCreateNewId&("SCROLL_LOOP")
  lblNoScreenScrollIdx = tiraLabelCreateNewId&("NO_SCREEN_SCROLL")
  lblLineReadyIdx = tiraLabelCreateNewId&("GFX_LINE_READY")
  lblChunkReadyIdx = tiraLabelCreateNewId&("GFX_CHUNK_READY")

  tiraLabelId lblTextLoopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_LITERAL, 0, lblTextDoneIdx

  tiraLabelId lblScrollLoopIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, lblNoScreenScrollIdx

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, destFrameIdx

  viewStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, topYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  destFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx

  fbRowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbRowBytesIdx, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  srcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

  fbShiftRowsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, botYIdx, TIRA_ARG_SYMBOL, topYIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

  fbShiftCountIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbShiftCountIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  tiraMemcpyId TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx

  botRowPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx
  tiraMemSetId TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, lastBackgroundIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblScrollLoopIdx

  tiraLabelId lblNoScreenScrollIdx

  pixelsLeftIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, pixelsLeftIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, TIRA_ARG_SYMBOL, textXIdx

  charsFitIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, charsFitIdx, TIRA_ARG_SYMBOL, pixelsLeftIdx, TIRA_ARG_LITERAL, 8

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, charsFitIdx, TIRA_ARG_LITERAL, 0, lblLineReadyIdx
  tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblTextLoopIdx

  tiraLabelId lblLineReadyIdx

  chunkLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId chunkLenIdx, TIRA_ARG_SYMBOL, textLeftIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_SYMBOL, charsFitIdx, lblChunkReadyIdx
  tiraAssignId chunkLenIdx, TIRA_ARG_SYMBOL, charsFitIdx
  tiraLabelId lblChunkReadyIdx

  '''' Render Text to Screen using the Absolute Text Helper
  tiraCallId5 drawTextAbsoluteIdx, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, foregroundIdx

  '''' Update Cursor X by 8 pixels per character
  totalWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalWidthIdx, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, totalWidthIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, chunkLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_SYMBOL, chunkLenIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_LITERAL, 0, lblTextDoneIdx

  tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblTextLoopIdx

  tiraLabelId lblTextDoneIdx

  '''' Redraw Graphic Viewport
  tiraTriggerAutoDisplayId
  tiraInjectPendingDisplayFlushId

  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeGfxAppend

''''''''''''''''''''''''
SUB emitRuntimeInp

  DIM argPortIdx AS LONG
  DIM retValIdx AS LONG
  DIM lbl3C9Idx AS LONG
  DIM skipAllIdx AS LONG
  DIM stepValIdx AS LONG
  DIM readStepIdx AS LONG
  DIM idxValIdx AS LONG
  DIM readIndexIdx AS LONG
  DIM paletteDescIdx AS LONG
  DIM palOffsetIdx AS LONG
  DIM palDataIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM lblStep0Idx AS LONG
  DIM lblStep1Idx AS LONG
  DIM lblStep2Idx AS LONG
  DIM addrRIdx AS LONG
  DIM rawR8Idx AS LONG
  DIM rawRIdx AS LONG
  DIM addrGIdx AS LONG
  DIM rawG8Idx AS LONG
  DIM rawGIdx AS LONG
  DIM addrBIdx AS LONG
  DIM rawB8Idx AS LONG
  DIM rawBIdx AS LONG

  rtOffset(RT_INP) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_DAC_READ_STEP")
  IF ff = 0 THEN EXIT SUB
  readStepIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_READ_IDX")
  IF ff = 0 THEN EXIT SUB
  readIndexIdx = returnedData2

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN EXIT SUB
  paletteDescIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argPortIdx = tiraDimVarId&("PORT", TYPE_LONG)
  tiraAbiReadArgId argPortIdx, 1

  retValIdx = tiraDimVarId&("RET", TYPE_LONG)
  tiraAssignId retValIdx, TIRA_ARG_LITERAL, 0

  lbl3C9Idx = tiraLabelCreateNewId&("INP_3C9")
  skipAllIdx = tiraLabelCreateNewId&("INP_SKIP_ALL")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argPortIdx, TIRA_ARG_LITERAL, 969, lbl3C9Idx
  tiraJmpId skipAllIdx

  tiraLabelId lbl3C9Idx

  stepValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId stepValIdx, TIRA_ARG_SYMBOL, readStepIdx

  idxValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId idxValIdx, TIRA_ARG_SYMBOL, readIndexIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 255

  palOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, palOffsetIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 4

  palDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, paletteDescIdx)
  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataIdx, TIRA_ARG_SYMBOL, palOffsetIdx

  lblStep0Idx = tiraLabelCreateNewId&("INP_STEP_0")
  lblStep1Idx = tiraLabelCreateNewId&("INP_STEP_1")
  lblStep2Idx = tiraLabelCreateNewId&("INP_STEP_2")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 0, lblStep0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 1, lblStep1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 2, lblStep2Idx
  tiraJmpId skipAllIdx

  tiraLabelId lblStep0Idx
  ' Read Red
  addrRIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addrRIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 2
  rawR8Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId rawR8Idx, TIRA_ARG_SYMBOL, addrRIdx
  rawRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId rawRIdx, TIRA_ARG_SYMBOL, rawR8Idx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, retValIdx, TIRA_ARG_SYMBOL, rawRIdx, TIRA_ARG_LITERAL, 4
  tiraAssignId readStepIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipAllIdx

  tiraLabelId lblStep1Idx
  ' Read Green
  addrGIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addrGIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 1
  rawG8Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId rawG8Idx, TIRA_ARG_SYMBOL, addrGIdx
  rawGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId rawGIdx, TIRA_ARG_SYMBOL, rawG8Idx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, retValIdx, TIRA_ARG_SYMBOL, rawGIdx, TIRA_ARG_LITERAL, 4
  tiraAssignId readStepIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId skipAllIdx

  tiraLabelId lblStep2Idx
  ' Read Blue
  addrBIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId addrBIdx, TIRA_ARG_SYMBOL, targetAddrIdx
  rawB8Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId rawB8Idx, TIRA_ARG_SYMBOL, addrBIdx
  rawBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId rawBIdx, TIRA_ARG_SYMBOL, rawB8Idx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, retValIdx, TIRA_ARG_SYMBOL, rawBIdx, TIRA_ARG_LITERAL, 4

  ' Advance index and reset step
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 255
  tiraAssignId readIndexIdx, TIRA_ARG_SYMBOL, idxValIdx
  tiraAssignId readStepIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId skipAllIdx

  tiraAbiWriteRetId retValIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeInp

''''''''''''''''''''''''
SUB emitRuntimeLimit

  DIM limitTickIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM arg1VarIdx AS LONG
  DIM fpsIntIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM msPerFrameIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM curTickIdx AS LONG
  DIM diffTickIdx AS LONG
  DIM newTickIdx AS LONG

  rtOffset(RT_LIMIT) = stream.emitPos

  ff = resolveSymbol("!G_SYS_VAL_LIMIT_TICK")
  IF ff = 0 THEN EXIT SUB
  limitTickIdx = returnedData2

  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN EXIT SUB
  getTickCountIdx = returnedData2

  ff = resolveSymbol("IAT_SLEEP")
  IF ff = 0 THEN EXIT SUB
  sleepFuncIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_DOUBLE)
  tiraAbiReadArgId arg1VarIdx, 1

  fpsIntIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, fpsIntIdx, TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_LITERAL, TYPE_LONG

  doneLblIdx = tiraLabelCreateNewId&("LIM_DONE")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, fpsIntIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  msPerFrameIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, msPerFrameIdx, TIRA_ARG_LITERAL, 1000, TIRA_ARG_SYMBOL, fpsIntIdx

  loopTopIdx = tiraLabelCreateNewId&("LIM_TOP")
  tiraLabelId loopTopIdx

  tiraCallId0 getTickCountIdx
  curTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId curTickIdx

  diffTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_SYMBOL, curTickIdx, TIRA_ARG_SYMBOL, limitTickIdx

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_SYMBOL, msPerFrameIdx, doneLblIdx

  tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId doneLblIdx
  tiraCallId0 getTickCountIdx
  newTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId newTickIdx
  tiraAssignId limitTickIdx, TIRA_ARG_SYMBOL, newTickIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeLimit

''''''''''''''''''''''''
SUB emitRuntimeLine

  DIM pixelMask AS LONG
  DIM tmpXIdx AS LONG
  DIM tmpYIdx AS LONG
  DIM errVarIdx AS LONG
  DIM e2VarIdx AS LONG
  DIM tmpPtr1Idx AS LONG
  DIM tmpPtr2Idx AS LONG
  DIM x1Idx AS LONG
  DIM y1Idx AS LONG
  DIM x2Idx AS LONG
  DIM y2Idx AS LONG
  DIM colorIdx AS LONG
  DIM boxIdx AS LONG
  DIM styleIdx AS LONG
  DIM dxIdx AS LONG
  DIM dyIdx AS LONG
  DIM sxIdx AS LONG
  DIM syIdx AS LONG
  DIM plotPixelIdx AS LONG
  DIM lblNotBFIdx AS LONG
  DIM lblEndBFIdx AS LONG
  DIM lblSkipSwapXBFIdx AS LONG
  DIM lblSkipSwapYBFIdx AS LONG
  DIM lblLoopYBFIdx AS LONG
  DIM lblLoopXBFIdx AS LONG
  DIM lblEndXBFIdx AS LONG
  DIM lblEndLineIdx AS LONG
  DIM lblNotBIdx AS LONG
  DIM lblSkipSwapXBIdx AS LONG
  DIM lblSkipSwapYBIdx AS LONG
  DIM lblLoopH1Idx AS LONG
  DIM lblEndH1Idx AS LONG
  DIM lblLoopH2Idx AS LONG
  DIM lblEndH2Idx AS LONG
  DIM lblLoopV1Idx AS LONG
  DIM lblEndV1Idx AS LONG
  DIM lblLoopV2Idx AS LONG
  DIM lblEndV2Idx AS LONG
  DIM lblSkipNegDXIdx AS LONG
  DIM lblSkipNegDYIdx AS LONG
  DIM lblLoopLineIdx AS LONG
  DIM lblNotDoneIdx AS LONG
  DIM lblSkipDXIdx AS LONG
  DIM lblSkipDYIdx AS LONG

  pixelMask = 255

  SELECT CASE compileScreenMode

    CASE 1, 10
      pixelMask = 3

    CASE 2, 11
      pixelMask = 1

    CASE 7, 8, 9, 12
      pixelMask = 15

  END SELECT ' compileScreenMode

  '''' RT_LINE
  rtOffset(RT_LINE) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_X1")
  IF ff = 0 THEN EXIT SUB
  x1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y1")
  IF ff = 0 THEN EXIT SUB
  y1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_X2")
  IF ff = 0 THEN EXIT SUB
  x2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y2")
  IF ff = 0 THEN EXIT SUB
  y2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_COLOR")
  IF ff = 0 THEN EXIT SUB
  colorIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_BOXX")
  IF ff = 0 THEN EXIT SUB
  boxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_STYLE")
  IF ff = 0 THEN EXIT SUB
  styleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DX")
  IF ff = 0 THEN EXIT SUB
  dxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DY")
  IF ff = 0 THEN EXIT SUB
  dyIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SX")
  IF ff = 0 THEN EXIT SUB
  sxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SY")
  IF ff = 0 THEN EXIT SUB
  syIdx = returnedData2

  ff = resolveSymbol("RT_PLOT_PIXEL")
  IF ff = 0 THEN EXIT SUB
  plotPixelIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  tmpXIdx = tiraDimVarId&("T", TYPE_LONG)
  tmpYIdx = tiraDimVarId&("T", TYPE_LONG)
  errVarIdx = tiraDimVarId&("T", TYPE_LONG)
  e2VarIdx = tiraDimVarId&("T", TYPE_LONG)
  tmpPtr1Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tmpPtr2Idx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraAbiReadArgId x1Idx, 1
  tiraAbiReadArgId y1Idx, 2
  tiraAbiReadArgId x2Idx, 3
  tiraAbiReadArgId y2Idx, 4
  tiraAbiReadArgId colorIdx, 5
  tiraAbiReadArgId boxIdx, 6
  tiraAbiReadArgId styleIdx, 7

  ' Keep the line color inside the palette-index range for the selected screen mode
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, colorIdx, TIRA_ARG_SYMBOL, colorIdx, TIRA_ARG_LITERAL, pixelMask

  lblNotBFIdx = tiraLabelCreateNewId&("NOT_BF")
  lblEndBFIdx = tiraLabelCreateNewId&("END_BF")

  ' IF !G_GFX_FLG_BOXX != 2 GOTO NOT_BF
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, boxIdx, TIRA_ARG_LITERAL, 2, lblNotBFIdx

  ' Swap X if X1 > X2
  lblSkipSwapXBFIdx = tiraLabelCreateNewId&("SKIP_SWAP_X_BF")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblSkipSwapXBFIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, x1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, x2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapXBFIdx

  ' Swap Y if Y1 > Y2
  lblSkipSwapYBFIdx = tiraLabelCreateNewId&("SKIP_SWAP_Y_BF")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblSkipSwapYBFIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, y1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, y2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapYBFIdx

  ' Outer Loop (Y)
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopYBFIdx = tiraLabelCreateNewId&("LOOP_Y_BF")
  tiraLabelId lblLoopYBFIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndBFIdx

  ' Inner Loop (X)
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopXBFIdx = tiraLabelCreateNewId&("LOOP_X_BF")
  lblEndXBFIdx = tiraLabelCreateNewId&("END_X_BF")
  tiraLabelId lblLoopXBFIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndXBFIdx

  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, colorIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopXBFIdx
  tiraLabelId lblEndXBFIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopYBFIdx

  tiraLabelId lblEndBFIdx
  lblEndLineIdx = tiraLabelCreateNewId&("END_LINE")
  tiraJmpId lblEndLineIdx

  tiraLabelId lblNotBFIdx

  ' Box (B) Logic
  lblNotBIdx = tiraLabelCreateNewId&("NOT_B")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, boxIdx, TIRA_ARG_LITERAL, 1, lblNotBIdx

  ' Swap X if X1 > X2
  lblSkipSwapXBIdx = tiraLabelCreateNewId&("SKIP_SWAP_X_B")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblSkipSwapXBIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, x1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, x2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapXBIdx

  ' Swap Y if Y1 > Y2
  lblSkipSwapYBIdx = tiraLabelCreateNewId&("SKIP_SWAP_Y_B")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblSkipSwapYBIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, y1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, y2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapYBIdx

  ' H1: Y=Y1, X=X1 to X2
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopH1Idx = tiraLabelCreateNewId&("LOOP_H1")
  lblEndH1Idx = tiraLabelCreateNewId&("END_H1")
  tiraLabelId lblLoopH1Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndH1Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, y1Idx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopH1Idx
  tiraLabelId lblEndH1Idx

  ' H2: Y=Y2, X=X1 to X2
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopH2Idx = tiraLabelCreateNewId&("LOOP_H2")
  lblEndH2Idx = tiraLabelCreateNewId&("END_H2")
  tiraLabelId lblLoopH2Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndH2Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, y2Idx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopH2Idx
  tiraLabelId lblEndH2Idx

  ' V1: X=X1, Y=Y1 to Y2
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopV1Idx = tiraLabelCreateNewId&("LOOP_V1")
  lblEndV1Idx = tiraLabelCreateNewId&("END_V1")
  tiraLabelId lblLoopV1Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndV1Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, tmpYIdx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopV1Idx
  tiraLabelId lblEndV1Idx

  ' V2: X=X2, Y=Y1 to Y2
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopV2Idx = tiraLabelCreateNewId&("LOOP_V2")
  lblEndV2Idx = tiraLabelCreateNewId&("END_V2")
  tiraLabelId lblLoopV2Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndV2Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x2Idx, TIRA_ARG_SYMBOL, tmpYIdx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopV2Idx
  tiraLabelId lblEndV2Idx

  tiraJmpId lblEndLineIdx
  tiraLabelId lblNotBIdx

  ' Bresenham Line Logic
  ' dx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, x2Idx, TIRA_ARG_SYMBOL, x1Idx
  lblSkipNegDXIdx = tiraLabelCreateNewId&("SKIP_NEG_DX")
  tiraAssignId sxIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_LITERAL, 0, lblSkipNegDXIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, dxIdx
  tiraAssignId sxIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId lblSkipNegDXIdx

  ' dy
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, y2Idx, TIRA_ARG_SYMBOL, y1Idx
  lblSkipNegDYIdx = tiraLabelCreateNewId&("SKIP_NEG_DY")
  tiraAssignId syIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_LITERAL, 0, lblSkipNegDYIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, dyIdx
  tiraAssignId syIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId lblSkipNegDYIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, dyIdx

  ' err = dx + dy
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, dyIdx

  lblLoopLineIdx = tiraLabelCreateNewId&("LOOP_LINE")
  tiraLabelId lblLoopLineIdx

  ' Plot
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, y1Idx, styleIdx, colorIdx, plotPixelIdx

  ' Check break
  lblNotDoneIdx = tiraLabelCreateNewId&("NOT_DONE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblNotDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblEndLineIdx
  tiraLabelId lblNotDoneIdx

  ' e2 = err * 2
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_LITERAL, 2

  ' if e2 >= dy
  lblSkipDXIdx = tiraLabelCreateNewId&("SKIP_DX")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, dyIdx, lblSkipDXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dyIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, sxIdx
  tiraLabelId lblSkipDXIdx

  ' if e2 <= dx
  lblSkipDYIdx = tiraLabelCreateNewId&("SKIP_DY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, dxIdx, lblSkipDYIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dxIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, syIdx
  tiraLabelId lblSkipDYIdx

  tiraJmpId lblLoopLineIdx

  tiraLabelId lblEndLineIdx

  tiraTriggerAutoDisplayId

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeLine

''''''''''''''''''''''''
SUB emitRuntimeMouseInput

  DIM mouseHeadIdx AS LONG
  DIM mouseTailIdx AS LONG
  DIM mouseBufferIdx AS LONG
  DIM screenWidthGlobalIdx AS LONG
  DIM screenHeightGlobalIdx AS LONG
  DIM clientWidthGlobalIdx AS LONG
  DIM clientHeightGlobalIdx AS LONG
  DIM mouseXGlobalIdx AS LONG
  DIM mouseYGlobalIdx AS LONG
  DIM mouseScrollGlobalIdx AS LONG
  DIM mouseB1GlobalIdx AS LONG
  DIM mouseB2GlobalIdx AS LONG
  DIM mouseB3GlobalIdx AS LONG

  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM retValIdx AS LONG
  DIM emptyLblIdx AS LONG
  DIM bufArrPtrIdx AS LONG
  DIM offsetValIdx AS LONG
  DIM recPtrIdx AS LONG
  DIM mouseXIdx AS LONG
  DIM mouseYIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG
  DIM clientWidthIdx AS LONG
  DIM clientHeightIdx AS LONG
  DIM mouseScaleDoneLblIdx AS LONG
  DIM scaledMouseXIdx AS LONG
  DIM scaledMouseYIdx AS LONG
  DIM screenMaxXIdx AS LONG
  DIM screenMaxYIdx AS LONG
  DIM mouseScaleXInRangeLblIdx AS LONG
  DIM mouseScaleYInRangeLblIdx AS LONG
  DIM mouseWheelIdx AS LONG
  DIM mouseBtnsIdx AS LONG
  DIM b1Idx AS LONG
  DIM b1StateIdx AS LONG
  DIM skipB1Idx AS LONG
  DIM b2Idx AS LONG
  DIM b2StateIdx AS LONG
  DIM skipB2Idx AS LONG
  DIM b3Idx AS LONG
  DIM b3StateIdx AS LONG
  DIM skipB3Idx AS LONG

  rtOffset(RT_MOUSEINPUT) = stream.emitPos

  ff = resolveSymbol("!G_INO_VAL_MOUSE_HEAD")
  IF ff = 0 THEN EXIT SUB
  mouseHeadIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_TAIL")
  IF ff = 0 THEN EXIT SUB
  mouseTailIdx = returnedData2

  ff = resolveSymbol("!G_INO_ARR_MOUSE_BUF")
  IF ff = 0 THEN EXIT SUB
  mouseBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNW")
  IF ff = 0 THEN EXIT SUB
  screenWidthGlobalIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNH")
  IF ff = 0 THEN EXIT SUB
  screenHeightGlobalIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_WIDTH")
  IF ff = 0 THEN EXIT SUB
  clientWidthGlobalIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HEIGHT")
  IF ff = 0 THEN EXIT SUB
  clientHeightGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_X")
  IF ff = 0 THEN EXIT SUB
  mouseXGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_Y")
  IF ff = 0 THEN EXIT SUB
  mouseYGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_SCRL")
  IF ff = 0 THEN EXIT SUB
  mouseScrollGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B1")
  IF ff = 0 THEN EXIT SUB
  mouseB1GlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B2")
  IF ff = 0 THEN EXIT SUB
  mouseB2GlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B3")
  IF ff = 0 THEN EXIT SUB
  mouseB3GlobalIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, mouseHeadIdx
  headValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

  tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, mouseTailIdx
  tailValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

  retValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId retValIdx, TIRA_ARG_LITERAL, 0

  emptyLblIdx = tiraLabelCreateNewId&("MI_EMPTY")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, emptyLblIdx

  bufArrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufArrPtrIdx, TIRA_ARG_SYMBOL, mouseBufferIdx

  offsetValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 16

  recPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, recPtrIdx, TIRA_ARG_SYMBOL, bufArrPtrIdx, TIRA_ARG_SYMBOL, offsetValIdx

  mouseXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId mouseXIdx, TIRA_ARG_SYMBOL, recPtrIdx

  mouseYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId mouseYIdx, TIRA_ARG_SYMBOL, recPtrIdx, 4

  ' Convert client pixels into coordinates belonging to the active SCREEN image
  ' Matching SCREEN and client dimensions preserve RES and MED without extra scaling
  screenWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId screenWidthIdx, TIRA_ARG_SYMBOL, screenWidthGlobalIdx

  screenHeightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId screenHeightIdx, TIRA_ARG_SYMBOL, screenHeightGlobalIdx

  clientWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId clientWidthIdx, TIRA_ARG_SYMBOL, clientWidthGlobalIdx

  clientHeightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId clientHeightIdx, TIRA_ARG_SYMBOL, clientHeightGlobalIdx

  mouseScaleDoneLblIdx = tiraLabelCreateNewId&("MI_SCALE_DONE")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, screenWidthIdx, TIRA_ARG_LITERAL, 0, mouseScaleDoneLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, screenHeightIdx, TIRA_ARG_LITERAL, 0, mouseScaleDoneLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_LITERAL, 0, mouseScaleDoneLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_LITERAL, 0, mouseScaleDoneLblIdx

  scaledMouseXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledMouseXIdx, TIRA_ARG_SYMBOL, mouseXIdx, TIRA_ARG_SYMBOL, screenWidthIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, mouseXIdx, TIRA_ARG_SYMBOL, scaledMouseXIdx, TIRA_ARG_SYMBOL, clientWidthIdx

  scaledMouseYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledMouseYIdx, TIRA_ARG_SYMBOL, mouseYIdx, TIRA_ARG_SYMBOL, screenHeightIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, mouseYIdx, TIRA_ARG_SYMBOL, scaledMouseYIdx, TIRA_ARG_SYMBOL, clientHeightIdx

  screenMaxXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, screenMaxXIdx, TIRA_ARG_SYMBOL, screenWidthIdx, TIRA_ARG_LITERAL, 1

  screenMaxYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, screenMaxYIdx, TIRA_ARG_SYMBOL, screenHeightIdx, TIRA_ARG_LITERAL, 1

  mouseScaleXInRangeLblIdx = tiraLabelCreateNewId&("MI_SCALE_X_RANGE")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, mouseXIdx, TIRA_ARG_SYMBOL, screenMaxXIdx, mouseScaleXInRangeLblIdx
  tiraAssignId mouseXIdx, TIRA_ARG_SYMBOL, screenMaxXIdx
  tiraLabelId mouseScaleXInRangeLblIdx

  mouseScaleYInRangeLblIdx = tiraLabelCreateNewId&("MI_SCALE_Y_RANGE")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, mouseYIdx, TIRA_ARG_SYMBOL, screenMaxYIdx, mouseScaleYInRangeLblIdx
  tiraAssignId mouseYIdx, TIRA_ARG_SYMBOL, screenMaxYIdx
  tiraLabelId mouseScaleYInRangeLblIdx

  tiraLabelId mouseScaleDoneLblIdx

  tiraAssignId mouseXGlobalIdx, TIRA_ARG_SYMBOL, mouseXIdx
  tiraAssignId mouseYGlobalIdx, TIRA_ARG_SYMBOL, mouseYIdx

  mouseWheelIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId mouseWheelIdx, TIRA_ARG_SYMBOL, recPtrIdx, 8
  tiraAssignId mouseScrollGlobalIdx, TIRA_ARG_SYMBOL, mouseWheelIdx

  mouseBtnsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId mouseBtnsIdx, TIRA_ARG_SYMBOL, recPtrIdx, 12

  b1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, b1Idx, TIRA_ARG_SYMBOL, mouseBtnsIdx, TIRA_ARG_LITERAL, 1
  b1StateIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId b1StateIdx, TIRA_ARG_LITERAL, 0
  skipB1Idx = tiraLabelCreateNewId&("MI_SKIPB1")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, b1Idx, TIRA_ARG_LITERAL, 0, skipB1Idx
  tiraAssignId b1StateIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId skipB1Idx
  tiraAssignId mouseB1GlobalIdx, TIRA_ARG_SYMBOL, b1StateIdx

  b2Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, b2Idx, TIRA_ARG_SYMBOL, mouseBtnsIdx, TIRA_ARG_LITERAL, 2
  b2StateIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId b2StateIdx, TIRA_ARG_LITERAL, 0
  skipB2Idx = tiraLabelCreateNewId&("MI_SKIPB2")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, b2Idx, TIRA_ARG_LITERAL, 0, skipB2Idx
  tiraAssignId b2StateIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId skipB2Idx
  tiraAssignId mouseB2GlobalIdx, TIRA_ARG_SYMBOL, b2StateIdx

  b3Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, b3Idx, TIRA_ARG_SYMBOL, mouseBtnsIdx, TIRA_ARG_LITERAL, 4
  b3StateIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId b3StateIdx, TIRA_ARG_LITERAL, 0
  skipB3Idx = tiraLabelCreateNewId&("MI_SKIPB3")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, b3Idx, TIRA_ARG_LITERAL, 0, skipB3Idx
  tiraAssignId b3StateIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId skipB3Idx
  tiraAssignId mouseB3GlobalIdx, TIRA_ARG_SYMBOL, b3StateIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 511
  tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

  tiraAssignId retValIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId emptyLblIdx

  tiraAbiWriteRetId retValIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeMouseInput

''''''''''''''''''''''''
SUB emitRuntimeOut

  DIM dacReadIndexIdx AS LONG
  DIM dacReadStepIdx AS LONG
  DIM dacWriteIndexIdx AS LONG
  DIM dacWriteStepIdx AS LONG
  DIM dacWriteRIdx AS LONG
  DIM dacWriteGIdx AS LONG
  DIM paletteDescIdx AS LONG
  DIM argPortIdx AS LONG
  DIM argValIdx AS LONG
  DIM skipAllIdx AS LONG
  DIM lbl3C7Idx AS LONG
  DIM lbl3C8Idx AS LONG
  DIM lbl3C9Idx AS LONG
  DIM stepValIdx AS LONG
  DIM lblStep0Idx AS LONG
  DIM lblStep1Idx AS LONG
  DIM lblStep2Idx AS LONG
  DIM idxValIdx AS LONG
  DIM palOffsetIdx AS LONG
  DIM palDataIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM valRIdx AS LONG
  DIM valGIdx AS LONG
  DIM valBIdx AS LONG
  DIM addrBIdx AS LONG
  DIM addrGIdx AS LONG
  DIM addrRIdx AS LONG

  rtOffset(RT_OUT) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_DAC_READ_IDX")
  IF ff = 0 THEN EXIT SUB
  dacReadIndexIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_READ_STEP")
  IF ff = 0 THEN EXIT SUB
  dacReadStepIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_WRITE_IDX")
  IF ff = 0 THEN EXIT SUB
  dacWriteIndexIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_WRITE_STEP")
  IF ff = 0 THEN EXIT SUB
  dacWriteStepIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_WRITE_R")
  IF ff = 0 THEN EXIT SUB
  dacWriteRIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DAC_WRITE_G")
  IF ff = 0 THEN EXIT SUB
  dacWriteGIdx = returnedData2

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN EXIT SUB
  paletteDescIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argPortIdx = tiraDimVarId&("PORT", TYPE_LONG)
  tiraAbiReadArgId argPortIdx, 1

  argValIdx = tiraDimVarId&("VAL", TYPE_LONG)
  tiraAbiReadArgId argValIdx, 2

  skipAllIdx = tiraLabelCreateNewId&("OUT_SKIP_ALL")

  lbl3C7Idx = tiraLabelCreateNewId&("OUT_3C7")
  lbl3C8Idx = tiraLabelCreateNewId&("OUT_3C8")
  lbl3C9Idx = tiraLabelCreateNewId&("OUT_3C9")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argPortIdx, TIRA_ARG_LITERAL, 967, lbl3C7Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argPortIdx, TIRA_ARG_LITERAL, 968, lbl3C8Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argPortIdx, TIRA_ARG_LITERAL, 969, lbl3C9Idx
  tiraJmpId skipAllIdx

  tiraLabelId lbl3C7Idx
  tiraAssignId dacReadIndexIdx, TIRA_ARG_SYMBOL, argValIdx
  tiraAssignId dacReadStepIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId skipAllIdx

  tiraLabelId lbl3C8Idx
  tiraAssignId dacWriteIndexIdx, TIRA_ARG_SYMBOL, argValIdx
  tiraAssignId dacWriteStepIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId skipAllIdx

  tiraLabelId lbl3C9Idx
  stepValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId stepValIdx, TIRA_ARG_SYMBOL, dacWriteStepIdx

  lblStep0Idx = tiraLabelCreateNewId&("OUT_STEP_0")
  lblStep1Idx = tiraLabelCreateNewId&("OUT_STEP_1")
  lblStep2Idx = tiraLabelCreateNewId&("OUT_STEP_2")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 0, lblStep0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 1, lblStep1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, stepValIdx, TIRA_ARG_LITERAL, 2, lblStep2Idx
  tiraJmpId skipAllIdx

  tiraLabelId lblStep0Idx
  tiraAssignId dacWriteRIdx, TIRA_ARG_SYMBOL, argValIdx
  tiraAssignId dacWriteStepIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipAllIdx

  tiraLabelId lblStep1Idx
  tiraAssignId dacWriteGIdx, TIRA_ARG_SYMBOL, argValIdx
  tiraAssignId dacWriteStepIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId skipAllIdx

  tiraLabelId lblStep2Idx
  idxValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId idxValIdx, TIRA_ARG_SYMBOL, dacWriteIndexIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 255

  palOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, palOffsetIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 4

  palDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, paletteDescIdx)
  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataIdx, TIRA_ARG_SYMBOL, palOffsetIdx

  valRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, valRIdx, TIRA_ARG_SYMBOL, dacWriteRIdx, TIRA_ARG_LITERAL, 4
  valGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, valGIdx, TIRA_ARG_SYMBOL, dacWriteGIdx, TIRA_ARG_LITERAL, 4
  valBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, valBIdx, TIRA_ARG_SYMBOL, argValIdx, TIRA_ARG_LITERAL, 4

  addrBIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId addrBIdx, TIRA_ARG_SYMBOL, targetAddrIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, addrBIdx, TIRA_ARG_SYMBOL, valBIdx, TIRA_ARG_LITERAL, 1

  addrGIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addrGIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, addrGIdx, TIRA_ARG_SYMBOL, valGIdx, TIRA_ARG_LITERAL, 1

  addrRIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addrRIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 2
  tiraWriteMemId TIRA_ARG_SYMBOL, addrRIdx, TIRA_ARG_SYMBOL, valRIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_SYMBOL, idxValIdx, TIRA_ARG_LITERAL, 255
  tiraAssignId dacWriteIndexIdx, TIRA_ARG_SYMBOL, idxValIdx
  tiraAssignId dacWriteStepIdx, TIRA_ARG_LITERAL, 0

  tiraTriggerAutoDisplayId

  tiraLabelId skipAllIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeOut

''''''''''''''''''''''''
SUB emitRuntimePcopy

  DIM renderLockIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM countBackIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM countPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM countPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM countPage3Idx AS LONG
  DIM pagingIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM invalidateRectIdx AS LONG
  DIM argSrcIdx AS LONG
  DIM argDestIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM lblSpinIdx AS LONG
  DIM lblAcqIdx AS LONG
  DIM spinValIdx AS LONG
  DIM fbSizeIdx AS LONG
  DIM txtSizeIdx AS LONG
  DIM lblSrc0Idx AS LONG
  DIM lblSrc1Idx AS LONG
  DIM lblSrc2Idx AS LONG
  DIM lblSrc3Idx AS LONG
  DIM lblSrcEndIdx AS LONG
  DIM ptrSrcFbIdx AS LONG
  DIM ptrSrcBufIdx AS LONG
  DIM cntSrcBufIdx AS LONG
  DIM lblDest0Idx AS LONG
  DIM lblDest1Idx AS LONG
  DIM lblDest2Idx AS LONG
  DIM lblDest3Idx AS LONG
  DIM lblDestEndIdx AS LONG
  DIM ptrDestFbIdx AS LONG
  DIM ptrDestBufIdx AS LONG
  DIM lblWrite0Idx AS LONG
  DIM lblWrite1Idx AS LONG
  DIM lblWrite2Idx AS LONG
  DIM lblWrite3Idx AS LONG
  DIM lblWriteEndIdx AS LONG
  DIM lblSkipRedrawIdx AS LONG

  rtOffset(RT_PCOPY) = stream.emitPos

  ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
  IF ff = 0 THEN EXIT SUB
  renderLockIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  IF ff = 0 THEN EXIT SUB
  frameBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  IF ff = 0 THEN EXIT SUB
  bufferBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  IF ff = 0 THEN EXIT SUB
  countBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  IF ff = 0 THEN EXIT SUB
  framePage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
  IF ff = 0 THEN EXIT SUB
  bufferPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
  IF ff = 0 THEN EXIT SUB
  countPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  IF ff = 0 THEN EXIT SUB
  framePage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
  IF ff = 0 THEN EXIT SUB
  bufferPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  IF ff = 0 THEN EXIT SUB
  countPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  IF ff = 0 THEN EXIT SUB
  framePage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
  IF ff = 0 THEN EXIT SUB
  bufferPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  IF ff = 0 THEN EXIT SUB
  countPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  IF ff = 0 THEN EXIT SUB
  pagingIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 0 THEN EXIT SUB
  windowHandleIdx = returnedData2

  ff = resolveSymbol("IAT_SLEEP")
  IF ff = 0 THEN EXIT SUB
  sleepFuncIdx = returnedData2

  ff = resolveSymbol("IAT_INVALIDATERECT")
  IF ff = 0 THEN EXIT SUB
  invalidateRectIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argSrcIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId argSrcIdx, 1
  argDestIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId argDestIdx, 2

  lblDoneIdx = tiraLabelCreateNewId&("PCOPY_DONE")

  ' Skip if src equals dest
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_SYMBOL, argDestIdx, lblDoneIdx

  ' Validate pages (0 to 3 natively supported)
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 3, lblDoneIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 3, lblDoneIdx

  ' Acquire Spinlock safely using hardware XCHG
  lblSpinIdx = tiraLabelCreateNewId&("PCOPY_SPIN")
  lblAcqIdx = tiraLabelCreateNewId&("PCOPY_ACQ")
  tiraLabelId lblSpinIdx
  spinValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId spinValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_XCHG, TIRA_ARG_SYMBOL, renderLockIdx, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 0, lblAcqIdx
  tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId lblSpinIdx
  tiraLabelId lblAcqIdx

  fbSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fbSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  txtSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId txtSizeIdx, TIRA_ARG_LITERAL, 4096 * layout.GfxBufEntrySize

  lblSrc0Idx = tiraLabelCreateNewId&("SRC_0")
  lblSrc1Idx = tiraLabelCreateNewId&("SRC_1")
  lblSrc2Idx = tiraLabelCreateNewId&("SRC_2")
  lblSrc3Idx = tiraLabelCreateNewId&("SRC_3")
  lblSrcEndIdx = tiraLabelCreateNewId&("SRC_END")

  ptrSrcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ptrSrcBufIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  cntSrcBufIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 0, lblSrc0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 1, lblSrc1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 2, lblSrc2Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 3, lblSrc3Idx
  tiraJmpId lblDoneIdx

  tiraLabelId lblSrc0Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId ptrSrcBufIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraAssignId cntSrcBufIdx, TIRA_ARG_SYMBOL, countBackIdx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc1Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId ptrSrcBufIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraAssignId cntSrcBufIdx, TIRA_ARG_SYMBOL, countPage1Idx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc2Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId ptrSrcBufIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraAssignId cntSrcBufIdx, TIRA_ARG_SYMBOL, countPage2Idx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc3Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId ptrSrcBufIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraAssignId cntSrcBufIdx, TIRA_ARG_SYMBOL, countPage3Idx

  tiraLabelId lblSrcEndIdx

  lblDest0Idx = tiraLabelCreateNewId&("DEST_0")
  lblDest1Idx = tiraLabelCreateNewId&("DEST_1")
  lblDest2Idx = tiraLabelCreateNewId&("DEST_2")
  lblDest3Idx = tiraLabelCreateNewId&("DEST_3")
  lblDestEndIdx = tiraLabelCreateNewId&("DEST_END")

  ptrDestFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ptrDestBufIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 0, lblDest0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 1, lblDest1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 2, lblDest2Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 3, lblDest3Idx
  tiraJmpId lblDoneIdx

  tiraLabelId lblDest0Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId ptrDestBufIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest1Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId ptrDestBufIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest2Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId ptrDestBufIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest3Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId ptrDestBufIdx, TIRA_ARG_SYMBOL, bufferPage3Idx

  tiraLabelId lblDestEndIdx

  tiraMemcpyId TIRA_ARG_SYMBOL, ptrDestFbIdx, TIRA_ARG_SYMBOL, ptrSrcFbIdx, TIRA_ARG_SYMBOL, fbSizeIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, ptrDestBufIdx, TIRA_ARG_SYMBOL, ptrSrcBufIdx, TIRA_ARG_SYMBOL, txtSizeIdx

  lblWrite0Idx = tiraLabelCreateNewId&("WR_0")
  lblWrite1Idx = tiraLabelCreateNewId&("WR_1")
  lblWrite2Idx = tiraLabelCreateNewId&("WR_2")
  lblWrite3Idx = tiraLabelCreateNewId&("WR_3")
  lblWriteEndIdx = tiraLabelCreateNewId&("WR_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 0, lblWrite0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 1, lblWrite1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 2, lblWrite2Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 3, lblWrite3Idx
  tiraJmpId lblWriteEndIdx

  tiraLabelId lblWrite0Idx
  tiraAssignId countBackIdx, TIRA_ARG_SYMBOL, cntSrcBufIdx
  tiraJmpId lblWriteEndIdx

  tiraLabelId lblWrite1Idx
  tiraAssignId countPage1Idx, TIRA_ARG_SYMBOL, cntSrcBufIdx
  tiraJmpId lblWriteEndIdx

  tiraLabelId lblWrite2Idx
  tiraAssignId countPage2Idx, TIRA_ARG_SYMBOL, cntSrcBufIdx
  tiraJmpId lblWriteEndIdx

  tiraLabelId lblWrite3Idx
  tiraAssignId countPage3Idx, TIRA_ARG_SYMBOL, cntSrcBufIdx

  tiraLabelId lblWriteEndIdx

  ' Release Spinlock
  tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0

  ' Instruct Windows to repaint the window using the newly swapped destination buffer ONLY if it is the active visual frame (Page 1 / FRONT)
  ' Explicit paging compares the destination against the selected visual page
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, argDestIdx

  lblSkipRedrawIdx = tiraLabelCreateNewId&("SKIP_REDRAW")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, lblSkipRedrawIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 1, lblSkipRedrawIdx
  tiraCallId3 invalidateRectIdx, TIRA_ARG_SYMBOL, windowHandleIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraLabelId lblSkipRedrawIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePcopy

