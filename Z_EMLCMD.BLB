  ' Check the required byte count before reading the numeric value
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 4, validCvlLblIdx

  tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVL()"

  tiraLabelId validCvlLblIdx

