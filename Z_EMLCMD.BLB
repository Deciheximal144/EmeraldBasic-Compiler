  END IF

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_CVL$ = scratchName$

END FUNCTION ' parse_CVL$

''''''''''''''''''''''''
FUNCTION parse_CVS$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM validCvsLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVS", 3) = 0 THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("CVS", "_VAL")
  IF scratchIdx = 0 THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Force the hoist variable to cleanly inherit the explicit SINGLE precision type
  symbols(scratchIdx).DataType = TYPE_SINGLE

  resVarIdx = tiraDimVarId&("T", TYPE_SINGLE)

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  validCvsLblIdx = tiraLabelCreateNewId&("VALID_CVS")

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 4, validCvsLblIdx

  tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVS()"

  tiraLabelId validCvsLblIdx

  tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_CVS$ = scratchName$

END FUNCTION ' parse_CVS$

''''''''''''''''''''''''
FUNCTION parse_CWD$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM getCurrentDirectoryIdx AS LONG
  DIM bufferSizeIdx AS LONG
  DIM pathLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM allocPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM validLblIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _CWD$", ASIS, 0
    parse_CWD$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("CWD", "_DSC")
  IF scratchIdx = 0 THEN
    parse_CWD$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("IAT_GETCURRENTDIRECTORYA")
  IF ff = 0 THEN
    tira_Cancel
    parse_CWD$ = ""
    EXIT FUNCTION
  END IF
  getCurrentDirectoryIdx = returnedData2

  bufferSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  pathLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId pathLenIdx, TIRA_ARG_LITERAL, 0
  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_LITERAL, 0
  doneLblIdx = tiraLabelCreateNewId&("CWD_DONE")

  ' Ask Windows for the space needed, including its terminating null byte
  tiraCallId2 getCurrentDirectoryIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraGetRetId bufferSizeIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, bufferSizeIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, bufferSizeIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_CWD$ = ""
    EXIT FUNCTION
  END IF
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx

  tiraCallId2 getCurrentDirectoryIdx, TIRA_ARG_SYMBOL, bufferSizeIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraGetRetId pathLenIdx

  ' If the path no longer fits, return an empty string instead of exposing a partial buffer
  validLblIdx = tiraLabelCreateNewId&("CWD_VALID")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, pathLenIdx, TIRA_ARG_SYMBOL, bufferSizeIdx, validLblIdx
  tiraAssignId pathLenIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId validLblIdx

  tiraLabelId doneLblIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, pathLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CWD$ = scratchName$

END FUNCTION ' parse_CWD$

''''''''''''''''''''''''
FUNCTION parse_DEFINT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM char1 AS LONG
  DIM char2 AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
    EXIT FUNCTION
  END IF

  DO WHILE tokIdx <= endIdx
    tok$ = lineTokens$(tokIdx)
    IF LEN(tok$) <> 1 THEN
      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
      EXIT FUNCTION
    END IF
    char1 = ASC(UCASE$(tok$))
    IF char1 < 65 OR char1 > 90 THEN
      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
      EXIT FUNCTION
    END IF
    char2 = char1
    tokIdx = tokIdx + 1
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("-") THEN
        tokIdx = tokIdx + 1
        IF tokIdx <= endIdx THEN
          tok2$ = lineTokens$(tokIdx)
          IF LEN(tok2$) <> 1 THEN
            throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
            EXIT FUNCTION
          END IF
          char2 = ASC(UCASE$(tok2$))
          IF char2 < 65 OR char2 > 90 OR char2 < char1 THEN
            throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
            EXIT FUNCTION
          END IF
          tokIdx = tokIdx + 1
        ELSE
          throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF
    FOR ix = char1 TO char2
      IF cm.HasGlobalDefInt = 0 THEN defIntMap(ix - 65) = 1
    NEXT
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerError "EXPECTED COMMA", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  parse_DEFINT = 1

END FUNCTION ' parse_DEFINT

''''''''''''''''''''''''
FUNCTION parse_DELAY_Core (startIdx, delayMode AS LONG)

  DIM endIdx AS LONG
  DIM hasArg AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM argFloatIdx AS LONG
  DIM msFloatIdx AS LONG
  DIM msScaleIdx AS LONG
  DIM delayMillisecondsType AS LONG
  DIM delayMillisecondsVal AS _INTEGER64
  DIM delayMillisecondsIdx AS LONG
  DIM skipClampLblIdx AS LONG
  DIM releaseWaitLblIdx AS LONG
  DIM releaseKeyLblIdx AS LONG
  DIM sleepWaitLblIdx AS LONG
  DIM sleepKeyLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM keyIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM playToken$
  DIM playText$
  DIM pauseText$
  DIM pauseValue AS LONG
  DIM pauseMilliseconds AS LONG
  DIM isPauseOnly AS LONG
  DIM chCheck AS STRING * 1
  DIM pendingBitsIdx AS LONG
  DIM skipPresentLblIdx AS LONG
  DIM skipTickLblIdx AS LONG
  DIM currentTickIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM getTickFuncIdx AS LONG
  DIM getAsyncKeyStateFuncIdx AS LONG
  DIM swapBuffersFuncIdx AS LONG
  DIM autoIdx AS LONG
  DIM pendingIdx AS LONG
  DIM displayTimerIdx AS LONG

  endIdx = lineTokenCount - 1
  hasArg = 0

  IF endIdx >= startIdx + 1 THEN hasArg = 1

  IF delayMode = 0 THEN
    IF hasArg = 0 THEN
      throwCompilerError "_DELAY REQUIRES NUMERIC ARGUMENT", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF delayMode = 2 THEN
    isPauseOnly = 0

    IF endIdx = startIdx + 1 THEN
      playToken$ = lineTokens$(startIdx + 1)

      IF LEN(playToken$) >= 3 THEN
        IF LEFT$(playToken$, 1) = CHR$(34) AND RIGHT$(playToken$, 1) = CHR$(34) THEN
          playText$ = UCASE$(LTRIM$(RTRIM$(MID$(playToken$, 2, LEN(playToken$) - 2))))

          IF LEFT$(playText$, 1) = "P" THEN
            pauseText$ = MID$(playText$, 2)

            IF LEN(pauseText$) > 0 THEN
              isPauseOnly = 1

              FOR ii = 1 TO LEN(pauseText$)
                chCheck = MID$(pauseText$, ii, 1)
                IF chCheck < "0" OR chCheck > "9" THEN
                  isPauseOnly = 0
                  EXIT FOR
                END IF
              NEXT

              IF isPauseOnly = 1 THEN
                IF LEN(pauseText$) > 2 THEN
                  throwCompilerError "PLAY PAUSE MUST BE BETWEEN 1 AND 64", ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isPauseOnly = 0 THEN
      parse_DELAY_Core = 1
      EXIT FUNCTION
    END IF

    pauseValue = VAL(pauseText$)

    IF pauseValue < 1 OR pauseValue > 64 THEN
      throwCompilerError "PLAY PAUSE MUST BE BETWEEN 1 AND 64", ASIS, 0
      EXIT FUNCTION
    END IF

    ' At the default PLAY tempo of 120, a whole note lasts 2000 milliseconds
    pauseMilliseconds = 2000 \ pauseValue
  END IF

  tira_Start

  delayMillisecondsType = TA_EMPTY
  delayMillisecondsVal = 0

  IF delayMode = 2 THEN
    delayMillisecondsType = TIRA_ARG_LITERAL
    delayMillisecondsVal = pauseMilliseconds
  ELSE
    IF hasArg = 1 THEN
      IF delayMode = 1 THEN
        ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "SLEEP REQUIRES NUMERIC ARGUMENT")
      ELSE
        ff = tiraParseExpressionNumericId(startIdx + 1, endIdx, ALIM, "_DELAY REQUIRES NUMERIC ARGUMENT")
      END IF

      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      argType = tiraParsedArgType
      argVal = tiraParsedArgVal

      IF delayMode = 1 THEN
        delayMillisecondsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, delayMillisecondsIdx, argType, argVal, TIRA_ARG_LITERAL, 1000
      ELSE
        argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)

        IF exprIs.DataType <> TYPE_DOUBLE THEN
          tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, argFloatIdx, argType, argVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
        ELSE
          tiraAssignId argFloatIdx, argType, argVal
        END IF

        msFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)

        ff = resolveSymbol("!C_PRS_VAL_FLT_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
        t.TiraVarCounter = t.TiraVarCounter + 1

        IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
          throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        msScaleIdx = returnedData2
        symbols(msScaleIdx).DataType = TYPE_DOUBLE
        floatVarData(msScaleIdx) = 1000

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, msFloatIdx, TIRA_ARG_SYMBOL, argFloatIdx, TIRA_ARG_SYMBOL, msScaleIdx

        delayMillisecondsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, delayMillisecondsIdx, TIRA_ARG_SYMBOL, msFloatIdx, TIRA_ARG_LITERAL, TYPE_LONG
      END IF

      delayMillisecondsType = TIRA_ARG_SYMBOL
      delayMillisecondsVal = delayMillisecondsIdx

      skipClampLblIdx = tiraLabelCreateNewId&("DELAY_SKIP_CLAMP")
      tiraJmpCondId JCC_JGE, delayMillisecondsType, delayMillisecondsVal, TIRA_ARG_LITERAL, 0, skipClampLblIdx
      tiraAssignId delayMillisecondsIdx, TIRA_ARG_LITERAL, 0
      tiraLabelId skipClampLblIdx
    END IF
  END IF

  IF delayMode = 0 THEN
    ff = resolveSymbol("IAT_SLEEP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    sleepFuncIdx = returnedData2
    tiraCallId1 sleepFuncIdx, delayMillisecondsType, delayMillisecondsVal
  ELSE
    IF delayMode = 2 THEN
      IF cm.HasGraphics = 1 THEN
        skipPresentLblIdx = tiraLabelCreateNewId&("PLAY_SKIP_PRESENT")
        ff = resolveSymbol("!G_GFX_FLG_AUTO")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        autoIdx = returnedData2
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, autoIdx, TIRA_ARG_LITERAL, 0, skipPresentLblIdx

        pendingBitsIdx = tiraDimVarId&("T", TYPE_LONG)
        ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        pendingIdx = returnedData2
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_LITERAL, 1
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipPresentLblIdx

        ' Present the completed frame before honoring the PLAY pause
        ff = resolveSymbol("RT_SWAP_BUFFERS")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        swapBuffersFuncIdx = returnedData2
        tiraCallId0 swapBuffersFuncIdx
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_LITERAL, -2

        tiraLabelId skipPresentLblIdx
      END IF

      ff = resolveSymbol("IAT_SLEEP")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      sleepFuncIdx = returnedData2
      tiraCallId1 sleepFuncIdx, delayMillisecondsType, delayMillisecondsVal

      IF cm.HasGraphics = 1 THEN
        skipTickLblIdx = tiraLabelCreateNewId&("PLAY_SKIP_TICK")
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, autoIdx, TIRA_ARG_LITERAL, 0, skipTickLblIdx

        ' Restart automatic display timing after the pause so the next CLS remains offscreen
        ff = resolveSymbol("IAT_GETTICKCOUNT")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        getTickFuncIdx = returnedData2
        tiraCallId0 getTickFuncIdx
        currentTickIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraGetRetId currentTickIdx
        ff = resolveSymbol("!G_GFX_VAL_DISPLAYI_TIMER")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        displayTimerIdx = returnedData2
        tiraAssignId displayTimerIdx, TIRA_ARG_SYMBOL, currentTickIdx

        tiraLabelId skipTickLblIdx
      END IF
    ELSE
      releaseWaitLblIdx = tiraLabelCreateNewId&("SLEEP_RELEASE_WAIT")
      releaseKeyLblIdx = tiraLabelCreateNewId&("SLEEP_RELEASE_KEY")
      sleepWaitLblIdx = tiraLabelCreateNewId&("SLEEP_WAIT")
      sleepKeyLblIdx = tiraLabelCreateNewId&("SLEEP_KEY")
      doneLblIdx = tiraLabelCreateNewId&("SLEEP_DONE")

      IF hasArg = 1 THEN
        tiraJmpCondId JCC_JLE, delayMillisecondsType, delayMillisecondsVal, TIRA_ARG_LITERAL, 0, doneLblIdx
      END IF

      keyIdx = tiraDimVarId&("T", TYPE_LONG)
      keyStateIdx = tiraDimVarId&("T", TYPE_LONG)

      IF cm.HasGraphics = 1 THEN
        skipPresentLblIdx = tiraLabelCreateNewId&("SLEEP_SKIP_PRESENT")
        ff = resolveSymbol("!G_GFX_FLG_AUTO")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        autoIdx = returnedData2
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, autoIdx, TIRA_ARG_LITERAL, 0, skipPresentLblIdx

        pendingBitsIdx = tiraDimVarId&("T", TYPE_LONG)
        ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        pendingIdx = returnedData2
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_LITERAL, 1
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipPresentLblIdx

        ' Present the completed frame before entering the SLEEP wait
        ff = resolveSymbol("RT_SWAP_BUFFERS")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        swapBuffersFuncIdx = returnedData2
        tiraCallId0 swapBuffersFuncIdx
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_SYMBOL, pendingIdx, TIRA_ARG_LITERAL, -2

        tiraLabelId skipPresentLblIdx
      END IF

      tiraLabelId releaseWaitLblIdx
      ff = resolveSymbol("IAT_SLEEP")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      sleepFuncIdx = returnedData2
      tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 10
      tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

      tiraLabelId releaseKeyLblIdx
      ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      getAsyncKeyStateFuncIdx = returnedData2
      tiraCallId1 getAsyncKeyStateFuncIdx, TIRA_ARG_SYMBOL, keyIdx
      tiraGetRetId keyStateIdx
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 32768
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, releaseWaitLblIdx

      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, releaseKeyLblIdx

      tiraLabelId sleepWaitLblIdx
      tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 10
      tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

      tiraLabelId sleepKeyLblIdx
      tiraCallId1 getAsyncKeyStateFuncIdx, TIRA_ARG_SYMBOL, keyIdx
      tiraGetRetId keyStateIdx
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 32768
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, sleepKeyLblIdx

      IF hasArg = 1 THEN
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, delayMillisecondsIdx, TIRA_ARG_SYMBOL, delayMillisecondsIdx, TIRA_ARG_LITERAL, 10
        tiraJmpCondId JCC_JG, delayMillisecondsType, delayMillisecondsVal, TIRA_ARG_LITERAL, 0, sleepWaitLblIdx
      ELSE
        tiraJmpId sleepWaitLblIdx
      END IF

      tiraLabelId doneLblIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DELAY_Core = 1

END FUNCTION ' parse_DELAY_Core

''''''''''''''''''''''''
FUNCTION parse_DEVICE$ (startIdx, endIdx, allowImplicit)

' Returns the description string of a specified connected input device

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_DEVICE$", 3) = 0 THEN
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("DEVICE", "_DSC")
  IF scratchIdx = 0 THEN
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  ff = resolveSymbol("RT_DEVICE")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, arg1Type, arg1Val, TIRA_ARG_SYMBOL, descPtrIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_DEVICE$ = scratchName$

END FUNCTION ' parse_DEVICE$

''''''''''''''''''''''''
FUNCTION parse_DEVICEINPUT$ (startIdx, endIdx, allowImplicit)

' Polls and processes input events from connected hardware devices

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_DEVICEINPUT", 3) = 0 THEN
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("DEVINP", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("RT_DEVICEINPUT")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEVICEINPUT$ = scratchName$

END FUNCTION ' parse_DEVICEINPUT$

''''''''''''''''''''''''
FUNCTION parse_DEVICES$ (startIdx, endIdx, allowImplicit)

' Returns the total count of connected hardware input devices

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DEVICES", ASIS, 0
    parse_DEVICES$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("DEVICES", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DEVICES$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("RT_DEVICES")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEVICES$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraCallId0 callFuncIdx
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEVICES$ = scratchName$

END FUNCTION ' parse_DEVICES$

''''''''''''''''''''''''
FUNCTION parse_DESKTOPHEIGHT$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DESKTOPHEIGHT", ASIS, 0
    parse_DESKTOPHEIGHT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("DKHGT", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DESKTOPHEIGHT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
  IF ff = 0 THEN
    tira_Cancel
    parse_DESKTOPHEIGHT$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraCallId1 callFuncIdx, TIRA_ARG_LITERAL, 1
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DESKTOPHEIGHT$ = scratchName$

END FUNCTION ' parse_DESKTOPHEIGHT$

''''''''''''''''''''''''
FUNCTION parse_DESKTOPWIDTH$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DESKTOPWIDTH", ASIS, 0
    parse_DESKTOPWIDTH$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("DKWID", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DESKTOPWIDTH$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
  IF ff = 0 THEN
    tira_Cancel
    parse_DESKTOPWIDTH$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraCallId1 callFuncIdx, TIRA_ARG_LITERAL, 0
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DESKTOPWIDTH$ = scratchName$

END FUNCTION ' parse_DESKTOPWIDTH$

''''''''''''''''''''''''
FUNCTION parse_DEST (startIdx)

  DIM endIdx AS LONG
  DIM pageVarType AS LONG
  DIM pageVarVal AS _INTEGER64
  DIM lblDest0Idx AS LONG
  DIM lblDest1Idx AS LONG
  DIM lblDest2Idx AS LONG
  DIM lblDest3Idx AS LONG
  DIM lblDestEndIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM destBufferIdx AS LONG
  DIM destCountPtrIdx AS LONG
  DIM destPageIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM countBackIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM countPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM countPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM countPage3Idx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_DEST REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED PAGE NUMBER AFTER _DEST", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  pageVarType = tiraParsedArgType
  pageVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destCountPtrIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  frameBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage3Idx = returnedData2

  lblDest0Idx = tiraLabelCreateNewId&("DEST_0")
  lblDest1Idx = tiraLabelCreateNewId&("DEST_1")
  lblDest2Idx = tiraLabelCreateNewId&("DEST_2")
  lblDest3Idx = tiraLabelCreateNewId&("DEST_3")
  lblDestEndIdx = tiraLabelCreateNewId&("DEST_END")

  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 0, lblDest0Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 1, lblDest1Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 2, lblDest2Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 3, lblDest3Idx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest0Idx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countBackIdx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest1Idx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage1Idx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest2Idx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage2Idx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest3Idx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage3Idx

  tiraLabelId lblDestEndIdx
  tiraAssignId destPageIdx, pageVarType, pageVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DEST = 1

END FUNCTION ' parse_DEST

''''''''''''''''''''''''
FUNCTION parse_DEST_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM destPageIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DEST", ASIS, 0
    parse_DEST_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("DEST", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DEST_FUNC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    parse_DEST_FUNC$ = ""
    EXIT FUNCTION
  END IF
  destPageIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, destPageIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEST_FUNC$ = scratchName$

END FUNCTION ' parse_DEST_FUNC$

''''''''''''''''''''''''
FUNCTION parse_DIREXISTS$ (startIdx, endIdx, allowImplicit)

  DIM pathType AS LONG
  DIM pathVal AS _INTEGER64
  DIM pathDataPtrIdx AS LONG
  DIM getFileAttributesIdx AS LONG
  DIM attributesIdx AS LONG
  DIM directoryBitIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM scratchIdx AS LONG
  DIM scratchName$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_DIREXISTS", 3) = 0 THEN
    parse_DIREXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_DIREXISTS$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_DIREXISTS REQUIRES STRING PATH", ASIS, 0
    parse_DIREXISTS$ = ""
    EXIT FUNCTION
  END IF
  pathType = tiraParsedArgType
  pathVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("DIREXISTS", "_VAL")
  IF scratchIdx = 0 THEN
    parse_DIREXISTS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  tiraAssignId scratchIdx, TIRA_ARG_LITERAL, 0
  pathDataPtrIdx = tiraGetStringDataId&(pathType, pathVal)

  ff = resolveSymbol("IAT_GETFILEATTRIBUTESA")
  IF ff = 0 THEN
    tira_Cancel
    parse_DIREXISTS$ = ""
    EXIT FUNCTION
  END IF
  getFileAttributesIdx = returnedData2

  tiraCallId1 getFileAttributesIdx, TIRA_ARG_SYMBOL, pathDataPtrIdx
  attributesIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId attributesIdx

  doneLblIdx = tiraLabelCreateNewId&("DIREXISTS_DONE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, attributesIdx, TIRA_ARG_LITERAL, -1, doneLblIdx

  directoryBitIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, directoryBitIdx, TIRA_ARG_SYMBOL, attributesIdx, TIRA_ARG_LITERAL, 16
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, directoryBitIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId doneLblIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DIREXISTS$ = scratchName$

END FUNCTION ' parse_DIREXISTS$

''''''''''''''''''''''''
FUNCTION parse_DISPLAY_Core (startIdx, isDisplayI)

  ' Core routine for handling screen buffer flush updates

  DIM endIdx AS LONG
  DIM autoFlagIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF isDisplayI = 1 THEN cmdName$ = "_DISPLAYI" ELSE cmdName$ = "_DISPLAY"

  IF cm.HasGraphics = 0 THEN
    throwCompilerError cmdName$ + " REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx, cmdName$)
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  ff = resolveSymbol("!G_GFX_FLG_AUTO")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  autoFlagIdx = returnedData2

  tiraAssignId autoFlagIdx, TIRA_ARG_LITERAL, 0

  IF isDisplayI = 0 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
  ELSE
    ff = resolveSymbol("RT_AUTODISPLAY_CHECK")
  END IF

  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DISPLAY_Core = 1

END FUNCTION ' parse_DISPLAY_Core

''''''''''''''''''''''''
FUNCTION parse_ELSEIF (startIdx)

  DIM endIdx AS LONG
  DIM hasThen AS LONG
  DIM thenIdx AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG
  DIM new_ifID AS LONG
  DIM exprType AS LONG
  DIM exprVal AS _INTEGER64
  DIM ff AS LONG
  DIM falseLbl$
  DIM endLbl$
  DIM trueLbl$
  DIM newFalseLbl$
  DIM falseLblIdx AS LONG
  DIM endLblIdx AS LONG
  DIM trueLblIdx AS LONG
  DIM newFalseLblIdx AS LONG

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "ELSEIF WITHOUT IF", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_IF THEN
    throwCompilerError "ELSEIF WITHOUT IF", ASIS, 0
    EXIT FUNCTION
  END IF

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  IF hasThen = 0 THEN
    throwCompilerError "MISSING THEN", ASIS, 0
    EXIT FUNCTION
  END IF

  ifID_end = ctrls(ctrlCount - 1).Patch1
  ifID_false = ctrls(ctrlCount - 1).Patch2

  falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
  endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

  new_ifID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  ' Keep user-side IF-chain labels below the generated-ID range reserved for runtime helpers.
  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_ELSEIF = 0
    EXIT FUNCTION
  END IF

  trueLbl$ = "@IF_TRUE_" + LTRIM$(RTRIM$(STR$(new_ifID)))
  newFalseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(new_ifID)))

  tira_Start

  ' Jump to end of IF block because the previous block just finished executing successfully
  tiraScheduleHeapResetId
  ff = resolveSymbol(endLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endLblIdx = returnedData2
  tiraJmpId endLblIdx

  ' The previous IF/ELSEIF conditions will skip to right here if they evaluated to false
  ff = resolveSymbol(falseLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  falseLblIdx = returnedData2
  tiraLabelId falseLblIdx

  tira_EndAndProcess

  ' Hoist intrinsics strictly AFTER control flow labels are anchored
  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  ' Re-evaluate token boundaries in case intrinsic hoisting collapsed tokens on the line
  endIdx = lineTokenCount - 1

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 1, thenIdx - 1, ALIM, "TYPE MISMATCH IN CONDITION")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  exprType = tiraParsedArgType
  exprVal = tiraParsedArgVal

  ff = resolveSymbol(trueLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  trueLblIdx = returnedData2
  tiraJmpCondId JCC_JNE, exprType, exprVal, TIRA_ARG_LITERAL, 0, trueLblIdx
  tiraScheduleHeapResetId
  ff = resolveSymbol(newFalseLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  newFalseLblIdx = returnedData2
  tiraJmpId newFalseLblIdx

  tiraLabelId trueLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  ff = verifyNoExtraTokens(endIdx, thenIdx, "THEN")
  IF ff = 0 THEN EXIT FUNCTION

  ' Update the active false block ID to link with subsequent ELSEIF chains
  ctrls(ctrlCount - 1).Patch2 = new_ifID

  parse_ELSEIF = 1

END FUNCTION ' parse_ELSEIF

''''''''''''''''''''''''
FUNCTION parse_EOF$ (startIdx, endIdx, allowImplicit)

  ' Checks if the end of an open file has been reached

  DIM fileNumStart AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM handlesIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM resVarIdx AS LONG
  DIM sizeVarIdx AS LONG
  DIM posVarIdx AS LONG
  DIM lblEofIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM getFileSizeIdx AS LONG
  DIM setFilePointerIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "EOF", 3) = 0 THEN
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  fileNumStart = startIdx + 2

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    END IF
  END IF

  ff = tiraParseExpressionIntId(fileNumStart, endIdx - 1, allowImplicit, "FILENUM MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("EOF", "_VAL")
  IF scratchIdx = 0 THEN
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF
  handlesIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  ' Request the overall file size cleanly from the Windows API
  ff = resolveSymbol("IAT_GETFILESIZE")
  IF ff = 0 THEN
    tira_Cancel
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF
  getFileSizeIdx = returnedData2

  tiraCallId2 getFileSizeIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0
  sizeVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId sizeVarIdx

  ' Set file pointer with a movement delta of 0 and FILE_CURRENT (1) to retrieve the actual OS position
  ff = resolveSymbol("IAT_SETFILEPOINTER")
  IF ff = 0 THEN
    tira_Cancel
    parse_EOF$ = ""
    EXIT FUNCTION
  END IF
  setFilePointerIdx = returnedData2

  tiraCallId4 setFilePointerIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1
  posVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId posVarIdx

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  lblEofIdx = tiraLabelCreateNewId&("EOF_TRUE")
  lblEndIdx = tiraLabelCreateNewId&("EOF_END")

  ' Check if the current pointer position is equal to or exceeds the overall file size
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, posVarIdx, TIRA_ARG_SYMBOL, sizeVarIdx, lblEofIdx
  tiraJmpId lblEndIdx

  tiraLabelId lblEofIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId lblEndIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_EOF$ = scratchName$

END FUNCTION ' parse_EOF$

''''''''''''''''''''''''
FUNCTION parse_FILEEXISTS$ (startIdx, endIdx, allowImplicit)

  ' Checks if a specific file exists on the disk

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM strDataPtrIdx AS LONG
  DIM attrValIdx AS LONG
  DIM isDirIdx AS LONG
  DIM skipDirLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM getFileAttributesIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_FILEEXISTS", 3) = 0 THEN
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_FILEEXISTS REQUIRES STRING ARGUMENT", ASIS, 0
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("FEXISTS", "_VAL")
  IF scratchIdx = 0 THEN
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  strDataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)

  ff = resolveSymbol("IAT_GETFILEATTRIBUTESA")
  IF ff = 0 THEN
    tira_Cancel
    parse_FILEEXISTS$ = ""
    EXIT FUNCTION
  END IF
  getFileAttributesIdx = returnedData2

  tiraCallId1 getFileAttributesIdx, TIRA_ARG_SYMBOL, strDataPtrIdx
  attrValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId attrValIdx

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  skipDirLblIdx = tiraLabelCreateNewId&("FEXISTS_SKIP")
  jmpDoneLblIdx = tiraLabelCreateNewId&("FEXISTS_DONE")

  ' If returned -1 (INVALID_FILE_ATTRIBUTES), file does not exist
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, attrValIdx, TIRA_ARG_LITERAL, -1, jmpDoneLblIdx

  ' Check if it is a directory (FILE_ATTRIBUTE_DIRECTORY = 16)
  isDirIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, isDirIdx, TIRA_ARG_SYMBOL, attrValIdx, TIRA_ARG_LITERAL, 16
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, isDirIdx, TIRA_ARG_LITERAL, 0, skipDirLblIdx

  ' File exists and is not a directory
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId jmpDoneLblIdx

  tiraLabelId skipDirLblIdx

  tiraLabelId jmpDoneLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FILEEXISTS$ = scratchName$

END FUNCTION ' parse_FILEEXISTS$

''''''''''''''''''''''''
FUNCTION parse_FIX$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM floatArgIdx AS LONG
  DIM floatTruncIdx AS LONG
  DIM negativeLblIdx AS LONG
  DIM doneLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "FIX", 3) = 0 THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("FIX", "_VAL")
  IF scratchIdx = 0 THEN
    parse_FIX$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_LONG

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, arg1Type, arg1Val

  floatArgIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatArgIdx, arg1Type, arg1Val

  floatTruncIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatTruncIdx, TIRA_ARG_SYMBOL, resVarIdx

  negativeLblIdx = tiraLabelCreateNewId&("FIX_NEGATIVE")
  doneLblIdx = tiraLabelCreateNewId&("FIX_DONE")

  ' Correct round-to-nearest conversion so FIX truncates toward zero
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, floatArgIdx, TIRA_ARG_LITERAL, 0, negativeLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, floatArgIdx, TIRA_ARG_SYMBOL, floatTruncIdx, doneLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId doneLblIdx

  tiraLabelId negativeLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, floatArgIdx, TIRA_ARG_SYMBOL, floatTruncIdx, doneLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId doneLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FIX$ = scratchName$

END FUNCTION ' parse_FIX$

''''''''''''''''''''''''
FUNCTION parse_FONT (startIdx)

  DIM endIdx AS LONG
  DIM fontValue AS DOUBLE
  DIM fontFirst AS STRING * 1
  DIM fontIsNumeric AS LONG
  DIM fontHeightIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx <> startIdx + 1 THEN
    throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 0 THEN
    throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  fontToken$ = lineTokens$(startIdx + 1)
  fontFirst = LEFT$(fontToken$, 1)
  fontIsNumeric = 0

  IF fontFirst >= "0" AND fontFirst <= "9" THEN fontIsNumeric = 1
  IF fontFirst = "-" OR fontFirst = "." THEN fontIsNumeric = 1
  IF fontFirst = "&" THEN
    IF UCASE$(MID$(fontToken$, 2, 1)) = "H" OR UCASE$(MID$(fontToken$, 2, 1)) = "O" THEN
      fontIsNumeric = 1
    END IF
  END IF

  IF fontIsNumeric = 0 THEN
    IF (fontFirst >= "A" AND fontFirst <= "Z") OR (fontFirst >= "a" AND fontFirst <= "z") OR fontFirst = "_" OR fontFirst = "!" THEN
      throwCompilerError "_FONT DOES NOT ACCEPT VARIABLES", ASIS, 0
    ELSE
      throwCompilerError "_FONT REQUIRES ONE NUMERIC LITERAL: 8, 14, OR 16", ASIS, 0
    END IF
    EXIT FUNCTION
  END IF

  fontValue = VAL(fontToken$)

  IF fontValue <> 8 AND fontValue <> 14 AND fontValue <> 16 THEN
    throwCompilerError "_FONT ONLY SUPPORTS 8, 14, OR 16", ASIS, 0
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FONT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fontHeightIdx = returnedData2

  tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, fontValue

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_FONT = 1

END FUNCTION ' parse_FONT

''''''''''''''''''''''''
FUNCTION parse_FREEFILE$ (startIdx, endIdx, allowImplicit)

  ' Returns the next available open file number from the operating system

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM idxVarIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM handlesIdx AS LONG
  DIM loopTopLblIdx AS LONG
  DIM loopDoneLblIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipLimitLblIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED FREEFILE", ASIS, 0
    parse_FREEFILE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("FREEFILE", "_VAL")
  IF scratchIdx = 0 THEN
    parse_FREEFILE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  idxVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId idxVarIdx, TIRA_ARG_LITERAL, 1

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    parse_FREEFILE$ = ""
    EXIT FUNCTION
  END IF
  handlesIdx = returnedData2

  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesIdx

  loopTopLblIdx = tiraLabelCreateNewId&("FF_TOP")
  loopDoneLblIdx = tiraLabelCreateNewId&("FF_DONE")

  tiraLabelId loopTopLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 255, loopDoneLblIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  ' If the handle is 0, this slot is completely unused
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, loopDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopLblIdx

  tiraLabelId loopDoneLblIdx

  ' Gracefully zero out the return variable if we exceeded 255 (no free files available)
  skipLimitLblIdx = tiraLabelCreateNewId&("FF_LIMIT")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 255, skipLimitLblIdx
  tiraAssignId idxVarIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId skipLimitLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, idxVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_FREEFILE$ = scratchName$

END FUNCTION ' parse_FREEFILE$

''''''''''''''''''''''''
FUNCTION parse_FREEIMAGE (startIdx)

  DIM endIdx AS LONG
  DIM handleVarType AS LONG
  DIM handleVarVal AS _INTEGER64
  DIM handleVarIdx AS LONG
  DIM lblCheck2Idx AS LONG
  DIM lblCheck3Idx AS LONG
  DIM lblErrorIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM fbClearSizeIdx AS LONG
  DIM lblSkipDestIdx AS LONG
  DIM lblSkipSrcIdx AS LONG
  DIM endFreeLblIdx AS LONG
  DIM countPage2Idx AS LONG
  DIM countPage3Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM destPageIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM destBufferIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM destCountPtrIdx AS LONG
  DIM countBackIdx AS LONG
  DIM sourcePageIdx AS LONG
  DIM sourceFrameIdx AS LONG
  DIM sourceBufferIdx AS LONG
  DIM sourceCountPtrIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FREEIMAGE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF endIdx >= startIdx + 1 THEN
    ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "HANDLE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    handleVarType = tiraParsedArgType
    handleVarVal = tiraParsedArgVal
  ELSE
    handleVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPageIdx = returnedData2

    tiraAssignId handleVarIdx, TIRA_ARG_SYMBOL, destPageIdx
    handleVarType = TIRA_ARG_SYMBOL
    handleVarVal = handleVarIdx
  END IF

  lblCheck2Idx = tiraLabelCreateNewId&("FREE_CHK2")
  lblCheck3Idx = tiraLabelCreateNewId&("FREE_CHK3")
  lblErrorIdx = tiraLabelCreateNewId&("FREE_ERR")
  lblDoneIdx = tiraLabelCreateNewId&("FREE_DONE")
  endFreeLblIdx = tiraLabelCreateNewId&("FREE_END")

  tiraJmpCondId JCC_JE, handleVarType, handleVarVal, TIRA_ARG_LITERAL, 2, lblCheck2Idx
  tiraJmpCondId JCC_JE, handleVarType, handleVarVal, TIRA_ARG_LITERAL, 3, lblCheck3Idx
  tiraJmpId lblErrorIdx

  tiraLabelId lblCheck2Idx

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage2Idx = returnedData2

  tiraAssignId countPage2Idx, TIRA_ARG_LITERAL, 0
  fbClearSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fbClearSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage2Idx = returnedData2

  tiraMemSetId TIRA_ARG_SYMBOL, framePage2Idx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, fbClearSizeIdx
  tiraJmpId lblDoneIdx

  tiraLabelId lblCheck3Idx

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage3Idx = returnedData2

  tiraAssignId countPage3Idx, TIRA_ARG_LITERAL, 0
  fbClearSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fbClearSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage3Idx = returnedData2

  tiraMemSetId TIRA_ARG_SYMBOL, framePage3Idx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, fbClearSizeIdx

  tiraLabelId lblDoneIdx

  ' Reset DEST to 0 if it was the freed handle
  lblSkipDestIdx = tiraLabelCreateNewId&("FREE_SKIP_DEST")

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destPageIdx = returnedData2

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, destPageIdx, handleVarType, handleVarVal, lblSkipDestIdx
  tiraAssignId destPageIdx, TIRA_ARG_LITERAL, 0

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  frameBackIdx = returnedData2

  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

  ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferBackIdx = returnedData2

  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

  ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destCountPtrIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countBackIdx = returnedData2

  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countBackIdx
  tiraLabelId lblSkipDestIdx

  ' Reset SOURCE to 0 if it was the freed handle
  lblSkipSrcIdx = tiraLabelCreateNewId&("FREE_SKIP_SRC")

  ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  sourcePageIdx = returnedData2

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, sourcePageIdx, handleVarType, handleVarVal, lblSkipSrcIdx
  tiraAssignId sourcePageIdx, TIRA_ARG_LITERAL, 0

  ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  sourceFrameIdx = returnedData2

  tiraAssignId sourceFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

  ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  sourceBufferIdx = returnedData2

  tiraAssignId sourceBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

  ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  sourceCountPtrIdx = returnedData2

  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, sourceCountPtrIdx, TIRA_ARG_SYMBOL, countBackIdx
  tiraLabelId lblSkipSrcIdx

  tiraJmpId endFreeLblIdx

  tiraLabelId lblErrorIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL IN _FREEIMAGE"

  tiraLabelId endFreeLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_FREEIMAGE = 1

END FUNCTION ' parse_FREEIMAGE

''''''''''''''''''''''''
FUNCTION parse_FULLSCREEN (startIdx)

  DIM endIdx AS LONG
  DIM fullscreenMode AS LONG
  DIM optionName$
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_FULLSCREEN REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  fullscreenMode = 1

  IF endIdx > startIdx THEN
    optionName$ = UCASE$(lineTokens$(startIdx + 1))

    IF optionName$ = "OFF" THEN
      fullscreenMode = 0
    END IF
  END IF

  ' _STRETCH, _SQUAREPIXELS and _SMOOTH currently use the standard fullscreen path
  tira_Start

  ff = resolveSymbol("RT_FULLSCREEN")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, TIRA_ARG_LITERAL, fullscreenMode
  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_FULLSCREEN = 1

END FUNCTION ' parse_FULLSCREEN

''''''''''''''''''''''''
FUNCTION parse_GDOUBLE (startIdx)

  DIM endIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GDOUBLE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx > startIdx THEN
    throwCompilerError "GDOUBLE DOES NOT TAKE ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("RT_GDOUBLE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx
  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_GDOUBLE = 1

END FUNCTION ' parse_GDOUBLE

''''''''''''''''''''''''
FUNCTION parse_GET_File (startIdx, endIdx)

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM targetStart AS LONG
  DIM closeParen AS LONG
  DIM tokIdx AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM numParsedIndices AS LONG

  DIM hasArrayIndices AS LONG
  DIM hasPosition AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM positionType AS LONG
  DIM positionVal AS _INTEGER64
  DIM handlesArrayIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipFileIOLblIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM fileModeIdx AS LONG
  DIM recordLenIdx AS LONG
  DIM fileModeOkLblIdx AS LONG
  DIM ptrIdx AS LONG
  DIM dataSizeIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataPtrIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM readFileIdx AS LONG

  tokIdx = startIdx + 1
  IF lineTokens$(tokIdx) = "#" THEN
    tokIdx = tokIdx + 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "GET MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    targetStart = comma1 + 1
  ELSE
    targetStart = comma2 + 1
  END IF

  IF targetStart > endIdx THEN
    throwCompilerError "GET MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(targetStart)
  vName$ = UCASE$(vTok$)
  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ff = tiraParseExpressionIntId(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  hasPosition = 0

  IF comma2 > 0 THEN
    IF comma2 > comma1 + 1 THEN
      ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, ALIM, "FILE POSITION MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      positionType = tiraParsedArgType
      positionVal = tiraParsedArgVal
      hasPosition = 1
    END IF
  END IF

  numParsedIndices = 0
  hasArrayIndices = 0

  IF targetStart < endIdx THEN
    IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
      hasArrayIndices = 1
      ff = tiraParseArrayId(targetStart + 1, endIdx, ALIM)
      IF ff = 0 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasArrayIndices = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasArrayIndices = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  handlesArrayIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  skipFileIOLblIdx = tiraLabelCreateNewId&("SKIP_FILE_IO")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipFileIOLblIdx

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES

  fileModeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId fileModeIdx, TIRA_ARG_SYMBOL, stateSlotIdx

  recordLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId recordLenIdx, TIRA_ARG_SYMBOL, stateSlotIdx, FS_STATE_RECORD_LENGTH_OFFSET

  fileModeOkLblIdx = tiraLabelCreateNewId&("GET_FILE_MODE_OK")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_BINARY, fileModeOkLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_RANDOM, fileModeOkLblIdx
  tiraFatalErrorId "BAD FILE MODE"
  tiraLabelId fileModeOkLblIdx

  ptrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
  IF ptrIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  dt = symbols(vIdx).DataType
  elemSize = retElementByteSize(vIdx)
  fixedLen = retFixedStringLength(vIdx)

  dataSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF dt = TYPE_STRING AND fixedLen = 0 THEN
    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    IF symbols(vIdx).IsArray > 0 THEN
      tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
    ELSE
      tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
    END IF

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)
    tiraAssignId dataSizeIdx, TIRA_ARG_SYMBOL, strLenIdx
    strDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, strDataPtrIdx

    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

  ELSE
    IF dt = TYPE_STRING AND fixedLen > 0 THEN
      tiraAssignId dataSizeIdx, TIRA_ARG_LITERAL, fixedLen

      IF symbols(vIdx).IsArray > 0 THEN
        tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
      ELSE
        descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

        strDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
        tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, strDataPtrIdx
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
      END IF
    ELSE
      tiraAssignId dataSizeIdx, TIRA_ARG_LITERAL, elemSize
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
    END IF
  END IF

  tiraFlushFileWriteBufferId

  IF hasPosition = 1 THEN
    tiraSeekFilePositionId TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_SYMBOL, recordLenIdx, positionType, positionVal
    IF compileError = 1 THEN EXIT FUNCTION
  END IF

  numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
  numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

  ff = resolveSymbol("IAT_READFILE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  readFileIdx = returnedData2

  tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId skipFileIOLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_GET_File = 1

END FUNCTION ' parse_GET_File

''''''''''''''''''''''''
FUNCTION parse_GLOBAL (startIdx)

  DIM tempSuccess AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "MALFORMED GLOBAL", ASIS, 0
    EXIT FUNCTION
  END IF

  tempSuccess = parse_GLOBAL_Core(startIdx + 1, endIdx)

  parse_GLOBAL = tempSuccess

END FUNCTION ' parse_GLOBAL

''''''''''''''''''''''''
FUNCTION parse_GLOBAL_Core (startTokIdx, endIdx)

  ' Used by the synonym commands GLOBAL and COMMON SHARED

  DIM dtMapped AS LONG
  DIM fixedLen AS LONG
  DIM typeData AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  tokIdx = startTokIdx

  DO WHILE tokIdx <= endIdx
    vTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerError "EXPECTED VARIABLE NAME", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(vTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    symbols(vIdx).IsShared = 1
    symbols(vIdx).IsExplicit = DECL_EXPLICIT

    tokIdx = tokIdx + 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN EXIT FUNCTION

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerError "EXPECTED COMMA", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  parse_GLOBAL_Core = 1

END FUNCTION ' parse_GLOBAL_Core

''''''''''''''''''''''''
FUNCTION parse_GOSUB (startIdx)

  ' Branches execution to a subroutine label and returns later

  DIM endIdx AS LONG
  DIM targetTok$
  DIM targetLabelName$
  DIM targetLabelIdx AS LONG
  DIM retLblIdx AS LONG
  DIM retAddrVarIdx AS LONG
  DIM tgtPtrVarIdx AS LONG
  DIM baseAddrVarIdx AS LONG
  DIM gosubArrayIdx AS LONG
  DIM gosubIndexIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "GOSUB NEEDS LABEL", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "GOSUB")
  IF ff = 0 THEN EXIT FUNCTION

  targetTok$ = lineTokens$(startIdx + 1)
  targetLabelName$ = "%" + UCASE$(targetTok$)

  expectedSymType = TYPE_LABEL
  ff = resolveSymbol(targetLabelName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF
  targetLabelIdx = returnedData2

  tira_Start

  retLblIdx = tiraLabelCreateNewId&("GOSUB_RET")
  retAddrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tgtPtrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  baseAddrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, retAddrVarIdx, TIRA_ARG_LABEL, retLblIdx

  ff = resolveSymbol("!G_SYS_ARR_GOSUB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gosubArrayIdx = returnedData2

  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrVarIdx, TIRA_ARG_SYMBOL, gosubArrayIdx

  ff = resolveSymbol("!G_SYS_IDX_GOSUB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gosubIndexIdx = returnedData2

  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, tgtPtrVarIdx, TIRA_ARG_SYMBOL, baseAddrVarIdx, TIRA_ARG_SYMBOL, gosubIndexIdx, TIRA_ARG_LITERAL, 8
  tiraWriteMemId TIRA_ARG_SYMBOL, tgtPtrVarIdx, TIRA_ARG_SYMBOL, retAddrVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, gosubIndexIdx, TIRA_ARG_SYMBOL, gosubIndexIdx, TIRA_ARG_LITERAL, 1

  tiraScheduleHeapResetId
  tiraJmpUserId targetLabelIdx

  tiraLabelId retLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  parse_GOSUB = 1

END FUNCTION ' parse_GOSUB

''''''''''''''''''''''''
FUNCTION parse_GREEN32$ (startIdx, endIdx, allowImplicit)

  ' Extracts the green channel component from a 32-bit color value

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM shiftVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_GREEN32", 3) = 0 THEN
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "_GREEN32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("GRN32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  shiftVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, shiftVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftVarIdx, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_GREEN32$ = scratchName$

END FUNCTION ' parse_GREEN32$

''''''''''''''''''''''''
FUNCTION parse_HEIGHT$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM resHeight AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED _HEIGHT", ASIS, 0
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED _HEIGHT", ASIS, 0
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_HEIGHT$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("HEIGHT", "_VAL")
  IF scratchIdx = 0 THEN
    parse_HEIGHT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_LONG

  resHeight = 25
  IF cm.HasGraphics = 1 THEN resHeight = gfxConfig.SizeY

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, resHeight

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_HEIGHT$ = scratchName$

END FUNCTION ' parse_HEIGHT$

''''''''''''''''''''''''
FUNCTION parse_HEX$ (startIdx, endIdx, allowImplicit)

  ' Converts a numeric value into a hexadecimal string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM argDataType AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM ptrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipAlphaIdx AS LONG
  DIM jmpWriteIdx AS LONG
  DIM strLenIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM workVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "HEX$", 3) = 0 THEN
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF

  ' Sovereign command opens its own compilation block
  tira_Start

  ' The Shunting Yard safely queues argument evaluation inside our pristine TIRA session
  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "HEX$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  argDataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("HEX", "_DSC")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Copy the evaluated argument into a working variable to prevent mutating user variables
  workVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId workVarIdx, arg1Type, arg1Val

  basePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 16)
  IF compileError = 1 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF

  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 16

  ' Mask the value to prevent infinite sign-extension loops for negative numbers

  SELECT CASE argDataType

    CASE TYPE_BYTE, TYPE_UBYTE
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 255
    CASE TYPE_INTEGER, TYPE_UINTEGER
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 65535
    CASE TYPE_LONG, TYPE_ULONG
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 4294967295

  END SELECT ' argDataType

  loopTopIdx = tiraLabelCreateNewId&("HEX_LOOP")
  tiraLabelId loopTopIdx

  digitIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 15

  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  skipAlphaIdx = tiraLabelCreateNewId&("HEX_SKIP_ALPHA")

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 10, skipAlphaIdx

  ' 0-9
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48
  jmpWriteIdx = tiraLabelCreateNewId&("HEX_WRITE")
  tiraJmpId jmpWriteIdx

  tiraLabelId skipAlphaIdx

  ' A-F
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 55

  tiraLabelId jmpWriteIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' Shr performs a logical shift, injecting zeros into the upper bits.
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 4

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  ' Close the block (NO HEAP RESET, so the string survives for the parent!)
  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_HEX$ = scratchName$

END FUNCTION ' parse_HEX$

''''''''''''''''''''''''
FUNCTION parse_IF (startIdx)

  DIM hasThen AS LONG
  DIM thenIdx AS LONG
  DIM ifID AS LONG
  DIM endIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  DIM trueLblIdx AS LONG
  DIM falseLblIdx AS LONG

  endIdx = lineTokenCount - 1

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  IF hasThen = 0 THEN
    throwCompilerError "MISSING THEN", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Generate a globally unique ID for this IF block
  ifID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_IF = 0
    EXIT FUNCTION
  END IF

  trueLbl$ = "@IF_TRUE_" + _TRIM$(STR$(ifID))
  falseLbl$ = "@IF_FALSE_" + _TRIM$(STR$(ifID))
  endLbl$ = "@IF_END_" + _TRIM$(STR$(ifID))

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 1, thenIdx - 1, ALIM, "TYPE MISMATCH IN CONDITION")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal

  ff = resolveSymbol(trueLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  trueLblIdx = returnedData2

  ' Anchor the True jump so execution flows into the THEN block
  tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, trueLblIdx
  tiraScheduleHeapResetId

  ff = resolveSymbol(falseLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  falseLblIdx = returnedData2

  tiraJmpId falseLblIdx

  tiraLabelId trueLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  ' Due to iterative Pass 2 flattening, single-line IF statements should never reach Pass 5.
  ' If there are tokens after THEN, something is structurally malformed in the source code.
  ff = verifyNoExtraTokens(endIdx, thenIdx, "THEN")
  IF ff = 0 THEN EXIT FUNCTION

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_IF
  ctrls(ctrlCount).Patch1 = ifID ' Save the master END IF block ID for final exit jumps
  ctrls(ctrlCount).Patch2 = ifID ' Save current FALSE block ID to link with subsequent ELSEIF chains
  ctrlCount = ctrlCount + 1

  parse_IF = 1

END FUNCTION ' parse_IF

''''''''''''''''''''''''
FUNCTION parse_KEYHIT$ (startIdx, endIdx, allowImplicit)

  ' Returns the ASCII code of the last key pressed

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM headSymbolIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailSymbolIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM emptyLblIdx AS LONG
  DIM bufSymbolIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charValIdx AS LONG
  DIM jmpDoneIdx AS LONG
  DIM normalLblIdx AS LONG
  DIM secondAddrIdx AS LONG
  DIM secondValIdx AS LONG
  DIM keyIdx AS LONG
  DIM keyLoopIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM skipKeyIdx AS LONG
  DIM mappedKeyIdx AS LONG
  DIM nmpSkipIdx AS LONG
  DIM ar1Idx AS LONG
  DIM ar2Idx AS LONG
  DIM ar3Idx AS LONG
  DIM ar4Idx AS LONG
  DIM resVarIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _KEYHIT", ASIS, 0
    parse_KEYHIT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("KEYHIT", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_KEYHIT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    headSymbolIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, headSymbolIdx
    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    tailSymbolIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailSymbolIdx
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    emptyLblIdx = tiraLabelCreateNewId&("KEYHIT_EMPTY")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, emptyLblIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    bufSymbolIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufSymbolIdx

    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255

    normalLblIdx = tiraLabelCreateNewId&("KEYHIT_NORMAL")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, normalLblIdx

    ' Convert the queued BIOS scan code to the QB64 extended _KEYHIT value
    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    secondValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId secondValIdx, TIRA_ARG_SYMBOL, secondAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 256

    jmpDoneIdx = tiraLabelCreateNewId&("KEYHIT_DONE")
    tiraJmpId jmpDoneIdx

    tiraLabelId normalLblIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, charValIdx
    tiraJmpId jmpDoneIdx

    tiraLabelId emptyLblIdx
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraLabelId jmpDoneIdx
  ELSE
    ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    getAsyncKeyStateIdx = returnedData2

    keyIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

    keyLoopIdx = tiraLabelCreateNewId&("KEYHIT_KLOOP")
    tiraLabelId keyLoopIdx

    tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_SYMBOL, keyIdx
    keyStateIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId keyStateIdx

    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 32768
    skipKeyIdx = tiraLabelCreateNewId&("KEYHIT_SKIP")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, skipKeyIdx

    mappedKeyIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId mappedKeyIdx, TIRA_ARG_SYMBOL, keyIdx

    nmpSkipIdx = tiraLabelCreateNewId&("KEYHIT_NMPSKIP")
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 96, nmpSkipIdx
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 105, nmpSkipIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 48
    tiraLabelId nmpSkipIdx

    ar1Idx = tiraLabelCreateNewId&("KEYHIT_AR1")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 37, ar1Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 52
    tiraLabelId ar1Idx

    ar2Idx = tiraLabelCreateNewId&("KEYHIT_AR2")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 38, ar2Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 56
    tiraLabelId ar2Idx

    ar3Idx = tiraLabelCreateNewId&("KEYHIT_AR3")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 39, ar3Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 54
    tiraLabelId ar3Idx

    ar4Idx = tiraLabelCreateNewId&("KEYHIT_AR4")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 40, ar4Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 50
    tiraLabelId ar4Idx

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, mappedKeyIdx
    jmpDoneIdx = tiraLabelCreateNewId&("KEYHIT_DONE")
    tiraJmpId jmpDoneIdx

    tiraLabelId skipKeyIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, keyLoopIdx

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraLabelId jmpDoneIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tiraInjectPendingDisplayFlushId

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_KEYHIT$ = scratchName$

END FUNCTION ' parse_KEYHIT$

''''''''''''''''''''''''
FUNCTION parse_INP$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM scratchName$
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INP", 3) = 0 THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerErrorAndCancelTira "INP REQUIRES #GRAPHICS", ASIS, 0
    parse_INP$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "PORT MUST BE NUMERIC")
  IF ff = 0 THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("INP", "_VAL")
  IF scratchIdx = 0 THEN
    parse_INP$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("RT_INP")
  IF ff = 0 THEN
    tira_Cancel
    parse_INP$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INP$ = scratchName$

END FUNCTION ' parse_INP$

''''''''''''''''''''''''
FUNCTION parse_INPUT (startIdx)

  DIM endIdx AS LONG
  DIM isFile AS LONG
  DIM hasIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM vIdx AS LONG
  DIM litIdx AS LONG
  DIM litPtrIdx AS LONG
  DIM tgtAddrIdx AS LONG
  DIM isStrVar AS LONG
  DIM callFuncIdx AS LONG

  tokIdx = startIdx + 1

  endIdx = lineTokenCount - 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  isFile = 0
  IF lineTokens$(tokIdx) = "#" THEN
    isFile = 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      isFile = 1
    END IF
  END IF

  IF isFile = 1 THEN
    parse_INPUT = parse_INPUT_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  hasPrompt = 0
  promptStr$ = ""
  IF LEFT$(lineTokens$(tokIdx), 1) = CHR$(34) THEN
    hasPrompt = 1
    promptStr$ = extractQuotes$(lineTokens$(tokIdx))
    tokIdx = tokIdx + 1
    IF tokIdx > endIdx THEN
      throwCompilerError "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF
    tVal = lineTokenVals(tokIdx)
    IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
      tokIdx = tokIdx + 1
    ELSE
      throwCompilerError "EXPECTED ; OR ,", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)

  hasIndex = 0
  IF tokIdx < endIdx THEN
    IF lineTokenVals(tokIdx + 1) = 256 + ASC("(") THEN hasIndex = 1
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  isStrVar = 0
  IF returnedData3 = TYPE_STRING THEN
    isStrVar = 1
  END IF

  IF hasPrompt = 1 THEN
    pStr$ = promptStr$
  ELSE
    pStr$ = "? "
  END IF

  ff = resolveSymbol("!C_EVL_DSC_LTRL_" + _TRIM$(STR$(t.TiraVarCounter)))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_INPUT = 0
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN EXIT FUNCTION
  litIdx = returnedData2
  strVarData$(litIdx) = pStr$

  tira_Start

  litPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId litPtrIdx, TIRA_ARG_SYMBOL, litIdx

  tgtAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_SYMBOL, vIdx

  ff = resolveSymbol("RT_INPUT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId5 callFuncIdx, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_LITERAL, isStrVar, TIRA_ARG_SYMBOL, litPtrIdx, TIRA_ARG_LITERAL, symbols(vIdx).DataType, TIRA_ARG_LITERAL, 0

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_INPUT = 1

END FUNCTION ' parse_INPUT

''''''''''''''''''''''''
FUNCTION parse_INPUT_File (startIdx, endIdx)

  ' Reads sequential text fields from an open file into one or more variables

  DIM fileNumStart AS LONG
  DIM comma1 AS LONG
  DIM nextComma AS LONG
  DIM targetStart AS LONG
  DIM targetEnd AS LONG
  DIM targetCount AS LONG
  DIM parenEnd AS LONG
  DIM hasIndices AS LONG
  DIM numParsedIndices AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM fixedLen AS LONG

  DIM targetName$
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM fileHandlesIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM readFileIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM fileDoneLblIdx AS LONG

  DIM fieldBufIdx AS LONG
  DIM fieldLenIdx AS LONG
  DIM fieldStartedIdx AS LONG
  DIM fieldQuotedIdx AS LONG
  DIM charPtrIdx AS LONG
  DIM bytesReadIdx AS LONG
  DIM bytesReadPtrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM fieldReadTopLblIdx AS LONG
  DIM fieldStartedLblIdx AS LONG
  DIM fieldUnquotedLblIdx AS LONG
  DIM fieldAppendLblIdx AS LONG
  DIM fieldNoAppendLblIdx AS LONG
  DIM fieldDoneLblIdx AS LONG
  DIM quoteTailTopLblIdx AS LONG

  DIM targetAddrIdx AS LONG
  DIM rhsDescPtrIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM lhsDataPtrIdx AS LONG
  DIM copyLenIdx AS LONG
  DIM copyLenReadyLblIdx AS LONG
  DIM copyDoneLblIdx AS LONG
  DIM padLenIdx AS LONG
  DIM padAddrIdx AS LONG
  DIM padDoneLblIdx AS LONG

  DIM numericPtrIdx AS LONG
  DIM numericRemainIdx AS LONG
  DIM numericValueIdx AS LONG
  DIM numericNegIdx AS LONG
  DIM numericSkipTopLblIdx AS LONG
  DIM numericSkipDoneLblIdx AS LONG
  DIM numericConsumeLblIdx AS LONG
  DIM numericSignDoneLblIdx AS LONG
  DIM numericNegativeLblIdx AS LONG
  DIM numericConsumeSignLblIdx AS LONG
  DIM numericLoopTopLblIdx AS LONG
  DIM numericLoopDoneLblIdx AS LONG
  DIM numericApplySignLblIdx AS LONG
  DIM storeModeType AS LONG
  DIM storeModeVal AS _INTEGER64

  fileNumStart = startIdx + 1

  IF fileNumStart > endIdx THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    ELSE
      throwCompilerError "INPUT FILE MISSING #", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF fileNumStart > endIdx THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = 0
  ff = findNextTokenAtDepth0(fileNumStart, endIdx, 256 + ASC(","))
  IF ff = 1 THEN comma1 = returnedData2

  IF comma1 = 0 THEN
    throwCompilerError "INPUT # MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fileNumStart > comma1 - 1 THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  targetStart = comma1 + 1
  IF targetStart > endIdx THEN
    throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Validate and register every target before emitting the file operation
  targetCount = 0

  DO WHILE targetStart <= endIdx
    nextComma = 0
    ff = findNextTokenAtDepth0(targetStart, endIdx, 256 + ASC(","))
    IF ff = 1 THEN nextComma = returnedData2

    targetEnd = endIdx
    IF nextComma > 0 THEN targetEnd = nextComma - 1

    IF targetStart > targetEnd THEN
      throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF lineTokenVals(targetStart) <> 0 THEN
      throwCompilerError "INPUT # EXPECTED TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    hasIndices = 0

    IF targetStart < targetEnd THEN
      IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
        ff = findMatchingParen(targetStart + 1, targetEnd)
        IF ff = 0 THEN
          throwCompilerError "UNMATCHED PARENTHESIS IN INPUT #", ASIS, 0
          EXIT FUNCTION
        END IF

        parenEnd = returnedData2
        IF parenEnd <> targetEnd THEN
          throwCompilerError "UNEXPECTED TOKEN AFTER INPUT # TARGET", ASIS, 0
          EXIT FUNCTION
        END IF

        hasIndices = 1
      ELSE
        throwCompilerError "UNEXPECTED TOKEN AFTER INPUT # TARGET", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    targetName$ = UCASE$(lineTokens$(targetStart))

    expectedSymType = TYPE_ANY
    ff = resolveSymbol(targetName$)
    IF ff = 0 THEN EXIT FUNCTION

    vIdx = returnedData2
    targetType = returnedData3

    IF symbols(vIdx).SubIndex <> 0 THEN
      throwCompilerError "INPUT # TARGET MUST BE A VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    IF hasIndices = 1 THEN
      IF symbols(vIdx).IsArray = 0 THEN
        throwCompilerError "INPUT # TARGET ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
    ELSE
      IF symbols(vIdx).IsArray > 0 THEN
        throwCompilerError "INPUT # ARRAY TARGET REQUIRES INDEX", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    SELECT CASE targetType

      CASE TYPE_BYTE, TYPE_UBYTE, TYPE_INTEGER, TYPE_UINTEGER
      CASE TYPE_LONG, TYPE_ULONG, TYPE_INTEGER64, TYPE_UINT64
      CASE TYPE_SINGLE, TYPE_DOUBLE, TYPE_STRING

      CASE ELSE
        throwCompilerError "INPUT # TARGET TYPE NOT SUPPORTED", ASIS, 0
        EXIT FUNCTION

    END SELECT ' targetType

    targetCount = targetCount + 1

    IF nextComma = 0 THEN
      EXIT DO
    END IF

    targetStart = nextComma + 1

    IF targetStart > endIdx THEN
      throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF
  LOOP

  IF targetCount = 0 THEN
    throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(fileNumStart, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileHandlesIdx = returnedData2

  ff = resolveSymbol("IAT_READFILE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  readFileIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, fileHandlesIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  fileDoneLblIdx = tiraLabelCreateNewId&("FINPUT_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, fileDoneLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, fileDoneLblIdx

  ' One shared field buffer is reused after each completed assignment
  fieldBufIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 8192)

  targetStart = comma1 + 1

  DO WHILE targetStart <= endIdx
    nextComma = 0
    ff = findNextTokenAtDepth0(targetStart, endIdx, 256 + ASC(","))
    IF ff = 1 THEN nextComma = returnedData2

    targetEnd = endIdx
    IF nextComma > 0 THEN targetEnd = nextComma - 1

    targetName$ = UCASE$(lineTokens$(targetStart))

    expectedSymType = TYPE_ANY
    ff = resolveSymbol(targetName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    vIdx = returnedData2
    targetType = returnedData3

    numParsedIndices = 0
    hasIndices = 0

    IF targetStart < targetEnd THEN
      IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
        hasIndices = 1
        ff = tiraParseArrayId(targetStart + 1, targetEnd, ALIM)
        IF ff = 0 THEN EXIT FUNCTION
        parenEnd = returnedData2
        numParsedIndices = returnedData3
      END IF
    END IF

    IF hasIndices = 1 THEN
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    targetAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
    IF targetAddrIdx = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    ' Read one comma-delimited or line-delimited field
    fieldLenIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fieldLenIdx, TIRA_ARG_LITERAL, 0

    fieldStartedIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fieldStartedIdx, TIRA_ARG_LITERAL, 0

    fieldQuotedIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fieldQuotedIdx, TIRA_ARG_LITERAL, 0

    charPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    bytesReadIdx = tiraDimVarId&("T", TYPE_LONG)
    bytesReadPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_SYMBOL, bytesReadIdx

    charByteIdx = tiraDimVarId&("T", TYPE_UBYTE)

    fieldReadTopLblIdx = tiraLabelCreateNewId&("FINPUT_READ")
    fieldStartedLblIdx = tiraLabelCreateNewId&("FINPUT_STARTED")
    fieldUnquotedLblIdx = tiraLabelCreateNewId&("FINPUT_UNQUOTED")
    fieldAppendLblIdx = tiraLabelCreateNewId&("FINPUT_APPEND")
    fieldNoAppendLblIdx = tiraLabelCreateNewId&("FINPUT_NO_APPEND")
    fieldDoneLblIdx = tiraLabelCreateNewId&("FINPUT_FIELD_DONE")
    quoteTailTopLblIdx = tiraLabelCreateNewId&("FINPUT_QUOTE_TAIL")

    tiraLabelId fieldReadTopLblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_SYMBOL, fieldBufIdx, TIRA_ARG_SYMBOL, fieldLenIdx

    tiraAssignId bytesReadIdx, TIRA_ARG_LITERAL, 0
    tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, bytesReadIdx, TIRA_ARG_LITERAL, 0, fieldDoneLblIdx

    tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charPtrIdx

    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, fieldStartedIdx, TIRA_ARG_LITERAL, 0, fieldStartedLblIdx

    ' Ignore whitespace and line boundaries before the field begins
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 32, fieldReadTopLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 9, fieldReadTopLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 13, fieldReadTopLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 10, fieldReadTopLblIdx

    tiraAssignId fieldStartedIdx, TIRA_ARG_LITERAL, 1

    ' An opening quote is structural and is not included in the target string
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 34, fieldStartedLblIdx
    tiraAssignId fieldQuotedIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId fieldReadTopLblIdx

    tiraLabelId fieldStartedLblIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fieldQuotedIdx, TIRA_ARG_LITERAL, 0, fieldUnquotedLblIdx

    ' A closing quote ends a quoted field
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 34, quoteTailTopLblIdx
    tiraJmpId fieldAppendLblIdx

    tiraLabelId fieldUnquotedLblIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 44, fieldDoneLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 10, fieldDoneLblIdx

    ' Consume CR and allow the following LF to terminate the field
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 13, fieldReadTopLblIdx

    tiraLabelId fieldAppendLblIdx

    ' Reserve the final byte as a safe one-byte read location after truncation
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, fieldLenIdx, TIRA_ARG_LITERAL, 8191, fieldNoAppendLblIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fieldLenIdx, TIRA_ARG_SYMBOL, fieldLenIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId fieldNoAppendLblIdx
    tiraJmpId fieldReadTopLblIdx

    ' Consume the delimiter following a quoted field
    tiraLabelId quoteTailTopLblIdx

    tiraAssignId bytesReadIdx, TIRA_ARG_LITERAL, 0
    tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, bytesReadIdx, TIRA_ARG_LITERAL, 0, fieldDoneLblIdx

    tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 44, fieldDoneLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 10, fieldDoneLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 13, quoteTailTopLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 32, quoteTailTopLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 9, quoteTailTopLblIdx
    tiraJmpId fieldDoneLblIdx

    tiraLabelId fieldDoneLblIdx

    IF targetType = TYPE_STRING THEN
      fixedLen = retFixedStringLength(vIdx)

      IF fixedLen > 0 THEN
        lhsDataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

        IF symbols(vIdx).IsArray > 0 THEN
          tiraAssignId lhsDataPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx
        ELSE
          tiraReadMemId lhsDataPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx
        END IF

        copyLenIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraAssignId copyLenIdx, TIRA_ARG_SYMBOL, fieldLenIdx

        copyLenReadyLblIdx = tiraLabelCreateNewId&("FINPUT_COPY_READY")
        tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, copyLenIdx, TIRA_ARG_LITERAL, fixedLen, copyLenReadyLblIdx
        tiraAssignId copyLenIdx, TIRA_ARG_LITERAL, fixedLen
        tiraLabelId copyLenReadyLblIdx

        copyDoneLblIdx = tiraLabelCreateNewId&("FINPUT_COPY_DONE")
        tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, copyLenIdx, TIRA_ARG_LITERAL, 0, copyDoneLblIdx
        tiraMemcpyId TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, fieldBufIdx, TIRA_ARG_SYMBOL, copyLenIdx
        tiraLabelId copyDoneLblIdx

        padLenIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_SYMBOL, copyLenIdx

        padDoneLblIdx = tiraLabelCreateNewId&("FINPUT_PAD_DONE")
        tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, 0, padDoneLblIdx

        padAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, copyLenIdx
        tiraMemSetId TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, padLenIdx

        tiraLabelId padDoneLblIdx
      ELSE
        rhsDescPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
        tiraBuildStrDescId TIRA_ARG_SYMBOL, rhsDescPtrIdx, TIRA_ARG_SYMBOL, fieldBufIdx, TIRA_ARG_SYMBOL, fieldLenIdx, TIRA_ARG_LITERAL, 0

        lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

        IF symbols(vIdx).IsArray > 0 THEN
          tiraReadMemId lhsDescPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx
          tiraEnsureStringAllocId lhsDescPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx
        ELSE
          tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, targetAddrIdx
        END IF

        ff = resolveSymbol("RT_STR_ASSIGN")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        strAssignIdx = returnedData2
        tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, lhsDescPtrIdx, TIRA_ARG_SYMBOL, rhsDescPtrIdx
      END IF
    ELSE
      ' Convert the field using the same whole-number behavior as standard INPUT
      numericPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId numericPtrIdx, TIRA_ARG_SYMBOL, fieldBufIdx

      numericRemainIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId numericRemainIdx, TIRA_ARG_SYMBOL, fieldLenIdx

      numericValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId numericValueIdx, TIRA_ARG_LITERAL, 0

      numericNegIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId numericNegIdx, TIRA_ARG_LITERAL, 0

      numericSkipTopLblIdx = tiraLabelCreateNewId&("FINPUT_NUM_SKIP")
      numericSkipDoneLblIdx = tiraLabelCreateNewId&("FINPUT_NUM_READY")
      numericConsumeLblIdx = tiraLabelCreateNewId&("FINPUT_NUM_CONSUME")

      tiraLabelId numericSkipTopLblIdx
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 0, numericSkipDoneLblIdx

      tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, numericPtrIdx

      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 32, numericConsumeLblIdx
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 9, numericSkipDoneLblIdx

      tiraLabelId numericConsumeLblIdx
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 1
      tiraJmpId numericSkipTopLblIdx

      tiraLabelId numericSkipDoneLblIdx

      numericSignDoneLblIdx = tiraLabelCreateNewId&("FINPUT_SIGN_DONE")
      numericNegativeLblIdx = tiraLabelCreateNewId&("FINPUT_NEGATIVE")
      numericConsumeSignLblIdx = tiraLabelCreateNewId&("FINPUT_SIGN_CONSUME")

      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 0, numericSignDoneLblIdx

      tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, numericPtrIdx

      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 45, numericNegativeLblIdx
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 43, numericSignDoneLblIdx
      tiraJmpId numericConsumeSignLblIdx

      tiraLabelId numericNegativeLblIdx
      tiraAssignId numericNegIdx, TIRA_ARG_LITERAL, 1

      tiraLabelId numericConsumeSignLblIdx
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 1

      tiraLabelId numericSignDoneLblIdx

      numericLoopTopLblIdx = tiraLabelCreateNewId&("FINPUT_NUM_LOOP")
      numericLoopDoneLblIdx = tiraLabelCreateNewId&("FINPUT_NUM_DONE")

      tiraLabelId numericLoopTopLblIdx
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 0, numericLoopDoneLblIdx

      tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, numericPtrIdx

      tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 48, numericLoopDoneLblIdx
      tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 57, numericLoopDoneLblIdx

      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 48
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, numericValueIdx, TIRA_ARG_SYMBOL, numericValueIdx, TIRA_ARG_LITERAL, 10
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numericValueIdx, TIRA_ARG_SYMBOL, numericValueIdx, TIRA_ARG_SYMBOL, charByteIdx

      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_SYMBOL, numericPtrIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_SYMBOL, numericRemainIdx, TIRA_ARG_LITERAL, 1
      tiraJmpId numericLoopTopLblIdx

      tiraLabelId numericLoopDoneLblIdx

      numericApplySignLblIdx = tiraLabelCreateNewId&("FINPUT_APPLY_SIGN")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numericNegIdx, TIRA_ARG_LITERAL, 0, numericApplySignLblIdx
      tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, numericValueIdx, TIRA_ARG_SYMBOL, numericValueIdx
      tiraLabelId numericApplySignLblIdx

      storeModeType = TA_EMPTY
      storeModeVal = 0

      SELECT CASE targetType

        CASE TYPE_BYTE, TYPE_UBYTE
          storeModeType = TIRA_ARG_LITERAL
          storeModeVal = 1

        CASE TYPE_INTEGER, TYPE_UINTEGER
          storeModeType = TIRA_ARG_LITERAL
          storeModeVal = 2

        CASE TYPE_LONG, TYPE_ULONG
          storeModeType = TIRA_ARG_LITERAL
          storeModeVal = 4

        CASE TYPE_INTEGER64, TYPE_UINT64
          storeModeType = TIRA_ARG_LITERAL
          storeModeVal = 8

        CASE TYPE_SINGLE
          storeModeType = TIRA_ARG_STR_LITERAL
          storeModeVal = 32

        CASE TYPE_DOUBLE
          storeModeType = TIRA_ARG_STR_LITERAL
          storeModeVal = 64

      END SELECT ' targetType

      tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, numericValueIdx, storeModeType, storeModeVal
    END IF

    IF nextComma = 0 THEN
      EXIT DO
    END IF

    targetStart = nextComma + 1
  LOOP

  tiraLabelId fileDoneLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_INPUT_File = 1

END FUNCTION ' parse_INPUT_File

''''''''''''''''''''''''
FUNCTION parse_INPUT_STR$ (startIdx, endIdx, allowImplicit)

  DIM requestedCountType AS LONG
  DIM requestedCountVal AS _INTEGER64
  DIM readCountIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM writePtrIdx AS LONG
  DIM remainingIdx AS LONG
  DIM charValIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM invalidCountLblIdx AS LONG
  DIM validCountLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM waitKeyLblIdx AS LONG
  DIM headSymbolIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailSymbolIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM bufSymbolIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM getChFuncIdx AS LONG
  DIM sleepFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INPUT$", 3) = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INPUT$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF
  requestedCountType = tiraParsedArgType
  requestedCountVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("INPUTSTR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  readCountIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId readCountIdx, requestedCountType, requestedCountVal

  invalidCountLblIdx = tiraLabelCreateNewId&("INPUTSTR_INVALID")
  validCountLblIdx = tiraLabelCreateNewId&("INPUTSTR_VALID")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 1, invalidCountLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 32767, validCountLblIdx

  tiraLabelId invalidCountLblIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId validCountLblIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, readCountIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF

  writePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId writePtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  remainingIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId remainingIdx, TIRA_ARG_SYMBOL, readCountIdx

  loopTopIdx = tiraLabelCreateNewId&("INPUTSTR_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("INPUTSTR_DONE")

  ' Present pending graphical output before waiting for a key
  tiraInjectPendingDisplayFlushId

  IF cm.HasGraphics = 0 THEN
    charValIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("IAT_GETCH")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    getChFuncIdx = returnedData2
  ELSE
    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)

    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    headSymbolIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, headSymbolIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    tailSymbolIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailSymbolIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    bufSymbolIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufSymbolIdx

    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    waitKeyLblIdx = tiraLabelCreateNewId&("INPUTSTR_WAIT")

    ff = resolveSymbol("IAT_SLEEP")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    sleepFuncIdx = returnedData2
  END IF

  tiraLabelId loopTopIdx

  IF cm.HasGraphics = 0 THEN
    tiraCallId0 getChFuncIdx
    tiraGetRetId charValIdx
  ELSE
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, waitKeyLblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4
  END IF

  tiraWriteMemId TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_LITERAL, 0, loopTopIdx
  tiraJmpId loopDoneIdx

  IF cm.HasGraphics <> 0 THEN
    tiraLabelId waitKeyLblIdx
    tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId loopTopIdx
  END IF

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_INPUT_STR$ = scratchName$

END FUNCTION ' parse_INPUT_STR$

''''''''''''''''''''''''
FUNCTION parse_INSTR$ (startIdx, endIdx, allowImplicit)

  ' Returns the position of the first occurrence of a substring within a string

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM argStartType AS LONG
  DIM argStartVal AS _INTEGER64
  DIM argStr1Type AS LONG
  DIM argStr1Val AS _INTEGER64
  DIM argStr2Type AS LONG
  DIM argStr2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM str1LenIdx AS LONG
  DIM str1DataIdx AS LONG
  DIM str2LenIdx AS LONG
  DIM str2DataIdx AS LONG
  DIM safeStartIdx AS LONG
  DIM searchIdx AS LONG
  DIM maxIdx AS LONG
  DIM subIdx AS LONG
  DIM addr1Idx AS LONG
  DIM char1Idx AS LONG
  DIM addr2Idx AS LONG
  DIM char2Idx AS LONG
  DIM lblEmptyStr2Idx AS LONG
  DIM lblStartCheckIdx AS LONG
  DIM lblLoopTopIdx AS LONG
  DIM lblLoopDoneIdx AS LONG
  DIM lblMatchFoundIdx AS LONG
  DIM lblSubTopIdx AS LONG
  DIM lblSubDoneIdx AS LONG
  DIM lblSubFailIdx AS LONG
  DIM lblEndIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INSTR", 4) = 0 THEN
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "INSTR REQUIRES 2 OR 3 ARGUMENTS", ASIS, 0
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "INSTR START MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    argStartType = tiraParsedArgType
    argStartVal = tiraParsedArgVal

    ff = tiraParseExpressionId(comma1 + 1, comma2 - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 2 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    argStr1Type = tiraParsedArgType
    argStr1Val = tiraParsedArgVal

    ff = tiraParseExpressionId(comma2 + 1, endIdx - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 3 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    argStr2Type = tiraParsedArgType
    argStr2Val = tiraParsedArgVal
  ELSE
    argStartType = TIRA_ARG_LITERAL
    argStartVal = 1

    ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 1 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    argStr1Type = tiraParsedArgType
    argStr1Val = tiraParsedArgVal

    ff = tiraParseExpressionId(comma1 + 1, endIdx - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INSTR ARG 2 MUST BE STRING", ASIS, 0
      parse_INSTR$ = ""
      EXIT FUNCTION
    END IF
    argStr2Type = tiraParsedArgType
    argStr2Val = tiraParsedArgVal
  END IF

  scratchIdx = tiraResolveHoistVarId&("INSTR", "_VAL")
  IF scratchIdx = 0 THEN
    parse_INSTR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  str1LenIdx = tiraGetStringLenId&(argStr1Type, argStr1Val)
  str1DataIdx = tiraGetStringDataId&(argStr1Type, argStr1Val)

  str2LenIdx = tiraGetStringLenId&(argStr2Type, argStr2Val)
  str2DataIdx = tiraGetStringDataId&(argStr2Type, argStr2Val)

  safeStartIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId safeStartIdx, argStartType, argStartVal
  tiraClampId safeStartIdx, TIRA_ARG_LITERAL, 1, TA_EMPTY, 0

  searchIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, searchIdx, TIRA_ARG_SYMBOL, safeStartIdx, TIRA_ARG_LITERAL, 1

  maxIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, maxIdx, TIRA_ARG_SYMBOL, str1LenIdx, TIRA_ARG_SYMBOL, str2LenIdx

  lblEndIdx = tiraLabelCreateNewId&("INSTR_END")

  lblEmptyStr2Idx = tiraLabelCreateNewId&("INSTR_MT2")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, str2LenIdx, TIRA_ARG_LITERAL, 0, lblEmptyStr2Idx

  lblStartCheckIdx = tiraLabelCreateNewId&("INSTR_CHKSTART")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, safeStartIdx, TIRA_ARG_SYMBOL, str1LenIdx, lblStartCheckIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId lblEndIdx
  tiraLabelId lblStartCheckIdx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, safeStartIdx
  tiraJmpId lblEndIdx

  tiraLabelId lblEmptyStr2Idx

  lblLoopTopIdx = tiraLabelCreateNewId&("INSTR_TOP")
  lblLoopDoneIdx = tiraLabelCreateNewId&("INSTR_DONE")
  lblMatchFoundIdx = tiraLabelCreateNewId&("INSTR_MATCH")

  tiraLabelId lblLoopTopIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, searchIdx, TIRA_ARG_SYMBOL, maxIdx, lblLoopDoneIdx

  subIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId subIdx, TIRA_ARG_LITERAL, 0

  lblSubTopIdx = tiraLabelCreateNewId&("INSTR_SUBTOP")
  lblSubDoneIdx = tiraLabelCreateNewId&("INSTR_SUBDONE")
  lblSubFailIdx = tiraLabelCreateNewId&("INSTR_SUBFAIL")

  tiraLabelId lblSubTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, subIdx, TIRA_ARG_SYMBOL, str2LenIdx, lblSubDoneIdx

  addr1Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  char1Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addr1Idx, TIRA_ARG_SYMBOL, str1DataIdx, TIRA_ARG_SYMBOL, searchIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addr1Idx, TIRA_ARG_SYMBOL, addr1Idx, TIRA_ARG_SYMBOL, subIdx
  tiraReadMemId char1Idx, TIRA_ARG_SYMBOL, addr1Idx

  addr2Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  char2Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, addr2Idx, TIRA_ARG_SYMBOL, str2DataIdx, TIRA_ARG_SYMBOL, subIdx
  tiraReadMemId char2Idx, TIRA_ARG_SYMBOL, addr2Idx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, char1Idx, TIRA_ARG_SYMBOL, char2Idx, lblSubFailIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, subIdx, TIRA_ARG_SYMBOL, subIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblSubTopIdx

  tiraLabelId lblSubDoneIdx
  tiraJmpId lblMatchFoundIdx

  tiraLabelId lblSubFailIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, searchIdx, TIRA_ARG_SYMBOL, searchIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopTopIdx

  tiraLabelId lblMatchFoundIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, searchIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId lblLoopDoneIdx
  tiraLabelId lblEndIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INSTR$ = scratchName$

END FUNCTION ' parse_INSTR$

''''''''''''''''''''''''
FUNCTION parse_INT$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM floatArgIdx AS LONG
  DIM floatTruncIdx AS LONG
  DIM skipDecLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INT", 3) = 0 THEN
    parse_INT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_INT$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("INT", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_INT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraAssignId resVarIdx, arg1Type, arg1Val ' Truncates float to int naturally

  floatArgIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatArgIdx, arg1Type, arg1Val

  floatTruncIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatTruncIdx, TIRA_ARG_SYMBOL, resVarIdx

  skipDecLblIdx = tiraLabelCreateNewId&("SKIP_DEC")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, floatArgIdx, TIRA_ARG_SYMBOL, floatTruncIdx, skipDecLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipDecLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INT$ = scratchName$

END FUNCTION ' parse_INT$

''''''''''''''''''''''''
FUNCTION parse_KEY (startIdx)

  ' Enables, disables, or suspends a numbered ON KEY event trap

  DIM endIdx AS LONG
  DIM closeParen AS LONG
  DIM modeVal AS _UNSIGNED LONG
  DIM eventNumberType AS LONG
  DIM eventNumberVal AS _INTEGER64
  DIM invalidKeyLblIdx AS LONG
  DIM validKeyLblIdx AS LONG
  DIM eventIndexIdx AS LONG
  DIM stateArrayIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM stateValueIdx AS LONG
  DIM keyAnyIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 4 THEN
    throwCompilerError "MALFORMED KEY STATEMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_OP_LPAREN THEN
    throwCompilerError "KEY REQUIRES (n)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(startIdx + 1, endIdx)
  IF ff = 0 THEN
    throwCompilerError "KEY MISSING )", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParen = returnedData2

  IF closeParen <= startIdx + 2 THEN
    throwCompilerError "KEY REQUIRES EVENT NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  IF closeParen >= endIdx THEN
    throwCompilerError "KEY EXPECTS ON, OFF, OR STOP", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, closeParen + 1, "KEY")
  IF ff = 0 THEN EXIT FUNCTION

  modeName$ = UCASE$(retTokenText$(lineTokens$(closeParen + 1)))
  modeVal = KEY_EVENT_MODE_OFF

  SELECT CASE modeName$

    CASE "ON"
      modeVal = KEY_EVENT_MODE_ON

    CASE "OFF"
      modeVal = KEY_EVENT_MODE_OFF

    CASE "STOP"
      modeVal = KEY_EVENT_MODE_STOP

    CASE ELSE
      throwCompilerError "KEY EXPECTS ON, OFF, OR STOP", ASIS, 0
      EXIT FUNCTION

  END SELECT ' modeName$

  ensureKeyEventSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  rtIsUsed(RT_KEY_EVENT) = 1

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, closeParen - 1, ALIM, "KEY EVENT NUMBER MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  eventNumberType = tiraParsedArgType
  eventNumberVal = tiraParsedArgVal

  invalidKeyLblIdx = tiraLabelCreateNewId&("KEY_NUMBER_INVALID")
  validKeyLblIdx = tiraLabelCreateNewId&("KEY_NUMBER_VALID")

  tiraJmpCondId JCC_JL, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, 1, invalidKeyLblIdx
  tiraJmpCondId JCC_JLE, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, KEY_EVENT_COUNT, validKeyLblIdx

  tiraLabelId invalidKeyLblIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId validKeyLblIdx

  eventIndexIdx = tiraDimVarId&("T", TYPE_UINT64)
  tiraAssignId eventIndexIdx, eventNumberType, eventNumberVal
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("!G_INO_ARR_KEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  stateArrayIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, stateArrayIdx

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

  IF modeVal = KEY_EVENT_MODE_OFF THEN
    tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES
  ELSE
    stateValueIdx = tiraDimVarId&("T", TYPE_UINT64)
    tiraReadMemId stateValueIdx, TIRA_ARG_SYMBOL, stateSlotIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_STATE_MASK
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, modeVal
    tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

    ff = resolveSymbol("!G_INO_FLG_KEYANY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    keyAnyIdx = returnedData2

    tiraAssignId keyAnyIdx, TIRA_ARG_LITERAL, 1
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_KEY = 1

END FUNCTION ' parse_KEY

''''''''''''''''''''''''
FUNCTION parse_KILL (startIdx)

  DIM endIdx AS LONG
  DIM fileNameType AS LONG
  DIM fileNameVal AS _INTEGER64
  DIM strDataPtrIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED FILENAME AFTER KILL", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNameType = tiraParsedArgType
  fileNameVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  strDataPtrIdx = tiraGetStringDataId&(fileNameType, fileNameVal)

  ff = resolveSymbol("IAT_DELETEFILEA")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, TIRA_ARG_SYMBOL, strDataPtrIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_KILL = 1

END FUNCTION ' parse_KILL

''''''''''''''''''''''''
FUNCTION parse_LBOUND$ (startIdx, endIdx, allowImplicit)

  ' Returns the lowest available index for a given array dimension

  DIM arrNameTok$
  DIM comma1 AS LONG
  DIM vIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dimVar$
  DIM dimVarType AS LONG
  DIM dimVarVal AS _INTEGER64
  DIM dimLBoundIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LBOUND", 3) = 0 THEN
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  arrNameTok$ = UCASE$(retTokenText$(lineTokens$(startIdx + 2)))
  ff = findSymbol(arrNameTok$)
  IF ff = 0 THEN
    throwCompilerError "UNDECLARED ARRAY IN LBOUND", ASIS, 0
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerError "LBOUND REQUIRES AN ARRAY", ASIS, 0
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "DIMENSION MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_LBOUND$ = ""
      EXIT FUNCTION
    END IF
    dimVarType = tiraParsedArgType
    dimVarVal = tiraParsedArgVal
  ELSE
    dimVarType = TIRA_ARG_LITERAL
    dimVarVal = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("LBOUND", "_VAL")
  IF scratchIdx = 0 THEN
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  lblEndIdx = tiraLabelCreateNewId&("LB_END")
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraJmpCondId JCC_JG, dimVarType, dimVarVal, TIRA_ARG_SYMBOL, numDimsIdx, lblEndIdx
  tiraJmpCondId JCC_JL, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1, lblEndIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, offsetVarIdx, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 0

  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, dimLBoundIdx

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LBOUND$ = scratchName$

END FUNCTION ' parse_LBOUND$

''''''''''''''''''''''''
FUNCTION parse_LCASE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM destItrIdx AS LONG
  DIM srcItrIdx AS LONG
  DIM itrLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipUpperLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LCASE$", 3) = 0 THEN
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LCASE$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("LCASE", "_DSC")
  IF scratchIdx = 0 THEN
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  destItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destItrIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  srcItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId srcItrIdx, TIRA_ARG_SYMBOL, srcPtrIdx
  itrLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId itrLenIdx, TIRA_ARG_SYMBOL, strLenIdx

  loopTopIdx = tiraLabelCreateNewId&("LCASE_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("LCASE_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, srcItrIdx

  skipUpperLblIdx = tiraLabelCreateNewId&("LCASE_SKIP")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 65, skipUpperLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 90, skipUpperLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32
  tiraLabelId skipUpperLblIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LCASE$ = scratchName$

END FUNCTION ' parse_LCASE$

''''''''''''''''''''''''
FUNCTION parse_LEN$ (startIdx, endIdx, allowImplicit)

  DIM isVariableLen AS LONG
  DIM isRuntimeArray AS LONG
  DIM reqSize AS LONG
  DIM innerStart AS LONG
  DIM innerEnd AS LONG
  DIM firstChar AS STRING * 1
  DIM vIdx AS LONG
  DIM isMatch AS LONG
  DIM isArrayWhole AS LONG
  DIM hasArraySyntax AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM isValidSize AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM arg1$
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM firstTok$
  DIM vName$
  DIM lenVarIdx AS LONG
  DIM fixedLen AS LONG
  DIM isFound AS LONG
  DIM descriptorAddrIdx AS LONG
  DIM descriptorDimsIdx AS LONG
  DIM descriptorElemSizeIdx AS LONG
  DIM dimensionIndexIdx AS LONG
  DIM dimensionOffsetIdx AS LONG
  DIM dimensionAddrIdx AS LONG
  DIM dimensionElemsIdx AS LONG
  DIM dimensionLoopIdx AS LONG
  DIM dimensionDoneIdx AS LONG
  DIM runtimeDoneIdx AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LEN", 3) = 0 THEN
    parse_LEN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  innerStart = startIdx + 2
  innerEnd = endIdx - 1
  isVariableLen = 0
  isRuntimeArray = 0
  reqSize = 0

  firstTok$ = lineTokens$(innerStart)
  IF lineTokenVals(innerStart) = 0 THEN
    firstChar = LEFT$(firstTok$, 1)
    IF (firstChar >= "A" AND firstChar <= "Z") OR (firstChar >= "a" AND firstChar <= "z") OR firstChar = "_" THEN
      vName$ = UCASE$(firstTok$)
      isMatch = 0
      isArrayWhole = 0

      IF innerStart = innerEnd THEN
        isMatch = 1
      ELSE
        IF innerStart + 2 = innerEnd THEN
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") AND lineTokenVals(innerEnd) = 256 + ASC(")") THEN
            isMatch = 1
            isArrayWhole = 1
          END IF
        ELSE
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") THEN
            IF findMatchingParen(innerStart + 1, innerEnd) = 1 THEN
              IF returnedData2 = innerEnd THEN
                isMatch = 1
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isMatch = 1 THEN
        hasArraySyntax = 0
        IF innerStart < innerEnd THEN
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") THEN hasArraySyntax = 1
        END IF

        isFound = 0
        symbolCountBefore = symbolCount
        IF findSymbol(vName$) THEN
          isFound = 1
          vIdx = returnedData2
        ELSE
          IF allowImplicit = 1 THEN
            ff = resolveSymbol(vName$)
            IF ff = 1 THEN
              isFound = 1
              vIdx = returnedData2
            END IF
          END IF
        END IF

        IF isFound = 1 THEN
          wasNewSymbol = 0
          IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

          IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
            IF symbols(vIdx).SubIndex = 0 THEN
              IF hasArraySyntax = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
                IF wasNewSymbol = 1 THEN
                  throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
                ELSE
                  throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
                END IF
                parse_LEN$ = ""
                EXIT FUNCTION
              END IF

              IF hasArraySyntax = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
                parse_LEN$ = ""
                EXIT FUNCTION
              END IF
            END IF
          END IF

          dt = symbols(vIdx).DataType
          elemSize = retElementByteSize(vIdx)
          isValidSize = 1

          IF dt = TYPE_STRING THEN
            fixedLen = retFixedStringLength(vIdx)
            IF fixedLen = 0 THEN
              isValidSize = 0
              elemSize = 0
            END IF
          END IF

          IF isArrayWhole = 1 THEN
            IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
              throwCompilerErrorAndCancelTira "EXPECTED ARRAY", ASIS, 0
              parse_LEN$ = ""
              EXIT FUNCTION
            END IF
            IF isValidSize = 0 THEN
              throwCompilerErrorAndCancelTira "CANNOT USE LEN ON DYNAMIC STRING ARRAY", ASIS, 0
              parse_LEN$ = ""
              EXIT FUNCTION
            END IF

            SELECT CASE symbols(vIdx).IsArray

              CASE ARRAY_TYPE_STATIC
                reqSize = elemSize * symbols(vIdx).Size
                isVariableLen = 1

              CASE ARRAY_TYPE_RUNTIME
                isRuntimeArray = 1

              CASE ELSE
                throwCompilerErrorAndCancelTira "INVALID ARRAY KIND", ASIS, 0
                parse_LEN$ = ""
                EXIT FUNCTION

            END SELECT
          ELSE
            IF dt <> TYPE_STRING THEN
              reqSize = elemSize
              isVariableLen = 1
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("LEN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_LEN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  IF isRuntimeArray = 1 THEN
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

    descriptorAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, vIdx

    descriptorDimsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId descriptorDimsIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 12

    runtimeDoneIdx = tiraLabelCreateNewId&("LEN_ARRAY_DONE")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimsIdx, TIRA_ARG_LITERAL, 0, runtimeDoneIdx

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 1

    dimensionIndexIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId dimensionIndexIdx, TIRA_ARG_LITERAL, 0

    dimensionLoopIdx = tiraLabelCreateNewId&("LEN_DIM_LOOP")
    dimensionDoneIdx = tiraLabelCreateNewId&("LEN_DIM_DONE")

    tiraLabelId dimensionLoopIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, descriptorDimsIdx, dimensionDoneIdx

    dimensionOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 8
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_LITERAL, 16

    dimensionAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionAddrIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx

    dimensionElemsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId dimensionElemsIdx, TIRA_ARG_SYMBOL, dimensionAddrIdx, 4

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, dimensionElemsIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId dimensionLoopIdx

    tiraLabelId dimensionDoneIdx

    descriptorElemSizeIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId descriptorElemSizeIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 8

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, descriptorElemSizeIdx

    tiraLabelId runtimeDoneIdx
  ELSE
    IF isVariableLen = 1 THEN
      tiraAssignId resVarIdx, TIRA_ARG_LITERAL, reqSize
    ELSE
      ff = tiraParseExpressionId(innerStart, innerEnd, allowImplicit)
      IF ff = 0 THEN
        tira_Cancel
        parse_LEN$ = ""
        EXIT FUNCTION
      END IF
      arg1Type = tiraParsedArgType
      arg1Val = tiraParsedArgVal
      IF exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "LEN REQUIRES STRING ARGUMENT", ASIS, 0
        parse_LEN$ = ""
        EXIT FUNCTION
      END IF

      lenVarIdx = tiraGetStringLenId&(arg1Type, arg1Val)
      tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, lenVarIdx
    END IF
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LEN$ = scratchName$

END FUNCTION ' parse_LEN$

''''''''''''''''''''''''
FUNCTION parse_LEFT$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM safeLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM comma1 AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LEFT$", 5) = 0 THEN
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "LEFT$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LEFT$ ARG 1 MUST BE STRING", ASIS, 0
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "LEFT$ ARG 2 MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF
  arg2Type = tiraParsedArgType
  arg2Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("LEFT", "_DSC")
  IF scratchIdx = 0 THEN
    parse_LEFT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  safeLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId safeLenIdx, arg2Type, arg2Val
  tiraClampId safeLenIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, strLenIdx

  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, safeLenIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LEFT$ = scratchName$

END FUNCTION ' parse_LEFT$

''''''''''''''''''''''''
FUNCTION parse_LIMIT (startIdx)

  DIM endIdx AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM argDataType AS LONG
  DIM argFloatIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "_LIMIT REQUIRES NUMERIC ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 1, endIdx, ALIM, "_LIMIT REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  argType = tiraParsedArgType
  argVal = tiraParsedArgVal
  argDataType = exprIs.DataType

  argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  IF argDataType <> TYPE_DOUBLE THEN
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, argFloatIdx, argType, argVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
  ELSE
    tiraAssignId argFloatIdx, argType, argVal
  END IF

  ff = resolveSymbol("RT_LIMIT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, TIRA_ARG_SYMBOL, argFloatIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LIMIT = 1

END FUNCTION ' parse_LIMIT

''''''''''''''''''''''''
FUNCTION parse_LINE_INPUT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasSuppress AS LONG
  DIM hasPrompt AS LONG
  DIM promptStr$
  DIM tVal AS LONG
  DIM vTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM pStr$
  DIM litIdx AS LONG
  DIM litPtrIdx AS LONG
  DIM tgtAddrIdx AS LONG

  DIM isFile AS LONG
  DIM comma1 AS LONG
  DIM vTokIdx AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM handlesArrIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipIOLblIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM bufLenIdx AS LONG
  DIM loopTopLblIdx AS LONG
  DIM charPtrIdx AS LONG
  DIM bytesReadIdx AS LONG
  DIM bytesReadPtrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM skipCRLblIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM readFileFuncIdx AS LONG
  DIM strAssignFuncIdx AS LONG
  DIM inputFuncIdx AS LONG

  endIdx = lineTokenCount - 1
  tokIdx = startIdx + 2 ' Skip TOK_LINE and TOK_INPUT

  isFile = 0
  IF tokIdx <= endIdx THEN
    IF lineTokens$(tokIdx) = "#" THEN
      isFile = 1
      tokIdx = tokIdx + 1
    ELSE
      IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
        isFile = 1
        lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
      END IF
    END IF
  END IF

  IF isFile = 1 THEN
    comma1 = findComma(tokIdx, endIdx)
    IF comma1 = 0 THEN
      throwCompilerError "LINE INPUT # MISSING COMMA", ASIS, 0
      EXIT FUNCTION
    END IF

    vTokIdx = comma1 + 1
    IF vTokIdx > endIdx THEN
      throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vTok$ = lineTokens$(vTokIdx)
    IF lineTokenVals(vTokIdx) <> 0 THEN
      throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = verifyNoExtraTokens(endIdx, vTokIdx, "LINE INPUT #")
    IF ff = 0 THEN EXIT FUNCTION

    vName$ = UCASE$(vTok$)

    ' Assert the expected typing to correctly inherit string nature if implicitly declared
    expectedSymType = TYPE_STRING

    ff = resolveSymbol(vName$)
    IF ff = 0 THEN EXIT FUNCTION
    vIdx = returnedData2

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    IF symbols(vIdx).DataType <> TYPE_STRING THEN
      throwCompilerError "LINE INPUT # REQUIRES STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    tira_Start

    ff = tiraParseExpressionIntId(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fileNumType = tiraParsedArgType
    fileNumVal = tiraParsedArgVal

    ff = resolveSymbol("!G_FLS_ARR_HANDLES")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    handlesArrIdx = returnedData2

    baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrIdx

    slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

    handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

    skipIOLblIdx = tiraLabelCreateNewId&("LINPUT_SKIP_IO")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipIOLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipIOLblIdx

    bufPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 8192)
    bufLenIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId bufLenIdx, TIRA_ARG_LITERAL, 0

    loopTopLblIdx = tiraLabelCreateNewId&("LINPUT_LOOP")
    tiraLabelId loopTopLblIdx

    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 8192, skipIOLblIdx

    charPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx

    bytesReadIdx = tiraDimVarId&("T", TYPE_LONG)
    bytesReadPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_SYMBOL, bytesReadIdx

    ff = resolveSymbol("IAT_READFILE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    readFileFuncIdx = returnedData2

    tiraCallId5 readFileFuncIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, bytesReadIdx, TIRA_ARG_LITERAL, 0, skipIOLblIdx

    charByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charPtrIdx

    skipCRLblIdx = tiraLabelCreateNewId&("LINPUT_SKIP_CR")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 13, skipCRLblIdx
    tiraJmpId loopTopLblIdx
    tiraLabelId skipCRLblIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charByteIdx, TIRA_ARG_LITERAL, 10, skipIOLblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId loopTopLblIdx

    tiraLabelId skipIOLblIdx

    ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    tempHeapIdx = returnedData2

    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 24
    tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, descPtrIdx

    tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0

    tgtAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_SYMBOL, vIdx

    ff = resolveSymbol("RT_STR_ASSIGN")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    strAssignFuncIdx = returnedData2

    tiraCallId2 strAssignFuncIdx, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_SYMBOL, descPtrIdx

    tiraScheduleHeapResetId
    tira_EndAndProcess

    parse_LINE_INPUT = 1
    EXIT FUNCTION
  END IF

  hasSuppress = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC(";") THEN
      hasSuppress = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  hasPrompt = 0
  promptStr$ = ""
  IF tokIdx <= endIdx THEN
    IF LEFT$(lineTokens$(tokIdx), 1) = CHR$(34) THEN
      hasPrompt = 1
      promptStr$ = extractQuotes$(lineTokens$(tokIdx))
      tokIdx = tokIdx + 1

      IF tokIdx <= endIdx THEN
        tVal = lineTokenVals(tokIdx)
        IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
          tokIdx = tokIdx + 1
        ELSE
          throwCompilerError "EXPECTED ; OR ,", ASIS, 0
          EXIT FUNCTION
        END IF
      ELSE
        throwCompilerError "EXPECTED ; OR ,", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 THEN
    throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, tokIdx, "LINE INPUT")
  IF ff = 0 THEN EXIT FUNCTION

  vName$ = UCASE$(vTok$)

  ' Assert the expected typing to correctly inherit string nature if implicitly declared
  expectedSymType = TYPE_STRING

  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF symbols(vIdx).DataType <> TYPE_STRING THEN
    throwCompilerError "LINE INPUT REQUIRES STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasPrompt = 1 THEN
    pStr$ = promptStr$
  ELSE
    pStr$ = ""
  END IF

  ff = resolveSymbol("!C_EVL_DSC_LTRL_" + _TRIM$(STR$(t.TiraVarCounter)))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_LINE_INPUT = 0
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN EXIT FUNCTION
  litIdx = returnedData2
  strVarData$(litIdx) = pStr$

  tira_Start

  litPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId litPtrIdx, TIRA_ARG_SYMBOL, litIdx

  tgtAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_SYMBOL, vIdx

  ff = resolveSymbol("RT_INPUT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  inputFuncIdx = returnedData2

  tiraCallId5 inputFuncIdx, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, litPtrIdx, TIRA_ARG_LITERAL, TYPE_STRING, TIRA_ARG_LITERAL, hasSuppress

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LINE_INPUT = 1

END FUNCTION ' parse_LINE_INPUT

''''''''''''''''''''''''
FUNCTION parse_LOCATE (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM maxX AS LONG
  DIM maxY AS LONG
  DIM textRowHeight AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM yType AS LONG
  DIM yVal AS _INTEGER64
  DIM xType AS LONG
  DIM xVal AS _INTEGER64
  DIM hasY AS LONG
  DIM hasX AS LONG
  DIM textYIdx AS LONG
  DIM textXIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM getConsoleInfoIdx AS LONG
  DIM setConsoleCursorIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM csbiIdx AS LONG
  DIM coordVarIdx AS LONG
  DIM maxYType AS LONG
  DIM maxYVal AS _INTEGER64
  DIM maxYVarIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM lblErrorIdx AS LONG
  DIM yZeroIdx AS LONG
  DIM xZeroIdx AS LONG
  DIM hndVar2Idx AS LONG
  DIM packedYIdx AS LONG
  DIM cleanXIdx AS LONG
  DIM coordIdx AS LONG

  endIdx = lineTokenCount - 1

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  commaIdx = findComma(startIdx + 1, endIdx)

  tira_Start

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fontHeightGlobalIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textYIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textXIdx = returnedData2

    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("LOCATE_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx
  ELSE
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setConsoleCursorIdx = returnedData2
  END IF

  hasY = 0
  hasX = 0

  IF commaIdx = 0 THEN
    IF startIdx + 1 <= endIdx THEN
      ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      yType = tiraParsedArgType
      yVal = tiraParsedArgVal
      hasY = 1
    END IF
  ELSE
    IF commaIdx > startIdx + 1 THEN
      ff = tiraParseExpressionIntId(startIdx + 1, commaIdx - 1, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      yType = tiraParsedArgType
      yVal = tiraParsedArgVal
      hasY = 1
    END IF
    IF commaIdx < endIdx THEN
      ff = tiraParseExpressionIntId(commaIdx + 1, endIdx, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      xType = tiraParsedArgType
      xVal = tiraParsedArgVal
      hasX = 1
    END IF
  END IF

  ' Support omitted arguments (e.g., LOCATE , 10) by fetching the current coordinate
  IF hasY = 0 OR hasX = 0 THEN
    IF cm.HasGraphics = 1 THEN
      IF hasY = 0 THEN
        yVal = tiraDimVarId&("T", TYPE_LONG)
        yType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_LITERAL, 1
      END IF
      IF hasX = 0 THEN
        xVal = tiraDimVarId&("T", TYPE_LONG)
        xType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_LITERAL, 8
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_LITERAL, 1
      END IF
    ELSE
      ff = resolveSymbol("IAT_GETCONSOLESCREENBUFFERINFO")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      getConsoleInfoIdx = returnedData2

      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx

      csbiIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
      IF compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraCallId2 getConsoleInfoIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, csbiIdx
      coordVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraReadMemOffsetId coordVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 4

      IF hasY = 0 THEN
        yVal = tiraDimVarId&("T", TYPE_LONG)
        yType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 16
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_LITERAL, 1
      END IF
      IF hasX = 0 THEN
        xVal = tiraDimVarId&("T", TYPE_LONG)
        xType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 65535
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_LITERAL, 1
      END IF
    END IF
  END IF

  maxX = 120
  maxY = 25
  maxYType = TIRA_ARG_LITERAL
  maxYVal = maxY

  IF cm.HasGraphics = 1 THEN
    maxX = gfxConfig.SizeX \ 8

    maxYVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId maxYVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, maxYVarIdx, TIRA_ARG_SYMBOL, maxYVarIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    maxYType = TIRA_ARG_SYMBOL
    maxYVal = maxYVarIdx
  END IF

  lblValidIdx = tiraLabelCreateNewId&("LOCATE_VALID")
  lblErrorIdx = tiraLabelCreateNewId&("LOCATE_ERR")

  tiraJmpCondId JCC_JL, yType, yVal, TIRA_ARG_LITERAL, 1, lblErrorIdx
  tiraJmpCondId JCC_JG, yType, yVal, maxYType, maxYVal, lblErrorIdx
  tiraJmpCondId JCC_JL, xType, xVal, TIRA_ARG_LITERAL, 1, lblErrorIdx
  tiraJmpCondId JCC_JG, xType, xVal, TIRA_ARG_LITERAL, maxX, lblErrorIdx

  tiraJmpId lblValidIdx

  tiraLabelId lblErrorIdx
  tiraFatalErrorId "LOCATE ATTEMPTED OFF SCREEN"

  tiraLabelId lblValidIdx

  yZeroIdx = tiraDimVarId&("T", TYPE_LONG)
  xZeroIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, yZeroIdx, yType, yVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, xZeroIdx, xType, xVal, TIRA_ARG_LITERAL, 1

  IF cm.HasGraphics = 1 THEN
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, yZeroIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, xZeroIdx, TIRA_ARG_LITERAL, 3
  ELSE
    hndVar2Idx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
    tiraGetRetId hndVar2Idx

    packedYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, yZeroIdx, TIRA_ARG_LITERAL, 16

    cleanXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cleanXIdx, TIRA_ARG_SYMBOL, xZeroIdx, TIRA_ARG_LITERAL, 65535

    coordIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, coordIdx, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, cleanXIdx

    tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVar2Idx, TIRA_ARG_SYMBOL, coordIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LOCATE = 1

END FUNCTION ' parse_LOCATE

''''''''''''''''''''''''
FUNCTION parse_LOF$ (startIdx, endIdx, allowImplicit)

  ' Returns the total length of an open file in bytes

  DIM fileNumStart AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM handlesArrayIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM getFileSizeIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LOF", 3) = 0 THEN
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF

  ensureFileWriteBufferSymbols

  tira_Start

  fileNumStart = startIdx + 2

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    END IF
  END IF

  ff = tiraParseExpressionIntId(fileNumStart, endIdx - 1, allowImplicit, "FILENUM MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("LOF", "_VAL")
  IF scratchIdx = 0 THEN
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF
  handlesArrayIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  ' Flush buffered PUT data so LOF observes the current file size
  tiraFlushFileWriteBufferId

  ff = resolveSymbol("IAT_GETFILESIZE")
  IF ff = 0 THEN
    tira_Cancel
    parse_LOF$ = ""
    EXIT FUNCTION
  END IF
  getFileSizeIdx = returnedData2

  tiraCallId2 getFileSizeIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LOF$ = scratchName$

END FUNCTION ' parse_LOF$

''''''''''''''''''''''''
FUNCTION parse_LOOP (startIdx)

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM hasCond AS LONG
  DIM tVal AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "LOOP WITHOUT DO", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_DO THEN
    throwCompilerError "LOOP MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrlCount = ctrlCount - 1
  loopID = ctrls(ctrlCount).Patch1

  topLbl$ = "@DO_TOP_" + _TRIM$(STR$(loopID))
  doneLbl$ = "@DO_DONE_" + _TRIM$(STR$(loopID))

  hasCond = 0

  IF endIdx > startIdx THEN
    tVal = lineTokenVals(startIdx + 1)
    IF tVal = TOK_UNTIL OR tVal = TOK_WHILE THEN
      hasCond = 1
    ELSE
      throwCompilerError "EXPECTED UNTIL OR WHILE", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  resetLbl$ = "@DO_RESET_" + _TRIM$(STR$(loopID))

  tira_Start

  IF hasCond = 1 THEN
    ff = tiraParseExpressionNumericId(startIdx + 2, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    exprVarType = tiraParsedArgType
    exprVarVal = tiraParsedArgVal

    ff = resolveSymbol(doneLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    doneLblIdx = returnedData2

    IF tVal = TOK_UNTIL THEN
      tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    ELSE
      tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    END IF

    tiraScheduleHeapResetId

    ff = resolveSymbol(topLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx
  ELSE
    tiraScheduleHeapResetId

    ff = resolveSymbol(topLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx
  END IF

  ' Anchor the end of the loop in the TIRA symbol table
  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2
  tiraLabelId doneLblIdx

  tiraScheduleHeapResetId

  tira_EndAndProcess

  parse_LOOP = 1

END FUNCTION ' parse_LOOP

''''''''''''''''''''''''
FUNCTION parse_LTRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM origPtrIdx AS LONG
  DIM origLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpaceLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LTRIM$", 3) = 0 THEN
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LTRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("LTRIM", "_DSC")
  IF scratchIdx = 0 THEN
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  origPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  origLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, origPtrIdx
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, origLenIdx

  loopTopIdx = tiraLabelCreateNewId&("LTRIM_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("LTRIM_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  isSpaceLblIdx = tiraLabelCreateNewId&("LTRIM_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopDoneIdx
  tiraLabelId isSpaceLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LTRIM$ = scratchName$

END FUNCTION ' parse_LTRIM$

''''''''''''''''''''''''
FUNCTION parse_KEYCLEAR (startIdx)

  DIM endIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailIdx AS LONG
  DIM headIdx AS LONG

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "_KEYCLEAR")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    tailIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    headIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailIdx

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, headIdx

    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_LITERAL, 4
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_KEYCLEAR = 1

END FUNCTION ' parse_KEYCLEAR

''''''''''''''''''''''''
FUNCTION parse_KEYDOWN$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_KEYDOWN", 3) = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("KEYDOWN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ff = resolveSymbol("RT_KEYDOWN")
  IF ff = 0 THEN
    tira_Cancel
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraInjectPendingDisplayFlushId

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_KEYDOWN$ = scratchName$

END FUNCTION ' parse_KEYDOWN$

''''''''''''''''''''''''
FUNCTION parse_MEM$ (startIdx, endIdx, allowImplicit)

  ' Provides direct memory access and sizing information for a variable

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM vNameTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM memUdtIdx AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM baseAddrIdx AS LONG
  DIM destAddrIdx AS LONG
  DIM destSizeAddrIdx AS LONG
  DIM hasIndex AS LONG
  DIM closeParen AS LONG
  DIM numParsedIndices AS LONG
  DIM elemSize AS LONG
  DIM staticByteSize AS _INTEGER64
  DIM memSizeIdx AS LONG
  DIM descriptorAddrIdx AS LONG
  DIM descriptorDimsIdx AS LONG
  DIM runtimeDoneIdx AS LONG
  DIM dimensionIndexIdx AS LONG
  DIM dimensionLoopIdx AS LONG
  DIM dimensionDoneIdx AS LONG
  DIM dimensionOffsetIdx AS LONG
  DIM dimensionAddrIdx AS LONG
  DIM dimensionElemsIdx AS LONG
  DIM descriptorElemSizeIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_MEM", 3) = 0 THEN
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  vNameTok$ = lineTokens$(startIdx + 2)
  vName$ = UCASE$(vNameTok$)

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  hasIndex = 0
  numParsedIndices = 0
  IF startIdx + 3 < endIdx THEN
    IF lineTokenVals(startIdx + 3) = 256 + ASC("(") THEN
      hasIndex = 1
      ff = tiraParseArrayId(startIdx + 3, endIdx, 0)
      IF ff = 0 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_MEM$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_MEM$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("MEM", "_UDT")
  IF scratchIdx = 0 THEN
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = findUdtIndex("_MEM")
  memUdtIdx = returnedData2

  symbols(scratchIdx).DataType = TYPE_UDT
  symbols(scratchIdx).UDTIndex = memUdtIdx

  baseAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF

  destAddrIdx = tiraFrontendCalcAddressId&(scratchIdx, 0, 0)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  tiraWriteMemId TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_LITERAL, 8

  ' Ensure SIZE is natively initialized to zero to prevent uninitialized data corruption inside the UDT mapping
  destSizeAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_LITERAL, 8
  tiraWriteMemId TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

  ' Set SIZE to the complete array payload or one addressed element
  elemSize = retElementByteSize(vIdx)
  memSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > 0 AND numParsedIndices = 0 THEN

    SELECT CASE symbols(vIdx).IsArray

      CASE ARRAY_TYPE_STATIC
        staticByteSize = elemSize
        staticByteSize = staticByteSize * symbols(vIdx).Size
        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, staticByteSize

      CASE ARRAY_TYPE_RUNTIME
        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, 0

        descriptorAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, vIdx

        descriptorDimsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId descriptorDimsIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 12

        runtimeDoneIdx = tiraLabelCreateNewId&("MEM_SIZE_DONE")
        tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimsIdx, TIRA_ARG_LITERAL, 0, runtimeDoneIdx

        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, 1

        dimensionIndexIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraAssignId dimensionIndexIdx, TIRA_ARG_LITERAL, 0

        dimensionLoopIdx = tiraLabelCreateNewId&("MEM_DIM_LOOP")
        dimensionDoneIdx = tiraLabelCreateNewId&("MEM_DIM_DONE")

        tiraLabelId dimensionLoopIdx
        tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, descriptorDimsIdx, dimensionDoneIdx

        dimensionOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 8
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_LITERAL, 16

        dimensionAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionAddrIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx

        dimensionElemsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimensionElemsIdx, TIRA_ARG_SYMBOL, dimensionAddrIdx, 4

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, dimensionElemsIdx
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 1
        tiraJmpId dimensionLoopIdx

        tiraLabelId dimensionDoneIdx

        descriptorElemSizeIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId descriptorElemSizeIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 8

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, descriptorElemSizeIdx

        tiraLabelId runtimeDoneIdx

      CASE ELSE
        throwCompilerErrorAndCancelTira "INVALID ARRAY KIND", ASIS, 0
        parse_MEM$ = ""
        EXIT FUNCTION

    END SELECT ' symbols(vIdx).IsArray

  ELSE
    tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, elemSize
  END IF

  tiraWriteMemId TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_LITERAL, 8

  tira_EndAndProcess

  exprIs.DataType = TYPE_UDT
  exprIs.IsTemp = 1
  parse_MEM$ = scratchName$

END FUNCTION ' parse_MEM$

''''''''''''''''''''''''
FUNCTION parse_MEMFREE (startIdx)

  ' Invalidates a non-owning _MEM descriptor without freeing its referenced storage

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM memUdtIndex AS LONG
  DIM memDescAddrIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "_MEMFREE REQUIRES A MEMORY BLOCK", ASIS, 0
    EXIT FUNCTION
  END IF

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx > 0 THEN
    throwCompilerError "_MEMFREE ACCEPTS ONE MEMORY BLOCK", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findUdtIndex("_MEM")
  IF ff = 0 THEN
    throwCompilerError "INTERNAL _MEM TYPE NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF
  memUdtIndex = returnedData2

  tira_Start

  memDescAddrIdx = tiraParseRhsUdtBaseId&(startIdx + 1, endIdx, memUdtIndex)
  IF memDescAddrIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraMemSetId TIRA_ARG_SYMBOL, memDescAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, udts(memUdtIndex).TotalSize

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_MEMFREE = 1

END FUNCTION ' parse_MEMFREE

''''''''''''''''''''''''
FUNCTION parse_MID$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2$
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM arg3$
  DIM arg3Type AS LONG
  DIM arg3Val AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLen$
  DIM strLenIdx AS LONG
  DIM startIdxVarIdx AS LONG
  DIM remLenIdx AS LONG
  DIM safeLenIdx AS LONG
  DIM dataPtr$
  DIM dataPtrIdx AS LONG
  DIM descPtr$
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MID$", 5) = 0 THEN
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "MALFORMED MID$", ASIS, 0
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_MID$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "MID$ ARG 1 MUST BE STRING", ASIS, 0
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, allowImplicit, "MID$ ARG 2 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(comma2 + 1, endIdx - 1, allowImplicit, "MID$ ARG 3 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg3Type = tiraParsedArgType
    arg3Val = tiraParsedArgVal
  ELSE
    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "MID$ ARG 2 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal
    arg3Type = TIRA_ARG_LITERAL
    arg3Val = &H7FFFFFFF ' Max integer length to act as missing arg
  END IF

  scratchIdx = tiraResolveHoistVarId&("MID", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MID$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  startIdxVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, startIdxVarIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1

  tiraClampId startIdxVarIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, strLenIdx

  remLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, startIdxVarIdx

  safeLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId safeLenIdx, arg3Type, arg3Val
  tiraClampId remLenIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, safeLenIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, startIdxVarIdx
  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, remLenIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MID$ = scratchName$

END FUNCTION ' parse_MID$

''''''''''''''''''''''''
FUNCTION parse_MID_Assign (startIdx)

  DIM endIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM strStartIdx AS LONG
  DIM strEndIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG
  DIM udtFieldNames$(256)
  DIM vTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tempFieldSize AS LONG
  DIM numParsedIndices AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM finalAddrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM startType AS LONG
  DIM startVal AS _INTEGER64
  DIM hasOptLen AS LONG
  DIM optLenType AS LONG
  DIM optLenVal AS _INTEGER64
  DIM rhsType AS LONG
  DIM rhsVal AS _INTEGER64
  DIM rhsDataPtrIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM maxCopyLenIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM lblErrIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM skipClampLenIdx AS LONG
  DIM skipClampRhsIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "MALFORMED MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER MID$", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(tokIdx, endIdx)
  IF ff = 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParenIdx = returnedData2

  IF closeParenIdx + 1 > endIdx OR lineTokenVals(closeParenIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = IN MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, closeParenIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "EXPECTED COMMA IN MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, closeParenIdx - 1)

  strStartIdx = startIdx + 2
  strEndIdx = comma1 - 1

  vTok$ = lineTokens$(strStartIdx)
  vName$ = UCASE$(vTok$)
  tokIdx = strStartIdx + 1

  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= strEndIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= strEndIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, strEndIdx)
      IF ff = 1 THEN
        tokIdx = returnedData2 + 1
      ELSE
        EXIT FUNCTION
      END IF
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= strEndIdx THEN
    throwCompilerError "MID$ TARGET MUST BE A SINGLE ADDRESSABLE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2
  targetType = returnedData3

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempFieldSize = udtFields(uIdx, iField).Size
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
          iField = returnedData2
          IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
            udtOffset = udtOffset + udtFields(uIdx, iField).Offset
            targetType = udtFields(uIdx, iField).DataType
            tempUdtIndex = udtFields(uIdx, iField).UDTIndex
            tempFieldSize = udtFields(uIdx, iField).Size
            tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
            fieldFound = 1
          END IF
        END IF
      END IF

      IF fieldFound = 0 THEN
        throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  IF targetType <> TYPE_STRING THEN
    throwCompilerError "MID$ TARGET MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayId(parenStartIdx, strEndIdx, 0)
    IF ff = 0 THEN EXIT FUNCTION
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerError "ARRAY NOT DIMMED", ASIS, 0
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  isFixedStr = 0
  destLen = 0
  IF hasField = 1 THEN
    IF tempIsDynamicString = 0 THEN
      isFixedStr = 1
      destLen = tempFieldSize
    END IF
  ELSE
    destLen = retFixedStringLength(vIdx)
    IF destLen > 0 THEN
      isFixedStr = 1
    END IF
  END IF

  IF isFixedStr = 1 THEN
    dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    strLenIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, destLen
  ELSE
    lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraReadMemId lhsDescPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
  END IF

  ' Evaluate START argument
  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, ALIM, "START MUST BE NUMERIC")
  ELSE
    ff = tiraParseExpressionIntId(comma1 + 1, closeParenIdx - 1, ALIM, "START MUST BE NUMERIC")
  END IF

  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  startType = tiraParsedArgType
  startVal = tiraParsedArgVal

  ' Evaluate LENGTH argument (optional)
  hasOptLen = 0
  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntId(comma2 + 1, closeParenIdx - 1, ALIM, "LENGTH MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    hasOptLen = 1
    optLenType = tiraParsedArgType
    optLenVal = tiraParsedArgVal
  END IF

  ' Evaluate RHS Expression
  ff = tiraParseExpressionId(closeParenIdx + 2, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  rhsType = tiraParsedArgType
  rhsVal = tiraParsedArgVal
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "MID$ ASSIGNMENT REQUIRES STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  rhsDataPtrIdx = tiraGetStringDataId&(rhsType, rhsVal)
  rhsLenIdx = tiraGetStringLenId&(rhsType, rhsVal)

  lblErrIdx = tiraLabelCreateNewId&("MID_ERR")
  lblValidIdx = tiraLabelCreateNewId&("MID_VALID")
  lblDoneIdx = tiraLabelCreateNewId&("MID_DONE")

  ' Error if start <= 0
  tiraJmpCondId JCC_JLE, startType, startVal, TIRA_ARG_LITERAL, 0, lblErrIdx
  tiraJmpId lblValidIdx

  tiraLabelId lblErrIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId lblValidIdx

  ' Convert 1-based start to 0-based offset
  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, offsetVarIdx, startType, startVal, TIRA_ARG_LITERAL, 1

  ' maxCopyLen = strLen - offset
  maxCopyLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, maxCopyLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  ' If offset >= strLen, do nothing
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maxCopyLenIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  ' Clamp maxCopyLen to optional length if provided
  IF hasOptLen = 1 THEN
    ' If optional length < 0, illegal function call.
    tiraJmpCondId JCC_JL, optLenType, optLenVal, TIRA_ARG_LITERAL, 0, lblErrIdx
    skipClampLenIdx = tiraLabelCreateNewId&("MID_SKIP_CLAMP_LEN")
    tiraJmpCondId JCC_JGE, optLenType, optLenVal, TIRA_ARG_SYMBOL, maxCopyLenIdx, skipClampLenIdx
    tiraAssignId maxCopyLenIdx, optLenType, optLenVal
    tiraLabelId skipClampLenIdx
  END IF

  ' Clamp maxCopyLen to RHS length
  skipClampRhsIdx = tiraLabelCreateNewId&("MID_SKIP_CLAMP_RHS")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_SYMBOL, maxCopyLenIdx, skipClampRhsIdx
  tiraAssignId maxCopyLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
  tiraLabelId skipClampRhsIdx

  ' Final safety check before copy
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maxCopyLenIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraMemcpyId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, rhsDataPtrIdx, TIRA_ARG_SYMBOL, maxCopyLenIdx

  tiraLabelId lblDoneIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_MID_Assign = 1

END FUNCTION ' parse_MID_Assign

''''''''''''''''''''''''
FUNCTION parse_MKD$ (startIdx, endIdx, allowImplicit)

  ' Converts a double-precision number into an 8-byte string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKD$", 3) = 0 THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("MKD", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MKD$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 8)

  ' Have the TIRA backend natively coerce the numeric expression into a 64-bit hardware DOUBLE precision value and save it to the allocated heap string block
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_STR_LITERAL, 64

  ' Build the string descriptor pointing to our 8-byte temporary string
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKD$ = scratchName$

END FUNCTION ' parse_MKD$

''''''''''''''''''''''''
FUNCTION parse_MKI$ (startIdx, endIdx, allowImplicit)

  ' Converts an integer into a 2-byte string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKI$", 3) = 0 THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("MKI", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MKI$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 2)

  ' Write the 2-byte integer payload to the heap natively
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 2

  ' Build the String Descriptor directly on the Scratchpad memory
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  ' Ensure Flags are set to 0 (No Free Required on Temp Heap)
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 2, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKI$ = scratchName$

END FUNCTION ' parse_MKI$

''''''''''''''''''''''''
FUNCTION parse_MKL$ (startIdx, endIdx, allowImplicit)

  ' Converts a long integer into a 4-byte string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKL$", 3) = 0 THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("MKL", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MKL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)

  ' Have the TIRA backend natively coerce the numeric expression into a 32-bit hardware LONG integer value and save it to the allocated heap string block
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 4

  ' Build the string descriptor pointing to our 4-byte temporary string
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 4, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKL$ = scratchName$

END FUNCTION ' parse_MKL$

''''''''''''''''''''''''
FUNCTION parse_MKS$ (startIdx, endIdx, allowImplicit)

  ' Converts a single-precision number into a 4-byte string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MKS$", 3) = 0 THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("MKS", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MKS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)

  ' Have the TIRA backend natively coerce the numeric expression into a 32-bit hardware SINGLE precision value and save it to the allocated heap string block
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_STR_LITERAL, 32

  ' Build the string descriptor pointing to our 4-byte temporary string
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 4, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MKS$ = scratchName$

END FUNCTION ' parse_MKS$

''''''''''''''''''''''''
FUNCTION parse_MOUSEBUTTON$ (startIdx, endIdx, allowImplicit)

' Returns the current state of a specified mouse button

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM lblB2Idx AS LONG
  DIM lblB3Idx AS LONG
  DIM lblEndIdx AS LONG
  DIM mouseB1Idx AS LONG
  DIM mouseB2Idx AS LONG
  DIM mouseB3Idx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_MOUSEBUTTON", 3) = 0 THEN
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEBUTTON REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("MOUSEBUTTON", "_VAL")
  IF scratchIdx = 0 THEN
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B1")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF
  mouseB1Idx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B2")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF
  mouseB2Idx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_MOUSE_B3")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF
  mouseB3Idx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  lblB2Idx = tiraLabelCreateNewId&("MB_2")
  lblB3Idx = tiraLabelCreateNewId&("MB_3")
  lblEndIdx = tiraLabelCreateNewId&("MB_END")

  tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 2, lblB2Idx
  tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 3, lblB3Idx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, mouseB1Idx
  tiraJmpId lblEndIdx

  tiraLabelId lblB2Idx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, mouseB2Idx
  tiraJmpId lblEndIdx

  tiraLabelId lblB3Idx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, mouseB3Idx

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEBUTTON$ = scratchName$

END FUNCTION ' parse_MOUSEBUTTON$

''''''''''''''''''''''''
FUNCTION parse_MOUSEINPUT$ (startIdx, endIdx, allowImplicit)

  ' Captures pending mouse events from the input queue

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _MOUSEINPUT", ASIS, 0
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEINPUT REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("MOUSEINPUT", "_VAL")
  IF scratchIdx = 0 THEN
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("RT_MOUSEINPUT")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEINPUT$ = scratchName$

END FUNCTION ' parse_MOUSEINPUT$

