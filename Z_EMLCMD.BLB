' Z_EMLCMD.BLB This is the external library file for EmeraldBasic
' The line with comment, dollar sign, and INCLUDE 'Z_EMLCMD.BLB' at the end of the EmeraldBasic file link this code in QB64PE
' For an EmeraldBasic compiler, use '#AUTOINCLUDE at the top of the file

FUNCTION addStackSpace (wSize)

  tempOffset = currentFrameSize
  currentFrameSize = currentFrameSize + wSize
  addStackSpace = tempOffset

END FUNCTION ' addStackSpace

''''''''''''''''''''''''
SUB emitRuntimeAxis

  rtOffset(RT_AXIS) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' For now we will return 0 as a placeholder stub
  resVar$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraAssign resVar$, "0"

  doneLbl$ = tiraLabelCreateNew$("AXIS_DONE")
  calcLbl$ = tiraLabelCreateNew$("AXIS_CALC")
  axis1Lbl$ = tiraLabelCreateNew$("AXIS_1")
  axis2Lbl$ = tiraLabelCreateNew$("AXIS_2")
  axis3Lbl$ = tiraLabelCreateNew$("AXIS_3")
  axis4Lbl$ = tiraLabelCreateNew$("AXIS_4")
  axis5Lbl$ = tiraLabelCreateNew$("AXIS_5")
  axis6Lbl$ = tiraLabelCreateNew$("AXIS_6")

  tiraJmpCond "JE", "!G_INO_FLG_GAMEPAD_VALID", "0", doneLbl$

  tiraJmpCond "JE", arg1Var$, "1", axis1Lbl$
  tiraJmpCond "JE", arg1Var$, "2", axis2Lbl$
  tiraJmpCond "JE", arg1Var$, "3", axis3Lbl$
  tiraJmpCond "JE", arg1Var$, "4", axis4Lbl$
  tiraJmpCond "JE", arg1Var$, "5", axis5Lbl$
  tiraJmpCond "JE", arg1Var$, "6", axis6Lbl$
  tiraJmp doneLbl$

  axisVal$ = tiraDimVar$("T", TYPE_LONG)
  scaleVal$ = tiraDimVar$("T", TYPE_SINGLE)

  tiraLabel axis1Lbl$
  tiraAssign axisVal$, "!G_INO_V32_GAMEPAD_LX"
  tiraAssign scaleVal$, "32768.0"
  tiraJmp calcLbl$

  tiraLabel axis2Lbl$
  tiraOp TC_SUB, axisVal$, "0", "!G_INO_V32_GAMEPAD_LY"
  tiraAssign scaleVal$, "32768.0"
  tiraJmp calcLbl$

  tiraLabel axis3Lbl$
  tiraAssign axisVal$, "!G_INO_V32_GAMEPAD_RX"
  tiraAssign scaleVal$, "32768.0"
  tiraJmp calcLbl$

  tiraLabel axis4Lbl$
  tiraOp TC_SUB, axisVal$, "0", "!G_INO_V32_GAMEPAD_RY"
  tiraAssign scaleVal$, "32768.0"
  tiraJmp calcLbl$

  tiraLabel axis5Lbl$
  tiraAssign axisVal$, "!G_INO_V32_GAMEPAD_LT"
  tiraAssign scaleVal$, "255.0"
  tiraJmp calcLbl$

  tiraLabel axis6Lbl$
  tiraAssign axisVal$, "!G_INO_V32_GAMEPAD_RT"
  tiraAssign scaleVal$, "255.0"

  tiraLabel calcLbl$
  axisSingle$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, axisSingle$, axisVal$, LTRIM$(STR$(TYPE_SINGLE))
  tiraOp TC_DIV, resVar$, axisSingle$, scaleVal$

  tiraLabel doneLbl$
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeAxis

''''''''''''''''''''''''
SUB emitRuntimeButton

  rtOffset(RT_BUTTON) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' For now we will return 0 as a placeholder stub
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  doneLbl$ = tiraLabelCreateNew$("BUTTON_DONE")
  checkLbl$ = tiraLabelCreateNew$("BUTTON_CHECK")
  button1Lbl$ = tiraLabelCreateNew$("BUTTON_1")
  button2Lbl$ = tiraLabelCreateNew$("BUTTON_2")
  button3Lbl$ = tiraLabelCreateNew$("BUTTON_3")
  button4Lbl$ = tiraLabelCreateNew$("BUTTON_4")
  button5Lbl$ = tiraLabelCreateNew$("BUTTON_5")
  button6Lbl$ = tiraLabelCreateNew$("BUTTON_6")
  button7Lbl$ = tiraLabelCreateNew$("BUTTON_7")
  button8Lbl$ = tiraLabelCreateNew$("BUTTON_8")
  button9Lbl$ = tiraLabelCreateNew$("BUTTON_9")
  button10Lbl$ = tiraLabelCreateNew$("BUTTON_10")
  button11Lbl$ = tiraLabelCreateNew$("BUTTON_11")
  button12Lbl$ = tiraLabelCreateNew$("BUTTON_12")
  button13Lbl$ = tiraLabelCreateNew$("BUTTON_13")
  button14Lbl$ = tiraLabelCreateNew$("BUTTON_14")

  tiraJmpCond "JE", "!G_INO_FLG_GAMEPAD_VALID", "0", doneLbl$

  tiraJmpCond "JE", arg1Var$, "1", button1Lbl$
  tiraJmpCond "JE", arg1Var$, "2", button2Lbl$
  tiraJmpCond "JE", arg1Var$, "3", button3Lbl$
  tiraJmpCond "JE", arg1Var$, "4", button4Lbl$
  tiraJmpCond "JE", arg1Var$, "5", button5Lbl$
  tiraJmpCond "JE", arg1Var$, "6", button6Lbl$
  tiraJmpCond "JE", arg1Var$, "7", button7Lbl$
  tiraJmpCond "JE", arg1Var$, "8", button8Lbl$
  tiraJmpCond "JE", arg1Var$, "9", button9Lbl$
  tiraJmpCond "JE", arg1Var$, "10", button10Lbl$
  tiraJmpCond "JE", arg1Var$, "11", button11Lbl$
  tiraJmpCond "JE", arg1Var$, "12", button12Lbl$
  tiraJmpCond "JE", arg1Var$, "13", button13Lbl$
  tiraJmpCond "JE", arg1Var$, "14", button14Lbl$
  tiraJmp doneLbl$

  maskVal$ = tiraDimVar$("T", TYPE_LONG)

  tiraLabel button1Lbl$
  tiraAssign maskVal$, "16384"
  tiraJmp checkLbl$

  tiraLabel button2Lbl$
  tiraAssign maskVal$, "8192"
  tiraJmp checkLbl$

  tiraLabel button3Lbl$
  tiraAssign maskVal$, "4096"
  tiraJmp checkLbl$

  tiraLabel button4Lbl$
  tiraAssign maskVal$, "32768"
  tiraJmp checkLbl$

  tiraLabel button5Lbl$
  tiraAssign maskVal$, "256"
  tiraJmp checkLbl$

  tiraLabel button6Lbl$
  tiraAssign maskVal$, "512"
  tiraJmp checkLbl$

  tiraLabel button7Lbl$
  tiraAssign maskVal$, "64"
  tiraJmp checkLbl$

  tiraLabel button8Lbl$
  tiraAssign maskVal$, "128"
  tiraJmp checkLbl$

  tiraLabel button9Lbl$
  tiraAssign maskVal$, "32"
  tiraJmp checkLbl$

  tiraLabel button10Lbl$
  tiraAssign maskVal$, "16"
  tiraJmp checkLbl$

  tiraLabel button11Lbl$
  tiraAssign maskVal$, "1"
  tiraJmp checkLbl$

  tiraLabel button12Lbl$
  tiraAssign maskVal$, "2"
  tiraJmp checkLbl$

  tiraLabel button13Lbl$
  tiraAssign maskVal$, "4"
  tiraJmp checkLbl$

  tiraLabel button14Lbl$
  tiraAssign maskVal$, "8"

  tiraLabel checkLbl$
  pressedVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, pressedVal$, "!G_INO_V32_GAMEPAD_BUTTONS", maskVal$
  tiraJmpCond "JE", pressedVal$, "0", doneLbl$
  tiraAssign resVar$, "-1"

  tiraLabel doneLbl$
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeButton

''''''''''''''''''''''''
SUB emitRuntimeCircle

  rtOffset(RT_CIRCLE) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argCx$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argCx$ + ", 1"
  argCy$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argCy$ + ", 2"
  argR$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argR$ + ", 3"
  argC$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argC$ + ", 4"

  x$ = tiraDimVar$("T", TYPE_LONG)
  y$ = tiraDimVar$("T", TYPE_LONG)
  errVal$ = tiraDimVar$("T", TYPE_LONG)

  tiraAssign x$, argR$
  tiraAssign y$, "0"
  tiraOp TC_SUB, errVal$, "1", x$

  loopTop$ = tiraLabelCreateNew$("CIRC_LOOP")
  loopDone$ = tiraLabelCreateNew$("CIRC_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JL", x$, y$, loopDone$

  tmpX$ = tiraDimVar$("T", TYPE_LONG)
  tmpY$ = tiraDimVar$("T", TYPE_LONG)

  tiraOp TC_ADD, tmpX$, argCx$, x$
  tiraOp TC_ADD, tmpY$, argCy$, y$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_ADD, tmpX$, argCx$, y$
  tiraOp TC_ADD, tmpY$, argCy$, x$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_SUB, tmpX$, argCx$, y$
  tiraOp TC_ADD, tmpY$, argCy$, x$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_SUB, tmpX$, argCx$, x$
  tiraOp TC_ADD, tmpY$, argCy$, y$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_SUB, tmpX$, argCx$, x$
  tiraOp TC_SUB, tmpY$, argCy$, y$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_SUB, tmpX$, argCx$, y$
  tiraOp TC_SUB, tmpY$, argCy$, x$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_ADD, tmpX$, argCx$, y$
  tiraOp TC_SUB, tmpY$, argCy$, x$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_ADD, tmpX$, argCx$, x$
  tiraOp TC_SUB, tmpY$, argCy$, y$
  tiraCall "RT_PLOT_PIXEL", 3, tmpX$ + ", " + tmpY$ + ", " + argC$

  tiraOp TC_ADD, y$, y$, "1"

  lblErrPos$ = tiraLabelCreateNew$("CIRC_ERR_POS")
  tiraJmpCond "JGE", errVal$, "0", lblErrPos$

  tmpErr$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, tmpErr$, y$, "2"
  tiraOp TC_ADD, tmpErr$, tmpErr$, "1"
  tiraOp TC_ADD, errVal$, errVal$, tmpErr$
  tiraJmp loopTop$

  tiraLabel lblErrPos$
  tiraOp TC_SUB, x$, x$, "1"

  tmpErr1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, tmpErr1$, y$, x$
  tiraOp TC_ADD, tmpErr1$, tmpErr1$, "1"
  tiraOp TC_MUL, tmpErr1$, tmpErr1$, "2"
  tiraOp TC_ADD, errVal$, errVal$, tmpErr1$
  tiraJmp loopTop$

  tiraLabel loopDone$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeCircle

''''''''''''''''''''''''
SUB emitRuntimeClipboardGet

  rtOffset(RT_GET_CLIPBOARD) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  ' Retrieve pointer to the uninitialized descriptor struct requesting the copied string
  descPtr$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, descPtr$ + ", 1"

  lblFail$ = tiraLabelCreateNew$("CGET_FAIL")
  lblDone$ = tiraLabelCreateNew$("CGET_DONE")

  ' Check if standard string text exists on the clipboard natively via IsClipboardFormatAvailable(CF_TEXT = 1)
  tiraCall "IAT_ISCLIPBOARDFORMATAVAILABLE", 1, "1"
  avail$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, avail$
  tiraJmpCond "JE", avail$, "0", lblFail$

  ' Request ownership of the clipboard hardware
  tiraCall "IAT_OPENCLIPBOARD", 1, "0"
  resOpen$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resOpen$
  tiraJmpCond "JE", resOpen$, "0", lblFail$

  ' Retrieve Global Handle pointing to the clipboard's CF_TEXT memory
  tiraCall "IAT_GETCLIPBOARDDATA", 1, "1"
  hMem$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hMem$
  tiraJmpCond "JE", hMem$, "0", lblFail$

  ' Lock hardware memory temporarily to safely read the bytes
  tiraCall "IAT_GLOBALLOCK", 1, hMem$
  srcPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, srcPtr$
  tiraJmpCond "JE", srcPtr$, "0", lblFail$

  lenVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign lenVar$, "0"
  lblLenTop$ = tiraLabelCreateNew$("CGET_LENTOP")
  lblLenDone$ = tiraLabelCreateNew$("CGET_LENDONE")

  ' Execute a high-speed manual strlen iteration to identify exactly where the clipboard data stops
  tiraLabel lblLenTop$
  checkAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, checkAddr$, srcPtr$, lenVar$
  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + checkAddr$
  tiraJmpCond "JE", byteVal$, "0", lblLenDone$ ' Stop exactly when the hardware null terminator is found
  tiraOp TC_ADD, lenVar$, lenVar$, "1"
  tiraJmp lblLenTop$
  tiraLabel lblLenDone$

  ' Safely allocate destination buffer internally using Temp Heap methodology to prevent memory leaks
  tiraOp TC_SUB, "!G_MEM_PTR_TEMP_HEAP", "!G_MEM_PTR_TEMP_HEAP", lenVar$
  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign dataPtr$, "!G_MEM_PTR_TEMP_HEAP"

  ' Transfer clipboard data into localized execution memory
  tiraMemcpy dataPtr$, srcPtr$, lenVar$

  tiraCall "IAT_GLOBALUNLOCK", 1, hMem$

  tiraCall "IAT_CLOSECLIPBOARD", 0, ""

  ' Tie the returned address back up to the source descriptor cleanly. Flag is 0 because the string lives on the Temp Heap.
  tiraBuildStringDescriptor descPtr$, dataPtr$, lenVar$, "0"
  tiraJmp lblDone$

  tiraLabel lblFail$

  ' If format missing or extraction fails, cleanly fall back and return an empty string safely to avoid crashing
  tiraBuildStringDescriptor descPtr$, "0", "0", "0"
  tiraCall "IAT_CLOSECLIPBOARD", 0, ""

  tiraLabel lblDone$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardGet

''''''''''''''''''''''''
SUB emitRuntimeClipboardSet

  rtOffset(RT_SET_CLIPBOARD) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  ' Read string descriptor argument directly from caller stack footprint
  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  dataPtr$ = tiraGetStringData$(arg1Var$)
  strLen$ = tiraGetStringLen$(arg1Var$)

  lblEmpty$ = tiraLabelCreateNew$("CLIP_EMPTY")
  lblDone$ = tiraLabelCreateNew$("CLIP_DONE")

  ' Request ownership of the Clipboard hardware natively using parameter zero
  tiraCall "IAT_OPENCLIPBOARD", 1, "0"
  resOpen$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resOpen$
  tiraJmpCond "JE", resOpen$, "0", lblDone$ ' Failed to open, gracefully abort

  ' We must successfully empty the clipboard before attempting to set new content
  tiraCall "IAT_EMPTYCLIPBOARD", 0, ""

  ' If the length is empty, jump to the end where we close and return safely
  tiraJmpCond "JLE", strLen$, "0", lblEmpty$

  ' Request Global Memory block ensuring we include space for the trailing null byte
  allocSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, allocSize$, strLen$, "1"

  ' GlobalAlloc(GMEM_MOVEABLE = 2, allocSize)
  tiraCall "IAT_GLOBALALLOC", 2, "2, " + allocSize$
  hMem$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hMem$

  tiraJmpCond "JE", hMem$, "0", lblEmpty$ ' Alloc failed, exit cleanly

  ' Lock memory block to retrieve the physical pointer handle
  tiraCall "IAT_GLOBALLOCK", 1, hMem$
  destPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, destPtr$

  tiraJmpCond "JE", destPtr$, "0", lblEmpty$ ' Lock failed, exit cleanly

  ' Clone string data into the globally allocated structure
  tiraMemcpy destPtr$, dataPtr$, strLen$

  ' Inject null terminator physically at the end to satisfy Windows CF_TEXT ABI
  nullPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, nullPtr$, destPtr$, strLen$
  tiraWriteMem nullPtr$, "0", "1"

  tiraCall "IAT_GLOBALUNLOCK", 1, hMem$

  ' Finalize data handoff to Windows via SetClipboardData(CF_TEXT = 1, hMem)
  tiraCall "IAT_SETCLIPBOARDDATA", 2, "1, " + hMem$

  tiraLabel lblEmpty$

  ' We must always release the clipboard so other programs do not get frozen
  tiraCall "IAT_CLOSECLIPBOARD", 0, ""

  tiraLabel lblDone$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardSet

''''''''''''''''''''''''
SUB emitRuntimeDevice

  rtOffset(RT_DEVICE) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  arg2Var$ = tiraDimVar$("ARG2", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"

  ' Build an empty string descriptor to satisfy the safe skeletal framework
  tiraBuildStringDescriptor arg2Var$, "0", "0", "0"

  heapMark$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign heapMark$, "!G_MEM_PTR_TEMP_HEAP"

  ' Allocate the returned description before temporary controller structures
  resultPtr$ = tiraAllocTempMem$("96")

  statePtr$ = tiraAllocTempMem$("52")
  userIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign userIdx$, "0"
  deviceCount$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign deviceCount$, "0"

  loopTop$ = tiraLabelCreateNew$("DEVICE_LOOP")
  loopNext$ = tiraLabelCreateNew$("DEVICE_NEXT")
  xinputDoneLbl$ = tiraLabelCreateNew$("DEVICE_XDONE")
  foundLbl$ = tiraLabelCreateNew$("DEVICE_FOUND")
  joyLoopTop$ = tiraLabelCreateNew$("DEVICE_JOY_LOOP")
  joyLoopNext$ = tiraLabelCreateNew$("DEVICE_JOY_NEXT")
  joyFoundLbl$ = tiraLabelCreateNew$("DEVICE_JOY_FOUND")
  joyCapsFailLbl$ = tiraLabelCreateNew$("DEVICE_JOY_CAPS_FAIL")
  joyNameLoopLbl$ = tiraLabelCreateNew$("DEVICE_JOY_NAME_LOOP")
  joyNameDoneLbl$ = tiraLabelCreateNew$("DEVICE_JOY_NAME_DONE")
  joyButtonDoneLbl$ = tiraLabelCreateNew$("DEVICE_JOY_BUTTON_DONE")
  joyAxisDoneLbl$ = tiraLabelCreateNew$("DEVICE_JOY_AXIS_DONE")
  resultDoneLbl$ = tiraLabelCreateNew$("DEVICE_RESULT_DONE")
  doneLbl$ = tiraLabelCreateNew$("DEVICE_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JGE", userIdx$, "4", xinputDoneLbl$

  tiraCall "IAT_XINPUTGETSTATE", 2, userIdx$ + ", " + statePtr$
  statusVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", loopNext$

  tiraOp TC_ADD, deviceCount$, deviceCount$, "1"
  tiraJmpCond "JE", deviceCount$, arg1Var$, foundLbl$

  tiraLabel loopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp loopTop$

  tiraLabel xinputDoneLbl$
  tiraJmpCond "JG", deviceCount$, "0", doneLbl$

  tiraAssign userIdx$, "0"
  tiraAssign deviceCount$, "0"

  tiraLabel joyLoopTop$
  tiraJmpCond "JGE", userIdx$, "16", doneLbl$

  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 0, 52, 4"
  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 4, 1279, 4"
  tiraCall "IAT_JOYGETPOSEX", 2, userIdx$ + ", " + statePtr$
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", joyLoopNext$

  tiraOp TC_ADD, deviceCount$, deviceCount$, "1"
  tiraJmpCond "JE", deviceCount$, arg1Var$, joyFoundLbl$

  tiraLabel joyLoopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp joyLoopTop$

  tiraLabel foundLbl$
  deviceDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign deviceDesc$, CHR$(34) + "[CONTROLLER][[NAME][XInput Controller]][BUTTON][AXIS]" + CHR$(34)
  dataPtr$ = tiraGetStringData$(deviceDesc$)
  strLen$ = tiraGetStringLen$(deviceDesc$)
  tiraBuildStringDescriptor arg2Var$, dataPtr$, strLen$, "0"
  tiraJmp doneLbl$

  tiraLabel joyFoundLbl$

  ' JOYCAPSA occupies 404 bytes and begins with the 32-byte product name at offset 4
  capsPtr$ = tiraAllocTempMem$("404")
  tiraMemSet capsPtr$, "0", "404"

  tiraCall "IAT_JOYGETDEVCAPSA", 3, userIdx$ + ", " + capsPtr$ + ", 404"
  capsStatus$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, capsStatus$
  tiraJmpCond "JNE", capsStatus$, "0", joyCapsFailLbl$

  namePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, namePtr$, capsPtr$, "4"

  nameLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign nameLen$, "0"

  nameBytePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  nameByte$ = tiraDimVar$("T", TYPE_UBYTE)

  tiraLabel joyNameLoopLbl$
  tiraJmpCond "JGE", nameLen$, "32", joyNameDoneLbl$

  tiraOp TC_ADD, nameBytePtr$, namePtr$, nameLen$
  tiraNew TC_READ_MEM, nameByte$ + ", " + nameBytePtr$
  tiraJmpCond "JE", nameByte$, "0", joyNameDoneLbl$

  tiraOp TC_ADD, nameLen$, nameLen$, "1"
  tiraJmp joyNameLoopLbl$

  tiraLabel joyNameDoneLbl$
  tiraJmpCond "JLE", nameLen$, "0", joyCapsFailLbl$

  numButtons$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, numButtons$ + ", " + capsPtr$ + ", 60"

  numAxes$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, numAxes$ + ", " + capsPtr$ + ", 104"

  writePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign writePtr$, resultPtr$

  prefixDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign prefixDesc$, CHR$(34) + "[CONTROLLER][[NAME][" + CHR$(34)
  prefixData$ = tiraGetStringData$(prefixDesc$)
  prefixLen$ = tiraGetStringLen$(prefixDesc$)

  tiraMemcpy writePtr$, prefixData$, prefixLen$
  tiraOp TC_ADD, writePtr$, writePtr$, prefixLen$

  tiraMemcpy writePtr$, namePtr$, nameLen$
  tiraOp TC_ADD, writePtr$, writePtr$, nameLen$

  closeDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign closeDesc$, CHR$(34) + "]]" + CHR$(34)
  closeData$ = tiraGetStringData$(closeDesc$)
  closeLen$ = tiraGetStringLen$(closeDesc$)

  tiraMemcpy writePtr$, closeData$, closeLen$
  tiraOp TC_ADD, writePtr$, writePtr$, closeLen$

  tiraJmpCond "JLE", numButtons$, "0", joyButtonDoneLbl$

  buttonDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign buttonDesc$, CHR$(34) + "[BUTTON]" + CHR$(34)
  buttonData$ = tiraGetStringData$(buttonDesc$)
  buttonLen$ = tiraGetStringLen$(buttonDesc$)

  tiraMemcpy writePtr$, buttonData$, buttonLen$
  tiraOp TC_ADD, writePtr$, writePtr$, buttonLen$

  tiraLabel joyButtonDoneLbl$
  tiraJmpCond "JLE", numAxes$, "0", joyAxisDoneLbl$

  axisDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign axisDesc$, CHR$(34) + "[AXIS]" + CHR$(34)
  axisData$ = tiraGetStringData$(axisDesc$)
  axisLen$ = tiraGetStringLen$(axisDesc$)

  tiraMemcpy writePtr$, axisData$, axisLen$
  tiraOp TC_ADD, writePtr$, writePtr$, axisLen$

  tiraLabel joyAxisDoneLbl$

  resultLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, resultLen$, writePtr$, resultPtr$

  tiraBuildStringDescriptor arg2Var$, resultPtr$, resultLen$, "0"

  ' Release the temporary controller structures while retaining the returned description
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", resultPtr$
  tiraJmp resultDoneLbl$

  tiraLabel joyCapsFailLbl$
  deviceDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign deviceDesc$, CHR$(34) + "[CONTROLLER][[NAME][JOYSTICK]][BUTTON][AXIS]" + CHR$(34)
  dataPtr$ = tiraGetStringData$(deviceDesc$)
  strLen$ = tiraGetStringLen$(deviceDesc$)
  tiraBuildStringDescriptor arg2Var$, dataPtr$, strLen$, "0"

  tiraLabel doneLbl$
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", heapMark$

  tiraLabel resultDoneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeDevice

''''''''''''''''''''''''

''''''''''''''''''''''''
SUB emitRuntimeDevices

  rtOffset(RT_DEVICES) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  ' For now we will return 0 devices as a placeholder stub while gamepad support is fleshed out
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  heapMark$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign heapMark$, "!G_MEM_PTR_TEMP_HEAP"

  statePtr$ = tiraAllocTempMem$("52")
  userIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign userIdx$, "0"

  loopTop$ = tiraLabelCreateNew$("DEVICES_LOOP")
  loopNext$ = tiraLabelCreateNew$("DEVICES_NEXT")
  xinputDoneLbl$ = tiraLabelCreateNew$("DEVICES_XDONE")
  joyLoopTop$ = tiraLabelCreateNew$("DEVICES_JOY_LOOP")
  joyLoopNext$ = tiraLabelCreateNew$("DEVICES_JOY_NEXT")
  doneLbl$ = tiraLabelCreateNew$("DEVICES_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JGE", userIdx$, "4", xinputDoneLbl$

  tiraCall "IAT_XINPUTGETSTATE", 2, userIdx$ + ", " + statePtr$
  statusVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", loopNext$

  tiraOp TC_ADD, resVar$, resVar$, "1"

  tiraLabel loopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp loopTop$

  tiraLabel xinputDoneLbl$
  tiraJmpCond "JG", resVar$, "0", doneLbl$

  tiraAssign userIdx$, "0"

  tiraLabel joyLoopTop$
  tiraJmpCond "JGE", userIdx$, "16", doneLbl$

  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 0, 52, 4"
  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 4, 1279, 4"
  tiraCall "IAT_JOYGETPOSEX", 2, userIdx$ + ", " + statePtr$
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", joyLoopNext$

  tiraOp TC_ADD, resVar$, resVar$, "1"

  tiraLabel joyLoopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp joyLoopTop$

  tiraLabel doneLbl$
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", heapMark$
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeDevices

''''''''''''''''''''''''
SUB emitRuntimeGfxGet

  rtOffset(RT_GET) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argX1$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX1$ + ", 1"
  argY1$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY1$ + ", 2"
  argX2$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX2$ + ", 3"
  argY2$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY2$ + ", 4"
  argPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argPtr$ + ", 5"
  argEnd$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argEnd$ + ", 6"

  ' Adjust incoming bounds cleanly using the established viewing origin
  tiraOp TC_ADD, argX1$, argX1$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY1$, argY1$, "!G_GFX_VAL_VIEW_OFFSET_Y"
  tiraOp TC_ADD, argX2$, argX2$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY2$, argY2$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ' Swap X bounds if X1 > X2
  ptr1$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2$ = tiraDimVar$("T", TYPE_INTEGER64)

  skipXSwap$ = tiraLabelCreateNew$("GET_SKIP_X")
  tiraJmpCond "JLE", argX1$, argX2$, skipXSwap$
  tiraOp TC_ADDRESS_OF, ptr1$, argX1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, argX2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipXSwap$

  ' Swap Y bounds if Y1 > Y2
  skipYSwap$ = tiraLabelCreateNew$("GET_SKIP_Y")
  tiraJmpCond "JLE", argY1$, argY2$, skipYSwap$
  tiraOp TC_ADDRESS_OF, ptr1$, argY1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, argY2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipYSwap$

  ' Calculate array width metrics into width$
  width$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, width$, argX2$, argX1$
  tiraOp TC_ADD, width$, width$, "1"

  ' Convert width from pixels to bits for QBasic GET/PUT array compatibility
  bitWidth$ = tiraDimVar$("T", TYPE_LONG)
  lblBitWidth7$ = tiraLabelCreateNew$("GET_BW_7")
  lblBitWidthDone$ = tiraLabelCreateNew$("GET_BW_DONE")

  tiraJmpCond "JE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblBitWidth7$
  ' SCREEN 13 (8bpp)
  tiraOp TC_MUL, bitWidth$, width$, "8"
  tiraJmp lblBitWidthDone$

  tiraLabel lblBitWidth7$
  ' SCREEN 7 (4bpp)
  tiraAssign bitWidth$, width$

  tiraLabel lblBitWidthDone$

  ' Calculate array height metrics into height$
  height$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, height$, argY2$, argY1$
  tiraOp TC_ADD, height$, height$, "1"

  ' Perform an Array Bounds Limit Check to ensure we have enough space for the 8-byte header
  chkPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, chkPtr$, argPtr$, "8"
  doneLbl$ = tiraLabelCreateNew$("GET_DONE")
  tiraJmpCond "JG", chkPtr$, argEnd$, doneLbl$

  ' Directly embed our dimensional metrics into the array structure exactly like native QBasic
  tiraWriteMem argPtr$, bitWidth$, "2"

  heightPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, heightPtr$, argPtr$, "2"
  tiraWriteMem heightPtr$, height$, "2"

  ' Embed the true hidden width and height for internal stride preservation
  trueWPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, trueWPtr$, argPtr$, "4"
  tiraWriteMem trueWPtr$, width$, "2"

  trueHPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, trueHPtr$, argPtr$, "6"
  tiraWriteMem trueHPtr$, height$, "2"

  tiraOp TC_ADD, argPtr$, argPtr$, "8"

  ' Fetch Framebuffer Base from user working buffer using the SOURCE page
  fbBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign fbBase$, "!G_GFX_PTR_SRC_FRMB"

  pixelToggle$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixelToggle$, "0"
  packedByte$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign packedByte$, "0"

  ' Execute outer rendering loop tracking Y iterations
  iterY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterY$, argY1$

  loopY$ = tiraLabelCreateNew$("GET_LOOP_Y")
  tiraLabel loopY$
  tiraJmpCond "JG", iterY$, argY2$, doneLbl$

  ' Execute inner rendering loop tracking X iterations
  iterX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterX$, argX1$

  loopX$ = tiraLabelCreateNew$("GET_LOOP_X")
  tiraLabel loopX$
  endXLbl$ = tiraLabelCreateNew$("GET_END_X")
  tiraJmpCond "JG", iterX$, argX2$, endXLbl$

  ' Clip boundaries to prevent reading outside the physical window coordinates
  pixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixel$, "0"

  skipBounds$ = tiraLabelCreateNew$("GET_SKIP_BND")

  tiraJmpCond "JL", iterX$, "!G_GFX_VAL_VIEW_X1", skipBounds$
  tiraJmpCond "JGE", iterX$, "!G_GFX_VAL_VIEW_X2", skipBounds$
  tiraJmpCond "JL", iterY$, "!G_GFX_VAL_VIEW_Y1", skipBounds$
  tiraJmpCond "JGE", iterY$, "!G_GFX_VAL_VIEW_Y2", skipBounds$

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCond "JAE", iterX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), skipBounds$
  tiraJmpCond "JAE", iterY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), skipBounds$

  ' Scan pixel byte from memory safely within visual area
  offset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offset$, iterY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offset$, offset$, iterX$

  pixAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, pixAddr$, fbBase$, offset$

  pixel8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel8$ + ", " + pixAddr$
  tiraAssign pixel$, pixel8$

  tiraLabel skipBounds$

  ' Copy scanned value into memory array structure dynamically responding to the current screen rendering mode
  skipWrite$ = tiraLabelCreateNew$("GET_SKIP_WR")
  lblPackSecond$ = tiraLabelCreateNew$("GET_PACK_SEC")
  lblPackDone$ = tiraLabelCreateNew$("GET_PACK_DN")

  tiraJmpCond "JE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblPackSecond$

  ' 8bpp native write processing
  tiraJmpCond "JGE", argPtr$, argEnd$, skipWrite$
  tiraWriteMem argPtr$, pixel$, "1"
  tiraOp TC_ADD, argPtr$, argPtr$, "1"
  tiraJmp skipWrite$

  tiraLabel lblPackSecond$
  ' 4bpp bitpacking emulation layer logic (SCREEN 7 format)
  tiraJmpCond "JE", pixelToggle$, "1", lblPackDone$

  ' Pack low nibble pixel chunk
  tiraOp TC_AND, pixel$, pixel$, "15"
  tiraAssign packedByte$, pixel$
  tiraAssign pixelToggle$, "1"
  tiraJmp skipWrite$

  tiraLabel lblPackDone$
  ' Pack high nibble pixel chunk and commit to the array immediately
  tiraOp TC_AND, pixel$, pixel$, "15"
  tiraOp TC_SHL, pixel$, pixel$, "4"
  tiraOp TC_OR, packedByte$, packedByte$, pixel$

  tiraJmpCond "JGE", argPtr$, argEnd$, skipWrite$
  tiraWriteMem argPtr$, packedByte$, "1"
  tiraOp TC_ADD, argPtr$, argPtr$, "1"

  tiraAssign pixelToggle$, "0"
  tiraAssign packedByte$, "0"

  tiraLabel skipWrite$

  ' X++
  tiraOp TC_ADD, iterX$, iterX$, "1"
  tiraJmp loopX$

  ' Y++
  tiraLabel endXLbl$

  lblFlushSkip$ = tiraLabelCreateNew$("GET_FLUSH_SKP")
  tiraJmpCond "JNE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblFlushSkip$
  tiraJmpCond "JE", pixelToggle$, "0", lblFlushSkip$
  tiraJmpCond "JGE", argPtr$, argEnd$, lblFlushSkip$
  tiraWriteMem argPtr$, packedByte$, "1"
  tiraOp TC_ADD, argPtr$, argPtr$, "1"
  tiraLabel lblFlushSkip$
  tiraAssign pixelToggle$, "0"
  tiraAssign packedByte$, "0"

  tiraOp TC_ADD, iterY$, iterY$, "1"
  tiraJmp loopY$

  tiraLabel doneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeGfxGet

''''''''''''''''''''''''
SUB emitRuntimeGfxPut

  rtOffset(RT_PUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"
  arg2Var$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"
  arg3Var$ = tiraDimVar$("ARG3", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg3Var$ + ", 3"
  arg4Var$ = tiraDimVar$("ARG4", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg4Var$ + ", 4"
  arg5Var$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg5Var$ + ", 5"

  argX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign argX$, arg1Var$
  tiraOp TC_ADD, argX$, argX$, "!G_GFX_VAL_VIEW_OFFSET_X"

  argY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign argY$, arg2Var$
  tiraOp TC_ADD, argY$, argY$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ptr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign ptr$, arg3Var$
  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign endPtr$, arg4Var$

  jmpDonePut1$ = tiraLabelCreateNew$("PUT_DONE1")
  jmpDonePut2$ = tiraLabelCreateNew$("PUT_DONE2")

  ' Check if we have at least 8 bytes available for the complete header mapping
  chkPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, chkPtr$, ptr$, "8"
  tiraJmpCond "JG", chkPtr$, endPtr$, jmpDonePut1$

  ' Read width and height natively via TIRA memory indirection
  bitWidth$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, bitWidth$ + ", " + ptr$
  tiraOp TC_AND, bitWidth$, bitWidth$, "65535"

  height$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, height$ + ", " + ptr$ + ", 2"
  tiraOp TC_AND, height$, height$, "65535"

  trueWidth$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, trueWidth$ + ", " + ptr$ + ", 4"
  tiraOp TC_AND, trueWidth$, trueWidth$, "65535"

  trueHeight$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, trueHeight$ + ", " + ptr$ + ", 6"
  tiraOp TC_AND, trueHeight$, trueHeight$, "65535"

  ' Convert width from bits to pixels for QBasic GET/PUT array compatibility
  width$ = tiraDimVar$("T", TYPE_LONG)
  lblPixWidth7$ = tiraLabelCreateNew$("PUT_PW_7")
  lblPixWidthDone$ = tiraLabelCreateNew$("PUT_PW_DONE")

  tiraJmpCond "JE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblPixWidth7$
  ' SCREEN 13 (8bpp)
  tiraOp TC_IDIV, width$, bitWidth$, "8"
  tiraJmp lblPixWidthDone$

  tiraLabel lblPixWidth7$
  ' SCREEN 7 (4bpp)
  tiraAssign width$, bitWidth$

  tiraLabel lblPixWidthDone$

  lblSaneW1$ = tiraLabelCreateNew$("PUT_SANE_W1")
  tiraJmpCond "JG", trueWidth$, "0", lblSaneW1$
  tiraAssign trueWidth$, width$
  tiraLabel lblSaneW1$

  lblSaneW2$ = tiraLabelCreateNew$("PUT_SANE_W2")
  tiraJmpCond "JLE", trueWidth$, "4096", lblSaneW2$
  tiraAssign trueWidth$, width$
  tiraLabel lblSaneW2$

  lblSaneH1$ = tiraLabelCreateNew$("PUT_SANE_H1")
  tiraJmpCond "JG", trueHeight$, "0", lblSaneH1$
  tiraAssign trueHeight$, height$
  tiraLabel lblSaneH1$

  lblSaneH2$ = tiraLabelCreateNew$("PUT_SANE_H2")
  tiraJmpCond "JLE", trueHeight$, "4096", lblSaneH2$
  tiraAssign trueHeight$, height$
  tiraLabel lblSaneH2$

  trueStrideBytes$ = tiraDimVar$("T", TYPE_LONG)
  lblStride7$ = tiraLabelCreateNew$("PUT_STRIDE_7")
  lblStrideDone$ = tiraLabelCreateNew$("PUT_STRIDE_DONE")

  tiraJmpCond "JE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblStride7$
  ' SCREEN 13
  tiraAssign trueStrideBytes$, trueWidth$
  tiraJmp lblStrideDone$

  tiraLabel lblStride7$
  ' SCREEN 7 (4bpp) packed 2 pixels per byte
  tiraOp TC_ADD, trueStrideBytes$, trueWidth$, "1"
  tiraOp TC_IDIV, trueStrideBytes$, trueStrideBytes$, "2"
  tiraLabel lblStrideDone$

  tiraOp TC_ADD, ptr$, ptr$, "8"

  fbBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign fbBase$, "!G_GFX_PTR_DEST_FRMB"

  iterY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterY$, "0"

  ' Outer Loop Y
  lblLoopY$ = tiraLabelCreateNew$("PUT_LOOP_Y")
  tiraLabel lblLoopY$
  tiraJmpCond "JGE", iterY$, height$, jmpDonePut2$

  rowStartPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  rowOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, rowOffset$, iterY$, trueStrideBytes$
  tiraOp TC_ADD, rowStartPtr$, ptr$, rowOffset$

  readPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign readPtr$, rowStartPtr$

  pixelToggle$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixelToggle$, "0"
  packedByte$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign packedByte$, "0"

  iterX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterX$, "0"

  ' Inner Loop X
  lblLoopX$ = tiraLabelCreateNew$("PUT_LOOP_X")
  tiraLabel lblLoopX$

  jmpEndX$ = tiraLabelCreateNew$("PUT_END_X")
  tiraJmpCond "JGE", iterX$, width$, jmpEndX$

  pixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixel$, "0"

  lblUnpackSecond$ = tiraLabelCreateNew$("PUT_UNP_SEC")
  lblUnpackDone$ = tiraLabelCreateNew$("PUT_UNP_DN")
  jmpSkipRead$ = tiraLabelCreateNew$("PUT_SKIP_RD")

  tiraJmpCond "JNE", LTRIM$(RTRIM$(STR$(compileScreenMode))), "7", lblUnpackSecond$

  ' Unpack the low nibble 4bpp chunk
  tiraJmpCond "JE", pixelToggle$, "1", lblUnpackDone$

  tiraJmpCond "JGE", readPtr$, endPtr$, jmpSkipRead$
  pixel8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel8$ + ", " + readPtr$
  tiraAssign packedByte$, pixel8$
  tiraOp TC_ADD, readPtr$, readPtr$, "1"
  tiraLabel jmpSkipRead$

  tiraOp TC_AND, pixel$, packedByte$, "15"
  tiraAssign pixelToggle$, "1"

  jmpCheckBounds$ = tiraLabelCreateNew$("PUT_CHK_BND")
  tiraJmp jmpCheckBounds$

  tiraLabel lblUnpackDone$
  ' Unpack the high nibble 4bpp chunk directly using our preserved packed payload byte
  tiraOp TC_SHR, pixel$, packedByte$, "4"
  tiraOp TC_AND, pixel$, pixel$, "15"
  tiraAssign pixelToggle$, "0"

  tiraJmp jmpCheckBounds$

  tiraLabel lblUnpackSecond$
  ' Standard 8bpp native execution reading
  jmpSkipRead8$ = tiraLabelCreateNew$("PUT_SKIP_RD8")
  tiraJmpCond "JGE", readPtr$, endPtr$, jmpSkipRead8$

  pixel8_alt$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel8_alt$ + ", " + readPtr$
  tiraAssign pixel$, pixel8_alt$
  tiraOp TC_ADD, readPtr$, readPtr$, "1"

  tiraLabel jmpSkipRead8$

  tiraLabel jmpCheckBounds$

  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, argX$, iterX$
  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, argY$, iterY$

  jmpSkipDraw$ = tiraLabelCreateNew$("PUT_SKIP_DRW")

  tiraJmpCond "JL", absX$, "!G_GFX_VAL_VIEW_X1", jmpSkipDraw$
  tiraJmpCond "JGE", absX$, "!G_GFX_VAL_VIEW_X2", jmpSkipDraw$
  tiraJmpCond "JL", absY$, "!G_GFX_VAL_VIEW_Y1", jmpSkipDraw$
  tiraJmpCond "JGE", absY$, "!G_GFX_VAL_VIEW_Y2", jmpSkipDraw$

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCond "JAE", absX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), jmpSkipDraw$
  tiraJmpCond "JAE", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), jmpSkipDraw$

  offset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offset$, absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offset$, offset$, absX$

  fbTarget$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fbTarget$, fbBase$, offset$

  ' Put Mode Support (0=PSET, 1=XOR, 2=AND, 3=OR, 4=PRESET)
  lblModePset$ = tiraLabelCreateNew$("PUT_MODE_PSET")
  lblModeAnd$ = tiraLabelCreateNew$("PUT_MODE_AND")
  lblModeOr$ = tiraLabelCreateNew$("PUT_MODE_OR")
  lblModePreset$ = tiraLabelCreateNew$("PUT_MODE_PRESET")
  lblModeEnd$ = tiraLabelCreateNew$("PUT_MODE_END")

  tiraJmpCond "JE", arg5Var$, "0", lblModePset$

  bgPixel8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, bgPixel8$ + ", " + fbTarget$

  bgPixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign bgPixel$, bgPixel8$

  tiraJmpCond "JE", arg5Var$, "2", lblModeAnd$
  tiraJmpCond "JE", arg5Var$, "3", lblModeOr$
  tiraJmpCond "JE", arg5Var$, "4", lblModePreset$

  ' Default to XOR if 1 (or unrecognized fallback)
  tiraOp TC_XOR, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModeAnd$
  tiraOp TC_AND, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModeOr$
  tiraOp TC_OR, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModePreset$
  tiraOp TC_NOT, pixel$, pixel$, ""
  tiraOp TC_AND, pixel$, pixel$, "255"
  tiraJmp lblModeEnd$

  tiraLabel lblModePset$
  tiraLabel lblModeEnd$

  tiraWriteMem fbTarget$, pixel$, "1"

  tiraLabel jmpSkipDraw$

  tiraOp TC_ADD, iterX$, iterX$, "1"
  tiraJmp lblLoopX$

  tiraLabel jmpEndX$
  tiraOp TC_ADD, iterY$, iterY$, "1"
  tiraJmp lblLoopY$

  tiraLabel jmpDonePut1$
  tiraLabel jmpDonePut2$

  tiraTriggerAutoDisplay

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeGfxPut

''''''''''''''''''''''''
SUB emitRuntimeMouseInput

  rtOffset(RT_MOUSEINPUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  headPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, headPtr$, "!G_INO_VAL_MOUSE_HEAD", ""
  headVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, headVal$ + ", " + headPtr$

  tailPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, tailPtr$, "!G_INO_VAL_MOUSE_TAIL", ""
  tailVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, tailVal$ + ", " + tailPtr$

  retVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign retVal$, "0"

  emptyLbl$ = tiraLabelCreateNew$("MI_EMPTY")
  tiraJmpCond "JE", headVal$, tailVal$, emptyLbl$

  bufArrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, bufArrPtr$, "!G_INO_ARR_MOUSE_BUF", ""

  offsetVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetVal$, tailVal$, "16"

  recPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, recPtr$, bufArrPtr$, offsetVal$

  mouseX$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, mouseX$ + ", " + recPtr$
  tiraAssign "!G_INO_VAL_MOUSE_X", mouseX$

  mouseY$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseY$ + ", " + recPtr$ + ", 4"
  tiraAssign "!G_INO_VAL_MOUSE_Y", mouseY$

  mouseWheel$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseWheel$ + ", " + recPtr$ + ", 8"
  tiraAssign "!G_INO_VAL_MOUSE_SCRL", mouseWheel$

  mouseBtns$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseBtns$ + ", " + recPtr$ + ", 12"

  b1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b1$, mouseBtns$, "1"
  b1State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b1State$, "0"
  skipB1$ = tiraLabelCreateNew$("MI_SKIPB1")
  tiraJmpCond "JE", b1$, "0", skipB1$
  tiraAssign b1State$, "-1"
  tiraLabel skipB1$
  tiraAssign "!G_INO_VAL_MOUSE_B1", b1State$

  b2$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b2$, mouseBtns$, "2"
  b2State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b2State$, "0"
  skipB2$ = tiraLabelCreateNew$("MI_SKIPB2")
  tiraJmpCond "JE", b2$, "0", skipB2$
  tiraAssign b2State$, "-1"
  tiraLabel skipB2$
  tiraAssign "!G_INO_VAL_MOUSE_B2", b2State$

  b3$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b3$, mouseBtns$, "4"
  b3State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b3State$, "0"
  skipB3$ = tiraLabelCreateNew$("MI_SKIPB3")
  tiraJmpCond "JE", b3$, "0", skipB3$
  tiraAssign b3State$, "-1"
  tiraLabel skipB3$
  tiraAssign "!G_INO_VAL_MOUSE_B3", b3State$

  tiraOp TC_ADD, tailVal$, tailVal$, "1"
  tiraOp TC_AND, tailVal$, tailVal$, "511"
  tiraWriteMem tailPtr$, tailVal$, "4"

  tiraAssign retVal$, "-1"

  tiraLabel emptyLbl$

  tiraNew TC_ABI_WRITE_RET, retVal$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeMouseInput

''''''''''''''''''''''''
SUB emitRuntimePaint

  rtOffset(RT_PAINT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argX$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX$ + ", 1"
  argY$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY$ + ", 2"
  argFillVar$ = tiraDimVar$("ARG3", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argFillVar$ + ", 3"
  argIsStr$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argIsStr$ + ", 4"
  argBorder$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argBorder$ + ", 5"

  doneLbl$ = tiraLabelCreateNew$("PAINT_END")

  tiraOp TC_ADD, argX$, argX$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY$, argY$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  tiraOp TC_AND, argBorder$, argBorder$, "255"

  ' Verify starting bounds are safely within drawing view
  tiraJmpCond "JL", argX$, "!G_GFX_VAL_VIEW_X1", doneLbl$
  tiraJmpCond "JGE", argX$, "!G_GFX_VAL_VIEW_X2", doneLbl$
  tiraJmpCond "JL", argY$, "!G_GFX_VAL_VIEW_Y1", doneLbl$
  tiraJmpCond "JGE", argY$, "!G_GFX_VAL_VIEW_Y2", doneLbl$

  ' Prevent infinite loops for identically matched solid color fills
  skipInitCheck$ = tiraLabelCreateNew$("PAINT_SKIP_INIT")
  tiraJmpCond "JE", argIsStr$, "1", skipInitCheck$

  fillMask$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, fillMask$, argFillVar$, "255"

  offsetStart$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetStart$, argY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offsetStart$, offsetStart$, argX$

  fPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fPtr$, "!G_GFX_PTR_DEST_FRMB", offsetStart$

  fByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, fByte$ + ", " + fPtr$

  tiraJmpCond "JE", fByte$, fillMask$, doneLbl$

  tiraLabel skipInitCheck$

  ' Allocate memory for the recursive stack mapping securely on the temporary heap
  memBlock$ = tiraAllocTempMem$("1500000")
  visitedBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign visitedBase$, memBlock$
  queueBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, queueBase$, memBlock$, "1200000"

  ' Clear visited array to prepare for clean memory tracking
  fbSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, fbSize$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), LTRIM$(RTRIM$(STR$(gfxConfig.SizeY)))
  tiraMemSet visitedBase$, "0", fbSize$

  qHead$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qHead$, "0"
  qTail$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qTail$, "0"

  pushX$ = tiraDimVar$("T", TYPE_LONG)
  pushY$ = tiraDimVar$("T", TYPE_LONG)
  qOffset$ = tiraDimVar$("T", TYPE_LONG)
  qPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraAssign pushX$, argX$
  tiraAssign pushY$, argY$

  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"

  popX$ = tiraDimVar$("T", TYPE_LONG)
  popY$ = tiraDimVar$("T", TYPE_LONG)
  curX$ = tiraDimVar$("T", TYPE_LONG)
  curY$ = tiraDimVar$("T", TYPE_LONG)

  checkX$ = tiraDimVar$("T", TYPE_LONG)
  checkY$ = tiraDimVar$("T", TYPE_LONG)
  isValid$ = tiraDimVar$("T", TYPE_LONG)
  vOffset$ = tiraDimVar$("T", TYPE_LONG)
  vPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  vByte$ = tiraDimVar$("T", TYPE_UBYTE)
  cByte$ = tiraDimVar$("T", TYPE_UBYTE)
  cPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  loopTop$ = tiraLabelCreateNew$("PAINT_LOOP")
  tiraLabel loopTop$

  tiraJmpCond "JE", qHead$, qTail$, doneLbl$

  tiraOp TC_MUL, qOffset$, qTail$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraNew TC_READ_MEM, popX$ + ", " + qPtr$
  tiraNew TC_READ_MEM_OFFSET, popY$ + ", " + qPtr$ + ", 4"
  tiraOp TC_ADD, qTail$, qTail$, "1"

  tiraAssign curX$, popX$
  tiraAssign curY$, popY$

  lblMoveLeft$ = tiraLabelCreateNew$("PAINT_LEFT")
  lblMoveLeftEnd$ = tiraLabelCreateNew$("PAINT_LEFT_END")
  tiraLabel lblMoveLeft$
  tiraOp TC_SUB, curX$, curX$, "1"
  tiraAssign checkX$, curX$
  tiraAssign checkY$, curY$

  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblMoveLeftEnd$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblMoveLeftEnd$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblMoveLeftEnd$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblMoveLeftEnd$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblMoveLeftEnd$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblMoveLeftEnd$
  tiraAssign isValid$, "1"
  tiraJmp lblMoveLeft$
  tiraLabel lblMoveLeftEnd$

  tiraOp TC_ADD, curX$, curX$, "1"

  spanAbove$ = tiraDimVar$("T", TYPE_LONG)
  spanBelow$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign spanAbove$, "0"
  tiraAssign spanBelow$, "0"

  lblScan$ = tiraLabelCreateNew$("PAINT_SCAN")
  lblScanEnd$ = tiraLabelCreateNew$("PAINT_SCAN_END")
  tiraLabel lblScan$
  tiraAssign checkX$, curX$
  tiraAssign checkY$, curY$

  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblScanEnd$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblScanEnd$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblScanEnd$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblScanEnd$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblScanEnd$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblScanEnd$
  tiraAssign isValid$, "1"

  tiraWriteMem vPtr$, "1", "1"

  lblSolid$ = tiraLabelCreateNew$("PAINT_SOLID")
  lblApply$ = tiraLabelCreateNew$("PAINT_APPLY")
  drawColor$ = tiraDimVar$("T", TYPE_LONG)

  tiraJmpCond "JE", argIsStr$, "0", lblSolid$

  strLen$ = tiraGetStringLen$(argFillVar$)
  strData$ = tiraGetStringData$(argFillVar$)
  tiraJmpCond "JLE", strLen$, "0", lblSolid$

  ' SCREEN 13 natively treats tiling string bytes as entire scanline color fills
  patIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MOD, patIdx$, curY$, strLen$

  charPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, charPtr$, strData$, patIdx$

  charByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, charByte$ + ", " + charPtr$
  tiraAssign drawColor$, charByte$

  tiraJmp lblApply$

  tiraLabel lblSolid$
  tiraAssign drawColor$, fillMask$

  tiraLabel lblApply$
  tiraWriteMem cPtr$, drawColor$, "1"

  lblAboveSkip$ = tiraLabelCreateNew$("PAINT_ABOVE_SKIP")
  lblAboveDone$ = tiraLabelCreateNew$("PAINT_ABOVE_DONE")
  tiraOp TC_SUB, checkY$, curY$, "1"
  tiraAssign checkX$, curX$
  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblAboveSkip$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblAboveSkip$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblAboveSkip$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblAboveSkip$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblAboveSkip$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblAboveSkip$
  tiraAssign isValid$, "1"
  tiraJmpCond "JNE", spanAbove$, "0", lblAboveDone$
  tiraAssign pushX$, curX$
  tiraAssign pushY$, checkY$
  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"
  tiraAssign spanAbove$, "1"
  tiraJmp lblAboveDone$

  tiraLabel lblAboveSkip$
  tiraAssign spanAbove$, "0"
  tiraLabel lblAboveDone$

  lblBelowSkip$ = tiraLabelCreateNew$("PAINT_BELOW_SKIP")
  lblBelowDone$ = tiraLabelCreateNew$("PAINT_BELOW_DONE")
  tiraOp TC_ADD, checkY$, curY$, "1"
  tiraAssign checkX$, curX$
  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblBelowSkip$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblBelowSkip$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblBelowSkip$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblBelowSkip$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblBelowSkip$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblBelowSkip$
  tiraAssign isValid$, "1"
  tiraJmpCond "JNE", spanBelow$, "0", lblBelowDone$
  tiraAssign pushX$, curX$
  tiraAssign pushY$, checkY$
  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"
  tiraAssign spanBelow$, "1"
  tiraJmp lblBelowDone$

  tiraLabel lblBelowSkip$
  tiraAssign spanBelow$, "0"
  tiraLabel lblBelowDone$

  tiraOp TC_ADD, curX$, curX$, "1"
  tiraJmp lblScan$
  tiraLabel lblScanEnd$

  tiraJmp loopTop$

  tiraLabel doneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePaint

''''''''''''''''''''''''
SUB emitRuntimeWheel

  rtOffset(RT_WHEEL) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' XInput controllers do not expose wheel inputs
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeWheel

''''''''''''''''''''''''
SUB emitRuntimeClearVars

  rtOffset(RT_CLEAR) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM uIdx AS LONG
  DIM iField AS LONG
  DIM elemSize AS LONG
  DIM totalElems AS LONG
  DIM dataOffset AS LONG
  DIM dataSize AS LONG
  DIM fOffset AS LONG
  DIM baseArr$
  DIM iterVar$
  DIM loopTop$
  DIM loopEnd$
  DIM slotAddr$
  DIM handleVar$
  DIM skipClose$
  DIM firstChar$
  DIM recName$
  DIM arrAddr$
  DIM dataAddr$
  DIM descPtr$
  DIM flagVal$
  DIM flagPtr$
  DIM skipFreeDescLbl$
  DIM dataPtr$
  DIM skipReinitLbl$
  DIM jmpStrDone$
  DIM strLen$
  DIM basePtr$
  DIM descAddr$
  DIM emptyDescPtr$
  DIM skipDescFree$
  DIM secondChar$
  DIM isEngine AS LONG

  ' 1. Close all opened files
  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  iterVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterVar$, "1"

  loopTop$ = tiraLabelCreateNew$("CLEAR_CLOSE_LOOP")
  loopEnd$ = tiraLabelCreateNew$("CLEAR_CLOSE_END")

  tiraLabel loopTop$
  tiraJmpCond "JG", iterVar$, "255", loopEnd$

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, iterVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  skipClose$ = tiraLabelCreateNew$("CLEAR_SKIP_CLOSE")
  tiraJmpCond "JE", handleVar$, "0", skipClose$
  tiraJmpCond "JE", handleVar$, "-1", skipClose$

  tiraCall "IAT_CLOSEHANDLE", 1, handleVar$
  tiraWriteMem slotAddr$, "0", "8"

  tiraLabel skipClose$
  tiraOp TC_ADD, iterVar$, iterVar$, "1"
  tiraJmp loopTop$

  tiraLabel loopEnd$

  ' 2. Clear all global variables and arrays
  IF symbolCount > 0 THEN
    FOR vIdx = 0 TO symbolCount - 1
      dt = symbols(vIdx).DataType
      recName$ = RTRIM$(symbols(vIdx).RecordName)
      firstChar$ = LEFT$(recName$, 1)
      secondChar$ = MID$(recName$, 2, 1)

      isEngine = 0
      IF firstChar$ = "!" THEN
        IF secondChar$ = "G" OR secondChar$ = "T" OR secondChar$ = "R" THEN isEngine = 1
      END IF

      ' Skip internal compiler variables, labels, and subroutines
      IF isEngine = 0 AND firstChar$ <> "@" AND firstChar$ <> "%" AND dt <> TYPE_LABEL AND dt <> TYPE_UNDEFINED AND symbols(vIdx).SubIndex = 0 THEN
        ' Exclude operating system IAT pointers and internal runtime helpers
        IF LEFT$(recName$, 4) <> "IAT_" AND LEFT$(recName$, 3) <> "RT_" THEN
          ' ONLY clear globals!
          IF symbols(vIdx).ScopeID = 0 THEN

            IF symbols(vIdx).IsArray > 0 THEN
              ' Free dynamic string elements and dynamic array blocks
              tiraScheduleArrayFree vIdx

              IF symbols(vIdx).IsArray = 1 THEN
                ' Zero out static array memory securely mapping the physical bounds
                elemSize = retElementByteSize(vIdx)
                totalElems = symbols(vIdx).Size
                dataOffset = 16 + (symbols(vIdx).NumDimensions * 8)
                dataSize = elemSize * totalElems

                arrAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraOp TC_ADDRESS_OF, arrAddr$, "#" + LTRIM$(STR$(vIdx)), ""

                dataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraOp TC_ADD, dataAddr$, arrAddr$, LTRIM$(STR$(dataOffset))

                tiraMemSet dataAddr$, "0", LTRIM$(STR$(dataSize))
              ELSE
                ' For dynamic arrays, clear the array pointer descriptor so it is removed
                arrAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraOp TC_ADDRESS_OF, arrAddr$, "#" + LTRIM$(STR$(vIdx)), ""
                tiraWriteMem arrAddr$, "0", "8"
              END IF

            ELSE
              ' Scalar Variables
              IF dt = TYPE_STRING THEN
                descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraAssign descPtr$, "#" + LTRIM$(STR$(vIdx))

                flagVal$ = tiraDimVar$("T", TYPE_LONG)
                flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraOp TC_ADD, flagPtr$, descPtr$, "16"
                tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

                skipFreeDescLbl$ = tiraLabelCreateNew$("CLR_SKIP_FREE")
                tiraJmpCond "JNE", flagVal$, "1", skipFreeDescLbl$

                dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraNew TC_READ_MEM, dataPtr$ + ", " + descPtr$
                tiraJmpCond "JE", dataPtr$, "0", skipFreeDescLbl$

                tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + dataPtr$

                tiraLabel skipFreeDescLbl$

                ' Re-initialize the descriptor
                skipReinitLbl$ = tiraLabelCreateNew$("CLR_SKIP_REINIT")
                tiraJmpCond "JNE", flagVal$, "1", skipReinitLbl$

                tiraBuildStringDescriptor descPtr$, "0", "0", "0"

                jmpStrDone$ = tiraLabelCreateNew$("CLR_STR_DONE")
                tiraJmp jmpStrDone$

                tiraLabel skipReinitLbl$
                ' It is a fixed string. Memset its data to space (32)
                dataPtr$ = tiraGetStringData$(descPtr$)
                strLen$ = tiraGetStringLen$(descPtr$)
                tiraMemSet dataPtr$, "32", strLen$

                tiraLabel jmpStrDone$

              ELSE
                IF dt = TYPE_UDT THEN
                  uIdx = symbols(vIdx).UDTIndex
                  IF uIdx <> -1 THEN
                    ' Must free dynamic strings within the scalar UDT
                    FOR iField = 0 TO udts(uIdx).FieldCount - 1
                      IF udtFields(uIdx, iField).DataType = TYPE_STRING AND udtFields(uIdx, iField).IsDynamicString = 1 THEN
                        fOffset = udtFields(uIdx, iField).Offset
                        basePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraOp TC_ADDRESS_OF, basePtr$, "#" + LTRIM$(STR$(vIdx)), ""

                        descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        IF fOffset > 0 THEN
                          tiraOp TC_ADD, descAddr$, basePtr$, LTRIM$(STR$(fOffset))
                        ELSE
                          tiraAssign descAddr$, basePtr$
                        END IF

                        descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraNew TC_READ_MEM, descPtr$ + ", " + descAddr$

                        skipFreeDescLbl$ = tiraLabelCreateNew$("CLR_SKIP_UDT_FREE")
                        tiraJmpCond "JE", descPtr$, "0", skipFreeDescLbl$

                        flagVal$ = tiraDimVar$("T", TYPE_LONG)
                        flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraOp TC_ADD, flagPtr$, descPtr$, "16"
                        tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

                        tiraJmpCond "JNE", flagVal$, "1", skipFreeDescLbl$

                        dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraNew TC_READ_MEM, dataPtr$ + ", " + descPtr$

                        tiraJmpCond "JE", dataPtr$, "0", skipFreeDescLbl$
                        tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + dataPtr$

                        tiraLabel skipFreeDescLbl$

                        emptyDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraAssign emptyDescPtr$, "!G_SYS_DSC_EMPTY"
                        skipDescFree$ = tiraLabelCreateNew$("CLR_SKIP_STR_FREE")
                        tiraJmpCond "JE", descPtr$, "0", skipDescFree$
                        tiraJmpCond "JE", descPtr$, emptyDescPtr$, skipDescFree$
                        tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + descPtr$
                        tiraLabel skipDescFree$
                      END IF
                    NEXT

                    ' Zero the UDT memory block
                    basePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                    tiraOp TC_ADDRESS_OF, basePtr$, "#" + LTRIM$(STR$(vIdx)), ""
                    tiraMemSet basePtr$, "0", LTRIM$(STR$(udts(uIdx).TotalSize))
                  END IF

                ELSE
                  ' Numeric scalar variable
                  tiraAssign "#" + LTRIM$(STR$(vIdx)), "0"
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeClearVars

''''''''''''''''''''''''
SUB emitRuntimeCrlf

  rtOffset(RT_CRLF) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  IF compileHasGraphics = 0 THEN
    ' Console mode logic utilizing the rigorous scrolling APIs for VIEW PRINT

    ' Call Windows API to get the standard output handle
    stdOutConst$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign stdOutConst$, "-11"
    tiraCall "IAT_GETSTDHANDLE", 1, stdOutConst$
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, hndVar$

    fallbackLbl$ = tiraLabelCreateNew$("CRLF_FALL")
    manualLbl$ = tiraLabelCreateNew$("CRLF_MAN")
    jmpDone$ = tiraLabelCreateNew$("CRLF_DONE")

    ' Fast bypass check for full screen bounds (no manual scroll computation required)
    tiraJmpCond "JG", "!G_INO_VAL_VIEW_TOP", "0", manualLbl$
    tiraJmpCond "JL", "!G_INO_VAL_VIEW_BOT", "25", manualLbl$
    tiraJmp fallbackLbl$

    tiraLabel manualLbl$

    ' Extract the hardware console cursor row
    csbi$ = tiraAllocTempMem$("24")
    tiraCall "IAT_GETCONSOLESCREENBUFFERINFO", 2, hndVar$ + ", " + csbi$
    coordVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, coordVar$ + ", " + csbi$ + ", 4"
    curY$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SHR, curY$, coordVar$, "16"

    botMinusOne$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, botMinusOne$, "!G_INO_VAL_VIEW_BOT", "1"

    doScrollLbl$ = tiraLabelCreateNew$("CRLF_DOSCROLL")

    ' Check if we hit the limit of the specific viewport
    tiraJmpCond "JGE", curY$, botMinusOne$, doScrollLbl$

    ' No scroll, advance cursor down cleanly
    tiraOp TC_ADD, curY$, curY$, "1"
    destCoord1$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SHL, destCoord1$, curY$, "16"
    tiraCall "IAT_SETCONSOLECURSORPOSITION", 2, hndVar$ + ", " + destCoord1$
    tiraJmp jmpDone$

    tiraLabel doScrollLbl$

    ' Execute localized block scroll
    scrollRect$ = tiraAllocTempMem$("8")
    tiraWriteMem scrollRect$, "0", "2"
    topPlusOne$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, topPlusOne$, "!G_INO_VAL_VIEW_TOP", "1"
    tiraNew TC_WRITE_MEM_OFFSET, scrollRect$ + ", 2, " + topPlusOne$ + ", 2"

    widthVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, widthVar$ + ", " + csbi$
    tiraOp TC_AND, widthVar$, widthVar$, "65535"
    tiraOp TC_SUB, widthVar$, widthVar$, "1"
    tiraNew TC_WRITE_MEM_OFFSET, scrollRect$ + ", 4, " + widthVar$ + ", 2"
    tiraNew TC_WRITE_MEM_OFFSET, scrollRect$ + ", 6, " + botMinusOne$ + ", 2"

    destCoord2$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SHL, destCoord2$, "!G_INO_VAL_VIEW_TOP", "16"

    charInfo$ = tiraAllocTempMem$("4")
    tiraWriteMem charInfo$, "32", "2"
    attrVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, attrVar$ + ", " + csbi$ + ", 8"
    tiraNew TC_WRITE_MEM_OFFSET, charInfo$ + ", 2, " + attrVar$ + ", 2"

    tiraCall "IAT_SCROLLCONSOLESCREENBUFFERA", 5, hndVar$ + ", " + scrollRect$ + ", 0, " + destCoord2$ + ", " + charInfo$

    ' Zero out the bottom row block completely empty
    destCoord3$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SHL, destCoord3$, botMinusOne$, "16"
    numWrtPtr$ = tiraAllocTempMem$("4")

    widthFill$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, widthFill$, widthVar$, "1"

    tiraCall "IAT_FILLCONSOLEOUTPUTCHARACTERA", 5, hndVar$ + ", 32, " + widthFill$ + ", " + destCoord3$ + ", " + numWrtPtr$
    tiraCall "IAT_FILLCONSOLEOUTPUTATTRIBUTE", 5, hndVar$ + ", " + attrVar$ + ", " + widthFill$ + ", " + destCoord3$ + ", " + numWrtPtr$

    tiraCall "IAT_SETCONSOLECURSORPOSITION", 2, hndVar$ + ", " + destCoord3$
    tiraJmp jmpDone$

    tiraLabel fallbackLbl$
    ' Unrestricted hardware newline execution
    descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign descPtr$, "!G_INO_DSC_CRLF"
    strData$ = tiraGetStringData$(descPtr$)
    strLen$ = tiraGetStringLen$(descPtr$)
    numWrtFB$ = tiraDimVar$("T", TYPE_LONG)
    numWrtFBPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtFBPtr$, numWrtFB$, ""
    tiraCall "IAT_WRITEFILE", 5, hndVar$ + ", " + strData$ + ", " + strLen$ + ", " + numWrtFBPtr$ + ", 0"

    tiraLabel jmpDone$
  ELSE
    ' Graphics mode newline logic
    tiraAssign "!G_GFX_VAL_CUR_X", "0"
    tiraOp TC_ADD, "!G_GFX_VAL_CUR_Y", "!G_GFX_VAL_CUR_Y", "8"
  END IF

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeCrlf

''''''''''''''
'' SUB emitRuntimeDevice ' This is found within Z_EMLCMD.BLB
'
' Generates low-level machine instructions required to retrieve an input device description

''''''''''''''
'' SUB emitRuntimeDeviceInput ' This is found within Z_EMLCMD.BLB
'
' Generates low-level machine instructions required to poll connected hardware input events

SUB emitRuntimeDeviceInput

  rtOffset(RT_DEVICEINPUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' For now we will return 0 as a placeholder stub
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  oldValid$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign oldValid$, "!G_INO_FLG_GAMEPAD_VALID"
  oldUser$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign oldUser$, "!G_INO_V32_GAMEPAD_USER"
  oldPacket$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign oldPacket$, "!G_INO_V32_GAMEPAD_PACKET"

  heapMark$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign heapMark$, "!G_MEM_PTR_TEMP_HEAP"

  statePtr$ = tiraAllocTempMem$("52")
  capsPtr$ = tiraAllocTempMem$("404")
  userIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign userIdx$, "0"
  deviceCount$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign deviceCount$, "0"

  loopTop$ = tiraLabelCreateNew$("DEVIN_LOOP")
  loopNext$ = tiraLabelCreateNew$("DEVIN_NEXT")
  xinputDoneLbl$ = tiraLabelCreateNew$("DEVIN_XDONE")
  foundLbl$ = tiraLabelCreateNew$("DEVIN_FOUND")
  changedLbl$ = tiraLabelCreateNew$("DEVIN_CHANGED")
  cacheLbl$ = tiraLabelCreateNew$("DEVIN_CACHE")
  joyLoopTop$ = tiraLabelCreateNew$("DEVIN_JOY_LOOP")
  joyLoopNext$ = tiraLabelCreateNew$("DEVIN_JOY_NEXT")
  joyFoundLbl$ = tiraLabelCreateNew$("DEVIN_JOY_FOUND")
  joyChangedLbl$ = tiraLabelCreateNew$("DEVIN_JOY_CHANGED")
  joyCacheLbl$ = tiraLabelCreateNew$("DEVIN_JOY_CACHE")
  notFoundLbl$ = tiraLabelCreateNew$("DEVIN_NOT_FOUND")
  doneLbl$ = tiraLabelCreateNew$("DEVIN_DONE")

  tiraLabel loopTop$
  tiraJmpCond "JGE", userIdx$, "4", xinputDoneLbl$

  tiraCall "IAT_XINPUTGETSTATE", 2, userIdx$ + ", " + statePtr$
  statusVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", loopNext$

  tiraOp TC_ADD, deviceCount$, deviceCount$, "1"
  tiraJmpCond "JE", deviceCount$, arg1Var$, foundLbl$

  tiraLabel loopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp loopTop$

  tiraLabel xinputDoneLbl$
  tiraJmpCond "JG", deviceCount$, "0", notFoundLbl$

  tiraAssign userIdx$, "0"
  tiraAssign deviceCount$, "0"

  tiraLabel joyLoopTop$
  tiraJmpCond "JGE", userIdx$, "16", notFoundLbl$

  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 0, 52, 4"
  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 4, 1279, 4"
  tiraNew TC_WRITE_MEM_OFFSET, statePtr$ + ", 40, -1, 4"
  tiraCall "IAT_JOYGETPOSEX", 2, userIdx$ + ", " + statePtr$
  tiraNew TC_GET_RET, statusVal$
  tiraJmpCond "JNE", statusVal$, "0", joyLoopNext$

  tiraOp TC_ADD, deviceCount$, deviceCount$, "1"
  tiraJmpCond "JE", deviceCount$, arg1Var$, joyFoundLbl$

  tiraLabel joyLoopNext$
  tiraOp TC_ADD, userIdx$, userIdx$, "1"
  tiraJmp joyLoopTop$

  tiraLabel foundLbl$
  packetVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, packetVal$ + ", " + statePtr$

  tiraJmpCond "JE", oldValid$, "0", changedLbl$
  tiraJmpCond "JNE", oldUser$, userIdx$, changedLbl$
  tiraJmpCond "JNE", oldPacket$, packetVal$, changedLbl$
  tiraJmp cacheLbl$

  tiraLabel changedLbl$
  tiraAssign resVar$, "-1"

  tiraLabel cacheLbl$
  tiraAssign "!G_INO_FLG_GAMEPAD_VALID", "1"
  tiraAssign "!G_INO_V32_GAMEPAD_USER", userIdx$
  tiraAssign "!G_INO_V32_GAMEPAD_PACKET", packetVal$

  buttonsVal$ = tiraDimVar$("T", TYPE_UINTEGER)
  tiraNew TC_READ_MEM_OFFSET, buttonsVal$ + ", " + statePtr$ + ", 4"
  tiraAssign "!G_INO_V32_GAMEPAD_BUTTONS", buttonsVal$

  leftTrigger$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM_OFFSET, leftTrigger$ + ", " + statePtr$ + ", 6"
  tiraAssign "!G_INO_V32_GAMEPAD_LT", leftTrigger$

  rightTrigger$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM_OFFSET, rightTrigger$ + ", " + statePtr$ + ", 7"
  tiraAssign "!G_INO_V32_GAMEPAD_RT", rightTrigger$

  leftX$ = tiraDimVar$("T", TYPE_INTEGER)
  tiraNew TC_READ_MEM_OFFSET, leftX$ + ", " + statePtr$ + ", 8"
  tiraAssign "!G_INO_V32_GAMEPAD_LX", leftX$

  leftY$ = tiraDimVar$("T", TYPE_INTEGER)
  tiraNew TC_READ_MEM_OFFSET, leftY$ + ", " + statePtr$ + ", 10"
  tiraAssign "!G_INO_V32_GAMEPAD_LY", leftY$

  rightX$ = tiraDimVar$("T", TYPE_INTEGER)
  tiraNew TC_READ_MEM_OFFSET, rightX$ + ", " + statePtr$ + ", 12"
  tiraAssign "!G_INO_V32_GAMEPAD_RX", rightX$

  rightY$ = tiraDimVar$("T", TYPE_INTEGER)
  tiraNew TC_READ_MEM_OFFSET, rightY$ + ", " + statePtr$ + ", 14"
  tiraAssign "!G_INO_V32_GAMEPAD_RY", rightY$
  tiraJmp doneLbl$

  tiraLabel joyFoundLbl$
  tiraMemSet capsPtr$, "0", "404"
  tiraCall "IAT_JOYGETDEVCAPSA", 3, userIdx$ + ", " + capsPtr$ + ", 404"
  capsStatus$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, capsStatus$

  joyCaps$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign joyCaps$, "0"

  joyCapsDoneLbl$ = tiraLabelCreateNew$("DEVIN_JOY_CAPS_DONE")
  tiraJmpCond "JNE", capsStatus$, "0", joyCapsDoneLbl$
  tiraNew TC_READ_MEM_OFFSET, joyCaps$ + ", " + capsPtr$ + ", 96"
  tiraLabel joyCapsDoneLbl$

  rawX$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rawX$ + ", " + statePtr$ + ", 8"

  rawY$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rawY$ + ", " + statePtr$ + ", 12"

  rawZ$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rawZ$ + ", " + statePtr$ + ", 16"

  rawR$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rawR$ + ", " + statePtr$ + ", 20"

  rawButtons$ = tiraDimVar$("T", TYPE_ULONG)
  tiraNew TC_READ_MEM_OFFSET, rawButtons$ + ", " + statePtr$ + ", 32"

  povVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, povVal$ + ", " + statePtr$ + ", 40"

  leftX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, leftX$, rawX$, "32768"

  leftY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, leftY$, "32768", rawY$

  rightX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, rightX$, rawZ$, "32768"

  rightY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, rightY$, "32768", rawR$

  povDoneLbl$ = tiraLabelCreateNew$("DEVIN_POV_DONE")
  povUpLbl$ = tiraLabelCreateNew$("DEVIN_POV_UP")
  povUpDoneLbl$ = tiraLabelCreateNew$("DEVIN_POV_UP_DONE")
  povRightDoneLbl$ = tiraLabelCreateNew$("DEVIN_POV_RIGHT_DONE")
  povDownDoneLbl$ = tiraLabelCreateNew$("DEVIN_POV_DOWN_DONE")
  povLeftDoneLbl$ = tiraLabelCreateNew$("DEVIN_POV_LEFT_DONE")

  povAvailable$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, povAvailable$, joyCaps$, "16"
  tiraJmpCond "JE", povAvailable$, "0", povDoneLbl$

  tiraJmpCond "JE", povVal$, "-1", povDoneLbl$
  tiraJmpCond "JE", povVal$, "65535", povDoneLbl$

  tiraAssign leftX$, "0"
  tiraAssign leftY$, "0"

  tiraJmpCond "JLE", povVal$, "4500", povUpLbl$
  tiraJmpCond "JGE", povVal$, "31500", povUpLbl$
  tiraJmp povUpDoneLbl$

  tiraLabel povUpLbl$
  tiraAssign leftY$, "32767"

  tiraLabel povUpDoneLbl$
  tiraJmpCond "JL", povVal$, "4500", povRightDoneLbl$
  tiraJmpCond "JG", povVal$, "13500", povRightDoneLbl$
  tiraAssign leftX$, "32767"

  tiraLabel povRightDoneLbl$
  tiraJmpCond "JL", povVal$, "13500", povDownDoneLbl$
  tiraJmpCond "JG", povVal$, "22500", povDownDoneLbl$
  tiraAssign leftY$, "-32768"

  tiraLabel povDownDoneLbl$
  tiraJmpCond "JL", povVal$, "22500", povLeftDoneLbl$
  tiraJmpCond "JG", povVal$, "31500", povLeftDoneLbl$
  tiraAssign leftX$, "-32768"

  tiraLabel povLeftDoneLbl$
  tiraLabel povDoneLbl$

  buttonsVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign buttonsVal$, "0"
  buttonTest$ = tiraDimVar$("T", TYPE_LONG)

  button1DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN1_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "1"
  tiraJmpCond "JE", buttonTest$, "0", button1DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "16384"
  tiraLabel button1DoneLbl$

  button2DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN2_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "2"
  tiraJmpCond "JE", buttonTest$, "0", button2DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "8192"
  tiraLabel button2DoneLbl$

  button3DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN3_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "4"
  tiraJmpCond "JE", buttonTest$, "0", button3DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "4096"
  tiraLabel button3DoneLbl$

  button4DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN4_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "8"
  tiraJmpCond "JE", buttonTest$, "0", button4DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "32768"
  tiraLabel button4DoneLbl$

  button5DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN5_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "16"
  tiraJmpCond "JE", buttonTest$, "0", button5DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "256"
  tiraLabel button5DoneLbl$

  button6DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN6_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "32"
  tiraJmpCond "JE", buttonTest$, "0", button6DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "512"
  tiraLabel button6DoneLbl$

  button9DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN9_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "256"
  tiraJmpCond "JE", buttonTest$, "0", button9DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "32"
  tiraLabel button9DoneLbl$

  button10DoneLbl$ = tiraLabelCreateNew$("DEVIN_BTN10_DONE")
  tiraOp TC_AND, buttonTest$, rawButtons$, "512"
  tiraJmpCond "JE", buttonTest$, "0", button10DoneLbl$
  tiraOp TC_OR, buttonsVal$, buttonsVal$, "16"
  tiraLabel button10DoneLbl$

  packetVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign packetVal$, buttonsVal$
  tiraOp TC_MUL, packetVal$, packetVal$, "31"
  tiraOp TC_ADD, packetVal$, packetVal$, leftX$
  tiraOp TC_MUL, packetVal$, packetVal$, "31"
  tiraOp TC_ADD, packetVal$, packetVal$, leftY$
  tiraOp TC_MUL, packetVal$, packetVal$, "31"
  tiraOp TC_ADD, packetVal$, packetVal$, rightX$
  tiraOp TC_MUL, packetVal$, packetVal$, "31"
  tiraOp TC_ADD, packetVal$, packetVal$, rightY$
  tiraOp TC_MUL, packetVal$, packetVal$, "31"
  tiraOp TC_ADD, packetVal$, packetVal$, povVal$

  joyUser$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, joyUser$, userIdx$, "16"

  tiraJmpCond "JE", oldValid$, "0", joyChangedLbl$
  tiraJmpCond "JNE", oldUser$, joyUser$, joyChangedLbl$
  tiraJmpCond "JNE", oldPacket$, packetVal$, joyChangedLbl$
  tiraJmp joyCacheLbl$

  tiraLabel joyChangedLbl$
  tiraAssign resVar$, "-1"

  tiraLabel joyCacheLbl$
  tiraAssign "!G_INO_FLG_GAMEPAD_VALID", "1"
  tiraAssign "!G_INO_V32_GAMEPAD_USER", joyUser$
  tiraAssign "!G_INO_V32_GAMEPAD_PACKET", packetVal$
  tiraAssign "!G_INO_V32_GAMEPAD_BUTTONS", buttonsVal$
  tiraAssign "!G_INO_V32_GAMEPAD_LT", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_RT", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_LX", leftX$
  tiraAssign "!G_INO_V32_GAMEPAD_LY", leftY$
  tiraAssign "!G_INO_V32_GAMEPAD_RX", rightX$
  tiraAssign "!G_INO_V32_GAMEPAD_RY", rightY$
  tiraJmp doneLbl$

  tiraLabel notFoundLbl$
  tiraAssign "!G_INO_FLG_GAMEPAD_VALID", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_USER", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_PACKET", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_BUTTONS", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_LT", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_RT", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_LX", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_LY", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_RX", "0"
  tiraAssign "!G_INO_V32_GAMEPAD_RY", "0"

  tiraLabel doneLbl$
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", heapMark$
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeDeviceInput


''''''''''''''
'' SUB emitRuntimeDevices ' This is found within Z_EMLCMD.BLB
'
' Generates low-level machine instructions required to count connected input devices

''''''''''''''''''''''''
SUB emitRuntimeFullscreen

  rtOffset(RT_FULLSCREEN) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  ' GetSystemMetrics(SM_CXSCREEN = 0)
  tiraCall "IAT_GETSYSTEMMETRICS", 1, "0"
  tiraNew TC_GET_RET, "!G_WND_VAL_WIDTH"

  ' GetSystemMetrics(SM_CYSCREEN = 1)
  tiraCall "IAT_GETSYSTEMMETRICS", 1, "1"
  tiraNew TC_GET_RET, "!G_WND_VAL_HEIGHT"

  ' SetWindowLongA(HWND, GWL_STYLE = -16, WS_POPUP | WS_VISIBLE = -1879048192)
  tiraCall "IAT_SETWINDOWLONGA", 3, "!G_WND_VAL_HWND, -16, -1879048192"

  ' SetWindowPos(HWND, HWND_TOP = 0, 0, 0, cx, cy, SWP_SHOWWINDOW | SWP_FRAMECHANGED = 96)
  tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, 0, 0, 0, !G_WND_VAL_WIDTH, !G_WND_VAL_HEIGHT, 96"

  tiraAssign "!G_GFX_VAL_IS_FULLSCREEN", "1"

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeFullscreen

''''''''''''''''''''''''
SUB emitRuntimeInput

  rtOffset(RT_INPUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  ' Capture incoming ABI hardware registers into TIRA accessible global memory slots
  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"
  arg2Var$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"
  arg3Var$ = tiraDimVar$("ARG3", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg3Var$ + ", 3"
  arg4Var$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg4Var$ + ", 4"
  arg5Var$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg5Var$ + ", 5"

  ' Cache the arguments securely to survive nested runtime calls which will clobber the !G_SYS_RT_ARG slots
  targetAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign targetAddrVar$, arg1Var$

  isStrVarVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign isStrVarVar$, arg2Var$

  promptPtrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign promptPtrVar$, arg3Var$

  tgtDataTypeVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign tgtDataTypeVar$, arg4Var$

  suppressNewlineVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign suppressNewlineVar$, arg5Var$

  ' Allocate a pristine 1024 byte buffer directly on the temporary heap
  bufPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign bufPtr$, "!G_MEM_PTR_TEMP_HEAP"
  tiraOp TC_SUB, bufPtr$, bufPtr$, "1024"
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", bufPtr$

  bufLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign bufLen$, "0"

  IF compileHasGraphics = 0 THEN
    ' Console mode logic
    tiraCall "RT_PRINT_STR", 1, promptPtrVar$

    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraCall "IAT_GETSTDHANDLE", 1, "-10"
    tiraNew TC_GET_RET, hndVar$

    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, bufLen$, ""

    tiraCall "IAT_READFILE", 5, hndVar$ + ", " + bufPtr$ + ", 1024, " + numWrtPtr$ + ", 0"
  ELSE
    ' Graphics mode delta rendering logic
    promptData$ = tiraGetStringData$(promptPtrVar$)
    promptLen$ = tiraGetStringLen$(promptPtrVar$)

    ' Print the prompt string directly to the screen immediately
    skipPromptLbl$ = tiraLabelCreateNew$("INP_SKIP_PRMPT")
    tiraJmpCond "JLE", promptLen$, "0", skipPromptLbl$
    tiraCall "RT_GFX_APPEND", 2, promptData$ + ", " + promptLen$
    tiraLabel skipPromptLbl$

    ' Unconditionally flush the screen buffer before blocking execution so prior PRINT statements are visible
    tiraCall "RT_SWAP_BUFFERS", 0, ""

    ' Fetch pointer structures for reading directly from the OS queue
    headPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, headPtr$, "!G_INO_VAL_KBD_HEAD", ""
    tailPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, tailPtr$, "!G_INO_VAL_KBD_TAIL", ""

    ' Spinlock: wait for ENTER to be released BEFORE capturing input to prevent skipping
    lblWaitEnterRel1$ = tiraLabelCreateNew$("INP_WAIT_REL1")
    tiraLabel lblWaitEnterRel1$
    tiraCall "IAT_GETASYNCKEYSTATE", 1, "13"
    entState1$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_GET_RET, entState1$
    tiraOp TC_AND, entState1$, entState1$, "32768"
    skipSleep1$ = tiraLabelCreateNew$("INP_SS1")
    tiraJmpCond "JE", entState1$, "0", skipSleep1$
    tiraCall "IAT_SLEEP", 1, "1"
    tiraJmp lblWaitEnterRel1$
    tiraLabel skipSleep1$

    ' Flush the OS keyboard ring buffer to clear ghost type-ahead keys completely
    flushHeadVal$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, flushHeadVal$ + ", " + headPtr$
    tiraWriteMem tailPtr$, flushHeadVal$, "4"

    ' Ultra-fast spin loop (No IAT_SLEEP latency penalty for responsive typing)
    loopTop$ = tiraLabelCreateNew$("INP_LOOP")
    tiraLabel loopTop$

    headVal$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, headVal$ + ", " + headPtr$

    tailVal$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, tailVal$ + ", " + tailPtr$

    tiraJmpCond "JE", headVal$, tailVal$, loopTop$

    ' Read Char from the tail
    charBufPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, charBufPtr$, "!G_INO_ARR_KBD_BUF", ""

    charAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, charAddr$, charBufPtr$, tailVal$

    charByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, charByte$ + ", " + charAddr$

    charVal$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign charVal$, charByte$

    ' Advance Tail
    tiraOp TC_ADD, tailVal$, tailVal$, "1"
    tiraOp TC_AND, tailVal$, tailVal$, "255"
    tiraWriteMem tailPtr$, tailVal$, "4"

    doneLbl$ = tiraLabelCreateNew$("INP_DONE")
    tiraJmpCond "JE", charVal$, "13", doneLbl$ ' Enter key finishes the routine

    notBsLbl$ = tiraLabelCreateNew$("INP_NOT_BS")
    tiraJmpCond "JNE", charVal$, "8", notBsLbl$ ' Backspace key

    ' Backspace logic
    skipBsLbl$ = tiraLabelCreateNew$("INP_SKIP_BS")
    tiraJmpCond "JLE", bufLen$, "0", skipBsLbl$
    tiraOp TC_SUB, bufLen$, bufLen$, "1"

    ' Step cursor backward by one character width (8 pixels)
    tiraOp TC_SUB, "!G_GFX_VAL_CUR_X", "!G_GFX_VAL_CUR_X", "8"
    skipWrapLbl$ = tiraLabelCreateNew$("INP_SKIP_WRAP")
    tiraJmpCond "JGE", "!G_GFX_VAL_CUR_X", "0", skipWrapLbl$
    wrapX$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign wrapX$, LTRIM$(STR$(gfxConfig.SizeX))
    tiraOp TC_SUB, "!G_GFX_VAL_CUR_X", wrapX$, "8"
    tiraOp TC_SUB, "!G_GFX_VAL_CUR_Y", "!G_GFX_VAL_CUR_Y", "8"
    tiraLabel skipWrapLbl$

    ' Save Cursor
    tempX$ = tiraDimVar$("T", TYPE_LONG)
    tempY$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign tempX$, "!G_GFX_VAL_CUR_X"
    tiraAssign tempY$, "!G_GFX_VAL_CUR_Y"

    ' Erase with Space
    spaceAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, spaceAddr$, bufPtr$, bufLen$
    tiraWriteMem spaceAddr$, "32", "1"
    tiraCall "RT_GFX_APPEND", 2, spaceAddr$ + ", 1"

    ' Restore Cursor
    tiraAssign "!G_GFX_VAL_CUR_X", tempX$
    tiraAssign "!G_GFX_VAL_CUR_Y", tempY$

    tiraCall "RT_SWAP_BUFFERS", 0, ""

    tiraLabel skipBsLbl$
    tiraJmp loopTop$

    ' Printable char logic
    tiraLabel notBsLbl$

    ' Only append if printable ASCII (32 to 126)
    skipKey$ = tiraLabelCreateNew$("INP_SKIP")
    tiraJmpCond "JL", charVal$, "32", skipKey$
    tiraJmpCond "JG", charVal$, "126", skipKey$

    destCharAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, destCharAddr$, bufPtr$, bufLen$
    tiraWriteMem destCharAddr$, charVal$, "1"
    tiraOp TC_ADD, bufLen$, bufLen$, "1"

    ' Delta Render: Append the single new character directly to the screen
    tiraCall "RT_GFX_APPEND", 2, destCharAddr$ + ", 1"
    tiraCall "RT_SWAP_BUFFERS", 0, ""

    tiraLabel skipKey$
    tiraJmp loopTop$

    tiraLabel doneLbl$

    ' Spinlock: wait for ENTER to be released after submitting input
    lblWaitEnterRel2$ = tiraLabelCreateNew$("INP_WAIT_REL2")
    tiraLabel lblWaitEnterRel2$
    tiraCall "IAT_GETASYNCKEYSTATE", 1, "13"
    entState2$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_GET_RET, entState2$
    tiraOp TC_AND, entState2$, entState2$, "32768"
    skipSleep2$ = tiraLabelCreateNew$("INP_SS2")
    tiraJmpCond "JE", entState2$, "0", skipSleep2$
    tiraCall "IAT_SLEEP", 1, "1"
    tiraJmp lblWaitEnterRel2$
    tiraLabel skipSleep2$

    skipCrlfLbl$ = tiraLabelCreateNew$("INP_SKIP_CRLF")
    tiraJmpCond "JNE", suppressNewlineVar$, "0", skipCrlfLbl$
    tiraCall "RT_CRLF", 0, ""
    tiraLabel skipCrlfLbl$
  END IF

  endInputLbl$ = tiraLabelCreateNew$("INP_END")
  notStrLbl$ = tiraLabelCreateNew$("INP_NOT_STR")

  tiraJmpCond "JE", isStrVarVar$, "0", notStrLbl$

  ' Handle string variable assignment
  stripLoop$ = tiraLabelCreateNew$("INP_STRIP")
  stripDone$ = tiraLabelCreateNew$("INP_STRIP_DONE")

  tiraLabel stripLoop$
  tiraJmpCond "JLE", bufLen$, "0", stripDone$

  lastCharAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, lastCharAddr$, bufPtr$, bufLen$
  tiraOp TC_SUB, lastCharAddr$, lastCharAddr$, "1"
  lastChar$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, lastChar$ + ", " + lastCharAddr$

  isCrLfLbl$ = tiraLabelCreateNew$("INP_ISCRLF")
  tiraJmpCond "JE", lastChar$, "13", isCrLfLbl$
  tiraJmpCond "JNE", lastChar$, "10", stripDone$

  tiraLabel isCrLfLbl$
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp stripLoop$
  tiraLabel stripDone$

  ' Build a 24-byte fake descriptor dynamically
  rhsDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign rhsDesc$, "!G_MEM_PTR_TEMP_HEAP"
  tiraOp TC_SUB, rhsDesc$, rhsDesc$, "24"
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", rhsDesc$

  tiraBuildStringDescriptor rhsDesc$, bufPtr$, bufLen$, "0"

  tiraCall "RT_STR_ASSIGN", 2, targetAddrVar$ + ", " + rhsDesc$
  tiraJmp endInputLbl$

  ' Handle numeric variable assignment
  tiraLabel notStrLbl$

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"
  isNeg$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign isNeg$, "0"

  skipLoop$ = tiraLabelCreateNew$("INP_NSKIP")
  skipDone$ = tiraLabelCreateNew$("INP_NSKIP_DN")

  tiraLabel skipLoop$
  tiraJmpCond "JLE", bufLen$, "0", skipDone$
  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  isSpcLbl$ = tiraLabelCreateNew$("INP_ISSPC")
  tiraJmpCond "JE", byteVal$, "32", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "13", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "10", isSpcLbl$
  tiraJmp skipDone$

  tiraLabel isSpcLbl$
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp skipLoop$

  tiraLabel skipDone$

  signDone$ = tiraLabelCreateNew$("VAL_SGN_DONE")
  tiraJmpCond "JLE", bufLen$, "0", signDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$
  tiraJmpCond "JNE", byteVal$, "45", signDone$ ' -
  tiraAssign isNeg$, "1"
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"

  tiraLabel signDone$

  numLoopTop$ = tiraLabelCreateNew$("VAL_NUM_LOOP")
  numLoopDone$ = tiraLabelCreateNew$("VAL_NUM_DONE")

  tiraLabel numLoopTop$
  tiraJmpCond "JLE", bufLen$, "0", numLoopDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  tiraJmpCond "JL", byteVal$, "48", numLoopDone$ ' 0
  tiraJmpCond "JG", byteVal$, "57", numLoopDone$ ' 9

  tiraOp TC_SUB, byteVal$, byteVal$, "48"
  tiraOp TC_MUL, resVar$, resVar$, "10"
  tiraOp TC_ADD, resVar$, resVar$, byteVal$

  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp numLoopTop$

  tiraLabel numLoopDone$

  applySignDone$ = tiraLabelCreateNew$("VAL_SGN_APP")
  tiraJmpCond "JE", isNeg$, "0", applySignDone$
  tiraOp TC_NEG, resVar$, resVar$, ""
  tiraLabel applySignDone$

  lblSingle$ = tiraLabelCreateNew$("IS_SNG")
  lblDouble$ = tiraLabelCreateNew$("IS_DBL")
  lblByte$ = tiraLabelCreateNew$("IS_BYT")
  lblInt$ = tiraLabelCreateNew$("IS_INT")
  lblLong$ = tiraLabelCreateNew$("IS_LNG")
  lblWriteDone$ = tiraLabelCreateNew$("WR_DONE")

  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_SINGLE)), lblSingle$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_DOUBLE)), lblDouble$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_BYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UBYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_INTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UINTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_LONG)), lblLong$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_ULONG)), lblLong$

  tiraWriteMem targetAddrVar$, resVar$, "8"
  tiraJmp lblWriteDone$

  tiraLabel lblSingle$
  tiraWriteMem targetAddrVar$, resVar$, "SINGLE"
  tiraJmp lblWriteDone$

  tiraLabel lblDouble$
  tiraWriteMem targetAddrVar$, resVar$, "DOUBLE"
  tiraJmp lblWriteDone$

  tiraLabel lblByte$
  tiraWriteMem targetAddrVar$, resVar$, "1"
  tiraJmp lblWriteDone$

  tiraLabel lblInt$
  tiraWriteMem targetAddrVar$, resVar$, "2"
  tiraJmp lblWriteDone$

  tiraLabel lblLong$
  tiraWriteMem targetAddrVar$, resVar$, "4"

  tiraLabel lblWriteDone$

  tiraLabel endInputLbl$

  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeInput

''''''''''''''''''''''''
SUB emitRuntimeKeyDown

  DIM qb AS LONG
  DIM vk AS LONG

  ' Build the key mapping data as a string payload to sit in the global literal pool
  mapPayload$ = ""
  FOR ii = 0 TO keyMappingCount - 1
    ' Append qbCode (4 bytes)
    qb = keyMapping(ii).qbCode
    mapPayload$ = mapPayload$ + CHR$(qb AND 255) + CHR$((qb \ 256) AND 255) + CHR$((qb \ 65536) AND 255) + CHR$((qb \ 16777216) AND 255)
    ' Append vkCode (4 bytes)
    vk = keyMapping(ii).vkCode
    mapPayload$ = mapPayload$ + CHR$(vk AND 255) + CHR$((vk \ 256) AND 255) + CHR$((vk \ 65536) AND 255) + CHR$((vk \ 16777216) AND 255)
  NEXT

  ff = resolveSymbol("!G_INO_DSC_KEYMAP")
  IF ff = 1 THEN
    mapIdx = returnedData2
    strVarData$(mapIdx) = mapPayload$
  END IF

  '''' RT_KEYDOWN
  rtOffset(RT_KEYDOWN) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' Load the requested key code
  qbCode$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qbCode$, arg1Var$

  ' Extract the data pointer from the string descriptor
  tableDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign tableDesc$, "!G_INO_DSC_KEYMAP"
  tablePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, tablePtr$ + ", " + tableDesc$

  ' Counter for mapped items
  count$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign count$, LTRIM$(STR$(keyMappingCount))

  vkCode$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign vkCode$, qbCode$

  loopScanStart$ = tiraLabelCreateNew$("KD_SCAN_LOOP")
  jmpDoneScan$ = tiraLabelCreateNew$("KD_SCAN_DONE")

  tiraLabel loopScanStart$

  ' If mapped items remain <= 0, we're done (not found in table)
  tiraJmpCond "JLE", count$, "0", jmpDoneScan$

  ' Compare table[index].qbCode with the requested code
  curQb$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, curQb$ + ", " + tablePtr$

  jmpFound$ = tiraLabelCreateNew$("KD_FOUND")
  tiraJmpCond "JE", curQb$, qbCode$, jmpFound$

  ' Advance to next 8-byte entry (qbCode + vkCode layout)
  tiraOp TC_ADD, tablePtr$, tablePtr$, "8"
  tiraOp TC_SUB, count$, count$, "1"
  tiraJmp loopScanStart$

  ' Match found, extract table[index].vkCode
  tiraLabel jmpFound$
  vkPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, vkPtr$, tablePtr$, "4"
  tiraNew TC_READ_MEM, vkCode$ + ", " + vkPtr$

  tiraLabel jmpDoneScan$

  ' Setup layout state extraction directly from the WndProc populated array
  tiraOp TC_AND, vkCode$, vkCode$, "255"

  stateAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateAddr$, "!G_INO_ARR_KBD_STATE", ""
  tiraOp TC_ADD, stateAddr$, stateAddr$, vkCode$

  keyByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, keyByte$ + ", " + stateAddr$

  keyState$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign keyState$, keyByte$

  retVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign retVal$, "0"

  jmpIsDown$ = tiraLabelCreateNew$("KD_IS_DOWN")
  tiraJmpCond "JNE", keyState$, "0", jmpIsDown$

  ' Not down (return 0)
  jmpEnd$ = tiraLabelCreateNew$("KD_END")
  tiraJmp jmpEnd$

  tiraLabel jmpIsDown$
  ' Is down (return -1)
  tiraAssign retVal$, "-1"

  tiraLabel jmpEnd$

  ' Route return value to arg1Var$ so it can be extracted to RAX cleanly
  tiraAssign arg1Var$, retVal$

  tiraNew TC_ABI_WRITE_RET, arg1Var$
  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeKeyDown

''''''''''''''''''''''''
SUB emitRuntimeLimit

  rtOffset(RT_LIMIT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_DOUBLE)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  fpsInt$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_CAST, fpsInt$, arg1Var$, LTRIM$(STR$(TYPE_LONG))

  doneLbl$ = tiraLabelCreateNew$("LIM_DONE")
  tiraJmpCond "JLE", fpsInt$, "0", doneLbl$

  msPerFrame$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_IDIV, msPerFrame$, "1000", fpsInt$

  loopTop$ = tiraLabelCreateNew$("LIM_TOP")
  tiraLabel loopTop$

  tiraCall "IAT_GETTICKCOUNT", 0, ""
  curTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, curTick$

  diffTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, diffTick$, curTick$, "!G_SYS_VAL_LIMIT_TICK"

  tiraJmpCond "JGE", diffTick$, msPerFrame$, doneLbl$

  tiraCall "IAT_SLEEP", 1, "1"
  tiraJmp loopTop$

  tiraLabel doneLbl$
  tiraCall "IAT_GETTICKCOUNT", 0, ""
  newTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, newTick$
  tiraAssign "!G_SYS_VAL_LIMIT_TICK", newTick$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeLimit

''''''''''''''''''''''''
SUB emitRuntimePcopy

  rtOffset(RT_PCOPY) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argSrc$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argSrc$ + ", 1"
  argDest$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argDest$ + ", 2"

  lblDone$ = tiraLabelCreateNew$("PCOPY_DONE")

  ' Skip if src equals dest
  tiraJmpCond "JE", argSrc$, argDest$, lblDone$

  ' Validate pages (0 to 3 natively supported)
  tiraJmpCond "JL", argSrc$, "0", lblDone$
  tiraJmpCond "JG", argSrc$, "3", lblDone$
  tiraJmpCond "JL", argDest$, "0", lblDone$
  tiraJmpCond "JG", argDest$, "3", lblDone$

  ' Acquire Spinlock safely using hardware XCHG
  lblSpin$ = tiraLabelCreateNew$("PCOPY_SPIN")
  lblAcq$ = tiraLabelCreateNew$("PCOPY_ACQ")
  tiraLabel lblSpin$
  spinVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign spinVal$, "1"
  tiraNew TC_XCHG, "!G_WND_FLG_RENDER_LOCK, " + spinVal$ + ", 4"
  tiraJmpCond "JE", spinVal$, "0", lblAcq$
  tiraCall "IAT_SLEEP", 1, "0"
  tiraJmp lblSpin$
  tiraLabel lblAcq$

  fbSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign fbSize$, LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

  txtSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign txtSize$, LTRIM$(STR$(4096 * layout.GfxBufEntrySize))

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  ptrSrcFb$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptrSrcBuf$ = tiraDimVar$("T", TYPE_INTEGER64)
  cntSrcBuf$ = tiraDimVar$("T", TYPE_LONG)

  tiraJmpCond "JE", argSrc$, "0", lblSrc0$
  tiraJmpCond "JE", argSrc$, "1", lblSrc1$
  tiraJmpCond "JE", argSrc$, "2", lblSrc2$
  tiraJmpCond "JE", argSrc$, "3", lblSrc3$
  tiraJmp lblDone$

  tiraLabel lblSrc0$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_BACK"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_BACK"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_FRONT"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_FRONT"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_FRONT"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_PAGE2"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_PAGE2"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_PAGE3"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_PAGE3"

  tiraLabel lblSrcEnd$

  lblDest0$ = tiraLabelCreateNew$("DEST_0")
  lblDest1$ = tiraLabelCreateNew$("DEST_1")
  lblDest2$ = tiraLabelCreateNew$("DEST_2")
  lblDest3$ = tiraLabelCreateNew$("DEST_3")
  lblDestEnd$ = tiraLabelCreateNew$("DEST_END")

  ptrDestFb$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptrDestBuf$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argDest$, "0", lblDest0$
  tiraJmpCond "JE", argDest$, "1", lblDest1$
  tiraJmpCond "JE", argDest$, "2", lblDest2$
  tiraJmpCond "JE", argDest$, "3", lblDest3$
  tiraJmp lblDone$

  tiraLabel lblDest0$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_BACK"
  tiraJmp lblDestEnd$

  tiraLabel lblDest1$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_FRONT"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_FRONT"
  tiraJmp lblDestEnd$

  tiraLabel lblDest2$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_PAGE2"
  tiraJmp lblDestEnd$

  tiraLabel lblDest3$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_PAGE3"

  tiraLabel lblDestEnd$

  tiraMemcpy ptrDestFb$, ptrSrcFb$, fbSize$
  tiraMemcpy ptrDestBuf$, ptrSrcBuf$, txtSize$

  lblWrite0$ = tiraLabelCreateNew$("WR_0")
  lblWrite1$ = tiraLabelCreateNew$("WR_1")
  lblWrite2$ = tiraLabelCreateNew$("WR_2")
  lblWrite3$ = tiraLabelCreateNew$("WR_3")
  lblWriteEnd$ = tiraLabelCreateNew$("WR_END")

  tiraJmpCond "JE", argDest$, "0", lblWrite0$
  tiraJmpCond "JE", argDest$, "1", lblWrite1$
  tiraJmpCond "JE", argDest$, "2", lblWrite2$
  tiraJmpCond "JE", argDest$, "3", lblWrite3$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite0$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_BACK", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite1$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite2$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE2", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite3$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE3", cntSrcBuf$

  tiraLabel lblWriteEnd$

  ' Release Spinlock
  tiraAssign "!G_WND_FLG_RENDER_LOCK", "0"

  ' Instruct Windows to repaint the window using the newly swapped destination buffer ONLY if it is the active visual frame (Page 1 / FRONT)
  lblSkipRedraw$ = tiraLabelCreateNew$("SKIP_REDRAW")
  tiraJmpCond "JNE", argDest$, "1", lblSkipRedraw$
  tiraCall "IAT_INVALIDATERECT", 3, "!G_WND_VAL_HWND, 0, 0"
  tiraLabel lblSkipRedraw$

  tiraLabel lblDone$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePcopy

''''''''''''''''''''''''
SUB emitRuntimePlotPixel

  '''' RT_PLOT_PIXEL
  rtOffset(RT_PLOT_PIXEL) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"
  arg2Var$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"
  arg3Var$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg3Var$ + ", 3"

  endLbl$ = tiraLabelCreateNew$("PLOT_END")

  ' Shift target coordinates into absolute mapped variables utilizing global offsets
  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, arg1Var$, "!G_GFX_VAL_VIEW_OFFSET_X"
  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, arg2Var$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ' Execute strict bounds testing securely trapping plotting within graphical VIEW logic
  tiraJmpCond "JL", absX$, "!G_GFX_VAL_VIEW_X1", endLbl$
  tiraJmpCond "JGE", absX$, "!G_GFX_VAL_VIEW_X2", endLbl$
  tiraJmpCond "JL", absY$, "!G_GFX_VAL_VIEW_Y1", endLbl$
  tiraJmpCond "JGE", absY$, "!G_GFX_VAL_VIEW_Y2", endLbl$

  ' Unsigned JAE hardware test to physically prevent screen buffer overrun exceptions
  tiraJmpCond "JAE", absX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), endLbl$
  tiraJmpCond "JAE", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), endLbl$

  ' Calculate offset targeting the working screen buffer
  tiraOp TC_MUL, "!G_GFX_IDX_PLOT_OFFSET", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, "!G_GFX_IDX_PLOT_OFFSET", "!G_GFX_IDX_PLOT_OFFSET", absX$

  ' Fetch framebuffer base pointer dynamically through the targeted active destination memory
  tiraAssign "!G_GFX_PTR_PLOT_FBBASE", "!G_GFX_PTR_DEST_FRMB"

  ' Target address
  tiraOp TC_ADD, "!G_GFX_PTR_PLOT_TARGET", "!G_GFX_PTR_PLOT_FBBASE", "!G_GFX_IDX_PLOT_OFFSET"

  ' Write byte to framebuffer
  tiraWriteMem "!G_GFX_PTR_PLOT_TARGET", arg3Var$, "1"

  tiraAssign "!G_GFX_FLG_DISPLAYI_PENDING", "1"

  tiraLabel endLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePlotPixel

''''''''''''''''''''''''
SUB emitRuntimePrintInt

  rtOffset(RT_PRINT_INT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' Use !G_MEM_PTR_TEMP_HEAP as the high-end of our temporary string scratchpad.
  ' We do not permanently allocate it because the string is consumed instantly.
  ptr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign ptr$, "!G_MEM_PTR_TEMP_HEAP"

  valVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign valVar$, arg1Var$

  isNeg$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign isNeg$, "0"

  skipNegLbl$ = tiraLabelCreateNew$("PI_SKIP_NEG")
  tiraJmpCond "JGE", valVar$, "0", skipNegLbl$
  tiraAssign isNeg$, "1"
  tiraLabel skipNegLbl$

  ' Add the trailing space required by QB64 PRINT formatting FIRST (since we build backwards)
  ' When the #EMERALD directive is active, we intentionally omit this trailing space so
  ' consecutive prints display tighter together, while retaining standard QBasic leading spaces.
  IF compileEmeraldMode = 0 THEN
    tiraOp TC_SUB, ptr$, ptr$, "1"
    tiraWriteMem ptr$, "32", "1"
  END IF

  loopTop$ = tiraLabelCreateNew$("PI_LOOP")
  tiraLabel loopTop$

  ' digit = val MOD 10
  digit$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MOD, digit$, valVar$, "10"

  skipDigitNegLbl$ = tiraLabelCreateNew$("PI_SKIP_DNEG")
  tiraJmpCond "JGE", digit$, "0", skipDigitNegLbl$
  tiraOp TC_NEG, digit$, digit$, ""
  tiraLabel skipDigitNegLbl$

  ' char = digit + 48
  charVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, charVar$, digit$, "48"

  ' ptr = ptr - 1
  tiraOp TC_SUB, ptr$, ptr$, "1"

  ' Write byte to temporary string buffer
  tiraWriteMem ptr$, charVar$, "1"

  ' val = val / 10
  tiraOp TC_IDIV, valVar$, valVar$, "10"

  ' Continue loop if val != 0
  tiraJmpCond "JNE", valVar$, "0", loopTop$

  ' Add leading sign OR space for positive numbers required by QB64 PRINT formatting
  tiraOp TC_SUB, ptr$, ptr$, "1"
  skipSpaceLbl$ = tiraLabelCreateNew$("PI_SKIP_SPC")
  tiraJmpCond "JE", isNeg$, "0", skipSpaceLbl$
  tiraWriteMem ptr$, "45", "1" ' 45 is '-'
  jmpDoneLbl$ = tiraLabelCreateNew$("PI_DONE")
  tiraJmp jmpDoneLbl$
  tiraLabel skipSpaceLbl$
  tiraWriteMem ptr$, "32", "1" ' 32 is Space
  tiraLabel jmpDoneLbl$

  ' Calculate strLen = !G_MEM_PTR_TEMP_HEAP - ptr
  strLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, strLen$, "!G_MEM_PTR_TEMP_HEAP", ptr$

  IF compileHasGraphics = 0 THEN
    ' Console output via WriteFile
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConst$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign stdOutConst$, "-11"

    ' Call Windows API to get the standard output handle
    tiraCall "IAT_GETSTDHANDLE", 1, stdOutConst$
    ' Retrieve the returned handle into a temporary variable
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, hndVar$

    ' Provide a safe throwaway memory address for the bytes written output
    numWrt$ = tiraDimVar$("T", TYPE_LONG)
    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

    ' Write the integer string to the console
    tiraCall "IAT_WRITEFILE", 5, hndVar$ + ", " + ptr$ + ", " + strLen$ + ", " + numWrtPtr$ + ", 0"
  ELSE
    ' Graphics output via GfxAppend
    tiraCall "RT_GFX_APPEND", 2, ptr$ + ", " + strLen$
  END IF

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePrintInt

''''''''''''''''''''''''
SUB emitRuntimePrintFloat

  rtOffset(RT_PRINT_FLOAT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_DOUBLE)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  arg2Var$ = tiraDimVar$("ARG2", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"

  ' Allocate 64 bytes on the temporary heap for the sprintf buffer natively
  basePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign basePtr$, "!G_MEM_PTR_TEMP_HEAP"
  tiraOp TC_SUB, basePtr$, basePtr$, "64"
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", basePtr$

  ' Read the pointer to the format string payload passed as arg 2
  fmtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, fmtPtr$ + ", " + arg2Var$

  ' Call sprintf natively using TIRA. The backend will perfectly mirror the
  ' float variable into both XMM2 and R8 to satisfy the Windows Varargs ABI.
  tiraCall "IAT_SPRINTF", 3, basePtr$ + ", " + fmtPtr$ + ", " + arg1Var$

  ' Capture the return length from sprintf
  strLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, strLen$

  IF compileHasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConst$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign stdOutConst$, "-11"

    ' Call Windows API to get the standard output handle
    tiraCall "IAT_GETSTDHANDLE", 1, stdOutConst$

    ' Retrieve the returned handle into a temporary variable
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, hndVar$

    ' Provide a safe throwaway memory address for the bytes written output
    numWrt$ = tiraDimVar$("T", TYPE_LONG)
    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

    ' Write the float string to the console
    tiraCall "IAT_WRITEFILE", 5, hndVar$ + ", " + basePtr$ + ", " + strLen$ + ", " + numWrtPtr$ + ", 0"
  ELSE
    ' Graphics output via GfxAppend
    tiraCall "RT_GFX_APPEND", 2, basePtr$ + ", " + strLen$
  END IF

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePrintFloat

''''''''''''''''''''''''
SUB emitRuntimePrintStr

  rtOffset(RT_PRINT_STR) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  IF compileHasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConst$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign stdOutConst$, "-11"

    ' Call Windows API to get the standard output handle
    tiraCall "IAT_GETSTDHANDLE", 1, stdOutConst$

    ' Retrieve the returned handle into a temporary varia5ble
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, hndVar$

    ' Read the memory address and length of the string data from the descriptor
    strData$ = tiraGetStringData$(arg1Var$)
    strLen$ = tiraGetStringLen$(arg1Var$)

    ' Provide a safe throwaway memory address for the bytes written output
    numWrt$ = tiraDimVar$("T", TYPE_LONG)
    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

    ' Write the string to the console
    tiraCall "IAT_WRITEFILE", 5, hndVar$ + ", " + strData$ + ", " + strLen$ + ", " + numWrtPtr$ + ", 0"
  ELSE
    ' Graphics mode

    ' Read the memory address and length of the string data from the descriptor
    strData$ = tiraGetStringData$(arg1Var$)
    strLen$ = tiraGetStringLen$(arg1Var$)

    ' Call RT_GFX_APPEND, pass data pointer and length
    tiraCall "RT_GFX_APPEND", 2, strData$ + ", " + strLen$
  END IF

  tiraRT_Epilogue
  tira_EndAndProcess


END SUB ' emitRuntimePrintStr

''''''''''''''''''''''''
SUB emitRuntimePutImage

  rtOffset(33) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  destX1$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destX1$ + ", 1"
  destY1$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destY1$ + ", 2"
  destX2$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destX2$ + ", 3"
  destY2$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destY2$ + ", 4"
  argSrc$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argSrc$ + ", 5"
  argDest$ = tiraDimVar$("ARG6", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argDest$ + ", 6"

  heapMark$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign heapMark$, "!G_MEM_PTR_TEMP_HEAP"

  lblDone$ = tiraLabelCreateNew$("PUTIMG_DONE")

  skipXSwap$ = tiraLabelCreateNew$("PUTIMG_SKIP_X")
  tiraJmpCond "JLE", destX1$, destX2$, skipXSwap$
  ptr1$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, ptr1$, destX1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, destX2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipXSwap$

  skipYSwap$ = tiraLabelCreateNew$("PUTIMG_SKIP_Y")
  tiraJmpCond "JLE", destY1$, destY2$, skipYSwap$
  ptr1_y$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2_y$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, ptr1_y$, destY1$, ""
  tiraOp TC_ADDRESS_OF, ptr2_y$, destY2$, ""
  tiraSwapMem ptr1_y$, ptr2_y$, "4"
  tiraLabel skipYSwap$

  tiraJmpCond "JL", argSrc$, "0", lblDone$
  tiraJmpCond "JG", argSrc$, "3", lblDone$
  tiraJmpCond "JL", argDest$, "0", lblDone$
  tiraJmpCond "JG", argDest$, "3", lblDone$

  ' Page 0 and page 1 use the fixed framebuffer that the window procedure stretches
  ' Normalize a larger full-screen destination so the complete source reaches that framebuffer
  keepDestRect$ = tiraLabelCreateNew$("PUTIMG_KEEP_DEST")
  normalizeDest$ = tiraLabelCreateNew$("PUTIMG_NORMALIZE_DEST")

  tiraJmpCond "JG", argDest$, "1", keepDestRect$
  tiraJmpCond "JNE", destX1$, "0", keepDestRect$
  tiraJmpCond "JNE", destY1$, "0", keepDestRect$

  requestedW$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, requestedW$, destX2$, destX1$
  tiraOp TC_ADD, requestedW$, requestedW$, "1"

  requestedH$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, requestedH$, destY2$, destY1$
  tiraOp TC_ADD, requestedH$, requestedH$, "1"

  tiraJmpCond "JG", requestedW$, LTRIM$(STR$(gfxConfig.SizeX)), normalizeDest$
  tiraJmpCond "JG", requestedH$, LTRIM$(STR$(gfxConfig.SizeY)), normalizeDest$
  tiraJmp keepDestRect$

  tiraLabel normalizeDest$
  tiraAssign destX2$, LTRIM$(STR$(gfxConfig.SizeX - 1))
  tiraAssign destY2$, LTRIM$(STR$(gfxConfig.SizeY - 1))

  tiraLabel keepDestRect$

  dstW$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, dstW$, destX2$, destX1$
  tiraOp TC_ADD, dstW$, dstW$, "1"

  dstH$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, dstH$, destY2$, destY1$
  tiraOp TC_ADD, dstH$, dstH$, "1"

  tiraJmpCond "JLE", dstW$, "0", lblDone$
  tiraJmpCond "JLE", dstH$, "0", lblDone$

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  ptrSrcFb$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argSrc$, "0", lblSrc0$
  tiraJmpCond "JE", argSrc$, "1", lblSrc1$
  tiraJmpCond "JE", argSrc$, "2", lblSrc2$
  tiraJmpCond "JE", argSrc$, "3", lblSrc3$
  tiraJmp lblDone$

  tiraLabel lblSrc0$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_FRONT"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE3"

  tiraLabel lblSrcEnd$

  lblDest0$ = tiraLabelCreateNew$("DEST_0")
  lblDest1$ = tiraLabelCreateNew$("DEST_1")
  lblDest2$ = tiraLabelCreateNew$("DEST_2")
  lblDest3$ = tiraLabelCreateNew$("DEST_3")
  lblDestEnd$ = tiraLabelCreateNew$("DEST_END")

  ptrDestFb$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argDest$, "0", lblDest0$
  tiraJmpCond "JE", argDest$, "1", lblDest1$
  tiraJmpCond "JE", argDest$, "2", lblDest2$
  tiraJmpCond "JE", argDest$, "3", lblDest3$
  tiraJmp lblDone$

  tiraLabel lblDest0$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraJmp lblDestEnd$

  tiraLabel lblDest1$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_FRONT"
  tiraJmp lblDestEnd$

  tiraLabel lblDest2$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraJmp lblDestEnd$

  tiraLabel lblDest3$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE3"

  tiraLabel lblDestEnd$

  srcW$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcW$, LTRIM$(STR$(gfxConfig.SizeX))

  srcH$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcH$, LTRIM$(STR$(gfxConfig.SizeY))

  ' Page 2 retains the dimensions supplied to _NEWIMAGE
  srcDimsDone$ = tiraLabelCreateNew$("PUTIMG_SRC_DIMS_DONE")
  tiraJmpCond "JNE", argSrc$, "2", srcDimsDone$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE2W", "0", srcDimsDone$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE2H", "0", srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE2W", LTRIM$(STR$(gfxConfig.SizeX)), srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE2H", LTRIM$(STR$(gfxConfig.SizeY)), srcDimsDone$

  tiraAssign srcW$, "!G_GFX_V32_PAGE2W"
  tiraAssign srcH$, "!G_GFX_V32_PAGE2H"

  tiraLabel srcDimsDone$

  ' When source and destination share a framebuffer, preserve the complete source before drawing
  sourceCopyDone$ = tiraLabelCreateNew$("PUTIMG_SOURCE_COPY_DONE")
  tiraJmpCond "JNE", ptrSrcFb$, ptrDestFb$, sourceCopyDone$

  sourceCopySize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign sourceCopySize$, LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

  sourceCopyPtr$ = tiraAllocTempMem$(sourceCopySize$)
  tiraMemcpy sourceCopyPtr$, ptrSrcFb$, sourceCopySize$
  tiraAssign ptrSrcFb$, sourceCopyPtr$

  tiraLabel sourceCopyDone$

  srcW_minus_1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, srcW_minus_1$, srcW$, "1"

  srcH_minus_1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, srcH_minus_1$, srcH$, "1"

  yItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign yItr$, "0"

  lblLoopY$ = tiraLabelCreateNew$("PUTIMG_LOOPY")
  lblDoneY$ = tiraLabelCreateNew$("PUTIMG_DONEY")

  tiraLabel lblLoopY$
  tiraJmpCond "JGE", yItr$, dstH$, lblDoneY$

  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, destY1$, yItr$

  skipRow$ = tiraLabelCreateNew$("PUTIMG_SKIPROW")
  tiraJmpCond "JL", absY$, "0", skipRow$
  tiraJmpCond "JGE", absY$, LTRIM$(STR$(gfxConfig.SizeY)), skipRow$

  srcY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcY$, yItr$, srcH$
  tiraOp TC_IDIV, srcY$, srcY$, dstH$
  tiraClamp srcY$, "0", srcH_minus_1$

  srcRowOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcRowOffset$, srcY$, LTRIM$(STR$(gfxConfig.SizeX))

  dstRowOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, dstRowOffset$, absY$, LTRIM$(STR$(gfxConfig.SizeX))

  xItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign xItr$, "0"

  lblLoopX$ = tiraLabelCreateNew$("PUTIMG_LOOPX")
  lblDoneX$ = tiraLabelCreateNew$("PUTIMG_DONEX")

  tiraLabel lblLoopX$
  tiraJmpCond "JGE", xItr$, dstW$, lblDoneX$

  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, destX1$, xItr$

  skipPix$ = tiraLabelCreateNew$("PUTIMG_SKIPPIX")
  tiraJmpCond "JL", absX$, "0", skipPix$
  tiraJmpCond "JGE", absX$, LTRIM$(STR$(gfxConfig.SizeX)), skipPix$

  srcX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcX$, xItr$, srcW$
  tiraOp TC_IDIV, srcX$, srcX$, dstW$
  tiraClamp srcX$, "0", srcW_minus_1$

  srcOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, srcOffset$, srcRowOffset$, srcX$

  srcAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, srcAddr$, ptrSrcFb$, srcOffset$

  pixel$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel$ + ", " + srcAddr$

  tiraJmpCond "JE", pixel$, "0", skipPix$

  dstOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, dstOffset$, dstRowOffset$, absX$

  dstAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dstAddr$, ptrDestFb$, dstOffset$

  tiraWriteMem dstAddr$, pixel$, "1"

  tiraLabel skipPix$

  tiraOp TC_ADD, xItr$, xItr$, "1"
  tiraJmp lblLoopX$

  tiraLabel lblDoneX$
  tiraLabel skipRow$

  tiraOp TC_ADD, yItr$, yItr$, "1"
  tiraJmp lblLoopY$

  tiraLabel lblDoneY$

  tiraLabel lblDone$

  tiraAssign "!G_MEM_PTR_TEMP_HEAP", heapMark$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePutImage

''''''''''''''''''''''''
SUB emitRuntimeRead

  rtOffset(RT_READ) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  targetAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, targetAddrVar$ + ", 1"

  isStrVarVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, isStrVarVar$ + ", 2"

  tgtDataTypeVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, tgtDataTypeVar$ + ", 3"

  skipErrLbl$ = tiraLabelCreateNew$("READ_SKIP_ERR")
  tiraJmpCond "JL", "!G_SYS_VAL_DATAINDEX", "!G_SYS_VAL_DATA_COUNT", skipErrLbl$

  errStr$ = CHR$(34) + "OUT OF DATA ERROR ON READ" + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel skipErrLbl$

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_SYS_ARR_DATA_LIST", ""

  descPtrAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB descPtrAddr$, baseArr$, "!G_SYS_VAL_DATAINDEX", "8"

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, descPtr$ + ", " + descPtrAddr$

  tiraOp TC_ADD, "!G_SYS_VAL_DATAINDEX", "!G_SYS_VAL_DATAINDEX", "1"

  notStrLbl$ = tiraLabelCreateNew$("READ_NOT_STR")
  tiraJmpCond "JE", isStrVarVar$, "0", notStrLbl$

  tiraCall "RT_STR_ASSIGN", 2, targetAddrVar$ + ", " + descPtr$

  endReadLbl$ = tiraLabelCreateNew$("READ_END")
  tiraJmp endReadLbl$

  tiraLabel notStrLbl$

  bufPtr$ = tiraGetStringData$(descPtr$)
  bufLen$ = tiraGetStringLen$(descPtr$)

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"
  isNeg$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign isNeg$, "0"

  skipLoop$ = tiraLabelCreateNew$("READ_NSKIP")
  skipDone$ = tiraLabelCreateNew$("READ_NSKIP_DN")

  tiraLabel skipLoop$
  tiraJmpCond "JLE", bufLen$, "0", skipDone$
  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  isSpcLbl$ = tiraLabelCreateNew$("READ_ISSPC")
  tiraJmpCond "JE", byteVal$, "32", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "13", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "10", isSpcLbl$
  tiraJmp skipDone$

  tiraLabel isSpcLbl$
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp skipLoop$

  tiraLabel skipDone$

  signDone$ = tiraLabelCreateNew$("READ_SGN_DONE")
  tiraJmpCond "JLE", bufLen$, "0", signDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$
  tiraJmpCond "JNE", byteVal$, "45", signDone$
  tiraAssign isNeg$, "1"
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"

  tiraLabel signDone$

  numLoopTop$ = tiraLabelCreateNew$("READ_NUM_LOOP")
  numLoopDone$ = tiraLabelCreateNew$("READ_NUM_DONE")

  tiraLabel numLoopTop$
  tiraJmpCond "JLE", bufLen$, "0", numLoopDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  tiraJmpCond "JL", byteVal$, "48", numLoopDone$
  tiraJmpCond "JG", byteVal$, "57", numLoopDone$

  tiraOp TC_SUB, byteVal$, byteVal$, "48"
  tiraOp TC_MUL, resVar$, resVar$, "10"
  tiraOp TC_ADD, resVar$, resVar$, byteVal$

  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp numLoopTop$

  tiraLabel numLoopDone$

  applySignDone$ = tiraLabelCreateNew$("READ_SGN_APP")
  tiraJmpCond "JE", isNeg$, "0", applySignDone$
  tiraOp TC_NEG, resVar$, resVar$, ""
  tiraLabel applySignDone$

  lblSingle$ = tiraLabelCreateNew$("READ_IS_SNG")
  lblDouble$ = tiraLabelCreateNew$("READ_IS_DBL")
  lblByte$ = tiraLabelCreateNew$("READ_IS_BYT")
  lblInt$ = tiraLabelCreateNew$("READ_IS_INT")
  lblLong$ = tiraLabelCreateNew$("READ_IS_LNG")
  lblWriteDone$ = tiraLabelCreateNew$("READ_WR_DONE")

  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_SINGLE)), lblSingle$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_DOUBLE)), lblDouble$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_BYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UBYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_INTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UINTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_LONG)), lblLong$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_ULONG)), lblLong$

  tiraWriteMem targetAddrVar$, resVar$, "8"
  tiraJmp lblWriteDone$

  tiraLabel lblSingle$
  tiraWriteMem targetAddrVar$, resVar$, "SINGLE"
  tiraJmp lblWriteDone$

  tiraLabel lblDouble$
  tiraWriteMem targetAddrVar$, resVar$, "DOUBLE"
  tiraJmp lblWriteDone$

  tiraLabel lblByte$
  tiraWriteMem targetAddrVar$, resVar$, "1"
  tiraJmp lblWriteDone$

  tiraLabel lblInt$
  tiraWriteMem targetAddrVar$, resVar$, "2"
  tiraJmp lblWriteDone$

  tiraLabel lblLong$
  tiraWriteMem targetAddrVar$, resVar$, "4"

  tiraLabel lblWriteDone$

  tiraLabel endReadLbl$

  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeRead

''''''''''''''''''''''''
SUB emitRuntimeVehHandler

  '''' RT_VEH_HANDLER
  rtOffset(RT_VEH_HANDLER) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  tiraCall "IAT_GETCURRENTTHREADID", 0, ""
  curThread$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, curThread$

  lblWrongThread$ = tiraLabelCreateNew$("VEH_WRONG_THREAD")
  tiraJmpCond "JNE", curThread$, "!G_SYS_VAL_USER_THREAD_ID", lblWrongThread$

  excPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign excPtr$, arg1Var$

  ' Read ExceptionRecord pointer (offset 0)
  excRecPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, excRecPtr$ + ", " + excPtr$

  ' Read ExceptionCode from the ExceptionRecord structure
  excCode$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, excCode$ + ", " + excRecPtr$

  lblMatchDivZero$ = tiraLabelCreateNew$("VEH_MATCH_DZ")
  lblMatchAccess$ = tiraLabelCreateNew$("VEH_MATCH_AV")
  lblMatchStack$ = tiraLabelCreateNew$("VEH_MATCH_SO")
  lblPrepareRestore$ = tiraLabelCreateNew$("VEH_PREP_RESTORE")
  lblEnd$ = tiraLabelCreateNew$("VEH_END")

  targetRip$ = tiraDimVar$("T", TYPE_INTEGER64)

  ' Check for integer divide by zero (0xC0000094 -> -1073741676)
  tiraJmpCond "JE", excCode$, "-1073741676", lblMatchDivZero$

  ' Check for float divide by zero (0xC000008E -> -1073741682)
  tiraJmpCond "JE", excCode$, "-1073741682", lblMatchDivZero$

  ' Check for Access Violation (0xC0000005 -> -1073741819)
  tiraJmpCond "JE", excCode$, "-1073741819", lblMatchAccess$

  ' Check for Stack Overflow (0xC00000FD -> -1073741571)
  tiraJmpCond "JE", excCode$, "-1073741571", lblMatchStack$

  ' Not a recognized exception, gracefully pass it back to Windows returning EXCEPTION_CONTINUE_SEARCH (0) in RAX
  tiraAssign arg1Var$, "0"
  tiraJmp lblEnd$

  tiraLabel lblMatchDivZero$
  tiraOp TC_ADDRESS_OF, targetRip$, "@NATIVE_DIV_ZERO_HANDLER", ""
  tiraJmp lblPrepareRestore$

  tiraLabel lblMatchAccess$
  tiraOp TC_ADDRESS_OF, targetRip$, "@NATIVE_MEM_ACCESS_HANDLER", ""
  tiraJmp lblPrepareRestore$

  tiraLabel lblMatchStack$
  tiraOp TC_ADDRESS_OF, targetRip$, "@NATIVE_STACK_HANDLER", ""
  tiraJmp lblPrepareRestore$

  tiraLabel lblPrepareRestore$

  ' Check for user handler override
  userHandler$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign userHandler$, "!G_ERR_PTR_HANDLER"
  lblHasHandler$ = tiraLabelCreateNew$("VEH_HAS_HDL")
  tiraJmpCond "JE", userHandler$, "0", lblHasHandler$
  tiraAssign targetRip$, userHandler$
  tiraLabel lblHasHandler$

  ' Start modifying the CPU CONTEXT struct to safely route execution into our basic program space by reading ContextRecord pointer (offset 8)
  ctxPtrAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, ctxPtrAddr$, excPtr$, "8"

  ctxPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, ctxPtr$ + ", " + ctxPtrAddr$

  ' Navigate to Context.Rsp to reset the dirty execution stack (offset 152)
  rspPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, rspPtr$, ctxPtr$, "152"
  tiraWriteMem rspPtr$, "!G_SYS_PTR_SAFE_RSP", "8"

  ' Write it into Context.Rbp to pull the base pointer out of any deep subroutine frames (offset 160)
  rbpPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, rbpPtr$, ctxPtr$, "160"
  tiraWriteMem rbpPtr$, "!G_SYS_PTR_SAFE_RSP", "8"

  ' Redirect the instruction pointer (offset 248)
  ripPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, ripPtr$, ctxPtr$, "248"

  ' Save the crashing instruction address for the RESUME keyword
  crashRip$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, crashRip$ + ", " + ripPtr$
  tiraAssign "!G_ERR_PTR_LAST", crashRip$

  ' Write the target address into Context.Rip
  tiraWriteMem ripPtr$, targetRip$, "8"

  ' Return EXCEPTION_CONTINUE_EXECUTION (-1) so Windows allows the thread to seamlessly continue
  tiraAssign arg1Var$, "-1"
  tiraJmp lblEnd$

  tiraLabel lblWrongThread$
  tiraAssign arg1Var$, "0"

  tiraLabel lblEnd$

  tiraNew TC_ABI_WRITE_RET, arg1Var$
  tiraRT_Epilogue

  '''' Append the native error handler to the compiled output space immediately following the VEH handler

  tiraLabel "@NATIVE_DIV_ZERO_HANDLER"
  tiraFatalError "UNHANDLED DIVISION BY ZERO"

  tiraLabel "@NATIVE_BOUNDS_HANDLER"
  tiraFatalError "ARRAY OUT OF BOUNDS"

  tiraLabel "@NATIVE_MEM_ACCESS_HANDLER"
  tiraFatalError "MEMORY ACCESS VIOLATION"

  tiraLabel "@NATIVE_STACK_HANDLER"
  tiraFatalError "STACK CORRUPTION DETECTED"

  tira_EndAndProcess

END SUB ' emitRuntimeVehHandler

''''''''''''''''''''''''
''''''''''''''''''''''''
SUB initKeyMapping

  keyMappingCount = 0

  ' Uppercase A-Z
  FOR ii = 65 TO 90
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Lowercase a-z
  FOR ii = 97 TO 122
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii - 32
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Numbers 0-9
  FOR ii = 48 TO 57
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Arrow Keys
  keyMapping(keyMappingCount).qbCode = 18432
  keyMapping(keyMappingCount).vkCode = 38
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 19200
  keyMapping(keyMappingCount).vkCode = 37
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 19712
  keyMapping(keyMappingCount).vkCode = 39
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20480
  keyMapping(keyMappingCount).vkCode = 40
  keyMappingCount = keyMappingCount + 1

  ' Navigation Keys
  keyMapping(keyMappingCount).qbCode = 18688
  keyMapping(keyMappingCount).vkCode = 33
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20736
  keyMapping(keyMappingCount).vkCode = 34
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 18176
  keyMapping(keyMappingCount).vkCode = 36
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20224
  keyMapping(keyMappingCount).vkCode = 35
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20992
  keyMapping(keyMappingCount).vkCode = 45
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 21248
  keyMapping(keyMappingCount).vkCode = 46
  keyMappingCount = keyMappingCount + 1

  ' Control Keys
  keyMapping(keyMappingCount).qbCode = 13
  keyMapping(keyMappingCount).vkCode = 13
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 27
  keyMapping(keyMappingCount).vkCode = 27
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 32
  keyMapping(keyMappingCount).vkCode = 32
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 9
  keyMapping(keyMappingCount).vkCode = 9
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 8
  keyMapping(keyMappingCount).vkCode = 8
  keyMappingCount = keyMappingCount + 1

  ' Function Keys
  keyMapping(keyMappingCount).qbCode = 15104
  keyMapping(keyMappingCount).vkCode = 112
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15360
  keyMapping(keyMappingCount).vkCode = 113
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15616
  keyMapping(keyMappingCount).vkCode = 114
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15872
  keyMapping(keyMappingCount).vkCode = 115
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16128
  keyMapping(keyMappingCount).vkCode = 116
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16384
  keyMapping(keyMappingCount).vkCode = 117
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16640
  keyMapping(keyMappingCount).vkCode = 118
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16896
  keyMapping(keyMappingCount).vkCode = 119
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 17152
  keyMapping(keyMappingCount).vkCode = 120
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 17408
  keyMapping(keyMappingCount).vkCode = 121
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34048
  keyMapping(keyMappingCount).vkCode = 122
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34304
  keyMapping(keyMappingCount).vkCode = 123
  keyMappingCount = keyMappingCount + 1

  ' Symbol Keys
  keyMapping(keyMappingCount).qbCode = 42
  keyMapping(keyMappingCount).vkCode = 106
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 43
  keyMapping(keyMappingCount).vkCode = 187
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 44
  keyMapping(keyMappingCount).vkCode = 188
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 45
  keyMapping(keyMappingCount).vkCode = 189
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 46
  keyMapping(keyMappingCount).vkCode = 190
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 47
  keyMapping(keyMappingCount).vkCode = 191
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 60
  keyMapping(keyMappingCount).vkCode = 188
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 61
  keyMapping(keyMappingCount).vkCode = 187
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 62
  keyMapping(keyMappingCount).vkCode = 190
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 63
  keyMapping(keyMappingCount).vkCode = 191
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 92
  keyMapping(keyMappingCount).vkCode = 220
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 95
  keyMapping(keyMappingCount).vkCode = 189
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 124
  keyMapping(keyMappingCount).vkCode = 220
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 39
  keyMapping(keyMappingCount).vkCode = 222
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34
  keyMapping(keyMappingCount).vkCode = 222
  keyMappingCount = keyMappingCount + 1

END SUB ' initKeyMapping

''''''''''''''''''''''''
FUNCTION parse_ATN$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM singleRes$
  DIM argFloat$
  DIM retType AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ATN", 3) = 0 THEN
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ' In QB64 is outputs as SINGLE, so it is Emerald mode that will allow more than that
  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF

  retType = TYPE_SINGLE
  IF compileEmeraldMode = 1 THEN
    IF exprIs.DataType = TYPE_DOUBLE THEN retType = TYPE_DOUBLE
  END IF

  scratchName$ = tiraResolveHoistVar$("ATN", "_VAL")
  IF scratchName$ = "" THEN
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as the correct float type
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = retType

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
    tiraOp TC_CAST, argFloat$, arg1$, LTRIM$(STR$(TYPE_DOUBLE))
    arg1$ = argFloat$
  END IF

  tiraCall "IAT_ATAN", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  IF retType = TYPE_SINGLE THEN
    singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
    tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))
    tiraAssign scratchName$, singleRes$
  ELSE
    tiraAssign scratchName$, resVar$
  END IF

  tira_EndAndProcess

  exprIs.DataType = retType
  exprIs.IsTemp = 1
  parse_ATN$ = scratchName$

END FUNCTION ' parse_ATN$

''''''''''''''''''''''''
FUNCTION parse_AXIS$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_AXIS", 3) = 0 THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("AXIS", "_VAL")
  IF scratchName$ = "" THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraCall "RT_AXIS", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_AXIS$ = scratchName$

END FUNCTION ' parse_AXIS$

''''''''''''''''''''''''
FUNCTION parse_BEEP (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "BEEP")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start
  tiraCall "IAT_BEEP", 2, "800, 250"
  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_BEEP = 1

END FUNCTION ' parse_BEEP

''''''''''''''''''''''''
FUNCTION parse_BLUE32$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_BLUE32", 3) = 0 THEN
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "_BLUE32 ARG MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("BLU32", "_VAL")
  IF scratchName$ = "" THEN
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  tiraOp TC_AND, resVar$, arg1$, "255"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_BLUE32$ = scratchName$

END FUNCTION ' parse_BLUE32$

