  fieldStartIdx = tiraDimVarId&("T", TYPE_LONG)
  fieldEndIdx = tiraDimVarId&("T", TYPE_LONG)
  probePositionIdx = tiraDimVarId&("T", TYPE_LONG)
  probeAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  probeCharIdx = tiraDimVarId&("T", TYPE_UBYTE)
  nextChar1Idx = tiraDimVarId&("T", TYPE_UBYTE)
  nextChar2Idx = tiraDimVarId&("T", TYPE_UBYTE)
  nextChar3Idx = tiraDimVarId&("T", TYPE_UBYTE)
