END FUNCTION ' parse_BUTTON$

''''''''''''''''''''''''
FUNCTION parse_CHDIR (startIdx)

  DIM endIdx AS LONG
  DIM pathType AS LONG
  DIM pathVal AS _INTEGER64
  DIM pathDataPtrIdx AS LONG
  DIM setCurrentDirectoryIdx AS LONG
  DIM changeResultIdx AS LONG
  DIM changedLblIdx AS LONG

  endIdx = lineTokenCount - 1

  IF startIdx + 1 > endIdx THEN
    throwCompilerError "CHDIR REQUIRES A STRING PATH", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  pathType = tiraParsedArgType
  pathVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "CHDIR PATH MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  pathDataPtrIdx = tiraGetStringDataId&(pathType, pathVal)

  ff = resolveSymbol("IAT_SETCURRENTDIRECTORYA")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  setCurrentDirectoryIdx = returnedData2

  tiraCallId1 setCurrentDirectoryIdx, TIRA_ARG_SYMBOL, pathDataPtrIdx
  changeResultIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId changeResultIdx

  changedLblIdx = tiraLabelCreateNewId&("CHDIR_CHANGED")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, changeResultIdx, TIRA_ARG_LITERAL, 0, changedLblIdx
  tiraFatalErrorId "CHDIR FAILED"
  tiraLabelId changedLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CHDIR = 1

END FUNCTION ' parse_CHDIR

''''''''''''''''''''''''
FUNCTION parse_CLEAR (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM commaIdx AS LONG
  DIM exprEnd AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF currentScopeID <> 0 THEN
    throwCompilerError "CLEAR NOT ALLOWED IN SUB OR FUNCTION", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Parse optional legacy CLEAR arguments (e.g. CLEAR , , 2000)
  ' We evaluate them for syntax compliance and side-effects, but discard the values
  ' since x64 executable stack/memory sizes are fixed in the PE header.
  tokIdx = startIdx + 1
  DO WHILE tokIdx <= endIdx
    commaIdx = findComma(tokIdx, endIdx)
    IF commaIdx > 0 THEN
      exprEnd = commaIdx - 1
    ELSE
      exprEnd = endIdx
    END IF

    IF exprEnd >= tokIdx THEN
      ff = tiraParseExpressionIntId(tokIdx, exprEnd, ALIM, "CLEAR ARGUMENTS MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF

    IF commaIdx > 0 THEN
      tokIdx = commaIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  ff = resolveSymbol("RT_CLEAR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CLEAR = 1

END FUNCTION ' parse_CLEAR

''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_Assign (startIdx)

  ' Copies a text string directly into the operating system clipboard

  DIM endIdx AS LONG
  DIM argVarType AS LONG
  DIM argVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF startIdx + 1 > endIdx THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  argVarType = tiraParsedArgType
  argVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_CLIPBOARD$ ASSIGN REQUIRES STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol("RT_SET_CLIPBOARD")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, argVarType, argVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CLIPBOARD_Assign = 1

END FUNCTION ' parse_CLIPBOARD_Assign

''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_FUNC$ (startIdx, endIdx, allowImplicit)

  ' Retrieves the current text string from the operating system clipboard

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _CLIPBOARD$", ASIS, 0
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("CLIP", "_DSC")
  IF scratchIdx = 0 THEN
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Allocate a local descriptor wrapper and push its address explicitly into the arguments
  ' so the Runtime Helper can physically write the required data pointers back into it
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  ff = resolveSymbol("RT_GET_CLIPBOARD")
  IF ff = 0 THEN
    tira_Cancel
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, TIRA_ARG_SYMBOL, descPtrIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CLIPBOARD_FUNC$ = scratchName$

END FUNCTION ' parse_CLIPBOARD_FUNC$

''''''''''''''''''''''''
FUNCTION parse_CLOSE (startIdx)

  ' Closes an open file or all open files

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM fileNumStart AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM handlesIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM closeHandleIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM iterVarIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopEndIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipCloseIdx AS LONG
  DIM skipClose2Idx AS LONG

  endIdx = lineTokenCount - 1

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  tiraFlushFileWriteBufferId

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  handlesIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesIdx

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  closeHandleIdx = returnedData2

  IF endIdx < startIdx + 1 THEN
    ' Close all files iteratively (1 to 255)
    iterVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId iterVarIdx, TIRA_ARG_LITERAL, 1

    loopTopIdx = tiraLabelCreateNewId&("CLOSE_LOOP")
    loopEndIdx = tiraLabelCreateNewId&("CLOSE_END")

    tiraLabelId loopTopIdx
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 255, loopEndIdx

    slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 8

    handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

    skipCloseIdx = tiraLabelCreateNewId&("SKIP_CLOSE")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipCloseIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipCloseIdx ' INVALID_HANDLE_VALUE (-1)

    tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx

    tiraLabelId skipCloseIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

    stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES
    tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, FS_MODE_NONE, TIRA_ARG_LITERAL, 8

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId loopTopIdx

    tiraLabelId loopEndIdx
  ELSE
    ' Close specifically identified files mapped by comma boundaries
    itemStart = startIdx + 1
    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      commaIdx = findComma(itemStart, endIdx)
      IF commaIdx > 0 THEN itemEnd = commaIdx - 1

      fileNumStart = itemStart

      ' Strip the # symbol so the expression evaluates properly
      IF lineTokens$(fileNumStart) = "#" THEN
        fileNumStart = fileNumStart + 1
      ELSE
        IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
          lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
        END IF
      END IF

      ff = tiraParseExpressionIntId(fileNumStart, itemEnd, ALIM, "FILENUM MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fileNumType = tiraParsedArgType
      fileNumVal = tiraParsedArgVal

      slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

      handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

      skipClose2Idx = tiraLabelCreateNewId&("SKIP_CLOSE")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipClose2Idx
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipClose2Idx

      tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx

      tiraLabelId skipClose2Idx

      tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

      stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES
      tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, FS_MODE_NONE, TIRA_ARG_LITERAL, 8

      itemStart = itemEnd + 2
    LOOP
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CLOSE = 1

END FUNCTION ' parse_CLOSE

''''''''''''''''''''''''
FUNCTION parse_COLOR (startIdx)

  DIM endIdx AS LONG
  DIM commaPos AS LONG
  DIM fgType AS LONG
  DIM fgVal AS _INTEGER64
  DIM bgType AS LONG
  DIM bgVal AS _INTEGER64
  DIM skipInitLblIdx AS LONG
  DIM lastFgIdx AS LONG
  DIM colorInitIdx AS LONG
  DIM lastBgIdx AS LONG
  DIM fgVarIdx AS LONG
  DIM fgMaskIdx AS LONG
  DIM fgRgbPtrIdx AS LONG
  DIM fgRgbIdx AS LONG
  DIM bgShiftIdx AS LONG
  DIM bgMaskIdx AS LONG
  DIM finalAttrIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM setTextAttrIdx AS LONG

  endIdx = lineTokenCount - 1

  tira_Start

  commaPos = findComma(startIdx + 1, endIdx)

  IF commaPos = 0 THEN
    ' No comma found, so there is only a foreground argument - COLOR fg
    ' Ensure the statement is not just "COLOR" with no arguments
    IF endIdx >= startIdx + 1 THEN
      hasFg = 1
      ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgType = tiraParsedArgType
      fgVal = tiraParsedArgVal
    END IF
  ELSE
    ' Comma was found. Check for arguments on either side of it
    IF commaPos > startIdx + 1 THEN
      ' Argument exists before the comma - COLOR fg, ...
      hasFg = 1
      ff = tiraParseExpressionIntId(startIdx + 1, commaPos - 1, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgType = tiraParsedArgType
      fgVal = tiraParsedArgVal
    END IF

    IF commaPos < endIdx THEN
      ' Argument exists after the comma - COLOR ..., bg
      hasBg = 1
      ff = tiraParseExpressionIntId(commaPos + 1, endIdx, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bgType = tiraParsedArgType
      bgVal = tiraParsedArgVal
    END IF
  END IF

  ' Process foreground
  IF hasFg = 1 THEN
    ff = resolveSymbol("!G_GFX_VAL_LAST_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastFgIdx = returnedData2
    tiraAssignId lastFgIdx, fgType, fgVal

    ff = resolveSymbol("!G_GFX_FLG_COLOR_INIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    colorInitIdx = returnedData2
    tiraAssignId colorInitIdx, TIRA_ARG_LITERAL, 1
  ELSE
    ' No foreground was provided, so load the last used one or the default.
    skipInitLblIdx = tiraLabelCreateNewId&("SKIP_INIT")
    fgVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_LAST_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastFgIdx = returnedData2
    tiraAssignId fgVarIdx, TIRA_ARG_SYMBOL, lastFgIdx

    ff = resolveSymbol("!G_GFX_FLG_COLOR_INIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    colorInitIdx = returnedData2
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, colorInitIdx, TIRA_ARG_LITERAL, 0, skipInitLblIdx
    tiraAssignId fgVarIdx, TIRA_ARG_LITERAL, 7 ' Default FG is 7 (Light Gray) in standard console
    tiraLabelId skipInitLblIdx

    fgType = TIRA_ARG_SYMBOL
    fgVal = fgVarIdx
  END IF

  ' Process background
  IF hasBg = 1 THEN
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2
    tiraAssignId lastBgIdx, bgType, bgVal
  ELSE
    ' No background was provided, so load the last used one.
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2
    bgType = TIRA_ARG_SYMBOL
    bgVal = lastBgIdx
  END IF

  IF cm.HasGraphics = 1 THEN
    ' Safely store as pure 8-bit palette index for direct plotting primitives
    fgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, fgMaskIdx, fgType, fgVal, TIRA_ARG_LITERAL, 255

    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgRgbIdx = returnedData2

    fgRgbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, fgRgbPtrIdx, TIRA_ARG_SYMBOL, fgRgbIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, fgRgbPtrIdx, TIRA_ARG_SYMBOL, fgMaskIdx, TIRA_ARG_LITERAL, 4
  ELSE
    ' Console mode logic - combine attributes into (BG_MASK) OR (FG_MASK)

    ' FG_MASK = FG AND 15
    fgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, fgMaskIdx, fgType, fgVal, TIRA_ARG_LITERAL, 15

    ' BG_SHIFT = BG * 16 (equivalent to SHL 4)
    bgShiftIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, bgShiftIdx, bgType, bgVal, TIRA_ARG_LITERAL, 16

    ' BG_MASK = BG_SHIFT AND 240
    bgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, bgMaskIdx, TIRA_ARG_SYMBOL, bgShiftIdx, TIRA_ARG_LITERAL, 240

    ' FINAL_ATTR = FG_MASK OR BG_MASK
    finalAttrIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, finalAttrIdx, TIRA_ARG_SYMBOL, fgMaskIdx, TIRA_ARG_SYMBOL, bgMaskIdx

    ' Call GetStdHandle(-11)
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11

    ' Retrieve the handle from RAX into a virtual register
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Call SetConsoleTextAttribute
    ff = resolveSymbol("IAT_SETCONSOLETEXTATTRIBUTE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setTextAttrIdx = returnedData2
    tiraCallId2 setTextAttrIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, finalAttrIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_COLOR = 1

END FUNCTION ' parse_COLOR

''''''''''''''''''''''''
FUNCTION parse_COMMON (startIdx)

  DIM tempSuccess AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 2 THEN
    throwCompilerError "MALFORMED COMMON SHARED", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_SHARED THEN
    throwCompilerError "EXPECTED SHARED AFTER COMMON", ASIS, 0
    EXIT FUNCTION
  END IF

  tempSuccessOrFail = parse_GLOBAL_Core(startIdx + 2, endIdx)

  parse_COMMON = tempSuccessOrFail

END FUNCTION ' parse_COMMON

''''''''''''''''''''''''
FUNCTION parse_COS$ (startIdx, endIdx, allowImplicit)

  ' Calculates the cosine of a numeric expression

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg1DataType AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM singleResIdx AS LONG
  DIM argFloatIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "COS", 3) = 0 THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_COS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal
  arg1DataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("COS", "_VAL")
  IF scratchIdx = 0 THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly override the integer prefix rule to safely route as float
  symbols(scratchIdx).DataType = TYPE_SINGLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF arg1DataType <> TYPE_DOUBLE THEN
    argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraAssignId argFloatIdx, arg1Type, arg1Val
    arg1Type = TIRA_ARG_SYMBOL
    arg1Val = argFloatIdx
  END IF

  ff = resolveSymbol("IAT_COS")
  IF ff = 0 THEN
    tira_Cancel
    parse_COS$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_COS$ = scratchName$

END FUNCTION ' parse_COS$

''''''''''''''''''''''''
FUNCTION parse_CVD$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM validCvdLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVD", 3) = 0 THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 OR compileError = 1 THEN
    tira_Cancel
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("CVD", "_VAL")
  IF scratchIdx = 0 THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Keep the hoisted result and memory read in the required numeric type
  symbols(scratchIdx).DataType = TYPE_DOUBLE
  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  validCvdLblIdx = tiraLabelCreateNewId&("VALID_CVD")

  ' Check the required byte count before reading the numeric value
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 8, validCvdLblIdx

  tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVD()"

  tiraLabelId validCvdLblIdx

  tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  IF compileError = 1 THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  exprIs.DataType = TYPE_DOUBLE
  exprIs.IsTemp = 1
  parse_CVD$ = scratchName$

END FUNCTION ' parse_CVD$

''''''''''''''''''''''''
FUNCTION parse_CVI$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM validCviLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVI", 3) = 0 THEN
    parse_CVI$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 OR compileError = 1 THEN
    tira_Cancel
    parse_CVI$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVI$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("CVI", "_VAL")
  IF scratchIdx = 0 THEN
    parse_CVI$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Keep the hoisted result and memory read in the required numeric type
  symbols(scratchIdx).DataType = TYPE_INTEGER
  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER)

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  validCviLblIdx = tiraLabelCreateNewId&("VALID_CVI")

  ' Check the required byte count before reading the numeric value
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 2, validCviLblIdx

  tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVI()"

  tiraLabelId validCviLblIdx

  tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  IF compileError = 1 THEN
    parse_CVI$ = ""
    EXIT FUNCTION
  END IF

  exprIs.DataType = TYPE_INTEGER
  exprIs.IsTemp = 1
  parse_CVI$ = scratchName$

END FUNCTION ' parse_CVI$

''''''''''''''''''''''''
FUNCTION parse_CVL$ (startIdx, endIdx, allowImplicit)

