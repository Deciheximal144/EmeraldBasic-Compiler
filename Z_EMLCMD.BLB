    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("MOUSEWHEEL", "_VAL")
  IF scratchIdx = 0 THEN
    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = resolveSymbol("!G_INO_VAL_MOUSE_SCRL")
  IF ff = 0 THEN
    tira_Cancel
    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF
  mouseWheelIdx = returnedData2

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, mouseWheelIdx

