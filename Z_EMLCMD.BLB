' Z_EMLCMD.BLB This is the external library file for EmeraldBasic
' The line with comment, dollar sign, and INCLUDE 'Z_EMLCMD.BLB' at the end of the EmeraldBasic file link this code in QB64PE
' For an EmeraldBasic compiler, use '#AUTOINCLUDE at the top of the file

''''''''''''''''''''''''
SUB emitRuntimeInp

  rtOffset(RT_INP) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argPort$ = tiraDimVar$("PORT", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argPort$ + ", 1"

  retVal$ = tiraDimVar$("RET", TYPE_LONG)
  tiraAssign retVal$, "0"

  lbl3C9$ = tiraLabelCreateNew$("INP_3C9")
  skipAll$ = tiraLabelCreateNew$("INP_SKIP_ALL")

  tiraJmpCond "JE", argPort$, "969", lbl3C9$
  tiraJmp skipAll$

  tiraLabel lbl3C9$

  stepVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign stepVal$, "!G_GFX_VAL_DAC_READ_STEP"

  idxVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign idxVal$, "!G_GFX_VAL_DAC_READ_IDX"
  tiraOp TC_AND, idxVal$, idxVal$, "255"

  palOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, palOffset$, idxVal$, "4"

  palData$ = tiraGetStringData$("!G_GFX_DSC_PALETTE")
  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palData$, palOffset$

  lblStep0$ = tiraLabelCreateNew$("INP_STEP_0")
  lblStep1$ = tiraLabelCreateNew$("INP_STEP_1")
  lblStep2$ = tiraLabelCreateNew$("INP_STEP_2")

  tiraJmpCond "JE", stepVal$, "0", lblStep0$
  tiraJmpCond "JE", stepVal$, "1", lblStep1$
  tiraJmpCond "JE", stepVal$, "2", lblStep2$
  tiraJmp skipAll$

  tiraLabel lblStep0$
  ' Read Red
  addrR$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, addrR$, targetAddr$, "2"
  rawR8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, rawR8$ + ", " + addrR$
  rawR$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign rawR$, rawR8$
  tiraOp TC_IDIV, retVal$, rawR$, "4"
  tiraAssign "!G_GFX_VAL_DAC_READ_STEP", "1"
  tiraJmp skipAll$

  tiraLabel lblStep1$
  ' Read Green
  addrG$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, addrG$, targetAddr$, "1"
  rawG8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, rawG8$ + ", " + addrG$
  rawG$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign rawG$, rawG8$
  tiraOp TC_IDIV, retVal$, rawG$, "4"
  tiraAssign "!G_GFX_VAL_DAC_READ_STEP", "2"
  tiraJmp skipAll$

  tiraLabel lblStep2$
  ' Read Blue
  addrB$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign addrB$, targetAddr$
  rawB8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, rawB8$ + ", " + addrB$
  rawB$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign rawB$, rawB8$
  tiraOp TC_IDIV, retVal$, rawB$, "4"

  ' Advance index and reset step
  tiraOp TC_ADD, idxVal$, idxVal$, "1"
  tiraOp TC_AND, idxVal$, idxVal$, "255"
  tiraAssign "!G_GFX_VAL_DAC_READ_IDX", idxVal$
  tiraAssign "!G_GFX_VAL_DAC_READ_STEP", "0"

  tiraLabel skipAll$

  tiraNew TC_ABI_WRITE_RET, retVal$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeInp

''''''''''''''''''''''''
SUB emitRuntimeKeyDown

  DIM qb AS LONG
  DIM vk AS LONG

  ' Build the key mapping data as a string payload to sit in the global literal pool
  mapPayload$ = ""
  FOR ii = 0 TO keyMappingCount - 1
    ' Append qbCode (4 bytes)
    qb = keyMapping(ii).qbCode
    mapPayload$ = mapPayload$ + CHR$(qb AND 255) + CHR$((qb \ 256) AND 255) + CHR$((qb \ 65536) AND 255) + CHR$((qb \ 16777216) AND 255)
    ' Append vkCode (4 bytes)
    vk = keyMapping(ii).vkCode
    mapPayload$ = mapPayload$ + CHR$(vk AND 255) + CHR$((vk \ 256) AND 255) + CHR$((vk \ 65536) AND 255) + CHR$((vk \ 16777216) AND 255)
  NEXT

  ff = resolveSymbol("!G_INO_DSC_KEYMAP")
  IF ff = 1 THEN
    mapIdx = returnedData2
    strVarData$(mapIdx) = mapPayload$
  END IF

  '''' RT_KEYDOWN
  rtOffset(RT_KEYDOWN) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' Load the requested key code
  qbCode$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qbCode$, arg1Var$

  ' Extract the data pointer from the string descriptor
  tableDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign tableDesc$, "!G_INO_DSC_KEYMAP"
  tablePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, tablePtr$ + ", " + tableDesc$

  ' Counter for mapped items
  count$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign count$, LTRIM$(STR$(keyMappingCount))

  vkCode$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign vkCode$, qbCode$

  loopScanStart$ = tiraLabelCreateNew$("KD_SCAN_LOOP")
  jmpDoneScan$ = tiraLabelCreateNew$("KD_SCAN_DONE")

  tiraLabel loopScanStart$

  ' If mapped items remain <= 0, we're done (not found in table)
  tiraJmpCond "JLE", count$, "0", jmpDoneScan$

  ' Compare table[index].qbCode with the requested code
  curQb$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, curQb$ + ", " + tablePtr$

  jmpFound$ = tiraLabelCreateNew$("KD_FOUND")
  tiraJmpCond "JE", curQb$, qbCode$, jmpFound$

  ' Advance to next 8-byte entry (qbCode + vkCode layout)
  tiraOp TC_ADD, tablePtr$, tablePtr$, "8"
  tiraOp TC_SUB, count$, count$, "1"
  tiraJmp loopScanStart$

  ' Match found, extract table[index].vkCode
  tiraLabel jmpFound$
  vkPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, vkPtr$, tablePtr$, "4"
  tiraNew TC_READ_MEM, vkCode$ + ", " + vkPtr$

  tiraLabel jmpDoneScan$

  tiraOp TC_AND, vkCode$, vkCode$, "255"

  keyState$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign keyState$, "0"

  IF cm.HasGraphics = 0 THEN
    ' Console mode has no WndProc to populate the keyboard-state array
    tiraCall "IAT_GETASYNCKEYSTATE", 1, vkCode$
    tiraNew TC_GET_RET, keyState$
    tiraOp TC_AND, keyState$, keyState$, "32768"
  ELSE
    ' Setup layout state extraction directly from the WndProc populated array
    stateAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, stateAddr$, "!G_INO_ARR_KBD_STATE", ""
    tiraOp TC_ADD, stateAddr$, stateAddr$, vkCode$

    keyByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, keyByte$ + ", " + stateAddr$

    tiraAssign keyState$, keyByte$
  END IF

  retVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign retVal$, "0"

  jmpIsDown$ = tiraLabelCreateNew$("KD_IS_DOWN")
  tiraJmpCond "JNE", keyState$, "0", jmpIsDown$

  ' Not down (return 0)
  jmpEnd$ = tiraLabelCreateNew$("KD_END")
  tiraJmp jmpEnd$

  tiraLabel jmpIsDown$
  ' Is down (return -1)
  tiraAssign retVal$, "-1"

  tiraLabel jmpEnd$

  ' Route return value to arg1Var$ so it can be extracted to RAX cleanly
  tiraAssign arg1Var$, retVal$

  tiraNew TC_ABI_WRITE_RET, arg1Var$
  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeKeyDown

''''''''''''''''''''''''
SUB emitRuntimeKeyEvent

  ' Polls enabled predefined ON KEY events and dispatches one handler

  rtOffset(RT_KEY_EVENT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  doneLbl$ = tiraLabelCreateNew$("KEY_EVENT_DONE")
  scanTopLbl$ = tiraLabelCreateNew$("KEY_EVENT_SCAN")
  scanNextLbl$ = tiraLabelCreateNew$("KEY_EVENT_NEXT")
  pollKeyLbl$ = tiraLabelCreateNew$("KEY_EVENT_POLL")
  f1ToF10Lbl$ = tiraLabelCreateNew$("KEY_EVENT_F1_F10")
  upKeyLbl$ = tiraLabelCreateNew$("KEY_EVENT_UP")
  leftKeyLbl$ = tiraLabelCreateNew$("KEY_EVENT_LEFT")
  rightKeyLbl$ = tiraLabelCreateNew$("KEY_EVENT_RIGHT")
  downKeyLbl$ = tiraLabelCreateNew$("KEY_EVENT_DOWN")
  keyMappedLbl$ = tiraLabelCreateNew$("KEY_EVENT_MAPPED")
  keyPressedLbl$ = tiraLabelCreateNew$("KEY_EVENT_PRESSED")
  dispatchLbl$ = tiraLabelCreateNew$("KEY_EVENT_DISPATCH")
  eventReturnLbl$ = tiraLabelCreateNew$("KEY_EVENT_RETURN")

  tiraJmpCond "JE", "!G_INO_FLG_KEYANY", "0", doneLbl$
  tiraJmpCond "JNE", "!G_INO_FLG_KEYACTIVE", "0", doneLbl$

  handlerBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, handlerBase$, "!G_INO_ARR_KEYHANDLER", ""

  stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateBase$, "!G_INO_ARR_KEYSTATE", ""

  eventIndex$ = tiraDimVar$("T", TYPE_UINT64)
  tiraAssign eventIndex$, "0"

  stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  stateValue$ = tiraDimVar$("T", TYPE_UINT64)
  modeValue$ = tiraDimVar$("T", TYPE_UINT64)
  pendingValue$ = tiraDimVar$("T", TYPE_UINT64)
  latchValue$ = tiraDimVar$("T", TYPE_UINT64)
  keyCode$ = tiraDimVar$("T", TYPE_LONG)
  keyBits$ = tiraDimVar$("T", TYPE_LONG)
  handlerSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  handlerAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  retAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  gosubBaseVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  gosubSlotVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraLabel scanTopLbl$
  tiraJmpCond "JGE", eventIndex$, LTRIM$(STR$(KEY_EVENT_COUNT)), doneLbl$

  tiraLeaSIB stateSlot$, stateBase$, eventIndex$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
  tiraNew TC_READ_MEM, stateValue$ + ", " + stateSlot$

  tiraOp TC_AND, modeValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_MODE_MASK))
  tiraJmpCond "JE", modeValue$, LTRIM$(STR$(KEY_EVENT_MODE_OFF)), scanNextLbl$

  tiraJmpCond "JNE", modeValue$, LTRIM$(STR$(KEY_EVENT_MODE_ON)), pollKeyLbl$
  tiraOp TC_AND, pendingValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_PENDING_MASK))
  tiraJmpCond "JNE", pendingValue$, "0", dispatchLbl$

  tiraLabel pollKeyLbl$

  tiraJmpCond "JLE", eventIndex$, "9", f1ToF10Lbl$
  tiraJmpCond "JE", eventIndex$, "10", upKeyLbl$
  tiraJmpCond "JE", eventIndex$, "11", leftKeyLbl$
  tiraJmpCond "JE", eventIndex$, "12", rightKeyLbl$
  tiraJmpCond "JE", eventIndex$, "13", downKeyLbl$
  tiraJmpCond "JL", eventIndex$, "29", scanNextLbl$

  tiraAssign keyCode$, eventIndex$
  tiraOp TC_ADD, keyCode$, keyCode$, "93"
  tiraJmp keyMappedLbl$

  tiraLabel f1ToF10Lbl$
  tiraAssign keyCode$, eventIndex$
  tiraOp TC_ADD, keyCode$, keyCode$, "112"
  tiraJmp keyMappedLbl$

  tiraLabel upKeyLbl$
  tiraAssign keyCode$, "38"
  tiraJmp keyMappedLbl$

  tiraLabel leftKeyLbl$
  tiraAssign keyCode$, "37"
  tiraJmp keyMappedLbl$

  tiraLabel rightKeyLbl$
  tiraAssign keyCode$, "39"
  tiraJmp keyMappedLbl$

  tiraLabel downKeyLbl$
  tiraAssign keyCode$, "40"

  tiraLabel keyMappedLbl$

  tiraCall "IAT_GETASYNCKEYSTATE", 1, keyCode$
  tiraNew TC_GET_RET, keyBits$
  tiraOp TC_AND, keyBits$, keyBits$, LTRIM$(STR$(KEY_EVENT_DOWN_MASK))
  tiraJmpCond "JNE", keyBits$, "0", keyPressedLbl$

  tiraOp TC_AND, latchValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_LATCH_MASK))
  tiraOp TC_SUB, stateValue$, stateValue$, latchValue$
  tiraWriteMem stateSlot$, stateValue$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
  tiraJmp scanNextLbl$

  tiraLabel keyPressedLbl$

  tiraOp TC_AND, latchValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_LATCH_MASK))
  tiraJmpCond "JNE", latchValue$, "0", scanNextLbl$

  tiraOp TC_OR, stateValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_LATCH_MASK))
  tiraWriteMem stateSlot$, stateValue$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))

  tiraJmpCond "JNE", modeValue$, LTRIM$(STR$(KEY_EVENT_MODE_STOP)), dispatchLbl$

  tiraOp TC_OR, stateValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_PENDING_MASK))
  tiraWriteMem stateSlot$, stateValue$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
  tiraJmp scanNextLbl$

  tiraLabel dispatchLbl$

  tiraLeaSIB handlerSlot$, handlerBase$, eventIndex$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))
  tiraNew TC_READ_MEM, handlerAddress$ + ", " + handlerSlot$
  tiraJmpCond "JE", handlerAddress$, "0", scanNextLbl$

  tiraOp TC_AND, pendingValue$, stateValue$, LTRIM$(STR$(KEY_EVENT_PENDING_MASK))
  tiraOp TC_SUB, stateValue$, stateValue$, pendingValue$
  tiraWriteMem stateSlot$, stateValue$, LTRIM$(STR$(KEY_EVENT_SLOT_BYTES))

  tiraAssign "!G_INO_FLG_KEYACTIVE", "1"

  tiraOp TC_ADDRESS_OF, retAddrVar$, eventReturnLbl$, ""
  tiraOp TC_ADDRESS_OF, gosubBaseVar$, "!G_SYS_ARR_GOSUB", ""

  tiraLeaSIB gosubSlotVar$, gosubBaseVar$, "!G_SYS_IDX_GOSUB", "8"
  tiraWriteMem gosubSlotVar$, retAddrVar$, "8"
  tiraOp TC_ADD, "!G_SYS_IDX_GOSUB", "!G_SYS_IDX_GOSUB", "1"

  tiraNew TC_JMP_DYN, handlerAddress$

  tiraLabel eventReturnLbl$
  tiraAssign "!G_INO_FLG_KEYACTIVE", "0"
  tiraJmp doneLbl$

  tiraLabel scanNextLbl$
  tiraOp TC_ADD, eventIndex$, eventIndex$, "1"
  tiraJmp scanTopLbl$

  tiraLabel doneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeKeyEvent

''''''''''''''''''''''''
SUB emitRuntimeLimit

  rtOffset(RT_LIMIT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_DOUBLE)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  fpsInt$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_CAST, fpsInt$, arg1Var$, LTRIM$(STR$(TYPE_LONG))

  doneLbl$ = tiraLabelCreateNew$("LIM_DONE")
  tiraJmpCond "JLE", fpsInt$, "0", doneLbl$

  msPerFrame$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_IDIV, msPerFrame$, "1000", fpsInt$

  loopTop$ = tiraLabelCreateNew$("LIM_TOP")
  tiraLabel loopTop$

  tiraCall "IAT_GETTICKCOUNT", 0, ""
  curTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, curTick$

  diffTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, diffTick$, curTick$, "!G_SYS_VAL_LIMIT_TICK"

  tiraJmpCond "JGE", diffTick$, msPerFrame$, doneLbl$

  tiraCall "IAT_SLEEP", 1, "1"
  tiraJmp loopTop$

  tiraLabel doneLbl$
  tiraCall "IAT_GETTICKCOUNT", 0, ""
  newTick$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, newTick$
  tiraAssign "!G_SYS_VAL_LIMIT_TICK", newTick$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeLimit

''''''''''''''''''''''''
SUB emitRuntimeMouseInput

  rtOffset(RT_MOUSEINPUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  headPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, headPtr$, "!G_INO_VAL_MOUSE_HEAD", ""
  headVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, headVal$ + ", " + headPtr$

  tailPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, tailPtr$, "!G_INO_VAL_MOUSE_TAIL", ""
  tailVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, tailVal$ + ", " + tailPtr$

  retVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign retVal$, "0"

  emptyLbl$ = tiraLabelCreateNew$("MI_EMPTY")
  tiraJmpCond "JE", headVal$, tailVal$, emptyLbl$

  bufArrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, bufArrPtr$, "!G_INO_ARR_MOUSE_BUF", ""

  offsetVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetVal$, tailVal$, "16"

  recPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, recPtr$, bufArrPtr$, offsetVal$

  mouseX$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, mouseX$ + ", " + recPtr$

  mouseY$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseY$ + ", " + recPtr$ + ", 4"

  ' Convert client pixels into coordinates belonging to the active SCREEN image
  ' Matching SCREEN and client dimensions preserve RES and MED without extra scaling
  screenWidth$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign screenWidth$, "!G_GFX_V32_SCRNW"

  screenHeight$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign screenHeight$, "!G_GFX_V32_SCRNH"

  clientWidth$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign clientWidth$, "!G_WND_VAL_WIDTH"

  clientHeight$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign clientHeight$, "!G_WND_VAL_HEIGHT"

  mouseScaleDoneLbl$ = tiraLabelCreateNew$("MI_SCALE_DONE")

  tiraJmpCond "JLE", screenWidth$, "0", mouseScaleDoneLbl$
  tiraJmpCond "JLE", screenHeight$, "0", mouseScaleDoneLbl$
  tiraJmpCond "JLE", clientWidth$, "0", mouseScaleDoneLbl$
  tiraJmpCond "JLE", clientHeight$, "0", mouseScaleDoneLbl$

  scaledMouseX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, scaledMouseX$, mouseX$, screenWidth$
  tiraOp TC_IDIV, mouseX$, scaledMouseX$, clientWidth$

  scaledMouseY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, scaledMouseY$, mouseY$, screenHeight$
  tiraOp TC_IDIV, mouseY$, scaledMouseY$, clientHeight$

  screenMaxX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, screenMaxX$, screenWidth$, "1"

  screenMaxY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, screenMaxY$, screenHeight$, "1"

  mouseScaleXInRangeLbl$ = tiraLabelCreateNew$("MI_SCALE_X_RANGE")
  tiraJmpCond "JLE", mouseX$, screenMaxX$, mouseScaleXInRangeLbl$
  tiraAssign mouseX$, screenMaxX$
  tiraLabel mouseScaleXInRangeLbl$

  mouseScaleYInRangeLbl$ = tiraLabelCreateNew$("MI_SCALE_Y_RANGE")
  tiraJmpCond "JLE", mouseY$, screenMaxY$, mouseScaleYInRangeLbl$
  tiraAssign mouseY$, screenMaxY$
  tiraLabel mouseScaleYInRangeLbl$

  tiraLabel mouseScaleDoneLbl$

  tiraAssign "!G_INO_VAL_MOUSE_X", mouseX$
  tiraAssign "!G_INO_VAL_MOUSE_Y", mouseY$

  mouseWheel$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseWheel$ + ", " + recPtr$ + ", 8"
  tiraAssign "!G_INO_VAL_MOUSE_SCRL", mouseWheel$

  mouseBtns$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, mouseBtns$ + ", " + recPtr$ + ", 12"

  b1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b1$, mouseBtns$, "1"
  b1State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b1State$, "0"
  skipB1$ = tiraLabelCreateNew$("MI_SKIPB1")
  tiraJmpCond "JE", b1$, "0", skipB1$
  tiraAssign b1State$, "-1"
  tiraLabel skipB1$
  tiraAssign "!G_INO_VAL_MOUSE_B1", b1State$

  b2$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b2$, mouseBtns$, "2"
  b2State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b2State$, "0"
  skipB2$ = tiraLabelCreateNew$("MI_SKIPB2")
  tiraJmpCond "JE", b2$, "0", skipB2$
  tiraAssign b2State$, "-1"
  tiraLabel skipB2$
  tiraAssign "!G_INO_VAL_MOUSE_B2", b2State$

  b3$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, b3$, mouseBtns$, "4"
  b3State$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign b3State$, "0"
  skipB3$ = tiraLabelCreateNew$("MI_SKIPB3")
  tiraJmpCond "JE", b3$, "0", skipB3$
  tiraAssign b3State$, "-1"
  tiraLabel skipB3$
  tiraAssign "!G_INO_VAL_MOUSE_B3", b3State$

  tiraOp TC_ADD, tailVal$, tailVal$, "1"
  tiraOp TC_AND, tailVal$, tailVal$, "511"
  tiraWriteMem tailPtr$, tailVal$, "4"

  tiraAssign retVal$, "-1"

  tiraLabel emptyLbl$

  tiraNew TC_ABI_WRITE_RET, retVal$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeMouseInput

''''''''''''''''''''''''
SUB emitRuntimeOut

  rtOffset(RT_OUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argPort$ = tiraDimVar$("PORT", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argPort$ + ", 1"

  argVal$ = tiraDimVar$("VAL", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argVal$ + ", 2"

  skipAll$ = tiraLabelCreateNew$("OUT_SKIP_ALL")

  lbl3C7$ = tiraLabelCreateNew$("OUT_3C7")
  lbl3C8$ = tiraLabelCreateNew$("OUT_3C8")
  lbl3C9$ = tiraLabelCreateNew$("OUT_3C9")

  tiraJmpCond "JE", argPort$, "967", lbl3C7$
  tiraJmpCond "JE", argPort$, "968", lbl3C8$
  tiraJmpCond "JE", argPort$, "969", lbl3C9$
  tiraJmp skipAll$

  tiraLabel lbl3C7$
  tiraAssign "!G_GFX_VAL_DAC_READ_IDX", argVal$
  tiraAssign "!G_GFX_VAL_DAC_READ_STEP", "0"
  tiraJmp skipAll$

  tiraLabel lbl3C8$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_IDX", argVal$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_STEP", "0"
  tiraJmp skipAll$

  tiraLabel lbl3C9$
  stepVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign stepVal$, "!G_GFX_VAL_DAC_WRITE_STEP"

  lblStep0$ = tiraLabelCreateNew$("OUT_STEP_0")
  lblStep1$ = tiraLabelCreateNew$("OUT_STEP_1")
  lblStep2$ = tiraLabelCreateNew$("OUT_STEP_2")

  tiraJmpCond "JE", stepVal$, "0", lblStep0$
  tiraJmpCond "JE", stepVal$, "1", lblStep1$
  tiraJmpCond "JE", stepVal$, "2", lblStep2$
  tiraJmp skipAll$

  tiraLabel lblStep0$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_R", argVal$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_STEP", "1"
  tiraJmp skipAll$

  tiraLabel lblStep1$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_G", argVal$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_STEP", "2"
  tiraJmp skipAll$

  tiraLabel lblStep2$
  idxVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign idxVal$, "!G_GFX_VAL_DAC_WRITE_IDX"
  tiraOp TC_AND, idxVal$, idxVal$, "255"

  palOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, palOffset$, idxVal$, "4"

  palData$ = tiraGetStringData$("!G_GFX_DSC_PALETTE")
  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palData$, palOffset$

  valR$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, valR$, "!G_GFX_VAL_DAC_WRITE_R", "4"
  valG$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, valG$, "!G_GFX_VAL_DAC_WRITE_G", "4"
  valB$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, valB$, argVal$, "4"

  addrB$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign addrB$, targetAddr$
  tiraWriteMem addrB$, valB$, "1"

  addrG$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, addrG$, targetAddr$, "1"
  tiraWriteMem addrG$, valG$, "1"

  addrR$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, addrR$, targetAddr$, "2"
  tiraWriteMem addrR$, valR$, "1"

  tiraOp TC_ADD, idxVal$, idxVal$, "1"
  tiraOp TC_AND, idxVal$, idxVal$, "255"
  tiraAssign "!G_GFX_VAL_DAC_WRITE_IDX", idxVal$
  tiraAssign "!G_GFX_VAL_DAC_WRITE_STEP", "0"

  tiraTriggerAutoDisplay

  tiraLabel skipAll$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeOut

''''''''''''''''''''''''
SUB emitRuntimePaint

' Floods an enclosed area of the graphics screen with a solid color or pattern until it hits a specified border boundary

  rtOffset(RT_PAINT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argX$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX$ + ", 1"
  argY$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY$ + ", 2"
  argFillVar$ = tiraDimVar$("ARG3", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argFillVar$ + ", 3"
  argIsStr$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argIsStr$ + ", 4"
  argBorder$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argBorder$ + ", 5"

  doneLbl$ = tiraLabelCreateNew$("PAINT_END")

  tiraOp TC_ADD, argX$, argX$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY$, argY$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  tiraOp TC_AND, argBorder$, argBorder$, "255"

  ' Verify starting bounds are safely within drawing view
  tiraJmpCond "JL", argX$, "!G_GFX_VAL_VIEW_X1", doneLbl$
  tiraJmpCond "JGE", argX$, "!G_GFX_VAL_VIEW_X2", doneLbl$
  tiraJmpCond "JL", argY$, "!G_GFX_VAL_VIEW_Y1", doneLbl$
  tiraJmpCond "JGE", argY$, "!G_GFX_VAL_VIEW_Y2", doneLbl$

  ' Prevent infinite loops for identically matched solid color fills
  skipInitCheck$ = tiraLabelCreateNew$("PAINT_SKIP_INIT")
  tiraJmpCond "JE", argIsStr$, "1", skipInitCheck$

  fillMask$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, fillMask$, argFillVar$, "255"

  offsetStart$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetStart$, argY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offsetStart$, offsetStart$, argX$

  fPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fPtr$, "!G_GFX_PTR_DEST_FRMB", offsetStart$

  fByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, fByte$ + ", " + fPtr$

  tiraJmpCond "JE", fByte$, fillMask$, doneLbl$

  tiraLabel skipInitCheck$

  ' Allocate memory for the recursive stack mapping securely on the temporary heap
  memBlock$ = tiraAllocTempMem$("1500000")
  visitedBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign visitedBase$, memBlock$
  queueBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, queueBase$, memBlock$, "1200000"

  ' Clear visited array to prepare for clean memory tracking
  fbSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, fbSize$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), LTRIM$(RTRIM$(STR$(gfxConfig.SizeY)))
  tiraMemSet visitedBase$, "0", fbSize$

  qHead$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qHead$, "0"
  qTail$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign qTail$, "0"

  pushX$ = tiraDimVar$("T", TYPE_LONG)
  pushY$ = tiraDimVar$("T", TYPE_LONG)
  qOffset$ = tiraDimVar$("T", TYPE_LONG)
  qPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraAssign pushX$, argX$
  tiraAssign pushY$, argY$

  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"

  popX$ = tiraDimVar$("T", TYPE_LONG)
  popY$ = tiraDimVar$("T", TYPE_LONG)
  curX$ = tiraDimVar$("T", TYPE_LONG)
  curY$ = tiraDimVar$("T", TYPE_LONG)

  checkX$ = tiraDimVar$("T", TYPE_LONG)
  checkY$ = tiraDimVar$("T", TYPE_LONG)
  isValid$ = tiraDimVar$("T", TYPE_LONG)
  vOffset$ = tiraDimVar$("T", TYPE_LONG)
  vPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  vByte$ = tiraDimVar$("T", TYPE_UBYTE)
  cByte$ = tiraDimVar$("T", TYPE_UBYTE)
  cPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  loopTop$ = tiraLabelCreateNew$("PAINT_LOOP")
  tiraLabel loopTop$

  tiraJmpCond "JE", qHead$, qTail$, doneLbl$

  tiraOp TC_MUL, qOffset$, qTail$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraNew TC_READ_MEM, popX$ + ", " + qPtr$
  tiraNew TC_READ_MEM_OFFSET, popY$ + ", " + qPtr$ + ", 4"
  tiraOp TC_ADD, qTail$, qTail$, "1"

  tiraAssign curX$, popX$
  tiraAssign curY$, popY$

  lblMoveLeft$ = tiraLabelCreateNew$("PAINT_LEFT")
  lblMoveLeftEnd$ = tiraLabelCreateNew$("PAINT_LEFT_END")
  tiraLabel lblMoveLeft$
  tiraOp TC_SUB, curX$, curX$, "1"
  tiraAssign checkX$, curX$
  tiraAssign checkY$, curY$

  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblMoveLeftEnd$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblMoveLeftEnd$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblMoveLeftEnd$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblMoveLeftEnd$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblMoveLeftEnd$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblMoveLeftEnd$
  tiraAssign isValid$, "1"
  tiraJmp lblMoveLeft$
  tiraLabel lblMoveLeftEnd$

  tiraOp TC_ADD, curX$, curX$, "1"

  spanAbove$ = tiraDimVar$("T", TYPE_LONG)
  spanBelow$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign spanAbove$, "0"
  tiraAssign spanBelow$, "0"

  lblScan$ = tiraLabelCreateNew$("PAINT_SCAN")
  lblScanEnd$ = tiraLabelCreateNew$("PAINT_SCAN_END")
  tiraLabel lblScan$
  tiraAssign checkX$, curX$
  tiraAssign checkY$, curY$

  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblScanEnd$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblScanEnd$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblScanEnd$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblScanEnd$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblScanEnd$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblScanEnd$
  tiraAssign isValid$, "1"

  tiraWriteMem vPtr$, "1", "1"

  lblSolid$ = tiraLabelCreateNew$("PAINT_SOLID")
  lblApply$ = tiraLabelCreateNew$("PAINT_APPLY")
  drawColor$ = tiraDimVar$("T", TYPE_LONG)

  tiraJmpCond "JE", argIsStr$, "0", lblSolid$

  strLen$ = tiraGetStringLen$(argFillVar$)
  strData$ = tiraGetStringData$(argFillVar$)
  tiraJmpCond "JLE", strLen$, "0", lblSolid$

  ' SCREEN 13 natively treats tiling string bytes as entire scanline color fills
  patIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MOD, patIdx$, curY$, strLen$

  charPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, charPtr$, strData$, patIdx$

  charByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, charByte$ + ", " + charPtr$
  tiraAssign drawColor$, charByte$

  tiraJmp lblApply$

  tiraLabel lblSolid$
  tiraAssign drawColor$, fillMask$

  tiraLabel lblApply$
  tiraWriteMem cPtr$, drawColor$, "1"

  lblAboveSkip$ = tiraLabelCreateNew$("PAINT_ABOVE_SKIP")
  lblAboveDone$ = tiraLabelCreateNew$("PAINT_ABOVE_DONE")
  tiraOp TC_SUB, checkY$, curY$, "1"
  tiraAssign checkX$, curX$
  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblAboveSkip$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblAboveSkip$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblAboveSkip$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblAboveSkip$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblAboveSkip$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblAboveSkip$
  tiraAssign isValid$, "1"
  tiraJmpCond "JNE", spanAbove$, "0", lblAboveDone$
  tiraAssign pushX$, curX$
  tiraAssign pushY$, checkY$
  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"
  tiraAssign spanAbove$, "1"
  tiraJmp lblAboveDone$

  tiraLabel lblAboveSkip$
  tiraAssign spanAbove$, "0"
  tiraLabel lblAboveDone$

  lblBelowSkip$ = tiraLabelCreateNew$("PAINT_BELOW_SKIP")
  lblBelowDone$ = tiraLabelCreateNew$("PAINT_BELOW_DONE")
  tiraOp TC_ADD, checkY$, curY$, "1"
  tiraAssign checkX$, curX$
  tiraAssign isValid$, "0"
  tiraJmpCond "JL", checkX$, "!G_GFX_VAL_VIEW_X1", lblBelowSkip$
  tiraJmpCond "JGE", checkX$, "!G_GFX_VAL_VIEW_X2", lblBelowSkip$
  tiraJmpCond "JL", checkY$, "!G_GFX_VAL_VIEW_Y1", lblBelowSkip$
  tiraJmpCond "JGE", checkY$, "!G_GFX_VAL_VIEW_Y2", lblBelowSkip$
  tiraOp TC_MUL, vOffset$, checkY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, vOffset$, vOffset$, checkX$
  tiraOp TC_ADD, vPtr$, visitedBase$, vOffset$
  tiraNew TC_READ_MEM, vByte$ + ", " + vPtr$
  tiraJmpCond "JNE", vByte$, "0", lblBelowSkip$
  tiraOp TC_ADD, cPtr$, "!G_GFX_PTR_DEST_FRMB", vOffset$
  tiraNew TC_READ_MEM, cByte$ + ", " + cPtr$
  tiraJmpCond "JE", cByte$, argBorder$, lblBelowSkip$
  tiraAssign isValid$, "1"
  tiraJmpCond "JNE", spanBelow$, "0", lblBelowDone$
  tiraAssign pushX$, curX$
  tiraAssign pushY$, checkY$
  tiraOp TC_MUL, qOffset$, qHead$, "8"
  tiraOp TC_ADD, qPtr$, queueBase$, qOffset$
  tiraWriteMem qPtr$, pushX$, "4"
  tiraNew TC_WRITE_MEM_OFFSET, qPtr$ + ", 4, " + pushY$ + ", 4"
  tiraOp TC_ADD, qHead$, qHead$, "1"
  tiraAssign spanBelow$, "1"
  tiraJmp lblBelowDone$

  tiraLabel lblBelowSkip$
  tiraAssign spanBelow$, "0"
  tiraLabel lblBelowDone$

  tiraOp TC_ADD, curX$, curX$, "1"
  tiraJmp lblScan$
  tiraLabel lblScanEnd$

  tiraJmp loopTop$

  tiraLabel doneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePaint

''''''''''''''''''''''''
SUB emitRuntimePcopy

  rtOffset(RT_PCOPY) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argSrc$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argSrc$ + ", 1"
  argDest$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argDest$ + ", 2"

  lblDone$ = tiraLabelCreateNew$("PCOPY_DONE")

  ' Skip if src equals dest
  tiraJmpCond "JE", argSrc$, argDest$, lblDone$

  ' Validate pages (0 to 3 natively supported)
  tiraJmpCond "JL", argSrc$, "0", lblDone$
  tiraJmpCond "JG", argSrc$, "3", lblDone$
  tiraJmpCond "JL", argDest$, "0", lblDone$
  tiraJmpCond "JG", argDest$, "3", lblDone$

  ' Acquire Spinlock safely using hardware XCHG
  lblSpin$ = tiraLabelCreateNew$("PCOPY_SPIN")
  lblAcq$ = tiraLabelCreateNew$("PCOPY_ACQ")
  tiraLabel lblSpin$
  spinVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign spinVal$, "1"
  tiraNew TC_XCHG, "!G_WND_FLG_RENDER_LOCK, " + spinVal$ + ", 4"
  tiraJmpCond "JE", spinVal$, "0", lblAcq$
  tiraCall "IAT_SLEEP", 1, "0"
  tiraJmp lblSpin$
  tiraLabel lblAcq$

  fbSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign fbSize$, LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

  txtSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign txtSize$, LTRIM$(STR$(4096 * layout.GfxBufEntrySize))

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  ptrSrcFb$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptrSrcBuf$ = tiraDimVar$("T", TYPE_INTEGER64)
  cntSrcBuf$ = tiraDimVar$("T", TYPE_LONG)

  tiraJmpCond "JE", argSrc$, "0", lblSrc0$
  tiraJmpCond "JE", argSrc$, "1", lblSrc1$
  tiraJmpCond "JE", argSrc$, "2", lblSrc2$
  tiraJmpCond "JE", argSrc$, "3", lblSrc3$
  tiraJmp lblDone$

  tiraLabel lblSrc0$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_BACK"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_BACK"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE1"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_PAGE1"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_PAGE1"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_PAGE2"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_PAGE2"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign ptrSrcBuf$, "!G_GFX_PTR_BUFR_PAGE3"
  tiraAssign cntSrcBuf$, "!G_GFX_VAL_BUFR_COUNT_PAGE3"

  tiraLabel lblSrcEnd$

  lblDest0$ = tiraLabelCreateNew$("DEST_0")
  lblDest1$ = tiraLabelCreateNew$("DEST_1")
  lblDest2$ = tiraLabelCreateNew$("DEST_2")
  lblDest3$ = tiraLabelCreateNew$("DEST_3")
  lblDestEnd$ = tiraLabelCreateNew$("DEST_END")

  ptrDestFb$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptrDestBuf$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argDest$, "0", lblDest0$
  tiraJmpCond "JE", argDest$, "1", lblDest1$
  tiraJmpCond "JE", argDest$, "2", lblDest2$
  tiraJmpCond "JE", argDest$, "3", lblDest3$
  tiraJmp lblDone$

  tiraLabel lblDest0$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_BACK"
  tiraJmp lblDestEnd$

  tiraLabel lblDest1$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE1"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_PAGE1"
  tiraJmp lblDestEnd$

  tiraLabel lblDest2$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_PAGE2"
  tiraJmp lblDestEnd$

  tiraLabel lblDest3$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign ptrDestBuf$, "!G_GFX_PTR_BUFR_PAGE3"

  tiraLabel lblDestEnd$

  tiraMemcpy ptrDestFb$, ptrSrcFb$, fbSize$
  tiraMemcpy ptrDestBuf$, ptrSrcBuf$, txtSize$

  lblWrite0$ = tiraLabelCreateNew$("WR_0")
  lblWrite1$ = tiraLabelCreateNew$("WR_1")
  lblWrite2$ = tiraLabelCreateNew$("WR_2")
  lblWrite3$ = tiraLabelCreateNew$("WR_3")
  lblWriteEnd$ = tiraLabelCreateNew$("WR_END")

  tiraJmpCond "JE", argDest$, "0", lblWrite0$
  tiraJmpCond "JE", argDest$, "1", lblWrite1$
  tiraJmpCond "JE", argDest$, "2", lblWrite2$
  tiraJmpCond "JE", argDest$, "3", lblWrite3$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite0$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_BACK", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite1$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE1", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite2$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE2", cntSrcBuf$
  tiraJmp lblWriteEnd$

  tiraLabel lblWrite3$
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE3", cntSrcBuf$

  tiraLabel lblWriteEnd$

  ' Release Spinlock
  tiraAssign "!G_WND_FLG_RENDER_LOCK", "0"

  ' Instruct Windows to repaint the window using the newly swapped destination buffer ONLY if it is the active visual frame (Page 1 / FRONT)
  ' Explicit paging compares the destination against the selected visual page
  tiraRefreshVisualPage argDest$

  lblSkipRedraw$ = tiraLabelCreateNew$("SKIP_REDRAW")
  tiraJmpCond "JNE", "!G_GFX_FLG_PAGING", "0", lblSkipRedraw$
  tiraJmpCond "JNE", argDest$, "1", lblSkipRedraw$
  tiraCall "IAT_INVALIDATERECT", 3, "!G_WND_VAL_HWND, 0, 0"
  tiraLabel lblSkipRedraw$

  tiraLabel lblDone$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePcopy

''''''''''''''''''''''''
SUB emitRuntimePlotPixel

  '''' RT_PLOT_PIXEL
  rtOffset(RT_PLOT_PIXEL) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"
  arg2Var$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"
  arg3Var$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg3Var$ + ", 3"

  endLbl$ = tiraLabelCreateNew$("PLOT_END")

  ' Shift target coordinates into absolute mapped variables utilizing global offsets
  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, arg1Var$, "!G_GFX_VAL_VIEW_OFFSET_X"
  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, arg2Var$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ' Execute strict bounds testing securely trapping plotting within graphical VIEW logic
  tiraJmpCond "JL", absX$, "!G_GFX_VAL_VIEW_X1", endLbl$
  tiraJmpCond "JGE", absX$, "!G_GFX_VAL_VIEW_X2", endLbl$
  tiraJmpCond "JL", absY$, "!G_GFX_VAL_VIEW_Y1", endLbl$
  tiraJmpCond "JGE", absY$, "!G_GFX_VAL_VIEW_Y2", endLbl$

  ' Unsigned JAE hardware test to physically prevent screen buffer overrun exceptions
  tiraJmpCond "JAE", absX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), endLbl$
  tiraJmpCond "JAE", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), endLbl$

  ' Calculate offset targeting the working screen buffer
  tiraOp TC_MUL, "!G_GFX_IDX_PLOT_OFFSET", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, "!G_GFX_IDX_PLOT_OFFSET", "!G_GFX_IDX_PLOT_OFFSET", absX$

  ' Fetch framebuffer base pointer dynamically through the targeted active destination memory
  tiraAssign "!G_GFX_PTR_PLOT_FBBASE", "!G_GFX_PTR_DEST_FRMB"

  ' Target address
  tiraOp TC_ADD, "!G_GFX_PTR_PLOT_TARGET", "!G_GFX_PTR_PLOT_FBBASE", "!G_GFX_IDX_PLOT_OFFSET"

  ' Write byte to framebuffer
  tiraWriteMem "!G_GFX_PTR_PLOT_TARGET", arg3Var$, "1"

  tiraAssign "!G_GFX_FLG_DISPLAYI_PENDING", "1"

  tiraLabel endLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePlotPixel

''''''''''''''''''''''''
SUB emitRuntimePrintUsing

  rtOffset(RT_PRINT_USING) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argFormat$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argFormat$ + ", 1"

  argStatePtr$ = tiraDimVar$("ARG2", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argStatePtr$ + ", 2"

  argKind$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argKind$ + ", 3"

  argInteger$ = tiraDimVar$("ARG4", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argInteger$ + ", 4"

  argNumber$ = tiraDimVar$("ARG5", TYPE_DOUBLE)
  tiraNew TC_ABI_READ_ARG, argNumber$ + ", 5"

  argString$ = tiraDimVar$("ARG6", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argString$ + ", 6"

  formatData$ = tiraGetStringData$(argFormat$)
  formatLength$ = tiraGetStringLen$(argFormat$)

  startPosition$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, startPosition$ + ", " + argStatePtr$

  scanPosition$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign scanPosition$, startPosition$

  itemDone$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign itemDone$, "0"

  charAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  charValue$ = tiraDimVar$("T", TYPE_UBYTE)
  charsLeft$ = tiraDimVar$("T", TYPE_LONG)
  fieldStart$ = tiraDimVar$("T", TYPE_LONG)
  fieldEnd$ = tiraDimVar$("T", TYPE_LONG)
  probePosition$ = tiraDimVar$("T", TYPE_LONG)
  probeAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  probeChar$ = tiraDimVar$("T", TYPE_UBYTE)
  nextChar1$ = tiraDimVar$("T", TYPE_UBYTE)
  nextChar2$ = tiraDimVar$("T", TYPE_UBYTE)
  nextChar3$ = tiraDimVar$("T", TYPE_UBYTE)
  nextChar4$ = tiraDimVar$("T", TYPE_UBYTE)

  formatStage$ = tiraDimVar$("T", TYPE_LONG)
  leadingPlus$ = tiraDimVar$("T", TYPE_LONG)
  dollarSign$ = tiraDimVar$("T", TYPE_LONG)
  asteriskFill$ = tiraDimVar$("T", TYPE_LONG)
  formatDigitsBefore$ = tiraDimVar$("T", TYPE_LONG)
  commaFlag$ = tiraDimVar$("T", TYPE_LONG)
  decimalPoint$ = tiraDimVar$("T", TYPE_LONG)
  formatDigitsAfter$ = tiraDimVar$("T", TYPE_LONG)
  trailingPlus$ = tiraDimVar$("T", TYPE_LONG)
  formatExponentDigits$ = tiraDimVar$("T", TYPE_LONG)
  trailingMinus$ = tiraDimVar$("T", TYPE_LONG)
  hashCount$ = tiraDimVar$("T", TYPE_LONG)
  totalDigits$ = tiraDimVar$("T", TYPE_LONG)

  stringWidth$ = tiraDimVar$("T", TYPE_LONG)
  stringMode$ = tiraDimVar$("T", TYPE_LONG)
  stringData$ = tiraDimVar$("T", TYPE_INTEGER64)
  stringLength$ = tiraDimVar$("T", TYPE_LONG)
  stringCopyCount$ = tiraDimVar$("T", TYPE_LONG)
  stringFieldPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  scratchBase$ = tiraAllocTempMem$("1024")
  rawPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign rawPtr$, scratchBase$

  digitsPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, digitsPtr$, scratchBase$, "128"

  fieldPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fieldPtr$, scratchBase$, "256"

  outDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, outDesc$, scratchBase$, "992"

  signedFormatPtr$ = tiraGetStringData$(CHR$(34) + "%I64d" + CHR$(34))
  unsignedFormatPtr$ = tiraGetStringData$(CHR$(34) + "%I64u" + CHR$(34))
  floatFormatPtr$ = tiraGetStringData$(CHR$(34) + "% .25E" + CHR$(34))
  exponentFormatPtr$ = tiraGetStringData$(CHR$(34) + "%d" + CHR$(34))

  rawLength$ = tiraDimVar$("T", TYPE_LONG)
  digitCount$ = tiraDimVar$("T", TYPE_LONG)
  decimalAdjust$ = tiraDimVar$("T", TYPE_LONG)
  isNegative$ = tiraDimVar$("T", TYPE_LONG)
  digitSource$ = tiraDimVar$("T", TYPE_INTEGER64)
  rawIndex$ = tiraDimVar$("T", TYPE_LONG)
  digitAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  digitByte$ = tiraDimVar$("T", TYPE_UBYTE)
  exponentNegative$ = tiraDimVar$("T", TYPE_LONG)
  exponentValue$ = tiraDimVar$("T", TYPE_LONG)
  sawDigit$ = tiraDimVar$("T", TYPE_LONG)
  exponentChar$ = tiraDimVar$("T", TYPE_UBYTE)
  rounded$ = tiraDimVar$("T", TYPE_LONG)

  useDigitsBefore$ = tiraDimVar$("T", TYPE_LONG)
  useDigitsAfter$ = tiraDimVar$("T", TYPE_LONG)
  useDecimalPoint$ = tiraDimVar$("T", TYPE_LONG)
  useExponentDigits$ = tiraDimVar$("T", TYPE_LONG)
  extraSignSpace$ = tiraDimVar$("T", TYPE_LONG)
  digitsAndCommasBefore$ = tiraDimVar$("T", TYPE_LONG)
  cannotFit$ = tiraDimVar$("T", TYPE_LONG)
  leadingZero$ = tiraDimVar$("T", TYPE_LONG)
  fillByte$ = tiraDimVar$("T", TYPE_UBYTE)
  wholeDigits$ = tiraDimVar$("T", TYPE_LONG)
  tempCalc$ = tiraDimVar$("T", TYPE_LONG)
  absoluteExponent$ = tiraDimVar$("T", TYPE_LONG)
  exponentTextLength$ = tiraDimVar$("T", TYPE_LONG)

  outPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  outLength$ = tiraDimVar$("T", TYPE_LONG)
  digitIndex$ = tiraDimVar$("T", TYPE_LONG)
  loopIndex$ = tiraDimVar$("T", TYPE_LONG)
  loopLimit$ = tiraDimVar$("T", TYPE_LONG)
  remainingChars$ = tiraDimVar$("T", TYPE_LONG)
  zeroGap$ = tiraDimVar$("T", TYPE_LONG)
  leadingCount$ = tiraDimVar$("T", TYPE_LONG)
  currentDigitAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  currentDigit$ = tiraDimVar$("T", TYPE_UBYTE)
  usedDigits$ = tiraDimVar$("T", TYPE_LONG)
  nextDigitAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  nextDigit$ = tiraDimVar$("T", TYPE_UBYTE)
  roundIndex$ = tiraDimVar$("T", TYPE_LONG)
  shiftIndex$ = tiraDimVar$("T", TYPE_LONG)
  sourceAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  destAddress$ = tiraDimVar$("T", TYPE_INTEGER64)
  roundMode$ = tiraDimVar$("T", TYPE_LONG)

  literalPosition$ = tiraDimVar$("T", TYPE_LONG)
  literalAddress$ = tiraDimVar$("T", TYPE_INTEGER64)

  scanTopLbl$ = tiraLabelCreateNew$("PU_SCAN")
  scanEndLbl$ = tiraLabelCreateNew$("PU_SCAN_END")
  scanWrapLbl$ = tiraLabelCreateNew$("PU_WRAP")
  doneLbl$ = tiraLabelCreateNew$("PU_DONE")
  errorLbl$ = tiraLabelCreateNew$("PU_ERROR")

  numericProbeTopLbl$ = tiraLabelCreateNew$("PU_NUM_PROBE")
  numericCheckExponentLbl$ = tiraLabelCreateNew$("PU_NUM_EXP_CHECK")
  numericCheckFourCaretsLbl$ = tiraLabelCreateNew$("PU_NUM_EXP4_CHECK")
  numericCheckFractionLbl$ = tiraLabelCreateNew$("PU_NUM_FRAC_CHECK")
  numericCheckCommaLbl$ = tiraLabelCreateNew$("PU_NUM_COMMA_CHECK")
  numericCheckHashLbl$ = tiraLabelCreateNew$("PU_NUM_HASH_CHECK")
  numericCheckPointLbl$ = tiraLabelCreateNew$("PU_NUM_POINT_CHECK")
  numericCheckSpecialLbl$ = tiraLabelCreateNew$("PU_NUM_SPECIAL_CHECK")
  numericCheckStarsLbl$ = tiraLabelCreateNew$("PU_NUM_STARS_CHECK")
  numericCheckDollarLbl$ = tiraLabelCreateNew$("PU_NUM_DOLLAR_CHECK")
  numericCheckLeadingPlusLbl$ = tiraLabelCreateNew$("PU_NUM_PLUS_CHECK")
  numericTrailingPlusLbl$ = tiraLabelCreateNew$("PU_NUM_TRAIL_PLUS")
  numericTrailingMinusLbl$ = tiraLabelCreateNew$("PU_NUM_TRAIL_MINUS")
  numericProbeDoneLbl$ = tiraLabelCreateNew$("PU_NUM_DONE")

  stringProbeLbl$ = tiraLabelCreateNew$("PU_STR_PROBE")
  stringAmpLbl$ = tiraLabelCreateNew$("PU_STR_AMP")
  stringBangLbl$ = tiraLabelCreateNew$("PU_STR_BANG")
  stringSlashLbl$ = tiraLabelCreateNew$("PU_STR_SLASH")
  stringSlashTopLbl$ = tiraLabelCreateNew$("PU_STR_SLASH_LOOP")
  stringSlashCloseLbl$ = tiraLabelCreateNew$("PU_STR_SLASH_CLOSE")
  stringValidLbl$ = tiraLabelCreateNew$("PU_STR_VALID")
  stringWholeLbl$ = tiraLabelCreateNew$("PU_STR_WHOLE")
  stringFirstLbl$ = tiraLabelCreateNew$("PU_STR_FIRST")
  stringFirstReadyLbl$ = tiraLabelCreateNew$("PU_STR_FIRST_READY")
  stringFixedLbl$ = tiraLabelCreateNew$("PU_STR_FIXED")
  stringCopyReadyLbl$ = tiraLabelCreateNew$("PU_STR_COPY_READY")
  stringDoneLbl$ = tiraLabelCreateNew$("PU_STR_DONE")

  literalLbl$ = tiraLabelCreateNew$("PU_LITERAL")
  literalReadyLbl$ = tiraLabelCreateNew$("PU_LITERAL_READY")

  numberSignedLbl$ = tiraLabelCreateNew$("PU_SIGNED")
  numberSignedReadyLbl$ = tiraLabelCreateNew$("PU_SIGNED_READY")
  numberUnsignedLbl$ = tiraLabelCreateNew$("PU_UNSIGNED")
  numberFloatLbl$ = tiraLabelCreateNew$("PU_FLOAT")
  floatSignReadyLbl$ = tiraLabelCreateNew$("PU_FLOAT_SIGN_READY")
  floatWholeTopLbl$ = tiraLabelCreateNew$("PU_FLOAT_WHOLE")
  floatPointLbl$ = tiraLabelCreateNew$("PU_FLOAT_POINT")
  floatFractionTopLbl$ = tiraLabelCreateNew$("PU_FLOAT_FRACTION")
  floatExponentLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXPONENT")
  floatExponentSignReadyLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXP_SIGN_READY")
  floatExponentInitLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXP_INIT")
  floatExponentTopLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXP_LOOP")
  floatExponentDoneLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXP_DONE")
  floatExponentPositiveLbl$ = tiraLabelCreateNew$("PU_FLOAT_EXP_POSITIVE")
  floatKindReadyLbl$ = tiraLabelCreateNew$("PU_FLOAT_KIND_READY")

  formatRepassLbl$ = tiraLabelCreateNew$("PU_FORMAT_REPASS")
  formatFillReadyLbl$ = tiraLabelCreateNew$("PU_FORMAT_FILL_READY")
  formatFixedAdjustLbl$ = tiraLabelCreateNew$("PU_FORMAT_FIXED_ADJUST")
  formatFixedSignDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_FIXED_SIGN_DONE")
  formatCommaDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_COMMA_DONE")
  formatExponentReserveDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_RESERVE_DONE")
  formatExponentAfterBeforeLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_AFTER_BEFORE")
  formatZeroCheckLbl$ = tiraLabelCreateNew$("PU_FORMAT_ZERO_CHECK")
  formatZeroDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_ZERO_DONE")
  formatExponentFitLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_FIT")
  formatExponentGivebackDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_GIVEBACK_DONE")
  formatExponentNotEmptyLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_NOT_EMPTY")
  formatExponentAbsoluteReadyLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_ABS_READY")
  formatExponentSizeReadyLbl$ = tiraLabelCreateNew$("PU_FORMAT_EXP_SIZE_READY")
  formatFixedFitLbl$ = tiraLabelCreateNew$("PU_FORMAT_FIXED_FIT")
  formatFixedFitDoneLbl$ = tiraLabelCreateNew$("PU_FORMAT_FIXED_FIT_DONE")

  buildFixedLbl$ = tiraLabelCreateNew$("PU_BUILD_FIXED")
  fixedOverflowDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_OVERFLOW_DONE")
  fixedLeadingSignReadyLbl$ = tiraLabelCreateNew$("PU_FIXED_LEADING_SIGN_READY")
  fixedLeadingSignDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_LEADING_SIGN_DONE")
  fixedZeroGapDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_ZERO_GAP_DONE")
  fixedCommaSizeDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_COMMA_SIZE_DONE")
  fixedRemainingReadyLbl$ = tiraLabelCreateNew$("PU_FIXED_REMAINING_READY")
  fixedLeadingZeroDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_LEADING_ZERO_DONE")
  fixedFillTopLbl$ = tiraLabelCreateNew$("PU_FIXED_FILL")
  fixedFillDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_FILL_DONE")
  fixedExtraSignDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_EXTRA_SIGN_DONE")
  fixedDollarDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_DOLLAR_DONE")
  fixedLeadingZeroPrintDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_ZERO_PRINT_DONE")
  fixedWholeTopLbl$ = tiraLabelCreateNew$("PU_FIXED_WHOLE")
  fixedWholeDigitLbl$ = tiraLabelCreateNew$("PU_FIXED_WHOLE_DIGIT")
  fixedWholeDigitReadyLbl$ = tiraLabelCreateNew$("PU_FIXED_WHOLE_DIGIT_READY")
  fixedWholeStepLbl$ = tiraLabelCreateNew$("PU_FIXED_WHOLE_STEP")
  fixedWholeDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_WHOLE_DONE")
  fixedPointDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_POINT_DONE")
  fixedFractionTopLbl$ = tiraLabelCreateNew$("PU_FIXED_FRACTION")
  fixedFractionDigitLbl$ = tiraLabelCreateNew$("PU_FIXED_FRACTION_DIGIT")
  fixedFractionDigitReadyLbl$ = tiraLabelCreateNew$("PU_FIXED_FRACTION_DIGIT_READY")
  fixedFractionDoneLbl$ = tiraLabelCreateNew$("PU_FIXED_FRACTION_DONE")

  buildExponentLbl$ = tiraLabelCreateNew$("PU_BUILD_EXPONENT")
  exponentOverflowDoneLbl$ = tiraLabelCreateNew$("PU_EXP_OVERFLOW_DONE")
  exponentLeadingSignReadyLbl$ = tiraLabelCreateNew$("PU_EXP_LEADING_SIGN_READY")
  exponentLeadingSignDoneLbl$ = tiraLabelCreateNew$("PU_EXP_LEADING_SIGN_DONE")
  exponentDollarDoneLbl$ = tiraLabelCreateNew$("PU_EXP_DOLLAR_DONE")
  exponentExtraSignReadyLbl$ = tiraLabelCreateNew$("PU_EXP_EXTRA_SIGN_READY")
  exponentExtraSignDoneLbl$ = tiraLabelCreateNew$("PU_EXP_EXTRA_SIGN_DONE")
  exponentExtraPrintDoneLbl$ = tiraLabelCreateNew$("PU_EXP_EXTRA_PRINT_DONE")
  exponentWholeTopLbl$ = tiraLabelCreateNew$("PU_EXP_WHOLE")
  exponentWholeDigitReadyLbl$ = tiraLabelCreateNew$("PU_EXP_WHOLE_DIGIT_READY")
  exponentWholeDoneLbl$ = tiraLabelCreateNew$("PU_EXP_WHOLE_DONE")
  exponentPointDoneLbl$ = tiraLabelCreateNew$("PU_EXP_POINT_DONE")
  exponentFractionTopLbl$ = tiraLabelCreateNew$("PU_EXP_FRACTION")
  exponentFractionDigitReadyLbl$ = tiraLabelCreateNew$("PU_EXP_FRACTION_DIGIT_READY")
  exponentFractionDoneLbl$ = tiraLabelCreateNew$("PU_EXP_FRACTION_DONE")

  roundCheckLbl$ = tiraLabelCreateNew$("PU_ROUND_CHECK")
  roundShiftRightTopLbl$ = tiraLabelCreateNew$("PU_ROUND_SHIFT_RIGHT")
  roundShiftRightDoneLbl$ = tiraLabelCreateNew$("PU_ROUND_SHIFT_RIGHT_DONE")
  roundCarryTopLbl$ = tiraLabelCreateNew$("PU_ROUND_CARRY")
  roundCarryStoreLbl$ = tiraLabelCreateNew$("PU_ROUND_CARRY_STORE")
  roundCarryDoneLbl$ = tiraLabelCreateNew$("PU_ROUND_CARRY_DONE")
  roundShiftLeftTopLbl$ = tiraLabelCreateNew$("PU_ROUND_SHIFT_LEFT")
  roundShiftLeftDoneLbl$ = tiraLabelCreateNew$("PU_ROUND_SHIFT_LEFT_DONE")
  numberOutputReadyLbl$ = tiraLabelCreateNew$("PU_NUMBER_OUTPUT_READY")

  appendExponentLbl$ = tiraLabelCreateNew$("PU_APPEND_EXPONENT")
  appendExponentSignReadyLbl$ = tiraLabelCreateNew$("PU_APPEND_EXP_SIGN_READY")
  appendExponentZeroTopLbl$ = tiraLabelCreateNew$("PU_APPEND_EXP_ZERO")
  appendExponentZeroDoneLbl$ = tiraLabelCreateNew$("PU_APPEND_EXP_ZERO_DONE")
  appendExponentTextTopLbl$ = tiraLabelCreateNew$("PU_APPEND_EXP_TEXT")
  appendExponentTextDoneLbl$ = tiraLabelCreateNew$("PU_APPEND_EXP_TEXT_DONE")
  appendTrailingLbl$ = tiraLabelCreateNew$("PU_APPEND_TRAILING")
  appendTrailingPlusReadyLbl$ = tiraLabelCreateNew$("PU_APPEND_TRAIL_PLUS_READY")
  appendTrailingPlusDoneLbl$ = tiraLabelCreateNew$("PU_APPEND_TRAIL_PLUS_DONE")
  appendTrailingMinusReadyLbl$ = tiraLabelCreateNew$("PU_APPEND_TRAIL_MINUS_READY")
  appendTrailingMinusDoneLbl$ = tiraLabelCreateNew$("PU_APPEND_TRAIL_MINUS_DONE")

  tiraJmpCond "JLE", formatLength$, "0", errorLbl$
  tiraJmpCond "JL", startPosition$, "0", errorLbl$
  tiraJmpCond "JG", startPosition$, formatLength$, errorLbl$

  tiraLabel scanTopLbl$
  tiraJmpCond "JGE", scanPosition$, formatLength$, scanEndLbl$

  tiraOp TC_ADD, charAddress$, formatData$, scanPosition$
  tiraNew TC_READ_MEM, charValue$ + ", " + charAddress$

  tiraAssign fieldStart$, scanPosition$
  tiraAssign probePosition$, scanPosition$
  tiraAssign formatStage$, "0"
  tiraAssign leadingPlus$, "0"
  tiraAssign dollarSign$, "0"
  tiraAssign asteriskFill$, "0"
  tiraAssign formatDigitsBefore$, "0"
  tiraAssign commaFlag$, "0"
  tiraAssign decimalPoint$, "0"
  tiraAssign formatDigitsAfter$, "0"
  tiraAssign trailingPlus$, "0"
  tiraAssign formatExponentDigits$, "0"
  tiraAssign trailingMinus$, "0"
  tiraAssign hashCount$, "0"

  tiraLabel numericProbeTopLbl$
  tiraJmpCond "JGE", probePosition$, formatLength$, numericProbeDoneLbl$

  tiraOp TC_ADD, probeAddress$, formatData$, probePosition$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraOp TC_SUB, charsLeft$, formatLength$, probePosition$

  tiraJmpCond "JL", formatStage$, "2", numericCheckExponentLbl$
  tiraJmpCond "JG", formatStage$, "4", numericCheckExponentLbl$
  tiraJmpCond "JE", probeChar$, "43", numericTrailingPlusLbl$
  tiraJmpCond "JE", probeChar$, "45", numericTrailingMinusLbl$

  tiraLabel numericCheckExponentLbl$
  tiraJmpCond "JL", formatStage$, "2", numericCheckFractionLbl$
  tiraJmpCond "JG", formatStage$, "3", numericCheckFractionLbl$
  tiraJmpCond "JNE", probeChar$, "94", numericCheckFractionLbl$
  tiraJmpCond "JL", charsLeft$, "5", numericCheckFourCaretsLbl$
  tiraNew TC_READ_MEM_OFFSET, nextChar1$ + ", " + probeAddress$ + ", 1"
  tiraNew TC_READ_MEM_OFFSET, nextChar2$ + ", " + probeAddress$ + ", 2"
  tiraNew TC_READ_MEM_OFFSET, nextChar3$ + ", " + probeAddress$ + ", 3"
  tiraNew TC_READ_MEM_OFFSET, nextChar4$ + ", " + probeAddress$ + ", 4"
  tiraJmpCond "JNE", nextChar1$, "94", numericCheckFourCaretsLbl$
  tiraJmpCond "JNE", nextChar2$, "94", numericCheckFourCaretsLbl$
  tiraJmpCond "JNE", nextChar3$, "94", numericCheckFourCaretsLbl$
  tiraJmpCond "JNE", nextChar4$, "94", numericCheckFourCaretsLbl$
  tiraAssign formatExponentDigits$, "3"
  tiraAssign formatStage$, "4"
  tiraOp TC_ADD, probePosition$, probePosition$, "5"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckFourCaretsLbl$
  tiraJmpCond "JL", charsLeft$, "4", numericCheckFractionLbl$
  tiraNew TC_READ_MEM_OFFSET, nextChar1$ + ", " + probeAddress$ + ", 1"
  tiraNew TC_READ_MEM_OFFSET, nextChar2$ + ", " + probeAddress$ + ", 2"
  tiraNew TC_READ_MEM_OFFSET, nextChar3$ + ", " + probeAddress$ + ", 3"
  tiraJmpCond "JNE", nextChar1$, "94", numericCheckFractionLbl$
  tiraJmpCond "JNE", nextChar2$, "94", numericCheckFractionLbl$
  tiraJmpCond "JNE", nextChar3$, "94", numericCheckFractionLbl$
  tiraAssign formatExponentDigits$, "2"
  tiraAssign formatStage$, "4"
  tiraOp TC_ADD, probePosition$, probePosition$, "4"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckFractionLbl$
  tiraJmpCond "JNE", formatStage$, "3", numericCheckCommaLbl$
  tiraJmpCond "JNE", probeChar$, "35", numericCheckCommaLbl$
  tiraOp TC_ADD, formatDigitsAfter$, formatDigitsAfter$, "1"
  tiraOp TC_ADD, hashCount$, hashCount$, "1"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckCommaLbl$
  tiraJmpCond "JNE", formatStage$, "2", numericCheckHashLbl$
  tiraJmpCond "JNE", probeChar$, "44", numericCheckHashLbl$
  tiraAssign commaFlag$, "1"
  tiraOp TC_ADD, formatDigitsBefore$, formatDigitsBefore$, "1"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckHashLbl$
  tiraJmpCond "JG", formatStage$, "2", numericCheckPointLbl$
  tiraJmpCond "JNE", probeChar$, "35", numericCheckPointLbl$
  tiraOp TC_ADD, formatDigitsBefore$, formatDigitsBefore$, "1"
  tiraOp TC_ADD, hashCount$, hashCount$, "1"
  tiraAssign formatStage$, "2"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckPointLbl$
  tiraJmpCond "JG", formatStage$, "2", numericCheckSpecialLbl$
  tiraJmpCond "JNE", probeChar$, "46", numericCheckSpecialLbl$
  tiraAssign decimalPoint$, "1"
  tiraAssign formatStage$, "3"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckSpecialLbl$
  tiraJmpCond "JG", formatStage$, "1", numericCheckLeadingPlusLbl$
  tiraJmpCond "JNE", probeChar$, "42", numericCheckDollarLbl$
  tiraJmpCond "JL", charsLeft$, "2", numericCheckDollarLbl$
  tiraNew TC_READ_MEM_OFFSET, nextChar1$ + ", " + probeAddress$ + ", 1"
  tiraJmpCond "JNE", nextChar1$, "42", numericCheckDollarLbl$
  tiraJmpCond "JL", charsLeft$, "3", numericCheckStarsLbl$
  tiraNew TC_READ_MEM_OFFSET, nextChar2$ + ", " + probeAddress$ + ", 2"
  tiraJmpCond "JNE", nextChar2$, "36", numericCheckStarsLbl$
  tiraAssign asteriskFill$, "1"
  tiraAssign dollarSign$, "1"
  tiraAssign formatDigitsBefore$, "2"
  tiraAssign formatStage$, "2"
  tiraOp TC_ADD, probePosition$, probePosition$, "3"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckStarsLbl$
  tiraAssign asteriskFill$, "1"
  tiraAssign formatDigitsBefore$, "2"
  tiraAssign formatStage$, "2"
  tiraOp TC_ADD, probePosition$, probePosition$, "2"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckDollarLbl$
  tiraJmpCond "JNE", probeChar$, "36", numericCheckLeadingPlusLbl$
  tiraJmpCond "JL", charsLeft$, "2", numericCheckLeadingPlusLbl$
  tiraNew TC_READ_MEM_OFFSET, nextChar1$ + ", " + probeAddress$ + ", 1"
  tiraJmpCond "JNE", nextChar1$, "36", numericCheckLeadingPlusLbl$
  tiraAssign dollarSign$, "1"
  tiraAssign formatDigitsBefore$, "1"
  tiraAssign formatStage$, "2"
  tiraOp TC_ADD, probePosition$, probePosition$, "2"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericCheckLeadingPlusLbl$
  tiraJmpCond "JNE", formatStage$, "0", numericProbeDoneLbl$
  tiraJmpCond "JNE", probeChar$, "43", numericProbeDoneLbl$
  tiraAssign leadingPlus$, "1"
  tiraAssign formatStage$, "1"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeTopLbl$

  tiraLabel numericTrailingPlusLbl$
  tiraAssign trailingPlus$, "1"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp numericProbeDoneLbl$

  tiraLabel numericTrailingMinusLbl$
  tiraAssign trailingMinus$, "1"
  tiraOp TC_ADD, probePosition$, probePosition$, "1"

  tiraLabel numericProbeDoneLbl$
  tiraJmpCond "JLE", formatStage$, "1", stringProbeLbl$
  tiraOp TC_ADD, totalDigits$, formatDigitsBefore$, formatDigitsAfter$
  tiraJmpCond "JE", totalDigits$, "0", stringProbeLbl$
  tiraJmpCond "JG", hashCount$, "25", errorLbl$
  tiraJmpCond "JNE", itemDone$, "0", doneLbl$
  tiraJmpCond "JE", argKind$, "5", errorLbl$
  tiraAssign fieldEnd$, probePosition$
  tiraAssign scanPosition$, probePosition$

  tiraJmpCond "JE", argKind$, "1", numberSignedLbl$
  tiraJmpCond "JE", argKind$, "2", numberUnsignedLbl$
  tiraJmpCond "JE", argKind$, "3", numberFloatLbl$
  tiraJmpCond "JE", argKind$, "4", numberFloatLbl$
  tiraJmp errorLbl$

  tiraLabel stringProbeLbl$
  tiraOp TC_ADD, probeAddress$, formatData$, fieldStart$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraJmpCond "JE", probeChar$, "38", stringAmpLbl$
  tiraJmpCond "JE", probeChar$, "33", stringBangLbl$
  tiraJmpCond "JE", probeChar$, "92", stringSlashLbl$
  tiraJmp literalLbl$

  tiraLabel stringAmpLbl$
  tiraAssign stringMode$, "1"
  tiraOp TC_ADD, fieldEnd$, fieldStart$, "1"
  tiraJmp stringValidLbl$

  tiraLabel stringBangLbl$
  tiraAssign stringMode$, "2"
  tiraAssign stringWidth$, "1"
  tiraOp TC_ADD, fieldEnd$, fieldStart$, "1"
  tiraJmp stringValidLbl$

  tiraLabel stringSlashLbl$
  tiraAssign stringMode$, "3"
  tiraAssign stringWidth$, "1"
  tiraOp TC_ADD, probePosition$, fieldStart$, "1"

  tiraLabel stringSlashTopLbl$
  tiraJmpCond "JGE", probePosition$, formatLength$, literalLbl$
  tiraOp TC_ADD, probeAddress$, formatData$, probePosition$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraOp TC_ADD, stringWidth$, stringWidth$, "1"
  tiraJmpCond "JE", probeChar$, "92", stringSlashCloseLbl$
  tiraJmpCond "JNE", probeChar$, "32", literalLbl$
  tiraOp TC_ADD, probePosition$, probePosition$, "1"
  tiraJmp stringSlashTopLbl$

  tiraLabel stringSlashCloseLbl$
  tiraOp TC_ADD, fieldEnd$, probePosition$, "1"

  tiraLabel stringValidLbl$
  tiraJmpCond "JNE", itemDone$, "0", doneLbl$
  tiraJmpCond "JNE", argKind$, "5", errorLbl$

  tiraNew TC_READ_MEM, stringData$ + ", " + argString$
  tiraNew TC_READ_MEM_OFFSET, stringLength$ + ", " + argString$ + ", 8"

  tiraJmpCond "JE", stringMode$, "1", stringWholeLbl$
  tiraJmpCond "JE", stringMode$, "2", stringFirstLbl$
  tiraJmp stringFixedLbl$

  tiraLabel stringWholeLbl$
  tiraPrintUsingPrintSpan outDesc$, stringData$, stringLength$
  tiraJmp stringDoneLbl$

  tiraLabel stringFirstLbl$
  tiraAssign outPtr$, fieldPtr$
  tiraAssign outLength$, "0"
  tiraAssign digitByte$, "32"
  tiraJmpCond "JLE", stringLength$, "0", stringFirstReadyLbl$
  tiraNew TC_READ_MEM, digitByte$ + ", " + stringData$
  tiraLabel stringFirstReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraPrintUsingPrintSpan outDesc$, fieldPtr$, outLength$
  tiraJmp stringDoneLbl$

  tiraLabel stringFixedLbl$
  stringFieldPtr$ = tiraAllocTempMem$(stringWidth$)
  tiraMemSet stringFieldPtr$, "32", stringWidth$
  tiraAssign stringCopyCount$, stringLength$
  tiraJmpCond "JLE", stringCopyCount$, stringWidth$, stringCopyReadyLbl$
  tiraAssign stringCopyCount$, stringWidth$
  tiraLabel stringCopyReadyLbl$
  tiraMemcpy stringFieldPtr$, stringData$, stringCopyCount$
  tiraPrintUsingPrintSpan outDesc$, stringFieldPtr$, stringWidth$

  tiraLabel stringDoneLbl$
  tiraAssign itemDone$, "1"
  tiraAssign scanPosition$, fieldEnd$
  tiraJmp scanTopLbl$

  tiraLabel literalLbl$
  tiraAssign literalPosition$, fieldStart$
  tiraJmpCond "JNE", charValue$, "95", literalReadyLbl$
  tiraOp TC_ADD, tempCalc$, fieldStart$, "1"
  tiraJmpCond "JGE", tempCalc$, formatLength$, literalReadyLbl$
  tiraAssign literalPosition$, tempCalc$
  tiraLabel literalReadyLbl$
  tiraOp TC_ADD, literalAddress$, formatData$, literalPosition$
  tiraPrintUsingPrintSpan outDesc$, literalAddress$, "1"
  tiraOp TC_ADD, scanPosition$, literalPosition$, "1"
  tiraJmp scanTopLbl$

  tiraLabel numberSignedLbl$
  tiraCall "IAT_SPRINTF", 3, rawPtr$ + ", " + signedFormatPtr$ + ", " + argInteger$
  tiraNew TC_GET_RET, rawLength$
  tiraJmpCond "JLE", rawLength$, "0", errorLbl$
  tiraAssign digitSource$, rawPtr$
  tiraAssign digitCount$, rawLength$
  tiraAssign isNegative$, "0"
  tiraNew TC_READ_MEM, digitByte$ + ", " + rawPtr$
  tiraJmpCond "JNE", digitByte$, "45", numberSignedReadyLbl$
  tiraAssign isNegative$, "1"
  tiraOp TC_ADD, digitSource$, digitSource$, "1"
  tiraOp TC_SUB, digitCount$, digitCount$, "1"
  tiraLabel numberSignedReadyLbl$
  tiraMemcpy digitsPtr$, digitSource$, digitCount$
  tiraAssign decimalAdjust$, "0"
  tiraAssign exponentChar$, "69"
  tiraAssign rounded$, "0"
  tiraJmp formatRepassLbl$

  tiraLabel numberUnsignedLbl$
  tiraCall "IAT_SPRINTF", 3, rawPtr$ + ", " + unsignedFormatPtr$ + ", " + argInteger$
  tiraNew TC_GET_RET, rawLength$
  tiraJmpCond "JLE", rawLength$, "0", errorLbl$
  tiraMemcpy digitsPtr$, rawPtr$, rawLength$
  tiraAssign digitCount$, rawLength$
  tiraAssign decimalAdjust$, "0"
  tiraAssign isNegative$, "0"
  tiraAssign exponentChar$, "69"
  tiraAssign rounded$, "0"
  tiraJmp formatRepassLbl$

  tiraLabel numberFloatLbl$
  tiraCall "IAT_SPRINTF", 3, rawPtr$ + ", " + floatFormatPtr$ + ", " + argNumber$
  tiraNew TC_GET_RET, rawLength$
  tiraJmpCond "JLE", rawLength$, "0", errorLbl$

  tiraAssign isNegative$, "0"
  tiraNew TC_READ_MEM, digitByte$ + ", " + rawPtr$
  tiraJmpCond "JE", digitByte$, "32", floatSignReadyLbl$
  tiraJmpCond "JNE", digitByte$, "45", errorLbl$
  tiraAssign isNegative$, "1"

  tiraLabel floatSignReadyLbl$
  tiraAssign rawIndex$, "1"
  tiraAssign digitCount$, "0"
  tiraAssign decimalAdjust$, "0"
  tiraAssign sawDigit$, "0"

  tiraLabel floatWholeTopLbl$
  tiraJmpCond "JGE", rawIndex$, rawLength$, errorLbl$
  tiraOp TC_ADD, probeAddress$, rawPtr$, rawIndex$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraJmpCond "JE", probeChar$, "46", floatPointLbl$
  tiraJmpCond "JL", probeChar$, "48", errorLbl$
  tiraJmpCond "JG", probeChar$, "57", errorLbl$
  tiraOp TC_ADD, digitAddress$, digitsPtr$, digitCount$
  tiraWriteMem digitAddress$, probeChar$, "1"
  tiraOp TC_ADD, digitCount$, digitCount$, "1"
  tiraAssign sawDigit$, "1"
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"
  tiraJmp floatWholeTopLbl$

  tiraLabel floatPointLbl$
  tiraJmpCond "JE", sawDigit$, "0", errorLbl$
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"

  tiraLabel floatFractionTopLbl$
  tiraJmpCond "JGE", rawIndex$, rawLength$, errorLbl$
  tiraOp TC_ADD, probeAddress$, rawPtr$, rawIndex$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraJmpCond "JE", probeChar$, "69", floatExponentLbl$
  tiraJmpCond "JE", probeChar$, "101", floatExponentLbl$
  tiraJmpCond "JL", probeChar$, "48", errorLbl$
  tiraJmpCond "JG", probeChar$, "57", errorLbl$
  tiraOp TC_ADD, digitAddress$, digitsPtr$, digitCount$
  tiraWriteMem digitAddress$, probeChar$, "1"
  tiraOp TC_ADD, digitCount$, digitCount$, "1"
  tiraOp TC_SUB, decimalAdjust$, decimalAdjust$, "1"
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"
  tiraJmp floatFractionTopLbl$

  tiraLabel floatExponentLbl$
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"
  tiraJmpCond "JGE", rawIndex$, rawLength$, errorLbl$
  tiraAssign exponentNegative$, "0"
  tiraOp TC_ADD, probeAddress$, rawPtr$, rawIndex$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraJmpCond "JE", probeChar$, "43", floatExponentSignReadyLbl$
  tiraJmpCond "JNE", probeChar$, "45", floatExponentInitLbl$
  tiraAssign exponentNegative$, "1"

  tiraLabel floatExponentSignReadyLbl$
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"

  tiraLabel floatExponentInitLbl$
  tiraAssign exponentValue$, "0"
  tiraAssign sawDigit$, "0"

  tiraLabel floatExponentTopLbl$
  tiraJmpCond "JGE", rawIndex$, rawLength$, floatExponentDoneLbl$
  tiraOp TC_ADD, probeAddress$, rawPtr$, rawIndex$
  tiraNew TC_READ_MEM, probeChar$ + ", " + probeAddress$
  tiraJmpCond "JL", probeChar$, "48", errorLbl$
  tiraJmpCond "JG", probeChar$, "57", errorLbl$
  tiraOp TC_MUL, exponentValue$, exponentValue$, "10"
  tiraOp TC_SUB, probeChar$, probeChar$, "48"
  tiraOp TC_ADD, exponentValue$, exponentValue$, probeChar$
  tiraAssign sawDigit$, "1"
  tiraOp TC_ADD, rawIndex$, rawIndex$, "1"
  tiraJmp floatExponentTopLbl$

  tiraLabel floatExponentDoneLbl$
  tiraJmpCond "JE", sawDigit$, "0", errorLbl$
  tiraJmpCond "JE", exponentNegative$, "0", floatExponentPositiveLbl$
  tiraOp TC_NEG, exponentValue$, exponentValue$, ""
  tiraLabel floatExponentPositiveLbl$
  tiraOp TC_ADD, decimalAdjust$, decimalAdjust$, exponentValue$
  tiraAssign exponentChar$, "69"
  tiraJmpCond "JNE", argKind$, "4", floatKindReadyLbl$
  tiraAssign exponentChar$, "68"
  tiraLabel floatKindReadyLbl$
  tiraAssign rounded$, "0"

  tiraLabel formatRepassLbl$
  tiraAssign useDigitsBefore$, formatDigitsBefore$
  tiraAssign useDigitsAfter$, formatDigitsAfter$
  tiraAssign useDecimalPoint$, decimalPoint$
  tiraAssign useExponentDigits$, formatExponentDigits$
  tiraAssign extraSignSpace$, "0"
  tiraAssign cannotFit$, "0"
  tiraAssign leadingZero$, "0"
  tiraAssign fillByte$, "32"
  tiraJmpCond "JE", asteriskFill$, "0", formatFillReadyLbl$
  tiraAssign fillByte$, "42"

  tiraLabel formatFillReadyLbl$
  tiraJmpCond "JLE", useExponentDigits$, "0", formatFixedAdjustLbl$
  tiraJmpCond "JNE", leadingPlus$, "0", formatExponentReserveDoneLbl$
  tiraJmpCond "JNE", trailingPlus$, "0", formatExponentReserveDoneLbl$
  tiraJmpCond "JNE", trailingMinus$, "0", formatExponentReserveDoneLbl$
  tiraOp TC_SUB, useDigitsBefore$, useDigitsBefore$, "1"
  tiraJmpCond "JNE", useDigitsBefore$, "-1", formatExponentAfterBeforeLbl$
  tiraOp TC_SUB, useDigitsAfter$, useDigitsAfter$, "1"
  tiraAssign useDigitsBefore$, "0"
  tiraJmpCond "JNE", useDigitsAfter$, "0", formatExponentAfterBeforeLbl$
  tiraAssign useDecimalPoint$, "0"
  tiraOp TC_ADD, useDigitsBefore$, useDigitsBefore$, "1"
  tiraLabel formatExponentAfterBeforeLbl$
  tiraAssign extraSignSpace$, "1"
  tiraLabel formatExponentReserveDoneLbl$
  tiraAssign digitsAndCommasBefore$, useDigitsBefore$
  tiraJmp formatZeroCheckLbl$

  tiraLabel formatFixedAdjustLbl$
  tiraJmpCond "JE", isNegative$, "0", formatFixedSignDoneLbl$
  tiraJmpCond "JNE", leadingPlus$, "0", formatFixedSignDoneLbl$
  tiraJmpCond "JNE", trailingPlus$, "0", formatFixedSignDoneLbl$
  tiraJmpCond "JNE", trailingMinus$, "0", formatFixedSignDoneLbl$
  tiraOp TC_SUB, useDigitsBefore$, useDigitsBefore$, "1"
  tiraAssign extraSignSpace$, "1"
  tiraLabel formatFixedSignDoneLbl$
  tiraAssign digitsAndCommasBefore$, useDigitsBefore$
  tiraJmpCond "JE", commaFlag$, "0", formatCommaDoneLbl$
  tiraOp TC_IDIV, tempCalc$, useDigitsBefore$, "4"
  tiraOp TC_SUB, useDigitsBefore$, useDigitsBefore$, tempCalc$
  tiraLabel formatCommaDoneLbl$

  tiraLabel formatZeroCheckLbl$
  tiraJmpCond "JNE", useDigitsBefore$, "0", formatZeroDoneLbl$
  tiraOp TC_ADD, wholeDigits$, digitCount$, decimalAdjust$
  tiraJmpCond "JNE", wholeDigits$, "1", formatZeroDoneLbl$
  tiraNew TC_READ_MEM, currentDigit$ + ", " + digitsPtr$
  tiraJmpCond "JNE", currentDigit$, "48", formatZeroDoneLbl$
  tiraOp TC_SUB, decimalAdjust$, decimalAdjust$, "1"

  tiraLabel formatZeroDoneLbl$
  tiraJmpCond "JG", useExponentDigits$, "0", formatExponentFitLbl$
  tiraJmp formatFixedFitLbl$

  tiraLabel formatExponentFitLbl$
  tiraJmpCond "JE", extraSignSpace$, "0", formatExponentGivebackDoneLbl$
  tiraJmpCond "JNE", isNegative$, "0", formatExponentGivebackDoneLbl$
  tiraJmpCond "JG", useDigitsBefore$, "0", formatExponentGivebackDoneLbl$
  tiraAssign extraSignSpace$, "0"
  tiraOp TC_ADD, useDigitsBefore$, useDigitsBefore$, "1"
  tiraJmpCond "JNE", useDigitsBefore$, "1", formatExponentGivebackDoneLbl$
  tiraJmpCond "JLE", useDigitsAfter$, "0", formatExponentGivebackDoneLbl$
  tiraOp TC_SUB, useDigitsBefore$, useDigitsBefore$, "1"
  tiraAssign extraSignSpace$, "2"

  tiraLabel formatExponentGivebackDoneLbl$
  tiraOp TC_ADD, tempCalc$, useDigitsBefore$, useDigitsAfter$
  tiraJmpCond "JNE", tempCalc$, "0", formatExponentNotEmptyLbl$
  tiraAssign cannotFit$, "1"
  tiraAssign useDigitsBefore$, "1"

  tiraLabel formatExponentNotEmptyLbl$
  tiraOp TC_ADD, exponentValue$, digitCount$, decimalAdjust$
  tiraOp TC_SUB, exponentValue$, exponentValue$, useDigitsBefore$
  tiraAssign absoluteExponent$, exponentValue$
  tiraJmpCond "JGE", absoluteExponent$, "0", formatExponentAbsoluteReadyLbl$
  tiraOp TC_NEG, absoluteExponent$, absoluteExponent$, ""
  tiraLabel formatExponentAbsoluteReadyLbl$
  tiraCall "IAT_SPRINTF", 3, rawPtr$ + ", " + exponentFormatPtr$ + ", " + absoluteExponent$
  tiraNew TC_GET_RET, exponentTextLength$
  tiraJmpCond "JLE", exponentTextLength$, "0", errorLbl$
  tiraJmpCond "JLE", exponentTextLength$, useExponentDigits$, formatExponentSizeReadyLbl$
  tiraAssign cannotFit$, "1"
  tiraAssign useExponentDigits$, exponentTextLength$
  tiraLabel formatExponentSizeReadyLbl$
  tiraJmp buildExponentLbl$

  tiraLabel formatFixedFitLbl$
  tiraOp TC_ADD, wholeDigits$, digitCount$, decimalAdjust$
  tiraJmpCond "JGE", useDigitsBefore$, wholeDigits$, formatFixedFitDoneLbl$
  tiraAssign useDigitsBefore$, wholeDigits$
  tiraAssign cannotFit$, "1"
  tiraAssign digitsAndCommasBefore$, useDigitsBefore$
  tiraJmpCond "JE", commaFlag$, "0", formatFixedFitDoneLbl$
  tiraOp TC_SUB, tempCalc$, wholeDigits$, "1"
  tiraOp TC_IDIV, tempCalc$, tempCalc$, "3"
  tiraOp TC_ADD, digitsAndCommasBefore$, wholeDigits$, tempCalc$

  tiraLabel formatFixedFitDoneLbl$
  tiraJmp buildFixedLbl$

  tiraLabel buildFixedLbl$
  tiraAssign outPtr$, fieldPtr$
  tiraAssign outLength$, "0"
  tiraAssign digitIndex$, "0"
  tiraAssign roundMode$, "0"
  tiraJmpCond "JE", cannotFit$, "0", fixedOverflowDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "37"
  tiraLabel fixedOverflowDoneLbl$

  tiraJmpCond "JE", leadingPlus$, "0", fixedLeadingSignDoneLbl$
  tiraAssign digitByte$, "43"
  tiraJmpCond "JE", isNegative$, "0", fixedLeadingSignReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel fixedLeadingSignReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraLabel fixedLeadingSignDoneLbl$

  tiraAssign zeroGap$, "0"
  tiraJmpCond "JGE", wholeDigits$, "0", fixedZeroGapDoneLbl$
  tiraOp TC_NEG, zeroGap$, wholeDigits$, ""
  tiraLabel fixedZeroGapDoneLbl$

  tiraAssign remainingChars$, wholeDigits$
  tiraJmpCond "JE", commaFlag$, "0", fixedCommaSizeDoneLbl$
  tiraOp TC_SUB, tempCalc$, wholeDigits$, "1"
  tiraOp TC_IDIV, tempCalc$, tempCalc$, "3"
  tiraOp TC_ADD, remainingChars$, remainingChars$, tempCalc$
  tiraLabel fixedCommaSizeDoneLbl$
  tiraJmpCond "JGE", remainingChars$, "0", fixedRemainingReadyLbl$
  tiraAssign remainingChars$, "0"
  tiraLabel fixedRemainingReadyLbl$

  tiraOp TC_SUB, leadingCount$, digitsAndCommasBefore$, remainingChars$
  tiraJmpCond "JNE", remainingChars$, "0", fixedLeadingZeroDoneLbl$
  tiraJmpCond "JLE", leadingCount$, "0", fixedLeadingZeroDoneLbl$
  tiraAssign leadingZero$, "1"
  tiraOp TC_SUB, leadingCount$, leadingCount$, "1"
  tiraLabel fixedLeadingZeroDoneLbl$

  tiraAssign loopIndex$, "0"
  tiraLabel fixedFillTopLbl$
  tiraJmpCond "JGE", loopIndex$, leadingCount$, fixedFillDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, fillByte$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp fixedFillTopLbl$
  tiraLabel fixedFillDoneLbl$

  tiraJmpCond "JE", extraSignSpace$, "0", fixedExtraSignDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "45"
  tiraLabel fixedExtraSignDoneLbl$

  tiraJmpCond "JE", dollarSign$, "0", fixedDollarDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "36"
  tiraLabel fixedDollarDoneLbl$

  tiraJmpCond "JE", leadingZero$, "0", fixedLeadingZeroPrintDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "48"
  tiraLabel fixedLeadingZeroPrintDoneLbl$

  tiraAssign loopIndex$, "0"
  tiraLabel fixedWholeTopLbl$
  tiraJmpCond "JGE", loopIndex$, remainingChars$, fixedWholeDoneLbl$
  tiraJmpCond "JE", commaFlag$, "0", fixedWholeDigitLbl$
  tiraOp TC_SUB, tempCalc$, remainingChars$, loopIndex$
  tiraOp TC_AND, tempCalc$, tempCalc$, "3"
  tiraJmpCond "JNE", tempCalc$, "0", fixedWholeDigitLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "44"
  tiraJmp fixedWholeStepLbl$

  tiraLabel fixedWholeDigitLbl$
  tiraAssign digitByte$, "48"
  tiraJmpCond "JGE", digitIndex$, digitCount$, fixedWholeDigitReadyLbl$
  tiraOp TC_ADD, currentDigitAddress$, digitsPtr$, digitIndex$
  tiraNew TC_READ_MEM, digitByte$ + ", " + currentDigitAddress$
  tiraOp TC_ADD, digitIndex$, digitIndex$, "1"
  tiraLabel fixedWholeDigitReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$

  tiraLabel fixedWholeStepLbl$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp fixedWholeTopLbl$

  tiraLabel fixedWholeDoneLbl$
  tiraJmpCond "JE", useDecimalPoint$, "0", fixedPointDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "46"
  tiraLabel fixedPointDoneLbl$

  tiraAssign loopIndex$, "0"
  tiraLabel fixedFractionTopLbl$
  tiraJmpCond "JGE", loopIndex$, useDigitsAfter$, fixedFractionDoneLbl$
  tiraAssign digitByte$, "48"
  tiraJmpCond "JLE", zeroGap$, "0", fixedFractionDigitLbl$
  tiraOp TC_SUB, zeroGap$, zeroGap$, "1"
  tiraJmp fixedFractionDigitReadyLbl$

  tiraLabel fixedFractionDigitLbl$
  tiraJmpCond "JGE", digitIndex$, digitCount$, fixedFractionDigitReadyLbl$
  tiraOp TC_ADD, currentDigitAddress$, digitsPtr$, digitIndex$
  tiraNew TC_READ_MEM, digitByte$ + ", " + currentDigitAddress$
  tiraOp TC_ADD, digitIndex$, digitIndex$, "1"

  tiraLabel fixedFractionDigitReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp fixedFractionTopLbl$

  tiraLabel fixedFractionDoneLbl$
  tiraAssign usedDigits$, digitIndex$
  tiraJmp roundCheckLbl$

  tiraLabel buildExponentLbl$
  tiraAssign outPtr$, fieldPtr$
  tiraAssign outLength$, "0"
  tiraAssign digitIndex$, "0"
  tiraAssign roundMode$, "1"
  tiraJmpCond "JE", cannotFit$, "0", exponentOverflowDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "37"
  tiraLabel exponentOverflowDoneLbl$

  tiraJmpCond "JE", leadingPlus$, "0", exponentLeadingSignDoneLbl$
  tiraAssign digitByte$, "43"
  tiraJmpCond "JE", isNegative$, "0", exponentLeadingSignReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel exponentLeadingSignReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraLabel exponentLeadingSignDoneLbl$

  tiraJmpCond "JE", dollarSign$, "0", exponentDollarDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "36"
  tiraLabel exponentDollarDoneLbl$

  tiraJmpCond "JE", extraSignSpace$, "0", exponentExtraSignDoneLbl$
  tiraAssign digitByte$, "32"
  tiraJmpCond "JE", isNegative$, "0", exponentExtraSignReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel exponentExtraSignReadyLbl$
  tiraJmpCond "JNE", isNegative$, "0", exponentExtraSignDoneLbl$
  tiraJmpCond "JNE", extraSignSpace$, "2", exponentExtraSignDoneLbl$
  tiraAssign digitByte$, "48"
  tiraLabel exponentExtraSignDoneLbl$
  tiraJmpCond "JE", extraSignSpace$, "0", exponentExtraPrintDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$

  tiraLabel exponentExtraPrintDoneLbl$

  tiraAssign loopIndex$, "0"
  tiraLabel exponentWholeTopLbl$
  tiraJmpCond "JGE", loopIndex$, useDigitsBefore$, exponentWholeDoneLbl$
  tiraAssign digitByte$, "48"
  tiraJmpCond "JGE", digitIndex$, digitCount$, exponentWholeDigitReadyLbl$
  tiraOp TC_ADD, currentDigitAddress$, digitsPtr$, digitIndex$
  tiraNew TC_READ_MEM, digitByte$ + ", " + currentDigitAddress$
  tiraOp TC_ADD, digitIndex$, digitIndex$, "1"
  tiraLabel exponentWholeDigitReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp exponentWholeTopLbl$

  tiraLabel exponentWholeDoneLbl$
  tiraJmpCond "JE", useDecimalPoint$, "0", exponentPointDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "46"
  tiraLabel exponentPointDoneLbl$

  tiraAssign loopIndex$, "0"
  tiraLabel exponentFractionTopLbl$
  tiraJmpCond "JGE", loopIndex$, useDigitsAfter$, exponentFractionDoneLbl$
  tiraAssign digitByte$, "48"
  tiraJmpCond "JGE", digitIndex$, digitCount$, exponentFractionDigitReadyLbl$
  tiraOp TC_ADD, currentDigitAddress$, digitsPtr$, digitIndex$
  tiraNew TC_READ_MEM, digitByte$ + ", " + currentDigitAddress$
  tiraOp TC_ADD, digitIndex$, digitIndex$, "1"
  tiraLabel exponentFractionDigitReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp exponentFractionTopLbl$

  tiraLabel exponentFractionDoneLbl$
  tiraAssign usedDigits$, digitIndex$

  tiraLabel roundCheckLbl$
  tiraJmpCond "JNE", rounded$, "0", numberOutputReadyLbl$
  tiraJmpCond "JGE", usedDigits$, digitCount$, numberOutputReadyLbl$
  tiraOp TC_ADD, nextDigitAddress$, digitsPtr$, usedDigits$
  tiraNew TC_READ_MEM, nextDigit$ + ", " + nextDigitAddress$
  tiraJmpCond "JL", nextDigit$, "53", numberOutputReadyLbl$
  tiraAssign rounded$, "1"

  tiraAssign shiftIndex$, digitCount$
  tiraLabel roundShiftRightTopLbl$
  tiraJmpCond "JLE", shiftIndex$, "0", roundShiftRightDoneLbl$
  tiraOp TC_SUB, tempCalc$, shiftIndex$, "1"
  tiraOp TC_ADD, sourceAddress$, digitsPtr$, tempCalc$
  tiraOp TC_ADD, destAddress$, digitsPtr$, shiftIndex$
  tiraNew TC_READ_MEM, currentDigit$ + ", " + sourceAddress$
  tiraWriteMem destAddress$, currentDigit$, "1"
  tiraOp TC_SUB, shiftIndex$, shiftIndex$, "1"
  tiraJmp roundShiftRightTopLbl$

  tiraLabel roundShiftRightDoneLbl$
  tiraWriteMem digitsPtr$, "48", "1"
  tiraAssign roundIndex$, usedDigits$

  tiraLabel roundCarryTopLbl$
  tiraOp TC_ADD, currentDigitAddress$, digitsPtr$, roundIndex$
  tiraNew TC_READ_MEM, currentDigit$ + ", " + currentDigitAddress$
  tiraOp TC_ADD, currentDigit$, currentDigit$, "1"
  tiraJmpCond "JLE", currentDigit$, "57", roundCarryStoreLbl$
  tiraWriteMem currentDigitAddress$, "48", "1"
  tiraOp TC_SUB, roundIndex$, roundIndex$, "1"
  tiraJmp roundCarryTopLbl$

  tiraLabel roundCarryStoreLbl$
  tiraWriteMem currentDigitAddress$, currentDigit$, "1"
  tiraNew TC_READ_MEM, currentDigit$ + ", " + digitsPtr$
  tiraJmpCond "JE", currentDigit$, "48", roundCarryDoneLbl$
  tiraOp TC_ADD, digitCount$, digitCount$, "1"
  tiraJmp formatRepassLbl$

  tiraLabel roundCarryDoneLbl$
  tiraAssign shiftIndex$, "0"
  tiraLabel roundShiftLeftTopLbl$
  tiraJmpCond "JGE", shiftIndex$, digitCount$, roundShiftLeftDoneLbl$
  tiraOp TC_ADD, tempCalc$, shiftIndex$, "1"
  tiraOp TC_ADD, sourceAddress$, digitsPtr$, tempCalc$
  tiraOp TC_ADD, destAddress$, digitsPtr$, shiftIndex$
  tiraNew TC_READ_MEM, currentDigit$ + ", " + sourceAddress$
  tiraWriteMem destAddress$, currentDigit$, "1"
  tiraOp TC_ADD, shiftIndex$, shiftIndex$, "1"
  tiraJmp roundShiftLeftTopLbl$

  tiraLabel roundShiftLeftDoneLbl$
  tiraJmp formatRepassLbl$

  tiraLabel numberOutputReadyLbl$
  tiraJmpCond "JE", roundMode$, "1", appendExponentLbl$
  tiraJmp appendTrailingLbl$

  tiraLabel appendExponentLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, exponentChar$
  tiraAssign digitByte$, "43"
  tiraJmpCond "JGE", exponentValue$, "0", appendExponentSignReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel appendExponentSignReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$

  tiraOp TC_SUB, loopLimit$, useExponentDigits$, exponentTextLength$
  tiraAssign loopIndex$, "0"
  tiraLabel appendExponentZeroTopLbl$
  tiraJmpCond "JGE", loopIndex$, loopLimit$, appendExponentZeroDoneLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, "48"
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp appendExponentZeroTopLbl$

  tiraLabel appendExponentZeroDoneLbl$
  tiraAssign loopIndex$, "0"
  tiraLabel appendExponentTextTopLbl$
  tiraJmpCond "JGE", loopIndex$, exponentTextLength$, appendExponentTextDoneLbl$
  tiraOp TC_ADD, currentDigitAddress$, rawPtr$, loopIndex$
  tiraNew TC_READ_MEM, digitByte$ + ", " + currentDigitAddress$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraOp TC_ADD, loopIndex$, loopIndex$, "1"
  tiraJmp appendExponentTextTopLbl$

  tiraLabel appendExponentTextDoneLbl$

  tiraLabel appendTrailingLbl$
  tiraJmpCond "JE", trailingPlus$, "0", appendTrailingPlusDoneLbl$
  tiraAssign digitByte$, "43"
  tiraJmpCond "JE", isNegative$, "0", appendTrailingPlusReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel appendTrailingPlusReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraLabel appendTrailingPlusDoneLbl$

  tiraJmpCond "JE", trailingMinus$, "0", appendTrailingMinusDoneLbl$
  tiraAssign digitByte$, "32"
  tiraJmpCond "JE", isNegative$, "0", appendTrailingMinusReadyLbl$
  tiraAssign digitByte$, "45"
  tiraLabel appendTrailingMinusReadyLbl$
  tiraPrintUsingPutByte outPtr$, outLength$, digitByte$
  tiraLabel appendTrailingMinusDoneLbl$

  tiraPrintUsingPrintSpan outDesc$, fieldPtr$, outLength$
  tiraAssign itemDone$, "1"
  tiraAssign scanPosition$, fieldEnd$
  tiraJmp scanTopLbl$

  tiraLabel scanEndLbl$
  tiraJmpCond "JE", itemDone$, "0", scanWrapLbl$
  tiraAssign scanPosition$, "0"
  tiraJmp doneLbl$

  tiraLabel scanWrapLbl$
  tiraJmpCond "JE", startPosition$, "0", errorLbl$
  tiraAssign scanPosition$, "0"
  tiraJmp scanTopLbl$

  tiraLabel errorLbl$
  tiraFatalError "ILLEGAL FUNCTION CALL"

  tiraLabel doneLbl$
  tiraWriteMem argStatePtr$, scanPosition$, "4"

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimePrintUsing

''''''''''''''''''''''''
SUB emitRuntimeRead

  rtOffset(RT_READ) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  targetAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, targetAddrVar$ + ", 1"

  isStrVarVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, isStrVarVar$ + ", 2"

  tgtDataTypeVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, tgtDataTypeVar$ + ", 3"

  skipErrLbl$ = tiraLabelCreateNew$("READ_SKIP_ERR")
  tiraJmpCond "JL", "!G_SYS_VAL_DATAINDEX", "!G_SYS_VAL_DATA_COUNT", skipErrLbl$

  errStr$ = CHR$(34) + "OUT OF DATA ERROR ON READ" + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel skipErrLbl$

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_SYS_ARR_DATA_LIST", ""

  descPtrAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB descPtrAddr$, baseArr$, "!G_SYS_VAL_DATAINDEX", "8"

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, descPtr$ + ", " + descPtrAddr$

  tiraOp TC_ADD, "!G_SYS_VAL_DATAINDEX", "!G_SYS_VAL_DATAINDEX", "1"

  notStrLbl$ = tiraLabelCreateNew$("READ_NOT_STR")
  tiraJmpCond "JE", isStrVarVar$, "0", notStrLbl$

  ' Dereference the pointer slot to obtain the actual descriptor address
  actualDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, actualDescPtr$ + ", " + targetAddrVar$

  ' Allocate a descriptor if the slot is still null
  tiraEnsureStringAlloc actualDescPtr$, targetAddrVar$

  tiraCall "RT_STR_ASSIGN", 2, actualDescPtr$ + ", " + descPtr$

  endReadLbl$ = tiraLabelCreateNew$("READ_END")
  tiraJmp endReadLbl$

  tiraLabel notStrLbl$

  bufPtr$ = tiraGetStringData$(descPtr$)
  bufLen$ = tiraGetStringLen$(descPtr$)

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"
  isNeg$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign isNeg$, "0"

  skipLoop$ = tiraLabelCreateNew$("READ_NSKIP")
  skipDone$ = tiraLabelCreateNew$("READ_NSKIP_DN")

  tiraLabel skipLoop$
  tiraJmpCond "JLE", bufLen$, "0", skipDone$
  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  isSpcLbl$ = tiraLabelCreateNew$("READ_ISSPC")
  tiraJmpCond "JE", byteVal$, "32", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "13", isSpcLbl$
  tiraJmpCond "JE", byteVal$, "10", isSpcLbl$
  tiraJmp skipDone$

  tiraLabel isSpcLbl$
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp skipLoop$

  tiraLabel skipDone$

  signDone$ = tiraLabelCreateNew$("READ_SGN_DONE")
  tiraJmpCond "JLE", bufLen$, "0", signDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$
  tiraJmpCond "JNE", byteVal$, "45", signDone$
  tiraAssign isNeg$, "1"
  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"

  tiraLabel signDone$

  numLoopTop$ = tiraLabelCreateNew$("READ_NUM_LOOP")
  numLoopDone$ = tiraLabelCreateNew$("READ_NUM_DONE")

  tiraLabel numLoopTop$
  tiraJmpCond "JLE", bufLen$, "0", numLoopDone$
  tiraNew TC_READ_MEM, byteVal$ + ", " + bufPtr$

  tiraJmpCond "JL", byteVal$, "48", numLoopDone$
  tiraJmpCond "JG", byteVal$, "57", numLoopDone$

  tiraOp TC_SUB, byteVal$, byteVal$, "48"
  tiraOp TC_MUL, resVar$, resVar$, "10"
  tiraOp TC_ADD, resVar$, resVar$, byteVal$

  tiraOp TC_ADD, bufPtr$, bufPtr$, "1"
  tiraOp TC_SUB, bufLen$, bufLen$, "1"
  tiraJmp numLoopTop$

  tiraLabel numLoopDone$

  applySignDone$ = tiraLabelCreateNew$("READ_SGN_APP")
  tiraJmpCond "JE", isNeg$, "0", applySignDone$
  tiraOp TC_NEG, resVar$, resVar$, ""
  tiraLabel applySignDone$

  lblSingle$ = tiraLabelCreateNew$("READ_IS_SNG")
  lblDouble$ = tiraLabelCreateNew$("READ_IS_DBL")
  lblByte$ = tiraLabelCreateNew$("READ_IS_BYT")
  lblInt$ = tiraLabelCreateNew$("READ_IS_INT")
  lblLong$ = tiraLabelCreateNew$("READ_IS_LNG")
  lblWriteDone$ = tiraLabelCreateNew$("READ_WR_DONE")

  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_SINGLE)), lblSingle$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_DOUBLE)), lblDouble$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_BYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UBYTE)), lblByte$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_INTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_UINTEGER)), lblInt$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_LONG)), lblLong$
  tiraJmpCond "JE", tgtDataTypeVar$, LTRIM$(STR$(TYPE_ULONG)), lblLong$

  tiraWriteMem targetAddrVar$, resVar$, "8"
  tiraJmp lblWriteDone$

  tiraLabel lblSingle$
  tiraWriteMem targetAddrVar$, resVar$, "SINGLE"
  tiraJmp lblWriteDone$

  tiraLabel lblDouble$
  tiraWriteMem targetAddrVar$, resVar$, "DOUBLE"
  tiraJmp lblWriteDone$

  tiraLabel lblByte$
  tiraWriteMem targetAddrVar$, resVar$, "1"
  tiraJmp lblWriteDone$

  tiraLabel lblInt$
  tiraWriteMem targetAddrVar$, resVar$, "2"
  tiraJmp lblWriteDone$

  tiraLabel lblLong$
  tiraWriteMem targetAddrVar$, resVar$, "4"

  tiraLabel lblWriteDone$

  tiraLabel endReadLbl$

  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeRead

''''''''''''''''''''''''
SUB emitRuntimeWheel

  rtOffset(RT_WHEEL) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  ' XInput controllers do not expose wheel inputs
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"
  tiraNew TC_ABI_WRITE_RET, resVar$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeWheel

''''''''''''''''''''''''
SUB initKeyMapping

  keyMappingCount = 0

  ' Uppercase A-Z
  FOR ii = 65 TO 90
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Lowercase a-z
  FOR ii = 97 TO 122
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii - 32
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Numbers 0-9
  FOR ii = 48 TO 57
    keyMapping(keyMappingCount).qbCode = ii
    keyMapping(keyMappingCount).vkCode = ii
    keyMappingCount = keyMappingCount + 1
  NEXT

  ' Arrow Keys
  keyMapping(keyMappingCount).qbCode = 18432
  keyMapping(keyMappingCount).vkCode = 38
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 19200
  keyMapping(keyMappingCount).vkCode = 37
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 19712
  keyMapping(keyMappingCount).vkCode = 39
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20480
  keyMapping(keyMappingCount).vkCode = 40
  keyMappingCount = keyMappingCount + 1

  ' Navigation Keys
  keyMapping(keyMappingCount).qbCode = 18688
  keyMapping(keyMappingCount).vkCode = 33
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20736
  keyMapping(keyMappingCount).vkCode = 34
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 18176
  keyMapping(keyMappingCount).vkCode = 36
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20224
  keyMapping(keyMappingCount).vkCode = 35
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 20992
  keyMapping(keyMappingCount).vkCode = 45
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 21248
  keyMapping(keyMappingCount).vkCode = 46
  keyMappingCount = keyMappingCount + 1

  ' Modifier Keys
  keyMapping(keyMappingCount).qbCode = 100303
  keyMapping(keyMappingCount).vkCode = 160
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 100304
  keyMapping(keyMappingCount).vkCode = 161
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 100305
  keyMapping(keyMappingCount).vkCode = 162
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 100306
  keyMapping(keyMappingCount).vkCode = 163
  keyMappingCount = keyMappingCount + 1

  ' Control Keys
  keyMapping(keyMappingCount).qbCode = 13
  keyMapping(keyMappingCount).vkCode = 13
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 27
  keyMapping(keyMappingCount).vkCode = 27
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 32
  keyMapping(keyMappingCount).vkCode = 32
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 9
  keyMapping(keyMappingCount).vkCode = 9
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 8
  keyMapping(keyMappingCount).vkCode = 8
  keyMappingCount = keyMappingCount + 1

  ' Function Keys
  keyMapping(keyMappingCount).qbCode = 15104
  keyMapping(keyMappingCount).vkCode = 112
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15360
  keyMapping(keyMappingCount).vkCode = 113
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15616
  keyMapping(keyMappingCount).vkCode = 114
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 15872
  keyMapping(keyMappingCount).vkCode = 115
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16128
  keyMapping(keyMappingCount).vkCode = 116
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16384
  keyMapping(keyMappingCount).vkCode = 117
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16640
  keyMapping(keyMappingCount).vkCode = 118
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 16896
  keyMapping(keyMappingCount).vkCode = 119
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 17152
  keyMapping(keyMappingCount).vkCode = 120
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 17408
  keyMapping(keyMappingCount).vkCode = 121
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34048
  keyMapping(keyMappingCount).vkCode = 122
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34304
  keyMapping(keyMappingCount).vkCode = 123
  keyMappingCount = keyMappingCount + 1

  ' Symbol Keys
  keyMapping(keyMappingCount).qbCode = 42
  keyMapping(keyMappingCount).vkCode = 106
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 43
  keyMapping(keyMappingCount).vkCode = 187
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 44
  keyMapping(keyMappingCount).vkCode = 188
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 45
  keyMapping(keyMappingCount).vkCode = 189
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 46
  keyMapping(keyMappingCount).vkCode = 190
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 47
  keyMapping(keyMappingCount).vkCode = 191
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 60
  keyMapping(keyMappingCount).vkCode = 188
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 61
  keyMapping(keyMappingCount).vkCode = 187
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 62
  keyMapping(keyMappingCount).vkCode = 190
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 63
  keyMapping(keyMappingCount).vkCode = 191
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 92
  keyMapping(keyMappingCount).vkCode = 220
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 95
  keyMapping(keyMappingCount).vkCode = 189
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 124
  keyMapping(keyMappingCount).vkCode = 220
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 39
  keyMapping(keyMappingCount).vkCode = 222
  keyMappingCount = keyMappingCount + 1

  keyMapping(keyMappingCount).qbCode = 34
  keyMapping(keyMappingCount).vkCode = 222
  keyMappingCount = keyMappingCount + 1

END SUB ' initKeyMapping

''''''''''''''''''''''''
FUNCTION parse_AXIS$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_AXIS", 3) = 0 THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("AXIS", "_VAL")
  IF scratchName$ = "" THEN
    parse_AXIS$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraCall "RT_AXIS", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_AXIS$ = scratchName$

END FUNCTION ' parse_AXIS$

''''''''''''''''''''''''
FUNCTION parse_BUTTON$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_BUTTON", 3) = 0 THEN
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("BUTTON", "_VAL")
  IF scratchName$ = "" THEN
    parse_BUTTON$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraCall "RT_BUTTON", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_BUTTON$ = scratchName$

END FUNCTION ' parse_BUTTON$

''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_Assign (startIdx)

' Copies a text string directly into the operating system clipboard

  DIM endIdx AS LONG
  DIM argVar$

  endIdx = lineTokenCount - 1

  IF startIdx + 1 > endIdx THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  argVar$ = tiraParseExpression$(startIdx + 2, endIdx, ALIM)
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_CLIPBOARD$ ASSIGN REQUIRES STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tiraCall "RT_SET_CLIPBOARD", 1, argVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_CLIPBOARD_Assign = 1

END FUNCTION ' parse_CLIPBOARD_Assign

''''''''''''''''''''''''
FUNCTION parse_COPYIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM comma1 AS LONG
  DIM scratchName$
  DIM srcVar$
  DIM skipZeroLbl$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_COPYIMAGE", 3) = 0 THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  IF comma1 > 0 THEN
    arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF

    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("CPYIMG", "_VAL")
  IF scratchName$ = "" THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF

  ' If the provided handle is 0, QB64 specifies that it copies the current destination screen
  srcVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcVar$, arg1$
  skipZeroLbl$ = tiraLabelCreateNew$("CPYIMG_SKIP_ZERO")
  tiraJmpCond "JNE", srcVar$, "0", skipZeroLbl$
  tiraAssign srcVar$, "!G_GFX_VAL_DEST_PAGE"
  tiraLabel skipZeroLbl$

  ' In the current architecture, DEST and PUTIMAGE strictly branch
  ' on handles 0, 1, 2, and 3. Similar to _NEWIMAGE, we map _COPYIMAGE directly
  ' to PAGE3 (3) and leverage the existing RT_PCOPY runtime helper to duplicate
  ' the source surface perfectly without requiring dynamic heap allocations.
  tiraCall "RT_PCOPY", 2, srcVar$ + ", 3"

  ' Return the new hardware surface handle
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "3"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_COPYIMAGE$ = scratchName$

END FUNCTION ' parse_COPYIMAGE$

''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_FUNC$ (startIdx, endIdx, allowImplicit)

' Retrieves the current text string from the operating system clipboard

  DIM scratchName$
  DIM descPtr$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _CLIPBOARD$", ASIS, 0
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("CLIP", "_DSC")
  IF scratchName$ = "" THEN
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF

  ' Allocate a local descriptor wrapper and push its address explicitly into the arguments
  ' so the Runtime Helper can physically write the required data pointers back into it
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  tiraCall "RT_GET_CLIPBOARD", 1, descPtr$

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CLIPBOARD_FUNC$ = scratchName$

END FUNCTION ' parse_CLIPBOARD_FUNC$

''''''''''''''''''''''''
FUNCTION parse_COS$ (startIdx, endIdx, allowImplicit)

' Calculates the cosine of a numeric expression

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM singleRes$
  DIM argFloat$

  IF checkIntrinsicSyntax(startIdx, endIdx, "COS", 3) = 0 THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("COS", "_VAL")
  IF scratchName$ = "" THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
    tiraAssign argFloat$, arg1$
    arg1$ = argFloat$
  END IF

  tiraCall "IAT_COS", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_COS$ = scratchName$

END FUNCTION ' parse_COS$

''''''''''''''''''''''''
FUNCTION parse_CVD$ (startIdx, endIdx, allowImplicit)

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVD", 3) = 0 THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" OR compileError = 1 THEN
    tira_Cancel
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("CVD", "_VAL")
  IF scratchName$ = "" THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 0 THEN
    tira_Cancel
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  ' Keep the hoisted result and memory read in the required numeric type
  symbols(returnedData2).DataType = TYPE_DOUBLE
  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  dataPtr$ = tiraGetStringData$(arg1$)
  strLen$ = tiraGetStringLen$(arg1$)

  validCvdLbl$ = tiraLabelCreateNew$("VALID_CVD")

  ' Check the required byte count before reading the numeric value
  tiraJmpCond "JGE", strLen$, "8", validCvdLbl$

  errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVD() ON LINE " + retLineNumberStr$ + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel validCvdLbl$

  tiraNew TC_READ_MEM, resVar$ + ", " + dataPtr$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  IF compileError = 1 THEN
    parse_CVD$ = ""
    EXIT FUNCTION
  END IF

  exprIs.DataType = TYPE_DOUBLE
  exprIs.IsTemp = 1
  parse_CVD$ = scratchName$

END FUNCTION ' parse_CVD$

