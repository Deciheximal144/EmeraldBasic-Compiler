''''''''''''''''''''''''
FUNCTION parse_NEXT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM parenDepth AS LONG
  DIM closeCount AS LONG
  DIM ctrlIdx AS LONG
  DIM closeIdx AS LONG
  DIM vIdx AS LONG
  DIM loopID AS LONG
  DIM endVarIdx AS LONG
  DIM stepVarIdx AS LONG
  DIM topLblIdx AS LONG
  DIM condLblIdx AS LONG
  DIM posStepLblIdx AS LONG
  DIM negStepLblIdx AS LONG
  DIM endNextLblIdx AS LONG

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "NEXT WITHOUT FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  closeCount = 0

  DO

    ctrlIdx = ctrlCount - closeCount - 1

    IF ctrlIdx < 0 THEN
      throwCompilerError "NEXT WITHOUT FOR", ASIS, 0
      EXIT FUNCTION
    END IF

    IF ctrls(ctrlIdx).TYPE <> CTRL_FOR THEN
      throwCompilerError "NEXT MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

    vIdx = ctrls(ctrlIdx).ForVarIdx

    IF endIdx > startIdx THEN
      parenDepth = 0

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
          parenDepth = parenDepth + 1
          tokIdx = tokIdx + 1
        ELSE
          EXIT DO
        END IF
      LOOP

      IF tokIdx > endIdx THEN
        throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      vTok$ = lineTokens$(tokIdx)
      baseName$ = UCASE$(vTok$)
      tokIdx = tokIdx + 1

      ' Handle legacy dot variables securely
      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          IF findSymbol(baseName$) THEN
            IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
          END IF
          IF cm.ClassicMode = 1 THEN
            IF tokIdx + 1 <= endIdx THEN
              baseName$ = baseName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
              tokIdx = tokIdx + 2
            ELSE
              EXIT DO
            END IF
          ELSE
            throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
            addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN
          parenDepth = parenDepth - 1
          tokIdx = tokIdx + 1
        ELSE
          EXIT DO
        END IF
      LOOP

      IF parenDepth <> 0 THEN
        throwCompilerError "UNMATCHED PARENTHESIS IN NEXT", ASIS, 0
        EXIT FUNCTION
      END IF

      IF baseName$ <> RTRIM$(symbols(vIdx).RecordName) THEN
        throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    closeCount = closeCount + 1

    IF endIdx = startIdx THEN EXIT DO
    IF tokIdx > endIdx THEN EXIT DO

    IF lineTokenVals(tokIdx) <> 256 + ASC(",") THEN
      throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1

    IF tokIdx > endIdx THEN
      throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

  LOOP

  tira_Start

  FOR closeIdx = 1 TO closeCount

    ctrlCount = ctrlCount - 1
    vIdx = ctrls(ctrlCount).ForVarIdx
    loopID = ctrls(ctrlCount).Patch1

    endNameTira$ = "!C_SYS_VAL_FOR_END_" + _TRIM$(STR$(loopID))
    ff = resolveSymbol(endNameTira$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endVarIdx = returnedData2

    stepNameTira$ = "!C_SYS_VAL_FOR_STEP_" + _TRIM$(STR$(loopID))
    ff = resolveSymbol(stepNameTira$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    stepVarIdx = returnedData2

    lblTop$ = "@FOR_TOP_" + _TRIM$(STR$(loopID))
    lblCond$ = "@FOR_COND_" + _TRIM$(STR$(loopID))
    lblPosStep$ = "@FOR_POS_" + _TRIM$(STR$(loopID))
    lblNegStep$ = "@FOR_NEG_" + _TRIM$(STR$(loopID))
    lblEndNext$ = "@FOR_DONE_" + _TRIM$(STR$(loopID))

    ' Apply step logic
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, stepVarIdx

    ff = resolveSymbol(lblCond$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    condLblIdx = returnedData2
    tiraLabelId condLblIdx

    ' Test step direction
    ff = resolveSymbol(lblNegStep$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    negStepLblIdx = returnedData2
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, stepVarIdx, TIRA_ARG_LITERAL, 0, negStepLblIdx

    ' Positive Step Check (Jump to end if we exceeded the boundary)
    ff = resolveSymbol(lblPosStep$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    posStepLblIdx = returnedData2
    tiraLabelId posStepLblIdx

    ff = resolveSymbol(lblEndNext$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endNextLblIdx = returnedData2
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, endVarIdx, endNextLblIdx
    tiraScheduleHeapResetId

    ff = resolveSymbol(lblTop$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx

    ' Negative Step Check (Jump to end if we exceeded the boundary)
    tiraLabelId negStepLblIdx
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, endVarIdx, endNextLblIdx
    tiraScheduleHeapResetId
    tiraJmpId topLblIdx

    ' Loop conclusion
    tiraLabelId endNextLblIdx
    tiraScheduleHeapResetId

  NEXT closeIdx

  tira_EndAndProcess

  parse_NEXT = 1

END FUNCTION ' parse_NEXT

''''''''''''''''''''''''
FUNCTION parse_NEWIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM arg3Type AS LONG
  DIM arg3Val AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM isScreenImage AS LONG
  DIM rectLowIdx AS LONG
  DIM rectHighIdx AS LONG
  DIM rectPtrIdx AS LONG
  DIM rectLeftIdx AS LONG
  DIM rectTopIdx AS LONG
  DIM rectRightIdx AS LONG
  DIM rectBottomIdx AS LONG
  DIM outerWidthIdx AS LONG
  DIM outerHeightIdx AS LONG
  DIM widthCorrectionIdx AS LONG
  DIM heightCorrectionIdx AS LONG
  DIM fullscreenScreenLblIdx AS LONG
  DIM screenResizeDoneLblIdx AS LONG

  DIM page2WidthIdx AS LONG
  DIM page2HeightIdx AS LONG
  DIM gDoubleIdx AS LONG
  DIM isFullscreenIdx AS LONG
  DIM windowHwndIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG

  DIM setWindowLongIdx AS LONG
  DIM adjustWindowRectIdx AS LONG
  DIM setWindowPosIdx AS LONG
  DIM getSystemMetricsIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_NEWIMAGE", 5) = 0 THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_NEWIMAGE REQUIRES AT LEAST 2 ARGUMENTS", ASIS, 0
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "WIDTH MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(comma2 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    arg3Type = tiraParsedArgType
    arg3Val = tiraParsedArgVal
  ELSE
    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal
  END IF

  scratchIdx = tiraResolveHoistVarId&("NEWIMG", "_VAL")
  IF scratchIdx = 0 THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  isScreenImage = 0
  IF startIdx > 0 THEN
    IF lineTokenVals(startIdx - 1) = TOK_SCREEN THEN isScreenImage = 1
  END IF

  ' Page 2 is the current backing surface used for independently created images
  ' Preserve its requested dimensions unless this image is being handed directly to SCREEN
  IF isScreenImage = 0 THEN
    ff = resolveSymbol("!G_GFX_V32_PAGE2W")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    page2WidthIdx = returnedData2

    ff = resolveSymbol("!G_GFX_V32_PAGE2H")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    page2HeightIdx = returnedData2

    tiraAssignId page2WidthIdx, arg1Type, arg1Val
    tiraAssignId page2HeightIdx, arg2Type, arg2Val
  ELSE
    ' A new SCREEN returns its later windowed form to native 1x sizing
    ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    gDoubleIdx = returnedData2
    tiraAssignId gDoubleIdx, TIRA_ARG_LITERAL, 0

    fullscreenScreenLblIdx = tiraLabelCreateNewId&("SCREEN_FULLSCREEN")
    screenResizeDoneLblIdx = tiraLabelCreateNewId&("SCREEN_RESIZE_DONE")

    ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    isFullscreenIdx = returnedData2

    ' Preserve fullscreen while changing only its logical SCREEN dimensions
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFullscreenIdx, TIRA_ARG_LITERAL, 1, fullscreenScreenLblIdx

    ' Two adjacent 64-bit temporaries provide the 16-byte RECT required by AdjustWindowRectEx
    rectLowIdx = tiraDimVarId&("SCREENRECTLOW", TYPE_INTEGER64)
    rectHighIdx = tiraDimVarId&("SCREENRECTHIGH", TYPE_INTEGER64)
    tiraAssignId rectLowIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId rectHighIdx, TIRA_ARG_LITERAL, 0

    rectPtrIdx = tiraDimVarId&("SCREENRECTPTR", TYPE_INTEGER64)
    ' User-code temporaries grow upward, so the first temporary is the RECT base
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_SYMBOL, rectLowIdx

    ' RECT.Right and RECT.Bottom receive the requested client dimensions
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 8, arg1Type, arg1Val, TIRA_ARG_LITERAL, 4
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 12, arg2Type, arg2Val, TIRA_ARG_LITERAL, 4

    ff = resolveSymbol("!G_WND_VAL_HWND")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    windowHwndIdx = returnedData2

    ff = resolveSymbol("IAT_SETWINDOWLONGA")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    setWindowLongIdx = returnedData2

    ' SCREEN creates a normal window before calculating the required outer dimensions
    tiraCallId3 setWindowLongIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -16, TIRA_ARG_LITERAL, 13565952

    ff = resolveSymbol("IAT_ADJUSTWINDOWRECTEX")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    adjustWindowRectIdx = returnedData2

    tiraCallId4 adjustWindowRectIdx, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_LITERAL, 13565952, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

    rectLeftIdx = tiraDimVarId&("SCREENRECTLEFT", TYPE_LONG)
    tiraReadMemId rectLeftIdx, TIRA_ARG_SYMBOL, rectPtrIdx

    rectTopIdx = tiraDimVarId&("SCREENRECTTOP", TYPE_LONG)
    tiraReadMemOffsetId rectTopIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 4

    rectRightIdx = tiraDimVarId&("SCREENRECTRIGHT", TYPE_LONG)
    tiraReadMemOffsetId rectRightIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 8

    rectBottomIdx = tiraDimVarId&("SCREENRECTBOTTOM", TYPE_LONG)
    tiraReadMemOffsetId rectBottomIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 12

    outerWidthIdx = tiraDimVarId&("SCREENOUTERWIDTH", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, rectRightIdx, TIRA_ARG_SYMBOL, rectLeftIdx

    outerHeightIdx = tiraDimVarId&("SCREENOUTERHEIGHT", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, rectBottomIdx, TIRA_ARG_SYMBOL, rectTopIdx

    ff = resolveSymbol("IAT_SETWINDOWPOS")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    setWindowPosIdx = returnedData2

    ' HWND_NOTOPMOST with SWP_NOMOVE, SWP_FRAMECHANGED and SWP_SHOWWINDOW
    tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

    ff = resolveSymbol("!G_WND_VAL_WIDTH")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    windowWidthIdx = returnedData2

    ff = resolveSymbol("!G_WND_VAL_HEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    windowHeightIdx = returnedData2

    ' Correct each outer dimension from the actual client size reported by WM_SIZE
    widthCorrectionIdx = tiraDimVarId&("SCREENWIDTHCORRECTION", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthCorrectionIdx, arg1Type, arg1Val, TIRA_ARG_SYMBOL, windowWidthIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, widthCorrectionIdx

    heightCorrectionIdx = tiraDimVarId&("SCREENHEIGHTCORRECTION", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, heightCorrectionIdx, arg2Type, arg2Val, TIRA_ARG_SYMBOL, windowHeightIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, heightCorrectionIdx

    tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, windowHwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

    tiraJmpId screenResizeDoneLblIdx

    tiraLabelId fullscreenScreenLblIdx

    ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    getSystemMetricsIdx = returnedData2

    ' Keep fullscreen mouse and rendering scale tied to physical desktop pixels
    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 0
    tiraGetRetId windowWidthIdx

    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 1
    tiraGetRetId windowHeightIdx

    tiraLabelId screenResizeDoneLblIdx

    ff = resolveSymbol("!G_GFX_V32_SCRNW")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    screenWidthIdx = returnedData2

    ff = resolveSymbol("!G_GFX_V32_SCRNH")
    IF ff = 0 THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
    screenHeightIdx = returnedData2

    ' Preserve the active SCREEN coordinate space independently from fullscreen sizing
    tiraAssignId screenWidthIdx, arg1Type, arg1Val
    tiraAssignId screenHeightIdx, arg2Type, arg2Val
  END IF

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 2

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_NEWIMAGE$ = scratchName$

END FUNCTION ' parse_NEWIMAGE$

''''''''''''''''''''''''
FUNCTION parse_OFFSET$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM addrVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_OFFSET", 3) = 0 THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Support dot variable syntax gracefully to map cleanly with older structural integrations
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN _OFFSET", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("OFFSET", "_PTR")
  IF scratchIdx = 0 THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF hasIndex = 0 AND hasField = 0 THEN
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
  ELSE
    addrVarIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
    IF compileError = 1 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, addrVarIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_OFFSET$ = scratchName$

END FUNCTION ' parse_OFFSET$

''''''''''''''''''''''''
FUNCTION parse_ON (startIdx)

  DIM endIdx AS LONG
  DIM closeParen AS LONG
  DIM targetLabelIdx AS LONG
  DIM eventNumberType AS LONG
  DIM eventNumberVal AS _INTEGER64
  DIM invalidKeyLblIdx AS LONG
  DIM validKeyLblIdx AS LONG
  DIM eventIndexIdx AS LONG
  DIM keyHandlerIdx AS LONG
  DIM handlerBaseIdx AS LONG
  DIM handlerSlotIdx AS LONG
  DIM handlerAddressIdx AS LONG
  DIM errorLabelIdx AS LONG
  DIM errorHandlerIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx >= startIdx + 1 THEN
    IF lineTokenVals(startIdx + 1) = TOK_KEY THEN
      IF endIdx < startIdx + 4 THEN
        throwCompilerError "MALFORMED ON KEY STATEMENT", ASIS, 0
        EXIT FUNCTION
      END IF

      IF lineTokenVals(startIdx + 2) <> TOK_OP_LPAREN THEN
        throwCompilerError "ON KEY REQUIRES (n)", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = findMatchingParen(startIdx + 2, endIdx)
      IF ff = 0 THEN
        throwCompilerError "ON KEY MISSING )", ASIS, 0
        EXIT FUNCTION
      END IF
      closeParen = returnedData2

      IF closeParen <= startIdx + 3 THEN
        throwCompilerError "ON KEY REQUIRES EVENT NUMBER", ASIS, 0
        EXIT FUNCTION
      END IF

      IF closeParen >= endIdx THEN
        throwCompilerError "ON KEY REQUIRES GOSUB LABEL", ASIS, 0
        EXIT FUNCTION
      END IF

      IF lineTokenVals(closeParen + 1) <> TOK_GOSUB THEN
        throwCompilerError "ON KEY CURRENTLY REQUIRES GOSUB", ASIS, 0
        EXIT FUNCTION
      END IF

      IF closeParen + 2 > endIdx THEN
        throwCompilerError "ON KEY GOSUB NEEDS LABEL", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = verifyNoExtraTokens(endIdx, closeParen + 2, "ON KEY GOSUB")
      IF ff = 0 THEN EXIT FUNCTION

      targetTok$ = lineTokens$(closeParen + 2)
      targetLabelName$ = "%" + UCASE$(targetTok$)

      expectedSymType = TYPE_LABEL
      ff = resolveSymbol(targetLabelName$)
      IF ff = 0 THEN EXIT FUNCTION
      targetLabelIdx = returnedData2

      ensureKeyEventSymbols
      IF compileError = 1 THEN EXIT FUNCTION

      rtIsUsed(RT_KEY_EVENT) = 1

      tira_Start

      ff = tiraParseExpressionIntId(startIdx + 3, closeParen - 1, ALIM, "ON KEY EVENT NUMBER MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      eventNumberType = tiraParsedArgType
      eventNumberVal = tiraParsedArgVal

      invalidKeyLblIdx = tiraLabelCreateNewId&("ON_KEY_NUMBER_INVALID")
      validKeyLblIdx = tiraLabelCreateNewId&("ON_KEY_NUMBER_VALID")

      tiraJmpCondId JCC_JL, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, 1, invalidKeyLblIdx
      tiraJmpCondId JCC_JLE, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, KEY_EVENT_COUNT, validKeyLblIdx

      tiraLabelId invalidKeyLblIdx
      tiraFatalErrorId "ILLEGAL FUNCTION CALL"

      tiraLabelId validKeyLblIdx

      eventIndexIdx = tiraDimVarId&("T", TYPE_UINT64)
      tiraAssignId eventIndexIdx, eventNumberType, eventNumberVal
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, 1

      ff = resolveSymbol("!G_INO_ARR_KEYHANDLER")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      keyHandlerIdx = returnedData2

      handlerBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlerBaseIdx, TIRA_ARG_SYMBOL, keyHandlerIdx

      handlerSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, handlerSlotIdx, TIRA_ARG_SYMBOL, handlerBaseIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

      handlerAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlerAddressIdx, TIRA_ARG_LABEL, targetLabelIdx
      tiraWriteMemId TIRA_ARG_SYMBOL, handlerSlotIdx, TIRA_ARG_SYMBOL, handlerAddressIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

      tiraScheduleHeapResetId
      tira_EndAndProcess

      parse_ON = 1
      EXIT FUNCTION
    END IF
  END IF

  IF endIdx >= startIdx + 3 THEN
    IF lineTokenVals(startIdx + 1) = TOK_ERROR THEN
      IF lineTokenVals(startIdx + 2) = TOK_GOTO THEN
        ff = verifyNoExtraTokens(endIdx, startIdx + 3, "ON ERROR GOTO")
        IF ff = 0 THEN EXIT FUNCTION

        lblTok$ = lineTokens$(startIdx + 3)

        tira_Start

        IF lblTok$ <> "0" THEN
          lblName$ = "%" + UCASE$(lblTok$)
          ff = resolveSymbol(lblName$)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorLabelIdx = returnedData2

          ff = resolveSymbol("!G_ERR_PTR_HANDLER")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorHandlerIdx = returnedData2

          tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, errorHandlerIdx, TIRA_ARG_LABEL, errorLabelIdx
        ELSE
          ff = resolveSymbol("!G_ERR_PTR_HANDLER")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorHandlerIdx = returnedData2

          tiraAssignId errorHandlerIdx, TIRA_ARG_LITERAL, 0
        END IF

        tiraScheduleHeapResetId
        tira_EndAndProcess

        parse_ON = 1
        EXIT FUNCTION
      END IF
    END IF
  END IF

  throwCompilerError "UNSUPPORTED OR MALFORMED ON STATEMENT", ASIS, 0

END FUNCTION ' parse_ON

''''''''''''''''''''''''
FUNCTION parse_OUT (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM portVarType AS LONG
  DIM portVarVal AS _INTEGER64
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "OUT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  commaIdx = findComma(startIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerError "OUT REQUIRES PORT AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, commaIdx - 1, ALIM, "PORT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  portVarType = tiraParsedArgType
  portVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(commaIdx + 1, endIdx, ALIM, "VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_OUT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, portVarType, portVarVal, valVarType, valVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_OUT = 1

END FUNCTION ' parse_OUT

''''''''''''''''''''''''
FUNCTION parse_PAINT (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM fillEnd AS LONG
  DIM coordinateEnd AS LONG
  DIM hasFill AS LONG
  DIM hasBorder AS LONG

  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM fillVarType AS LONG
  DIM fillVarVal AS _INTEGER64
  DIM borderVarType AS LONG
  DIM borderVarVal AS _INTEGER64

  DIM stepXIdx AS LONG
  DIM stepYIdx AS LONG
  DIM fillIsStrIdx AS LONG
  DIM borderVarIdx AS LONG
  DIM lblDefBorderIdx AS LONG
  DIM lblBorderDoneIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM paintFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  hasStep = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      hasStep = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  coordinateEnd = endIdx
  hasFill = 0
  hasBorder = 0

  IF comma1 > 0 THEN
    coordinateEnd = comma1 - 1
    comma2 = findComma(comma1 + 1, endIdx)

    fillEnd = endIdx
    IF comma2 > 0 THEN fillEnd = comma2 - 1

    IF comma1 + 1 <= fillEnd THEN hasFill = 1

    IF comma2 > 0 THEN
      IF comma2 + 1 <= endIdx THEN hasBorder = 1
    END IF
  END IF

  cComma = retCoordinateBoundaries(tokIdx, coordinateEnd)
  IF cComma = 0 THEN
    throwCompilerError "PAINT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  IF hasStep = 1 THEN
    stepXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, stepXIdx, TIRA_ARG_SYMBOL, currentXIdx, xVarType, xVarVal
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = stepXIdx

    stepYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, stepYIdx, TIRA_ARG_SYMBOL, currentYIdx, yVarType, yVarVal
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = stepYIdx
  END IF

  fillIsStrIdx = tiraDimVarId&("T", TYPE_LONG)

  IF hasFill = 1 THEN
    ff = tiraParseExpressionId(comma1 + 1, fillEnd, ALIM)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fillVarType = tiraParsedArgType
    fillVarVal = tiraParsedArgVal

    IF exprIs.DataType = TYPE_STRING THEN
      tiraAssignId fillIsStrIdx, TIRA_ARG_LITERAL, 1
    ELSE
      tiraAssignId fillIsStrIdx, TIRA_ARG_LITERAL, 0
    END IF
  ELSE
    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    foregroundIdx = returnedData2

    fillVarType = TIRA_ARG_SYMBOL
    fillVarVal = foregroundIdx
    tiraAssignId fillIsStrIdx, TIRA_ARG_LITERAL, 0
  END IF

  IF hasBorder = 1 THEN
    ff = tiraParseExpressionIntId(comma2 + 1, endIdx, ALIM, "BORDER COLOR MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    borderVarType = tiraParsedArgType
    borderVarVal = tiraParsedArgVal
  ELSE
    borderVarIdx = tiraDimVarId&("T", TYPE_LONG)
    lblDefBorderIdx = tiraLabelCreateNewId&("DEF_BORDER")
    lblBorderDoneIdx = tiraLabelCreateNewId&("BORDER_DONE")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fillIsStrIdx, TIRA_ARG_LITERAL, 1, lblDefBorderIdx
    tiraAssignId borderVarIdx, fillVarType, fillVarVal
    tiraJmpId lblBorderDoneIdx
    tiraLabelId lblDefBorderIdx

    IF hasFill = 1 THEN
      ff = resolveSymbol("!G_GFX_VAL_FG")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      foregroundIdx = returnedData2
    END IF

    tiraAssignId borderVarIdx, TIRA_ARG_SYMBOL, foregroundIdx
    tiraLabelId lblBorderDoneIdx

    borderVarType = TIRA_ARG_SYMBOL
    borderVarVal = borderVarIdx
  END IF

  ' Update graphics tracking coordinates
  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  ff = resolveSymbol("RT_PAINT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  paintFuncIdx = returnedData2

  tiraCallId5 paintFuncIdx, xVarType, xVarVal, yVarType, yVarVal, fillVarType, fillVarVal, TIRA_ARG_SYMBOL, fillIsStrIdx, borderVarType, borderVarVal

  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PAINT = 1

END FUNCTION ' parse_PAINT

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR (startIdx)

  DIM comma1 AS LONG
  DIM idxVarType AS LONG
  DIM idxVarVal AS _INTEGER64
  DIM colorVarType AS LONG
  DIM colorVarVal AS _INTEGER64
  DIM skipLblIdx AS LONG
  DIM paletteIdx AS LONG
  DIM palDescPtrIdx AS LONG
  DIM palDataAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  idxVarType = tiraParsedArgType
  idxVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  colorVarType = tiraParsedArgType
  colorVarVal = tiraParsedArgVal

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PAL")

  tiraJmpCondId JCC_JL, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraJmpCondId JCC_JG, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 255, skipLblIdx

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  paletteIdx = returnedData2

  palDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId palDescPtrIdx, TIRA_ARG_SYMBOL, paletteIdx

  palDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId palDataAddrIdx, TIRA_ARG_SYMBOL, palDescPtrIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 4

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 4

  tiraTriggerAutoDisplayId

  tiraLabelId skipLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PALETTECOLOR = 1

END FUNCTION ' parse_PALETTECOLOR

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM paletteIdx AS LONG
  DIM palDescPtrIdx AS LONG
  DIM palDataAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM skipLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_PALETTECOLOR", 3) = 0 THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INDEX MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("PALCOL", "_VAL")
  IF scratchIdx = 0 THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PALCOL")

  tiraJmpCondId JCC_JL, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraJmpCondId JCC_JG, arg1Type, arg1Val, TIRA_ARG_LITERAL, 255, skipLblIdx

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF
  paletteIdx = returnedData2

  palDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId palDescPtrIdx, TIRA_ARG_SYMBOL, paletteIdx

  palDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId palDataAddrIdx, TIRA_ARG_SYMBOL, palDescPtrIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 4

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, targetAddrIdx

  tiraLabelId skipLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_PALETTECOLOR_FUNC$ = scratchName$

END FUNCTION ' parse_PALETTECOLOR_FUNC$

''''''''''''''''''''''''
FUNCTION parse_PEEK$ (startIdx, endIdx, allowImplicit)

  ' This function evaluates the peek command to read data from memory
  ' Address 1047 emulates the legacy DOS keyboard flags byte
  ' Address 1132 emulates the low byte of the BIOS timer tick counter

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM checkTimerLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM stateVarIdx AS LONG
  DIM flagsVarIdx AS LONG
  DIM tickVarIdx AS LONG
  DIM elapsedVarIdx AS LONG
  DIM timerLblIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM pixelVarIdx AS LONG
  DIM graphicsDoneLblIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG
  DIM getKeyStateIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM peekTickIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "PEEK", 3) = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ' Evaluate the memory address argument passed to the peek function
  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "PEEK REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("PEEK", "_VAL")
  IF scratchIdx = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Initialize the return variable with a default value of zero for any unhandled memory addresses
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  ' Check the keyboard flags compatibility address first
  checkTimerLblIdx = tiraLabelCreateNewId&("CHECK_PEEK_TIMER")
  doneLblIdx = tiraLabelCreateNewId&("DONE_PEEK")
  tiraJmpCondId JCC_JNE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1047, checkTimerLblIdx

  ' Build the complete BIOS keyboard flags byte used by classic programs
  flagsVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId flagsVarIdx, TIRA_ARG_LITERAL, 0

  ' Bit zero reports the right Shift key
  ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getAsyncKeyStateIdx = returnedData2
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 161
  stateVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 15
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit one reports the left Shift key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 160
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 14
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit two reports either Control key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 17
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 13
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit three reports either Alt key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 18
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 12
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit four reports the Scroll Lock toggle state
  ff = resolveSymbol("IAT_GETKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getKeyStateIdx = returnedData2
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 145
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Ask windows for the actual state of the numlock key
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 144
  tiraGetRetId stateVarIdx

  ' Mask out all but the lowest bit to get the clean toggle state
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1

  ' Shift the bit left into the bit five position to emulate the legacy keyboard flag
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 5
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit six reports the Caps Lock toggle state
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 20
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 6
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit seven reports the Insert toggle state
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 45
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 7
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Assign the emulated flag byte to the return variable
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx
  tiraJmpId doneLblIdx

  tiraLabelId checkTimerLblIdx

  timerLblIdx = tiraLabelCreateNewId&("PEEK_TIMER")
  tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1132, timerLblIdx

  IF cm.HasGraphics = 1 THEN
    ' Graphics PEEK addresses are linear offsets into the active destination framebuffer
    offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, offsetVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 65535

    graphicsDoneLblIdx = tiraLabelCreateNewId&("PEEK_GRAPHICS_DONE")

    ' Bytes in the unused tail of the 64K graphics segment read back as zero
    tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY, graphicsDoneLblIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      parse_PEEK$ = ""
      EXIT FUNCTION
    END IF
    gfxDestIdx = returnedData2

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

    targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    pixelVarIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId pixelVarIdx, TIRA_ARG_SYMBOL, targetAddrIdx
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, pixelVarIdx
    tiraJmpId graphicsDoneLblIdx

    tiraLabelId graphicsDoneLblIdx
  END IF

  ' Leave unhandled addresses at the default value of zero
  tiraJmpId doneLblIdx

  tiraLabelId timerLblIdx

  ' Convert milliseconds since the matching POKE reset into approximately 18.2 BIOS ticks per second
  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getTickCountIdx = returnedData2
  tiraCallId0 getTickCountIdx
  tickVarIdx = tiraDimVarId&("T", TYPE_ULONG)
  tiraGetRetId tickVarIdx

  ff = resolveSymbol("!G_SYS_VAL_PEEK1132_TICK")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  peekTickIdx = returnedData2

  elapsedVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, tickVarIdx, TIRA_ARG_SYMBOL, peekTickIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_LITERAL, 55

  ' PEEK returns a byte, matching the low byte stored at BIOS data address 1132
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_LITERAL, 255
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx

  tiraLabelId doneLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_PEEK$ = scratchName$

END FUNCTION ' parse_PEEK$

''''''''''''''''''''''''
FUNCTION parse_POINT$ (startIdx, endIdx, allowImplicit)

' Returns the color attribute of a specific pixel on the screen

  DIM comma1 AS LONG
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM colorByteIdx AS LONG
  DIM lblXIdx AS LONG
  DIM lblYIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM sourceFrameIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "POINT", 3) = 0 THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "POINT REQUIRES #GRAPHICS", ASIS, 0
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("POINT", "_VAL")
  IF scratchIdx = 0 THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

  IF comma1 = 0 THEN
    ' 1 argument: POINT(n)
    ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "POINT ARGUMENT MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    lblXIdx = tiraLabelCreateNewId&("PT_X")
    lblYIdx = tiraLabelCreateNewId&("PT_Y")
    lblEndIdx = tiraLabelCreateNewId&("PT_END")

    tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, lblXIdx
    tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 2, lblXIdx
    tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1, lblYIdx
    tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 3, lblYIdx
    tiraJmpId lblEndIdx

    tiraLabelId lblXIdx

    ff = resolveSymbol("!G_GFX_VAL_CUR_X")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    currentXIdx = returnedData2

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, currentXIdx
    tiraJmpId lblEndIdx

    tiraLabelId lblYIdx

    ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    currentYIdx = returnedData2

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, currentYIdx
    tiraLabelId lblEndIdx

  ELSE
    ' 2 arguments: POINT(x, y)
    ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal

    skipLblIdx = tiraLabelCreateNewId&("PT_SKIP")

    ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
    tiraJmpCondId JCC_JAE, arg1Type, arg1Val, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipLblIdx
    tiraJmpCondId JCC_JAE, arg2Type, arg2Val, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipLblIdx

    offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, arg1Type, arg1Val

    ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF
    sourceFrameIdx = returnedData2

    targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, sourceFrameIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    colorByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId colorByteIdx, TIRA_ARG_SYMBOL, targetAddrIdx

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, colorByteIdx

    tiraLabelId skipLblIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_POINT$ = scratchName$

END FUNCTION ' parse_POINT$

''''''''''''''''''''''''
FUNCTION parse_POKE (startIdx)

  ' This function evaluates the poke command to write data into memory
  ' Rather than exposing direct memory access which would crash a modern operating system
  ' specific features are emulated, such as address 1047. In legacy dos systems, address 1047 holds
  ' the keyboard flags where the bit representing 32 controls the numlock state
  ' If the user script tries to write to 1047, we extract the requested numlock state
  ' and use the windows api to simulate physical key presses if the state needs to change

  DIM commaIdx AS LONG
  DIM addrVarType AS LONG
  DIM addrVarVal AS _INTEGER64
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM skipLblIdx AS LONG
  DIM desiredIdx AS LONG
  DIM currentIdx AS LONG
  DIM getKeyStateIdx AS LONG
  DIM keybdEventIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx = 0 THEN
    throwCompilerError "POKE MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Evaluate the address and value arguments provided by the user script
  ff = tiraParseExpressionIntId(startIdx + 1, commaIdx - 1, ALIM, "POKE ADDRESS MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  addrVarType = tiraParsedArgType
  addrVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(commaIdx + 1, endIdx, ALIM, "POKE VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  ' Create a jump label to skip the emulation block if the address is not exactly 1047
  skipLblIdx = tiraLabelCreateNewId&("SKIP_POKE")
  tiraJmpCondId JCC_JNE, addrVarType, addrVarVal, TIRA_ARG_LITERAL, 1047, skipLblIdx

  ' Extract the target state by masking out the thirty two bit and shifting it down to the lowest bit position
  desiredIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, desiredIdx, valVarType, valVarVal, TIRA_ARG_LITERAL, 32
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_LITERAL, 5

  ' Ask windows for the current hardware state of the numlock key using its virtual key code
  ff = resolveSymbol("IAT_GETKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  getKeyStateIdx = returnedData2
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 144
  currentIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId currentIdx

  ' Mask the windows return value to isolate just the active toggle state bit
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, currentIdx, TIRA_ARG_SYMBOL, currentIdx, TIRA_ARG_LITERAL, 1

  ' Compare the requested state with the current hardware state and jump past the toggle event if they match
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_SYMBOL, currentIdx, skipLblIdx

  ' Fire down and up keyboard events to physically toggle the numlock key at the hardware level
  ff = resolveSymbol("IAT_KEYBD_EVENT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  keybdEventIdx = returnedData2
  tiraCallId4 keybdEventIdx, TIRA_ARG_LITERAL, 144, TIRA_ARG_LITERAL, 69, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0
  tiraCallId4 keybdEventIdx, TIRA_ARG_LITERAL, 144, TIRA_ARG_LITERAL, 69, TIRA_ARG_LITERAL, 3, TIRA_ARG_LITERAL, 0

  tiraLabelId skipLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_POKE = 1

END FUNCTION ' parse_POKE

''''''''''''''''''''''''
FUNCTION parse_POKE_Compat (startIdx)

  ' Preserve the ignored POKE behavior except for the literal BIOS timer reset used by legacy timer polling code
  ' Graphics framebuffer offsets are additionally supported for classic screen compatibility

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM addrStartIdx AS LONG
  DIM addrEndIdx AS LONG
  DIM valueStartIdx AS LONG
  DIM valueEndIdx AS LONG
  DIM isTimerReset AS LONG
  DIM addrVarType AS LONG
  DIM addrVarVal AS _INTEGER64
  DIM valueVarType AS LONG
  DIM valueVarVal AS _INTEGER64
  DIM offsetVarIdx AS LONG
  DIM byteVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM donePokeLblIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM tickVarIdx AS LONG
  DIM peekTickIdx AS LONG

  endIdx = lineTokenCount - 1
  commaIdx = findComma(startIdx + 1, endIdx)
  isTimerReset = 0

  IF commaIdx > 0 THEN
    addrStartIdx = startIdx + 1
    addrEndIdx = commaIdx - 1
    valueStartIdx = commaIdx + 1
    valueEndIdx = endIdx

    ' Accept either POKE 1132, 0 or POKE (1132), 0
    IF addrStartIdx < addrEndIdx THEN
      IF lineTokenVals(addrStartIdx) = 256 + ASC("(") AND lineTokenVals(addrEndIdx) = 256 + ASC(")") THEN
        addrStartIdx = addrStartIdx + 1
        addrEndIdx = addrEndIdx - 1
      END IF
    END IF

    IF valueStartIdx < valueEndIdx THEN
      IF lineTokenVals(valueStartIdx) = 256 + ASC("(") AND lineTokenVals(valueEndIdx) = 256 + ASC(")") THEN
        valueStartIdx = valueStartIdx + 1
        valueEndIdx = valueEndIdx - 1
      END IF
    END IF

    IF addrStartIdx = addrEndIdx AND valueStartIdx = valueEndIdx THEN
      IF lineTokens$(addrStartIdx) = "1132" AND lineTokens$(valueStartIdx) = "0" THEN
        isTimerReset = 1
      END IF
    END IF
  END IF

  IF commaIdx = 0 THEN
    throwCompilerError "POKE REQUIRES ADDRESS AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF isTimerReset = 0 THEN
    IF cm.HasGraphics = 0 THEN
      parse_POKE_Compat = parse_POKE(startIdx)
      EXIT FUNCTION
    END IF

    tira_Start

    ' Graphics POKE addresses are linear offsets into the active destination framebuffer
    ff = tiraParseExpressionIntId(addrStartIdx, addrEndIdx, ALIM, "POKE ADDRESS MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    addrVarType = tiraParsedArgType
    addrVarVal = tiraParsedArgVal

    ff = tiraParseExpressionIntId(valueStartIdx, valueEndIdx, ALIM, "POKE VALUE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    valueVarType = tiraParsedArgType
    valueVarVal = tiraParsedArgVal

    offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ' Convert the classic signed INTEGER representation into its unsigned 16-bit segment offset
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, offsetVarIdx, addrVarType, addrVarVal, TIRA_ARG_LITERAL, 65535

    donePokeLblIdx = tiraLabelCreateNewId&("POKE_DONE")

    ' Reject segment offsets beyond the active framebuffer
    ' Safely discard writes into the unused tail of the 64K graphics segment
    tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY, donePokeLblIdx

    byteVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, byteVarIdx, valueVarType, valueVarVal, TIRA_ARG_LITERAL, 255

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxDestIdx = returnedData2

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

    targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, byteVarIdx, TIRA_ARG_LITERAL, 1
    tiraTriggerAutoDisplayId
    tiraJmpId donePokeLblIdx

    tiraLabelId donePokeLblIdx

    tira_EndAndProcess

    parse_POKE_Compat = 1
    EXIT FUNCTION
  END IF

  tira_Start

  ' Record the reset time so later PEEK(1132) calls return elapsed BIOS-style ticks
  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  getTickCountIdx = returnedData2
  tiraCallId0 getTickCountIdx

  tickVarIdx = tiraDimVarId&("T", TYPE_ULONG)
  tiraGetRetId tickVarIdx

  ff = resolveSymbol("!G_SYS_VAL_PEEK1132_TICK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  peekTickIdx = returnedData2
  tiraAssignId peekTickIdx, TIRA_ARG_SYMBOL, tickVarIdx

  tira_EndAndProcess

  parse_POKE_Compat = 1

END FUNCTION ' parse_POKE_Compat

''''''''''''''''''''''''
FUNCTION parse_PRESET (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM coordStart AS LONG
  DIM isParen AS LONG
  DIM commaColor AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cStartCoord AS LONG
  DIM cEndCoord AS LONG
  DIM cStartColor AS LONG
  DIM cEndColor AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG
  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM cVarType AS LONG
  DIM cVarVal AS _INTEGER64
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM lastBgIdx AS LONG
  DIM newXIdx AS LONG
  DIM newYIdx AS LONG
  DIM colorVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM cMaskIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM targetAddrIdx AS LONG

  endIdx = lineTokenCount - 1

  hasStep = 0
  coordStart = startIdx + 1

  IF coordStart <= endIdx THEN
    IF lineTokenVals(coordStart) = TOK_STEP THEN
      hasStep = 1
      coordStart = coordStart + 1
    END IF
  END IF

  IF coordStart > endIdx THEN
    throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
    EXIT FUNCTION
  END IF

  isParen = 0
  IF lineTokenVals(coordStart) = 256 + ASC("(") THEN isParen = 1

  ' Seamlessly map varying PRESET syntax (parens vs plain) and strip optional color payload
  IF isParen = 1 THEN
    commaColor = findComma(coordStart, endIdx)
    IF commaColor > 0 THEN
      cStartCoord = coordStart
      cEndCoord = commaColor - 1
      cStartColor = commaColor + 1
      cEndColor = endIdx
    ELSE
      cStartCoord = coordStart
      cEndCoord = endIdx
      cStartColor = 0
      cEndColor = 0
    END IF
  ELSE
    comma1 = findComma(coordStart, endIdx)
    IF comma1 = 0 THEN
      throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
      EXIT FUNCTION
    END IF
    comma2 = findComma(comma1 + 1, endIdx)

    IF comma2 > 0 THEN
      cStartCoord = coordStart
      cEndCoord = comma2 - 1
      cStartColor = comma2 + 1
      cEndColor = endIdx
    ELSE
      cStartCoord = coordStart
      cEndCoord = endIdx
      cStartColor = 0
      cEndColor = 0
    END IF
  END IF

  cComma = retCoordinateBoundaries(cStartCoord, cEndCoord)
  IF cComma = 0 THEN
    throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  IF hasStep = 1 THEN
    newXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newXIdx, TIRA_ARG_SYMBOL, currentXIdx, xVarType, xVarVal
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = newXIdx

    newYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newYIdx, TIRA_ARG_SYMBOL, currentYIdx, yVarType, yVarVal
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = newYIdx
  END IF

  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  IF cStartColor > 0 THEN
    ff = tiraParseExpressionIntId(cStartColor, cEndColor, ALIM, "COLOR MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    cVarType = tiraParsedArgType
    cVarVal = tiraParsedArgVal
  ELSE
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2

    colorVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId colorVarIdx, TIRA_ARG_SYMBOL, lastBgIdx
    cVarType = TIRA_ARG_SYMBOL
    cVarVal = colorVarIdx
  END IF

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PRESET")

  ' Strict hardware bounds check, unsigned evaluation gracefully covers negative coordinate drops
  tiraJmpCondId JCC_JAE, xVarType, xVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipLblIdx
  tiraJmpCondId JCC_JAE, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipLblIdx

  cMaskIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cMaskIdx, cVarType, cVarVal, TIRA_ARG_LITERAL, 255

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, xVarType, xVarVal

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gfxDestIdx = returnedData2

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, cMaskIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipLblIdx

  tiraTriggerAutoDisplayId

  tira_EndAndProcess

  parse_PRESET = 1

END FUNCTION ' parse_PRESET

''''''''''''''''''''''''
FUNCTION parse_PRINTSTRING (startIdx)

  DIM endIdx AS LONG
  DIM coordStart AS LONG
  DIM isParen AS LONG
  DIM commaText AS LONG
  DIM commaExtra AS LONG
  DIM cStartCoord AS LONG
  DIM cEndCoord AS LONG
  DIM textStart AS LONG
  DIM textEnd AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG

  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM textVarType AS LONG
  DIM textVarVal AS _INTEGER64
  DIM colorVarIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM drawTextFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PRINTSTRING REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  coordStart = startIdx + 1
  IF coordStart > endIdx THEN
    throwCompilerError "EXPECTED (X, Y) AFTER _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF

  isParen = 0
  IF lineTokenVals(coordStart) = 256 + ASC("(") THEN isParen = 1

  IF isParen = 0 THEN
    throwCompilerError "_PRINTSTRING EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(coordStart, endIdx)
  IF ff = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF
  cEndCoord = returnedData2
  cStartCoord = coordStart

  commaText = findComma(cEndCoord + 1, endIdx)
  IF commaText = 0 THEN
    throwCompilerError "_PRINTSTRING EXPECTS COMMA AFTER COORDINATES", ASIS, 0
    EXIT FUNCTION
  END IF

  textStart = commaText + 1
  textEnd = endIdx

  commaExtra = findComma(textStart, endIdx)
  IF commaExtra > 0 THEN
    throwCompilerError "_PRINTSTRING DOES NOT ACCEPT A COLOR ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(cStartCoord, cEndCoord)
  IF cComma = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = tiraParseExpressionId(textStart, textEnd, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  textVarType = tiraParsedArgType
  textVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_PRINTSTRING EXPECTS STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  colorVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ff = resolveSymbol("!G_GFX_VAL_FG")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  foregroundIdx = returnedData2

  tiraAssignId colorVarIdx, TIRA_ARG_SYMBOL, foregroundIdx

  strDataIdx = tiraGetStringDataId&(textVarType, textVarVal)
  strLenIdx = tiraGetStringLenId&(textVarType, textVarVal)

  ff = resolveSymbol("RT_DRAW_TEXT_ABSOLUTE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  drawTextFuncIdx = returnedData2

  tiraCallId5 drawTextFuncIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, xVarType, xVarVal, yVarType, yVarVal, TIRA_ARG_SYMBOL, colorVarIdx
  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PRINTSTRING = 1

END FUNCTION ' parse_PRINTSTRING

''''''''''''''''''''''''
FUNCTION parse_PUT_File (startIdx, endIdx)

  ' Writes binary data from a variable into an open file

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM targetStart AS LONG
  DIM closeParen AS LONG
  DIM tokIdx AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM numParsedIndices AS LONG

  DIM hasArrayIndices AS LONG
  DIM hasPosition AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM positionType AS LONG
  DIM positionVal AS _INTEGER64
  DIM handlesArrayIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipFileIOLblIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM fileModeIdx AS LONG
  DIM recordLenIdx AS LONG
  DIM fileModeOkLblIdx AS LONG
  DIM ptrIdx AS LONG
  DIM dataSizeIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataPtrIdx AS LONG
  DIM writeBufferIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM bufferReadyLblIdx AS LONG
  DIM directWriteLblIdx AS LONG
  DIM writeDoneLblIdx AS LONG
  DIM writeCountIdx AS LONG
  DIM writeHandleIdx AS LONG
  DIM pendingReadyLblIdx AS LONG
  DIM sameHandleLblIdx AS LONG
  DIM combinedSizeIdx AS LONG
  DIM bufferDestIdx AS LONG
  DIM copyManyLblIdx AS LONG
  DIM copyDoneLblIdx AS LONG
  DIM byteValIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG

  tokIdx = startIdx + 1
  IF lineTokens$(tokIdx) = "#" THEN
    tokIdx = tokIdx + 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "PUT MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    targetStart = comma1 + 1
  ELSE
    targetStart = comma2 + 1
  END IF

  IF targetStart > endIdx THEN
    throwCompilerError "PUT MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(targetStart)
  vName$ = UCASE$(vTok$)
  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ff = tiraParseExpressionIntId(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  hasPosition = 0

  IF comma2 > 0 THEN
    IF comma2 > comma1 + 1 THEN
      ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, ALIM, "FILE POSITION MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      positionType = tiraParsedArgType
      positionVal = tiraParsedArgVal
      hasPosition = 1
    END IF
  END IF

  numParsedIndices = 0
  hasArrayIndices = 0

  IF targetStart < endIdx THEN
    IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
      hasArrayIndices = 1
      ff = tiraParseArrayId(targetStart + 1, endIdx, ALIM)
      IF ff = 0 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasArrayIndices = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasArrayIndices = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  handlesArrayIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  skipFileIOLblIdx = tiraLabelCreateNewId&("SKIP_FILE_IO")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipFileIOLblIdx

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES

  fileModeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId fileModeIdx, TIRA_ARG_SYMBOL, stateSlotIdx

  recordLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId recordLenIdx, TIRA_ARG_SYMBOL, stateSlotIdx, FS_STATE_RECORD_LENGTH_OFFSET

  fileModeOkLblIdx = tiraLabelCreateNewId&("PUT_FILE_MODE_OK")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_BINARY, fileModeOkLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_RANDOM, fileModeOkLblIdx
  tiraFatalErrorId "BAD FILE MODE"
  tiraLabelId fileModeOkLblIdx

  ptrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
  IF ptrIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  dt = symbols(vIdx).DataType
  elemSize = retElementByteSize(vIdx)
  fixedLen = retFixedStringLength(vIdx)

  dataSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF dt = TYPE_STRING AND fixedLen = 0 THEN
    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    IF symbols(vIdx).IsArray > 0 THEN
      tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
    ELSE
      tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
    END IF

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)
    tiraAssignId dataSizeIdx, TIRA_ARG_SYMBOL, strLenIdx
    strDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, strDataPtrIdx

    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

  ELSE
    IF dt = TYPE_STRING AND fixedLen > 0 THEN
      tiraAssignId dataSizeIdx, TIRA_ARG_LITERAL, fixedLen

      IF symbols(vIdx).IsArray > 0 THEN
        tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, ptrIdx
      ELSE
        descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx

        strDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
        tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, strDataPtrIdx
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
      END IF
    ELSE
      tiraAssignId dataSizeIdx, TIRA_ARG_LITERAL, elemSize
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 0, skipFileIOLblIdx
    END IF
  END IF

  IF hasPosition = 1 THEN
    tiraFlushFileWriteBufferId
    tiraSeekFilePositionId TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_SYMBOL, recordLenIdx, positionType, positionVal
    IF compileError = 1 THEN EXIT FUNCTION
  END IF

  ff = resolveSymbol("!G_FLS_PTR_WRITE_BUFFER")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  writeBufferIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  processHeapIdx = returnedData2

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  heapAllocIdx = returnedData2

  ff = resolveSymbol("!G_FLS_IDX_WRITE_COUNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  writeCountIdx = returnedData2

  ff = resolveSymbol("!G_FLS_PTR_WRITE_HANDLE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  writeHandleIdx = returnedData2

  bufferReadyLblIdx = tiraLabelCreateNewId&("FILE_WRITE_BUFFER_READY")

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_LITERAL, 0, bufferReadyLblIdx

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, 65536
  tiraGetRetId writeBufferIdx

  tiraLabelId bufferReadyLblIdx

  directWriteLblIdx = tiraLabelCreateNewId&("FILE_WRITE_DIRECT")
  writeDoneLblIdx = tiraLabelCreateNewId&("FILE_WRITE_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_LITERAL, 0, directWriteLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 65536, directWriteLblIdx

  pendingReadyLblIdx = tiraLabelCreateNewId&("FILE_WRITE_PENDING_READY")
  sameHandleLblIdx = tiraLabelCreateNewId&("FILE_WRITE_SAME_HANDLE")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_LITERAL, 0, pendingReadyLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx, sameHandleLblIdx

  tiraFlushFileWriteBufferId
  tiraJmpId pendingReadyLblIdx

  tiraLabelId sameHandleLblIdx

  combinedSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, combinedSizeIdx, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_SYMBOL, dataSizeIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, combinedSizeIdx, TIRA_ARG_LITERAL, 65536, pendingReadyLblIdx

  tiraFlushFileWriteBufferId

  tiraLabelId pendingReadyLblIdx

  bufferDestIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId bufferDestIdx, TIRA_ARG_SYMBOL, writeBufferIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufferDestIdx, TIRA_ARG_SYMBOL, bufferDestIdx, TIRA_ARG_SYMBOL, writeCountIdx

  copyManyLblIdx = tiraLabelCreateNewId&("FILE_WRITE_COPY_MANY")
  copyDoneLblIdx = tiraLabelCreateNewId&("FILE_WRITE_COPY_DONE")

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_LITERAL, 1, copyManyLblIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, bufferDestIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId copyDoneLblIdx

  tiraLabelId copyManyLblIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, bufferDestIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataSizeIdx

  tiraLabelId copyDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_SYMBOL, dataSizeIdx
  tiraAssignId writeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx

  tiraJmpId writeDoneLblIdx

  tiraLabelId directWriteLblIdx

  tiraFlushFileWriteBufferId

  numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
  numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

  ff = resolveSymbol("IAT_WRITEFILE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  writeFileIdx = returnedData2

  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataSizeIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId writeDoneLblIdx
  tiraLabelId skipFileIOLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PUT_File = 1

END FUNCTION ' parse_PUT_File

''''''''''''''''''''''''
FUNCTION parse_PUTIMAGE (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasCoords AS LONG
  DIM isStep1 AS LONG
  DIM isStep2 AS LONG
  DIM dashIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM cComma AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM commaSrcDest AS LONG
  DIM srcStart AS LONG
  DIM srcEnd AS LONG
  DIM destStart AS LONG
  DIM destEnd AS LONG
  DIM cComma2 AS LONG

  DIM x1VarType AS LONG
  DIM x1VarVal AS _INTEGER64
  DIM y1VarType AS LONG
  DIM y1VarVal AS _INTEGER64
  DIM x2VarType AS LONG
  DIM x2VarVal AS _INTEGER64
  DIM y2VarType AS LONG
  DIM y2VarVal AS _INTEGER64
  DIM srcVarType AS LONG
  DIM srcVarVal AS _INTEGER64
  DIM destVarType AS LONG
  DIM destVarVal AS _INTEGER64

  DIM x2VarIdx AS LONG
  DIM y2VarIdx AS LONG
  DIM srcVarIdx AS LONG
  DIM destVarIdx AS LONG
  DIM newX1Idx AS LONG
  DIM newY1Idx AS LONG
  DIM newX2Idx AS LONG
  DIM newY2Idx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM srcPageIdx AS LONG
  DIM destPageIdx AS LONG
  DIM putImageFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PUTIMAGE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  hasCoords = 0
  isStep1 = 0
  isStep2 = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP OR lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasCoords = 1
    END IF
  END IF

  tira_Start

  IF hasCoords = 1 THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      isStep1 = 1
      tokIdx = tokIdx + 1
    END IF

    IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
      throwCompilerErrorAndCancelTira "EXPECTED ( AFTER _PUTIMAGE", ASIS, 0
      EXIT FUNCTION
    END IF

    dashIdx = 0
    ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
    IF ff = 1 THEN dashIdx = returnedData2

    IF dashIdx > 0 THEN
      cComma = retCoordinateBoundaries(tokIdx, dashIdx - 1)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      ff = tiraParseExpressionIntId(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      x1VarType = tiraParsedArgType
      x1VarVal = tiraParsedArgVal

      ff = tiraParseExpressionIntId(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      y1VarType = tiraParsedArgType
      y1VarVal = tiraParsedArgVal

      tokIdx = dashIdx + 1
      IF tokIdx <= endIdx THEN
        IF lineTokenVals(tokIdx) = TOK_STEP THEN
          isStep2 = 1
          tokIdx = tokIdx + 1
        END IF
      END IF

      IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
        throwCompilerErrorAndCancelTira "EXPECTED ( AFTER -", ASIS, 0
        EXIT FUNCTION
      END IF

      commaSrcDest = findComma(tokIdx, endIdx)
      cEnd2 = endIdx
      IF commaSrcDest > 0 THEN cEnd2 = commaSrcDest - 1

      cComma2 = retCoordinateBoundaries(tokIdx, cEnd2)
      IF cComma2 = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X2, Y2", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart2 = returnedData2
      cEnd2 = returnedData3

      ff = tiraParseExpressionIntId(cStart2, cComma2 - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      x2VarType = tiraParsedArgType
      x2VarVal = tiraParsedArgVal

      ff = tiraParseExpressionIntId(cComma2 + 1, cEnd2, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      y2VarType = tiraParsedArgType
      y2VarVal = tiraParsedArgVal

      tokIdx = cEnd2 + 2
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    ELSE
      ff = findMatchingParen(tokIdx, endIdx)
      IF ff = 0 THEN
        throwCompilerErrorAndCancelTira "MALFORMED COORDINATES IN _PUTIMAGE", ASIS, 0
        EXIT FUNCTION
      END IF
      closeParenIdx = returnedData2

      cComma = retCoordinateBoundaries(tokIdx, closeParenIdx)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      ff = tiraParseExpressionIntId(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      x1VarType = tiraParsedArgType
      x1VarVal = tiraParsedArgVal

      ff = tiraParseExpressionIntId(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      y1VarType = tiraParsedArgType
      y1VarVal = tiraParsedArgVal

      x2VarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, x2VarIdx, x1VarType, x1VarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, x2VarIdx, TIRA_ARG_SYMBOL, x2VarIdx, TIRA_ARG_LITERAL, 1
      x2VarType = TIRA_ARG_SYMBOL
      x2VarVal = x2VarIdx

      y2VarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, y2VarIdx, y1VarType, y1VarVal, TIRA_ARG_LITERAL, gfxConfig.SizeY
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, y2VarIdx, TIRA_ARG_SYMBOL, y2VarIdx, TIRA_ARG_LITERAL, 1
      y2VarType = TIRA_ARG_SYMBOL
      y2VarVal = y2VarIdx

      tokIdx = closeParenIdx + 1
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    END IF

    IF isStep1 = 1 THEN
      ff = resolveSymbol("!G_GFX_VAL_CUR_X")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      currentXIdx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      currentYIdx = returnedData2

      newX1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX1Idx, TIRA_ARG_SYMBOL, currentXIdx, x1VarType, x1VarVal
      x1VarType = TIRA_ARG_SYMBOL
      x1VarVal = newX1Idx

      newY1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY1Idx, TIRA_ARG_SYMBOL, currentYIdx, y1VarType, y1VarVal
      y1VarType = TIRA_ARG_SYMBOL
      y1VarVal = newY1Idx
    END IF

    IF isStep2 = 1 THEN
      newX2Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX2Idx, x1VarType, x1VarVal, x2VarType, x2VarVal
      x2VarType = TIRA_ARG_SYMBOL
      x2VarVal = newX2Idx

      newY2Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY2Idx, y1VarType, y1VarVal, y2VarType, y2VarVal
      y2VarType = TIRA_ARG_SYMBOL
      y2VarVal = newY2Idx
    END IF
  ELSE
    newX1Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId newX1Idx, TIRA_ARG_LITERAL, 0
    x1VarType = TIRA_ARG_SYMBOL
    x1VarVal = newX1Idx

    newY1Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId newY1Idx, TIRA_ARG_LITERAL, 0
    y1VarType = TIRA_ARG_SYMBOL
    y1VarVal = newY1Idx

    x2VarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, x2VarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, TIRA_ARG_LITERAL, 1
    x2VarType = TIRA_ARG_SYMBOL
    x2VarVal = x2VarIdx

    y2VarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, y2VarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, TIRA_ARG_LITERAL, 1
    y2VarType = TIRA_ARG_SYMBOL
    y2VarVal = y2VarIdx
  END IF

  commaSrcDest = findComma(tokIdx, endIdx)
  IF commaSrcDest > 0 THEN
    srcStart = tokIdx
    srcEnd = commaSrcDest - 1
    destStart = commaSrcDest + 1
    destEnd = endIdx
  ELSE
    srcStart = tokIdx
    srcEnd = endIdx
    destStart = 0
    destEnd = 0
  END IF

  IF srcStart > 0 AND srcStart <= srcEnd THEN
    ff = tiraParseExpressionIntId(srcStart, srcEnd, ALIM, "SOURCE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcVarType = tiraParsedArgType
    srcVarVal = tiraParsedArgVal
  ELSE
    srcVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcPageIdx = returnedData2

    tiraAssignId srcVarIdx, TIRA_ARG_SYMBOL, srcPageIdx
    srcVarType = TIRA_ARG_SYMBOL
    srcVarVal = srcVarIdx
  END IF

  IF destStart > 0 AND destStart <= destEnd THEN
    ff = tiraParseExpressionIntId(destStart, destEnd, ALIM, "DEST MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destVarType = tiraParsedArgType
    destVarVal = tiraParsedArgVal
  ELSE
    destVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPageIdx = returnedData2

    tiraAssignId destVarIdx, TIRA_ARG_SYMBOL, destPageIdx
    destVarType = TIRA_ARG_SYMBOL
    destVarVal = destVarIdx
  END IF

  ff = resolveSymbol("RT_PUTIMAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  putImageFuncIdx = returnedData2

  tiraCallId6 putImageFuncIdx, x1VarType, x1VarVal, y1VarType, y1VarVal, x2VarType, x2VarVal, y2VarType, y2VarVal, srcVarType, srcVarVal, destVarType, destVarVal

  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PUTIMAGE = 1

END FUNCTION ' parse_PUTIMAGE

''''''''''''''''''''''''
FUNCTION parse_RANDOMIZE (startIdx)

  DIM endIdx AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED NUMERIC ARGUMENT AFTER RANDOMIZE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "RANDOMIZE REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  argType = tiraParsedArgType
  argVal = tiraParsedArgVal

  ff = resolveSymbol("IAT_SRAND")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, argType, argVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_RANDOMIZE = 1

END FUNCTION ' parse_RANDOMIZE

''''''''''''''''''''''''
FUNCTION parse_READ (startIdx)

  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM commaIdx AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM hasIndex AS LONG
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM fieldName$
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM ptrIdx AS LONG
  DIM targetType AS LONG
  DIM isStrVar AS LONG
  DIM endIdx AS LONG
  DIM numParsedIndices AS LONG
  DIM currUdtIndex AS LONG
  DIM tempFieldSize AS LONG
  DIM tempIsDynamicString AS LONG
  DIM isFixedStr AS LONG
  DIM fixedLen AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM readFuncIdx AS LONG
  DIM tempDescIdx AS LONG
  DIM emptyDescIdx AS LONG
  DIM rhsDataPtrIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM padLenIdx AS LONG
  DIM skipPadLblIdx AS LONG
  DIM padAddrIdx AS LONG
  DIM strAssignFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "READ MISSING VARIABLES", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("RT_READ")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  readFuncIdx = returnedData2

  itemStart = startIdx + 1
  DO WHILE itemStart <= endIdx
    itemEnd = endIdx
    commaIdx = findComma(itemStart, endIdx)
    IF commaIdx > 0 THEN itemEnd = commaIdx - 1

    tokIdx = itemStart
    vTok$ = lineTokens$(tokIdx)
    vName$ = UCASE$(vTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    targetType = symbols(vIdx).DataType

    tokIdx = tokIdx + 1

    hasIndex = 0
    numParsedIndices = 0

    IF tokIdx <= itemEnd THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        ff = tiraParseArrayId(tokIdx, itemEnd, 0)
        IF ff = 0 AND compileError = 1 THEN EXIT FUNCTION
        closeParen = returnedData2
        numParsedIndices = returnedData3
        tokIdx = closeParen + 1
      END IF
    END IF

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF

    hasField = 0
    udtOffset = 0
    currUdtIndex = symbols(vIdx).UDTIndex
    tempFieldSize = 0
    tempIsDynamicString = 0

    DO WHILE tokIdx <= itemEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        tokIdx = tokIdx + 1
        fieldName$ = UCASE$(lineTokens$(tokIdx))
        tokIdx = tokIdx + 1

        IF targetType <> TYPE_UDT THEN
          throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF

        fieldFound = 0

        IF findUdtFieldIndex(currUdtIndex, fieldName$) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
          targetType = udtFields(currUdtIndex, iField).DataType
          tempFieldSize = udtFields(currUdtIndex, iField).Size
          tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
          currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ptrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
    IF ptrIdx = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    isStrVar = 0
    IF targetType = TYPE_STRING THEN isStrVar = 1

    isFixedStr = 0
    fixedLen = 0

    IF isStrVar = 1 THEN
      IF hasField = 1 THEN
        IF tempIsDynamicString = 0 THEN
          isFixedStr = 1
          fixedLen = tempFieldSize
        END IF
      ELSE
        fixedLen = retFixedStringLength(vIdx)
        IF fixedLen > 0 THEN
          isFixedStr = 1
        END IF
      END IF
    END IF

    IF isFixedStr = 1 THEN
      ' Read safely into a temporary dynamic string to respect raw character constraints
      tempDescIdx = tiraResolveHoistVarId&("RDTMP", "_DSC")
      IF tempDescIdx = 0 THEN EXIT FUNCTION

      ff = resolveSymbol("!G_SYS_DSC_EMPTY")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      emptyDescIdx = returnedData2

      tiraAssignId tempDescIdx, TIRA_ARG_SYMBOL, emptyDescIdx

      tiraCallId3 readFuncIdx, TIRA_ARG_SYMBOL, tempDescIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, TYPE_STRING

      ' Copy raw characters seamlessly into the fixed data buffer without memory corruption
      rhsDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, tempDescIdx)
      rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, tempDescIdx)

      minLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
      tiraClampId minLenIdx, TA_EMPTY, 0, TIRA_ARG_LITERAL, fixedLen

      tiraMemcpyId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, rhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx

      padLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_SYMBOL, minLenIdx
      skipPadLblIdx = tiraLabelCreateNewId&("SKIP_PAD")
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, 0, skipPadLblIdx

      padAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, minLenIdx
      tiraMemSetId TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, padLenIdx
      tiraLabelId skipPadLblIdx

      ' Garbage collect the temporary dynamic string
      ff = resolveSymbol("RT_STR_ASSIGN")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      strAssignFuncIdx = returnedData2

      tiraCallId2 strAssignFuncIdx, TIRA_ARG_SYMBOL, tempDescIdx, TIRA_ARG_SYMBOL, emptyDescIdx
    ELSE
      tiraCallId3 readFuncIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, isStrVar, TIRA_ARG_LITERAL, targetType
    END IF

    itemStart = itemEnd + 2
  LOOP

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_READ = 1

END FUNCTION ' parse_READ

''''''''''''''''''''''''
FUNCTION parse_RED32$ (startIdx, endIdx, allowImplicit)

  ' Extracts the red channel component from a 32-bit color value

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM shiftVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RED32", 3) = 0 THEN
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "_RED32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RED32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  shiftVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, shiftVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftVarIdx, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RED32$ = scratchName$

END FUNCTION ' parse_RED32$

''''''''''''''''''''''''
FUNCTION parse_RESTORE (startIdx)

  ' Resets the internal data pointer to the beginning of a specific DATA label

  DIM endIdx AS LONG
  DIM dataIndexIdx AS LONG
  DIM vIdx AS LONG
  DIM idxVal AS _INTEGER64

  endIdx = lineTokenCount - 1

  tira_Start

  ff = resolveSymbol("!G_SYS_VAL_DATAINDEX")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  dataIndexIdx = returnedData2

  IF endIdx < startIdx + 1 THEN
    tiraAssignId dataIndexIdx, TIRA_ARG_LITERAL, 0
  ELSE
    lblTok$ = lineTokens$(startIdx + 1)
    lblName$ = "%" + UCASE$(lblTok$)
    expectedSymType = TYPE_LABEL
    ff = resolveSymbol(lblName$)
    IF ff = 1 THEN
      vIdx = returnedData2
      idxVal = symbols(vIdx).DataIndex
      tiraAssignId dataIndexIdx, TIRA_ARG_LITERAL, idxVal
    ELSE
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_RESTORE = 1

END FUNCTION ' parse_RESTORE

''''''''''''''''''''''''
FUNCTION parse_RETURN (startIdx)

  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM endIdx AS LONG
  DIM argVarType AS LONG
  DIM argVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG
  DIM endRoutineIdx AS LONG
  DIM tgtPtrIdx AS LONG
  DIM retAddrIdx AS LONG
  DIM baseAddrIdx AS LONG
  DIM gosubIdx AS LONG
  DIM gosubArrayIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx >= startIdx + 1 THEN
    IF insideSub = 0 THEN
      throwCompilerErrorAndCancelTira "RETURN OUTSIDE SUB OR FUNCTION", ASIS, 0
      EXIT FUNCTION
    END IF

    IF insideSub <> 2 THEN
      throwCompilerErrorAndCancelTira "SUB CANNOT RETURN A VALUE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    argVarType = tiraParsedArgType
    argVarVal = tiraParsedArgVal

    ff = resolveSymbol(currentSubName$)
    IF ff = 1 THEN
      vIdx = returnedData2
      targetType = returnedData3

      IF targetType = TYPE_STRING THEN
        IF exprIs.DataType <> TYPE_STRING THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        ff = resolveSymbol("RT_STR_ASSIGN")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        callFuncIdx = returnedData2

        tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, vIdx, argVarType, argVarVal
      ELSE
        IF exprIs.DataType = TYPE_STRING THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        tiraAssignId vIdx, argVarType, argVarVal
      END IF
    END IF

    tiraScheduleHeapResetId

    ff = resolveSymbol("@END_ROUTINE_" + currentSubName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endRoutineIdx = returnedData2
    tiraJmpId endRoutineIdx

  ELSE
    ' GOSUB Return (no arguments)
    tgtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    retAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    ff = resolveSymbol("!G_SYS_IDX_GOSUB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gosubIdx = returnedData2

    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("!G_SYS_ARR_GOSUB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gosubArrayIdx = returnedData2

    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, gosubArrayIdx
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, tgtPtrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_LITERAL, 8
    tiraReadMemId retAddrIdx, TIRA_ARG_SYMBOL, tgtPtrIdx
    tiraScheduleHeapResetId
    tiraJmpDynId TIRA_ARG_SYMBOL, retAddrIdx
  END IF

  tira_EndAndProcess

  parse_RETURN = 1

END FUNCTION ' parse_RETURN

''''''''''''''''''''''''
FUNCTION parse_RGB$ (startIdx, endIdx, allowImplicit)

  ' Returns the closest hardware palette index for a specified red, green, and blue mixture

  DIM argRType AS LONG
  DIM argRVal AS _INTEGER64
  DIM argGType AS LONG
  DIM argGVal AS _INTEGER64
  DIM argBType AS LONG
  DIM argBVal AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM maskRIdx AS LONG
  DIM maskGIdx AS LONG
  DIM maskBIdx AS LONG
  DIM paletteIndexIdx AS LONG
  DIM bestIndexIdx AS LONG
  DIM minDistIdx AS LONG
  DIM paletteSymbolIdx AS LONG
  DIM palDescPtrIdx AS LONG
  DIM palDataAddrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM palBIdx AS LONG
  DIM palGAddrIdx AS LONG
  DIM palGIdx AS LONG
  DIM palRAddrIdx AS LONG
  DIM palRIdx AS LONG
  DIM diffRIdx AS LONG
  DIM diffGIdx AS LONG
  DIM diffBIdx AS LONG
  DIM sqRIdx AS LONG
  DIM sqGIdx AS LONG
  DIM sqBIdx AS LONG
  DIM distIdx AS LONG
  DIM skipUpdateIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB", 7) = 0 THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "_RGB RED ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argRType = tiraParsedArgType
  argRVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, allowImplicit, "_RGB GREEN ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argGType = tiraParsedArgType
  argGVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma2 + 1, endIdx - 1, allowImplicit, "_RGB BLUE ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argBType = tiraParsedArgType
  argBVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RGB", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Force incoming values to 0-255 limits cleanly before calculation
  maskRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskRIdx, argRType, argRVal, TIRA_ARG_LITERAL, 255

  maskGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskGIdx, argGType, argGVal, TIRA_ARG_LITERAL, 255

  maskBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskBIdx, argBType, argBVal, TIRA_ARG_LITERAL, 255

  paletteIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId paletteIndexIdx, TIRA_ARG_LITERAL, 0

  bestIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId bestIndexIdx, TIRA_ARG_LITERAL, 0

  minDistIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId minDistIdx, TIRA_ARG_LITERAL, 9999999

  ' Read directly from the internal compiler global palette block memory
  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  paletteSymbolIdx = returnedData2

  palDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId palDescPtrIdx, TIRA_ARG_SYMBOL, paletteSymbolIdx

  palDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId palDataAddrIdx, TIRA_ARG_SYMBOL, palDescPtrIdx

  loopTopIdx = tiraLabelCreateNewId&("RGB_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("RGB_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 255, loopDoneIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 4

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  palBIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palBIdx, TIRA_ARG_SYMBOL, targetAddrIdx

  palGAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, palGAddrIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 1
  palGIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palGIdx, TIRA_ARG_SYMBOL, palGAddrIdx

  palRAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, palRAddrIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 2
  palRIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palRIdx, TIRA_ARG_SYMBOL, palRAddrIdx

  ' Calculate the numerical difference between the target pixel and the current index pixel
  diffRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffRIdx, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_SYMBOL, palRIdx

  diffGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffGIdx, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_SYMBOL, palGIdx

  diffBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffBIdx, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_SYMBOL, palBIdx

  ' Square the differences internally to isolate purely positive vector distances
  sqRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqRIdx, TIRA_ARG_SYMBOL, diffRIdx, TIRA_ARG_SYMBOL, diffRIdx

  sqGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqGIdx, TIRA_ARG_SYMBOL, diffGIdx, TIRA_ARG_SYMBOL, diffGIdx

  sqBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqBIdx, TIRA_ARG_SYMBOL, diffBIdx, TIRA_ARG_SYMBOL, diffBIdx

  distIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, sqRIdx, TIRA_ARG_SYMBOL, sqGIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, sqBIdx

  ' Skip overriding the best match if this index is farther away than our currently held match
  skipUpdateIdx = tiraLabelCreateNewId&("RGB_SKIP_UPD")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, minDistIdx, skipUpdateIdx
  tiraAssignId minDistIdx, TIRA_ARG_SYMBOL, distIdx
  tiraAssignId bestIndexIdx, TIRA_ARG_SYMBOL, paletteIndexIdx

  ' Speed optimization: If exact perfect distance hit 0 is reached, terminate scan early
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx
  tiraLabelId skipUpdateIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, bestIndexIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB$ = scratchName$

END FUNCTION ' parse_RGB$

''''''''''''''''''''''''
FUNCTION parse_RGB32$ (startIdx, endIdx, allowImplicit)

  DIM argRType AS LONG
  DIM argRVal AS _INTEGER64
  DIM argGType AS LONG
  DIM argGVal AS _INTEGER64
  DIM argBType AS LONG
  DIM argBVal AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM maskRIdx AS LONG
  DIM maskGIdx AS LONG
  DIM maskBIdx AS LONG
  DIM clampRMinDoneIdx AS LONG
  DIM clampRDoneIdx AS LONG
  DIM clampGMinDoneIdx AS LONG
  DIM clampGDoneIdx AS LONG
  DIM clampBMinDoneIdx AS LONG
  DIM clampBDoneIdx AS LONG
  DIM shiftGIdx AS LONG
  DIM shiftRIdx AS LONG
  DIM alphaValIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB32", 7) = 0 THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "_RGB32 RED ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argRType = tiraParsedArgType
  argRVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, allowImplicit, "_RGB32 GREEN ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argGType = tiraParsedArgType
  argGVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma2 + 1, endIdx - 1, allowImplicit, "_RGB32 BLUE ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argBType = tiraParsedArgType
  argBVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RGB32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  clampRMinDoneIdx = tiraLabelCreateNewId&("RGB32_R_MIN_DONE")
  clampRDoneIdx = tiraLabelCreateNewId&("RGB32_R_DONE")
  clampGMinDoneIdx = tiraLabelCreateNewId&("RGB32_G_MIN_DONE")
  clampGDoneIdx = tiraLabelCreateNewId&("RGB32_G_DONE")
  clampBMinDoneIdx = tiraLabelCreateNewId&("RGB32_B_MIN_DONE")
  clampBDoneIdx = tiraLabelCreateNewId&("RGB32_B_DONE")

  maskRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskRIdx, argRType, argRVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 0, clampRMinDoneIdx
  tiraAssignId maskRIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampRMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 255, clampRDoneIdx
  tiraAssignId maskRIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampRDoneIdx

  maskGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskGIdx, argGType, argGVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 0, clampGMinDoneIdx
  tiraAssignId maskGIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampGMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 255, clampGDoneIdx
  tiraAssignId maskGIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampGDoneIdx

  maskBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskBIdx, argBType, argBVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_LITERAL, 0, clampBMinDoneIdx
  tiraAssignId maskBIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampBMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_LITERAL, 255, clampBDoneIdx
  tiraAssignId maskBIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampBDoneIdx

  shiftGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, shiftGIdx, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 8

  shiftRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, shiftRIdx, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 16

  ' Default the missing alpha value safely to &HFF000000 (-16777216)
  alphaValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId alphaValIdx, TIRA_ARG_LITERAL, -16777216

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_SYMBOL, shiftGIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftRIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, alphaValIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB32$ = scratchName$

END FUNCTION ' parse_RGB32$

''''''''''''''''''''''''
FUNCTION parse_RIGHT$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM safeLenIdx AS LONG
  DIM srcOffsetIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM comma1 AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "RIGHT$", 5) = 0 THEN
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "RIGHT$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "RIGHT$ ARG 1 MUST BE STRING", ASIS, 0
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "RIGHT$ ARG 2 MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF
  arg2Type = tiraParsedArgType
  arg2Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RIGHT", "_DSC")
  IF scratchIdx = 0 THEN
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  safeLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId safeLenIdx, arg2Type, arg2Val
  tiraClampId safeLenIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, strLenIdx

  srcOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, srcOffsetIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, safeLenIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, srcOffsetIdx

  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, safeLenIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_RIGHT$ = scratchName$

END FUNCTION ' parse_RIGHT$

''''''''''''''''''''''''
FUNCTION parse_RND$ (startIdx, endIdx, allowImplicit)

  ' Returns a random single-precision floating point number

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM randFuncIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dblResIdx AS LONG
  DIM maxValIdx AS LONG
  DIM finalDblIdx AS LONG
  DIM singleResIdx AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("RND", "_VAL")
  IF scratchIdx = 0 THEN
    parse_RND$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)
  symbols(scratchIdx).DataType = TYPE_SINGLE

  ff = resolveSymbol("IAT_RAND")
  IF ff = 0 THEN
    tira_Cancel
    parse_RND$ = ""
    EXIT FUNCTION
  END IF
  randFuncIdx = returnedData2

  tiraCallId0 randFuncIdx

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resVarIdx

  dblResIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dblResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE

  maxValIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId maxValIdx, TIRA_ARG_LITERAL, 32767

  finalDblIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, finalDblIdx, TIRA_ARG_SYMBOL, dblResIdx, TIRA_ARG_SYMBOL, maxValIdx

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, finalDblIdx, TIRA_ARG_LITERAL, TYPE_SINGLE

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_RND$ = scratchName$

END FUNCTION ' parse_RND$

''''''''''''''''''''''''
FUNCTION parse_RTRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpaceLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "RTRIM$", 3) = 0 THEN
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "RTRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("RTRIM", "_DSC")
  IF scratchIdx = 0 THEN
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1

  loopTopIdx = tiraLabelCreateNewId&("RTRIM_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("RTRIM_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, endPtrIdx

  isSpaceLblIdx = tiraLabelCreateNewId&("RTRIM_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopDoneIdx
  tiraLabelId isSpaceLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_RTRIM$ = scratchName$

END FUNCTION ' parse_RTRIM$

''''''''''''''''''''''''
FUNCTION parse_SCREENEXISTS$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM windowReadyIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SCREENEXISTS", ASIS, 0
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("SCREX", "_VAL")
  IF scratchIdx = 0 THEN
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ' Evaluates the window readiness spinlock to determine if the screen exists
  ' Console windows are always considered ready
  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_WND_FLG_READY")
    IF ff = 0 THEN
      tira_Cancel
      parse_SCREENEXISTS$ = ""
      EXIT FUNCTION
    END IF
    windowReadyIdx = returnedData2

    tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, windowReadyIdx
  ELSE
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SCREENEXISTS$ = scratchName$

END FUNCTION ' parse_SCREENEXISTS$

''''''''''''''''''''''''
FUNCTION parse_SCREENICON (startIdx)

  ' Sets the window icon for the graphical display

  DIM endIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM showWindowIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_SCREENICON REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx > startIdx THEN
    throwCompilerError "_SCREENICON DOES NOT TAKE ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  windowHandleIdx = returnedData2

  ff = resolveSymbol("IAT_SHOWWINDOW")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  showWindowIdx = returnedData2

  tiraCallId2 showWindowIdx, TIRA_ARG_SYMBOL, windowHandleIdx, TIRA_ARG_LITERAL, 6

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SCREENICON = 1

END FUNCTION ' parse_SCREENICON

''''''''''''''''''''''''
FUNCTION parse_SELECT (startIdx)

  DIM endIdx AS LONG
  DIM hiddenVarIdx AS LONG
  DIM selectDataType AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "MALFORMED SELECT CASE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_CASE THEN
    throwCompilerError "EXPECTED CASE AFTER SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Generate a globally unique ID for this SELECT block
  selID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_SELECT = 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal
  selectDataType = exprIs.DataType

  IF selectDataType = TYPE_STRING THEN
    hiddenName$ = "!C_SYS_DSC_SEL_SVAR_" + _TRIM$(STR$(selID))
  ELSE
    hiddenName$ = "!C_SYS_VAL_SEL_NVAR_" + _TRIM$(STR$(selID))
  END IF

  ff = resolveSymbol(hiddenName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  hiddenVarIdx = returnedData2

  symbols(hiddenVarIdx).DataType = selectDataType

  IF currentScopeID > 0 THEN
    symbols(hiddenVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  ' Ensure string descriptors are cloned correctly using the runtime helper to prevent data loss
  IF selectDataType = TYPE_STRING THEN
    ff = resolveSymbol("RT_STR_ASSIGN")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2

    tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, hiddenVarIdx, exprVarType, exprVarVal
  ELSE
    tiraAssignId hiddenVarIdx, exprVarType, exprVarVal
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_SELECT
  ctrls(ctrlCount).SelectVarIdx = hiddenVarIdx
  ctrls(ctrlCount).Patch1 = selID ' The unique SELECT block ID
  ctrls(ctrlCount).Patch2 = 0 ' Unused in TIRA
  ctrls(ctrlCount).SelectCaseSeen = 0 ' 0 means no CASE seen yet
  ctrls(ctrlCount).SelectDataType = selectDataType

  ctrlCount = ctrlCount + 1

  parse_SELECT = 1

END FUNCTION ' parse_SELECT

''''''''''''''''''''''''
FUNCTION parse_SGN$ (startIdx, endIdx, allowImplicit)

  ' Evaluates a numeric value and returns its mathematical sign as positive, negative, or zero

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchIdx AS LONG
  DIM scratchName$
  DIM resVarIdx AS LONG
  DIM lblPosIdx AS LONG
  DIM lblEndIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "SGN", 3) = 0 THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("SGN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  lblPosIdx = tiraLabelCreateNewId&("SGN_POS")
  lblEndIdx = tiraLabelCreateNewId&("SGN_END")

  ' TC_JMP_COND seamlessly handles float/integer mixed conditions safely using UCOMI
  tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, lblEndIdx
  tiraJmpCondId JCC_JG, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, lblPosIdx

  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId lblEndIdx

  tiraLabelId lblPosIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SGN$ = scratchName$

END FUNCTION ' parse_SGN$

''''''''''''''''''''''''
FUNCTION parse_SHELL (startIdx)

  DIM endIdx AS LONG
  DIM hasHide AS LONG
  DIM hasDontWait AS LONG
  DIM cmdStart AS LONG
  DIM cmdVarType AS LONG
  DIM cmdVarVal AS _INTEGER64
  DIM strDataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM hideValIdx AS LONG
  DIM structRawPtrIdx AS LONG
  DIM startupInfoPtrIdx AS LONG
  DIM processInfoPtrIdx AS LONG
  DIM cmdAllocSizeIdx AS LONG
  DIM cmdBufferIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM createResultIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM processHandleIdx AS LONG
  DIM threadHandleIdx AS LONG
  DIM callFuncIdx AS LONG
  DIM tokVal AS LONG

  endIdx = lineTokenCount - 1
  hasHide = 0
  hasDontWait = 0
  cmdStart = startIdx + 1

  DO WHILE cmdStart <= endIdx
    tokVal = lineTokenVals(cmdStart)

    SELECT CASE tokVal

      CASE TOK_HIDE
        hasHide = 1
        cmdStart = cmdStart + 1
      CASE TOK_DONTWAIT
        hasDontWait = 1
        cmdStart = cmdStart + 1
      CASE ELSE
        EXIT DO

    END SELECT ' tokVak

  LOOP

  IF cmdStart > endIdx THEN
    throwCompilerError "EXPECTED COMMAND STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(cmdStart, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  cmdVarType = tiraParsedArgType
  cmdVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "COMMAND MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Extract raw pointer to our seamlessly null-terminated C string in memory
  strDataPtrIdx = tiraGetStringDataId&(cmdVarType, cmdVarVal)

  hideValIdx = tiraDimVarId&("T", TYPE_LONG)
  IF hasHide = 1 THEN
    tiraAssignId hideValIdx, TIRA_ARG_LITERAL, 0 ' SW_HIDE flag
  ELSE
    tiraAssignId hideValIdx, TIRA_ARG_LITERAL, 1 ' SW_SHOWNORMAL flag
  END IF

  IF hasDontWait = 1 THEN
    ' WinExec remains the asynchronous path for SHELL _DONTWAIT
    ff = resolveSymbol("IAT_WINEXEC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2
    tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, strDataPtrIdx, TIRA_ARG_SYMBOL, hideValIdx
  ELSE
    strLenIdx = tiraGetStringLenId&(cmdVarType, cmdVarVal)

    ' Reserve one aligned block for STARTUPINFOA and PROCESS_INFORMATION before the variable-length command buffer
    structRawPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 135)
    startupInfoPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_SYMBOL, structRawPtrIdx, TIRA_ARG_LITERAL, 7
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_LITERAL, -8

    processInfoPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, processInfoPtrIdx, TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_LITERAL, 104

    tiraMemSetId TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 128
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, startupInfoPtrIdx, 0, TIRA_ARG_LITERAL, 104, TIRA_ARG_LITERAL, 4 ' STARTUPINFOA.cb
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, startupInfoPtrIdx, 60, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 4 ' STARTF_USESHOWWINDOW
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, startupInfoPtrIdx, 64, TIRA_ARG_SYMBOL, hideValIdx, TIRA_ARG_LITERAL, 2 ' STARTUPINFOA.wShowWindow

    ' CreateProcessA requires a writable null-terminated command-line buffer
    cmdAllocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, cmdAllocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
    cmdBufferIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, cmdAllocSizeIdx)
    tiraMemcpyId TIRA_ARG_SYMBOL, cmdBufferIdx, TIRA_ARG_SYMBOL, strDataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

    nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, cmdBufferIdx, TIRA_ARG_SYMBOL, strLenIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("IAT_CREATEPROCESSA")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2

    tiraCallId10 callFuncIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, cmdBufferIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, startupInfoPtrIdx, TIRA_ARG_SYMBOL, processInfoPtrIdx
    createResultIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId createResultIdx

    doneLblIdx = tiraLabelCreateNewId&("SHELL_DONE")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, createResultIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

    processHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId processHandleIdx, TIRA_ARG_SYMBOL, processInfoPtrIdx

    threadHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemOffsetId threadHandleIdx, TIRA_ARG_SYMBOL, processInfoPtrIdx, 8

    ff = resolveSymbol("IAT_WAITFORSINGLEOBJECT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2
    tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, processHandleIdx, TIRA_ARG_LITERAL, -1

    ff = resolveSymbol("IAT_CLOSEHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2
    tiraCallId1 callFuncIdx, TIRA_ARG_SYMBOL, processHandleIdx
    tiraCallId1 callFuncIdx, TIRA_ARG_SYMBOL, threadHandleIdx

    tiraLabelId doneLblIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SHELL = 1

END FUNCTION ' parse_SHELL

''''''''''''''''''''''''
FUNCTION parse_SIN$ (startIdx, endIdx, allowImplicit)

  ' Calculates the mathematical sine of a given angle in radians

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg1DataType AS LONG
  DIM scratchIdx AS LONG
  DIM scratchName$
  DIM resVarIdx AS LONG
  DIM singleResIdx AS LONG
  DIM argFloatIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "SIN", 3) = 0 THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal
  arg1DataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("SIN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly override the integer prefix rule to safely route as float
  symbols(scratchIdx).DataType = TYPE_SINGLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF arg1DataType <> TYPE_DOUBLE THEN
    argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraAssignId argFloatIdx, arg1Type, arg1Val
    arg1Type = TIRA_ARG_SYMBOL
    arg1Val = argFloatIdx
  END IF

  ff = resolveSymbol("IAT_SIN")
  IF ff = 0 THEN
    tira_Cancel
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_SIN$ = scratchName$

END FUNCTION ' parse_SIN$

''''''''''''''''''''''''
FUNCTION parse_SOURCE (startIdx)

  DIM endIdx AS LONG
  DIM pageVarType AS LONG
  DIM pageVarVal AS _INTEGER64
  DIM lblSrc0Idx AS LONG
  DIM lblSrc1Idx AS LONG
  DIM lblSrc2Idx AS LONG
  DIM lblSrc3Idx AS LONG
  DIM lblSrcEndIdx AS LONG
  DIM srcFrameIdx AS LONG
  DIM srcBufferIdx AS LONG
  DIM srcCountIdx AS LONG
  DIM srcPageIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM countBackIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM countPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM countPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM countPage3Idx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_SOURCE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED PAGE NUMBER AFTER _SOURCE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  pageVarType = tiraParsedArgType
  pageVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcCountIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  frameBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  framePage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bufferPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  countPage3Idx = returnedData2

  lblSrc0Idx = tiraLabelCreateNewId&("SRC_0")
  lblSrc1Idx = tiraLabelCreateNewId&("SRC_1")
  lblSrc2Idx = tiraLabelCreateNewId&("SRC_2")
  lblSrc3Idx = tiraLabelCreateNewId&("SRC_3")
  lblSrcEndIdx = tiraLabelCreateNewId&("SRC_END")

  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 0, lblSrc0Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 1, lblSrc1Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 2, lblSrc2Idx
  tiraJmpCondId JCC_JE, pageVarType, pageVarVal, TIRA_ARG_LITERAL, 3, lblSrc3Idx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc0Idx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, countBackIdx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc1Idx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, countPage1Idx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc2Idx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, countPage2Idx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc3Idx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, countPage3Idx

  tiraLabelId lblSrcEndIdx
  tiraAssignId srcPageIdx, pageVarType, pageVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SOURCE = 1

END FUNCTION ' parse_SOURCE

''''''''''''''''''''''''
FUNCTION parse_SOURCE_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM sourcePageIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SOURCE", ASIS, 0
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("SOURCE", "_VAL")
  IF scratchIdx = 0 THEN
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_LONG

  ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF
  sourcePageIdx = returnedData2

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, sourcePageIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SOURCE_FUNC$ = scratchName$

END FUNCTION ' parse_SOURCE_FUNC$

''''''''''''''''''''''''
FUNCTION parse_SPACE$ (startIdx, endIdx, allowImplicit)

  ' Generates a string consisting of a specific number of blank space characters

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM skipLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM jmpDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "SPACE$", 3) = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF

  ' Sovereign command opens its own compilation block
  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "SPACE$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("SPACE", "_DSC")
  IF scratchIdx = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  skipLenIdx = tiraLabelCreateNewId&("SPACE_SKIP")

  tiraJmpCondId JCC_JLE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, skipLenIdx

  dataPtrIdx = tiraAllocTempMemId&(arg1Type, arg1Val)
  IF compileError = 1 THEN
    tira_Cancel
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF

  ' Memset with 32 (space character)
  tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 32, arg1Type, arg1Val

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0

  jmpDoneIdx = tiraLabelCreateNewId&("SPACE_DONE")
  tiraJmpId jmpDoneIdx

  tiraLabelId skipLenIdx
  ' Safely construct an empty descriptor entirely within the Temp Heap paradigm
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraLabelId jmpDoneIdx

  ' Close the block (NO HEAP RESET, so the string survives for the parent!)
  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_SPACE$ = scratchName$

END FUNCTION ' parse_SPACE$

''''''''''''''''''''''''
FUNCTION parse_STRINGFUNC$ (startIdx, endIdx, allowImplicit)

  DIM comma1 AS LONG
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM isStringChar AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM lblEmptyIdx AS LONG
  DIM lblNotEmptyIdx AS LONG
  DIM lblValidCountIdx AS LONG
  DIM lblDoAllocIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM tmpByteIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "STRING$", 5) = 0 THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "STRING$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "STRING$ ARG 1 MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  expectedSymType = TYPE_ANY
  ff = tiraParseExpressionId(comma1 + 1, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF
  arg2Type = tiraParsedArgType
  arg2Val = tiraParsedArgVal

  isStringChar = 0
  IF exprIs.DataType = TYPE_STRING THEN isStringChar = 1

  scratchIdx = tiraResolveHoistVarId&("STRF", "_DSC")
  IF scratchIdx = 0 THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  lblValidCountIdx = tiraLabelCreateNewId&("STRF_VCNT")
  tiraJmpCondId JCC_JGE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, lblValidCountIdx

  tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$"

  tiraLabelId lblValidCountIdx

  charByteIdx = tiraDimVarId&("T", TYPE_LONG)

  IF isStringChar = 1 THEN
    strLenIdx = tiraGetStringLenId&(arg2Type, arg2Val)

    lblEmptyIdx = tiraLabelCreateNewId&("STRF_MT")
    lblNotEmptyIdx = tiraLabelCreateNewId&("STRF_NMT")

    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx

    strDataIdx = tiraGetStringDataId&(arg2Type, arg2Val)
    tmpByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId tmpByteIdx, TIRA_ARG_SYMBOL, strDataIdx
    tiraAssignId charByteIdx, TIRA_ARG_SYMBOL, tmpByteIdx
    tiraJmpId lblNotEmptyIdx

    tiraLabelId lblEmptyIdx
    tiraFatalErrorId "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$"

    tiraLabelId lblNotEmptyIdx
  ELSE
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, charByteIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, 255
  END IF

  lblDoAllocIdx = tiraLabelCreateNewId&("STRF_ALLOC")
  lblDoneIdx = tiraLabelCreateNewId&("STRF_DONE")

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraJmpCondId JCC_JG, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, lblDoAllocIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraJmpId lblDoneIdx

  tiraLabelId lblDoAllocIdx
  dataPtrIdx = tiraAllocTempMemId&(arg1Type, arg1Val)

  tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, charByteIdx, arg1Type, arg1Val

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0

  tiraLabelId lblDoneIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_STRINGFUNC$ = scratchName$

END FUNCTION ' parse_STRINGFUNC$

''''''''''''''''''''''''
FUNCTION parse_SWAP (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM iVar AS LONG
  DIM vStart AS LONG
  DIM vEnd AS LONG
  DIM tokIdx AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM tempFieldSize AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM varAddr(2) AS LONG
  DIM varType(2) AS LONG
  DIM varSize(2) AS LONG
  DIM varUdt(2) AS LONG
  DIM varDynStr(2) AS LONG
  DIM finalAddrIdx AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM iDot AS LONG

  DIM sz AS LONG
  DIM tempHeapPtrIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx = 0 THEN
    throwCompilerError "SWAP REQUIRES TWO VARIABLES SEPARATED BY A COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  FOR iVar = 1 TO 2
    IF iVar = 1 THEN
      vStart = startIdx + 1
      vEnd = commaIdx - 1
    ELSE
      vStart = commaIdx + 1
      vEnd = endIdx
    END IF

    tokIdx = vStart
    IF tokIdx > vEnd THEN
      throwCompilerErrorAndCancelTira "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 OR LEN(vTok$) = 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(vTok$)
    tokIdx = tokIdx + 1

    ' 1. Dot notation (Legacy)
    DO WHILE tokIdx <= vEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        IF findSymbol(vName$) THEN
          IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
        END IF
        IF cm.ClassicMode = 1 THEN
          IF tokIdx + 1 <= vEnd THEN
            vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
            tokIdx = tokIdx + 2
          ELSE
            EXIT DO
          END IF
        ELSE
          throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
          addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ' 2. Array Indices
    hasIndex = 0
    parenStartIdx = 0
    closeParenIdx = 0
    IF tokIdx <= vEnd THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        parenStartIdx = tokIdx
        ff = findMatchingParen(tokIdx, vEnd)
        IF ff = 1 THEN
          closeParenIdx = returnedData2
        ELSE
          throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN SWAP", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = closeParenIdx + 1
      END IF
    END IF

    ' 3. UDT Fields
    udtFieldCount = 0
    hasField = 0
    DO WHILE tokIdx <= vEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
        udtFieldCount = udtFieldCount + 1
        IF udtFieldCount >= 256 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = tokIdx + 2
      ELSE
        EXIT DO
      END IF
    LOOP

    IF tokIdx <= vEnd THEN
      throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN SWAP VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    ' Process UDT
    IF hasField = 1 THEN
      IF targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
      tempUdtIndex = symbols(vIdx).UDTIndex
      udtOffset = 0
      tempIsDynamicString = 0
      tempFieldSize = 0

      FOR iDot = 0 TO udtFieldCount - 1
        uIdx = tempUdtIndex
        fieldFound = 0

        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(uIdx, iField).Offset
          targetType = udtFields(uIdx, iField).DataType
          tempUdtIndex = udtFields(uIdx, iField).UDTIndex
          tempFieldSize = udtFields(uIdx, iField).Size
          tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
            iField = returnedData2
            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
              udtOffset = udtOffset + udtFields(uIdx, iField).Offset
              targetType = udtFields(uIdx, iField).DataType
              tempUdtIndex = udtFields(uIdx, iField).UDTIndex
              tempFieldSize = udtFields(uIdx, iField).Size
              tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
              fieldFound = 1
            END IF
          END IF
        END IF

        IF fieldFound = 0 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
          throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF
      NEXT iDot
    END IF

    ' Indices
    numParsedIndices = 0
    IF hasIndex = 1 THEN
      ff = tiraParseArrayId(parenStartIdx, closeParenIdx, 0)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      numParsedIndices = returnedData3
    END IF

    IF hasIndex = 1 THEN
      IF symbols(vIdx).IsArray = 0 THEN
        throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    varType(iVar) = targetType
    varUdt(iVar) = -1

    isFixedStr = 0
    destLen = 0
    IF hasField = 1 THEN
      IF targetType = TYPE_UDT THEN
        varUdt(iVar) = tempUdtIndex
        varSize(iVar) = tempFieldSize
      ELSE
        IF targetType = TYPE_STRING THEN
          IF tempIsDynamicString = 0 THEN
            isFixedStr = 1
            destLen = tempFieldSize
          END IF
        END IF
      END IF
    ELSE
      IF targetType = TYPE_UDT THEN
        varUdt(iVar) = symbols(vIdx).UDTIndex
        varSize(iVar) = retElementByteSize(vIdx)
      ELSE
        IF targetType = TYPE_STRING THEN
          destLen = retFixedStringLength(vIdx)
          IF destLen > 0 THEN
            isFixedStr = 1
          END IF
        END IF
      END IF
    END IF

    varDynStr(iVar) = 0

    IF targetType = TYPE_STRING THEN
      IF isFixedStr = 1 THEN
        varSize(iVar) = destLen
      ELSE
        varDynStr(iVar) = 1
        varSize(iVar) = 24 ' Size of string descriptor
      END IF
    ELSE
      IF targetType <> TYPE_UDT THEN
        varSize(iVar) = retElementByteSize(vIdx)
      END IF
    END IF

    IF hasIndex = 0 AND hasField = 0 THEN
      finalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, vIdx
      varAddr(iVar) = finalAddrIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      varAddr(iVar) = finalAddrIdx
    END IF
  NEXT iVar

  ' Type matching
  IF varType(1) <> varType(2) THEN
    throwCompilerErrorAndCancelTira "SWAP TYPE MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  IF varType(1) = TYPE_UDT THEN
    IF varUdt(1) <> varUdt(2) THEN
      throwCompilerErrorAndCancelTira "SWAP UDT TYPE MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF varType(1) = TYPE_STRING THEN
    IF varDynStr(1) <> varDynStr(2) THEN
      throwCompilerErrorAndCancelTira "CANNOT SWAP DYNAMIC AND FIXED STRINGS", ASIS, 0
      EXIT FUNCTION
    END IF
    IF varDynStr(1) = 0 THEN
      IF varSize(1) <> varSize(2) THEN
        throwCompilerErrorAndCancelTira "FIXED STRINGS MUST BE EXACT SAME LENGTH TO SWAP", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  sz = varSize(1)

  IF sz = 1 OR sz = 2 OR sz = 4 OR sz = 8 THEN
    tiraSwapMemId TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_LITERAL, sz
  ELSE
    tempHeapPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, sz)
    IF compileError = 1 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    tiraMemcpyId TIRA_ARG_SYMBOL, tempHeapPtrIdx, TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_LITERAL, sz
    tiraMemcpyId TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_LITERAL, sz
    tiraMemcpyId TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_SYMBOL, tempHeapPtrIdx, TIRA_ARG_LITERAL, sz
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SWAP = 1

END FUNCTION ' parse_SWAP

''''''''''''''''''''''''
FUNCTION parse_SYSTEM (startIdx)

  DIM endIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  DIM exitValueIdx AS LONG
  DIM endProgramIdx AS LONG

  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx > startIdx THEN
    ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "SYSTEM REQUIRES NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    exprVarType = tiraParsedArgType
    exprVarVal = tiraParsedArgVal

    ff = resolveSymbol("!G_SYS_VAL_EXIT")
    IF ff = 1 THEN
      exitValueIdx = returnedData2
      tiraAssignId exitValueIdx, exprVarType, exprVarVal
    END IF
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endProgramIdx = returnedData2

  tiraJmpId endProgramIdx

  tira_EndAndProcess

  parse_SYSTEM = 1

END FUNCTION ' parse_SYSTEM

''''''''''''''''''''''''
FUNCTION parse_THROWERR (startIdx)

  ' This function evaluates the THROWERR command, which replaces the legacy MEMERROR command
  ' It intentionally triggers specific compiler or runtime errors for testing the error handler subsystems
  '
  ' Arg value 0: Injects TC_MEMERROR into the TIRA queue to trigger a runtime memory access violation
  ' Arg value 1: Triggers a very long compile-time error to test multi-line status bar clicking

  DIM endIdx AS LONG
  DIM argStr$
  DIM errCode AS LONG
  DIM iLong AS LONG

  endIdx = lineTokenCount - 1

  ' Check to make sure the user provided an argument after the command
  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED ERROR CODE AFTER THROWERR", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Evaluate the argument text statically at compile time to branch the logic
  argStr$ = ""
  FOR iLong = startIdx + 1 TO endIdx
    argStr$ = argStr$ + retTokenText$(lineTokens$(iLong))
  NEXT

  argStr$ = evalMathConst$(argStr$)
  errCode = VAL(argStr$)

  IF errCode = 1 THEN
    throwCompilerError "THIS IS A DELIBERATELY LONG ERROR MESSAGE DESIGNED SPECIFICALLY TO EXCEED THE WIDTH OF THE STATUS BAR SO IT WRAPS INTO MULTIPLE LINES FOR CLICK TESTING", ASIS, 0

    tira_Start
    tiraScheduleHeapResetId
    tira_EndAndProcess
  ELSE
    ' Force an immediate runtime access violation by writing to a null pointer natively via TC_MEMERROR
    tira_Start

    tiraOpId0 TC_MEMERROR

    tiraScheduleHeapResetId
    tira_EndAndProcess
  END IF

  parse_THROWERR = 1

END FUNCTION ' parse_THROWERR

''''''''''''''''''''''''
FUNCTION parse_TIMER$ (startIdx, endIdx, allowImplicit)

  DIM scratchIdx AS LONG
  DIM scratchName$
  DIM tickValIdx AS LONG
  DIM tickDoubleIdx AS LONG
  DIM resVarIdx AS LONG
  DIM singleResIdx AS LONG
  DIM callFuncIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED TIMER", ASIS, 0
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("TIMER", "_VAL")
  IF scratchIdx = 0 THEN
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly override the integer prefix rule to safely route as float
  symbols(scratchIdx).DataType = TYPE_SINGLE

  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN
    tira_Cancel
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2
  tiraCallId0 callFuncIdx

  tickValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId tickValIdx

  tickDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, tickDoubleIdx, TIRA_ARG_SYMBOL, tickValIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, tickDoubleIdx, TIRA_ARG_LITERAL, 1000

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_TIMER$ = scratchName$

END FUNCTION ' parse_TIMER$

''''''''''''''''''''''''
FUNCTION parse_TRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM origPtrIdx AS LONG
  DIM origLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM loopLeftTopIdx AS LONG
  DIM loopLeftDoneIdx AS LONG
  DIM loopRightTopIdx AS LONG
  DIM loopRightDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpaceLLblIdx AS LONG
  DIM isSpaceRLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_TRIM$", 3) = 0 THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_TRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("TRIM", "_DSC")
  IF scratchIdx = 0 THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  origPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  origLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, origPtrIdx
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, origLenIdx

  loopLeftTopIdx = tiraLabelCreateNewId&("TRIM_L_LOOP")
  loopLeftDoneIdx = tiraLabelCreateNewId&("TRIM_L_DONE")

  tiraLabelId loopLeftTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopLeftDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  isSpaceLLblIdx = tiraLabelCreateNewId&("TRIM_L_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceLLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopLeftDoneIdx
  tiraLabelId isSpaceLLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopLeftTopIdx

  tiraLabelId loopLeftDoneIdx

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1

  loopRightTopIdx = tiraLabelCreateNewId&("TRIM_R_LOOP")
  loopRightDoneIdx = tiraLabelCreateNewId&("TRIM_R_DONE")

  tiraLabelId loopRightTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopRightDoneIdx

  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, endPtrIdx

  isSpaceRLblIdx = tiraLabelCreateNewId&("TRIM_R_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceRLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopRightDoneIdx
  tiraLabelId isSpaceRLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopRightTopIdx

  tiraLabelId loopRightDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_TRIM$ = scratchName$

END FUNCTION ' parse_TRIM$

''''''''''''''''''''''''
FUNCTION parse_UBOUND$ (startIdx, endIdx, allowImplicit)

  DIM arrNameTok$
  DIM comma1 AS LONG
  DIM vIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dimVarType AS LONG
  DIM dimVarVal AS _INTEGER64
  DIM resVarIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM dimLBoundIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM descAddrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "UBOUND", 3) = 0 THEN
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  arrNameTok$ = UCASE$(retTokenText$(lineTokens$(startIdx + 2)))
  ff = findSymbol(arrNameTok$)
  IF ff = 0 THEN
    throwCompilerError "UNDECLARED ARRAY IN UBOUND", ASIS, 0
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerError "UBOUND REQUIRES AN ARRAY", ASIS, 0
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "DIMENSION MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_UBOUND$ = ""
      EXIT FUNCTION
    END IF
    dimVarType = tiraParsedArgType
    dimVarVal = tiraParsedArgVal
  ELSE
    dimVarType = TIRA_ARG_LITERAL
    dimVarVal = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("UBOUND", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  lblEndIdx = tiraLabelCreateNewId&("UB_END")
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraJmpCondId JCC_JG, dimVarType, dimVarVal, TIRA_ARG_SYMBOL, numDimsIdx, lblEndIdx
  tiraJmpCondId JCC_JL, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1, lblEndIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, offsetVarIdx, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 0

  dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 4

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, dimLBoundIdx, TIRA_ARG_SYMBOL, dimNumElemsIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_UBOUND$ = scratchName$

END FUNCTION ' parse_UBOUND$

''''''''''''''''''''''''
FUNCTION parse_UCASE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM destItrIdx AS LONG
  DIM srcItrIdx AS LONG
  DIM itrLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipLowerLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "UCASE$", 3) = 0 THEN
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "UCASE$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("UCASE", "_DSC")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF dataPtrIdx = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  destItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destItrIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  srcItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId srcItrIdx, TIRA_ARG_SYMBOL, srcPtrIdx
  itrLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId itrLenIdx, TIRA_ARG_SYMBOL, strLenIdx

  loopTopIdx = tiraLabelCreateNewId&("UCASE_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("UCASE_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, srcItrIdx

  skipLowerLblIdx = tiraLabelCreateNewId&("UCASE_SKIP")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 97, skipLowerLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 122, skipLowerLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32
  tiraLabelId skipLowerLblIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_UCASE$ = scratchName$

END FUNCTION ' parse_UCASE$

''''''''''''''''''''''''
FUNCTION parse_WAIT (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM refreshRate AS LONG
  DIM portVarType AS LONG
  DIM portVarVal AS _INTEGER64
  DIM maskVarType AS LONG
  DIM maskVarVal AS _INTEGER64
  DIM rateVarIdx AS LONG
  DIM skipWaitLblIdx AS LONG
  DIM autoFlagIdx AS LONG
  DIM swapFuncIdx AS LONG
  DIM limitFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerError "WAIT REQUIRES PORT AND MASK", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, commaIdx - 1, ALIM, "PORT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  portVarType = tiraParsedArgType
  portVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(commaIdx + 1, endIdx, ALIM, "MASK MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  maskVarType = tiraParsedArgType
  maskVarVal = tiraParsedArgVal

  IF cm.HasGraphics = 1 THEN
    skipWaitLblIdx = tiraLabelCreateNewId&("WAIT_SKIP")

    tiraJmpCondId JCC_JNE, portVarType, portVarVal, TIRA_ARG_LITERAL, 986, skipWaitLblIdx

    tiraJmpCondId JCC_JNE, maskVarType, maskVarVal, TIRA_ARG_LITERAL, 8, skipWaitLblIdx

    refreshRate = 60
    IF compileScreenMode = 13 THEN refreshRate = 70

    rateVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraAssignId rateVarIdx, TIRA_ARG_LITERAL, refreshRate

    ff = resolveSymbol("!G_GFX_FLG_AUTO")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    autoFlagIdx = returnedData2
    tiraAssignId autoFlagIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    swapFuncIdx = returnedData2
    tiraCallId0 swapFuncIdx

    ff = resolveSymbol("RT_LIMIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    limitFuncIdx = returnedData2
    tiraCallId1 limitFuncIdx, TIRA_ARG_SYMBOL, rateVarIdx

    tiraLabelId skipWaitLblIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_WAIT = 1

END FUNCTION ' parse_WAIT

''''''''''''''''''''''''
FUNCTION parse_WEND (startIdx)

' Marks the conclusion of a WHILE loop and returns execution to the top evaluation condition

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "WEND WITHOUT WHILE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_WHILE THEN
    throwCompilerError "WEND MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrlCount = ctrlCount - 1
  loopID = ctrls(ctrlCount).Patch1

  topLbl$ = "@WHILE_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  tira_Start
  tiraScheduleHeapResetId

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraJmpId topLblIdx

  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2
  tiraLabelId doneLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_WEND = 1

END FUNCTION ' parse_WEND

''''''''''''''''''''''''
FUNCTION parse_WHEEL$ (startIdx, endIdx, allowImplicit)

  ' Returns the relative rotation value of a controller wheel

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_WHEEL", 3) = 0 THEN
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("WHEEL", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ff = resolveSymbol("RT_WHEEL")
  IF ff = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WHEEL$ = scratchName$

END FUNCTION ' parse_WHEEL$

''''''''''''''''''''''''
FUNCTION parse_WHILE (startIdx)

' Initiates a loop block that continues to execute as long as its condition remains true

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  endIdx = lineTokenCount - 1

  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_WHILE = 0
    EXIT FUNCTION
  END IF

  topLbl$ = "@WHILE_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  tira_Start

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx

  tira_EndAndProcess

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  ' Intrinsic hoisting shortens the token list, so refresh the expression boundary before parsing
  endIdx = lineTokenCount - 1

  tira_Start

  ff = tiraParseExpressionNumericId(startIdx + 1, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal

  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2

  tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_WHILE
  ctrls(ctrlCount).Patch1 = loopID
  ctrls(ctrlCount).Patch2 = 0
  ctrlCount = ctrlCount + 1

  parse_WHILE = 1

END FUNCTION ' parse_WHILE

''''''''''''''''''''''''
FUNCTION parse_WINDOWHANDLE$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM getConsoleWindowIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _WINDOWHANDLE", ASIS, 0
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("WNDHND", "_VAL")
  IF scratchIdx = 0 THEN
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly force the data type to 64-bit integer
  symbols(scratchIdx).DataType = TYPE_INTEGER64

  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_WND_VAL_HWND")
    IF ff = 0 THEN
      tira_Cancel
      parse_WINDOWHANDLE$ = ""
      EXIT FUNCTION
    END IF
    windowHandleIdx = returnedData2

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, windowHandleIdx
  ELSE
    ff = resolveSymbol("IAT_GETCONSOLEWINDOW")
    IF ff = 0 THEN
      tira_Cancel
      parse_WINDOWHANDLE$ = ""
      EXIT FUNCTION
    END IF
    getConsoleWindowIdx = returnedData2

    tiraCallId0 getConsoleWindowIdx
    tiraGetRetId resVarIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_WINDOWHANDLE$ = scratchName$

END FUNCTION ' parse_WINDOWHANDLE$

''''''''''''''''''''''''
FUNCTION parse_WIDTH$ (startIdx, endIdx, allowImplicit)
  ' Func version, will need to change names later when WIDTH without underscore is supported

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM resWidth AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("WIDTH", "_VAL")
  IF scratchIdx = 0 THEN
    parse_WIDTH$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_LONG

  resWidth = 120
  IF cm.HasGraphics = 1 THEN resWidth = gfxConfig.SizeX

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, resWidth

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WIDTH$ = scratchName$

END FUNCTION ' parse_WIDTH$

''''''''''''''''''''''''
FUNCTION parse_VAL$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM isNegIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipSpaceTopIdx AS LONG
  DIM skipSpaceDoneIdx AS LONG
  DIM checkSignDoneIdx AS LONG
  DIM negativeSignLblIdx AS LONG
  DIM consumeSignLblIdx AS LONG
  DIM numLoopTopIdx AS LONG
  DIM numLoopDoneIdx AS LONG
  DIM applySignDoneIdx AS LONG

  DIM isAmpLblIdx AS LONG
  DIM isHexLblIdx AS LONG
  DIM isOctLblIdx AS LONG
  DIM base10LblIdx AS LONG
  DIM hexLoopTopIdx AS LONG
  DIM isDigitLblIdx AS LONG
  DIM isUpperLblIdx AS LONG
  DIM isLowerLblIdx AS LONG
  DIM applyHexLblIdx AS LONG
  DIM octLoopTopIdx AS LONG

  DIM isFractionIdx AS LONG
  DIM fractionDivIdx AS LONG
  DIM digitFloatIdx AS LONG
  DIM decimalPointLblIdx AS LONG
  DIM wholeDigitLblIdx AS LONG
  DIM digitAdvanceLblIdx AS LONG

  DIM exponentLblIdx AS LONG
  DIM exponentValIdx AS LONG
  DIM exponentNegIdx AS LONG
  DIM exponentSignDoneIdx AS LONG
  DIM exponentNegativeLblIdx AS LONG
  DIM exponentConsumeSignLblIdx AS LONG
  DIM exponentLoopTopIdx AS LONG
  DIM exponentApplyLblIdx AS LONG
  DIM exponentApplyTopIdx AS LONG
  DIM exponentMultiplyLblIdx AS LONG
  DIM exponentStepDoneIdx AS LONG
  DIM exponentCapDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VAL", 3) = 0 THEN
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("VAL", "_VAL")
  IF scratchIdx = 0 THEN
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_DOUBLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)

  skipSpaceTopIdx = tiraLabelCreateNewId&("VAL_SKIP_SPC")
  skipSpaceDoneIdx = tiraLabelCreateNewId&("VAL_SPC_DONE")

  tiraLabelId skipSpaceTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, skipSpaceDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, skipSpaceDoneIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipSpaceTopIdx

  tiraLabelId skipSpaceDoneIdx

  checkSignDoneIdx = tiraLabelCreateNewId&("VAL_SGN_DONE")
  negativeSignLblIdx = tiraLabelCreateNewId&("VAL_SGN_NEG")
  consumeSignLblIdx = tiraLabelCreateNewId&("VAL_SGN_CONSUME")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, checkSignDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, negativeSignLblIdx ' -
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 43, checkSignDoneIdx ' +
  tiraJmpId consumeSignLblIdx

  tiraLabelId negativeSignLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId consumeSignLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId checkSignDoneIdx

  isAmpLblIdx = tiraLabelCreateNewId&("VAL_IS_AMP")
  isHexLblIdx = tiraLabelCreateNewId&("VAL_IS_HEX")
  isOctLblIdx = tiraLabelCreateNewId&("VAL_IS_OCT")
  base10LblIdx = tiraLabelCreateNewId&("VAL_BASE10")
  numLoopDoneIdx = tiraLabelCreateNewId&("VAL_NUM_DONE")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 38, isAmpLblIdx ' 38 is &
  tiraJmpId base10LblIdx

  tiraLabelId isAmpLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx

  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 72, isHexLblIdx ' H
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 104, isHexLblIdx ' h
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 79, isOctLblIdx ' O
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 111, isOctLblIdx ' o

  tiraJmpId numLoopDoneIdx

  tiraLabelId isHexLblIdx
  hexLoopTopIdx = tiraLabelCreateNewId&("VAL_HEX_LOOP")
  isDigitLblIdx = tiraLabelCreateNewId&("VAL_HEX_DIGIT")
  isUpperLblIdx = tiraLabelCreateNewId&("VAL_HEX_UPPER")
  isLowerLblIdx = tiraLabelCreateNewId&("VAL_HEX_LOWER")
  applyHexLblIdx = tiraLabelCreateNewId&("VAL_HEX_APPLY")

  tiraLabelId hexLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, isDigitLblIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 65, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 70, isUpperLblIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 97, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 102, isLowerLblIdx

  tiraJmpId numLoopDoneIdx

  tiraLabelId isDigitLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraJmpId applyHexLblIdx

  tiraLabelId isUpperLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 55
  tiraJmpId applyHexLblIdx

  tiraLabelId isLowerLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 87

  tiraLabelId applyHexLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId hexLoopTopIdx

  tiraLabelId isOctLblIdx
  octLoopTopIdx = tiraLabelCreateNewId&("VAL_OCT_LOOP")

  tiraLabelId octLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 55, numLoopDoneIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId octLoopTopIdx

  tiraLabelId base10LblIdx

  isFractionIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isFractionIdx, TIRA_ARG_LITERAL, 0

  fractionDivIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId fractionDivIdx, TIRA_ARG_LITERAL, 1

  digitFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  numLoopTopIdx = tiraLabelCreateNewId&("VAL_NUM_LOOP")
  decimalPointLblIdx = tiraLabelCreateNewId&("VAL_DECIMAL")
  wholeDigitLblIdx = tiraLabelCreateNewId&("VAL_WHOLE_DIGIT")
  digitAdvanceLblIdx = tiraLabelCreateNewId&("VAL_DIGIT_ADVANCE")
  exponentLblIdx = tiraLabelCreateNewId&("VAL_EXPONENT")

  tiraLabelId numLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 46, decimalPointLblIdx ' .
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 69, exponentLblIdx ' E
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 101, exponentLblIdx ' e
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 68, exponentLblIdx ' D
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 100, exponentLblIdx ' d

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx ' 0
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, numLoopDoneIdx ' 9

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFractionIdx, TIRA_ARG_LITERAL, 0, wholeDigitLblIdx

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fractionDivIdx, TIRA_ARG_SYMBOL, fractionDivIdx, TIRA_ARG_LITERAL, 10
  tiraAssignId digitFloatIdx, TIRA_ARG_SYMBOL, byteValIdx
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, digitFloatIdx, TIRA_ARG_SYMBOL, digitFloatIdx, TIRA_ARG_SYMBOL, fractionDivIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, digitFloatIdx
  tiraJmpId digitAdvanceLblIdx

  tiraLabelId wholeDigitLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraLabelId digitAdvanceLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId decimalPointLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, isFractionIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraAssignId isFractionIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId exponentLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  exponentValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId exponentValIdx, TIRA_ARG_LITERAL, 0

  exponentNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId exponentNegIdx, TIRA_ARG_LITERAL, 0

  exponentSignDoneIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_DONE")
  exponentNegativeLblIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_NEG")
  exponentConsumeSignLblIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_CONSUME")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, exponentNegativeLblIdx ' -
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 43, exponentSignDoneIdx ' +
  tiraJmpId exponentConsumeSignLblIdx

  tiraLabelId exponentNegativeLblIdx
  tiraAssignId exponentNegIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId exponentConsumeSignLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId exponentSignDoneIdx

  exponentLoopTopIdx = tiraLabelCreateNewId&("VAL_EXP_LOOP")
  exponentApplyLblIdx = tiraLabelCreateNewId&("VAL_EXP_APPLY")
  exponentCapDoneIdx = tiraLabelCreateNewId&("VAL_EXP_CAP")

  tiraLabelId exponentLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, exponentApplyLblIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, exponentApplyLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, exponentApplyLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 400, exponentCapDoneIdx
  tiraAssignId exponentValIdx, TIRA_ARG_LITERAL, 400
  tiraLabelId exponentCapDoneIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId exponentLoopTopIdx

  tiraLabelId exponentApplyLblIdx

  exponentApplyTopIdx = tiraLabelCreateNewId&("VAL_EXP_APPLY_LOOP")
  exponentMultiplyLblIdx = tiraLabelCreateNewId&("VAL_EXP_MUL")
  exponentStepDoneIdx = tiraLabelCreateNewId&("VAL_EXP_STEP")

  tiraLabelId exponentApplyTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, exponentNegIdx, TIRA_ARG_LITERAL, 0, exponentMultiplyLblIdx

  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraJmpId exponentStepDoneIdx

  tiraLabelId exponentMultiplyLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10

  tiraLabelId exponentStepDoneIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId exponentApplyTopIdx

  tiraLabelId numLoopDoneIdx

  applySignDoneIdx = tiraLabelCreateNewId&("VAL_SGN_APP")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, applySignDoneIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId applySignDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_DOUBLE
  exprIs.IsTemp = 1
  parse_VAL$ = scratchName$

END FUNCTION ' parse_VAL$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_VARPTR$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM addrVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VARPTR", 3) = 0 THEN
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER VARPTR", ASIS, 0
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Support dot variable syntax gracefully to map cleanly with older structural integrations
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN VARPTR", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN VARPTR", ASIS, 0
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("VARPTR", "_PTR")
  IF scratchIdx = 0 THEN
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF hasIndex = 0 AND hasField = 0 THEN
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
  ELSE
    addrVarIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
    IF compileError = 1 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, addrVarIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_VARPTR$ = scratchName$

END FUNCTION ' parse_VARPTR$

''''''''''''''''''''''''
FUNCTION parse_VARSEG$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VARSEG", 3) = 0 THEN
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER VARSEG", ASIS, 0
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN VARSEG", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN VARSEG", ASIS, 0
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("VARSEG", "_VAL")
  IF scratchIdx = 0 THEN
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_VARSEG$ = scratchName$

END FUNCTION ' parse_VARSEG$

''''''''''''''''''''''''
FUNCTION parse_VIEW_GRAPHICS (startIdx, endIdx)

  DIM tokIdx AS LONG
  DIM isScreen AS LONG
  DIM dashIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM p2End AS LONG
  DIM cComma1 AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM cComma2 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM colEnd1 AS LONG
  DIM hasColBg AS LONG
  DIM hasColBorder AS LONG

  DIM x1Type AS LONG
  DIM x1Val AS _INTEGER64
  DIM y1Type AS LONG
  DIM y1Val AS _INTEGER64
  DIM x2Type AS LONG
  DIM x2Val AS _INTEGER64
  DIM y2Type AS LONG
  DIM y2Val AS _INTEGER64
  DIM colBgType AS LONG
  DIM colBgVal AS _INTEGER64
  DIM colBorderType AS LONG
  DIM colBorderVal AS _INTEGER64

  DIM minXIdx AS LONG
  DIM maxXIdx AS LONG
  DIM minYIdx AS LONG
  DIM maxYIdx AS LONG
  DIM skipXIdx AS LONG
  DIM skipYIdx AS LONG
  DIM bMinXIdx AS LONG
  DIM bMaxXIdx AS LONG
  DIM bMinYIdx AS LONG
  DIM bMaxYIdx AS LONG

  DIM viewX1Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM lineFuncIdx AS LONG

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "VIEW REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewX1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewY1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewX2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewY2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewOffsetXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewOffsetYIdx = returnedData2

  IF startIdx > endIdx THEN
    tiraAssignId viewX1Idx, TIRA_ARG_LITERAL, 0
    tiraAssignId viewY1Idx, TIRA_ARG_LITERAL, 0
    tiraAssignId viewX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraAssignId viewY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY
    tiraAssignId viewOffsetXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId viewOffsetYIdx, TIRA_ARG_LITERAL, 0

    tiraScheduleHeapResetId
    tira_EndAndProcess
    parse_VIEW_GRAPHICS = 1
    EXIT FUNCTION
  END IF

  tokIdx = startIdx
  isScreen = 0
  IF lineTokenVals(tokIdx) = TOK_SCREEN THEN
    isScreen = 1
    tokIdx = tokIdx + 1
  END IF

  dashIdx = 0
  ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
  IF ff = 1 THEN
    dashIdx = returnedData2
  END IF

  IF dashIdx = 0 THEN
    throwCompilerErrorAndCancelTira "VIEW MISSING -", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  IF comma1 > 0 THEN comma2 = findComma(comma1 + 1, endIdx)

  p2End = endIdx
  IF comma1 > 0 THEN p2End = comma1 - 1

  cComma1 = retCoordinateBoundaries(tokIdx, dashIdx - 1)
  cStart1 = returnedData2
  cEnd1 = returnedData3

  cComma2 = retCoordinateBoundaries(dashIdx + 1, p2End)
  cStart2 = returnedData2
  cEnd2 = returnedData3

  IF cComma1 = 0 OR cComma2 = 0 THEN
    throwCompilerErrorAndCancelTira "VIEW MISSING COORDINATES", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntId(cStart1, cComma1 - 1, ALIM, "COORD MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x1Type = tiraParsedArgType
  x1Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma1 + 1, cEnd1, ALIM, "COORD MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y1Type = tiraParsedArgType
  y1Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cStart2, cComma2 - 1, ALIM, "COORD MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2Type = tiraParsedArgType
  x2Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma2 + 1, cEnd2, ALIM, "COORD MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2Type = tiraParsedArgType
  y2Val = tiraParsedArgVal

  hasColBg = 0
  hasColBorder = 0

  IF comma1 > 0 THEN
    colEnd1 = endIdx
    IF comma2 > 0 THEN colEnd1 = comma2 - 1

    IF comma1 + 1 <= colEnd1 THEN
      ff = tiraParseExpressionIntId(comma1 + 1, colEnd1, ALIM, "COLOR MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      colBgType = tiraParsedArgType
      colBgVal = tiraParsedArgVal
      hasColBg = 1
    END IF

    IF comma2 > 0 THEN
      IF comma2 + 1 <= endIdx THEN
        ff = tiraParseExpressionIntId(comma2 + 1, endIdx, ALIM, "BORDER MUST BE NUMERIC")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        colBorderType = tiraParsedArgType
        colBorderVal = tiraParsedArgVal
        hasColBorder = 1
      END IF
    END IF
  END IF

  minXIdx = tiraDimVarId&("T", TYPE_LONG)
  maxXIdx = tiraDimVarId&("T", TYPE_LONG)
  minYIdx = tiraDimVarId&("T", TYPE_LONG)
  maxYIdx = tiraDimVarId&("T", TYPE_LONG)

  skipXIdx = tiraLabelCreateNewId&("VIEW_X")
  tiraAssignId minXIdx, x1Type, x1Val
  tiraAssignId maxXIdx, x2Type, x2Val
  tiraJmpCondId JCC_JLE, x1Type, x1Val, x2Type, x2Val, skipXIdx
  tiraAssignId minXIdx, x2Type, x2Val
  tiraAssignId maxXIdx, x1Type, x1Val
  tiraLabelId skipXIdx

  skipYIdx = tiraLabelCreateNewId&("VIEW_Y")
  tiraAssignId minYIdx, y1Type, y1Val
  tiraAssignId maxYIdx, y2Type, y2Val
  tiraJmpCondId JCC_JLE, y1Type, y1Val, y2Type, y2Val, skipYIdx
  tiraAssignId minYIdx, y2Type, y2Val
  tiraAssignId maxYIdx, y1Type, y1Val
  tiraLabelId skipYIdx

  ' Temporarily set viewport to absolute full screen to safely draw the background and borders
  tiraAssignId viewX1Idx, TIRA_ARG_LITERAL, 0
  tiraAssignId viewY1Idx, TIRA_ARG_LITERAL, 0
  tiraAssignId viewX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraAssignId viewY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY
  tiraAssignId viewOffsetXIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId viewOffsetYIdx, TIRA_ARG_LITERAL, 0

  IF hasColBg = 1 THEN
    ff = resolveSymbol("RT_LINE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lineFuncIdx = returnedData2

    tiraCallId7 lineFuncIdx, TIRA_ARG_SYMBOL, minXIdx, TIRA_ARG_SYMBOL, minYIdx, TIRA_ARG_SYMBOL, maxXIdx, TIRA_ARG_SYMBOL, maxYIdx, colBgType, colBgVal, TIRA_ARG_LITERAL, 2, TIRA_ARG_LITERAL, 65535
  END IF

  IF hasColBorder = 1 THEN
    bMinXIdx = tiraDimVarId&("T", TYPE_LONG)
    bMaxXIdx = tiraDimVarId&("T", TYPE_LONG)
    bMinYIdx = tiraDimVarId&("T", TYPE_LONG)
    bMaxYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bMinXIdx, TIRA_ARG_SYMBOL, minXIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bMaxXIdx, TIRA_ARG_SYMBOL, maxXIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bMinYIdx, TIRA_ARG_SYMBOL, minYIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bMaxYIdx, TIRA_ARG_SYMBOL, maxYIdx, TIRA_ARG_LITERAL, 1

    IF hasColBg = 0 THEN
      ff = resolveSymbol("RT_LINE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      lineFuncIdx = returnedData2
    END IF

    tiraCallId7 lineFuncIdx, TIRA_ARG_SYMBOL, bMinXIdx, TIRA_ARG_SYMBOL, bMinYIdx, TIRA_ARG_SYMBOL, bMaxXIdx, TIRA_ARG_SYMBOL, bMaxYIdx, colBorderType, colBorderVal, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 65535
  END IF

  ' Now establish the actual restricted viewport boundaries internally
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, maxXIdx, TIRA_ARG_SYMBOL, maxXIdx, TIRA_ARG_LITERAL, 1 ' Max limits are exclusive
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, maxYIdx, TIRA_ARG_SYMBOL, maxYIdx, TIRA_ARG_LITERAL, 1

  tiraAssignId viewX1Idx, TIRA_ARG_SYMBOL, minXIdx
  tiraAssignId viewX2Idx, TIRA_ARG_SYMBOL, maxXIdx
  tiraAssignId viewY1Idx, TIRA_ARG_SYMBOL, minYIdx
  tiraAssignId viewY2Idx, TIRA_ARG_SYMBOL, maxYIdx

  IF isScreen = 1 THEN
    tiraAssignId viewOffsetXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId viewOffsetYIdx, TIRA_ARG_LITERAL, 0
  ELSE
    tiraAssignId viewOffsetXIdx, TIRA_ARG_SYMBOL, minXIdx
    tiraAssignId viewOffsetYIdx, TIRA_ARG_SYMBOL, minYIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_VIEW_GRAPHICS = 1

END FUNCTION ' parse_VIEW_GRAPHICS

''''''''''''''''''''''''
FUNCTION parse_VIEW_PRINT (startIdx, endIdx)

  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM maxRows AS LONG
  DIM textRowHeight AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBotIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM setConsoleCursorIdx AS LONG
  DIM fullRowsIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM topType AS LONG
  DIM topVal AS _INTEGER64
  DIM botType AS LONG
  DIM botVal AS _INTEGER64
  DIM maxRowsType AS LONG
  DIM maxRowsVal AS _INTEGER64
  DIM maxRowsVarIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM lblErrIdx AS LONG
  DIM topZeroIdx AS LONG
  DIM packedYIdx AS LONG

  textRowHeight = 8
  IF compileScreenMode = 9 THEN textRowHeight = 14
  IF compileScreenMode = 11 OR compileScreenMode = 12 THEN textRowHeight = 16

  tira_Start

  ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewTopIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewBotIdx = returnedData2

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fontHeightGlobalIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textXIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textYIdx = returnedData2

    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("VIEWP_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx
  ELSE
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setConsoleCursorIdx = returnedData2
  END IF

  IF startIdx > endIdx THEN
    tiraAssignId viewTopIdx, TIRA_ARG_LITERAL, 0
    IF cm.HasGraphics = 1 THEN
      fullRowsIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId fullRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
      tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

      ' Reset text cursor to top left
      tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId textYIdx, TIRA_ARG_LITERAL, 0
    ELSE
      tiraAssignId viewBotIdx, TIRA_ARG_LITERAL, 25

      ' Reset native console cursor to top left
      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx
      tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_LITERAL, 0
    END IF
  ELSE
    hasTo = 0
    toIdx = 0
    ff = findNextTokenAtDepth0(startIdx, endIdx, TOK_TO)
    IF ff = 1 THEN
      hasTo = 1
      toIdx = returnedData2
    END IF

    IF hasTo = 0 THEN
      throwCompilerErrorAndCancelTira "VIEW PRINT MISSING TO", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = tiraParseExpressionIntId(startIdx, toIdx - 1, ALIM, "TOP ROW MUST BE NUMERIC")
    IF ff = 0 THEN EXIT FUNCTION
    topType = tiraParsedArgType
    topVal = tiraParsedArgVal

    ff = tiraParseExpressionIntId(toIdx + 1, endIdx, ALIM, "BOTTOM ROW MUST BE NUMERIC")
    IF ff = 0 THEN EXIT FUNCTION
    botType = tiraParsedArgType
    botVal = tiraParsedArgVal

    maxRows = 25
    maxRowsType = TIRA_ARG_LITERAL
    maxRowsVal = maxRows

    IF cm.HasGraphics = 1 THEN
      maxRowsVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId maxRowsVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
      tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, maxRowsVarIdx, TIRA_ARG_SYMBOL, maxRowsVarIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      maxRowsType = TIRA_ARG_SYMBOL
      maxRowsVal = maxRowsVarIdx
    END IF

    lblValidIdx = tiraLabelCreateNewId&("VIEWP_VALID")
    lblErrIdx = tiraLabelCreateNewId&("VIEWP_ERR")

    tiraJmpCondId JCC_JL, topType, topVal, TIRA_ARG_LITERAL, 1, lblErrIdx
    tiraJmpCondId JCC_JG, botType, botVal, maxRowsType, maxRowsVal, lblErrIdx
    tiraJmpCondId JCC_JG, topType, topVal, botType, botVal, lblErrIdx

    tiraJmpId lblValidIdx

    tiraLabelId lblErrIdx
    tiraFatalErrorId "ILLEGAL FUNCTION CALL IN VIEW PRINT"

    tiraLabelId lblValidIdx

    topZeroIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, topZeroIdx, topType, topVal, TIRA_ARG_LITERAL, 1 ' Make 0-based row targeting safely using a temp variable

    IF cm.HasGraphics = 1 THEN
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_SYMBOL, topZeroIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewBotIdx, botType, botVal, TIRA_ARG_SYMBOL, fontHeightIdx

      ' Move text cursor exactly into the top left of the new viewport
      tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId textYIdx, TIRA_ARG_SYMBOL, viewTopIdx
    ELSE
      tiraAssignId viewTopIdx, TIRA_ARG_SYMBOL, topZeroIdx
      tiraAssignId viewBotIdx, botType, botVal

      packedYIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, topZeroIdx, TIRA_ARG_LITERAL, 16

      ' Move console cursor into the top left of the new viewport
      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx
      tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, packedYIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_VIEW_PRINT = 1

END FUNCTION ' parse_VIEW_PRINT

''''''''''''''''''''''''
SUB waitKeyRelease (wKey$)

  DIM currentDest AS LONG

  currentDest = _DEST

  IF currentDest = logicalScreen THEN
    dispScreenFlushUpdate ' Logical-screen modals still require their normal scaled presentation
  ELSE
    _DISPLAY ' Physical screen content is already complete and must not be replaced by logicalScreen
  END IF

  DO
  LOOP UNTIL keyCheck(wKey$) = 0

END SUB ' waitKeyRelease

