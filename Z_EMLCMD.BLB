  literalPositionIdx = tiraDimVarId&("T", TYPE_LONG)
  literalAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  scanTopLblIdx = tiraLabelCreateNewId&("PU_SCAN")
  scanEndLblIdx = tiraLabelCreateNewId&("PU_SCAN_END")
  scanWrapLblIdx = tiraLabelCreateNewId&("PU_WRAP")
  doneLblIdx = tiraLabelCreateNewId&("PU_DONE")
  errorLblIdx = tiraLabelCreateNewId&("PU_ERROR")

  numericProbeTopLblIdx = tiraLabelCreateNewId&("PU_NUM_PROBE")
  numericCheckExponentLblIdx = tiraLabelCreateNewId&("PU_NUM_EXP_CHECK")
  numericCheckFourCaretsLblIdx = tiraLabelCreateNewId&("PU_NUM_EXP4_CHECK")
  numericCheckFractionLblIdx = tiraLabelCreateNewId&("PU_NUM_FRAC_CHECK")
  numericCheckCommaLblIdx = tiraLabelCreateNewId&("PU_NUM_COMMA_CHECK")
  numericCheckHashLblIdx = tiraLabelCreateNewId&("PU_NUM_HASH_CHECK")
  numericCheckPointLblIdx = tiraLabelCreateNewId&("PU_NUM_POINT_CHECK")
  numericCheckSpecialLblIdx = tiraLabelCreateNewId&("PU_NUM_SPECIAL_CHECK")
  numericCheckStarsLblIdx = tiraLabelCreateNewId&("PU_NUM_STARS_CHECK")
  numericCheckDollarLblIdx = tiraLabelCreateNewId&("PU_NUM_DOLLAR_CHECK")
  numericCheckLeadingPlusLblIdx = tiraLabelCreateNewId&("PU_NUM_PLUS_CHECK")
  numericTrailingPlusLblIdx = tiraLabelCreateNewId&("PU_NUM_TRAIL_PLUS")
  numericTrailingMinusLblIdx = tiraLabelCreateNewId&("PU_NUM_TRAIL_MINUS")
  numericProbeDoneLblIdx = tiraLabelCreateNewId&("PU_NUM_DONE")

  stringProbeLblIdx = tiraLabelCreateNewId&("PU_STR_PROBE")
  stringAmpLblIdx = tiraLabelCreateNewId&("PU_STR_AMP")
  stringBangLblIdx = tiraLabelCreateNewId&("PU_STR_BANG")
  stringSlashLblIdx = tiraLabelCreateNewId&("PU_STR_SLASH")
  stringSlashTopLblIdx = tiraLabelCreateNewId&("PU_STR_SLASH_LOOP")
  stringSlashCloseLblIdx = tiraLabelCreateNewId&("PU_STR_SLASH_CLOSE")
  stringValidLblIdx = tiraLabelCreateNewId&("PU_STR_VALID")
  stringWholeLblIdx = tiraLabelCreateNewId&("PU_STR_WHOLE")
  stringFirstLblIdx = tiraLabelCreateNewId&("PU_STR_FIRST")
  stringFirstReadyLblIdx = tiraLabelCreateNewId&("PU_STR_FIRST_READY")
  stringFixedLblIdx = tiraLabelCreateNewId&("PU_STR_FIXED")
  stringCopyReadyLblIdx = tiraLabelCreateNewId&("PU_STR_COPY_READY")
  stringDoneLblIdx = tiraLabelCreateNewId&("PU_STR_DONE")

  literalLblIdx = tiraLabelCreateNewId&("PU_LITERAL")
  literalReadyLblIdx = tiraLabelCreateNewId&("PU_LITERAL_READY")

  numberSignedLblIdx = tiraLabelCreateNewId&("PU_SIGNED")
  numberSignedReadyLblIdx = tiraLabelCreateNewId&("PU_SIGNED_READY")
