  stringLengthIdx = tiraDimVarId&("T", TYPE_LONG)
  stringCopyCountIdx = tiraDimVarId&("T", TYPE_LONG)
  stringFieldPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  scratchBaseIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1024)
  rawPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId rawPtrIdx, TIRA_ARG_SYMBOL, scratchBaseIdx

  digitsPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, digitsPtrIdx, TIRA_ARG_SYMBOL, scratchBaseIdx, TIRA_ARG_LITERAL, 128

  fieldPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fieldPtrIdx, TIRA_ARG_SYMBOL, scratchBaseIdx, TIRA_ARG_LITERAL, 256

  outDescIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outDescIdx, TIRA_ARG_SYMBOL, scratchBaseIdx, TIRA_ARG_LITERAL, 992

  signedFormatLiteralIdx = tiraStringLiteralId&("%I64d")
  IF signedFormatLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  signedFormatPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, signedFormatLiteralIdx)

  unsignedFormatLiteralIdx = tiraStringLiteralId&("%I64u")
  IF unsignedFormatLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  unsignedFormatPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, unsignedFormatLiteralIdx)

  floatFormatLiteralIdx = tiraStringLiteralId&("% .25E")
  IF floatFormatLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  floatFormatPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, floatFormatLiteralIdx)

  exponentFormatLiteralIdx = tiraStringLiteralId&("%d")
  IF exponentFormatLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  exponentFormatPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, exponentFormatLiteralIdx)

  rawLengthIdx = tiraDimVarId&("T", TYPE_LONG)
  digitCountIdx = tiraDimVarId&("T", TYPE_LONG)
  decimalAdjustIdx = tiraDimVarId&("T", TYPE_LONG)
  isNegativeIdx = tiraDimVarId&("T", TYPE_LONG)
  digitSourceIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  rawIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  digitAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  digitByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  exponentNegativeIdx = tiraDimVarId&("T", TYPE_LONG)
  exponentValueIdx = tiraDimVarId&("T", TYPE_LONG)
  sawDigitIdx = tiraDimVarId&("T", TYPE_LONG)
