END FUNCTION ' parse_MKS$

''''''''''''''''''''''''
FUNCTION parse_MOUSEBUTTON$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM lblB2$
  DIM lblB3$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_MOUSEBUTTON", 3) = 0 THEN
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEBUTTON REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("MOUSEBUTTON", "_VAL")
  IF scratchName$ = "" THEN
    parse_MOUSEBUTTON$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  lblB2$ = tiraLabelCreateNew$("MB_2")
  lblB3$ = tiraLabelCreateNew$("MB_3")
  lblEnd$ = tiraLabelCreateNew$("MB_END")

  tiraJmpCond "JE", arg1$, "2", lblB2$
  tiraJmpCond "JE", arg1$, "3", lblB3$
  tiraAssign resVar$, "!G_INO_VAL_MOUSE_B1"
  tiraJmp lblEnd$

  tiraLabel lblB2$
  tiraAssign resVar$, "!G_INO_VAL_MOUSE_B2"
  tiraJmp lblEnd$

  tiraLabel lblB3$
  tiraAssign resVar$, "!G_INO_VAL_MOUSE_B3"

  tiraLabel lblEnd$
  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEBUTTON$ = scratchName$

END FUNCTION ' parse_MOUSEBUTTON$

''''''''''''''''''''''''
FUNCTION parse_MOUSEINPUT$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _MOUSEINPUT", ASIS, 0
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEINPUT REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("MOUSEINPUT", "_VAL")
  IF scratchName$ = "" THEN
    parse_MOUSEINPUT$ = ""
    EXIT FUNCTION
  END IF

  tiraCall "RT_MOUSEINPUT", 0, ""

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEINPUT$ = scratchName$

END FUNCTION ' parse_MOUSEINPUT$

''''''''''''''''''''''''
FUNCTION parse_MOUSEX$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _MOUSEX", ASIS, 0
    parse_MOUSEX$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEX REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEX$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("MOUSEX", "_VAL")
  IF scratchName$ = "" THEN
    parse_MOUSEX$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign resVar$, "!G_INO_VAL_MOUSE_X"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEX$ = scratchName$

END FUNCTION ' parse_MOUSEX$

''''''''''''''''''''''''
FUNCTION parse_MOUSEY$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _MOUSEY", ASIS, 0
    parse_MOUSEY$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEY REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEY$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("MOUSEY", "_VAL")
  IF scratchName$ = "" THEN
    parse_MOUSEY$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign resVar$, "!G_INO_VAL_MOUSE_Y"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEY$ = scratchName$

END FUNCTION ' parse_MOUSEY$

''''''''''''''''''''''''
FUNCTION parse_MOUSEWHEEL$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _MOUSEWHEEL", ASIS, 0
    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_MOUSEWHEEL REQUIRES #GRAPHICS", ASIS, 0
    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("MOUSEWHEEL", "_VAL")
  IF scratchName$ = "" THEN
    parse_MOUSEWHEEL$ = ""
    EXIT FUNCTION
  END IF

  tiraAssign scratchName$, "!G_INO_VAL_MOUSE_SCRL"

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_MOUSEWHEEL$ = scratchName$

END FUNCTION ' parse_MOUSEWHEEL$

''''''''''''''''''''''''
FUNCTION parse_NEWIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM arg3$
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM resVar$
  DIM isScreenImage AS LONG
  DIM rectLow$
  DIM rectHigh$
  DIM rectPtr$
  DIM rectLeft$
  DIM rectTop$
  DIM rectRight$
  DIM rectBottom$
  DIM outerWidth$
  DIM outerHeight$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_NEWIMAGE", 5) = 0 THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_NEWIMAGE REQUIRES AT LEAST 2 ARGUMENTS", ASIS, 0
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "WIDTH MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    arg2$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF

    arg3$ = tiraParseExpressionInt$(comma2 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF arg3$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "HEIGHT MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_NEWIMAGE$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("NEWIMG", "_VAL")
  IF scratchName$ = "" THEN
    parse_NEWIMAGE$ = ""
    EXIT FUNCTION
  END IF

  isScreenImage = 0
  IF startIdx > 0 THEN
    IF lineTokenVals(startIdx - 1) = TOK_SCREEN THEN isScreenImage = 1
  END IF

  ' Page 2 is the current backing surface used for independently created images
  ' Preserve its requested dimensions unless this image is being handed directly to SCREEN
  IF isScreenImage = 0 THEN
    tiraAssign "!G_GFX_V32_PAGE2W", arg1$
    tiraAssign "!G_GFX_V32_PAGE2H", arg2$
  ELSE
    ' A new SCREEN returns its later windowed form to native 1x sizing
    tiraAssign "!G_GFX_FLG_GDOUBLE", "0"

    fullscreenScreenLbl$ = tiraLabelCreateNew$("SCREEN_FULLSCREEN")
    screenResizeDoneLbl$ = tiraLabelCreateNew$("SCREEN_RESIZE_DONE")

    ' Preserve fullscreen while changing only its logical SCREEN dimensions
    tiraJmpCond "JE", "!G_GFX_VAL_IS_FULLSCREEN", "1", fullscreenScreenLbl$

    ' Two adjacent 64-bit temporaries provide the 16-byte RECT required by AdjustWindowRectEx
    rectLow$ = tiraDimVar$("SCREENRECTLOW", TYPE_INTEGER64)
    rectHigh$ = tiraDimVar$("SCREENRECTHIGH", TYPE_INTEGER64)
    tiraAssign rectLow$, "0"
    tiraAssign rectHigh$, "0"

    rectPtr$ = tiraDimVar$("SCREENRECTPTR", TYPE_INTEGER64)
    ' User-code temporaries grow upward, so the first temporary is the RECT base
    tiraOp TC_ADDRESS_OF, rectPtr$, rectLow$, ""

    ' RECT.Right and RECT.Bottom receive the requested client dimensions
    tiraNew TC_WRITE_MEM_OFFSET, rectPtr$ + ", 8, " + arg1$ + ", 4"
    tiraNew TC_WRITE_MEM_OFFSET, rectPtr$ + ", 12, " + arg2$ + ", 4"

    ' SCREEN creates a normal window before calculating the required outer dimensions
    tiraCall "IAT_SETWINDOWLONGA", 3, "!G_WND_VAL_HWND, -16, 13565952"
    tiraCall "IAT_ADJUSTWINDOWRECTEX", 4, rectPtr$ + ", 13565952, 0, 0"

    rectLeft$ = tiraDimVar$("SCREENRECTLEFT", TYPE_LONG)
    tiraNew TC_READ_MEM, rectLeft$ + ", " + rectPtr$

    rectTop$ = tiraDimVar$("SCREENRECTTOP", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, rectTop$ + ", " + rectPtr$ + ", 4"

    rectRight$ = tiraDimVar$("SCREENRECTRIGHT", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, rectRight$ + ", " + rectPtr$ + ", 8"

    rectBottom$ = tiraDimVar$("SCREENRECTBOTTOM", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, rectBottom$ + ", " + rectPtr$ + ", 12"

    outerWidth$ = tiraDimVar$("SCREENOUTERWIDTH", TYPE_LONG)
    tiraOp TC_SUB, outerWidth$, rectRight$, rectLeft$

    outerHeight$ = tiraDimVar$("SCREENOUTERHEIGHT", TYPE_LONG)
    tiraOp TC_SUB, outerHeight$, rectBottom$, rectTop$

    ' HWND_NOTOPMOST with SWP_NOMOVE, SWP_FRAMECHANGED and SWP_SHOWWINDOW
    tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, -2, 0, 0, " + outerWidth$ + ", " + outerHeight$ + ", 98"

    ' Correct each outer dimension from the actual client size reported by WM_SIZE
    widthCorrection$ = tiraDimVar$("SCREENWIDTHCORRECTION", TYPE_LONG)
    tiraOp TC_SUB, widthCorrection$, arg1$, "!G_WND_VAL_WIDTH"
    tiraOp TC_ADD, outerWidth$, outerWidth$, widthCorrection$

    heightCorrection$ = tiraDimVar$("SCREENHEIGHTCORRECTION", TYPE_LONG)
    tiraOp TC_SUB, heightCorrection$, arg2$, "!G_WND_VAL_HEIGHT"
    tiraOp TC_ADD, outerHeight$, outerHeight$, heightCorrection$

    tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, -2, 0, 0, " + outerWidth$ + ", " + outerHeight$ + ", 98"

    tiraJmp screenResizeDoneLbl$

    tiraLabel fullscreenScreenLbl$

    ' Keep fullscreen mouse and rendering scale tied to physical desktop pixels
    tiraCall "IAT_GETSYSTEMMETRICS", 1, "0"
    tiraNew TC_GET_RET, "!G_WND_VAL_WIDTH"

    tiraCall "IAT_GETSYSTEMMETRICS", 1, "1"
    tiraNew TC_GET_RET, "!G_WND_VAL_HEIGHT"

    tiraLabel screenResizeDoneLbl$

    ' Preserve the active SCREEN coordinate space independently from fullscreen sizing
    tiraAssign "!G_GFX_V32_SCRNW", arg1$
    tiraAssign "!G_GFX_V32_SCRNH", arg2$
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "2"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_NEWIMAGE$ = scratchName$

END FUNCTION ' parse_NEWIMAGE$

''''''''''''''''''''''''
FUNCTION parse_PAINT (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM fillEnd AS LONG
  DIM coordinateEnd AS LONG
  DIM hasFill AS LONG
  DIM hasBorder AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  hasStep = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      hasStep = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  coordinateEnd = endIdx
  hasFill = 0
  hasBorder = 0

  IF comma1 > 0 THEN
    coordinateEnd = comma1 - 1
    comma2 = findComma(comma1 + 1, endIdx)

    fillEnd = endIdx
    IF comma2 > 0 THEN fillEnd = comma2 - 1

    IF comma1 + 1 <= fillEnd THEN hasFill = 1

    IF comma2 > 0 THEN
      IF comma2 + 1 <= endIdx THEN hasBorder = 1
    END IF
  END IF

  cComma = retCoordinateBoundaries(tokIdx, coordinateEnd)
  IF cComma = 0 THEN
    throwCompilerError "PAINT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  xVar$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF xVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  yVar$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF yVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    stepX$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, stepX$, "!G_GFX_VAL_CUR_X", xVar$
    xVar$ = stepX$

    stepY$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, stepY$, "!G_GFX_VAL_CUR_Y", yVar$
    yVar$ = stepY$
  END IF

  fillIsStr$ = tiraDimVar$("T", TYPE_LONG)

  IF hasFill = 1 THEN
    fillVar$ = tiraParseExpression$(comma1 + 1, fillEnd, ALIM)
    IF fillVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    IF exprIs.DataType = TYPE_STRING THEN
      tiraAssign fillIsStr$, "1"
    ELSE
      tiraAssign fillIsStr$, "0"
    END IF
  ELSE
    fillVar$ = "!G_GFX_VAL_FG"
    tiraAssign fillIsStr$, "0"
  END IF

  IF hasBorder = 1 THEN
    borderVar$ = tiraParseExpressionInt$(comma2 + 1, endIdx, ALIM, "BORDER COLOR MUST BE NUMERIC")
    IF borderVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  ELSE
    borderVar$ = tiraDimVar$("T", TYPE_LONG)
    lblDefBorder$ = tiraLabelCreateNew$("DEF_BORDER")
    lblBorderDone$ = tiraLabelCreateNew$("BORDER_DONE")

    tiraJmpCond "JE", fillIsStr$, "1", lblDefBorder$
    tiraAssign borderVar$, fillVar$
    tiraJmp lblBorderDone$
    tiraLabel lblDefBorder$
    tiraAssign borderVar$, "!G_GFX_VAL_FG"
    tiraLabel lblBorderDone$
  END IF

  ' Update graphics tracking coordinates
  tiraAssign "!G_GFX_VAL_CUR_X", xVar$
  tiraAssign "!G_GFX_VAL_CUR_Y", yVar$

  tiraCall "RT_PAINT", 5, xVar$ + ", " + yVar$ + ", " + fillVar$ + ", " + fillIsStr$ + ", " + borderVar$

  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PAINT = 1

END FUNCTION ' parse_PAINT

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR (startIdx)

  DIM comma1 AS LONG
  DIM idxVar$
  DIM colorVar$
  DIM skipLbl$
  DIM palDescPtr$
  DIM palDataAddr$
  DIM offsetVar$
  DIM targetAddr$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  idxVar$ = tiraParseExpressionInt$(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF idxVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  colorVar$ = tiraParseExpressionInt$(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF colorVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  skipLbl$ = tiraLabelCreateNew$("SKIP_PAL")

  tiraJmpCond "JL", idxVar$, "0", skipLbl$
  tiraJmpCond "JG", idxVar$, "255", skipLbl$

  palDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign palDescPtr$, "!G_GFX_DSC_PALETTE"

  palDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, palDataAddr$ + ", " + palDescPtr$

  offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, offsetVar$, idxVar$, "4"

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palDataAddr$, offsetVar$

  tiraWriteMem targetAddr$, colorVar$, "4"

  tiraTriggerAutoDisplay

  tiraLabel skipLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PALETTECOLOR = 1

END FUNCTION ' parse_PALETTECOLOR

''''''''''''''''''''''''
FUNCTION parse_PALETTECOLOR_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM palDescPtr$
  DIM palDataAddr$
  DIM offsetVar$
  DIM targetAddr$
  DIM skipLbl$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_PALETTECOLOR", 3) = 0 THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PALETTECOLOR REQUIRES #GRAPHICS", ASIS, 0
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INDEX MUST BE NUMERIC")
  IF arg1$ = "" THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("PALCOL", "_VAL")
  IF scratchName$ = "" THEN
    parse_PALETTECOLOR_FUNC$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  skipLbl$ = tiraLabelCreateNew$("SKIP_PALCOL")

  tiraJmpCond "JL", arg1$, "0", skipLbl$
  tiraJmpCond "JG", arg1$, "255", skipLbl$

  palDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign palDescPtr$, "!G_GFX_DSC_PALETTE"

  palDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, palDataAddr$ + ", " + palDescPtr$

  offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, offsetVar$, arg1$, "4"

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, palDataAddr$, offsetVar$

  tiraNew TC_READ_MEM, resVar$ + ", " + targetAddr$

  tiraLabel skipLbl$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_PALETTECOLOR_FUNC$ = scratchName$

END FUNCTION ' parse_PALETTECOLOR_FUNC$

''''''''''''''''''''''''
FUNCTION parse_POINT$ (startIdx, endIdx, allowImplicit)

  DIM comma1 AS LONG
  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM resVar$
  DIM skipLbl$
  DIM offsetVar$
  DIM targetAddr$
  DIM colorByte$
  DIM lblX$
  DIM lblY$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "POINT", 3) = 0 THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "POINT REQUIRES #GRAPHICS", ASIS, 0
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  scratchName$ = tiraResolveHoistVar$("POINT", "_VAL")
  IF scratchName$ = "" THEN
    parse_POINT$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "-1"

  IF comma1 = 0 THEN
    ' 1 argument: POINT(n)
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "POINT ARGUMENT MUST BE NUMERIC")
    IF arg1$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    lblX$ = tiraLabelCreateNew$("PT_X")
    lblY$ = tiraLabelCreateNew$("PT_Y")
    lblEnd$ = tiraLabelCreateNew$("PT_END")

    tiraJmpCond "JE", arg1$, "0", lblX$
    tiraJmpCond "JE", arg1$, "2", lblX$
    tiraJmpCond "JE", arg1$, "1", lblY$
    tiraJmpCond "JE", arg1$, "3", lblY$
    tiraJmp lblEnd$

    tiraLabel lblX$
    tiraAssign resVar$, "!G_GFX_VAL_CUR_X"
    tiraJmp lblEnd$

    tiraLabel lblY$
    tiraAssign resVar$, "!G_GFX_VAL_CUR_Y"
    tiraLabel lblEnd$

  ELSE
    ' 2 arguments: POINT(x, y)
    arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "COORDINATE MUST BE NUMERIC")
    IF arg2$ = "" THEN
      parse_POINT$ = ""
      EXIT FUNCTION
    END IF

    skipLbl$ = tiraLabelCreateNew$("PT_SKIP")

    ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
    tiraJmpCond "JAE", arg1$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), skipLbl$
    tiraJmpCond "JAE", arg2$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), skipLbl$

    offsetVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, offsetVar$, arg2$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
    tiraOp TC_ADD, offsetVar$, offsetVar$, arg1$

    targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, targetAddr$, "!G_GFX_PTR_SRC_FRMB", offsetVar$

    colorByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, colorByte$ + ", " + targetAddr$

    tiraAssign resVar$, colorByte$

    tiraLabel skipLbl$
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_POINT$ = scratchName$

END FUNCTION ' parse_POINT$

''''''''''''''''''''''''
FUNCTION parse_PRINTSTRING (startIdx)

  DIM endIdx AS LONG
  DIM coordStart AS LONG
  DIM isParen AS LONG
  DIM commaText AS LONG
  DIM commaExtra AS LONG
  DIM cStartCoord AS LONG
  DIM cEndCoord AS LONG
  DIM textStart AS LONG
  DIM textEnd AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG
  DIM xVar$
  DIM yVar$
  DIM textVar$
  DIM colorVar$
  DIM strData$
  DIM strLen$

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PRINTSTRING REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  coordStart = startIdx + 1
  IF coordStart > endIdx THEN
    throwCompilerError "EXPECTED (X, Y) AFTER _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF

  isParen = 0
  IF lineTokenVals(coordStart) = 256 + ASC("(") THEN isParen = 1

  IF isParen = 0 THEN
    throwCompilerError "_PRINTSTRING EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(coordStart, endIdx)
  IF ff = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF
  cEndCoord = returnedData2
  cStartCoord = coordStart

  commaText = findComma(cEndCoord + 1, endIdx)
  IF commaText = 0 THEN
    throwCompilerError "_PRINTSTRING EXPECTS COMMA AFTER COORDINATES", ASIS, 0
    EXIT FUNCTION
  END IF

  textStart = commaText + 1
  textEnd = endIdx

  commaExtra = findComma(textStart, endIdx)
  IF commaExtra > 0 THEN
    throwCompilerError "_PRINTSTRING DOES NOT ACCEPT A COLOR ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(cStartCoord, cEndCoord)
  IF cComma = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN _PRINTSTRING", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  xVar$ = tiraParseExpressionInt$(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF xVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  yVar$ = tiraParseExpressionInt$(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF yVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  textVar$ = tiraParseExpression$(textStart, textEnd, ALIM)
  IF textVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_PRINTSTRING EXPECTS STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  colorVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign colorVar$, "!G_GFX_VAL_FG"

  strData$ = tiraGetStringData$(textVar$)
  strLen$ = tiraGetStringLen$(textVar$)

  tiraCall "RT_DRAW_TEXT_ABSOLUTE", 5, strData$ + ", " + strLen$ + ", " + xVar$ + ", " + yVar$ + ", " + colorVar$
  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PRINTSTRING = 1

END FUNCTION ' parse_PRINTSTRING

''''''''''''''''''''''''
FUNCTION parse_PRINT_USING (startIdx, usingIdx)

  DIM endIdx AS LONG
  DIM prefixStart AS LONG
  DIM prefixEnd AS LONG
  DIM prefixSeparator AS LONG
  DIM templateStart AS LONG
  DIM templateEnd AS LONG
  DIM templateSeparator AS LONG
  DIM valueStart AS LONG
  DIM valueEnd AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM parenDepth AS LONG
  DIM tokenVal AS LONG
  DIM trailingSeparator AS LONG
  DIM valueType AS LONG

  endIdx = lineTokenCount - 1

  prefixStart = startIdx + 1
  prefixEnd = usingIdx - 1
  prefixSeparator = 0

  IF prefixEnd >= prefixStart THEN
    tokenVal = lineTokenVals(prefixEnd)
    IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
      prefixSeparator = tokenVal
      prefixEnd = prefixEnd - 1
    END IF
  END IF

  IF prefixSeparator <> 0 AND prefixEnd < prefixStart THEN
    throwCompilerError "PRINT USING HAS AN EMPTY LEADING ITEM", ASIS, 0
    EXIT FUNCTION
  END IF

  templateStart = usingIdx + 1
  IF templateStart > endIdx THEN
    throwCompilerError "PRINT USING REQUIRES A TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  templateSeparator = 0
  parenDepth = 0
  FOR ii = templateStart TO endIdx
    tokenVal = lineTokenVals(ii)
    IF tokenVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
    IF tokenVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1
    IF parenDepth = 0 THEN
      IF tokenVal = 256 + ASC(",") THEN
        throwCompilerError "PRINT USING REQUIRES ; AFTER THE TEMPLATE", ASIS, 0
        EXIT FUNCTION
      END IF
      IF tokenVal = 256 + ASC(";") THEN
        templateSeparator = ii
        EXIT FOR
      END IF
    END IF
  NEXT

  IF templateSeparator = 0 THEN
    throwCompilerError "PRINT USING REQUIRES ; AFTER THE TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  templateEnd = templateSeparator - 1
  IF templateEnd < templateStart THEN
    throwCompilerError "PRINT USING REQUIRES A TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  valueStart = templateSeparator + 1
  IF valueStart > endIdx THEN
    throwCompilerError "PRINT USING REQUIRES AT LEAST ONE VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  trailingSeparator = 0
  valueEnd = endIdx
  tokenVal = lineTokenVals(valueEnd)
  IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
    trailingSeparator = tokenVal
    valueEnd = valueEnd - 1
  END IF

  IF valueEnd < valueStart THEN
    throwCompilerError "PRINT USING REQUIRES AT LEAST ONE VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tokenVal = lineTokenVals(valueEnd)
  IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
    throwCompilerError "PRINT USING HAS AN EMPTY VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF prefixEnd >= prefixStart THEN
    prefixVar$ = tiraParseExpression$(prefixStart, prefixEnd, ALIM)
    IF prefixVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "TEXT BEFORE USING MUST BE A STRING", ASIS, 0
      EXIT FUNCTION
    END IF

    tiraCall "RT_PRINT_STR", 1, prefixVar$

    IF prefixSeparator = 256 + ASC(",") THEN
      tiraPrintUsingCommaZone
    END IF
  END IF

  templateVar$ = tiraParseExpression$(templateStart, templateEnd, ALIM)
  IF templateVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "PRINT USING TEMPLATE MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  templateData$ = tiraGetStringData$(templateVar$)
  templateLen$ = tiraGetStringLen$(templateVar$)
  templateCopyData$ = tiraAllocTempMem$(templateLen$)
  tiraMemcpy templateCopyData$, templateData$, templateLen$

  templateCopyDesc$ = tiraAllocTempMem$("24")
  tiraBuildStrDesc templateCopyDesc$, templateCopyData$, templateLen$, "0"

  formatPos$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign formatPos$, "0"

  formatPosPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, formatPosPtr$, formatPos$, ""

  zeroInt$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign zeroInt$, "0"

  zeroDouble$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign zeroDouble$, "0"

  itemStart = valueStart
  DO WHILE itemStart <= valueEnd
    itemEnd = valueEnd
    parenDepth = 0

    FOR ii = itemStart TO valueEnd
      tokenVal = lineTokenVals(ii)
      IF tokenVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
      IF tokenVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

      IF parenDepth = 0 THEN
        IF tokenVal = 256 + ASC(",") THEN
          throwCompilerErrorAndCancelTira "PRINT USING VALUES MUST BE SEPARATED BY ;", ASIS, 0
          EXIT FUNCTION
        END IF

        IF tokenVal = 256 + ASC(";") THEN
          itemEnd = ii - 1
          EXIT FOR
        END IF
      END IF
    NEXT

    IF itemEnd < itemStart THEN
      throwCompilerErrorAndCancelTira "PRINT USING HAS AN EMPTY VALUE", ASIS, 0
      EXIT FUNCTION
    END IF

    exprVar$ = tiraParseExpression$(itemStart, itemEnd, ALIM)
    IF exprVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    valueType = exprIs.DataType

    IF valueType = TYPE_STRING THEN
      tiraCall "RT_PRINT_USING", 6, templateCopyDesc$ + ", " + formatPosPtr$ + ", 5, " + zeroInt$ + ", " + zeroDouble$ + ", " + exprVar$
    ELSE
      IF valueType = TYPE_SINGLE OR valueType = TYPE_DOUBLE THEN
        IF valueType = TYPE_SINGLE THEN
          castVar$ = tiraDimVar$("T", TYPE_DOUBLE)
          tiraOp TC_CAST, castVar$, exprVar$, LTRIM$(STR$(TYPE_DOUBLE))
          exprVar$ = castVar$
          tiraCall "RT_PRINT_USING", 6, templateCopyDesc$ + ", " + formatPosPtr$ + ", 3, " + zeroInt$ + ", " + exprVar$ + ", 0"
        ELSE
          tiraCall "RT_PRINT_USING", 6, templateCopyDesc$ + ", " + formatPosPtr$ + ", 4, " + zeroInt$ + ", " + exprVar$ + ", 0"
        END IF
      ELSE
        IF valueType = TYPE_UBYTE OR valueType = TYPE_UINTEGER OR valueType = TYPE_ULONG OR valueType = TYPE_UINT64 THEN
          tiraCall "RT_PRINT_USING", 6, templateCopyDesc$ + ", " + formatPosPtr$ + ", 2, " + exprVar$ + ", " + zeroDouble$ + ", 0"
        ELSE
          IF valueType = TYPE_BYTE OR valueType = TYPE_INTEGER OR valueType = TYPE_LONG OR valueType = TYPE_INTEGER64 THEN
            tiraCall "RT_PRINT_USING", 6, templateCopyDesc$ + ", " + formatPosPtr$ + ", 1, " + exprVar$ + ", " + zeroDouble$ + ", 0"
          ELSE
            throwCompilerErrorAndCancelTira "PRINT USING VALUE MUST BE STRING OR NUMERIC", ASIS, 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF

    itemStart = itemEnd + 2
  LOOP

  IF trailingSeparator = 256 + ASC(",") THEN
    tiraPrintUsingCommaZone
  ELSE
    IF trailingSeparator = 0 THEN
      tiraCall "RT_CRLF", 0, ""
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PRINT_USING = 1

END FUNCTION ' parse_PRINT_USING

''''''''''''''''''''''''
FUNCTION parse_RANDOMIZE (startIdx)

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED NUMERIC ARGUMENT AFTER RANDOMIZE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  argVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "RANDOMIZE REQUIRES NUMERIC ARGUMENT")
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraCall "IAT_SRAND", 1, argVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_RANDOMIZE = 1

END FUNCTION ' parse_RANDOMIZE

''''''''''''''''''''''''
FUNCTION parse_RESTORE (startIdx)

' Resets the internal data pointer to the beginning of a specific DATA label

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx < startIdx + 1 THEN
    tiraAssign "!G_SYS_VAL_DATAINDEX", "0"
  ELSE
    lblTok$ = lineTokens$(startIdx + 1)
    lblName$ = "%" + UCASE$(lblTok$)
    expectedSymType = TYPE_LABEL
    ff = resolveSymbol(lblName$)
    IF ff = 1 THEN
      vIdx = returnedData2
      idxVal = symbols(vIdx).DataIndex
      tiraAssign "!G_SYS_VAL_DATAINDEX", LTRIM$(STR$(idxVal))
    ELSE
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_RESTORE = 1

END FUNCTION ' parse_RESTORE

''''''''''''''''''''''''
FUNCTION parse_RESUME (startIdx)

' Returns execution to the line that triggered the active error handler

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start
  tiraScheduleHeapReset
  tiraNew TC_RESUME, ""
  tira_EndAndProcess

  parse_RESUME = 1

END FUNCTION ' parse_RESUME

''''''''''''''''''''''''
FUNCTION parse_RIGHT$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM srcPtr$
  DIM strLen$
  DIM safeLen$
  DIM srcOffset$
  DIM dataPtr$
  DIM descPtr$
  DIM comma1 AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "RIGHT$", 5) = 0 THEN
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "RIGHT$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, comma1 - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "RIGHT$ ARG 1 MUST BE STRING", ASIS, 0
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "RIGHT$ ARG 2 MUST BE NUMERIC")
  IF arg2$ = "" THEN
    tira_Cancel
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("RIGHT", "_DSC")
  IF scratchName$ = "" THEN
    parse_RIGHT$ = ""
    EXIT FUNCTION
  END IF

  srcPtr$ = tiraGetStringData$(arg1$)
  strLen$ = tiraGetStringLen$(arg1$)

  safeLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign safeLen$, arg2$
  tiraClamp safeLen$, "0", strLen$

  srcOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, srcOffset$, strLen$, safeLen$
  tiraOp TC_ADD, srcPtr$, srcPtr$, srcOffset$

  tiraAssign strLen$, safeLen$

  dataPtr$ = tiraAllocTempMem$(strLen$)

  tiraMemcpy dataPtr$, srcPtr$, strLen$

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, strLen$, "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_RIGHT$ = scratchName$

END FUNCTION ' parse_RIGHT$

''''''''''''''''''''''''
FUNCTION parse_RND$ (startIdx, endIdx, allowImplicit)

  ' Returns a random single-precision floating point number

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM dblRes$
  DIM maxVal$
  DIM finalDbl$
  DIM singleRes$

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED RND", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
    IF arg1$ = "" THEN
      tira_Cancel
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType = TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES NUMERIC", ASIS, 0
      parse_RND$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("RND", "_VAL")
  IF scratchName$ = "" THEN
    parse_RND$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  tiraCall "IAT_RAND", 0, ""
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, resVar$

  dblRes$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_CAST, dblRes$, resVar$, LTRIM$(STR$(TYPE_DOUBLE))

  maxVal$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign maxVal$, "32767.0#"

  finalDbl$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_DIV, finalDbl$, dblRes$, maxVal$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, finalDbl$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_RND$ = scratchName$

END FUNCTION ' parse_RND$

''''''''''''''''''''''''
FUNCTION parse_RUN (startIdx)

  DIM endIdx AS LONG
  DIM imagePath$
  DIM imageLength$
  DIM pathEnd$
  DIM startupInfo$
  DIM processInfo$
  DIM createResult$
  DIM processHandle$
  DIM threadHandle$
  DIM pathFoundLbl$
  DIM pathReadyLbl$
  DIM processReadyLbl$

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "RUN")
  IF ff = 0 THEN EXIT FUNCTION

  ' Reuse CLOSE with no file numbers so buffered output is written and every BASIC file handle is released
  ff = parse_CLOSE(startIdx)
  IF ff = 0 OR compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ' Get the exact path of the running executable
  imagePath$ = tiraAllocTempMem$("32768")

  tiraCall "IAT_GETMODULEFILENAMEA", 3, "0, " + imagePath$ + ", 32768"
  imageLength$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, imageLength$

  pathFoundLbl$ = tiraLabelCreateNew$("RUN_PATH_FOUND")
  tiraJmpCond "JNE", imageLength$, "0", pathFoundLbl$
  tiraFatalError "RUN COULD NOT LOCATE EXECUTABLE"
  tiraLabel pathFoundLbl$

  pathReadyLbl$ = tiraLabelCreateNew$("RUN_PATH_READY")
  tiraJmpCond "JL", imageLength$, "32768", pathReadyLbl$
  tiraFatalError "RUN EXECUTABLE PATH IS TOO LONG"
  tiraLabel pathReadyLbl$

  ' Terminate the path explicitly inside the validated buffer
  pathEnd$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, pathEnd$, imagePath$, imageLength$
  tiraWriteMem pathEnd$, "0", "1"

  ' STARTUPINFOA is 104 bytes and PROCESS_INFORMATION is 24 bytes on Win64
  startupInfo$ = tiraAllocTempMem$("104")
  processInfo$ = tiraAllocTempMem$("24")

  ' STARTUPINFOA.cb
  tiraWriteMem startupInfo$, "104", "4"

  tiraCall "IAT_CREATEPROCESSA", 10, imagePath$ + ", 0, 0, 0, 0, 0, 0, 0, " + startupInfo$ + ", " + processInfo$
  createResult$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, createResult$

  processReadyLbl$ = tiraLabelCreateNew$("RUN_PROCESS_READY")
  tiraJmpCond "JNE", createResult$, "0", processReadyLbl$
  tiraFatalError "RUN COULD NOT START EXECUTABLE"
  tiraLabel processReadyLbl$

  ' The replacement process continues independently after its returned handles are closed
  processHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, processHandle$ + ", " + processInfo$

  threadHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM_OFFSET, threadHandle$ + ", " + processInfo$ + ", 8"

  tiraCall "IAT_CLOSEHANDLE", 1, threadHandle$
  tiraCall "IAT_CLOSEHANDLE", 1, processHandle$

  ' Bypass the normal pause epilogue because RUN is an immediate restart
  tiraCall "IAT_EXITPROCESS", 1, "0"

  tira_EndAndProcess

  parse_RUN = 1

END FUNCTION ' parse_RUN

''''''''''''''''''''''''
FUNCTION parse_SCREENICON (startIdx)

  ' Sets the window icon for the graphical display

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_SCREENICON REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx > startIdx THEN
    throwCompilerError "_SCREENICON DOES NOT TAKE ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  tiraCall "IAT_SHOWWINDOW", 2, "!G_WND_VAL_HWND, 6"

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SCREENICON = 1

END FUNCTION ' parse_SCREENICON

''''''''''''''''''''''''
FUNCTION parse_SCREENEXISTS$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SCREENEXISTS", ASIS, 0
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("SCREX", "_VAL")
  IF scratchName$ = "" THEN
    parse_SCREENEXISTS$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  ' Evaluates the window readiness spinlock to determine if the screen exists
  ' Console windows are always considered ready
  IF cm.HasGraphics = 1 THEN
    tiraOp TC_NEG, resVar$, "!G_WND_FLG_READY", ""
  ELSE
    tiraAssign resVar$, "-1"
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SCREENEXISTS$ = scratchName$

END FUNCTION ' parse_SCREENEXISTS$

''''''''''''''''''''''''
FUNCTION parse_SGN$ (startIdx, endIdx, allowImplicit)

' Evaluates a numeric value and returns its mathematical sign as positive, negative, or zero

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM lblPos$
  DIM lblEnd$

  IF checkIntrinsicSyntax(startIdx, endIdx, "SGN", 3) = 0 THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("SGN", "_VAL")
  IF scratchName$ = "" THEN
    parse_SGN$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "0"

  lblPos$ = tiraLabelCreateNew$("SGN_POS")
  lblEnd$ = tiraLabelCreateNew$("SGN_END")

  ' TC_JMP_COND seamlessly handles float/integer mixed conditions safely using UCOMI
  tiraJmpCond "JE", arg1$, "0", lblEnd$
  tiraJmpCond "JG", arg1$, "0", lblPos$

  tiraAssign resVar$, "-1"
  tiraJmp lblEnd$

  tiraLabel lblPos$
  tiraAssign resVar$, "1"

  tiraLabel lblEnd$
  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SGN$ = scratchName$

END FUNCTION ' parse_SGN$

''''''''''''''''''''''''
FUNCTION parse_SHELL (startIdx)

  DIM endIdx AS LONG
  DIM hasHide AS LONG
  DIM hasDontWait AS LONG
  DIM cmdStart AS LONG
  DIM cmdStr$
  DIM strDataPtr$
  DIM strLen$
  DIM hideVal$
  DIM structRawPtr$
  DIM startupInfoPtr$
  DIM processInfoPtr$
  DIM cmdAllocSize$
  DIM cmdBuffer$
  DIM nullPtr$
  DIM createResult$
  DIM doneLbl$
  DIM processHandle$
  DIM threadHandle$
  DIM tokVal AS LONG

  endIdx = lineTokenCount - 1
  hasHide = 0
  hasDontWait = 0
  cmdStart = startIdx + 1

  DO WHILE cmdStart <= endIdx
    tokVal = lineTokenVals(cmdStart)

    SELECT CASE tokVal

      CASE TOK_HIDE
        hasHide = 1
        cmdStart = cmdStart + 1
      CASE TOK_DONTWAIT
        hasDontWait = 1
        cmdStart = cmdStart + 1
      CASE ELSE
        EXIT DO

    END SELECT ' tokVak

  LOOP

  IF cmdStart > endIdx THEN
    throwCompilerError "EXPECTED COMMAND STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  cmdStr$ = tiraParseExpression$(cmdStart, endIdx, ALIM)
  IF cmdStr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "COMMAND MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Extract raw pointer to our seamlessly null-terminated C string in memory
  strDataPtr$ = tiraGetStringData$(cmdStr$)

  hideVal$ = tiraDimVar$("T", TYPE_LONG)
  IF hasHide = 1 THEN
    tiraAssign hideVal$, "0" ' SW_HIDE flag
  ELSE
    tiraAssign hideVal$, "1" ' SW_SHOWNORMAL flag
  END IF

  IF hasDontWait = 1 THEN
    ' WinExec remains the asynchronous path for SHELL _DONTWAIT
    tiraCall "IAT_WINEXEC", 2, strDataPtr$ + ", " + hideVal$
  ELSE
    strLen$ = tiraGetStringLen$(cmdStr$)

    ' Reserve one aligned block for STARTUPINFOA and PROCESS_INFORMATION before the variable-length command buffer
    structRawPtr$ = tiraAllocTempMem$("135")
    startupInfoPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, startupInfoPtr$, structRawPtr$, "7"
    tiraOp TC_AND, startupInfoPtr$, startupInfoPtr$, "-8"

    processInfoPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, processInfoPtr$, startupInfoPtr$, "104"

    tiraMemSet startupInfoPtr$, "0", "128"
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 0, 104, 4" ' STARTUPINFOA.cb
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 60, 1, 4" ' STARTF_USESHOWWINDOW
    tiraNew TC_WRITE_MEM_OFFSET, startupInfoPtr$ + ", 64, " + hideVal$ + ", 2" ' STARTUPINFOA.wShowWindow

    ' CreateProcessA requires a writable null-terminated command-line buffer
    cmdAllocSize$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, cmdAllocSize$, strLen$, "1"
    cmdBuffer$ = tiraAllocTempMem$(cmdAllocSize$)
    tiraMemcpy cmdBuffer$, strDataPtr$, strLen$

    nullPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, nullPtr$, cmdBuffer$, strLen$
    tiraWriteMem nullPtr$, "0", "1"

    tiraCall "IAT_CREATEPROCESSA", 10, "0, " + cmdBuffer$ + ", 0, 0, 0, 0, 0, 0, " + startupInfoPtr$ + ", " + processInfoPtr$
    createResult$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_GET_RET, createResult$

    doneLbl$ = tiraLabelCreateNew$("SHELL_DONE")
    tiraJmpCond "JE", createResult$, "0", doneLbl$

    processHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, processHandle$ + ", " + processInfoPtr$

    threadHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM_OFFSET, threadHandle$ + ", " + processInfoPtr$ + ", 8"

    tiraCall "IAT_WAITFORSINGLEOBJECT", 2, processHandle$ + ", -1"
    tiraCall "IAT_CLOSEHANDLE", 1, processHandle$
    tiraCall "IAT_CLOSEHANDLE", 1, threadHandle$

    tiraLabel doneLbl$
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SHELL = 1

END FUNCTION ' parse_SHELL

''''''''''''''''''''''''
FUNCTION parse_SIN$ (startIdx, endIdx, allowImplicit)

' Calculates the mathematical sine of a given angle in radians

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM singleRes$
  DIM argFloat$

  IF checkIntrinsicSyntax(startIdx, endIdx, "SIN", 3) = 0 THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("SIN", "_VAL")
  IF scratchName$ = "" THEN
    parse_SIN$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
    tiraAssign argFloat$, arg1$
    arg1$ = argFloat$
  END IF

  tiraCall "IAT_SIN", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_SIN$ = scratchName$

END FUNCTION ' parse_SIN$

''''''''''''''''''''''''
FUNCTION parse_SOURCE (startIdx)

  DIM endIdx AS LONG
  DIM pageVar$
  DIM lblSrc0$
  DIM lblSrc1$
  DIM lblSrc2$
  DIM lblSrc3$
  DIM lblSrcEnd$

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_SOURCE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED PAGE NUMBER AFTER _SOURCE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  pageVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "PAGE MUST BE NUMERIC")
  IF pageVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  tiraJmpCond "JE", pageVar$, "0", lblSrc0$
  tiraJmpCond "JE", pageVar$, "1", lblSrc1$
  tiraJmpCond "JE", pageVar$, "2", lblSrc2$
  tiraJmpCond "JE", pageVar$, "3", lblSrc3$
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc0$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE1"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE1"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE1", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE2"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE2"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE2", ""
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE3"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE3"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE3", ""

  tiraLabel lblSrcEnd$
  tiraAssign "!G_GFX_VAL_SRC_PAGE", pageVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SOURCE = 1

END FUNCTION ' parse_SOURCE

''''''''''''''''''''''''
FUNCTION parse_SOURCE_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _SOURCE", ASIS, 0
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("SOURCE", "_VAL")
  IF scratchName$ = "" THEN
    parse_SOURCE_FUNC$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "!G_GFX_VAL_SRC_PAGE"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_SOURCE_FUNC$ = scratchName$

END FUNCTION ' parse_SOURCE_FUNC$

''''''''''''''''''''''''
FUNCTION parse_STOP (startIdx)

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "STOP")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  tiraJmp "@END_PROGRAM"

  tira_EndAndProcess

  parse_STOP = 1

END FUNCTION ' parse_STOP

''''''''''''''''''''''''
FUNCTION parse_STRINGFUNC$ (startIdx, endIdx, allowImplicit)

  DIM comma1 AS LONG
  DIM arg1$
  DIM arg2$
  DIM scratchName$
  DIM descPtr$
  DIM dataPtr$
  DIM charByte$
  DIM isStringChar AS LONG
  DIM strLen$
  DIM strData$
  DIM lblEmpty$
  DIM lblNotEmpty$
  DIM lblValidCount$
  DIM lblDoAlloc$
  DIM lblDone$
  DIM errStr$
  DIM tmpByte$

  IF checkIntrinsicSyntax(startIdx, endIdx, "STRING$", 5) = 0 THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "STRING$ REQUIRES TWO ARGUMENTS", ASIS, 0
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "STRING$ ARG 1 MUST BE NUMERIC")
  IF arg1$ = "" THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  expectedSymType = TYPE_ANY
  arg2$ = tiraParseExpression$(comma1 + 1, endIdx - 1, allowImplicit)
  IF arg2$ = "" THEN
    tira_Cancel
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  isStringChar = 0
  IF exprIs.DataType = TYPE_STRING THEN isStringChar = 1

  scratchName$ = tiraResolveHoistVar$("STRF", "_DSC")
  IF scratchName$ = "" THEN
    parse_STRINGFUNC$ = ""
    EXIT FUNCTION
  END IF

  lblValidCount$ = tiraLabelCreateNew$("STRF_VCNT")
  tiraJmpCond "JGE", arg1$, "0", lblValidCount$

  errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$ ON LINE " + retLineNumberStr$ + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel lblValidCount$

  charByte$ = tiraDimVar$("T", TYPE_LONG)

  IF isStringChar = 1 THEN
    strLen$ = tiraGetStringLen$(arg2$)

    lblEmpty$ = tiraLabelCreateNew$("STRF_MT")
    lblNotEmpty$ = tiraLabelCreateNew$("STRF_NMT")

    tiraJmpCond "JLE", strLen$, "0", lblEmpty$

    strData$ = tiraGetStringData$(arg2$)
    tmpByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, tmpByte$ + ", " + strData$
    tiraAssign charByte$, tmpByte$
    tiraJmp lblNotEmpty$

    tiraLabel lblEmpty$
    errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN STRING$ ON LINE " + retLineNumberStr$ + CHR$(34)
    tiraCall "RT_PRINT_STR", 1, errStr$
    tiraCall "RT_CRLF", 0, ""
    tiraJmp "@END_PROGRAM"

    tiraLabel lblNotEmpty$
  ELSE
    tiraOp TC_AND, charByte$, arg2$, "255"
  END IF

  lblDoAlloc$ = tiraLabelCreateNew$("STRF_ALLOC")
  lblDone$ = tiraLabelCreateNew$("STRF_DONE")

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  tiraJmpCond "JG", arg1$, "0", lblDoAlloc$

  tiraBuildStrDesc descPtr$, "0", "0", "0"
  tiraJmp lblDone$

  tiraLabel lblDoAlloc$
  dataPtr$ = tiraAllocTempMem$(arg1$)

  tiraMemSet dataPtr$, charByte$, arg1$

  tiraBuildStrDesc descPtr$, dataPtr$, arg1$, "0"

  tiraLabel lblDone$

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_STRINGFUNC$ = scratchName$

END FUNCTION ' parse_STRINGFUNC$

''''''''''''''''''''''''
FUNCTION parse_SYSTEM (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx > startIdx THEN
    exprVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "SYSTEM REQUIRES NUMERIC")
    IF exprVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    ff = resolveSymbol("!G_SYS_VAL_EXIT")
    IF ff = 1 THEN
      tiraAssign "!G_SYS_VAL_EXIT", exprVar$
    END IF
  END IF

  tiraJmp "@END_PROGRAM"

  tira_EndAndProcess

  parse_SYSTEM = 1

END FUNCTION ' parse_SYSTEM

''''''''''''''''''''''''
FUNCTION parse_THROWERR (startIdx)

  ' This function evaluates the THROWERR command, which replaces the legacy MEMERROR command
  ' It intentionally triggers specific compiler or runtime errors for testing the error handler subsystems
  '
  ' Arg value 0: Injects TC_MEMERROR into the TIRA queue to trigger a runtime memory access violation
  ' Arg value 1: Triggers a very long compile-time error to test multi-line status bar clicking

  DIM endIdx AS LONG
  DIM argStr$
  DIM errCode AS LONG
  DIM iLong AS LONG

  endIdx = lineTokenCount - 1

  ' Check to make sure the user provided an argument after the command
  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED ERROR CODE AFTER THROWERR", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Evaluate the argument text statically at compile time to branch the logic
  argStr$ = ""
  FOR iLong = startIdx + 1 TO endIdx
    argStr$ = argStr$ + retTokenText$(lineTokens$(iLong))
  NEXT

  argStr$ = evalMathConst$(argStr$)
  errCode = VAL(argStr$)

  IF errCode = 1 THEN
    throwCompilerError "THIS IS A DELIBERATELY LONG ERROR MESSAGE DESIGNED SPECIFICALLY TO EXCEED THE WIDTH OF THE STATUS BAR SO IT WRAPS INTO MULTIPLE LINES FOR CLICK TESTING", ASIS, 0

    tira_Start
    tiraScheduleHeapReset
    tira_EndAndProcess
  ELSE
    ' Force an immediate runtime access violation by writing to a null pointer natively via TC_MEMERROR
    tira_Start

    tiraNew TC_MEMERROR, ""

    tiraScheduleHeapReset
    tira_EndAndProcess
  END IF

  parse_THROWERR = 1

END FUNCTION ' parse_THROWERR

''''''''''''''''''''''''
FUNCTION parse_TIMER$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM tickVal$
  DIM tickDouble$
  DIM resVar$
  DIM singleRes$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED TIMER", ASIS, 0
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("TIMER", "_VAL")
  IF scratchName$ = "" THEN
    parse_TIMER$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  tiraCall "IAT_GETTICKCOUNT", 0, ""

  tickVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_GET_RET, tickVal$

  tickDouble$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_CAST, tickDouble$, tickVal$, LTRIM$(STR$(TYPE_DOUBLE))

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_DIV, resVar$, tickDouble$, "1000.0#"

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_TIMER$ = scratchName$

END FUNCTION ' parse_TIMER$

''''''''''''''''''''''''
FUNCTION parse_TRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM origPtr$
  DIM origLen$
  DIM dataPtr$
  DIM strLen$
  DIM endPtr$
  DIM loopLeftTop$
  DIM loopLeftDone$
  DIM loopRightTop$
  DIM loopRightDone$
  DIM byteVal$
  DIM isSpaceLLbl$
  DIM isSpaceRLbl$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_TRIM$", 3) = 0 THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_TRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("TRIM", "_DSC")
  IF scratchName$ = "" THEN
    parse_TRIM$ = ""
    EXIT FUNCTION
  END IF

  origPtr$ = tiraGetStringData$(arg1$)
  origLen$ = tiraGetStringLen$(arg1$)

  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign dataPtr$, origPtr$
  strLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign strLen$, origLen$

  loopLeftTop$ = tiraLabelCreateNew$("TRIM_L_LOOP")
  loopLeftDone$ = tiraLabelCreateNew$("TRIM_L_DONE")

  tiraLabel loopLeftTop$
  tiraJmpCond "JLE", strLen$, "0", loopLeftDone$

  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + dataPtr$

  isSpaceLLbl$ = tiraLabelCreateNew$("TRIM_L_IS_SPC")
  tiraJmpCond "JE", byteVal$, "32", isSpaceLLbl$
  tiraJmpCond "JNE", byteVal$, "9", loopLeftDone$
  tiraLabel isSpaceLLbl$

  tiraOp TC_ADD, dataPtr$, dataPtr$, "1"
  tiraOp TC_SUB, strLen$, strLen$, "1"
  tiraJmp loopLeftTop$

  tiraLabel loopLeftDone$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, endPtr$, dataPtr$, strLen$
  tiraOp TC_SUB, endPtr$, endPtr$, "1"

  loopRightTop$ = tiraLabelCreateNew$("TRIM_R_LOOP")
  loopRightDone$ = tiraLabelCreateNew$("TRIM_R_DONE")

  tiraLabel loopRightTop$
  tiraJmpCond "JLE", strLen$, "0", loopRightDone$

  tiraNew TC_READ_MEM, byteVal$ + ", " + endPtr$

  isSpaceRLbl$ = tiraLabelCreateNew$("TRIM_R_IS_SPC")
  tiraJmpCond "JE", byteVal$, "32", isSpaceRLbl$
  tiraJmpCond "JNE", byteVal$, "9", loopRightDone$
  tiraLabel isSpaceRLbl$

  tiraOp TC_SUB, endPtr$, endPtr$, "1"
  tiraOp TC_SUB, strLen$, strLen$, "1"
  tiraJmp loopRightTop$

  tiraLabel loopRightDone$

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$
  tiraBuildStrDesc descPtr$, dataPtr$, strLen$, "0"

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_TRIM$ = scratchName$

END FUNCTION ' parse_TRIM$

''''''''''''''''''''''''
FUNCTION parse_VIEW (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF startIdx + 1 <= endIdx THEN
    IF lineTokenVals(startIdx + 1) = TOK_PRINT THEN
      parse_VIEW = parse_VIEW_PRINT(startIdx + 2, endIdx)
      EXIT FUNCTION
    END IF
  END IF

  parse_VIEW = parse_VIEW_GRAPHICS(startIdx + 1, endIdx)

END FUNCTION ' parse_VIEW

''''''''''''''''''''''''
FUNCTION parse_VIEW_GRAPHICS (startIdx, endIdx)

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "VIEW REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF startIdx > endIdx THEN
    tiraAssign "!G_GFX_VAL_VIEW_X1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_Y1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_X2", LTRIM$(STR$(gfxConfig.SizeX))
    tiraAssign "!G_GFX_VAL_VIEW_Y2", LTRIM$(STR$(gfxConfig.SizeY))
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"

    tiraScheduleHeapReset
    tira_EndAndProcess
    parse_VIEW_GRAPHICS = 1
    EXIT FUNCTION
  END IF

  tokIdx = startIdx
  isScreen = 0
  IF lineTokenVals(tokIdx) = TOK_SCREEN THEN
    isScreen = 1
    tokIdx = tokIdx + 1
  END IF

  dashIdx = 0
  ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
  IF ff = 1 THEN
    dashIdx = returnedData2
  END IF

  IF dashIdx = 0 THEN
    throwCompilerErrorAndCancelTira "VIEW MISSING -", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  IF comma1 > 0 THEN comma2 = findComma(comma1 + 1, endIdx)

  p2End = endIdx
  IF comma1 > 0 THEN p2End = comma1 - 1

  cComma1 = retCoordinateBoundaries(tokIdx, dashIdx - 1)
  cStart1 = returnedData2
  cEnd1 = returnedData3

  cComma2 = retCoordinateBoundaries(dashIdx + 1, p2End)
  cStart2 = returnedData2
  cEnd2 = returnedData3

  IF cComma1 = 0 OR cComma2 = 0 THEN
    throwCompilerErrorAndCancelTira "VIEW MISSING COORDINATES", ASIS, 0
    EXIT FUNCTION
  END IF

  x1$ = tiraParseExpressionInt$(cStart1, cComma1 - 1, ALIM, "COORD MUST BE NUMERIC")
  IF x1$ = "" THEN EXIT FUNCTION

  y1$ = tiraParseExpressionInt$(cComma1 + 1, cEnd1, ALIM, "COORD MUST BE NUMERIC")
  IF y1$ = "" THEN EXIT FUNCTION

  x2$ = tiraParseExpressionInt$(cStart2, cComma2 - 1, ALIM, "COORD MUST BE NUMERIC")
  IF x2$ = "" THEN EXIT FUNCTION

  y2$ = tiraParseExpressionInt$(cComma2 + 1, cEnd2, ALIM, "COORD MUST BE NUMERIC")
  IF y2$ = "" THEN EXIT FUNCTION

  colBg$ = ""
  colBorder$ = ""

  IF comma1 > 0 THEN
    colEnd1 = endIdx
    IF comma2 > 0 THEN colEnd1 = comma2 - 1

    IF comma1 + 1 <= colEnd1 THEN
      colBg$ = tiraParseExpressionInt$(comma1 + 1, colEnd1, ALIM, "COLOR MUST BE NUMERIC")
      IF colBg$ = "" THEN EXIT FUNCTION
    END IF

    IF comma2 > 0 THEN
      IF comma2 + 1 <= endIdx THEN
        colBorder$ = tiraParseExpressionInt$(comma2 + 1, endIdx, ALIM, "BORDER MUST BE NUMERIC")
        IF colBorder$ = "" THEN EXIT FUNCTION
      END IF
    END IF
  END IF

  minX$ = tiraDimVar$("T", TYPE_LONG)
  maxX$ = tiraDimVar$("T", TYPE_LONG)
  minY$ = tiraDimVar$("T", TYPE_LONG)
  maxY$ = tiraDimVar$("T", TYPE_LONG)

  skipX$ = tiraLabelCreateNew$("VIEW_X")
  tiraAssign minX$, x1$
  tiraAssign maxX$, x2$
  tiraJmpCond "JLE", x1$, x2$, skipX$
  tiraAssign minX$, x2$
  tiraAssign maxX$, x1$
  tiraLabel skipX$

  skipY$ = tiraLabelCreateNew$("VIEW_Y")
  tiraAssign minY$, y1$
  tiraAssign maxY$, y2$
  tiraJmpCond "JLE", y1$, y2$, skipY$
  tiraAssign minY$, y2$
  tiraAssign maxY$, y1$
  tiraLabel skipY$

  ' Temporarily set viewport to absolute full screen to safely draw the background and borders
  tiraAssign "!G_GFX_VAL_VIEW_X1", "0"
  tiraAssign "!G_GFX_VAL_VIEW_Y1", "0"
  tiraAssign "!G_GFX_VAL_VIEW_X2", LTRIM$(STR$(gfxConfig.SizeX))
  tiraAssign "!G_GFX_VAL_VIEW_Y2", LTRIM$(STR$(gfxConfig.SizeY))
  tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
  tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"

  IF colBg$ <> "" THEN
    tiraCall "RT_LINE", 7, minX$ + ", " + minY$ + ", " + maxX$ + ", " + maxY$ + ", " + colBg$ + ", 2, 65535"
  END IF

  IF colBorder$ <> "" THEN
    bMinX$ = tiraDimVar$("T", TYPE_LONG)
    bMaxX$ = tiraDimVar$("T", TYPE_LONG)
    bMinY$ = tiraDimVar$("T", TYPE_LONG)
    bMaxY$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, bMinX$, minX$, "1"
    tiraOp TC_ADD, bMaxX$, maxX$, "1"
    tiraOp TC_SUB, bMinY$, minY$, "1"
    tiraOp TC_ADD, bMaxY$, maxY$, "1"
    tiraCall "RT_LINE", 7, bMinX$ + ", " + bMinY$ + ", " + bMaxX$ + ", " + bMaxY$ + ", " + colBorder$ + ", 1, 65535"
  END IF

  ' Now establish the actual restricted viewport boundaries internally
  tiraOp TC_ADD, maxX$, maxX$, "1" ' Max limits are exclusive
  tiraOp TC_ADD, maxY$, maxY$, "1"

  tiraAssign "!G_GFX_VAL_VIEW_X1", minX$
  tiraAssign "!G_GFX_VAL_VIEW_X2", maxX$
  tiraAssign "!G_GFX_VAL_VIEW_Y1", minY$
  tiraAssign "!G_GFX_VAL_VIEW_Y2", maxY$

  IF isScreen = 1 THEN
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"
  ELSE
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", minX$
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", minY$
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_VIEW_GRAPHICS = 1

END FUNCTION ' parse_VIEW_GRAPHICS

''''''''''''''''''''''''
FUNCTION parse_WIDTH$ (startIdx, endIdx, allowImplicit)
  ' Func version, will need to change names later when WIDTH without underscore is supported

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM resWidth AS LONG

  IF lineTokenVals(startIdx + 1) = 256 + ASC("(") AND lineTokenVals(endIdx) = 256 + ASC(")") THEN
    IF startIdx + 3 > endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF startIdx <> endIdx THEN
      throwCompilerError "MALFORMED _WIDTH", ASIS, 0
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF startIdx <> endIdx THEN
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_WIDTH$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("WIDTH", "_VAL")
  IF scratchName$ = "" THEN
    parse_WIDTH$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resWidth = 120
  IF cm.HasGraphics = 1 THEN resWidth = gfxConfig.SizeX

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, LTRIM$(STR$(resWidth))

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WIDTH$ = scratchName$

END FUNCTION ' parse_WIDTH$

''''''''''''''''''''''''
FUNCTION parse_WINDOWHANDLE$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _WINDOWHANDLE", ASIS, 0
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("WNDHND", "_VAL")
  IF scratchName$ = "" THEN
    parse_WINDOWHANDLE$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly force the data type to 64-bit integer
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_INTEGER64

  resVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF cm.HasGraphics = 1 THEN
    tiraAssign resVar$, "!G_WND_VAL_HWND"
  ELSE
    tiraCall "IAT_GETCONSOLEWINDOW", 0, ""
    tiraNew TC_GET_RET, resVar$
  END IF

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_WINDOWHANDLE$ = scratchName$

END FUNCTION ' parse_WINDOWHANDLE$

''''''''''''''''''''''''
SUB tiraDrawCmdFinishMove (endX$, endY$, colorVar$, blindVar$, noMoveVar$, currentX$, currentY$)

  tiraCheckActive ("tiraDrawCmdFinishMove")
  IF tiraLineCheck THEN EXIT SUB

  lineSkipLbl$ = tiraLabelCreateNew$("DRAW_LINE_SKIP")
  cursorSkipLbl$ = tiraLabelCreateNew$("DRAW_CURSOR_SKIP")

  tiraJmpCond "JNE", blindVar$, "0", lineSkipLbl$
  tiraCall "RT_LINE", 7, currentX$ + ", " + currentY$ + ", " + endX$ + ", " + endY$ + ", " + colorVar$ + ", 0, 65535"
  tiraLabel lineSkipLbl$

  tiraJmpCond "JNE", noMoveVar$, "0", cursorSkipLbl$
  tiraAssign currentX$, endX$
  tiraAssign currentY$, endY$
  tiraLabel cursorSkipLbl$

  tiraAssign blindVar$, "0"
  tiraAssign noMoveVar$, "0"

END SUB ' tiraDrawCmdFinishMove

''''''''''''''''''''''''
SUB tiraDrawCmdMoveVector (vectorX$, vectorY$, moveAmount$, scaleVar$, sineVar$, cosineVar$, colorVar$, blindVar$, noMoveVar$, currentX$, currentY$)

  tiraCheckActive ("tiraDrawCmdMoveVector")
  IF tiraLineCheck THEN EXIT SUB

  amountFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign amountFloat$, moveAmount$

  scaleFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign scaleFloat$, scaleVar$

  scaledAmount$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, scaledAmount$, amountFloat$, scaleFloat$
  tiraOp TC_DIV, scaledAmount$, scaledAmount$, "4.0#"

  baseX$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign baseX$, vectorX$

  baseY$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign baseY$, vectorY$

  rotatedX$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, rotatedX$, baseX$, cosineVar$

  turnX$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, turnX$, baseY$, sineVar$
  tiraOp TC_ADD, rotatedX$, rotatedX$, turnX$

  rotatedY$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, rotatedY$, baseY$, cosineVar$

  turnY$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, turnY$, baseX$, sineVar$
  tiraOp TC_SUB, rotatedY$, rotatedY$, turnY$

  deltaX$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, deltaX$, rotatedX$, scaledAmount$

  deltaY$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, deltaY$, rotatedY$, scaledAmount$

  endFloatX$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign endFloatX$, currentX$
  tiraOp TC_ADD, endFloatX$, endFloatX$, deltaX$

  endFloatY$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign endFloatY$, currentY$
  tiraOp TC_ADD, endFloatY$, endFloatY$, deltaY$

  endX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign endX$, endFloatX$

  endY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign endY$, endFloatY$

  tiraDrawCmdFinishMove endX$, endY$, colorVar$, blindVar$, noMoveVar$, currentX$, currentY$

END SUB ' tiraDrawCmdMoveVector

''''''''''''''''''''''''
SUB tiraDrawCmdReadNumber (dataPtr$, indexVar$, drawSize$, valueVar$, foundVar$, invalidVar$)

  ' Relates to DRAW command. Used to extract the numeric values that follow the command letters
  ' in the string, such as reading the "100" out of "U100" while handling positive and negative signs

  tiraCheckActive ("tiraDrawCmdReadNumber")
  IF tiraLineCheck THEN EXIT SUB

  tiraAssign valueVar$, "0"
  tiraAssign foundVar$, "0"
  tiraAssign invalidVar$, "0"

  negativeVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign negativeVar$, "0"

  signSeen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign signSeen$, "0"

  numberPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  numberByte$ = tiraDimVar$("T", TYPE_UBYTE)
  digitVar$ = tiraDimVar$("T", TYPE_LONG)

  plusLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_PLUS")
  minusLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_MINUS")
  digitTopLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_DIGIT")
  digitDoneLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_DIGIT_DONE")
  checkTermLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_TERM")
  malformedLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_BAD")
  applySignLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_SIGN")
  completeLbl$ = tiraLabelCreateNew$("DRAW_NUMBER_DONE")

  tiraDrawCmdSkipWhitespace dataPtr$, indexVar$, drawSize$

  tiraJmpCond "JGE", indexVar$, drawSize$, completeLbl$

  tiraOp TC_ADD, numberPtr$, dataPtr$, indexVar$
  tiraNew TC_READ_MEM, numberByte$ + ", " + numberPtr$

  tiraJmpCond "JE", numberByte$, "43", plusLbl$
  tiraJmpCond "JE", numberByte$, "45", minusLbl$
  tiraJmp digitTopLbl$

  tiraLabel plusLbl$
  tiraAssign signSeen$, "1"
  tiraOp TC_ADD, indexVar$, indexVar$, "1"
  tiraJmp digitTopLbl$

  tiraLabel minusLbl$
  tiraAssign signSeen$, "1"
  tiraAssign negativeVar$, "1"
  tiraOp TC_ADD, indexVar$, indexVar$, "1"

  tiraLabel digitTopLbl$
  tiraJmpCond "JGE", indexVar$, drawSize$, digitDoneLbl$

  tiraOp TC_ADD, numberPtr$, dataPtr$, indexVar$
  tiraNew TC_READ_MEM, numberByte$ + ", " + numberPtr$

  tiraJmpCond "JL", numberByte$, "48", digitDoneLbl$
  tiraJmpCond "JG", numberByte$, "57", digitDoneLbl$

  tiraAssign foundVar$, "1"

  tiraOp TC_MUL, valueVar$, valueVar$, "10"
  tiraOp TC_SUB, digitVar$, numberByte$, "48"
  tiraOp TC_ADD, valueVar$, valueVar$, digitVar$

  tiraOp TC_ADD, indexVar$, indexVar$, "1"
  tiraJmp digitTopLbl$

  tiraLabel digitDoneLbl$

  tiraJmpCond "JNE", foundVar$, "0", checkTermLbl$
  tiraJmpCond "JNE", signSeen$, "0", malformedLbl$
  tiraJmpCond "JGE", indexVar$, drawSize$, completeLbl$
  tiraJmpCond "JE", numberByte$, "46", malformedLbl$
  tiraJmpCond "JE", numberByte$, "61", malformedLbl$
  tiraJmp completeLbl$

  tiraLabel checkTermLbl$
  tiraJmpCond "JGE", indexVar$, drawSize$, applySignLbl$
  tiraJmpCond "JE", numberByte$, "46", malformedLbl$
  tiraJmpCond "JE", numberByte$, "61", malformedLbl$
  tiraJmp applySignLbl$

  tiraLabel malformedLbl$
  tiraAssign invalidVar$, "1"
  tiraJmp completeLbl$

  tiraLabel applySignLbl$
  tiraJmpCond "JE", negativeVar$, "0", completeLbl$
  tiraOp TC_NEG, valueVar$, valueVar$, ""

  tiraLabel completeLbl$

END SUB ' tiraDrawCmdReadNumber

''''''''''''''''''''''''
SUB tiraDrawCmdSetRotation (angleVar$, sineVar$, cosineVar$)

  ' Relates to DRAW command. Used to calculate the sine and cosine values when the DRAW string uses
  ' the Turn Angle (TA) command, which rotates the subsequent drawing vectors by a specific number of degrees

  tiraCheckActive ("tiraDrawCmdSetRotation")
  IF tiraLineCheck THEN EXIT SUB

  angleFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign angleFloat$, angleVar$

  radiansVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, radiansVar$, angleFloat$, "0.017453292519943295#"

  tiraCall "IAT_COS", 1, radiansVar$
  tiraNew TC_GET_RET, cosineVar$

  tiraCall "IAT_SIN", 1, radiansVar$
  tiraNew TC_GET_RET, sineVar$

END SUB ' tiraDrawCmdSetRotation

''''''''''''''''''''''''
SUB tiraDrawCmdSkipWhitespace (dataPtr$, indexVar$, drawSize$)

  ' Relates to DRAW command. Used to advance the string parser past any blank spaces inside the
  ' DRAW string so it can find the next instruction or number

  tiraCheckActive ("tiraDrawCmdSkipWhitespace")
  IF tiraLineCheck THEN EXIT SUB

  skipTopLbl$ = tiraLabelCreateNew$("DRAW_SPACE")
  skipAdvanceLbl$ = tiraLabelCreateNew$("DRAW_SPACE_ADVANCE")
  skipDoneLbl$ = tiraLabelCreateNew$("DRAW_SPACE_DONE")

  skipPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  skipByte$ = tiraDimVar$("T", TYPE_UBYTE)

  tiraLabel skipTopLbl$
  tiraJmpCond "JGE", indexVar$, drawSize$, skipDoneLbl$

  tiraOp TC_ADD, skipPtr$, dataPtr$, indexVar$
  tiraNew TC_READ_MEM, skipByte$ + ", " + skipPtr$

  tiraJmpCond "JE", skipByte$, "32", skipAdvanceLbl$
  tiraJmpCond "JNE", skipByte$, "9", skipDoneLbl$

  tiraLabel skipAdvanceLbl$
  tiraOp TC_ADD, indexVar$, indexVar$, "1"
  tiraJmp skipTopLbl$

  tiraLabel skipDoneLbl$

END SUB ' tiraDrawCmdSkipWhitespace

''''''''''''''''''''''''
SUB tiraPrintUsingCommaZone

  curCol$ = tiraDimVar$("T", TYPE_LONG)

  IF cm.HasGraphics = 1 THEN
    tiraOp TC_IDIV, curCol$, "!G_GFX_VAL_CUR_X", "8"
    tiraOp TC_ADD, curCol$, curCol$, "1"
  ELSE
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraCall "IAT_GETSTDHANDLE", 1, "-11"
    tiraNew TC_GET_RET, hndVar$

    csbi$ = tiraAllocTempMem$("24")
    tiraCall "IAT_GETCONSOLESCREENBUFFERINFO", 2, hndVar$ + ", " + csbi$

    coordVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, coordVar$ + ", " + csbi$ + ", 4"

    tiraOp TC_AND, curCol$, coordVar$, "65535"
    tiraOp TC_ADD, curCol$, curCol$, "1"
  END IF

  zoneOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, zoneOffset$, curCol$, "1"
  tiraOp TC_MOD, zoneOffset$, zoneOffset$, "14"

  spacesNeeded$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, spacesNeeded$, "14", zoneOffset$

  dataPtr$ = tiraAllocTempMem$(spacesNeeded$)
  tiraMemSet dataPtr$, "32", spacesNeeded$

  descPtr$ = tiraAllocTempMem$("24")
  tiraBuildStrDesc descPtr$, dataPtr$, spacesNeeded$, "0"
  tiraCall "RT_PRINT_STR", 1, descPtr$

END SUB ' tiraPrintUsingCommaZone

''''''''''''''''''''''''
SUB tiraPrintUsingPrintSpan (descPtr$, dataPtr$, dataLen$)

  tiraBuildStrDesc descPtr$, dataPtr$, dataLen$, "0"
  tiraCall "RT_PRINT_STR", 1, descPtr$

END SUB ' tiraPrintUsingPrintSpan

''''''''''''''''''''''''
SUB tiraPrintUsingPutByte (outPtr$, outLen$, byteVal$)

  tiraWriteMem outPtr$, byteVal$, "1"
  tiraOp TC_ADD, outPtr$, outPtr$, "1"
  tiraOp TC_ADD, outLen$, outLen$, "1"

END SUB ' tiraPrintUsingPutByte

''''''''''''''''''''''''
SUB waitKeyRelease (wKey$)

  DIM currentDest AS LONG

  currentDest = _DEST

  IF currentDest = logicalScreen THEN
    dispScreenFlushUpdate ' Logical-screen modals still require their normal scaled presentation
  ELSE
    _DISPLAY ' Physical screen content is already complete and must not be replaced by logicalScreen
  END IF

  DO
  LOOP UNTIL keyCheck(wKey$) = 0

END SUB ' waitKeyRelease

''''''''''''''''''''''''
SUB waitTimer (wSeconds)

  tGoal = TIMER + wSeconds
  DO WHILE TIMER < tGoal
  LOOP

END SUB ' waitTimer

