END FUNCTION ' parse_BUTTON$

''''''''''''''''''''''''
FUNCTION parse_CIRCLE (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM comma5 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM rEnd AS LONG
  DIM colEnd AS LONG
  DIM radStart AS LONG
  DIM radEnd AS LONG
  DIM aspStart AS LONG
  DIM aspEnd AS LONG
  DIM xVar$
  DIM yVar$
  DIM radVar$
  DIM colVar$
  DIM tmpVar$

  endIdx = lineTokenCount - 1

  IF compileHasGraphics = 0 THEN
    throwCompilerError "CIRCLE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  hasStep = 0
  IF lineTokenVals(tokIdx) = TOK_STEP THEN
    hasStep = 1
    tokIdx = tokIdx + 1
    IF tokIdx > endIdx THEN
      throwCompilerError "EXPECTED ( AFTER STEP", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  comma3 = 0
  comma4 = 0
  comma5 = 0

  IF comma1 > 0 THEN comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 > 0 THEN comma3 = findComma(comma2 + 1, endIdx)
  IF comma3 > 0 THEN comma4 = findComma(comma3 + 1, endIdx)
  IF comma4 > 0 THEN comma5 = findComma(comma4 + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(tokIdx, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "CIRCLE MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  xVar$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF xVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  yVar$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF yVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    tiraOp TC_ADD, xVar$, xVar$, "!G_GFX_VAL_CUR_X"
    tiraOp TC_ADD, yVar$, yVar$, "!G_GFX_VAL_CUR_Y"
  END IF

  rEnd = endIdx
  IF comma2 > 0 THEN rEnd = comma2 - 1

  IF comma1 + 1 > rEnd THEN
    throwCompilerErrorAndCancelTira "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  radVar$ = tiraParseExpressionInt$(comma1 + 1, rEnd, ALIM, "RADIUS MUST BE NUMERIC")
  IF radVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    colEnd = endIdx
    IF comma3 > 0 THEN colEnd = comma3 - 1
    IF comma2 + 1 > colEnd THEN
      colVar$ = "!G_GFX_VAL_FG"
    ELSE
      colVar$ = tiraParseExpressionInt$(comma2 + 1, colEnd, ALIM, "COLOR MUST BE NUMERIC")
      IF colVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF
  ELSE
    colVar$ = "!G_GFX_VAL_FG"
  END IF

  IF comma3 > 0 THEN
    radStart = comma3 + 1
    radEnd = endIdx
    IF comma4 > 0 THEN radEnd = comma4 - 1
    IF radStart <= radEnd THEN
      IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
      tmpVar$ = tiraParseExpressionNumeric$(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF comma4 > 0 THEN
    radStart = comma4 + 1
    radEnd = endIdx
    IF comma5 > 0 THEN radEnd = comma5 - 1
    IF radStart <= radEnd THEN
      IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
      tmpVar$ = tiraParseExpressionNumeric$(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF comma5 > 0 THEN
    aspStart = comma5 + 1
    aspEnd = endIdx
    IF aspStart <= aspEnd THEN
      IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
      tmpVar$ = tiraParseExpressionNumeric$(aspStart, aspEnd, ALIM, "ASPECT MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF
  END IF

  tiraCall "RT_CIRCLE", 4, xVar$ + ", " + yVar$ + ", " + radVar$ + ", " + colVar$

  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_CIRCLE = 1

END FUNCTION ' parse_CIRCLE

''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_Assign (startIdx)

  DIM endIdx AS LONG
  DIM argVar$

  endIdx = lineTokenCount - 1

  IF startIdx + 1 > endIdx THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = AFTER _CLIPBOARD$", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_STRING
  argVar$ = tiraParseExpression$(startIdx + 2, endIdx, ALIM)
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "_CLIPBOARD$ ASSIGN REQUIRES STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tiraCall "RT_SET_CLIPBOARD", 1, argVar$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_CLIPBOARD_Assign = 1

END FUNCTION ' parse_CLIPBOARD_Assign

''''''''''''''''''''''''
FUNCTION parse_COPYIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg2$
  DIM comma1 AS LONG
  DIM scratchName$
  DIM srcVar$
  DIM skipZeroLbl$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_COPYIMAGE", 3) = 0 THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  IF comma1 > 0 THEN
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, comma1 - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF

    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg2$ = tiraParseExpressionInt$(comma1 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF arg2$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE
    arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF arg1$ = "" THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchName$ = tiraResolveHoistVar$("CPYIMG", "_VAL")
  IF scratchName$ = "" THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF

  ' If the provided handle is 0, QB64 specifies that it copies the current destination screen
  srcVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcVar$, arg1$
  skipZeroLbl$ = tiraLabelCreateNew$("CPYIMG_SKIP_ZERO")
  tiraJmpCond "JNE", srcVar$, "0", skipZeroLbl$
  tiraAssign srcVar$, "!G_GFX_VAL_DEST_PAGE"
  tiraLabel skipZeroLbl$

  ' In the current EmeraldBasic architecture, DEST and PUTIMAGE strictly branch
  ' on handles 0, 1, 2, and 3. Similar to _NEWIMAGE, we map _COPYIMAGE directly
  ' to PAGE3 (3) and leverage the existing RT_PCOPY runtime helper to duplicate
  ' the source surface perfectly without requiring dynamic heap allocations.
  tiraCall "RT_PCOPY", 2, srcVar$ + ", 3"

  ' Return the new hardware surface handle
  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign resVar$, "3"

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_COPYIMAGE$ = scratchName$

END FUNCTION ' parse_COPYIMAGE$


''''''''''''''''''''''''
FUNCTION parse_CLIPBOARD_FUNC$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM descPtr$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _CLIPBOARD$", ASIS, 0
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("CLIP", "_DSC")
  IF scratchName$ = "" THEN
    parse_CLIPBOARD_FUNC$ = ""
    EXIT FUNCTION
  END IF

  ' Allocate a local descriptor wrapper and push its address explicitly into the arguments
  ' so the Runtime Helper can physically write the required data pointers back into it
  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  tiraCall "RT_GET_CLIPBOARD", 1, descPtr$

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CLIPBOARD_FUNC$ = scratchName$

END FUNCTION ' parse_CLIPBOARD_FUNC$

''''''''''''''''''''''''
FUNCTION parse_COS$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM singleRes$
  DIM argFloat$

  IF checkIntrinsicSyntax(startIdx, endIdx, "COS", 3) = 0 THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  arg1$ = tiraParseExpressionNumeric$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("COS", "_VAL")
  IF scratchName$ = "" THEN
    parse_COS$ = ""
    EXIT FUNCTION
  END IF

  ' Explicitly override the integer prefix rule to safely route as float
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
    tiraAssign argFloat$, arg1$
    arg1$ = argFloat$
  END IF

  tiraCall "IAT_COS", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  singleRes$ = tiraDimVar$("T", TYPE_SINGLE)
  tiraOp TC_CAST, singleRes$, resVar$, LTRIM$(STR$(TYPE_SINGLE))

  tiraAssign scratchName$, singleRes$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_COS$ = scratchName$

END FUNCTION ' parse_COS$

''''''''''''''''''''''''
FUNCTION parse_CVS$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM dataPtr$
  DIM strLen$
  DIM validCvsLbl$
  DIM errStr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVS", 3) = 0 THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_STRING

  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("CVS", "_VAL")
  IF scratchName$ = "" THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  ' Force the hoist variable to cleanly inherit the explicit SINGLE precision type
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_SINGLE)

  dataPtr$ = tiraGetStringData$(arg1$)
  strLen$ = tiraGetStringLen$(arg1$)

  validCvsLbl$ = tiraLabelCreateNew$("VALID_CVS")

  tiraJmpCond "JGE", strLen$, "4", validCvsLbl$

  errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVS() ON LINE " + retLineNumberStr$ + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel validCvsLbl$

  tiraNew TC_READ_MEM, resVar$ + ", " + dataPtr$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_CVS$ = scratchName$

END FUNCTION ' parse_CVS$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_DELAY (startIdx)

  DIM endIdx AS LONG
  DIM argVar$
  DIM argFloat$
  DIM msFloat$
  DIM msInt$
  DIM skipClampLbl$

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "_DELAY REQUIRES NUMERIC ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  IF compileEmeraldMode = 1 THEN expectedSymType = TYPE_SINGLE

  argVar$ = tiraParseExpressionNumeric$(startIdx + 1, endIdx, ALIM, "_DELAY REQUIRES NUMERIC ARGUMENT")
  IF argVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)

  IF exprIs.DataType <> TYPE_DOUBLE THEN
    tiraOp TC_CAST, argFloat$, argVar$, LTRIM$(STR$(TYPE_DOUBLE))
  ELSE
    tiraAssign argFloat$, argVar$
  END IF

  msFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraOp TC_MUL, msFloat$, argFloat$, "1000.0#"

  msInt$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_CAST, msInt$, msFloat$, LTRIM$(STR$(TYPE_LONG))

  skipClampLbl$ = tiraLabelCreateNew$("DELAY_SKIP_CLAMP")
  tiraJmpCond "JGE", msInt$, "0", skipClampLbl$
  tiraAssign msInt$, "0"
  tiraLabel skipClampLbl$

  tiraCall "IAT_SLEEP", 1, msInt$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_DELAY = 1

END FUNCTION ' parse_DELAY


