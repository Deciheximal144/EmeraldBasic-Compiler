''''''''''''''''''''''''
FUNCTION parse_CVS$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$
  DIM dataPtr$
  DIM strLen$
  DIM validCvsLbl$
  DIM errStr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "CVS", 3) = 0 THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpression$(startIdx + 2, endIdx - 1, allowImplicit)
  IF arg1$ = "" THEN
    tira_Cancel
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("CVS", "_VAL")
  IF scratchName$ = "" THEN
    parse_CVS$ = ""
    EXIT FUNCTION
  END IF

  ' Force the hoist variable to cleanly inherit the explicit SINGLE precision type
  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_SINGLE

  resVar$ = tiraDimVar$("T", TYPE_SINGLE)

  dataPtr$ = tiraGetStringData$(arg1$)
  strLen$ = tiraGetStringLen$(arg1$)

  validCvsLbl$ = tiraLabelCreateNew$("VALID_CVS")

  tiraJmpCond "JGE", strLen$, "4", validCvsLbl$

  errStr$ = CHR$(34) + "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN CVS() ON LINE " + retLineNumberStr$ + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_CRLF", 0, ""
  tiraJmp "@END_PROGRAM"

  tiraLabel validCvsLbl$

  tiraNew TC_READ_MEM, resVar$ + ", " + dataPtr$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_CVS$ = scratchName$

END FUNCTION ' parse_CVS$

''''''''''''''''''''''''
FUNCTION parse_DEFINT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM char1 AS LONG
  DIM char2 AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
    EXIT FUNCTION
  END IF

  DO WHILE tokIdx <= endIdx
    tok$ = lineTokens$(tokIdx)
    IF LEN(tok$) <> 1 THEN
      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
      EXIT FUNCTION
    END IF
    char1 = ASC(UCASE$(tok$))
    IF char1 < 65 OR char1 > 90 THEN
      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
      EXIT FUNCTION
    END IF
    char2 = char1
    tokIdx = tokIdx + 1
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("-") THEN
        tokIdx = tokIdx + 1
        IF tokIdx <= endIdx THEN
          tok2$ = lineTokens$(tokIdx)
          IF LEN(tok2$) <> 1 THEN
            throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
            EXIT FUNCTION
          END IF
          char2 = ASC(UCASE$(tok2$))
          IF char2 < 65 OR char2 > 90 OR char2 < char1 THEN
            throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
            EXIT FUNCTION
          END IF
          tokIdx = tokIdx + 1
        ELSE
          throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF
    FOR ix = char1 TO char2
      IF cm.HasGlobalDefInt = 0 THEN defIntMap(ix - 65) = 1
    NEXT
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerError "EXPECTED COMMA", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  parse_DEFINT = 1

END FUNCTION ' parse_DEFINT

''''''''''''''''''''''''
FUNCTION parse_DELAY (startIdx)

  parse_DELAY = parse_DELAY_Core(startIdx, 0)

END FUNCTION ' parse_DELAY

''''''''''''''''''''''''
FUNCTION parse_DELAY_Core (startIdx, delayMode AS LONG)

  DIM endIdx AS LONG
  DIM hasArg AS LONG
  DIM argVar$
  DIM argFloat$
  DIM msFloat$
  DIM delayMilliseconds$
  DIM skipClampLbl$
  DIM releaseWaitLbl$
  DIM releaseKeyLbl$
  DIM sleepWaitLbl$
  DIM sleepKeyLbl$
  DIM doneLbl$
  DIM keyIdx$
  DIM keyState$
  DIM playToken$
  DIM playText$
  DIM pauseText$
  DIM pauseValue AS LONG
  DIM pauseMilliseconds AS LONG
  DIM isPauseOnly AS LONG
  DIM chCheck AS STRING * 1
  DIM pendingBits$
  DIM skipPresentLbl$
  DIM skipTickLbl$
  DIM currentTick$

  endIdx = lineTokenCount - 1
  hasArg = 0

  IF endIdx >= startIdx + 1 THEN hasArg = 1

  IF delayMode = 0 THEN
    IF hasArg = 0 THEN
      throwCompilerError "_DELAY REQUIRES NUMERIC ARGUMENT", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF delayMode = 2 THEN
    isPauseOnly = 0

    IF endIdx = startIdx + 1 THEN
      playToken$ = lineTokens$(startIdx + 1)

      IF LEN(playToken$) >= 3 THEN
        IF LEFT$(playToken$, 1) = CHR$(34) AND RIGHT$(playToken$, 1) = CHR$(34) THEN
          playText$ = UCASE$(LTRIM$(RTRIM$(MID$(playToken$, 2, LEN(playToken$) - 2))))

          IF LEFT$(playText$, 1) = "P" THEN
            pauseText$ = MID$(playText$, 2)

            IF LEN(pauseText$) > 0 THEN
              isPauseOnly = 1

              FOR ii = 1 TO LEN(pauseText$)
                chCheck = MID$(pauseText$, ii, 1)
                IF chCheck < "0" OR chCheck > "9" THEN
                  isPauseOnly = 0
                  EXIT FOR
                END IF
              NEXT

              IF isPauseOnly = 1 THEN
                IF LEN(pauseText$) > 2 THEN
                  throwCompilerError "PLAY PAUSE MUST BE BETWEEN 1 AND 64", ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isPauseOnly = 0 THEN
      parse_DELAY_Core = 1
      EXIT FUNCTION
    END IF

    pauseValue = VAL(pauseText$)

    IF pauseValue < 1 OR pauseValue > 64 THEN
      throwCompilerError "PLAY PAUSE MUST BE BETWEEN 1 AND 64", ASIS, 0
      EXIT FUNCTION
    END IF

    ' At the default PLAY tempo of 120, a whole note lasts 2000 milliseconds
    pauseMilliseconds = 2000 \ pauseValue
  END IF

  tira_Start

  delayMilliseconds$ = ""

  IF delayMode = 2 THEN
    delayMilliseconds$ = LTRIM$(STR$(pauseMilliseconds))
  ELSE
    IF hasArg = 1 THEN
      IF delayMode = 1 THEN
        argVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "SLEEP REQUIRES NUMERIC ARGUMENT")
      ELSE
        argVar$ = tiraParseExpressionNumeric$(startIdx + 1, endIdx, ALIM, "_DELAY REQUIRES NUMERIC ARGUMENT")
      END IF

      IF argVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      IF delayMode = 1 THEN
        delayMilliseconds$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_MUL, delayMilliseconds$, argVar$, "1000"
      ELSE
        argFloat$ = tiraDimVar$("T", TYPE_DOUBLE)

        IF exprIs.DataType <> TYPE_DOUBLE THEN
          tiraOp TC_CAST, argFloat$, argVar$, LTRIM$(STR$(TYPE_DOUBLE))
        ELSE
          tiraAssign argFloat$, argVar$
        END IF

        msFloat$ = tiraDimVar$("T", TYPE_DOUBLE)
        tiraOp TC_MUL, msFloat$, argFloat$, "1000.0#"

        delayMilliseconds$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_CAST, delayMilliseconds$, msFloat$, LTRIM$(STR$(TYPE_LONG))
      END IF

      skipClampLbl$ = tiraLabelCreateNew$("DELAY_SKIP_CLAMP")
      tiraJmpCond "JGE", delayMilliseconds$, "0", skipClampLbl$
      tiraAssign delayMilliseconds$, "0"
      tiraLabel skipClampLbl$
    END IF
  END IF

  IF delayMode = 0 THEN
    tiraCall "IAT_SLEEP", 1, delayMilliseconds$
  ELSE
    IF delayMode = 2 THEN
      IF cm.HasGraphics = 1 THEN
        skipPresentLbl$ = tiraLabelCreateNew$("PLAY_SKIP_PRESENT")
        tiraJmpCond "JE", "!G_GFX_FLG_AUTO", "0", skipPresentLbl$

        pendingBits$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_AND, pendingBits$, "!G_GFX_FLG_DISPLAYI_PENDING", "1"
        tiraJmpCond "JE", pendingBits$, "0", skipPresentLbl$

        ' Present the completed frame before honoring the PLAY pause
        tiraCall "RT_SWAP_BUFFERS", 0, ""
        tiraOp TC_AND, "!G_GFX_FLG_DISPLAYI_PENDING", "!G_GFX_FLG_DISPLAYI_PENDING", "-2"

        tiraLabel skipPresentLbl$
      END IF

      tiraCall "IAT_SLEEP", 1, delayMilliseconds$

      IF cm.HasGraphics = 1 THEN
        skipTickLbl$ = tiraLabelCreateNew$("PLAY_SKIP_TICK")
        tiraJmpCond "JE", "!G_GFX_FLG_AUTO", "0", skipTickLbl$

        ' Restart automatic display timing after the pause so the next CLS remains offscreen
        tiraCall "IAT_GETTICKCOUNT", 0, ""
        currentTick$ = tiraDimVar$("T", TYPE_LONG)
        tiraNew TC_GET_RET, currentTick$
        tiraAssign "!G_GFX_VAL_DISPLAYI_TIMER", currentTick$

        tiraLabel skipTickLbl$
      END IF
    ELSE
      releaseWaitLbl$ = tiraLabelCreateNew$("SLEEP_RELEASE_WAIT")
      releaseKeyLbl$ = tiraLabelCreateNew$("SLEEP_RELEASE_KEY")
      sleepWaitLbl$ = tiraLabelCreateNew$("SLEEP_WAIT")
      sleepKeyLbl$ = tiraLabelCreateNew$("SLEEP_KEY")
      doneLbl$ = tiraLabelCreateNew$("SLEEP_DONE")

      IF hasArg = 1 THEN
        tiraJmpCond "JLE", delayMilliseconds$, "0", doneLbl$
      END IF

      keyIdx$ = tiraDimVar$("T", TYPE_LONG)
      keyState$ = tiraDimVar$("T", TYPE_LONG)

      IF cm.HasGraphics = 1 THEN
        skipPresentLbl$ = tiraLabelCreateNew$("SLEEP_SKIP_PRESENT")
        tiraJmpCond "JE", "!G_GFX_FLG_AUTO", "0", skipPresentLbl$

        pendingBits$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_AND, pendingBits$, "!G_GFX_FLG_DISPLAYI_PENDING", "1"
        tiraJmpCond "JE", pendingBits$, "0", skipPresentLbl$

        ' Present the completed frame before entering the SLEEP wait
        tiraCall "RT_SWAP_BUFFERS", 0, ""
        tiraOp TC_AND, "!G_GFX_FLG_DISPLAYI_PENDING", "!G_GFX_FLG_DISPLAYI_PENDING", "-2"

        tiraLabel skipPresentLbl$
      END IF

      tiraLabel releaseWaitLbl$
      tiraCall "IAT_SLEEP", 1, "10"
      tiraAssign keyIdx$, "8"

      tiraLabel releaseKeyLbl$
      tiraCall "IAT_GETASYNCKEYSTATE", 1, keyIdx$
      tiraNew TC_GET_RET, keyState$
      tiraOp TC_AND, keyState$, keyState$, "32768"
      tiraJmpCond "JNE", keyState$, "0", releaseWaitLbl$

      tiraOp TC_ADD, keyIdx$, keyIdx$, "1"
      tiraJmpCond "JLE", keyIdx$, "255", releaseKeyLbl$

      tiraLabel sleepWaitLbl$
      tiraCall "IAT_SLEEP", 1, "10"
      tiraAssign keyIdx$, "8"

      tiraLabel sleepKeyLbl$
      tiraCall "IAT_GETASYNCKEYSTATE", 1, keyIdx$
      tiraNew TC_GET_RET, keyState$
      tiraOp TC_AND, keyState$, keyState$, "32768"
      tiraJmpCond "JNE", keyState$, "0", doneLbl$

      tiraOp TC_ADD, keyIdx$, keyIdx$, "1"
      tiraJmpCond "JLE", keyIdx$, "255", sleepKeyLbl$

      IF hasArg = 1 THEN
        tiraOp TC_SUB, delayMilliseconds$, delayMilliseconds$, "10"
        tiraJmpCond "JG", delayMilliseconds$, "0", sleepWaitLbl$
      ELSE
        tiraJmp sleepWaitLbl$
      END IF

      tiraLabel doneLbl$
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_DELAY_Core = 1

END FUNCTION ' parse_DELAY_Core

''''''''''''''''''''''''
FUNCTION parse_DEVICE$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM descPtr$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_DEVICE$", 3) = 0 THEN
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("DEVICE", "_DSC")
  IF scratchName$ = "" THEN
    parse_DEVICE$ = ""
    EXIT FUNCTION
  END IF

  descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign descPtr$, scratchName$

  tiraCall "RT_DEVICE", 2, arg1$ + ", " + descPtr$

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_DEVICE$ = scratchName$

END FUNCTION ' parse_DEVICE$

''''''''''''''''''''''''
FUNCTION parse_DEVICEINPUT$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM scratchName$
  DIM resVar$

  IF checkIntrinsicSyntax(startIdx, endIdx, "_DEVICEINPUT", 3) = 0 THEN
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  arg1$ = tiraParseExpressionInt$(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF arg1$ = "" THEN
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF

  scratchName$ = tiraResolveHoistVar$("DEVINP", "_VAL")
  IF scratchName$ = "" THEN
    parse_DEVICEINPUT$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraCall "RT_DEVICEINPUT", 1, arg1$
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEVICEINPUT$ = scratchName$

END FUNCTION ' parse_DEVICEINPUT$

''''''''''''''''''''''''
FUNCTION parse_DEVICES$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DEVICES", ASIS, 0
    parse_DEVICES$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("DEVICES", "_VAL")
  IF scratchName$ = "" THEN
    parse_DEVICES$ = ""
    EXIT FUNCTION
  END IF

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  tiraCall "RT_DEVICES", 0, ""
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DEVICES$ = scratchName$

END FUNCTION ' parse_DEVICES$

''''''''''''''''''''''''
FUNCTION parse_DESKTOPHEIGHT$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM resVar$

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _DESKTOPHEIGHT", ASIS, 0
    parse_DESKTOPHEIGHT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchName$ = tiraResolveHoistVar$("DKHGT", "_VAL")
  IF scratchName$ = "" THEN
    parse_DESKTOPHEIGHT$ = ""
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(scratchName$)
  IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_LONG

  resVar$ = tiraDimVar$("T", TYPE_LONG)

  tiraCall "IAT_GETSYSTEMMETRICS", 1, "1"
  tiraNew TC_GET_RET, resVar$

  tiraAssign scratchName$, resVar$

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_DESKTOPHEIGHT$ = scratchName$

END FUNCTION ' parse_DESKTOPHEIGHT$

