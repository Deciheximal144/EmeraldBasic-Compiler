  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 4500, povUpLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 31500, povUpLblIdx
  tiraJmpId povUpDoneLblIdx

  tiraLabelId povUpLblIdx
  tiraAssignId leftYIdx, TIRA_ARG_LITERAL, 32767

  tiraLabelId povUpDoneLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 4500, povRightDoneLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 13500, povRightDoneLblIdx
  tiraAssignId leftXIdx, TIRA_ARG_LITERAL, 32767

  tiraLabelId povRightDoneLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 13500, povDownDoneLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 22500, povDownDoneLblIdx
  tiraAssignId leftYIdx, TIRA_ARG_LITERAL, -32768

  tiraLabelId povDownDoneLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 22500, povLeftDoneLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, povValIdx, TIRA_ARG_LITERAL, 31500, povLeftDoneLblIdx
  tiraAssignId leftXIdx, TIRA_ARG_LITERAL, -32768

  tiraLabelId povLeftDoneLblIdx
  tiraLabelId povDoneLblIdx

  buttonsValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId buttonsValIdx, TIRA_ARG_LITERAL, 0
  buttonTestIdx = tiraDimVarId&("T", TYPE_LONG)

  button1DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN1_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button1DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 16384
  tiraLabelId button1DoneLblIdx

  button2DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN2_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 2
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button2DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 8192
  tiraLabelId button2DoneLblIdx

  button3DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN3_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button3DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 4096
  tiraLabelId button3DoneLblIdx

  button4DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN4_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 8
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button4DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 32768
  tiraLabelId button4DoneLblIdx

  button5DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN5_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 16
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button5DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 256
  tiraLabelId button5DoneLblIdx

  button6DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN6_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 32
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button6DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 512
  tiraLabelId button6DoneLblIdx

  button9DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN9_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 256
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button9DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 32
  tiraLabelId button9DoneLblIdx

  button10DoneLblIdx = tiraLabelCreateNewId&("DEVIN_BTN10_DONE")
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_SYMBOL, rawButtonsIdx, TIRA_ARG_LITERAL, 512
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, buttonTestIdx, TIRA_ARG_LITERAL, 0, button10DoneLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_SYMBOL, buttonsValIdx, TIRA_ARG_LITERAL, 16
  tiraLabelId button10DoneLblIdx

  packetValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId packetValIdx, TIRA_ARG_SYMBOL, buttonsValIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_LITERAL, 31
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, leftXIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_LITERAL, 31
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, leftYIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_LITERAL, 31
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, rightXIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_LITERAL, 31
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, rightYIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_LITERAL, 31
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, packetValIdx, TIRA_ARG_SYMBOL, povValIdx

  joyUserIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, joyUserIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_LITERAL, 16

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, oldValidIdx, TIRA_ARG_LITERAL, 0, joyChangedLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, oldUserIdx, TIRA_ARG_SYMBOL, joyUserIdx, joyChangedLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, oldPacketIdx, TIRA_ARG_SYMBOL, packetValIdx, joyChangedLblIdx
  tiraJmpId joyCacheLblIdx

  tiraLabelId joyChangedLblIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId joyCacheLblIdx
  tiraAssignId gamepadValidIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId gamepadUserIdx, TIRA_ARG_SYMBOL, joyUserIdx
  tiraAssignId gamepadPacketIdx, TIRA_ARG_SYMBOL, packetValIdx
  tiraAssignId gamepadButtonsIdx, TIRA_ARG_SYMBOL, buttonsValIdx
  tiraAssignId gamepadLtIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadRtIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadLxIdx, TIRA_ARG_SYMBOL, leftXIdx
  tiraAssignId gamepadLyIdx, TIRA_ARG_SYMBOL, leftYIdx
  tiraAssignId gamepadRxIdx, TIRA_ARG_SYMBOL, rightXIdx
  tiraAssignId gamepadRyIdx, TIRA_ARG_SYMBOL, rightYIdx
  tiraJmpId doneLblIdx

  tiraLabelId notFoundLblIdx
  tiraAssignId gamepadValidIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadUserIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadPacketIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadButtonsIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadLtIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadRtIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadLxIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadLyIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadRxIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId gamepadRyIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId doneLblIdx
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, heapMarkIdx
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeDeviceInput

''''''''''''''''''''''''
SUB emitRuntimeInput

  DIM textRowHeight AS LONG
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM arg3VarIdx AS LONG
  DIM arg4VarIdx AS LONG
  DIM arg5VarIdx AS LONG
  DIM targetAddrVarIdx AS LONG
  DIM isStrVarVarIdx AS LONG
  DIM promptPtrVarIdx AS LONG
  DIM tgtDataTypeVarIdx AS LONG
  DIM suppressNewlineVarIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM bufLenIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM promptDataIdx AS LONG
  DIM promptLenIdx AS LONG
  DIM skipPromptLblIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM lblWaitEnterRel1Idx AS LONG
  DIM entState1Idx AS LONG
  DIM skipSleep1Idx AS LONG
  DIM flushHeadValIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailValIdx AS LONG
  DIM charBufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM charValIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM notBsLblIdx AS LONG
  DIM skipBsLblIdx AS LONG
  DIM skipWrapLblIdx AS LONG
  DIM wrapXIdx AS LONG
  DIM tempXIdx AS LONG
  DIM tempYIdx AS LONG
  DIM spaceAddrIdx AS LONG
  DIM skipKeyIdx AS LONG
  DIM destCharAddrIdx AS LONG
  DIM lblWaitEnterRel2Idx AS LONG
  DIM entState2Idx AS LONG
  DIM skipSleep2Idx AS LONG
  DIM skipCrlfLblIdx AS LONG
  DIM endInputLblIdx AS LONG
  DIM notStrLblIdx AS LONG
  DIM stripLoopIdx AS LONG
  DIM stripDoneIdx AS LONG
  DIM lastCharAddrIdx AS LONG
  DIM lastCharIdx AS LONG
  DIM isCrLfLblIdx AS LONG
  DIM rhsDescIdx AS LONG
  DIM resVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipLoopIdx AS LONG
  DIM skipDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpcLblIdx AS LONG
  DIM signDoneIdx AS LONG
  DIM numLoopTopIdx AS LONG
  DIM numLoopDoneIdx AS LONG
  DIM applySignDoneIdx AS LONG
  DIM lblSingleIdx AS LONG
  DIM lblDoubleIdx AS LONG
  DIM lblByteIdx AS LONG
  DIM lblIntIdx AS LONG
  DIM lblLongIdx AS LONG
  DIM lblWriteDoneIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM gfxFontHeightIdx AS LONG
  DIM kbdHeadIdx AS LONG
  DIM kbdTailIdx AS LONG
  DIM kbdBufferIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM rtPrintStrIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM readFileIdx AS LONG
  DIM gfxAppendIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG
  DIM sleepIdx AS LONG
  DIM crlfIdx AS LONG
  DIM strAssignIdx AS LONG

  rtOffset(RT_INPUT) = stream.emitPos

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN EXIT SUB
  tempHeapIdx = returnedData2

  ff = resolveSymbol("RT_STR_ASSIGN")
  IF ff = 0 THEN EXIT SUB
  strAssignIdx = returnedData2

  IF cm.HasGraphics = 0 THEN
    ff = resolveSymbol("RT_PRINT_STR")
    IF ff = 0 THEN EXIT SUB
    rtPrintStrIdx = returnedData2

    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN EXIT SUB
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_READFILE")
    IF ff = 0 THEN EXIT SUB
    readFileIdx = returnedData2
  ELSE
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN EXIT SUB
    gfxFontHeightIdx = returnedData2

    ff = resolveSymbol("RT_GFX_APPEND")
    IF ff = 0 THEN EXIT SUB
    gfxAppendIdx = returnedData2

    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN EXIT SUB
    swapBuffersIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN EXIT SUB
    kbdHeadIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN EXIT SUB
    kbdTailIdx = returnedData2

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN EXIT SUB
    kbdBufferIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN EXIT SUB
    textXIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN EXIT SUB
    textYIdx = returnedData2

    ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
    IF ff = 0 THEN EXIT SUB
    getAsyncKeyStateIdx = returnedData2

    ff = resolveSymbol("IAT_SLEEP")
    IF ff = 0 THEN EXIT SUB
    sleepIdx = returnedData2

    ff = resolveSymbol("RT_CRLF")
    IF ff = 0 THEN EXIT SUB
    crlfIdx = returnedData2
  END IF

  tira_Start
  tiraRT_PrologueId

  ' Capture incoming ABI hardware registers into TIRA accessible global memory slots
  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1
  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId arg2VarIdx, 2
  arg3VarIdx = tiraDimVarId&("ARG3", TYPE_INTEGER64)
  tiraAbiReadArgId arg3VarIdx, 3
  arg4VarIdx = tiraDimVarId&("ARG4", TYPE_LONG)
  tiraAbiReadArgId arg4VarIdx, 4
  arg5VarIdx = tiraDimVarId&("ARG5", TYPE_LONG)
  tiraAbiReadArgId arg5VarIdx, 5

  ' Cache the arguments securely to survive nested runtime calls which will clobber the !G_SYS_RT_ARG slots
  targetAddrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId targetAddrVarIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  isStrVarVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isStrVarVarIdx, TIRA_ARG_SYMBOL, arg2VarIdx

  promptPtrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId promptPtrVarIdx, TIRA_ARG_SYMBOL, arg3VarIdx

  tgtDataTypeVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId tgtDataTypeVarIdx, TIRA_ARG_SYMBOL, arg4VarIdx

  suppressNewlineVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId suppressNewlineVarIdx, TIRA_ARG_SYMBOL, arg5VarIdx

  ' Allocate a pristine 1024 byte buffer directly on the temporary heap
  bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId bufPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1024
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, bufPtrIdx

  bufLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId bufLenIdx, TIRA_ARG_LITERAL, 0

  IF cm.HasGraphics = 0 THEN
    ' Console mode logic
    tiraCallId1 rtPrintStrIdx, TIRA_ARG_SYMBOL, promptPtrVarIdx

    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -10
    tiraGetRetId hndVarIdx

    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx

    tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1024, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics mode delta rendering logic
    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, gfxFontHeightIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("INPUT_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx

    promptDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, promptPtrVarIdx)
    promptLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, promptPtrVarIdx)

    ' Print the prompt string directly to the screen immediately
    skipPromptLblIdx = tiraLabelCreateNewId&("INP_SKIP_PRMPT")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, promptLenIdx, TIRA_ARG_LITERAL, 0, skipPromptLblIdx
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, promptDataIdx, TIRA_ARG_SYMBOL, promptLenIdx
    tiraLabelId skipPromptLblIdx

    ' Unconditionally flush the screen buffer before blocking execution so prior PRINT statements are visible
    tiraCallId0 swapBuffersIdx

    ' Fetch pointer structures for reading directly from the OS queue
    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, kbdHeadIdx
    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, kbdTailIdx

    ' Spinlock: wait for ENTER to be released BEFORE capturing input to prevent skipping
    lblWaitEnterRel1Idx = tiraLabelCreateNewId&("INP_WAIT_REL1")
    tiraLabelId lblWaitEnterRel1Idx
    tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 13
    entState1Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId entState1Idx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, entState1Idx, TIRA_ARG_SYMBOL, entState1Idx, TIRA_ARG_LITERAL, 32768
    skipSleep1Idx = tiraLabelCreateNewId&("INP_SS1")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, entState1Idx, TIRA_ARG_LITERAL, 0, skipSleep1Idx
    tiraCallId1 sleepIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId lblWaitEnterRel1Idx
    tiraLabelId skipSleep1Idx

    ' Flush the OS keyboard ring buffer to clear ghost type-ahead keys completely
    flushHeadValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId flushHeadValIdx, TIRA_ARG_SYMBOL, headPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, flushHeadValIdx, TIRA_ARG_LITERAL, 4

    ' Ultra-fast spin loop (No IAT_SLEEP latency penalty for responsive typing)
    loopTopIdx = tiraLabelCreateNewId&("INP_LOOP")
    tiraLabelId loopTopIdx

    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, loopTopIdx

    ' Read Char from the tail
    charBufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, charBufPtrIdx, TIRA_ARG_SYMBOL, kbdBufferIdx

    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, charBufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    charByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charAddrIdx

    charValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId charValIdx, TIRA_ARG_SYMBOL, charByteIdx

    ' Advance Tail
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    doneLblIdx = tiraLabelCreateNewId&("INP_DONE")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 13, doneLblIdx ' Enter key finishes the routine

    notBsLblIdx = tiraLabelCreateNewId&("INP_NOT_BS")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 8, notBsLblIdx ' Backspace key

    ' Backspace logic
    skipBsLblIdx = tiraLabelCreateNewId&("INP_SKIP_BS")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, skipBsLblIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1

    ' Step cursor backward by one character width (8 pixels)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_LITERAL, 8
    skipWrapLblIdx = tiraLabelCreateNewId&("INP_SKIP_WRAP")
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_LITERAL, 0, skipWrapLblIdx
    wrapXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId wrapXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, wrapXIdx, TIRA_ARG_LITERAL, 8
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    tiraLabelId skipWrapLblIdx

    ' Save Cursor
    tempXIdx = tiraDimVarId&("T", TYPE_LONG)
    tempYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId tempXIdx, TIRA_ARG_SYMBOL, textXIdx
    tiraAssignId tempYIdx, TIRA_ARG_SYMBOL, textYIdx

    ' Erase with Space
    spaceAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, spaceAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, spaceAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, spaceAddrIdx, TIRA_ARG_LITERAL, 1

    ' Restore Cursor
    tiraAssignId textXIdx, TIRA_ARG_SYMBOL, tempXIdx
    tiraAssignId textYIdx, TIRA_ARG_SYMBOL, tempYIdx

    tiraCallId0 swapBuffersIdx

    tiraLabelId skipBsLblIdx
    tiraJmpId loopTopIdx

    ' Printable char logic
    tiraLabelId notBsLblIdx

    ' Only append if printable ASCII (32 to 126)
    skipKeyIdx = tiraLabelCreateNewId&("INP_SKIP")
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 32, skipKeyIdx
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 126, skipKeyIdx

    destCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destCharAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, destCharAddrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1

    ' Delta Render: Append the single new character directly to the screen
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, destCharAddrIdx, TIRA_ARG_LITERAL, 1
    tiraCallId0 swapBuffersIdx

    tiraLabelId skipKeyIdx
    tiraJmpId loopTopIdx

    tiraLabelId doneLblIdx

    ' Spinlock: wait for ENTER to be released after submitting input
    lblWaitEnterRel2Idx = tiraLabelCreateNewId&("INP_WAIT_REL2")
    tiraLabelId lblWaitEnterRel2Idx
    tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 13
    entState2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId entState2Idx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, entState2Idx, TIRA_ARG_SYMBOL, entState2Idx, TIRA_ARG_LITERAL, 32768
    skipSleep2Idx = tiraLabelCreateNewId&("INP_SS2")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, entState2Idx, TIRA_ARG_LITERAL, 0, skipSleep2Idx
    tiraCallId1 sleepIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId lblWaitEnterRel2Idx
    tiraLabelId skipSleep2Idx

    skipCrlfLblIdx = tiraLabelCreateNewId&("INP_SKIP_CRLF")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, suppressNewlineVarIdx, TIRA_ARG_LITERAL, 0, skipCrlfLblIdx
    tiraCallId0 crlfIdx
    tiraLabelId skipCrlfLblIdx
  END IF

  endInputLblIdx = tiraLabelCreateNewId&("INP_END")
  notStrLblIdx = tiraLabelCreateNewId&("INP_NOT_STR")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isStrVarVarIdx, TIRA_ARG_LITERAL, 0, notStrLblIdx

  ' Handle string variable assignment
  stripLoopIdx = tiraLabelCreateNewId&("INP_STRIP")
  stripDoneIdx = tiraLabelCreateNewId&("INP_STRIP_DONE")

  tiraLabelId stripLoopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, stripDoneIdx

  lastCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, lastCharAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, lastCharAddrIdx, TIRA_ARG_SYMBOL, lastCharAddrIdx, TIRA_ARG_LITERAL, 1
  lastCharIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId lastCharIdx, TIRA_ARG_SYMBOL, lastCharAddrIdx

  isCrLfLblIdx = tiraLabelCreateNewId&("INP_ISCRLF")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, lastCharIdx, TIRA_ARG_LITERAL, 13, isCrLfLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, lastCharIdx, TIRA_ARG_LITERAL, 10, stripDoneIdx

  tiraLabelId isCrLfLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId stripLoopIdx
  tiraLabelId stripDoneIdx

  ' Build a 24-byte fake descriptor dynamically
  rhsDescIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId rhsDescIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, rhsDescIdx, TIRA_ARG_SYMBOL, rhsDescIdx, TIRA_ARG_LITERAL, 24
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, rhsDescIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, rhsDescIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0

  tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, rhsDescIdx
  tiraJmpId endInputLblIdx

  ' Handle numeric variable assignment
  tiraLabelId notStrLblIdx

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipLoopIdx = tiraLabelCreateNewId&("INP_NSKIP")
  skipDoneIdx = tiraLabelCreateNewId&("INP_NSKIP_DN")

  tiraLabelId skipLoopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, skipDoneIdx
  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx

  isSpcLblIdx = tiraLabelCreateNewId&("INP_ISSPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpcLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 13, isSpcLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 10, isSpcLblIdx
  tiraJmpId skipDoneIdx

  tiraLabelId isSpcLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipLoopIdx

  tiraLabelId skipDoneIdx

  signDoneIdx = tiraLabelCreateNewId&("VAL_SGN_DONE")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, signDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, signDoneIdx ' -
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId signDoneIdx

  numLoopTopIdx = tiraLabelCreateNewId&("VAL_NUM_LOOP")
  numLoopDoneIdx = tiraLabelCreateNewId&("VAL_NUM_DONE")

  tiraLabelId numLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, bufPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx ' 0
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, numLoopDoneIdx ' 9

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_SYMBOL, bufLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId numLoopDoneIdx

  applySignDoneIdx = tiraLabelCreateNewId&("VAL_SGN_APP")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, applySignDoneIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId applySignDoneIdx

  lblSingleIdx = tiraLabelCreateNewId&("IS_SNG")
  lblDoubleIdx = tiraLabelCreateNewId&("IS_DBL")
  lblByteIdx = tiraLabelCreateNewId&("IS_BYT")
  lblIntIdx = tiraLabelCreateNewId&("IS_INT")
  lblLongIdx = tiraLabelCreateNewId&("IS_LNG")
  lblWriteDoneIdx = tiraLabelCreateNewId&("WR_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE, lblSingleIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE, lblDoubleIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_BYTE, lblByteIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_UBYTE, lblByteIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_INTEGER, lblIntIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_UINTEGER, lblIntIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_LONG, lblLongIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, tgtDataTypeVarIdx, TIRA_ARG_LITERAL, TYPE_ULONG, lblLongIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 8
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblSingleIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_STR_LITERAL, 32
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblDoubleIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_STR_LITERAL, 64
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblByteIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblIntIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId lblWriteDoneIdx

  tiraLabelId lblLongIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 4

  tiraLabelId lblWriteDoneIdx

  tiraLabelId endInputLblIdx

  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeInput

''''''''''''''''''''''''
SUB emitRuntimeKeyDown

  DIM qb AS LONG
  DIM vk AS LONG
  DIM mapIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG
  DIM kbdStateIdx AS LONG
  DIM arg1VarIdx AS LONG
  DIM qbCodeIdx AS LONG
  DIM tablePtrIdx AS LONG
  DIM countIdx AS LONG
  DIM vkCodeIdx AS LONG
  DIM loopScanStartIdx AS LONG
  DIM jmpDoneScanIdx AS LONG
  DIM curQbIdx AS LONG
  DIM jmpFoundIdx AS LONG
  DIM vkPtrIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM stateAddrIdx AS LONG
  DIM keyByteIdx AS LONG
  DIM retValIdx AS LONG
  DIM jmpIsDownIdx AS LONG
  DIM jmpEndIdx AS LONG

  ' Build the key mapping data as a string payload to sit in the global literal pool
  mapPayload$ = ""
  FOR ii = 0 TO keyMappingCount - 1
    ' Append qbCode (4 bytes)
    qb = keyMapping(ii).qbCode
    mapPayload$ = mapPayload$ + CHR$(qb AND 255) + CHR$((qb \ 256) AND 255) + CHR$((qb \ 65536) AND 255) + CHR$((qb \ 16777216) AND 255)
    ' Append vkCode (4 bytes)
    vk = keyMapping(ii).vkCode
    mapPayload$ = mapPayload$ + CHR$(vk AND 255) + CHR$((vk \ 256) AND 255) + CHR$((vk \ 65536) AND 255) + CHR$((vk \ 16777216) AND 255)
  NEXT

  ff = resolveSymbol("!G_INO_DSC_KEYMAP")
  IF ff = 0 THEN EXIT SUB
  mapIdx = returnedData2
  strVarData$(mapIdx) = mapPayload$

  '''' RT_KEYDOWN
  rtOffset(RT_KEYDOWN) = stream.emitPos

  IF cm.HasGraphics = 0 THEN
    ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
    IF ff = 0 THEN EXIT SUB
    getAsyncKeyStateIdx = returnedData2
  ELSE
    ff = resolveSymbol("!G_INO_ARR_KBD_STATE")
    IF ff = 0 THEN EXIT SUB
    kbdStateIdx = returnedData2
  END IF

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1VarIdx, 1

  ' Load the requested key code
  qbCodeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId qbCodeIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  ' Extract the data pointer from the string descriptor
  tablePtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, mapIdx)

  ' Counter for mapped items
  countIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId countIdx, TIRA_ARG_LITERAL, keyMappingCount

  vkCodeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId vkCodeIdx, TIRA_ARG_SYMBOL, qbCodeIdx

  loopScanStartIdx = tiraLabelCreateNewId&("KD_SCAN_LOOP")
  jmpDoneScanIdx = tiraLabelCreateNewId&("KD_SCAN_DONE")

  tiraLabelId loopScanStartIdx

  ' If mapped items remain <= 0, we're done (not found in table)
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, countIdx, TIRA_ARG_LITERAL, 0, jmpDoneScanIdx

  ' Compare table[index].qbCode with the requested code
  curQbIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId curQbIdx, TIRA_ARG_SYMBOL, tablePtrIdx

  jmpFoundIdx = tiraLabelCreateNewId&("KD_FOUND")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, curQbIdx, TIRA_ARG_SYMBOL, qbCodeIdx, jmpFoundIdx

  ' Advance to next 8-byte entry (qbCode + vkCode layout)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tablePtrIdx, TIRA_ARG_SYMBOL, tablePtrIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, countIdx, TIRA_ARG_SYMBOL, countIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopScanStartIdx

  ' Match found, extract table[index].vkCode
  tiraLabelId jmpFoundIdx
  vkPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vkPtrIdx, TIRA_ARG_SYMBOL, tablePtrIdx, TIRA_ARG_LITERAL, 4
  tiraReadMemId vkCodeIdx, TIRA_ARG_SYMBOL, vkPtrIdx

  tiraLabelId jmpDoneScanIdx

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, vkCodeIdx, TIRA_ARG_SYMBOL, vkCodeIdx, TIRA_ARG_LITERAL, 255

  keyStateIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId keyStateIdx, TIRA_ARG_LITERAL, 0

  IF cm.HasGraphics = 0 THEN
    ' Console mode has no WndProc to populate the keyboard-state array
    tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_SYMBOL, vkCodeIdx
    tiraGetRetId keyStateIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 32768
  ELSE
    ' Setup layout state extraction directly from the WndProc populated array
    stateAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateAddrIdx, TIRA_ARG_SYMBOL, kbdStateIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, stateAddrIdx, TIRA_ARG_SYMBOL, stateAddrIdx, TIRA_ARG_SYMBOL, vkCodeIdx

    keyByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId keyByteIdx, TIRA_ARG_SYMBOL, stateAddrIdx

    tiraAssignId keyStateIdx, TIRA_ARG_SYMBOL, keyByteIdx
  END IF

  retValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId retValIdx, TIRA_ARG_LITERAL, 0

  jmpIsDownIdx = tiraLabelCreateNewId&("KD_IS_DOWN")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, jmpIsDownIdx

  ' Not down (return 0)
  jmpEndIdx = tiraLabelCreateNewId&("KD_END")
  tiraJmpId jmpEndIdx

  tiraLabelId jmpIsDownIdx
  ' Is down (return -1)
  tiraAssignId retValIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId jmpEndIdx

  ' Route return value to arg1Var$ so it can be extracted to RAX cleanly
  tiraAssignId arg1VarIdx, TIRA_ARG_SYMBOL, retValIdx

  tiraAbiWriteRetId arg1VarIdx
  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeKeyDown

''''''''''''''''''''''''
SUB emitRuntimeKeyEvent

  ' Polls enabled predefined ON KEY events and dispatches one handler

  DIM keyAnyIdx AS LONG
  DIM keyActiveIdx AS LONG
  DIM keyHandlerIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM gosubBaseIdx AS LONG
  DIM gosubIndexIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM scanTopLblIdx AS LONG
  DIM scanNextLblIdx AS LONG
  DIM pollKeyLblIdx AS LONG
  DIM f1ToF10LblIdx AS LONG
  DIM upKeyLblIdx AS LONG
  DIM leftKeyLblIdx AS LONG
  DIM rightKeyLblIdx AS LONG
  DIM downKeyLblIdx AS LONG
  DIM keyMappedLblIdx AS LONG
  DIM keyPressedLblIdx AS LONG
  DIM dispatchLblIdx AS LONG
  DIM eventReturnLblIdx AS LONG
  DIM handlerBaseIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM eventIndexIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM stateValueIdx AS LONG
  DIM modeValueIdx AS LONG
  DIM pendingValueIdx AS LONG
  DIM latchValueIdx AS LONG
  DIM keyCodeIdx AS LONG
  DIM keyBitsIdx AS LONG
  DIM handlerSlotIdx AS LONG
  DIM handlerAddressIdx AS LONG
  DIM retAddrVarIdx AS LONG
  DIM gosubBaseVarIdx AS LONG
  DIM gosubSlotVarIdx AS LONG

  rtOffset(RT_KEY_EVENT) = stream.emitPos

  ff = resolveSymbol("!G_INO_FLG_KEYANY")
  IF ff = 0 THEN EXIT SUB
  keyAnyIdx = returnedData2

  ff = resolveSymbol("!G_INO_FLG_KEYACTIVE")
  IF ff = 0 THEN EXIT SUB
  keyActiveIdx = returnedData2

  ff = resolveSymbol("!G_INO_ARR_KEYHANDLER")
  IF ff = 0 THEN EXIT SUB
  keyHandlerIdx = returnedData2

  ff = resolveSymbol("!G_INO_ARR_KEYSTATE")
  IF ff = 0 THEN EXIT SUB
  keyStateIdx = returnedData2

  ff = resolveSymbol("!G_SYS_ARR_GOSUB")
  IF ff = 0 THEN EXIT SUB
  gosubBaseIdx = returnedData2

  ff = resolveSymbol("!G_SYS_IDX_GOSUB")
  IF ff = 0 THEN EXIT SUB
  gosubIndexIdx = returnedData2

  ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
  IF ff = 0 THEN EXIT SUB
  getAsyncKeyStateIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  doneLblIdx = tiraLabelCreateNewId&("KEY_EVENT_DONE")
  scanTopLblIdx = tiraLabelCreateNewId&("KEY_EVENT_SCAN")
  scanNextLblIdx = tiraLabelCreateNewId&("KEY_EVENT_NEXT")
  pollKeyLblIdx = tiraLabelCreateNewId&("KEY_EVENT_POLL")
  f1ToF10LblIdx = tiraLabelCreateNewId&("KEY_EVENT_F1_F10")
  upKeyLblIdx = tiraLabelCreateNewId&("KEY_EVENT_UP")
  leftKeyLblIdx = tiraLabelCreateNewId&("KEY_EVENT_LEFT")
  rightKeyLblIdx = tiraLabelCreateNewId&("KEY_EVENT_RIGHT")
  downKeyLblIdx = tiraLabelCreateNewId&("KEY_EVENT_DOWN")
  keyMappedLblIdx = tiraLabelCreateNewId&("KEY_EVENT_MAPPED")
  keyPressedLblIdx = tiraLabelCreateNewId&("KEY_EVENT_PRESSED")
  dispatchLblIdx = tiraLabelCreateNewId&("KEY_EVENT_DISPATCH")
  eventReturnLblIdx = tiraLabelCreateNewId&("KEY_EVENT_RETURN")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, keyAnyIdx, TIRA_ARG_LITERAL, 0, doneLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, keyActiveIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  handlerBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlerBaseIdx, TIRA_ARG_SYMBOL, keyHandlerIdx

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, keyStateIdx

  eventIndexIdx = tiraDimVarId&("T", TYPE_UINT64)
  tiraAssignId eventIndexIdx, TIRA_ARG_LITERAL, 0

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  stateValueIdx = tiraDimVarId&("T", TYPE_UINT64)
  modeValueIdx = tiraDimVarId&("T", TYPE_UINT64)
  pendingValueIdx = tiraDimVarId&("T", TYPE_UINT64)
  latchValueIdx = tiraDimVarId&("T", TYPE_UINT64)
  keyCodeIdx = tiraDimVarId&("T", TYPE_LONG)
  keyBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  handlerSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  handlerAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  retAddrVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  gosubBaseVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  gosubSlotVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraLabelId scanTopLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, KEY_EVENT_COUNT, doneLblIdx

  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES
  tiraReadMemId stateValueIdx, TIRA_ARG_SYMBOL, stateSlotIdx

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, modeValueIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_MODE_MASK
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, modeValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_MODE_OFF, scanNextLblIdx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, modeValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_MODE_ON, pollKeyLblIdx
