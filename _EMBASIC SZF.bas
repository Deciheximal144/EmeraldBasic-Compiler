''''''''''''''''''''''''
FUNCTION retLabelStripLength$ (passLine$)

  returnExtraPrepare

  '''' Analyzes the line to find any valid label prefix and returns the string, and length via return2
  ' Used by the compile* functions

  isLabel = 0
  tempLabelStr$ = ""
  stripLen = 0

  IF LEN(passLine$) = 0 THEN
    return2 0
    retLabelStripLength$ = ""
    EXIT FUNCTION
  END IF

  firstCharAs = ASC(passLine$, 1)
  IF firstCharAs >= 48 AND firstCharAs <= 57 THEN
    tempStrip = 0
    FOR ii = 1 TO LEN(passLine$)
      cAs = ASC(passLine$, ii)
      IF cAs >= 48 AND cAs <= 57 THEN
        tempStrip = tempStrip + 1
      ELSE
        EXIT FOR
      END IF
    NEXT
    isLabel = 1
    stripLen = tempStrip
    IF tempStrip < LEN(passLine$) THEN
      IF ASC(passLine$, tempStrip + 1) = 58 THEN ' :
        stripLen = tempStrip + 1
      END IF
    END IF
    IF isLabel = 1 THEN tempLabelStr$ = LEFT$(passLine$, tempStrip)
  ELSE
    IF (firstCharAs >= 65 AND firstCharAs <= 90) OR (firstCharAs >= 97 AND firstCharAs <= 122) THEN
      tempStrip = 0
      FOR ii = 1 TO LEN(passLine$)
        cAs = ASC(passLine$, ii)
        IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR (cAs >= 48 AND cAs <= 57) OR cAs = 95 THEN
          tempStrip = tempStrip + 1
        ELSE
          EXIT FOR
        END IF
      NEXT
      IF tempStrip < LEN(passLine$) THEN
        IF ASC(passLine$, tempStrip + 1) = 58 THEN
          isLabel = 1
          tempLabel$ = UCASE$(LEFT$(passLine$, tempStrip))

          ff = findKeywordIndex(tempLabel$)
          IF ff = 1 THEN isLabel = 0

          IF isLabel = 1 THEN
            tempLabelStr$ = tempLabel$
            stripLen = tempStrip + 1
          END IF
        END IF
      END IF
    END IF
  END IF

  IF isLabel = 0 THEN
    return2 0
    retLabelStripLength$ = ""
  ELSE
    return2 stripLen
    retLabelStripLength$ = tempLabelStr$
  END IF

END FUNCTION ' retLabelStripLength$

''''''''''''''''''''''''
FUNCTION retLineNumberStr$

  ' Returns the current line number as a formatted string
  DIM sourceLine AS LONG
  displayLine$ = LTRIM$(RTRIM$(STR$(currentLineNumber)))

  IF pass5.Mode <> PASS5_MODE_NONE THEN
    IF pass5.LINE >= 1 AND pass5.LINE <= compileLastLine THEN
      IF editorLineLinkMap(pass5.LINE) = currentLineNumber THEN
        sourceLine = includeSourceLineMap(pass5.LINE)
        IF sourceLine > 0 THEN
          sourceFile$ = extractQuotes$(editorText$(currentLineNumber))
          displayLine$ = LTRIM$(STR$(sourceLine)) + " (" + sourceFile$ + ")"
        END IF
      END IF
    END IF
  END IF

  retLineNumberStr$ = displayLine$

END FUNCTION ' retLineNumberStr$

''''''''''''''''''''''''
FUNCTION retRoutineBaseName$ (passName$)

  baseName$ = RTRIM$(passName$)
  lastTwo$ = RIGHT$(baseName$, 2)

  IF lastTwo$ = "&&" THEN
    baseName$ = LEFT$(baseName$, LEN(baseName$) - 2)
  ELSE
    lastChar$ = RIGHT$(baseName$, 1)
    IF lastChar$ = "$" OR lastChar$ = "%" OR lastChar$ = "&" OR lastChar$ = "!" OR lastChar$ = "#" THEN
      baseName$ = LEFT$(baseName$, LEN(baseName$) - 1)
    END IF

    lastChar$ = RIGHT$(baseName$, 1)
    IF lastChar$ = "~" THEN
      baseName$ = LEFT$(baseName$, LEN(baseName$) - 1)
    END IF
  END IF

  retRoutineBaseName$ = baseName$

END FUNCTION ' retRoutineBaseName$

''''''''''''''''''''''''
FUNCTION retRoutineDeclarationExists (passName$)

  ' Checks the current source stream for a matching SUB or FUNCTION declaration
  ' This resolves the identifier-colon ambiguity before routine symbols are registered

  DIM firstCharAs AS LONG
  DIM hashValue AS LONG
  DIM checkIdx AS LONG

  searchName$ = UCASE$(LTRIM$(RTRIM$(passName$)))

  IF searchName$ = "" THEN
    retRoutineDeclarationExists = 0
    EXIT FUNCTION
  END IF

  firstCharAs = ASC(searchName$, 1)

  IF firstCharAs >= 48 AND firstCharAs <= 57 THEN
    retRoutineDeclarationExists = 0
    EXIT FUNCTION
  END IF

  hashValue = hashString(searchName$)
  checkIdx = routineDeclHash(hashValue)

  DO WHILE checkIdx <> NO_VALID_INDEX
    IF routineDeclName$(checkIdx) = searchName$ THEN
      retRoutineDeclarationExists = 1
      EXIT FUNCTION
    END IF

    checkIdx = routineDeclHashNext(checkIdx)
  LOOP

  retRoutineDeclarationExists = 0

END FUNCTION ' retRoutineDeclarationExists

