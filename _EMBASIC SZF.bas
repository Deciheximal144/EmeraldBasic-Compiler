  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_SYMBOL, keyCodeIdx
  tiraGetRetId keyBitsIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyBitsIdx, TIRA_ARG_SYMBOL, keyBitsIdx, TIRA_ARG_LITERAL, KEY_EVENT_DOWN_MASK
