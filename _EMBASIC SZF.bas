SUB tiraClampId (varVal AS LONG, minType AS LONG, minVal AS _INTEGER64, maxType AS LONG, maxVal AS _INTEGER64)

  tiraCheckActive ("tiraClampId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM skipMinLblIdx AS LONG
  DIM skipMaxLblIdx AS LONG

  IF minType <> TA_EMPTY THEN
    skipMinLblIdx = tiraLabelCreateNewId&("CLAMP_MIN")
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, varVal, minType, minVal, skipMinLblIdx
