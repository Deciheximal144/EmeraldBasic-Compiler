'''''''''''''''''''''''
SUB syncSymbolHashIndex

  DIM hVal AS LONG
  DIM vIdx AS LONG
  DIM recordName$

  IF symIndexedSymbolCount > symbolCount THEN
    rebuildSymbolHash
    EXIT SUB
  END IF

  IF symIndexedSymbolCount < symbolCount THEN
    FOR vIdx = symIndexedSymbolCount TO symbolCount - 1
      symHashNext(vIdx) = NO_VALID_INDEX
      scopeSymbolNext(vIdx) = 0

      recordName$ = RTRIM$(symbols(vIdx).RecordName)

      IF recordName$ <> "" THEN
        hVal = hashSymbolString(recordName$)
        indexSymbolHash vIdx, hVal
      END IF
    NEXT

    symIndexedSymbolCount = symbolCount
  END IF

END SUB ' syncSymbolHashIndex

'''''''''''''''''''''''
SUB tasm_DoCast (destType AS LONG, destVal AS _INTEGER64, srcType AS LONG, srcVal AS _INTEGER64)

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_DoCast: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  DIM dtDest AS LONG
  DIM dtSrc AS LONG
  DIM isFloat AS LONG

  dtDest = tasm_GetOperandType(destType, destVal)
  dtSrc = tasm_GetOperandType(srcType, srcVal)

  IF dtDest = TYPE_STRING OR dtSrc = TYPE_STRING THEN
    throwCompilerError "CANNOT CAST STRINGS", ASIS, 0
    EXIT SUB
  END IF

  isFloat = tasm_LoadOperand(srcType, srcVal, 0)

  tasm_StoreOperand destType, destVal, 0, isFloat

END SUB ' tasm_DoCast

''''''''''''''''''''''''
FUNCTION tasm_DoJumpCond (condType AS LONG, condVal AS _INTEGER64, src1Type AS LONG, src1Val AS _INTEGER64, src2Type AS LONG, src2Val AS _INTEGER64, tgtType AS LONG, tgtVal AS _INTEGER64)

  IF t.IsActive <> 2 THEN
    throwCompilerError "tasm_DoJumpCond: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    tasm_DoJumpCond = 0
    EXIT FUNCTION
  END IF

  DIM dt1 AS LONG
  DIM dt2 AS LONG
  DIM isFloat1 AS LONG
  DIM isFloat2 AS LONG
  DIM targetMode AS LONG
  DIM opModeFloat AS LONG
  DIM pushedDummy AS LONG
  DIM jmpType AS LONG
  DIM vIdx AS LONG
  DIM isUnsigned AS LONG

  IF tgtType <> TIRA_ARG_LABEL THEN
    throwCompilerError "Internal jump targets must use valid PRS LABEL", ASIS, 0
    tasm_DoJumpCond = 0
    EXIT FUNCTION
  END IF

  dt1 = tasm_GetOperandType(src1Type, src1Val)
  dt2 = tasm_GetOperandType(src2Type, src2Val)

  isUnsigned = 0
  IF dt1 = TYPE_UBYTE OR dt1 = TYPE_UINTEGER OR dt1 = TYPE_ULONG OR dt1 = TYPE_UINT64 THEN isUnsigned = 1
  IF dt2 = TYPE_UBYTE OR dt2 = TYPE_UINTEGER OR dt2 = TYPE_ULONG OR dt2 = TYPE_UINT64 THEN isUnsigned = 1

  isFloat1 = tasm_LoadOperand(src1Type, src1Val, 0)
  isFloat2 = tasm_LoadOperand(src2Type, src2Val, 3)

  IF dt1 = TYPE_STRING AND dt2 = TYPE_STRING THEN
    opPushReg 1
    opPushReg 2

    ' String Compare Block
    ' Move descriptors from RAX(0) and RBX(3) into RCX(1) and RDX(2) for ABI
    ff = opMov(OP_TYPE_REG, 1, OP_TYPE_REG, 0, 64)
    ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, 3, 64)

    pushedDummy = 0
    IF updateStackAlignment = 0 THEN
      opPushReg 13
      pushedDummy = 1
    END IF

    ' Allocate 32 bytes shadow space to prevent prologue stack corruption
    ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
    stack.currentStackOffset = stack.currentStackOffset + 32
    ff = updateStackAlignment

    rtIsUsed(RT_STR_CMP) = 1
    addPatch PATCH_RT, opCall(0, CALLMODE_REL32), RT_STR_CMP
    IF compileError = 1 THEN
      tasm_DoJumpCond = 0
      EXIT FUNCTION
    END IF

    ' Restore shadow space
    ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
    stack.currentStackOffset = stack.currentStackOffset - 32
    ff = updateStackAlignment

    IF pushedDummy = 1 THEN
      opPopReg 13
    END IF

    opPopReg 2
    opPopReg 1

    ' Result is in RAX (0). Compare with 0.
    ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_IMM, 0, 64)
    jmpType = condVal
  ELSE
    IF isFloat1 > 0 OR isFloat2 > 0 THEN
      ' Match QB64 promotion by using SINGLE unless either operand is DOUBLE
      targetMode = typeDb(TYPE_SINGLE).LoadMode
      IF isFloat1 = typeDb(TYPE_DOUBLE).IsFloat OR isFloat2 = typeDb(TYPE_DOUBLE).IsFloat THEN
        targetMode = typeDb(TYPE_DOUBLE).LoadMode
      END IF

      IF isFloat1 = 0 THEN
        ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, targetMode)
      ELSE
        IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
          ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_SINGLE).LoadMode)
        END IF
      END IF

      IF isFloat2 = 0 THEN
        ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 3, targetMode)
      ELSE
        opModeFloat = typeDb(TYPE_DOUBLE).LoadMode
        IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opModeFloat = typeDb(TYPE_SINGLE).LoadMode
        ff = opSSE(SSE_MOV, OP_TYPE_REG, 1, OP_TYPE_REG, 3, opModeFloat)
        IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
          ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 1, typeDb(TYPE_SINGLE).LoadMode)
        END IF
      END IF

      ff = opSSE(SSE_UCOMI, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)

      jmpType = condVal
      SELECT CASE jmpType

        CASE JCC_JL: jmpType = JCC_JB
        CASE JCC_JLE: jmpType = JCC_JBE
        CASE JCC_JG: jmpType = JCC_JA
        CASE JCC_JGE: jmpType = JCC_JAE

      END SELECT ' jmpType

    ELSE
      ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      jmpType = condVal

      IF isUnsigned = 1 THEN
        SELECT CASE jmpType

          CASE JCC_JL: jmpType = JCC_JB
          CASE JCC_JLE: jmpType = JCC_JBE
          CASE JCC_JG: jmpType = JCC_JA
          CASE JCC_JGE: jmpType = JCC_JAE

        END SELECT ' jmpType
      END IF

    END IF
  END IF

  vIdx = tgtVal
  addPatch PATCH_GOTO, opJcc(jmpType, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), vIdx
  IF compileError = 1 THEN
    tasm_DoJumpCond = 0
    EXIT FUNCTION
  END IF

  tasm_DoJumpCond = 1

END FUNCTION ' tasm_DoJumpCond

''''''''''''''''''''''''
SUB tasm_DoMath (opCmd AS LONG, destType AS LONG, destVal AS _INTEGER64, src1Type AS LONG, src1Val AS _INTEGER64, src2Type AS LONG, src2Val AS _INTEGER64)

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_DoMath: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  ' tasm_ functions are back end functions designed to be called by tira_EndAndProcess, or another tasm_ function
  ' These functions do not sit between a tira_Start and a tira_EndAndProcess. They can output raw assembly

  DIM dtDest AS LONG
  DIM dt1 AS LONG
  DIM dt2 AS LONG
  DIM isFloat1 AS LONG
  DIM isFloat2 AS LONG
  DIM targetMode AS LONG
  DIM resIsFloat AS LONG
  DIM opModeFloat AS LONG
  DIM pushedDummy AS LONG
  DIM isUnsigned AS LONG
  DIM tempBaseIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM jmpSkipSpill AS _UNSIGNED LONG
  DIM jmpSpillDone AS _UNSIGNED LONG
  DIM spillHeadIdx AS LONG
  DIM skipOomLbl AS _UNSIGNED LONG

  dtDest = tasm_GetOperandType(destType, destVal)
  dt1 = tasm_GetOperandType(src1Type, src1Val)
  dt2 = tasm_GetOperandType(src2Type, src2Val)

  isUnsigned = 0
  IF dt1 = TYPE_UBYTE OR dt1 = TYPE_UINTEGER OR dt1 = TYPE_ULONG OR dt1 = TYPE_UINT64 THEN isUnsigned = 1
  IF dt2 = TYPE_UBYTE OR dt2 = TYPE_UINTEGER OR dt2 = TYPE_ULONG OR dt2 = TYPE_UINT64 THEN isUnsigned = 1

  IF opCmd = TC_CONCAT THEN
    IF dtDest <> TYPE_STRING OR dt1 <> TYPE_STRING OR dt2 <> TYPE_STRING THEN
      throwCompilerError "TC_CONCAT REQUIRES STRINGS", ASIS, 0
      EXIT SUB
    END IF

    IF engineSymbolIds.IsReady <> 1 THEN
      throwCompilerError "ENGINE SYMBOL ID CACHE NOT READY", ASIS, 0
      EXIT SUB
    END IF

    tempBaseIdx = engineSymbolIds.MemPtrTempBase
    processHeapIdx = engineSymbolIds.MemPtrProcessHeap
    spillHeadIdx = engineSymbolIds.MemPtrSpillHead

    opPushReg 12 ' Protect ABI non-volatile string descriptors
    opPushReg 13
    opPushReg 14

    isFloat1 = tasm_LoadOperand(src1Type, src1Val, 0)
    isFloat2 = tasm_LoadOperand(src2Type, src2Val, 3)

    ff = genLoadStringDesc(0, 12, 13)
    ff = genLoadStringDesc(3, 10, 11)

    ff = genSymbolRouteMov(OP_TYPE_REG, 7, OP_TYPE_MEM_RIP, 0, 64, internalTempHeapSymbolIdx)

    ff = opMov(OP_TYPE_REG, 8, OP_TYPE_REG, 13, 64)
    ff = opALU(ALU_ADD, OP_TYPE_REG, 8, OP_TYPE_REG, 11, 64)

    ' Calculate padded allocation size to maintain 8-byte alignment
    ' R9 = (R8 + 31) AND -8  (31 = 24 bytes descriptor + 7 for rounding)
    ff = opMov(OP_TYPE_REG, 9, OP_TYPE_REG, 8, 64)
    ff = opALU(ALU_ADD, OP_TYPE_REG, 9, OP_TYPE_IMM, 31, 64)
    ff = opALU(ALU_AND, OP_TYPE_REG, 9, OP_TYPE_IMM, -8, 64)

    ' Calculate new potential heap pointer: R7 - R9
    ff = opALU(ALU_SUB, OP_TYPE_REG, 7, OP_TYPE_REG, 9, 64)
    ff = opMov(OP_TYPE_REG, 14, OP_TYPE_REG, 7, 64) ' R14 = new heap pointer (if fits)

    ' Fetch !G_MEM_PTR_TEMP_BASE to verify we haven't underflowed the heap
    ff = genSymbolRouteMov(OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, 64, tempBaseIdx)

    ' cmp R14, RAX
    ff = opALU(ALU_CMP, OP_TYPE_REG, 14, OP_TYPE_REG, 0, 64)

    jmpSkipSpill = opJcc(JCC_JGE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)

    '''' Spill Allocation (OS Heap)
    ' Protect Volatiles needed for later assembly
    opPushReg 8 ' R8 = combined length
    opPushReg 10 ' R10 = src2_ptr
    opPushReg 11 ' R11 = src2_len

    ' Call IAT_HEAPALLOC(!G_MEM_PTR_PROCESS_HEAP, 8 (HEAP_ZERO_MEMORY), R9 + 8)
    ff = genSymbolRouteMov(OP_TYPE_REG, 1, OP_TYPE_MEM_RIP, 0, 64, processHeapIdx)

    ff = opMov(OP_TYPE_REG, 2, OP_TYPE_IMM, 8, 64)

    ff = opMov(OP_TYPE_REG, 8, OP_TYPE_REG, 9, 64)
    ff = opALU(ALU_ADD, OP_TYPE_REG, 8, OP_TYPE_IMM, 8, 64)

    ff = genAlignedCall(IAT_HEAPALLOC, 13, DEFAULT)

    ' Check OOM
    ff = opTest(OP_TYPE_REG, 0, OP_TYPE_REG, 0, 64)
    skipOomLbl = opJcc(JCC_JNE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)
    ff = resolveSymbol("@NATIVE_STACK_HANDLER")
    IF ff = 1 THEN
      addPatch PATCH_GOTO, opJcc(JCC_JMP, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), returnedData2
    END IF
    patch8 skipOomLbl

    ' Link OS allocation into Spill List
    ff = genSymbolRouteMov(OP_TYPE_REG, 1, OP_TYPE_MEM_RIP, 0, 64, spillHeadIdx)

    ff = opMov(OP_TYPE_MEM_REG, 0, OP_TYPE_REG, 1, 64) ' [RAX] = !G_MEM_PTR_SPILL_HEAD
    ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 64, spillHeadIdx) ' !G_MEM_PTR_SPILL_HEAD = RAX

    ' Point R14 directly to the string payload (skip the 8-byte spill list link)
    ff = opMov(OP_TYPE_REG, 14, OP_TYPE_REG, 0, 64)
    ff = opALU(ALU_ADD, OP_TYPE_REG, 14, OP_TYPE_IMM, 8, 64)

    ' Realign R7 iterator with R14 data base
    ff = opMov(OP_TYPE_REG, 7, OP_TYPE_REG, 14, 64)

    opPopReg 11
    opPopReg 10
    opPopReg 8

    jmpSpillDone = opJcc(JCC_JMP, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)

    '''' Standard temp heap
    patch8 jmpSkipSpill

    ' Update !G_MEM_PTR_TEMP_HEAP to the lowest address (R14)
    ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 14, 64, internalTempHeapSymbolIdx)

    patch8 jmpSpillDone

    '''' Assemble string payload
    genBlockTransfer 12, 7, 13

    ' Advance R7 by the length of the first string to prevent overwriting
    ff = opALU(ALU_ADD, OP_TYPE_REG, 7, OP_TYPE_REG, 13, 64)

    genBlockTransfer 10, 7, 11

    ' Advance R7 by the length of the second string to align with the descriptor slot
    ff = opALU(ALU_ADD, OP_TYPE_REG, 7, OP_TYPE_REG, 11, 64)

    ' R7 natively points precisely to the correct 24-byte descriptor slot after genBlockTransfer completes
    ff = opMov(OP_TYPE_MEM_REG, 7, OP_TYPE_REG, 14, 64)
    ff = opMov(OP_TYPE_MEM_REG_DISP8, 7 + (8 * 256), OP_TYPE_REG, 8, 64)

    ' Explicitly clear the Flags value to 0 to prevent garbage data from triggering double-frees during Garbage Collection
    ff = opALU(ALU_XOR, OP_TYPE_REG, 9, OP_TYPE_REG, 9, 64)
    ff = opMov(OP_TYPE_MEM_REG_DISP8, 7 + (16 * 256), OP_TYPE_REG, 9, 64)

    ff = opMov(OP_TYPE_REG, 0, OP_TYPE_REG, 7, 64)
    tasm_StoreOperand destType, destVal, 0, 0

    opPopReg 14 ' Restore ABI non-volatile string descriptors
    opPopReg 13
    opPopReg 12

    EXIT SUB
  END IF

  IF dtDest = TYPE_STRING OR dt1 = TYPE_STRING OR dt2 = TYPE_STRING THEN
    throwCompilerError "MATH OP WITH STRING", ASIS, 0
    EXIT SUB
  END IF

  isFloat1 = tasm_LoadOperand(src1Type, src1Val, 0)
  isFloat2 = tasm_LoadOperand(src2Type, src2Val, 3)

  ' Force float-to-integer conversion for strict integer instructions before they hit the math flow
  IF opCmd = TC_IDIV OR opCmd = TC_MOD OR opCmd = TC_AND OR opCmd = TC_OR OR opCmd = TC_XOR OR opCmd = TC_NOR OR opCmd = TC_NAND OR opCmd = TC_XNOR THEN
    IF isFloat1 > 0 THEN
      opModeFloat = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat THEN opModeFloat = typeDb(TYPE_SINGLE).LoadMode
      ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opModeFloat)
      isFloat1 = 0
    END IF
    IF isFloat2 > 0 THEN
      opModeFloat = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opModeFloat = typeDb(TYPE_SINGLE).LoadMode
      ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 3, OP_TYPE_REG, 3, opModeFloat)
      isFloat2 = 0
    END IF
  END IF

  IF isFloat1 > 0 OR isFloat2 > 0 OR opCmd = TC_POW OR opCmd = TC_DIV THEN
    targetMode = typeDb(TYPE_SINGLE).LoadMode

    IF isFloat1 = typeDb(TYPE_DOUBLE).IsFloat OR isFloat2 = typeDb(TYPE_DOUBLE).IsFloat OR opCmd = TC_POW THEN
      targetMode = typeDb(TYPE_DOUBLE).LoadMode
    END IF

    IF isFloat1 = 0 THEN
      ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, targetMode)
    ELSE
      IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
        ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_SINGLE).LoadMode)
      END IF
    END IF

    IF isFloat2 = 0 THEN
      ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 3, targetMode)
    ELSE
      opModeFloat = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opModeFloat = typeDb(TYPE_SINGLE).LoadMode
      ff = opSSE(SSE_MOV, OP_TYPE_REG, 1, OP_TYPE_REG, 3, opModeFloat)
      IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
        ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 1, typeDb(TYPE_SINGLE).LoadMode)
      END IF
    END IF

    IF opCmd = TC_POW THEN
      ff = genAlignedCall(IAT_POW, 13, DEFAULT)
    ELSE

      SELECT CASE opCmd

        CASE TC_ADD: ff = opSSE(SSE_ADD, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)
        CASE TC_SUB: ff = opSSE(SSE_SUB, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)
        CASE TC_MUL: ff = opSSE(SSE_MUL, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)
        CASE TC_DIV: ff = opSSE(SSE_DIV, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)

      END SELECT ' opCmd

    END IF

    resIsFloat = typeDb(TYPE_DOUBLE).IsFloat
    IF targetMode = typeDb(TYPE_SINGLE).LoadMode THEN resIsFloat = typeDb(TYPE_SINGLE).IsFloat
    tasm_StoreOperand destType, destVal, 0, resIsFloat
  ELSE

    SELECT CASE opCmd

      CASE TC_ADD: ff = opALU(ALU_ADD, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      CASE TC_SUB: ff = opALU(ALU_SUB, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      CASE TC_MUL: ff = opImul(0, OP_TYPE_REG, 3, 0, MODE_IMUL64_REG)
      CASE TC_IDIV
        opPushReg 2
        IF isUnsigned = 1 THEN
          ff = opALU(ALU_XOR, OP_TYPE_REG, 2, OP_TYPE_REG, 2, 64)
          ff = opUnary(UNARY_DIV, OP_TYPE_REG, 3, 64)
        ELSE
          opExtend EXTEND_CQO
          ff = opUnary(UNARY_IDIV, OP_TYPE_REG, 3, 64)
        END IF
        opPopReg 2
      CASE TC_MOD
        opPushReg 2
        IF isUnsigned = 1 THEN
          ff = opALU(ALU_XOR, OP_TYPE_REG, 2, OP_TYPE_REG, 2, 64)
          ff = opUnary(UNARY_DIV, OP_TYPE_REG, 3, 64)
        ELSE
          opExtend EXTEND_CQO
          ff = opUnary(UNARY_IDIV, OP_TYPE_REG, 3, 64)
        END IF
        ff = opMov(OP_TYPE_REG, 0, OP_TYPE_REG, 2, 64)
        opPopReg 2
      CASE TC_AND: ff = opALU(ALU_AND, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      CASE TC_OR: ff = opALU(ALU_OR, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      CASE TC_XOR: ff = opALU(ALU_XOR, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
      CASE TC_NOR
        ff = opALU(ALU_OR, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
        ff = opUnary(UNARY_NOT, OP_TYPE_REG, 0, 64)
      CASE TC_NAND
        ff = opALU(ALU_AND, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
        ff = opUnary(UNARY_NOT, OP_TYPE_REG, 0, 64)
      CASE TC_XNOR
        ff = opALU(ALU_XOR, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
        ff = opUnary(UNARY_NOT, OP_TYPE_REG, 0, 64)
      CASE TC_COMPARE
        ' In TC_COMPARE, the destination node actually holds the first operand, and src1 holds the second
        dt1 = tasm_GetOperandType(destType, destVal)
        dt2 = tasm_GetOperandType(src1Type, src1Val)

        isFloat1 = tasm_LoadOperand(destType, destVal, 0)
        isFloat2 = tasm_LoadOperand(src1Type, src1Val, 3)

        IF dt1 = TYPE_STRING AND dt2 = TYPE_STRING THEN
          opPushReg 1
          opPushReg 2

          ' String Compare Block
          ' Move descriptors from RAX(0) and RBX(3) into RCX(1) and RDX(2) for ABI
          ff = opMov(OP_TYPE_REG, 1, OP_TYPE_REG, 0, 64)
          ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, 3, 64)

          pushedDummy = 0
          IF updateStackAlignment = 0 THEN
            opPushReg 13
            pushedDummy = 1
          END IF

          ' Allocate 32 bytes shadow space to prevent prologue stack corruption
          ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
          stack.currentStackOffset = stack.currentStackOffset + 32
          ff = updateStackAlignment

          rtIsUsed(RT_STR_CMP) = 1
          addPatch PATCH_RT, opCall(0, CALLMODE_REL32), RT_STR_CMP
          IF compileError = 1 THEN
            tira_Cancel
            EXIT SUB
          END IF

          ' Restore shadow space
          ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
          stack.currentStackOffset = stack.currentStackOffset - 32
          ff = updateStackAlignment

          IF pushedDummy = 1 THEN
            opPopReg 13
          END IF

          opPopReg 2
          opPopReg 1

          ' Result is in RAX (0). Compare with 0.
          ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_IMM, 0, 64)
        ELSE
          IF isFloat1 > 0 OR isFloat2 > 0 THEN
            targetMode = typeDb(TYPE_DOUBLE).LoadMode
            IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat AND isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN targetMode = typeDb(TYPE_SINGLE).LoadMode

            IF isFloat1 = 0 THEN
              ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, targetMode)
            ELSE
              IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
                ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_SINGLE).LoadMode)
              END IF
            END IF

            IF isFloat2 = 0 THEN
              ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 3, targetMode)
            ELSE
              opModeFloat = typeDb(TYPE_DOUBLE).LoadMode
              IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opModeFloat = typeDb(TYPE_SINGLE).LoadMode
              ff = opSSE(SSE_MOV, OP_TYPE_REG, 1, OP_TYPE_REG, 3, opModeFloat)
              IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat AND targetMode = typeDb(TYPE_DOUBLE).LoadMode THEN
                ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 1, OP_TYPE_REG, 1, typeDb(TYPE_SINGLE).LoadMode)
              END IF
            END IF

            ff = opSSE(SSE_UCOMI, OP_TYPE_REG, 0, OP_TYPE_REG, 1, targetMode)
          ELSE
            ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)
          END IF
        END IF
        EXIT SUB

    END SELECT ' opCmd

    tasm_StoreOperand destType, destVal, 0, 0
  END IF

END SUB ' tasm_DoMath

''''''''''''''''''''''''
SUB tasm_DoShift (opCmd AS LONG, destType AS LONG, destVal AS _INTEGER64, src1Type AS LONG, src1Val AS _INTEGER64, src2Type AS LONG, src2Val AS _INTEGER64)

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_DoShift: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  DIM dtDest AS LONG
  DIM dt1 AS LONG
  DIM dt2 AS LONG
  DIM isFloat1 AS LONG
  DIM isFloat2 AS LONG
  DIM opMode AS LONG

  dtDest = tasm_GetOperandType(destType, destVal)
  dt1 = tasm_GetOperandType(src1Type, src1Val)
  dt2 = tasm_GetOperandType(src2Type, src2Val)

  IF dtDest = TYPE_STRING OR dt1 = TYPE_STRING OR dt2 = TYPE_STRING THEN
    throwCompilerError "SHIFT OP WITH STRING", ASIS, 0
    EXIT SUB
  END IF

  opPushReg 1

  isFloat1 = tasm_LoadOperand(src1Type, src1Val, 0)
  isFloat2 = tasm_LoadOperand(src2Type, src2Val, 1)

  IF isFloat1 > 0 THEN
    opMode = typeDb(TYPE_DOUBLE).LoadMode
    IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
    ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opMode)
  END IF

  IF isFloat2 > 0 THEN
    opMode = typeDb(TYPE_DOUBLE).LoadMode
    IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
    ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 1, OP_TYPE_REG, 1, opMode)
  END IF

  ' REX.W (64-bit operation)
  emitByteCode &H48

  ' D3 = SHL/SHR/SAR r/m64, CL
  emitByteCode &HD3

  IF opCmd = TC_SHL THEN
    emitByteCode &HE0 ' 11 100 000 (mod=3, reg=4 for SHL, rm=0 for RAX)
  ELSE
    IF opCmd = TC_SHR THEN
      emitByteCode &HE8 ' 11 101 000 (mod=3, reg=5 for SHR, rm=0 for RAX)
    ELSE
      emitByteCode &HF8 ' 11 111 000 (mod=3, reg=7 for SAR, rm=0 for RAX)
    END IF
  END IF

  opPopReg 1

  tasm_StoreOperand destType, destVal, 0, 0

END SUB ' tasm_DoShift

''''''''''''''''''''''''
SUB tasm_DoSwap (addr1Type AS LONG, addr1Val AS _INTEGER64, addr2Type AS LONG, addr2Val AS _INTEGER64, sizeModeType AS LONG, sizeModeVal AS _INTEGER64)

  IF t.IsActive <> 2 THEN
    throwCompilerError "tasm_DoSwap: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  DIM opSize AS LONG

  ff = tasm_LoadOperand(addr1Type, addr1Val, 10)
  ff = tasm_LoadOperand(addr2Type, addr2Val, 11)

  opSize = 64
  IF sizeModeType = TIRA_ARG_LITERAL THEN
    opSize = sizeModeVal * 8
  ELSE
    IF sizeModeType = TIRA_ARG_STR_LITERAL THEN
      IF sizeModeVal = 32 THEN opSize = 32
      IF sizeModeVal = 64 THEN opSize = 64
    END IF
  END IF

  ' Read the memory values into our primary compute registers
  ff = opMov(OP_TYPE_REG, 0, OP_TYPE_MEM_REG, 10, opSize)
  ff = opMov(OP_TYPE_REG, 3, OP_TYPE_MEM_REG, 11, opSize)

  ' Write the values back to the swapped addresses
  ff = opMov(OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 3, opSize)
  ff = opMov(OP_TYPE_MEM_REG, 11, OP_TYPE_REG, 0, opSize)

END SUB ' tasm_DoSwap

''''''''''''''''''''''''
SUB tasm_DoUnary (opCmd AS LONG, destType AS LONG, destVal AS _INTEGER64, srcType AS LONG, srcVal AS _INTEGER64)

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_DoUnary: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  DIM dtDest AS LONG
  DIM dtSrc AS LONG
  DIM isFloat AS LONG
  DIM opMode AS LONG

  dtDest = tasm_GetOperandType(destType, destVal)
  dtSrc = tasm_GetOperandType(srcType, srcVal)

  IF dtDest = TYPE_STRING OR dtSrc = TYPE_STRING THEN
    throwCompilerError "UNARY OP WITH STRING", ASIS, 0
    EXIT SUB
  END IF

  isFloat = tasm_LoadOperand(srcType, srcVal, 0)

  IF opCmd = TC_NEG THEN
    IF isFloat > 0 THEN
      opMode = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode

      ' Zero out XMM3 to serve as 0.0
      ff = opSSE(SSE_XOR, OP_TYPE_REG, 3, OP_TYPE_REG, 3, opMode)

      ' Subtract XMM0 from XMM3 (0.0 - value)
      ff = opSSE(SSE_SUB, OP_TYPE_REG, 3, OP_TYPE_REG, 0, opMode)

      ' Move result back into XMM0 for storage
      ff = opSSE(SSE_MOV, OP_TYPE_REG, 0, OP_TYPE_REG, 3, opMode)
    ELSE
      ff = opUnary(UNARY_NEG, OP_TYPE_REG, 0, 64)
    END IF
  ELSE
    ' TC_NOT inherently requires an integer context to perform a bitwise flip
    IF isFloat > 0 THEN
      opMode = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
      ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opMode)
      isFloat = 0
    END IF

    ff = opUnary(UNARY_NOT, OP_TYPE_REG, 0, 64)
  END IF

  tasm_StoreOperand destType, destVal, 0, isFloat

END SUB ' tasm_DoUnary

''''''''''''''''''''''''
FUNCTION tasm_GetOperandType (argType AS LONG, argVal AS _INTEGER64)

  DIM dt AS LONG

  dt = TYPE_LONG
  IF argType = TIRA_ARG_LITERAL THEN
    dt = TYPE_LONG ' Literals are inherently integer values from the parser
  ELSE
    IF argType = TIRA_ARG_SYMBOL THEN
      dt = symbols(argVal).DataType
    END IF
  END IF

  tasm_GetOperandType = dt

END FUNCTION ' tasm_GetOperandType

''''''''''''''''''''''''
FUNCTION tasm_LoadOperand (argType AS LONG, argVal AS _INTEGER64, destReg AS LONG)

  ' Loads a TIRA operand into a hardware register and natively returns whether the
  ' loaded value is a floating-point type, replacing legacy pass-by-reference mutation

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_LoadOperand: TIRA NOT IN SETTING 2", ASIS, 0
    tasm_LoadOperand = 0
    EXIT FUNCTION
  END IF

  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM isFloat AS LONG

  isFloat = 0

  IF argType = TA_EMPTY THEN
    tasm_LoadOperand = 0
    EXIT FUNCTION
  ELSE
    IF argType = TIRA_ARG_LITERAL THEN
      ff = opMov(OP_TYPE_REG, destReg, OP_TYPE_IMM, argVal, MODE_IMM64)
      isFloat = 0
    ELSE
      IF argType = TIRA_ARG_LABEL THEN
        throwCompilerError "FATAL: Cannot load label value into register", ASIS, 0
        tasm_LoadOperand = 0
        EXIT FUNCTION
      ELSE
        IF argType = TIRA_ARG_SYMBOL THEN
          vIdx = argVal
          dt = symbols(vIdx).DataType

          IF dt = TYPE_SINGLE OR dt = TYPE_DOUBLE THEN
            ff = genSymbolRouteSSE(SSE_MOV, OP_TYPE_REG, destReg, OP_TYPE_MEM_RIP, 0, typeDb(dt).LoadMode, vIdx)
            isFloat = typeDb(dt).IsFloat
          ELSE
            IF dt = TYPE_STRING THEN
              ' Local strings use 24-byte inline descriptors, so we must load their address using LEA
              ' Global and ephemeral strings store an 8-byte pointer to the descriptor, so we read it using MOV
              IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 AND symbols(vIdx).IsTempInternal = 0 THEN
                ff = genSymbolRouteLea(destReg, vIdx)
              ELSE
                ff = genSymbolRouteMov(OP_TYPE_REG, destReg, OP_TYPE_MEM_RIP, 0, 64, vIdx)
              END IF
            ELSE
              ff = genSymbolRouteMov(OP_TYPE_REG, destReg, OP_TYPE_MEM_RIP, 0, typeDb(dt).LoadMode, vIdx)
            END IF
            isFloat = 0
          END IF
        END IF
      END IF
    END IF
  END IF

  return3 0
  return2 0
  tasm_LoadOperand = isFloat

END FUNCTION ' tasm_LoadOperand

''''''''''''''''''''''''
SUB tasm_ProbeStack (allocSize AS _INTEGER64)

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_ProbeStack: TIRA NOT IN SETTING 2, NO tira_EndAndProcess CALL", ASIS, 0
    EXIT SUB
  END IF

  DIM probeLoop AS _UNSIGNED LONG
  DIM jmpDone AS _UNSIGNED LONG
  DIM skipLoop AS _UNSIGNED LONG

  ' Move total allocation size into R11
  ff = opMov(OP_TYPE_REG, 11, OP_TYPE_IMM, allocSize, 64)

  ' cmp r11, 4096
  ff = opALU(ALU_CMP, OP_TYPE_REG, 11, OP_TYPE_IMM, 4096, 64)

  ' jl skipLoop
  skipLoop = opJcc(JCC_JL, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)

  probeLoop = stream.emitPos

  ' sub rsp, 4096
  ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, 4096, 64)

  ' or byte ptr [rsp], 0 (Touch the guard page to commit the memory)
  ff = opALU(ALU_OR, OP_TYPE_MEM_RSP, 0, OP_TYPE_IMM, 0, 8)

  ' sub r11, 4096
  ff = opALU(ALU_SUB, OP_TYPE_REG, 11, OP_TYPE_IMM, 4096, 64)

  ' cmp r11, 4096
  ff = opALU(ALU_CMP, OP_TYPE_REG, 11, OP_TYPE_IMM, 4096, 64)

  ' jge probeLoop
  ff = opJcc(JCC_JGE, JCC_MODE_BACKWARD, probeLoop, JCC_TYPE_SHORT)

  patch8 skipLoop

  ' test r11, r11
  ff = opTest(OP_TYPE_REG, 11, OP_TYPE_REG, 11, 64)

  ' jle jmpDone
  jmpDone = opJcc(JCC_JLE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)

  ' sub rsp, r11
  ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_REG, 11, 64)

  ' Touch the final memory page allocated for the stack frame
  ff = opALU(ALU_OR, OP_TYPE_MEM_RSP, 0, OP_TYPE_IMM, 0, 8)

  patch8 jmpDone

  stack.currentStackOffset = stack.currentStackOffset + allocSize
  ff = updateStackAlignment

END SUB ' tasm_ProbeStack

''''''''''''''''''''''''
SUB tasm_StoreOperand (argType AS LONG, argVal AS _INTEGER64, srcReg AS LONG, rsIsFloat AS LONG)

  ' Stores a hardware register value back into a TIRA operand
  ' The rsIsFloat parameter explicitly utilizes rs (Reference Safety) to guarantee
  ' the caller's state is completely immunized against unintended mutation

  DIM isFloat AS LONG
  isFloat = rsIsFloat

  IF t.IsActive <> 2 THEN ' Make sure this function was called in a TIRA block
    throwCompilerError "tasm_StoreOperand: TIRA NOT IN SETTING 2", ASIS, 0
    EXIT SUB
  END IF

  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM opMode AS LONG
  DIM pushedDummy AS LONG

  IF argType <> TIRA_ARG_SYMBOL THEN
    throwCompilerError "FATAL: Can only store to a symbol", ASIS, 0
    EXIT SUB
  END IF

  vIdx = argVal
  targetType = symbols(vIdx).DataType

  IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
    IF isFloat = 0 THEN
      ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, srcReg, OP_TYPE_REG, srcReg, typeDb(TYPE_DOUBLE).LoadMode)
      isFloat = typeDb(TYPE_DOUBLE).IsFloat
    END IF

    IF isFloat = typeDb(TYPE_DOUBLE).IsFloat AND targetType = TYPE_SINGLE THEN
      ff = opSSE(SSE_CVTSD2SS, OP_TYPE_REG, srcReg, OP_TYPE_REG, srcReg, typeDb(TYPE_DOUBLE).LoadMode)
      isFloat = typeDb(TYPE_SINGLE).IsFloat
    END IF
    IF isFloat = typeDb(TYPE_SINGLE).IsFloat AND targetType = TYPE_DOUBLE THEN
      ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, srcReg, OP_TYPE_REG, srcReg, typeDb(TYPE_SINGLE).LoadMode)
      isFloat = typeDb(TYPE_DOUBLE).IsFloat
    END IF

    ff = genSymbolRouteSSE(SSE_MOV, OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, srcReg, typeDb(targetType).LoadMode, vIdx)
  ELSE
    IF isFloat > 0 THEN
      opMode = typeDb(TYPE_DOUBLE).LoadMode
      IF isFloat = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
      ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, srcReg, OP_TYPE_REG, srcReg, opMode)
    END IF

    IF targetType = TYPE_STRING THEN
      IF symbols(vIdx).IsTempInternal = 1 THEN
        ' Safe pointer routing for temporary TIRA variables
        ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, srcReg, 64, vIdx)
      ELSE
        ' Full safety for true string assignment
        opPushReg 1
        opPushReg 2

        IF srcReg <> 2 THEN ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, srcReg, 64)

        ' Precautionary measure: Local strings store their 24-byte descriptor inline on the RBP stack frame,
        ' requiring LEA to retrieve the target memory address. Global strings and ephemeral TIRA pointers
        ' store an 8-byte pointer to their descriptor in the data segment, requiring a MOV to correctly
        ' dereference the pointer instead of overwriting the pointer's memory location itself
        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 AND symbols(vIdx).IsTempInternal = 0 THEN
          ff = genSymbolRouteLea(1, vIdx)
        ELSE
          ff = genSymbolRouteMov(OP_TYPE_REG, 1, OP_TYPE_MEM_RIP, 0, 64, vIdx)
        END IF

        opPushReg 8
        opPushReg 9
        opPushReg 10
        opPushReg 11

        pushedDummy = 0
        IF updateStackAlignment = 0 THEN
          opPushReg 13
          pushedDummy = 1
        END IF

        ' Allocate 32 bytes shadow space to prevent prologue stack corruption
        ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
        stack.currentStackOffset = stack.currentStackOffset + 32
        ff = updateStackAlignment

        rtIsUsed(RT_STR_ASSIGN) = 1
        addPatch PATCH_RT, opCall(0, CALLMODE_REL32), RT_STR_ASSIGN
        IF compileError = 1 THEN EXIT SUB

        ' Restore shadow space
        ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
        stack.currentStackOffset = stack.currentStackOffset - 32
        ff = updateStackAlignment

        IF pushedDummy = 1 THEN
          opPopReg 13
        END IF

        opPopReg 11
        opPopReg 10
        opPopReg 9
        opPopReg 8

        opPopReg 2
        opPopReg 1
      END IF
    ELSE
      ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, srcReg, typeDb(targetType).StoreMode, vIdx)
    END IF
  END IF

END SUB ' tasm_StoreOperand

''''''''''''''''''''''''
FUNCTION textFileRVA& (wFileOffset AS _UNSIGNED LONG)

  DIM tempRet AS LONG

  tempRet = PE_TEXT_VA + (wFileOffset - PE_FILE_HEADER_OFFSET)
  textFileRVA = tempRet

END FUNCTION ' textFileRVA

''''''''''''''''''''''''
SUB tira_Cancel

  t.IsActive = 0

END SUB 'tira_Cancel

''''''''''''''''''''''''
SUB tira_EndAndProcess

  t.IsActive = 2

  '''' Tira register allocation and ABI protection rules
  ' The TIRA backend operates as a memory-to-memory intermediate representation.
  ' To prevent internal calculations from silently corrupting the Windows x64 ABI
  ' volatile parameter registers (RCX, RDX, R8, R9) during execution, the tasm_
  ' suite enforces a strict register partitioning protocol:
  '
  ' RAX (0) and RBX (3): These act as TIRA's primary computational targets.
  ' Mathematical operations and general scalar evaluations natively resolve here.
  '
  ' R10 (10) and R11 (11): These serve as TIRA's exclusive safe scratchpads.
  ' They handle pointer indirection, array scaling (LEA_SIB), memory extraction,
  ' and data shuffling without risking ABI collisions.
  '
  ' RCX (1) and RDX (2): These are heavily restricted volatile ABI registers.
  ' The x64 processor hardware physically mandates their use for certain
  ' operations, such as CL for variable bit-shifting (SHL/SHR), RDX for division
  ' and modulo (IDIV), and RCX for block memory transfers (REP MOVSB/STOSB).
  ' Whenever TIRA executes these specific instructions, the registers are
  ' structurally shielded via opPushReg and opPopReg to preserve the ABI state.
  '
  ' R8 (8) and R9 (9): Volatile ABI registers left entirely untouched by internal
  ' TIRA math, reserved strictly for tiraCall parameter routing.
  '
  ' RSP (4) and RBP (5): Protected hardware stack and frame pointers. These are
  ' completely locked out of general scratchpad usage to prevent stack desyncs.
  '
  ' RDI (7) and RSI (6): Dedicated indexing registers used for block memory ops
  ' (TC_MEMCPY and TC_MEMSET). They are globally protected by the subroutine
  ' frame builder (TC_ENTER_FRAME) to comply with x64 non-volatile rules.

  DIM vIdx AS LONG
  DIM destIdx AS LONG
  DIM destVIdx AS LONG
  DIM isFloat1 AS LONG
  DIM isFloat2 AS LONG
  DIM opMode AS LONG
  DIM pushedDummy AS LONG
  DIM allocSize AS LONG
  DIM cmdNum AS LONG
  DIM jmpType AS LONG
  DIM dispVal AS LONG
  DIM argIdx AS LONG
  DIM srcVIdx AS LONG
  DIM stackOffset AS LONG
  DIM memOpTypeR AS LONG
  DIM memOpTypeW AS LONG
  DIM argCount AS LONG
  DIM symName$
  DIM funcName$
  DIM funcSymbolIdx AS LONG
  DIM callKind AS LONG
  DIM callTarget AS LONG
  DIM rtAddrOffset AS LONG
  DIM hasStoreTarget AS LONG
  DIM storeTargetArgType AS LONG
  DIM dt1 AS LONG
  DIM dt2 AS LONG
  DIM targetType AS LONG
  DIM subIdx AS LONG
  DIM remainder AS LONG
  DIM jmpSkipMemCpy AS _UNSIGNED LONG
  DIM jmpSkipMemSet AS _UNSIGNED LONG

  IF pass5.Mode = PASS5_MODE_DISCOVERY THEN
    ' Pass 5A records compiler state without selecting or emitting native instructions
    ' Abstract stack transitions are retained because later source parsing validates them

    IF t.LineCount > 0 THEN
      FOR ii = 0 TO t.LineCount - 1
        cmdNum = tiraNode(ii).OpCode
        hasStoreTarget = 0
        storeTargetArgType = TA_EMPTY
        destVIdx = 0

        SELECT CASE cmdNum

          CASE TC_INVALID
            throwCompilerError "INVALID TIRA COMMAND (0)", ASIS, 0
            t.LineCount = 0
            t.IsActive = 0
            EXIT SUB

          CASE TC_LABEL
            IF tiraNode(ii).Arg1Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg1Val
              symbols(vIdx).DataType = TYPE_LABEL
              symbols(vIdx).Offset = 0
              symbols(vIdx).alreadyParsed = 1
            END IF

          CASE TC_SET_SUB_OFFSET
            subIdx = tiraNode(ii).Arg1Val
            subs(subIdx).Offset = 0

          CASE TC_MAIN_PROLOGUE
            stack.currentStackOffset = 8
            allocSize = tiraNode(ii).Arg1Val
            IF allocSize > 0 THEN
              stack.currentStackOffset = stack.currentStackOffset + allocSize
            END IF
            ff = updateStackAlignment

          CASE TC_ENTER_FRAME
            allocSize = tiraNode(ii).Arg1Val
            stack.currentStackOffset = PE_STACK_FRAME_OVERHEAD + allocSize
            ff = updateStackAlignment
            hasStoreTarget = 1
            storeTargetArgType = tiraNode(ii).Arg2Type
            destVIdx = tiraNode(ii).Arg2Val

          CASE TC_LEAVE_FRAME
            ff = resolveSymbol("@NATIVE_STACK_HANDLER")
            stack.currentStackOffset = 8
            ff = updateStackAlignment

          CASE TC_ABI_PROLOGUE, TC_ABI_EPILOGUE
            stack.currentStackOffset = 0
            ff = updateStackAlignment

          CASE TC_CALL
            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              funcSymbolIdx = tiraNode(ii).Arg1Val

              IF funcSymbolIdx < 0 OR funcSymbolIdx >= symbolCount THEN
                throwCompilerErrorAndCancelTira "TC_CALL REQUIRES VALID FUNCTION SYMBOL ID", ASIS, 0
                t.LineCount = 0
                t.IsActive = 0
                EXIT SUB
              END IF
            ELSE
              throwCompilerErrorAndCancelTira "TC_CALL REQUIRES SYMBOL FOR FUNCTION NAME", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

            argCount = tiraNode(ii).Arg2Val
            IF argCount > 16 THEN
              throwCompilerErrorAndCancelTira "TIRA_CALL WITH > 16 ARGS NOT SUPPORTED", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

            callKind = symbols(funcSymbolIdx).CallKind
            callTarget = symbols(funcSymbolIdx).CallTarget

            IF callKind = TIRA_CALL_KIND_NONE THEN
              callTarget = symbols(funcSymbolIdx).SubIndex
              IF callTarget > 0 AND callTarget < subCount THEN
                callKind = TIRA_CALL_KIND_SUB
              END IF
            END IF

            SELECT CASE callKind

              CASE TIRA_CALL_KIND_RUNTIME
                IF callTarget = RT_INVALID THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "RUNTIME HELPER NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                  t.LineCount = 0
                  t.IsActive = 0
                  EXIT SUB
                END IF
                rtIsUsed(callTarget) = 1

              CASE TIRA_CALL_KIND_IAT
                IF callTarget = IAT_INVALID THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "INVALID IAT CALL: " + funcName$, ASIS, 0
                  t.LineCount = 0
                  t.IsActive = 0
                  EXIT SUB
                END IF

              CASE TIRA_CALL_KIND_SUB
                IF callTarget <= 0 OR callTarget >= subCount THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "SUB NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                  t.LineCount = 0
                  t.IsActive = 0
                  EXIT SUB
                END IF

              CASE ELSE
                funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                throwCompilerErrorAndCancelTira "SUB NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                t.LineCount = 0
                t.IsActive = 0
                EXIT SUB

            END SELECT ' callKind

          CASE TC_ADDRESS_OF
            hasStoreTarget = 1
            storeTargetArgType = tiraNode(ii).Arg1Type
            destVIdx = tiraNode(ii).Arg1Val

            IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL OR tiraNode(ii).Arg2Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg2Val
              IF symbols(vIdx).CallKind = TIRA_CALL_KIND_RUNTIME THEN
                rtAddrOffset = symbols(vIdx).CallTarget
                IF rtAddrOffset = RT_INVALID THEN
                  symName$ = RTRIM$(symbols(vIdx).RecordName)
                  throwCompilerErrorAndCancelTira "RUNTIME HELPER NOT FOUND IN TC_ADDRESS_OF: " + symName$, ASIS, 0
                  t.LineCount = 0
                  t.IsActive = 0
                  EXIT SUB
                END IF
                rtIsUsed(rtAddrOffset) = 1
              END IF
            ELSE
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN ADDRESS_OF", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

          CASE TC_CONCAT
            ff = resolveSymbol("!G_MEM_PTR_TEMP_BASE")
            ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
            ff = resolveSymbol("@NATIVE_STACK_HANDLER")
            ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
            hasStoreTarget = 1
            storeTargetArgType = tiraNode(ii).Arg1Type
            destVIdx = tiraNode(ii).Arg1Val

          CASE TC_JMP_COND
            IF tiraNode(ii).Arg4Type <> TIRA_ARG_LABEL THEN
              throwCompilerError "Internal jump targets must use valid PRS LABEL", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

            dt1 = TYPE_LONG
            IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL THEN
              dt1 = symbols(tiraNode(ii).Arg2Val).DataType
            END IF

            dt2 = TYPE_LONG
            IF tiraNode(ii).Arg3Type = TIRA_ARG_SYMBOL THEN
              dt2 = symbols(tiraNode(ii).Arg3Val).DataType
            END IF

            IF dt1 = TYPE_STRING AND dt2 = TYPE_STRING THEN
              rtIsUsed(RT_STR_CMP) = 1
            END IF

          CASE TC_COMPARE
            dt1 = TYPE_LONG
            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              dt1 = symbols(tiraNode(ii).Arg1Val).DataType
            END IF

            dt2 = TYPE_LONG
            IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL THEN
              dt2 = symbols(tiraNode(ii).Arg2Val).DataType
            END IF

            IF dt1 = TYPE_STRING AND dt2 = TYPE_STRING THEN
              rtIsUsed(RT_STR_CMP) = 1
            END IF

          CASE TC_ASSIGN, TC_READ_MEM, TC_READ_MEM_OFFSET, TC_GET_RET, TC_GET_RSP, TC_LEA_SIB
            hasStoreTarget = 1
            storeTargetArgType = tiraNode(ii).Arg1Type
            destVIdx = tiraNode(ii).Arg1Val

          CASE TC_XCHG, TC_CMPXCHG
            hasStoreTarget = 1
            storeTargetArgType = tiraNode(ii).Arg2Type
            destVIdx = tiraNode(ii).Arg2Val

          CASE TC_SET_RSP
            ff = resolveSymbol("!G_SYS_PTR_SAFE_RSP")
            IF ff = 0 THEN
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN SET_RSP", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

          CASE TC_RESUME
            ff = resolveSymbol("!G_ERR_PTR_LAST")
            IF compileError = 1 THEN
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

          CASE TC_BOUNDS_CHECK
            ff = resolveSymbol("@NATIVE_BOUNDS_HANDLER")
            IF ff = 0 THEN
              throwCompilerErrorAndCancelTira "FATAL: @NATIVE_BOUNDS_HANDLER NOT FOUND", ASIS, 0
              t.LineCount = 0
              t.IsActive = 0
              EXIT SUB
            END IF

            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              targetType = symbols(tiraNode(ii).Arg1Val).DataType
              IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
                throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK INDEX CANNOT BE FLOAT", ASIS, 0
                t.LineCount = 0
                t.IsActive = 0
                EXIT SUB
              END IF
              IF targetType <> TYPE_INTEGER64 AND targetType <> TYPE_UINT64 THEN
                throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK INDEX MUST BE 64-BIT INTEGER", ASIS, 0
                t.LineCount = 0
                t.IsActive = 0
                EXIT SUB
              END IF
            END IF

            IF tiraNode(ii).Arg2Type <> TIRA_ARG_LITERAL THEN
              IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL THEN
                targetType = symbols(tiraNode(ii).Arg2Val).DataType
                IF targetType <> TYPE_INTEGER64 AND targetType <> TYPE_UINT64 THEN
                  throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK LIMIT MUST BE 64-BIT INTEGER", ASIS, 0
                  t.LineCount = 0
                  t.IsActive = 0
                  EXIT SUB
                END IF
              ELSE
                throwCompilerErrorAndCancelTira "FATAL: INVALID BOUNDS CHECK LIMIT TYPE", ASIS, 0
                t.LineCount = 0
                t.IsActive = 0
                EXIT SUB
              END IF
            END IF

          CASE TC_ABI_READ_ARG, TC_ABI_WRITE_RET, TC_ADD, TC_AND, TC_BREAK, TC_CAST, TC_DIV, TC_IDIV, TC_JCC, TC_JMP, TC_JMP_DYN, TC_JMP_USER, TC_MEMCPY, TC_MEMERROR, TC_MEMSET, TC_MOD, TC_MUL, TC_NAND, TC_NEG, TC_NOR, TC_NOT, TC_OR, TC_POW, TC_REDIM, TC_SAR, TC_SHL, TC_SHR, TC_SUB, TC_SWAP_MEM, TC_TEST, TC_WRITE_MEM, TC_WRITE_MEM_OFFSET, TC_XNOR, TC_XOR
            ' No discovery-only state is required for these commands

          CASE ELSE
            throwCompilerErrorAndCancelTira "TIRA COMMAND NOT IMPLEMENTED IN BACKEND", ASIS, 0
            t.LineCount = 0
            t.IsActive = 0
            EXIT SUB

        END SELECT ' cmdNum

        IF hasStoreTarget = 1 THEN
          IF storeTargetArgType <> TIRA_ARG_SYMBOL THEN
            throwCompilerError "FATAL: Can only store to a symbol", ASIS, 0
            t.LineCount = 0
            t.IsActive = 0
            EXIT SUB
          END IF

          vIdx = destVIdx
          targetType = symbols(vIdx).DataType

          IF targetType = TYPE_STRING THEN
            IF symbols(vIdx).IsTempInternal = 0 THEN
              rtIsUsed(RT_STR_ASSIGN) = 1
            END IF
          END IF
        END IF
      NEXT
    END IF

    t.LineCount = 0 ' Reset for another TIRA round, triggered by tira start function
    t.IsActive = 0
    EXIT SUB
  END IF

  IF t.LineCount > 0 THEN
    FOR ii = 0 TO t.LineCount - 1
      cmdNum = tiraNode(ii).OpCode

      IF cmdNum = TC_INVALID THEN
        throwCompilerError "INVALID TIRA COMMAND (0)", ASIS, 0
        t.IsActive = 0
        EXIT SUB
      END IF

      IF cmdNum = TC_LABEL THEN
        IF tiraNode(ii).Arg1Type = TIRA_ARG_LABEL THEN
          vIdx = tiraNode(ii).Arg1Val
          symbols(vIdx).DataType = TYPE_LABEL
          symbols(vIdx).Offset = stream.emitPos
          symbols(vIdx).alreadyParsed = 1
        END IF
      ELSE

        SELECT CASE cmdNum

          CASE TC_SET_SUB_OFFSET
            subIdx = tiraNode(ii).Arg1Val
            subs(subIdx).Offset = stream.emitPos

          CASE TC_MAIN_PROLOGUE
            stack.currentStackOffset = 8
            ff = updateStackAlignment
            allocSize = tiraNode(ii).Arg1Val
            IF allocSize > 0 THEN
              tasm_ProbeStack allocSize
            END IF

          CASE TC_ENTER_FRAME
            stack.currentStackOffset = 8
            ff = updateStackAlignment
            allocSize = tiraNode(ii).Arg1Val

            ' Standard x64 ABI Prologue: Set up RBP as a stable frame pointer
            opPushReg 5 ' RBP
            ff = opMov(OP_TYPE_REG, 5, OP_TYPE_REG, 4, 64) ' mov rbp, rsp

            ' Push non-volatile registers to conform to x64 ABI calling conventions
            opPushReg 3 ' RBX
            opPushReg 6 ' RSI
            opPushReg 7 ' RDI
            opPushReg 12 ' R12
            opPushReg 13 ' R13
            opPushReg 14 ' R14
            opPushReg 15 ' R15

            ' Stack canary
            ' Push a known 64-bit canary value to detect buffer overflows in local variables
            ff = opMov(OP_TYPE_REG, 11, OP_TYPE_IMM, -559038737, 64) ' &HDEADBEEF
            opPushReg 11

            ' Allocate the local stack frame using safe OS guard page probing
            tasm_ProbeStack allocSize

            ' Store RSP (Register 4) into the provided TIRA tracking variable safely via parse Node
            tasm_StoreOperand tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 4, 0

          CASE TC_LEAVE_FRAME
            allocSize = tiraNode(ii).Arg1Val

            ' Deallocate the local stack frame
            IF allocSize > 0 THEN
              opAddRsp32 allocSize
            END IF

            '''' Stack canary check
            opPopReg 11
            ff = opMov(OP_TYPE_REG, 10, OP_TYPE_IMM, -559038737, 64) ' &HDEADBEEF
            ff = opALU(ALU_CMP, OP_TYPE_REG, 11, OP_TYPE_REG, 10, 64)

            ff = resolveSymbol("@NATIVE_STACK_HANDLER")
            IF ff = 1 THEN
              addPatch PATCH_GOTO, opJcc(JCC_JNE, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), returnedData2
            END IF

            ' Pop non-volatile registers in reverse order to conform to x64 ABI
            opPopReg 15 ' R15
            opPopReg 14 ' R14
            opPopReg 13 ' R13
            opPopReg 12 ' R12
            opPopReg 7 ' RDI
            opPopReg 6 ' RSI
            opPopReg 3 ' RBX

            ' Restore caller's RBP frame pointer
            emitByteCode &H5D
            stack.currentStackOffset = stack.currentStackOffset - 8
            ff = updateStackAlignment

            ' Return to caller
            opRet

          CASE TC_ABI_PROLOGUE
            allocSize = tiraNode(ii).Arg1Val

            ' Industry Standard: Set up RBP as the stable frame pointer
            opPushReg 5 ' RBP
            ff = opMov(OP_TYPE_REG, 5, OP_TYPE_REG, 4, 64) ' mov rbp, rsp

            ' Spill volatile ABI registers to their guaranteed shadow space
            ' Because RBP is our stable anchor, these offsets never change
            ff = opMov(OP_TYPE_MEM_RBP, 16, OP_TYPE_REG, 1, 64) ' RCX -> [rbp+16]
            ff = opMov(OP_TYPE_MEM_RBP, 24, OP_TYPE_REG, 2, 64) ' RDX -> [rbp+24]
            ff = opMov(OP_TYPE_MEM_RBP, 32, OP_TYPE_REG, 8, 64) ' R8  -> [rbp+32]
            ff = opMov(OP_TYPE_MEM_RBP, 40, OP_TYPE_REG, 9, 64) ' R9  -> [rbp+40]

            opPushReg 3 ' RBX

            ' Stack alignment math: 24 bytes pushed (RIP + RBP + RBX)
            ' allocSize must pad RSP so that (24 + allocSize) MOD 16 == 0
            ' Therefore, allocSize MOD 16 must equal 8
            remainder = allocSize AND 15 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
            IF remainder <= 8 THEN
              allocSize = allocSize + (8 - remainder)
            ELSE
              allocSize = allocSize + (24 - remainder)
            END IF

            IF allocSize > 0 THEN
              opSubRsp32 allocSize
            END IF

            ' Reset generator's stack tracking for the new perfectly aligned runtime frame
            stack.currentStackOffset = 0
            ff = updateStackAlignment

          CASE TC_ABI_EPILOGUE
            allocSize = tiraNode(ii).Arg1Val

            ' Recalculate the exact padding to restore RSP cleanly
            remainder = allocSize AND 15 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
            IF remainder <= 8 THEN
              allocSize = allocSize + (8 - remainder)
            ELSE
              allocSize = allocSize + (24 - remainder)
            END IF

            IF allocSize > 0 THEN
              opAddRsp32 allocSize
            END IF

            ' Temporarily restore stack tracking to reflect the two pushed registers (RBP, RBX)
            ' This prevents the compiler's underflow safety from triggering on the pops
            stack.currentStackOffset = 16
            ff = updateStackAlignment

            opPopReg 3 ' RBX

            emitByteCode &H5D
            stack.currentStackOffset = stack.currentStackOffset - 8
            ff = updateStackAlignment

            opRet

            ' Reset generator's stack tracking safely
            stack.currentStackOffset = 0
            ff = updateStackAlignment

          CASE TC_ABI_READ_ARG
            IF tiraNode(ii).Arg1Type <> TIRA_ARG_SYMBOL THEN
              tira_Cancel
              EXIT SUB
            END IF
            destVIdx = tiraNode(ii).Arg1Val
            targetType = symbols(destVIdx).DataType

            argIdx = tiraNode(ii).Arg2Val

            ' Because we spilled all registers to the shadow space in the prologue, we can
            ' uniformly read every argument directly from the stack using the RBP anchor
            ' [rbp + 16] = Arg 1, [rbp + 24] = Arg 2, [rbp + 48] = Arg 5, etc.
            stackOffset = 8 + (argIdx * 8)

            IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
              ff = opSSE(SSE_MOV, OP_TYPE_REG, 0, OP_TYPE_MEM_RBP, stackOffset, typeDb(targetType).LoadMode)
              ff = genSymbolRouteSSE(SSE_MOV, OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, typeDb(targetType).LoadMode, destVIdx)
            ELSE
              ' Read the 64-bit argument from the stack into RAX
              ff = opMov(OP_TYPE_REG, 0, OP_TYPE_MEM_RBP, stackOffset, 64)
              ' Write from RAX into the destination variable using its specific byte size
              ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, typeDb(targetType).StoreMode, destVIdx)
            END IF

          CASE TC_ABI_WRITE_RET
            IF tiraNode(ii).Arg1Type <> TIRA_ARG_SYMBOL THEN
              tira_Cancel
              EXIT SUB
            END IF
            srcVIdx = tiraNode(ii).Arg1Val
            targetType = symbols(srcVIdx).DataType

            IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
              ff = genSymbolRouteSSE(SSE_MOV, OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, typeDb(targetType).LoadMode, srcVIdx)
            ELSE
              ' Read from the source variable into RAX using its specific byte size and sign extension rules
              ff = genSymbolRouteMov(OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, typeDb(targetType).LoadMode, srcVIdx)
            END IF

          CASE TC_ASSIGN
            isFloat1 = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0)
            tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, isFloat1

          CASE TC_CAST
            tasm_DoCast tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val

          CASE TC_ADD, TC_SUB, TC_MUL, TC_DIV, TC_IDIV, TC_MOD, TC_AND, TC_OR, TC_XOR, TC_NOR, TC_NAND, TC_XNOR, TC_POW, TC_CONCAT, TC_COMPARE
            tasm_DoMath cmdNum, tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val

          CASE TC_SHL, TC_SHR, TC_SAR
            tasm_DoShift cmdNum, tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val

          CASE TC_NEG, TC_NOT
            tasm_DoUnary cmdNum, tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val

          CASE TC_TEST
            isFloat1 = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0)
            isFloat2 = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 3)

            IF isFloat1 > 0 THEN
              opMode = typeDb(TYPE_DOUBLE).LoadMode
              IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
              ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opMode)
            END IF

            IF isFloat2 > 0 THEN
              opMode = typeDb(TYPE_DOUBLE).LoadMode
              IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
              ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 3, OP_TYPE_REG, 3, opMode)
            END IF

            ff = opTest(OP_TYPE_REG, 0, OP_TYPE_REG, 3, 64)

          CASE TC_JCC
            jmpType = tiraNode(ii).Arg1Val
            IF tiraNode(ii).Arg2Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg2Val
              addPatch PATCH_GOTO, opJcc(jmpType, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), vIdx
            END IF
            IF compileError = 1 THEN
              tira_Cancel
              EXIT SUB
            END IF

          CASE TC_JMP, TC_JMP_USER
            IF tiraNode(ii).Arg1Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg1Val
              addPatch PATCH_GOTO, opJcc(JCC_JMP, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), vIdx
            END IF
            IF compileError = 1 THEN
              tira_Cancel
              EXIT SUB
            END IF

          CASE TC_READ_MEM
            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              destVIdx = tiraNode(ii).Arg1Val
              targetType = symbols(destVIdx).DataType

              ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 10)

              IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
                ff = opSSE(SSE_MOV, OP_TYPE_REG, 0, OP_TYPE_MEM_REG, 10, typeDb(targetType).LoadMode)
                isFloat1 = typeDb(targetType).IsFloat
              ELSE
                IF targetType = TYPE_STRING THEN
                  ff = opMov(OP_TYPE_REG, 0, OP_TYPE_MEM_REG, 10, 64)
                  isFloat1 = 0
                ELSE
                  ff = opMov(OP_TYPE_REG, 0, OP_TYPE_MEM_REG, 10, typeDb(targetType).LoadMode)
                  isFloat1 = 0
                END IF
              END IF

              tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, isFloat1
            ELSE
              throwCompilerErrorAndCancelTira "DESTINATION MUST BE A SYMBOL IN TC_READ_MEM", ASIS, 0
              EXIT SUB
            END IF

          CASE TC_READ_MEM_OFFSET
            dispVal = tiraNode(ii).Arg3Val

            ' Dynamically expands memory size to 32-bit for safety when the value exceeds signed 8-bit limits
            IF dispVal >= -128 AND dispVal <= 127 THEN
              memOpTypeR = OP_TYPE_MEM_REG_DISP8
            ELSE
              memOpTypeR = OP_TYPE_MEM_REG_DISP32
            END IF

            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              destVIdx = tiraNode(ii).Arg1Val
              targetType = symbols(destVIdx).DataType

              ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 10)

              IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
                ff = opSSE(SSE_MOV, OP_TYPE_REG, 0, memOpTypeR, 10 + (dispVal * 256), typeDb(targetType).LoadMode)
                isFloat1 = typeDb(targetType).IsFloat
              ELSE
                IF targetType = TYPE_STRING THEN
                  ff = opMov(OP_TYPE_REG, 0, memOpTypeR, 10 + (dispVal * 256), 64)
                  isFloat1 = 0
                ELSE
                  ff = opMov(OP_TYPE_REG, 0, memOpTypeR, 10 + (dispVal * 256), typeDb(targetType).LoadMode)
                  isFloat1 = 0
                END IF
              END IF

              tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, isFloat1
            ELSE
              throwCompilerErrorAndCancelTira "DESTINATION MUST BE A SYMBOL IN TC_READ_MEM_OFFSET", ASIS, 0
              EXIT SUB
            END IF

          CASE TC_WRITE_MEM
            ff = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 10)
            isFloat2 = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0)

            IF tiraNode(ii).Arg3Type = TIRA_ARG_STR_LITERAL THEN
              IF isFloat2 = 0 THEN
                ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_DOUBLE).LoadMode)
                isFloat2 = typeDb(TYPE_DOUBLE).IsFloat
              END IF
              opMode = typeDb(TYPE_DOUBLE).LoadMode
              IF tiraNode(ii).Arg3Val = 32 THEN opMode = typeDb(TYPE_SINGLE).LoadMode

              IF isFloat2 = typeDb(TYPE_DOUBLE).IsFloat AND tiraNode(ii).Arg3Val = 32 THEN
                ff = opSSE(SSE_CVTSD2SS, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_DOUBLE).LoadMode)
              END IF
              IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat AND tiraNode(ii).Arg3Val = 64 THEN
                ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_SINGLE).LoadMode)
              END IF

              ff = opSSE(SSE_MOV, OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 0, opMode)
            ELSE
              IF isFloat2 > 0 THEN
                opMode = typeDb(TYPE_DOUBLE).LoadMode
                IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
                ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opMode)
              END IF

              SELECT CASE tiraNode(ii).Arg3Val

                CASE 1: ff = opMov(OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 0, 8)
                CASE 2: ff = opMov(OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 0, 16)
                CASE 4: ff = opMov(OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 0, 32)
                CASE 8: ff = opMov(OP_TYPE_MEM_REG, 10, OP_TYPE_REG, 0, 64)

              END SELECT ' Arg3Val

            END IF

          CASE TC_WRITE_MEM_OFFSET
            dispVal = tiraNode(ii).Arg2Val

            ' Dynamically expands memory size to 32-bit for safety when the value exceeds signed 8-bit limits
            IF dispVal >= -128 AND dispVal <= 127 THEN
              memOpTypeW = OP_TYPE_MEM_REG_DISP8
            ELSE
              memOpTypeW = OP_TYPE_MEM_REG_DISP32
            END IF

            ff = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 10)
            isFloat2 = tasm_LoadOperand(tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, 0)

            IF tiraNode(ii).Arg4Type = TIRA_ARG_STR_LITERAL THEN
              IF isFloat2 = 0 THEN
                ff = opSSE(SSE_CVTSI2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_DOUBLE).LoadMode)
                isFloat2 = typeDb(TYPE_DOUBLE).IsFloat
              END IF
              opMode = typeDb(TYPE_DOUBLE).LoadMode
              IF tiraNode(ii).Arg4Val = 32 THEN opMode = typeDb(TYPE_SINGLE).LoadMode

              IF isFloat2 = typeDb(TYPE_DOUBLE).IsFloat AND tiraNode(ii).Arg4Val = 32 THEN
                ff = opSSE(SSE_CVTSD2SS, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_DOUBLE).LoadMode)
              END IF
              IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat AND tiraNode(ii).Arg4Val = 64 THEN
                ff = opSSE(SSE_CVTSS2SD, OP_TYPE_REG, 0, OP_TYPE_REG, 0, typeDb(TYPE_SINGLE).LoadMode)
              END IF

              ff = opSSE(SSE_MOV, memOpTypeW, 10 + (dispVal * 256), OP_TYPE_REG, 0, opMode)
            ELSE
              IF isFloat2 > 0 THEN
                opMode = typeDb(TYPE_DOUBLE).LoadMode
                IF isFloat2 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode
                ff = opSSE(SSE_CVTSD2SI, OP_TYPE_REG, 0, OP_TYPE_REG, 0, opMode)
              END IF

              SELECT CASE tiraNode(ii).Arg4Val

                CASE 1: ff = opMov(memOpTypeW, 10 + (dispVal * 256), OP_TYPE_REG, 0, 8)
                CASE 2: ff = opMov(memOpTypeW, 10 + (dispVal * 256), OP_TYPE_REG, 0, 16)
                CASE 4: ff = opMov(memOpTypeW, 10 + (dispVal * 256), OP_TYPE_REG, 0, 32)
                CASE 8: ff = opMov(memOpTypeW, 10 + (dispVal * 256), OP_TYPE_REG, 0, 64)

              END SELECT ' Arg4Val

            END IF

          CASE TC_SWAP_MEM
            tasm_DoSwap tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val

          CASE TC_MEMCPY
            opPushReg 7 ' Protect ABI non-volatile RDI
            opPushReg 6 ' Protect ABI non-volatile RSI

            ff = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 7) ' Load into RDI
            ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 6) ' Load into RSI

            opPushReg 1 ' Protect volatile RCX
            ff = tasm_LoadOperand(tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, 1) ' Load into RCX

            ff = opTest(OP_TYPE_REG, 1, OP_TYPE_REG, 1, 64)
            jmpSkipMemCpy = opJcc(JCC_JLE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)
            opFlag FLAG_CLD
            opString STR_MOVS, REP_REP, 8
            patch8 jmpSkipMemCpy

            opPopReg 1
            opPopReg 6
            opPopReg 7

          CASE TC_MEMSET
            opPushReg 7 ' Protect ABI non-volatile RDI
            ff = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 7) ' Load into RDI
            ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0) ' Load into RAX

            opPushReg 1 ' Protect volatile RCX
            ff = tasm_LoadOperand(tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, 1) ' Load into RCX

            ff = opTest(OP_TYPE_REG, 1, OP_TYPE_REG, 1, 64)
            jmpSkipMemSet = opJcc(JCC_JLE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)
            opFlag FLAG_CLD

            SELECT CASE tiraNode(ii).Arg4Val

              CASE 2: opString STR_STOS, REP_REP, 16
              CASE 4: opString STR_STOS, REP_REP, 32
              CASE 8: opString STR_STOS, REP_REP, 64
              CASE ELSE: opString STR_STOS, REP_REP, 8

            END SELECT ' Arg4Val

            patch8 jmpSkipMemSet

            opPopReg 1
            opPopReg 7

          CASE TC_JMP_COND
            ff = tasm_DoJumpCond(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, tiraNode(ii).Arg4Type, tiraNode(ii).Arg4Val)
            IF ff = 0 THEN
              tira_Cancel
              EXIT SUB
            END IF

          CASE TC_GET_RET
            IF tiraNode(ii).Arg1Type <> TIRA_ARG_SYMBOL THEN
              throwCompilerErrorAndCancelTira "FATAL: TC_GET_RET dest must be a symbol", ASIS, 0
              EXIT SUB
            END IF
            destIdx = tiraNode(ii).Arg1Val
            targetType = symbols(destIdx).DataType

            IF targetType = TYPE_SINGLE OR targetType = TYPE_DOUBLE THEN
              ff = genSymbolRouteSSE(SSE_MOV, OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, typeDb(targetType).LoadMode, destIdx)
            ELSE

              SELECT CASE targetType

                CASE TYPE_BYTE, TYPE_UBYTE
                  ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 8, destIdx)
                CASE TYPE_INTEGER, TYPE_UINTEGER
                  ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 16, destIdx)
                CASE TYPE_LONG, TYPE_ULONG
                  ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 32, destIdx)
                CASE TYPE_INTEGER64, TYPE_UINT64
                  ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 64, destIdx)
                CASE TYPE_STRING
                  IF symbols(destIdx).IsTempInternal = 1 THEN
                    ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 64, destIdx)
                  ELSE
                    opPushReg 1
                    opPushReg 2

                    ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, 0, 64)

                    IF symbols(destIdx).IsLocal = LOCAL_STANDARD AND symbols(destIdx).IsShared = 0 AND symbols(destIdx).IsTempInternal = 0 THEN
                      ff = genSymbolRouteLea(1, destIdx)
                    ELSE
                      ff = genSymbolRouteMov(OP_TYPE_REG, 1, OP_TYPE_MEM_RIP, 0, 64, destIdx)
                    END IF

                    opPushReg 8
                    opPushReg 9
                    opPushReg 10
                    opPushReg 11

                    pushedDummy = 0
                    IF updateStackAlignment = 0 THEN
                      opPushReg 13
                      pushedDummy = 1
                    END IF

                    ' Allocate 32 bytes shadow space to prevent prologue stack corruption
                    ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
                    stack.currentStackOffset = stack.currentStackOffset + 32
                    ff = updateStackAlignment

                    rtIsUsed(RT_STR_ASSIGN) = 1
                    addPatch PATCH_RT, opCall(0, CALLMODE_REL32), RT_STR_ASSIGN
                    IF compileError = 1 THEN
                      tira_Cancel
                      EXIT SUB
                    END IF

                    ' Restore shadow space
                    ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, 32, 64)
                    stack.currentStackOffset = stack.currentStackOffset - 32
                    ff = updateStackAlignment

                    IF pushedDummy = 1 THEN
                      opPopReg 13
                    END IF

                    opPopReg 11
                    opPopReg 10
                    opPopReg 9
                    opPopReg 8

                    opPopReg 2
                    opPopReg 1
                  END IF
                CASE ELSE
                  ff = genSymbolRouteMov(OP_TYPE_MEM_RIP, 0, OP_TYPE_REG, 0, 64, destIdx)

              END SELECT ' targetType

            END IF

          CASE TC_GET_RSP
            ff = opMov(OP_TYPE_REG, 0, OP_TYPE_REG, 4, 64)
            tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, 0

          CASE TC_SET_RSP
            ff = resolveSymbol("!G_SYS_PTR_SAFE_RSP")
            IF ff = 1 THEN
              vIdx = returnedData2
              ' Safely load the pristine pointer into RAX (Register 0)
              ff = genSymbolRouteMov(OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, 64, vIdx)

              ' Manually emit the raw hardware opcodes to force RSP and RBP to inherit RAX
              ' This specifically bypasses opMov's safety lock against targeting stack registers

              ' MOV RSP, RAX
              emitByteCode &H48
              emitByteCode &H89
              emitByteCode &HC4

              ' MOV RBP, RAX
              emitByteCode &H48
              emitByteCode &H89
              emitByteCode &HC5
            ELSE
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN SET_RSP", ASIS, 0
              EXIT SUB
            END IF
            ' Do not update stack.currentStackOffset here!
            ' TC_SET_RSP is a runtime death jump designed for tiraFatalError.
            ' Modifying stack tracker here desynchronizes the compiler's view of the stack for the active valid block.

          CASE TC_MEMERROR
            ' Force an immediate access violation by writing to a null pointer
            ff = opALU(ALU_XOR, OP_TYPE_REG, 0, OP_TYPE_REG, 0, 64)
            ff = opMov(OP_TYPE_MEM_REG, 0, OP_TYPE_REG, 0, 64)

          CASE TC_CALL
            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              funcSymbolIdx = tiraNode(ii).Arg1Val

              IF funcSymbolIdx < 0 OR funcSymbolIdx >= symbolCount THEN
                throwCompilerErrorAndCancelTira "TC_CALL REQUIRES VALID FUNCTION SYMBOL ID", ASIS, 0
                EXIT SUB
              END IF
            ELSE
              throwCompilerErrorAndCancelTira "TC_CALL REQUIRES SYMBOL FOR FUNCTION NAME", ASIS, 0
              EXIT SUB
            END IF

            argCount = tiraNode(ii).Arg2Val

            IF argCount > 16 THEN
              throwCompilerErrorAndCancelTira "TIRA_CALL WITH > 16 ARGS NOT SUPPORTED", ASIS, 0
              EXIT SUB
            END IF

            callKind = symbols(funcSymbolIdx).CallKind
            callTarget = symbols(funcSymbolIdx).CallTarget

            IF callKind = TIRA_CALL_KIND_NONE THEN
              callTarget = symbols(funcSymbolIdx).SubIndex
              IF callTarget > 0 AND callTarget < subCount THEN
                callKind = TIRA_CALL_KIND_SUB
              END IF
            END IF

            SELECT CASE callKind

              CASE TIRA_CALL_KIND_RUNTIME
                IF callTarget = RT_INVALID THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "RUNTIME HELPER NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                  EXIT SUB
                END IF

              CASE TIRA_CALL_KIND_IAT
                IF callTarget = IAT_INVALID THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "INVALID IAT CALL: " + funcName$, ASIS, 0
                  EXIT SUB
                END IF

              CASE TIRA_CALL_KIND_SUB
                IF callTarget <= 0 OR callTarget >= subCount THEN
                  funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                  throwCompilerErrorAndCancelTira "SUB NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                  EXIT SUB
                END IF

              CASE ELSE
                funcName$ = RTRIM$(symbols(funcSymbolIdx).RecordName)
                throwCompilerErrorAndCancelTira "SUB NOT FOUND IN TIRA_CALL: " + funcName$, ASIS, 0
                EXIT SUB

            END SELECT ' callKind

            allocSize = 32 ' ALWAYS allocate shadow space for x64 ABI compliance
            IF argCount > 4 THEN
              allocSize = allocSize + ((argCount - 4) * 8)
            END IF

            ' Standardize payload strictly for alignment guarantee
            IF (allocSize AND 15) <> 0 THEN ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
              allocSize = allocSize + 8
            END IF

            pushedDummy = 0
            IF updateStackAlignment = 0 THEN
              opPushReg 13
              pushedDummy = 1
            END IF

            ' Allocate shadow space and standard stack argument routing array
            IF allocSize > 0 THEN
              ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, allocSize, 64)
              stack.currentStackOffset = stack.currentStackOffset + allocSize
              ff = updateStackAlignment
            END IF

            ' Standard Win64 Calling Convention Routing Loop
            FOR iArg = 0 TO argCount - 1
              ' Determine type first to choose a safe scratch register.
              ' Using XMM10 clobbers a non-volatile float register in the ABI.
              ' We must use a volatile XMM register (like XMM4) for floats, and R10 for integers.
              dt1 = tasm_GetOperandType(tiraCallArg(ii, iArg).ArgType, tiraCallArg(ii, iArg).ArgVal)

              isFloat1 = 0
              IF dt1 = TYPE_SINGLE OR dt1 = TYPE_DOUBLE THEN
                isFloat1 = typeDb(dt1).IsFloat
              END IF

              IF isFloat1 > 0 THEN
                ' Load float into XMM4 (4) safely to prevent overwriting ABI registers
                ff = tasm_LoadOperand(tiraCallArg(ii, iArg).ArgType, tiraCallArg(ii, iArg).ArgVal, 4)

                ' Route to standard XMM register block or Stack
                opMode = typeDb(TYPE_DOUBLE).LoadMode
                IF isFloat1 = typeDb(TYPE_SINGLE).IsFloat THEN opMode = typeDb(TYPE_SINGLE).LoadMode

                SELECT CASE iArg

                  CASE 0: ff = opSSE(SSE_MOV, OP_TYPE_REG, 0, OP_TYPE_REG, 4, opMode)
                  CASE 1: ff = opSSE(SSE_MOV, OP_TYPE_REG, 1, OP_TYPE_REG, 4, opMode)
                  CASE 2: ff = opSSE(SSE_MOV, OP_TYPE_REG, 2, OP_TYPE_REG, 4, opMode)
                  CASE 3: ff = opSSE(SSE_MOV, OP_TYPE_REG, 3, OP_TYPE_REG, 4, opMode)
                  CASE ELSE
                    ' ALWAYS use the absolute stack index now, no need to separate IAT and internal
                    ff = opSSE(SSE_MOV, OP_TYPE_MEM_RSP, 32 + ((iArg - 4) * 8), OP_TYPE_REG, 4, opMode)

                END SELECT ' iArg

                '''' VARARGS mirroring
                ' The Windows x64 ABI requires that varargs functions (like sprintf)
                ' receive float values in BOTH the XMM register and the corresponding GPR
                IF iArg < 4 THEN
                  ' Copy XMM4 into R10 without converting (bitwise copy)
                  ff = opSSE(SSE_MOVQ_REG_XMM, OP_TYPE_REG, 10, OP_TYPE_REG, 4, typeDb(TYPE_DOUBLE).LoadMode)
                  ' Route R10 to the correct General Purpose Register

                  SELECT CASE iArg

                    CASE 0: ff = opMov(OP_TYPE_REG, 1, OP_TYPE_REG, 10, 64)
                    CASE 1: ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, 10, 64)
                    CASE 2: ff = opMov(OP_TYPE_REG, 8, OP_TYPE_REG, 10, 64)
                    CASE 3: ff = opMov(OP_TYPE_REG, 9, OP_TYPE_REG, 10, 64)

                  END SELECT ' iArg

                END IF

              ELSE
                ' Load integer into R10 (10) safely to prevent overwriting ABI registers
                ff = tasm_LoadOperand(tiraCallArg(ii, iArg).ArgType, tiraCallArg(ii, iArg).ArgVal, 10)

                ' Route to standard GPR block (RCX, RDX, R8, R9) or Stack

                SELECT CASE iArg

                  CASE 0: ff = opMov(OP_TYPE_REG, 1, OP_TYPE_REG, 10, 64)
                  CASE 1: ff = opMov(OP_TYPE_REG, 2, OP_TYPE_REG, 10, 64)
                  CASE 2: ff = opMov(OP_TYPE_REG, 8, OP_TYPE_REG, 10, 64)
                  CASE 3: ff = opMov(OP_TYPE_REG, 9, OP_TYPE_REG, 10, 64)
                  CASE ELSE
                    ff = opMov(OP_TYPE_MEM_RSP, 32 + ((iArg - 4) * 8), OP_TYPE_REG, 10, 64)

                END SELECT ' iArg

              END IF
            NEXT

            ' Resolve Subroutine offset dynamically
            ' Route the already-resolved numeric call target without returning to its symbol name
            SELECT CASE callKind

              CASE TIRA_CALL_KIND_RUNTIME
                rtIsUsed(callTarget) = 1

                addPatch PATCH_RT, opCall(0, CALLMODE_REL32), callTarget
                IF compileError = 1 THEN
                  t.IsActive = 0
                  EXIT SUB
                END IF

              CASE TIRA_CALL_KIND_IAT
                ' Directly run an unprotected opCall because TIRA_CALL intrinsically guarantees stack alignments
                ff = opCall(callTarget, CALLMODE_IAT)
                IF compileError = 1 THEN
                  tira_Cancel
                  EXIT SUB
                END IF

              CASE TIRA_CALL_KIND_SUB
                ' User SUB mapping
                IF subs(callTarget).IsDll = 1 THEN
                  ' DLL call seamlessly utilizes the IAT structure mapped via buildImportTable dynamically
                  addPatch PATCH_IAT, opCall(0, CALLMODE_IAT), 1000 + callTarget
                ELSE
                  addPatch PATCH_CALL, opCall(0, CALLMODE_REL32), callTarget
                END IF

                IF compileError = 1 THEN
                  tira_Cancel
                  EXIT SUB
                END IF

            END SELECT ' callKind

            ' Restore stack footprint offsets safely
            IF allocSize > 0 THEN
              ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, allocSize, 64)
              stack.currentStackOffset = stack.currentStackOffset - allocSize
              ff = updateStackAlignment
            END IF
            IF pushedDummy = 1 THEN
              opPopReg 13
            END IF

          CASE TC_XCHG
            ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0)

            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL OR tiraNode(ii).Arg1Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg1Val
              ff = genSymbolRouteLea(10, vIdx)

              SELECT CASE tiraNode(ii).Arg3Val

                CASE 4
                  emitByteCode &H41: emitByteCode &H87: emitByteCode &H02
                CASE 8
                  emitByteCode &H49: emitByteCode &H87: emitByteCode &H02
                CASE ELSE
                  emitByteCode &H41: emitByteCode &H87: emitByteCode &H02

              END SELECT ' Arg3Val

              tasm_StoreOperand tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0, 0
            ELSE
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN XCHG", ASIS, 0
              EXIT SUB
            END IF

          CASE TC_CMPXCHG
            ff = tasm_LoadOperand(tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, 11) ' Load new value into R11
            ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0) ' Load comparison value into RAX

            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL OR tiraNode(ii).Arg1Type = TIRA_ARG_LABEL THEN
              vIdx = tiraNode(ii).Arg1Val
              ff = genSymbolRouteLea(10, vIdx) ' Load address into R10

              emitByteCode &HF0 ' LOCK prefix for atomic safety

              SELECT CASE tiraNode(ii).Arg4Val

                CASE 4
                  emitByteCode &H45: emitByteCode &H0F: emitByteCode &HB1: emitByteCode &H1A
                CASE 8
                  emitByteCode &H4D: emitByteCode &H0F: emitByteCode &HB1: emitByteCode &H1A
                CASE ELSE
                  emitByteCode &H45: emitByteCode &H0F: emitByteCode &HB1: emitByteCode &H1A

              END SELECT ' Arg4Val

              tasm_StoreOperand tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 0, 0
            ELSE
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN CMPXCHG", ASIS, 0
              EXIT SUB
            END IF

          CASE TC_BREAK
            emitByteCode &HCC

          CASE TC_ADDRESS_OF
            IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL OR tiraNode(ii).Arg2Type = TIRA_ARG_LABEL THEN
              srcVIdx = tiraNode(ii).Arg2Val
              IF symbols(srcVIdx).CallKind = TIRA_CALL_KIND_RUNTIME THEN
                rtAddrOffset = symbols(srcVIdx).CallTarget

                IF rtAddrOffset = RT_INVALID THEN
                  symName$ = RTRIM$(symbols(srcVIdx).RecordName)
                  throwCompilerErrorAndCancelTira "RUNTIME HELPER NOT FOUND IN TC_ADDRESS_OF: " + symName$, ASIS, 0
                  EXIT SUB
                END IF

                rtIsUsed(rtAddrOffset) = 1

                addPatch PATCH_RT, opLea(OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, 64), rtAddrOffset
                IF compileError = 1 THEN
                  tira_Cancel
                  EXIT SUB
                END IF

                tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, 0
              ELSE
                ' Generate the Load Effective Address (LEA) into RAX (Register 0)
                ff = genSymbolRouteLea(0, srcVIdx)
                ' Store the calculated address from RAX into the destination variable
                tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, 0
              END IF
            ELSE
              throwCompilerErrorAndCancelTira "SYMBOL NOT FOUND IN ADDRESS_OF", ASIS, 0
              EXIT SUB
            END IF

          CASE TC_RESUME
            ff = resolveSymbol("!G_ERR_PTR_LAST")
            IF ff = 1 THEN
              ff = genSymbolRouteMov(OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, 64, returnedData2)
            END IF
            IF compileError = 1 THEN
              tira_Cancel
              EXIT SUB
            END IF
            emitByteCode &HFF: emitByteCode &HE0

          CASE TC_LEA_SIB
            ff = tasm_LoadOperand(tiraNode(ii).Arg2Type, tiraNode(ii).Arg2Val, 10) ' Load Base into R10
            ff = tasm_LoadOperand(tiraNode(ii).Arg3Type, tiraNode(ii).Arg3Val, 11) ' Load Index into R11

            ' opLea_SIB(destReg, baseReg, indexReg, scaleVal, dispVal, opSize)
            ff = opLea_SIB(0, 10, 11, tiraNode(ii).Arg4Val, 0, 64) ' RAX = R10 + R11*scale

            tasm_StoreOperand tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0, 0 ' Store RAX back to dest

          CASE TC_BOUNDS_CHECK
            ff = resolveSymbol("@NATIVE_BOUNDS_HANDLER")
            IF ff = 1 THEN
              vIdx = returnedData2
            ELSE
              throwCompilerErrorAndCancelTira "FATAL: @NATIVE_BOUNDS_HANDLER NOT FOUND", ASIS, 0
              EXIT SUB
            END IF

            ' Safety Check: Ensure the index is an integer before proceeding
            isFloat1 = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0)
            IF isFloat1 > 0 THEN
              throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK INDEX CANNOT BE FLOAT", ASIS, 0
              EXIT SUB
            END IF

            IF tiraNode(ii).Arg1Type = TIRA_ARG_SYMBOL THEN
              dt1 = symbols(tiraNode(ii).Arg1Val).DataType
              IF dt1 <> TYPE_INTEGER64 AND dt1 <> TYPE_UINT64 THEN
                throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK INDEX MUST BE 64-BIT INTEGER", ASIS, 0
                EXIT SUB
              END IF
            END IF

            ' Optimization: Compare RAX directly against the limit in memory or literal
            IF tiraNode(ii).Arg2Type = TIRA_ARG_LITERAL THEN
              ' x64 CMP cannot take a 64-bit immediate. It sign-extends 32-bit immediates.
              ' If the literal exceeds signed 32-bit limits, we must route it through a register.
              IF tiraNode(ii).Arg2Val < -2147483648 OR tiraNode(ii).Arg2Val > 2147483647 THEN
                ff = opMov(OP_TYPE_REG, 11, OP_TYPE_IMM, tiraNode(ii).Arg2Val, MODE_IMM64)
                ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_REG, 11, 64)
              ELSE
                ff = opALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_IMM, tiraNode(ii).Arg2Val, 64)
              END IF
            ELSE
              IF tiraNode(ii).Arg2Type = TIRA_ARG_SYMBOL THEN
                srcVIdx = tiraNode(ii).Arg2Val

                ' Safety Check: Ensure the limit is strictly a 64-bit integer
                ' because genSymbolRouteALU is hardcoded to execute a 64-bit read
                dt2 = symbols(srcVIdx).DataType
                IF dt2 <> TYPE_INTEGER64 AND dt2 <> TYPE_UINT64 THEN
                  throwCompilerErrorAndCancelTira "FATAL: BOUNDS CHECK LIMIT MUST BE 64-BIT INTEGER", ASIS, 0
                  EXIT SUB
                END IF

                ff = genSymbolRouteALU(ALU_CMP, OP_TYPE_REG, 0, OP_TYPE_MEM_RIP, 0, 64, srcVIdx)
              ELSE
                throwCompilerErrorAndCancelTira "FATAL: INVALID BOUNDS CHECK LIMIT TYPE", ASIS, 0
                EXIT SUB
              END IF
            END IF

            ' Speed boost optimization: Using unsigned jump (JAE) checks both < 0 and >= max limit simultaneously
            addPatch PATCH_GOTO, opJcc(JCC_JAE, JCC_MODE_FORWARD, 0, JCC_TYPE_NEAR), vIdx

          CASE TC_REDIM
            ' Redim memory reallocation is abstracted cleanly into frontend heap commands

          CASE TC_JMP_DYN
            ff = tasm_LoadOperand(tiraNode(ii).Arg1Type, tiraNode(ii).Arg1Val, 0)
            emitByteCode &HFF: emitByteCode &HE0

          CASE ELSE
            throwCompilerErrorAndCancelTira "TIRA COMMAND NOT IMPLEMENTED IN BACKEND", ASIS, 0
            EXIT SUB

        END SELECT ' cmdNum

      END IF
    NEXT
  END IF

  t.LineCount = 0 ' Reset for another TIRA round, triggered by tira start function
  t.IsActive = 0

END SUB ' tira_EndAndProcess

''''''''''''''''''''''''
SUB tira_Start

  IF t.IsActive <> 0 THEN
    throwCompilerError "TIRA QUEUE ALREADY ACTIVE", ASIS, 0
    EXIT SUB
  END IF

  t.IsActive = 1

  ' Initializes the localized 3AC queue for a single BASIC statement
  t.LineCount = 0

  ' Reset the ephemeral TIRA variable counter for this specific statement block
  t.TempCounter = 0

END SUB ' tira_Start

''''''''''''''''''''''''
SUB tiraAbiEpilogueId (frameSize AS LONG)

  tiraCheckActive ("tiraAbiEpilogueId")
  IF tiraLineCheckId THEN EXIT SUB

  IF isCompilingRT = 1 AND rtWrapperActive = 0 THEN
    throwCompilerError "MANUAL ABI COMMANDS NOT ALLOWED IN RUNTIMES, USE tiraRT_Prologue", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_ABI_EPILOGUE

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = frameSize

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraAbiEpilogueId

''''''''''''''''''''''''
SUB tiraAbiPrologueId (frameSize AS LONG)

  tiraCheckActive ("tiraAbiPrologueId")
  IF tiraLineCheckId THEN EXIT SUB

  IF isCompilingRT = 1 AND rtWrapperActive = 0 THEN
    throwCompilerError "MANUAL ABI COMMANDS NOT ALLOWED IN RUNTIMES, USE tiraRT_Prologue", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_ABI_PROLOGUE

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = frameSize

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraAbiPrologueId

''''''''''''''''''''''''
SUB tiraAbiReadArgId (destVal AS LONG, argIdx AS LONG)

  tiraCheckActive ("tiraAbiReadArgId")
  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_ABI_READ_ARG

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_SYMBOL
  tiraNode(t.LineCount).Arg1Val = destVal

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg2Val = argIdx

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraAbiReadArgId

''''''''''''''''''''''''
SUB tiraAbiWriteRetId (srcVal AS LONG)

  tiraCheckActive ("tiraAbiWriteRetId")
  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_ABI_WRITE_RET

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_SYMBOL
  tiraNode(t.LineCount).Arg1Val = srcVal

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraAbiWriteRetId

''''''''''''''''''''''''
FUNCTION tiraAllocTempMemId& (sizeType AS LONG, sizeVal AS _INTEGER64)

  tiraCheckActive ("tiraAllocTempMemId&")

  tiraAllocTempMemId& = 0
  IF tiraLineCheckId THEN EXIT FUNCTION

  DIM paddedSizeIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM skipUnderflowLblIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM osPtrIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM skipUpdateLblIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM tempBaseIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM spillHeadIdx AS LONG
  DIM heapAllocIdx AS LONG

  IF engineSymbolIds.IsReady <> 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tempHeapIdx = internalTempHeapSymbolIdx
  tempBaseIdx = engineSymbolIds.MemPtrTempBase
  processHeapIdx = engineSymbolIds.MemPtrProcessHeap
  spillHeadIdx = engineSymbolIds.MemPtrSpillHead

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  heapAllocIdx = returnedData2

  paddedSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, paddedSizeIdx, sizeType, sizeVal, TIRA_ARG_LITERAL, 7
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_LITERAL, -8

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, paddedSizeIdx

  skipUnderflowLblIdx = tiraLabelCreateNewId&("TEMP_HEAP_OK")
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, tempBaseIdx, skipUnderflowLblIdx

  ' Fallback: Allocate from OS Heap (paddedSize + 8) directly to prevent overflow
  allocSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_LITERAL, 8

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_SYMBOL, allocSizeIdx
  osPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraGetRetId osPtrIdx

  skipOomLblIdx = tiraLabelCreateNewId&("SPILL_OOM_SKIP")
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, osPtrIdx, TIRA_ARG_LITERAL, 0, skipOomLblIdx
  tiraFatalErrorId "TEMPORARY HEAP OUT OF MEMORY"
  IF compileError = 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraLabelId skipOomLblIdx

  ' Link the massive OS allocation directly into the current execution scope's spill list
  tiraWriteMemId TIRA_ARG_SYMBOL, osPtrIdx, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 8
