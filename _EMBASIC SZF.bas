  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, prevHeadIdx, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, prevHeadIdx, TIRA_ARG_SYMBOL, prevHeadIdx, TIRA_ARG_LITERAL, 511

  prevOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, prevOffsetIdx, TIRA_ARG_SYMBOL, prevHeadIdx, TIRA_ARG_LITERAL, 16

  bufArrPtrFilterIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufArrPtrFilterIdx, TIRA_ARG_SYMBOL, symInoArrMouseBufIdx

  prevRecPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, prevRecPtrIdx, TIRA_ARG_SYMBOL, bufArrPtrFilterIdx, TIRA_ARG_SYMBOL, prevOffsetIdx

  prevWheelIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId prevWheelIdx, TIRA_ARG_SYMBOL, prevRecPtrIdx, 8

  prevBtnsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId prevBtnsIdx, TIRA_ARG_SYMBOL, prevRecPtrIdx, 12

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, prevWheelIdx, TIRA_ARG_LITERAL, 0, skipFilterLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, prevBtnsIdx, TIRA_ARG_SYMBOL, finalBtnsIdx, skipFilterLblIdx

  prevXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId prevXIdx, TIRA_ARG_SYMBOL, prevRecPtrIdx

  prevYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId prevYIdx, TIRA_ARG_SYMBOL, prevRecPtrIdx, 4

  isStationaryLblIdx = tiraLabelCreateNewId&("MOUSE_STATIONARY")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, prevXIdx, TIRA_ARG_SYMBOL, mouseXIdx, isStationaryLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, prevYIdx, TIRA_ARG_SYMBOL, mouseYIdx, isStationaryLblIdx

  tiraJmpId skipMouseEndIdx

  tiraLabelId isStationaryLblIdx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, symWndValLastMsgIdx, TIRA_ARG_LITERAL, 512, skipFilterLblIdx

  tiraAssignId headValIdx, TIRA_ARG_SYMBOL, prevHeadIdx

  tiraLabelId skipFilterLblIdx

  nextHeadIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nextHeadIdx, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, nextHeadIdx, TIRA_ARG_SYMBOL, nextHeadIdx, TIRA_ARG_LITERAL, 511

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, nextHeadIdx, TIRA_ARG_SYMBOL, tailValIdx, skipMouseEndIdx

  bufArrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufArrPtrIdx, TIRA_ARG_SYMBOL, symInoArrMouseBufIdx

  offsetValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetValIdx, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_LITERAL, 16

  recPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, recPtrIdx, TIRA_ARG_SYMBOL, bufArrPtrIdx, TIRA_ARG_SYMBOL, offsetValIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, recPtrIdx, TIRA_ARG_SYMBOL, mouseXIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, recPtrIdx, 4, TIRA_ARG_SYMBOL, mouseYIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, recPtrIdx, 8, TIRA_ARG_SYMBOL, mouseWheelIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, recPtrIdx, 12, TIRA_ARG_SYMBOL, finalBtnsIdx, TIRA_ARG_LITERAL, 4

  tiraWriteMemId TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, nextHeadIdx, TIRA_ARG_LITERAL, 4

  tiraAssignId symWndValLastMsgIdx, TIRA_ARG_SYMBOL, msgValIdx

  tiraLabelId skipMouseEndIdx
  tiraJmpId lblOnDefaultIdx

  tiraLabelId lblUserIdx

  tiraCallId0 funcIatGetcurrentthreadidIdx
  tiraGetRetId symSysValUserThreadIdIdx

  lblSpinTopIdx = tiraLabelCreateNewId&("SPIN_TOP")
  lblSpinEndIdx = tiraLabelCreateNewId&("SPIN_END")
  tiraLabelId lblSpinTopIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, symWndFlgReadyIdx, TIRA_ARG_LITERAL, 0, lblSpinEndIdx
  tiraCallId1 funcIatSleepIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblSpinTopIdx
  tiraLabelId lblSpinEndIdx

  tira_EndAndProcess

END SUB ' emitPrologueWindowSetup

''''''''''''''''''''''''
SUB emitRuntimeAll

  DIM skipRuntimeLblIdx AS LONG

  ' Some runtime routines rely on other smaller helpers to do their job
  ' We flag those required helpers here so they get compiled into the executable
  IF rtIsUsed(RT_DRAW) = 1 THEN
    rtIsUsed(RT_LINE) = 1
    rtIsUsed(RT_PAINT) = 1
    rtIsUsed(RT_PRINT_STR) = 1
    rtIsUsed(RT_PRINT_INT) = 1
    rtIsUsed(RT_CRLF) = 1
    rtIsUsed(RT_SWAP_BUFFERS) = 1
  END IF
  IF rtIsUsed(RT_LINE) = 1 THEN rtIsUsed(RT_PLOT_PIXEL) = 1
  IF rtIsUsed(RT_CIRCLE) = 1 THEN rtIsUsed(RT_PLOT_PIXEL) = 1
  IF rtIsUsed(RT_VEH_HANDLER) = 1 THEN
    rtIsUsed(RT_PRINT_STR) = 1
    rtIsUsed(RT_CRLF) = 1
    rtIsUsed(RT_PRINT_INT) = 1
  END IF
  IF rtIsUsed(RT_INPUT) = 1 THEN
    rtIsUsed(RT_STR_ASSIGN) = 1
    rtIsUsed(RT_CRLF) = 1
    IF cm.HasGraphics = 0 THEN
      rtIsUsed(RT_PRINT_STR) = 1
    ELSE
      rtIsUsed(RT_GFX_APPEND) = 1
    END IF
  END IF
  IF rtIsUsed(RT_READ) = 1 THEN
    rtIsUsed(RT_STR_ASSIGN) = 1
    rtIsUsed(RT_PRINT_STR) = 1
    rtIsUsed(RT_CRLF) = 1
  END IF

  IF rtIsUsed(RT_PRINT_USING) = 1 THEN
    rtIsUsed(RT_PRINT_STR) = 1
    rtIsUsed(RT_PRINT_INT) = 1
    rtIsUsed(RT_CRLF) = 1
    IF cm.HasGraphics = 1 THEN rtIsUsed(RT_SWAP_BUFFERS) = 1
  END IF

  IF cm.HasGraphics = 1 THEN
    IF rtIsUsed(RT_PRINT_INT) = 1 THEN rtIsUsed(RT_GFX_APPEND) = 1
    IF rtIsUsed(RT_PRINT_FLOAT) = 1 THEN rtIsUsed(RT_GFX_APPEND) = 1
    IF rtIsUsed(RT_PRINT_STR) = 1 THEN rtIsUsed(RT_GFX_APPEND) = 1
    IF rtIsUsed(RT_GFX_APPEND) = 1 THEN rtIsUsed(RT_DRAW_TEXT_ABSOLUTE) = 1
    IF rtIsUsed(RT_AUTODISPLAY_CHECK) = 1 THEN rtIsUsed(RT_SWAP_BUFFERS) = 1
    IF rtIsUsed(RT_PAINT) = 1 THEN
      rtIsUsed(RT_SWAP_BUFFERS) = 1
      rtIsUsed(RT_AUTODISPLAY_CHECK) = 1
    END IF
  END IF

  ff = resolveSymbol("@SKIP_RUNTIME")
  IF ff = FAILURE THEN EXIT SUB
  skipRuntimeLblIdx = returnedData2
  tira_Start
  tiraJmpId skipRuntimeLblIdx
  tira_EndAndProcess

  ' Arm the runtime phase and verify the wrapper is defaulted to OFF
  isCompilingRT = 1
  rtWrapperActive = 0

  ' To guarantee absolute isolation between runtime helper labels and user-code labels
  ' across multiple compilation passes, the internal TIRA counter is shifted to a massive,
  ' non-colliding offset during runtime emission. The original sequence is preserved
  ' and restored to ensure user-code parsing remains perfectly synchronized with the global memory map
  DIM cachedCounter AS LONG
  cachedCounter = t.TiraVarCounter
  t.TiraVarCounter = TIRA_RUNTIME_ID_BASE

  IF rtIsUsed(RT_STR_ASSIGN) = 1 THEN
    emitRuntimeStrAssign
  END IF
  IF rtIsUsed(RT_PLOT_PIXEL) = 1 THEN
    emitRuntimePlotPixel
  END IF
  IF rtIsUsed(RT_LINE) = 1 THEN
    emitRuntimeLine
  END IF
  IF rtIsUsed(RT_CIRCLE) = 1 THEN
    emitRuntimeCircle
  END IF
  IF rtIsUsed(RT_VEH_HANDLER) = 1 THEN
    emitRuntimeVehHandler
  END IF
  IF rtIsUsed(RT_KEYDOWN) = 1 THEN
    emitRuntimeKeyDown
  END IF
  IF rtIsUsed(RT_KEY_EVENT) = 1 THEN
    emitRuntimeKeyEvent
  END IF

  ' Embed the additional I/O runtime helpers
  IF rtIsUsed(RT_PRINT_INT) = 1 THEN
    emitRuntimePrintInt
  END IF
  IF rtIsUsed(RT_PRINT_FLOAT) = 1 THEN
    emitRuntimePrintFloat
  END IF
  IF rtIsUsed(RT_PRINT_STR) = 1 THEN
    emitRuntimePrintStr
  END IF
  IF rtIsUsed(RT_PRINT_USING) = 1 THEN
    emitRuntimePrintUsing
  END IF
  IF rtIsUsed(RT_CRLF) = 1 THEN
    emitRuntimeCrlf
  END IF
  IF rtIsUsed(RT_INPUT) = 1 THEN
    emitRuntimeInput
  END IF
  IF rtIsUsed(RT_STR_CMP) = 1 THEN
    emitRuntimeStrCmp
  END IF
  IF rtIsUsed(RT_READ) = 1 THEN
    emitRuntimeRead
  END IF

  IF cm.HasGraphics = 1 THEN
    IF rtIsUsed(RT_GFX_APPEND) = 1 THEN
      emitRuntimeGfxAppend
    END IF
    IF rtIsUsed(RT_DRAW_TEXT_ABSOLUTE) = 1 THEN
      emitRuntimeDrawTextAbsolute
    END IF
    IF rtIsUsed(RT_GET) = 1 THEN
      emitRuntimeGfxGet
    END IF
    IF rtIsUsed(RT_PUT) = 1 THEN
      emitRuntimeGfxPut
    END IF
    IF rtIsUsed(RT_PUTIMAGE) = 1 THEN
      emitRuntimeGfxCopyPage
    END IF
    IF rtIsUsed(RT_SWAP_BUFFERS) = 1 THEN
      emitRuntimeSwapBuffers
    END IF
    IF rtIsUsed(RT_FULLSCREEN) = 1 THEN
      emitRuntimeFullscreen
    END IF
    IF rtIsUsed(RT_AUTODISPLAY_CHECK) = 1 THEN
      emitRuntimeAutodisplayCheck
    END IF
    IF rtIsUsed(RT_MOUSEINPUT) = 1 THEN
      emitRuntimeMouseInput
    END IF
    IF rtIsUsed(RT_PAINT) = 1 THEN
      emitRuntimePaint
    END IF
    IF rtIsUsed(RT_DRAW) = 1 THEN
      emitRuntimeDraw
    END IF
    IF rtIsUsed(RT_PCOPY) = 1 THEN
      emitRuntimePcopy
    END IF
    IF rtIsUsed(RT_GDOUBLE) = 1 THEN
      emitRuntimeGDouble
    END IF
    IF rtIsUsed(RT_OUT) = 1 THEN
      emitRuntimeOut
    END IF
    IF rtIsUsed(RT_INP) = 1 THEN
      emitRuntimeInp
    END IF
  END IF

  IF rtIsUsed(RT_BLOAD) = 1 THEN
    emitRuntimeBload
  END IF
  IF rtIsUsed(RT_BSAVE) = 1 THEN
    emitRuntimeBsave
  END IF

  IF rtIsUsed(RT_SET_CLIPBOARD) = 1 THEN
    emitRuntimeClipboardSet
  END IF
  IF rtIsUsed(RT_GET_CLIPBOARD) = 1 THEN
    emitRuntimeClipboardGet
  END IF
  IF rtIsUsed(RT_DEVICES) = 1 THEN
    emitRuntimeDevices
  END IF
  IF rtIsUsed(RT_DEVICE) = 1 THEN
    emitRuntimeDevice
  END IF
  IF rtIsUsed(RT_CLEAR) = 1 THEN
    emitRuntimeClearVars
  END IF
  IF rtIsUsed(RT_LIMIT) = 1 THEN
    emitRuntimeLimit
  END IF
  IF rtIsUsed(RT_DEVICEINPUT) = 1 THEN
    emitRuntimeDeviceInput
  END IF
  IF rtIsUsed(RT_AXIS) = 1 THEN
    emitRuntimeAxis
  END IF
  IF rtIsUsed(RT_WHEEL) = 1 THEN
    emitRuntimeWheel
  END IF
  IF rtIsUsed(RT_BUTTON) = 1 THEN
    emitRuntimeButton
  END IF

  t.TiraVarCounter = cachedCounter

  ' Deactivate the runtime phase to allow normal execution loops to resume
  isCompilingRT = 0

  tira_Start
  tiraLabelId skipRuntimeLblIdx
  tira_EndAndProcess

END SUB ' emitRuntimeAll

''''''''''''''''''''''''
SUB emitRuntimeAutodisplayCheck

  DIM curTickIdx AS LONG
  DIM displayPendingIdx AS LONG
  DIM displayTimerIdx AS LONG
  DIM pagingIdx AS LONG
  DIM destPageIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM skipDisplayILblIdx AS LONG
  DIM pagingDisplayLblIdx AS LONG
  DIM displayDoneLblIdx AS LONG
  DIM pendingBitsIdx AS LONG
  DIM diffTickIdx AS LONG
  DIM claimDisplayLblIdx AS LONG
  DIM observedBitsIdx AS LONG
  DIM clearedBitsIdx AS LONG
  DIM compareBitsIdx AS LONG

  rtOffset(RT_AUTODISPLAY_CHECK) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
  displayPendingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DISPLAYI_TIMER")
  displayTimerIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  pagingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  destPageIdx = returnedData2

  ff = resolveSymbol("IAT_GETTICKCOUNT")
  getTickCountIdx = returnedData2

  ff = resolveSymbol("RT_SWAP_BUFFERS")
  swapBuffersIdx = returnedData2

  skipDisplayILblIdx = tiraLabelCreateNewId&("SKIP_DISPLAYI")
  pagingDisplayLblIdx = tiraLabelCreateNewId&("PAGING_DISPLAY")
  displayDoneLblIdx = tiraLabelCreateNewId&("DISPLAY_DONE")

  ' Bit zero records whether the destination framebuffer has pixels waiting to be presented
  pendingBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipDisplayILblIdx

  ' Get Tick Count from Windows
  tiraCallId0 getTickCountIdx
  curTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId curTickIdx

  ' Calculate time elapsed since last refresh
  diffTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_SYMBOL, curTickIdx, TIRA_ARG_SYMBOL, displayTimerIdx

  ' If less than 16 milliseconds have passed, skip the redraw to enforce 60 FPS maximum
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_LITERAL, 16, skipDisplayILblIdx

  ' Clear the dirty bit while preserving the full-circle warmup state
  claimDisplayLblIdx = tiraLabelCreateNewId&("CLAIM_DISPLAY")
  tiraLabelId claimDisplayLblIdx

  observedBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId observedBitsIdx, TIRA_ARG_SYMBOL, displayPendingIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipDisplayILblIdx

  clearedBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, clearedBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, TIRA_ARG_LITERAL, -2

  compareBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId compareBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx
  tiraCmpxchgId TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_SYMBOL, compareBitsIdx, TIRA_ARG_SYMBOL, clearedBitsIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, compareBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, claimDisplayLblIdx

  ' Explicit SCREEN paging owns presentation until paging is reset
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, pagingDisplayLblIdx

  ' Trigger the buffer swap to push the backbuffer to the monitor
  tiraCallId0 swapBuffersIdx
  tiraJmpId displayDoneLblIdx

  tiraLabelId pagingDisplayLblIdx

  ' Refresh only when the destination is the selected visual page
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, destPageIdx

  tiraLabelId displayDoneLblIdx

  tiraAssignId displayTimerIdx, TIRA_ARG_SYMBOL, curTickIdx

  tiraLabelId skipDisplayILblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeAutodisplayCheck

''''''''''''''''''''''''
SUB emitRuntimeCircle

  DIM argCxIdx AS LONG
  DIM argCyIdx AS LONG
  DIM argRIdx AS LONG
  DIM argCIdx AS LONG
  DIM argStartIdx AS LONG
  DIM argEndIdx AS LONG
  DIM argHasArcIdx AS LONG
  DIM argAspectIdx AS LONG
  DIM argHasAspectIdx AS LONG
  DIM circleAspectIdx AS LONG
  DIM oneDoubleIdx AS LONG
  DIM zeroDoubleIdx AS LONG
  DIM aspectModeLiteralIdx AS LONG
  DIM tauDoubleIdx AS LONG
  DIM halfDoubleIdx AS LONG
  DIM explicitAspectIdx AS LONG
  DIM xScaleIdx AS LONG
  DIM yScaleIdx AS LONG
  DIM radiusDoubleIdx AS LONG
  DIM arcStartIdx AS LONG
  DIM arcEndIdx AS LONG
  DIM arcStepIdx AS LONG
  DIM arcAngleIdx AS LONG
  DIM cosValueIdx AS LONG
  DIM xOffsetDoubleIdx AS LONG
  DIM xOffsetIdx AS LONG
  DIM arcXIdx AS LONG
  DIM sinValueIdx AS LONG
  DIM yOffsetDoubleIdx AS LONG
  DIM yOffsetIdx AS LONG
  DIM arcYIdx AS LONG
  DIM xIdx AS LONG
  DIM yIdx AS LONG
  DIM errValIdx AS LONG
  DIM scaledXFromXDoubleIdx AS LONG
  DIM scaledXFromXIdx AS LONG
  DIM scaledXFromYDoubleIdx AS LONG
  DIM scaledXFromYIdx AS LONG
  DIM scaledYFromXDoubleIdx AS LONG
  DIM scaledYFromXIdx AS LONG
  DIM scaledYFromYDoubleIdx AS LONG
  DIM scaledYFromYIdx AS LONG
  DIM tmpXIdx AS LONG
  DIM tmpYIdx AS LONG
  DIM tmpErrIdx AS LONG
  DIM tmpErr1Idx AS LONG
  DIM plotPixelIdx AS LONG
  DIM cosFuncIdx AS LONG
  DIM sinFuncIdx AS LONG
  DIM aspectReadyLblIdx AS LONG
  DIM aspectPositiveLblIdx AS LONG
  DIM aspectBelowOneLblIdx AS LONG
  DIM aspectScaleDoneLblIdx AS LONG
  DIM fullCircleLblIdx AS LONG
  DIM circleDoneLblIdx AS LONG
  DIM arcRadiusReadyLblIdx AS LONG
  DIM arcRadiusZeroLblIdx AS LONG
  DIM arcRangeReadyLblIdx AS LONG
  DIM arcLoopTopIdx AS LONG
  DIM arcUseEndLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM lblErrPosIdx AS LONG

  rtOffset(RT_CIRCLE) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  argCxIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId argCxIdx, 1

  argCyIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId argCyIdx, 2

  argRIdx = tiraDimVarId&("ARG3", TYPE_LONG)
  tiraAbiReadArgId argRIdx, 3

  argCIdx = tiraDimVarId&("ARG4", TYPE_LONG)
  tiraAbiReadArgId argCIdx, 4

  argStartIdx = tiraDimVarId&("ARG5", TYPE_DOUBLE)
  tiraAbiReadArgId argStartIdx, 5

  argEndIdx = tiraDimVarId&("ARG6", TYPE_DOUBLE)
  tiraAbiReadArgId argEndIdx, 6

  argHasArcIdx = tiraDimVarId&("ARG7", TYPE_LONG)
  tiraAbiReadArgId argHasArcIdx, 7

  argAspectIdx = tiraDimVarId&("ARG8", TYPE_DOUBLE)
  tiraAbiReadArgId argAspectIdx, 8

  argHasAspectIdx = tiraDimVarId&("ARG9", TYPE_LONG)
  tiraAbiReadArgId argHasAspectIdx, 9

  ff = resolveSymbol("RT_PLOT_PIXEL")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  plotPixelIdx = returnedData2

  ff = resolveSymbol("IAT_COS")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  cosFuncIdx = returnedData2

  ff = resolveSymbol("IAT_SIN")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  sinFuncIdx = returnedData2

  ' Establish the default aspect required by the classic screen mode
  circleAspectIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  oneDoubleIdx = tiraDoubleLiteralId&(1#)
  IF oneDoubleIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  tiraAssignId circleAspectIdx, TIRA_ARG_SYMBOL, oneDoubleIdx

  SELECT CASE compileScreenMode

    CASE 1, 7, 13
      aspectModeLiteralIdx = tiraDoubleLiteralId&(0.8333333333333333#)
      IF aspectModeLiteralIdx = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      tiraAssignId circleAspectIdx, TIRA_ARG_SYMBOL, aspectModeLiteralIdx

    CASE 2, 8
      aspectModeLiteralIdx = tiraDoubleLiteralId&(0.4166666666666667#)
      IF aspectModeLiteralIdx = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      tiraAssignId circleAspectIdx, TIRA_ARG_SYMBOL, aspectModeLiteralIdx

    CASE 9, 10
      aspectModeLiteralIdx = tiraDoubleLiteralId&(0.7291666666666667#)
      IF aspectModeLiteralIdx = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      tiraAssignId circleAspectIdx, TIRA_ARG_SYMBOL, aspectModeLiteralIdx

  END SELECT ' compileScreenMode

  ' An explicit aspect replaces the screen-mode default
  aspectReadyLblIdx = tiraLabelCreateNewId&("CIRC_ASPECT_READY")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argHasAspectIdx, TIRA_ARG_LITERAL, 0, aspectReadyLblIdx

  explicitAspectIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId explicitAspectIdx, TIRA_ARG_SYMBOL, argAspectIdx

  zeroDoubleIdx = tiraDoubleLiteralId&(0#)
  IF zeroDoubleIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF

  aspectPositiveLblIdx = tiraLabelCreateNewId&("CIRC_ASPECT_POS")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, explicitAspectIdx, TIRA_ARG_SYMBOL, zeroDoubleIdx, aspectPositiveLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, explicitAspectIdx, TIRA_ARG_SYMBOL, explicitAspectIdx
  tiraLabelId aspectPositiveLblIdx

  ' Zero retains the usable screen-mode default
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, explicitAspectIdx, TIRA_ARG_SYMBOL, zeroDoubleIdx, aspectReadyLblIdx
  tiraAssignId circleAspectIdx, TIRA_ARG_SYMBOL, explicitAspectIdx

  tiraLabelId aspectReadyLblIdx

  ' Convert the aspect ratio into independent axis scales
  xScaleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  yScaleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId xScaleIdx, TIRA_ARG_SYMBOL, oneDoubleIdx
  tiraAssignId yScaleIdx, TIRA_ARG_SYMBOL, oneDoubleIdx

  aspectBelowOneLblIdx = tiraLabelCreateNewId&("CIRC_ASPECT_LOW")
  aspectScaleDoneLblIdx = tiraLabelCreateNewId&("CIRC_ASPECT_DONE")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, circleAspectIdx, TIRA_ARG_SYMBOL, oneDoubleIdx, aspectBelowOneLblIdx

  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, xScaleIdx, TIRA_ARG_SYMBOL, oneDoubleIdx, TIRA_ARG_SYMBOL, circleAspectIdx
  tiraJmpId aspectScaleDoneLblIdx

  tiraLabelId aspectBelowOneLblIdx
  tiraAssignId yScaleIdx, TIRA_ARG_SYMBOL, circleAspectIdx

  tiraLabelId aspectScaleDoneLblIdx

  fullCircleLblIdx = tiraLabelCreateNewId&("CIRC_FULL")
  circleDoneLblIdx = tiraLabelCreateNewId&("CIRC_ALL_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argHasArcIdx, TIRA_ARG_LITERAL, 0, fullCircleLblIdx

  arcRadiusReadyLblIdx = tiraLabelCreateNewId&("CIRC_ARC_RADIUS")
  arcRadiusZeroLblIdx = tiraLabelCreateNewId&("CIRC_ARC_ZERO")

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argRIdx, TIRA_ARG_LITERAL, 0, arcRadiusReadyLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argRIdx, TIRA_ARG_LITERAL, 0, arcRadiusZeroLblIdx
  tiraJmpId circleDoneLblIdx

  tiraLabelId arcRadiusZeroLblIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, argCIdx
  tiraJmpId circleDoneLblIdx

  tiraLabelId arcRadiusReadyLblIdx

  radiusDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, radiusDoubleIdx, TIRA_ARG_SYMBOL, argRIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE

  arcStartIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId arcStartIdx, TIRA_ARG_SYMBOL, argStartIdx

  arcEndIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId arcEndIdx, TIRA_ARG_SYMBOL, argEndIdx

  tauDoubleIdx = tiraDoubleLiteralId&(6.283185307179586#)
  IF tauDoubleIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF

  arcRangeReadyLblIdx = tiraLabelCreateNewId&("CIRC_ARC_RANGE")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, arcEndIdx, TIRA_ARG_SYMBOL, arcStartIdx, arcRangeReadyLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, arcEndIdx, TIRA_ARG_SYMBOL, arcEndIdx, TIRA_ARG_SYMBOL, tauDoubleIdx
  tiraLabelId arcRangeReadyLblIdx

  halfDoubleIdx = tiraDoubleLiteralId&(0.5#)
  IF halfDoubleIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF

  arcStepIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, arcStepIdx, TIRA_ARG_SYMBOL, halfDoubleIdx, TIRA_ARG_SYMBOL, radiusDoubleIdx

  arcAngleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId arcAngleIdx, TIRA_ARG_SYMBOL, arcStartIdx

  arcLoopTopIdx = tiraLabelCreateNewId&("CIRC_ARC_LOOP")
  arcUseEndLblIdx = tiraLabelCreateNewId&("CIRC_ARC_USE_END")

  tiraLabelId arcLoopTopIdx

  tiraCallId1 cosFuncIdx, TIRA_ARG_SYMBOL, arcAngleIdx

  cosValueIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraGetRetId cosValueIdx

  xOffsetDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, xOffsetDoubleIdx, TIRA_ARG_SYMBOL, cosValueIdx, TIRA_ARG_SYMBOL, radiusDoubleIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, xOffsetDoubleIdx, TIRA_ARG_SYMBOL, xOffsetDoubleIdx, TIRA_ARG_SYMBOL, xScaleIdx

  xOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, xOffsetIdx, TIRA_ARG_SYMBOL, xOffsetDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  arcXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, arcXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, xOffsetIdx

  tiraCallId1 sinFuncIdx, TIRA_ARG_SYMBOL, arcAngleIdx

  sinValueIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraGetRetId sinValueIdx

  yOffsetDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, yOffsetDoubleIdx, TIRA_ARG_SYMBOL, sinValueIdx, TIRA_ARG_SYMBOL, radiusDoubleIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, yOffsetDoubleIdx, TIRA_ARG_SYMBOL, yOffsetDoubleIdx, TIRA_ARG_SYMBOL, yScaleIdx

  yOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, yOffsetIdx, TIRA_ARG_SYMBOL, yOffsetDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  arcYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, arcYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, yOffsetIdx

  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, arcXIdx, TIRA_ARG_SYMBOL, arcYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, arcAngleIdx, TIRA_ARG_SYMBOL, arcEndIdx, circleDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, arcAngleIdx, TIRA_ARG_SYMBOL, arcAngleIdx, TIRA_ARG_SYMBOL, arcStepIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, arcAngleIdx, TIRA_ARG_SYMBOL, arcEndIdx, arcUseEndLblIdx
  tiraJmpId arcLoopTopIdx

  tiraLabelId arcUseEndLblIdx
  tiraAssignId arcAngleIdx, TIRA_ARG_SYMBOL, arcEndIdx
  tiraJmpId arcLoopTopIdx

  tiraLabelId fullCircleLblIdx

  xIdx = tiraDimVarId&("T", TYPE_LONG)
  yIdx = tiraDimVarId&("T", TYPE_LONG)
  errValIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraAssignId xIdx, TIRA_ARG_SYMBOL, argRIdx
  tiraAssignId yIdx, TIRA_ARG_LITERAL, 0
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, xIdx

  loopTopIdx = tiraLabelCreateNewId&("CIRC_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("CIRC_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, xIdx, TIRA_ARG_SYMBOL, yIdx, loopDoneIdx

  ' Scale the two horizontal octant distances
  scaledXFromXDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledXFromXDoubleIdx, TIRA_ARG_SYMBOL, xIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledXFromXDoubleIdx, TIRA_ARG_SYMBOL, scaledXFromXDoubleIdx, TIRA_ARG_SYMBOL, xScaleIdx

  scaledXFromXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledXFromXIdx, TIRA_ARG_SYMBOL, scaledXFromXDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  scaledXFromYDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledXFromYDoubleIdx, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledXFromYDoubleIdx, TIRA_ARG_SYMBOL, scaledXFromYDoubleIdx, TIRA_ARG_SYMBOL, xScaleIdx

  scaledXFromYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledXFromYIdx, TIRA_ARG_SYMBOL, scaledXFromYDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  ' Scale the two vertical octant distances
  scaledYFromXDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledYFromXDoubleIdx, TIRA_ARG_SYMBOL, xIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledYFromXDoubleIdx, TIRA_ARG_SYMBOL, scaledYFromXDoubleIdx, TIRA_ARG_SYMBOL, yScaleIdx

  scaledYFromXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledYFromXIdx, TIRA_ARG_SYMBOL, scaledYFromXDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  scaledYFromYDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledYFromYDoubleIdx, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_LITERAL, TYPE_DOUBLE
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledYFromYDoubleIdx, TIRA_ARG_SYMBOL, scaledYFromYDoubleIdx, TIRA_ARG_SYMBOL, yScaleIdx

  scaledYFromYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, scaledYFromYIdx, TIRA_ARG_SYMBOL, scaledYFromYDoubleIdx, TIRA_ARG_LITERAL, TYPE_LONG

  tmpXIdx = tiraDimVarId&("T", TYPE_LONG)
  tmpYIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromYIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromYIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromXIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromYIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromXIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromYIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromXIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromYIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromYIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromXIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromYIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromXIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, argCxIdx, TIRA_ARG_SYMBOL, scaledXFromXIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCyIdx, TIRA_ARG_SYMBOL, scaledYFromYIdx
  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, argCIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_LITERAL, 1

  lblErrPosIdx = tiraLabelCreateNewId&("CIRC_ERR_POS")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_LITERAL, 0, lblErrPosIdx

  tmpErrIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, tmpErrIdx, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_LITERAL, 2
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpErrIdx, TIRA_ARG_SYMBOL, tmpErrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_SYMBOL, tmpErrIdx
  tiraJmpId loopTopIdx

  tiraLabelId lblErrPosIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, xIdx, TIRA_ARG_SYMBOL, xIdx, TIRA_ARG_LITERAL, 1

  tmpErr1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tmpErr1Idx, TIRA_ARG_SYMBOL, yIdx, TIRA_ARG_SYMBOL, xIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpErr1Idx, TIRA_ARG_SYMBOL, tmpErr1Idx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, tmpErr1Idx, TIRA_ARG_SYMBOL, tmpErr1Idx, TIRA_ARG_LITERAL, 2
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_SYMBOL, errValIdx, TIRA_ARG_SYMBOL, tmpErr1Idx
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx
  tiraLabelId circleDoneLblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeCircle

''''''''''''''''''''''''
SUB emitRuntimeClearVars

  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM uIdx AS LONG
  DIM iField AS LONG
  DIM elemSize AS LONG
  DIM totalElems AS LONG
  DIM dataOffset AS LONG
  DIM dataSize AS LONG
  DIM fOffset AS LONG
  DIM baseArrIdx AS LONG
  DIM baseArrGlobalIdx AS LONG
  DIM iterVarIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopEndIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipCloseIdx AS LONG
  DIM arrAddrIdx AS LONG
  DIM dataAddrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM flagValIdx AS LONG
  DIM flagPtrIdx AS LONG
  DIM skipFreeDescLblIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM skipReinitLblIdx AS LONG
  DIM jmpStrDoneIdx AS LONG
  DIM strLenIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM emptyDescPtrIdx AS LONG
  DIM skipDescFreeIdx AS LONG
  DIM closeHandleIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM emptyDescGlobalIdx AS LONG

  rtOffset(RT_CLEAR) = stream.emitPos

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN EXIT SUB
  baseArrGlobalIdx = returnedData2

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  IF ff = 0 THEN EXIT SUB
  closeHandleIdx = returnedData2

  ff = resolveSymbol("IAT_HEAPFREE")
  IF ff = 0 THEN EXIT SUB
  heapFreeIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN EXIT SUB
  processHeapIdx = returnedData2

  ff = resolveSymbol("!G_SYS_DSC_EMPTY")
  IF ff = 0 THEN EXIT SUB
  emptyDescGlobalIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  ' 1. Close all opened files
  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, baseArrGlobalIdx

  iterVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iterVarIdx, TIRA_ARG_LITERAL, 1

  loopTopIdx = tiraLabelCreateNewId&("CLEAR_CLOSE_LOOP")
  loopEndIdx = tiraLabelCreateNewId&("CLEAR_CLOSE_END")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 255, loopEndIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 8

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

  skipCloseIdx = tiraLabelCreateNewId&("CLEAR_SKIP_CLOSE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipCloseIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipCloseIdx

  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

  tiraLabelId skipCloseIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopEndIdx

  ' 2. Clear all global variables and arrays
  IF symbolCount > 0 THEN
    FOR vIdx = 0 TO symbolCount - 1
      dt = symbols(vIdx).DataType

      ' Skip internal compiler variables, labels, and subroutines
      IF symbols(vIdx).IsInternal = 0 AND symbols(vIdx).IsLabelName = 0 AND dt <> TYPE_LABEL AND dt <> TYPE_UNDEFINED AND symbols(vIdx).SubIndex = 0 THEN
        ' Exclude operating system IAT pointers and internal runtime helpers
        IF symbols(vIdx).IsRuntimeOrIatName = 0 THEN
          ' ONLY clear globals!
          IF symbols(vIdx).ScopeID = 0 THEN

            IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
              ' Free dynamic string elements and dynamic array blocks
              tiraScheduleArrayFreeId vIdx

              IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
                ' Zero out static array memory securely mapping the physical bounds
                elemSize = retElementByteSize(vIdx)
                totalElems = symbols(vIdx).Size
                dataOffset = 16 + (symbols(vIdx).NumDimensions * 8)
                dataSize = elemSize * totalElems

                arrAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, arrAddrIdx, TIRA_ARG_SYMBOL, vIdx

                dataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_SYMBOL, arrAddrIdx, TIRA_ARG_LITERAL, dataOffset

                tiraMemSetId TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, dataSize
              ELSE
                ' For dynamic arrays, clear the array pointer descriptor so it is removed
                arrAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, arrAddrIdx, TIRA_ARG_SYMBOL, vIdx
                tiraWriteMemId TIRA_ARG_SYMBOL, arrAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8
              END IF

            ELSE
              ' Scalar Variables
              IF dt = TYPE_STRING THEN
                descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, vIdx

                flagValIdx = tiraDimVarId&("T", TYPE_LONG)
                flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 16
                tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

                skipFreeDescLblIdx = tiraLabelCreateNewId&("CLR_SKIP_FREE")
                tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeDescLblIdx

                dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraReadMemId dataPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx
                tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx

                tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, dataPtrIdx

                tiraLabelId skipFreeDescLblIdx

                ' Re-initialize the descriptor
                skipReinitLblIdx = tiraLabelCreateNewId&("CLR_SKIP_REINIT")
                tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipReinitLblIdx

                tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

                jmpStrDoneIdx = tiraLabelCreateNewId&("CLR_STR_DONE")
                tiraJmpId jmpStrDoneIdx

                tiraLabelId skipReinitLblIdx
                ' It is a fixed string. Memset its data to space (32)
                dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
                strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)
                tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, strLenIdx

                tiraLabelId jmpStrDoneIdx

              ELSE
                IF dt = TYPE_UDT THEN
                  uIdx = symbols(vIdx).UDTIndex
                  IF uIdx <> -1 THEN
                    ' Must free dynamic strings within the scalar UDT
                    FOR iField = 0 TO udts(uIdx).FieldCount - 1
                      IF udtFields(uIdx, iField).DataType = TYPE_STRING AND udtFields(uIdx, iField).IsDynamicString = 1 THEN
                        fOffset = udtFields(uIdx, iField).Offset
                        basePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, vIdx

                        descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        IF fOffset > 0 THEN
                          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, fOffset
                        ELSE
                          tiraAssignId descAddrIdx, TIRA_ARG_SYMBOL, basePtrIdx
                        END IF

                        descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, descAddrIdx

                        skipFreeDescLblIdx = tiraLabelCreateNewId&("CLR_SKIP_UDT_FREE")
                        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx

                        flagValIdx = tiraDimVarId&("T", TYPE_LONG)
                        flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 16
                        tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

                        tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeDescLblIdx

                        dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraReadMemId dataPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx

                        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx
                        tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, dataPtrIdx

                        tiraLabelId skipFreeDescLblIdx

                        emptyDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraAssignId emptyDescPtrIdx, TIRA_ARG_SYMBOL, emptyDescGlobalIdx
                        skipDescFreeIdx = tiraLabelCreateNewId&("CLR_SKIP_STR_FREE")
                        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipDescFreeIdx
                        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, emptyDescPtrIdx, skipDescFreeIdx
                        tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, descPtrIdx
                        tiraLabelId skipDescFreeIdx
                      END IF
                    NEXT

                    ' Zero the UDT memory block
                    basePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, vIdx
                    tiraMemSetId TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, udts(uIdx).TotalSize
                  END IF

                ELSE
                  ' Numeric scalar variable
                  tiraAssignId vIdx, TIRA_ARG_LITERAL, 0
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeClearVars

''''''''''''''''''''''''
SUB emitRuntimeCrlf

  DIM textRowHeight AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM fallbackLblIdx AS LONG
  DIM manualLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBotIdx AS LONG
  DIM csbiIdx AS LONG
  DIM getConsoleScreenBufferInfoIdx AS LONG
  DIM coordVarIdx AS LONG
  DIM curYIdx AS LONG
  DIM botMinusOneIdx AS LONG
  DIM doScrollLblIdx AS LONG
  DIM destCoord1Idx AS LONG
  DIM setConsoleCursorPositionIdx AS LONG
  DIM scrollRectIdx AS LONG
  DIM topPlusOneIdx AS LONG
  DIM widthVarIdx AS LONG
  DIM destCoord2Idx AS LONG
  DIM charInfoIdx AS LONG
  DIM attrVarIdx AS LONG
  DIM scrollConsoleScreenBufferIdx AS LONG
  DIM destCoord3Idx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM widthFillIdx AS LONG
  DIM fillConsoleOutputCharacterIdx AS LONG
  DIM fillConsoleOutputAttributeIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM crlfDescIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtFBIdx AS LONG
  DIM numWrtFBPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM botYIdx AS LONG
  DIM topYIdx AS LONG
  DIM scrollLoopLblIdx AS LONG
  DIM noScreenScrollLblIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM viewStartOffsetIdx AS LONG
  DIM destFbIdx AS LONG
  DIM fbRowBytesIdx AS LONG
  DIM srcFbIdx AS LONG
  DIM fbShiftRowsIdx AS LONG
  DIM fbShiftCountIdx AS LONG
  DIM botRowPtrIdx AS LONG
  DIM lastBgIdx AS LONG

  rtOffset(RT_CRLF) = stream.emitPos

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  tira_Start
  tiraRT_PrologueId

  IF cm.HasGraphics = 0 THEN
    ' Console mode logic utilizing the rigorous scrolling APIs for VIEW PRINT

    ' Call Windows API to get the standard output handle
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    fallbackLblIdx = tiraLabelCreateNewId&("CRLF_FALL")
    manualLblIdx = tiraLabelCreateNewId&("CRLF_MAN")
    jmpDoneLblIdx = tiraLabelCreateNewId&("CRLF_DONE")

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    viewTopIdx = returnedData2
    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    viewBotIdx = returnedData2

    ' Fast bypass check for full screen bounds (no manual scroll computation required)
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 0, manualLblIdx
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_LITERAL, 25, manualLblIdx
    tiraJmpId fallbackLblIdx

    tiraLabelId manualLblIdx

    ' Extract the hardware console cursor row
    csbiIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
    ff = resolveSymbol("IAT_GETCONSOLESCREENBUFFERINFO")
    getConsoleScreenBufferInfoIdx = returnedData2
    tiraCallId2 getConsoleScreenBufferInfoIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, csbiIdx
    coordVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId coordVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 4
    curYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 16

    botMinusOneIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_LITERAL, 1

    doScrollLblIdx = tiraLabelCreateNewId&("CRLF_DOSCROLL")

    ' Check if we hit the limit of the specific viewport
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, botMinusOneIdx, doScrollLblIdx

    ' No scroll, advance cursor down cleanly
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 1
    destCoord1Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord1Idx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 16
    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    setConsoleCursorPositionIdx = returnedData2
    tiraCallId2 setConsoleCursorPositionIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, destCoord1Idx
    tiraJmpId jmpDoneLblIdx

    tiraLabelId doScrollLblIdx

    ' Execute localized block scroll
    scrollRectIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 8)
    tiraWriteMemId TIRA_ARG_SYMBOL, scrollRectIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 2
    topPlusOneIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, topPlusOneIdx, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 2, TIRA_ARG_SYMBOL, topPlusOneIdx, TIRA_ARG_LITERAL, 2

    widthVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId widthVarIdx, TIRA_ARG_SYMBOL, csbiIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 65535
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 4, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 2
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 6, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_LITERAL, 2

    destCoord2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord2Idx, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 16

    charInfoIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)
    tiraWriteMemId TIRA_ARG_SYMBOL, charInfoIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 2
    attrVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId attrVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 8
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, charInfoIdx, 2, TIRA_ARG_SYMBOL, attrVarIdx, TIRA_ARG_LITERAL, 2

    ff = resolveSymbol("IAT_SCROLLCONSOLESCREENBUFFERA")
    scrollConsoleScreenBufferIdx = returnedData2
    tiraCallId5 scrollConsoleScreenBufferIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, scrollRectIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, destCoord2Idx, TIRA_ARG_SYMBOL, charInfoIdx

    ' Zero out the bottom row block completely empty
    destCoord3Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_LITERAL, 16
    numWrtPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)

    widthFillIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("IAT_FILLCONSOLEOUTPUTCHARACTERA")
    fillConsoleOutputCharacterIdx = returnedData2
    tiraCallId5 fillConsoleOutputCharacterIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, numWrtPtrIdx

    ff = resolveSymbol("IAT_FILLCONSOLEOUTPUTATTRIBUTE")
    fillConsoleOutputAttributeIdx = returnedData2
    tiraCallId5 fillConsoleOutputAttributeIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, attrVarIdx, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, numWrtPtrIdx

    tiraCallId2 setConsoleCursorPositionIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, destCoord3Idx
    tiraJmpId jmpDoneLblIdx

    tiraLabelId fallbackLblIdx
    ' Unrestricted hardware newline execution
    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_INO_DSC_CRLF")
    crlfDescIdx = returnedData2
    tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, crlfDescIdx
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)
    numWrtFBIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtFBPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtFBPtrIdx, TIRA_ARG_SYMBOL, numWrtFBIdx
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtFBPtrIdx, TIRA_ARG_LITERAL, 0

    tiraLabelId jmpDoneLblIdx
  ELSE
    ' Graphics mode newline logic
    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    fontHeightGlobalIdx = returnedData2
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("CRLF_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    textXIdx = returnedData2
    tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    textYIdx = returnedData2
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    viewBotIdx = returnedData2
    botYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId botYIdx, TIRA_ARG_SYMBOL, viewBotIdx

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    viewTopIdx = returnedData2
    topYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId topYIdx, TIRA_ARG_SYMBOL, viewTopIdx

    scrollLoopLblIdx = tiraLabelCreateNewId&("CRLF_GFX_SCROLL")
    noScreenScrollLblIdx = tiraLabelCreateNewId&("CRLF_GFX_NOSCROLL")

    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, noScreenScrollLblIdx

    tiraLabelId scrollLoopLblIdx

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    destFrameIdx = returnedData2
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, destFrameIdx

    viewStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, topYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    destFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx

    fbRowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbRowBytesIdx, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    srcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

    fbShiftRowsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, botYIdx, TIRA_ARG_SYMBOL, topYIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

    fbShiftCountIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbShiftCountIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    tiraMemcpyId TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx

    botRowPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    lastBgIdx = returnedData2
    tiraMemSetId TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, lastBgIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, scrollLoopLblIdx

    tiraTriggerAutoDisplayId
    tiraInjectPendingDisplayFlushId

    tiraLabelId noScreenScrollLblIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeCrlf

''''''''''''''''''''''''
SUB emitRuntimeDevice

  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM heapMarkIdx AS LONG
  DIM resultPtrIdx AS LONG
  DIM statePtrIdx AS LONG
  DIM userIdx AS LONG
  DIM deviceCountIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopNextIdx AS LONG
  DIM xinputDoneLblIdx AS LONG
  DIM foundLblIdx AS LONG
  DIM joyLoopTopIdx AS LONG
  DIM joyLoopNextIdx AS LONG
  DIM joyFoundLblIdx AS LONG
  DIM joyCapsFailLblIdx AS LONG
  DIM joyNameLoopLblIdx AS LONG
  DIM joyNameDoneLblIdx AS LONG
  DIM joyButtonDoneLblIdx AS LONG
  DIM joyAxisDoneLblIdx AS LONG
  DIM resultDoneLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM statusValIdx AS LONG
  DIM deviceDescIdx AS LONG
  DIM deviceLiteralIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM capsPtrIdx AS LONG
  DIM capsStatusIdx AS LONG
  DIM namePtrIdx AS LONG
  DIM nameLenIdx AS LONG
  DIM nameBytePtrIdx AS LONG
  DIM nameByteIdx AS LONG
  DIM numButtonsIdx AS LONG
  DIM numAxesIdx AS LONG
  DIM writePtrIdx AS LONG
  DIM prefixDescIdx AS LONG
  DIM prefixLiteralIdx AS LONG
  DIM prefixDataIdx AS LONG
  DIM prefixLenIdx AS LONG
  DIM closeDescIdx AS LONG
  DIM closeLiteralIdx AS LONG
  DIM closeDataIdx AS LONG
  DIM closeLenIdx AS LONG
  DIM buttonDescIdx AS LONG
  DIM buttonLiteralIdx AS LONG
  DIM buttonDataIdx AS LONG
  DIM buttonLenIdx AS LONG
  DIM axisDescIdx AS LONG
  DIM axisLiteralIdx AS LONG
  DIM axisDataIdx AS LONG
  DIM axisLenIdx AS LONG
  DIM resultLenIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM xinputGetStateIdx AS LONG
  DIM joyGetPosExIdx AS LONG
  DIM joyGetDevCapsAIdx AS LONG

  rtOffset(RT_DEVICE) = stream.emitPos

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN EXIT SUB
  tempHeapIdx = returnedData2

  ff = resolveSymbol("IAT_XINPUTGETSTATE")
  IF ff = 0 THEN EXIT SUB
  xinputGetStateIdx = returnedData2

  ff = resolveSymbol("IAT_JOYGETPOSEX")
  IF ff = 0 THEN EXIT SUB
  joyGetPosExIdx = returnedData2

  ff = resolveSymbol("IAT_JOYGETDEVCAPSA")
  IF ff = 0 THEN EXIT SUB
  joyGetDevCapsAIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  ' Build an empty string descriptor to satisfy the safe skeletal framework
  tiraBuildStrDescId TIRA_ARG_SYMBOL, arg2VarIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  heapMarkIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId heapMarkIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  ' Allocate the returned description before temporary controller structures
  resultPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 96)

  statePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 52)
  userIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId userIdx, TIRA_ARG_LITERAL, 0
  deviceCountIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId deviceCountIdx, TIRA_ARG_LITERAL, 0

  loopTopIdx = tiraLabelCreateNewId&("DEVICE_LOOP")
  loopNextIdx = tiraLabelCreateNewId&("DEVICE_NEXT")
  xinputDoneLblIdx = tiraLabelCreateNewId&("DEVICE_XDONE")
  foundLblIdx = tiraLabelCreateNewId&("DEVICE_FOUND")
  joyLoopTopIdx = tiraLabelCreateNewId&("DEVICE_JOY_LOOP")
  joyLoopNextIdx = tiraLabelCreateNewId&("DEVICE_JOY_NEXT")
  joyFoundLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_FOUND")
  joyCapsFailLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_CAPS_FAIL")
  joyNameLoopLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_NAME_LOOP")
  joyNameDoneLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_NAME_DONE")
  joyButtonDoneLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_BUTTON_DONE")
  joyAxisDoneLblIdx = tiraLabelCreateNewId&("DEVICE_JOY_AXIS_DONE")
  resultDoneLblIdx = tiraLabelCreateNewId&("DEVICE_RESULT_DONE")
  doneLblIdx = tiraLabelCreateNewId&("DEVICE_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_LITERAL, 4, xinputDoneLblIdx

  tiraCallId2 xinputGetStateIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_SYMBOL, statePtrIdx
  statusValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId statusValIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, statusValIdx, TIRA_ARG_LITERAL, 0, loopNextIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_SYMBOL, arg1VarIdx, foundLblIdx

  tiraLabelId loopNextIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId xinputDoneLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraAssignId userIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId deviceCountIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId joyLoopTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_LITERAL, 16, doneLblIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, statePtrIdx, 0, TIRA_ARG_LITERAL, 52, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, statePtrIdx, 4, TIRA_ARG_LITERAL, 1279, TIRA_ARG_LITERAL, 4
  tiraCallId2 joyGetPosExIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_SYMBOL, statePtrIdx
  tiraGetRetId statusValIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, statusValIdx, TIRA_ARG_LITERAL, 0, joyLoopNextIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, deviceCountIdx, TIRA_ARG_SYMBOL, arg1VarIdx, joyFoundLblIdx

  tiraLabelId joyLoopNextIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId joyLoopTopIdx

  tiraLabelId foundLblIdx
  deviceDescIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  deviceLiteralIdx = tiraStringLiteralId&("[CONTROLLER][[NAME][XInput Controller]][BUTTON][AXIS]")
  IF deviceLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  tiraAssignId deviceDescIdx, TIRA_ARG_SYMBOL, deviceLiteralIdx
  dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, deviceDescIdx)
  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, deviceDescIdx)
  tiraBuildStrDescId TIRA_ARG_SYMBOL, arg2VarIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId doneLblIdx

  tiraLabelId joyFoundLblIdx

  ' JOYCAPSA occupies 404 bytes and begins with the 32-byte product name at offset 4
  capsPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 404)
  tiraMemSetId TIRA_ARG_SYMBOL, capsPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 404

  tiraCallId3 joyGetDevCapsAIdx, TIRA_ARG_SYMBOL, userIdx, TIRA_ARG_SYMBOL, capsPtrIdx, TIRA_ARG_LITERAL, 404
  capsStatusIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId capsStatusIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, capsStatusIdx, TIRA_ARG_LITERAL, 0, joyCapsFailLblIdx

  namePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, namePtrIdx, TIRA_ARG_SYMBOL, capsPtrIdx, TIRA_ARG_LITERAL, 4

  nameLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId nameLenIdx, TIRA_ARG_LITERAL, 0

  nameBytePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  nameByteIdx = tiraDimVarId&("T", TYPE_UBYTE)

  tiraLabelId joyNameLoopLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, nameLenIdx, TIRA_ARG_LITERAL, 32, joyNameDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nameBytePtrIdx, TIRA_ARG_SYMBOL, namePtrIdx, TIRA_ARG_SYMBOL, nameLenIdx
  tiraReadMemId nameByteIdx, TIRA_ARG_SYMBOL, nameBytePtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, nameByteIdx, TIRA_ARG_LITERAL, 0, joyNameDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nameLenIdx, TIRA_ARG_SYMBOL, nameLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId joyNameLoopLblIdx

  tiraLabelId joyNameDoneLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, nameLenIdx, TIRA_ARG_LITERAL, 0, joyCapsFailLblIdx

  numButtonsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numButtonsIdx, TIRA_ARG_SYMBOL, capsPtrIdx, 60

  numAxesIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numAxesIdx, TIRA_ARG_SYMBOL, capsPtrIdx, 104

  writePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId writePtrIdx, TIRA_ARG_SYMBOL, resultPtrIdx

  prefixDescIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  prefixLiteralIdx = tiraStringLiteralId&("[CONTROLLER][[NAME][")
  IF prefixLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
