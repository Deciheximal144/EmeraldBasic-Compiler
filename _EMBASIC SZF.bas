'' SUB ESCAPETEXT2 (wStr1$, wStr2$) ' This is found within Z_EMLINF.BLB
'
' Logs a two-line error report to an external text file, displays the two lines of strings in
' a banner-wrapped box on the screen, and ends the program

''''''''''''''''''''''''
SUB emitRuntimeDraw

  DIM gfxCurrentXIdx AS LONG
  DIM gfxCurrentYIdx AS LONG
  DIM gfxForegroundIdx AS LONG
  DIM drawInitIdx AS LONG
  DIM drawAngleIdx AS LONG
  DIM drawScaleIdx AS LONG
  DIM lineFuncIdx AS LONG
  DIM cosFuncIdx AS LONG
  DIM sinFuncIdx AS LONG
  DIM paintFuncIdx AS LONG
  DIM degreesToRadiansLiteralIdx AS LONG
  DIM quarterScaleLiteralIdx AS LONG
  DIM argDrawIdx AS LONG
  DIM drawDataIdx AS LONG
  DIM drawSizeIdx AS LONG
  DIM drawIndexIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM drawColorIdx AS LONG
  DIM blindVarIdx AS LONG
  DIM noMoveVarIdx AS LONG
  DIM initDoneLblIdx AS LONG
  DIM drawSineIdx AS LONG
  DIM drawCosineIdx AS LONG
  DIM commandPtrIdx AS LONG
  DIM commandByteIdx AS LONG
  DIM vectorXIdx AS LONG
  DIM vectorYIdx AS LONG
  DIM numberOneIdx AS LONG
  DIM numberTwoIdx AS LONG
  DIM numberFoundIdx AS LONG
  DIM numberInvalidIdx AS LONG
  DIM relativeModeIdx AS LONG
  DIM fillMaskIdx AS LONG
  DIM drawLoopTopIdx AS LONG
  DIM drawDoneLblIdx AS LONG
  DIM drawInvalidLblIdx AS LONG
  DIM commandUpperDoneLblIdx AS LONG
  DIM drawBlindLblIdx AS LONG
  DIM drawNoMoveLblIdx AS LONG
  DIM drawMoveLblIdx AS LONG
  DIM drawUpLblIdx AS LONG
  DIM drawDownLblIdx AS LONG
  DIM drawLeftLblIdx AS LONG
  DIM drawRightLblIdx AS LONG
  DIM drawNELblIdx AS LONG
  DIM drawSELblIdx AS LONG
  DIM drawSWLblIdx AS LONG
  DIM drawNWLblIdx AS LONG
  DIM drawColorLblIdx AS LONG
  DIM drawScaleLblIdx AS LONG
  DIM drawAngleLblIdx AS LONG
  DIM drawTurnLblIdx AS LONG
  DIM drawPaintLblIdx AS LONG
  DIM directionAmountLblIdx AS LONG
  DIM directionHaveAmountLblIdx AS LONG
  DIM moveRelativeSetLblIdx AS LONG
  DIM moveModeReadyLblIdx AS LONG
  DIM moveRelativeLblIdx AS LONG
  DIM turnReadyLblIdx AS LONG

  rtOffset(RT_DRAW) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN EXIT SUB
  gfxCurrentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN EXIT SUB
  gfxCurrentYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_FG")
  IF ff = 0 THEN EXIT SUB
  gfxForegroundIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_DRAWINIT")
  IF ff = 0 THEN EXIT SUB
  drawInitIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_DRAWANGLE")
  IF ff = 0 THEN EXIT SUB
  drawAngleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_DRAWSCALE")
  IF ff = 0 THEN EXIT SUB
  drawScaleIdx = returnedData2

  ff = resolveSymbol("RT_LINE")
  IF ff = 0 THEN EXIT SUB
  lineFuncIdx = returnedData2

  ff = resolveSymbol("IAT_COS")
  IF ff = 0 THEN EXIT SUB
  cosFuncIdx = returnedData2

  ff = resolveSymbol("IAT_SIN")
  IF ff = 0 THEN EXIT SUB
  sinFuncIdx = returnedData2

  ff = resolveSymbol("RT_PAINT")
  IF ff = 0 THEN EXIT SUB
  paintFuncIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  degreesToRadiansLiteralIdx = tiraDoubleLiteralId&(0.017453292519943295#)
  IF degreesToRadiansLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF

  quarterScaleLiteralIdx = tiraDoubleLiteralId&(4#)
  IF quarterScaleLiteralIdx = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF

  argDrawIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId argDrawIdx, 1

  drawDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argDrawIdx)
  drawSizeIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argDrawIdx)

  drawIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId drawIndexIdx, TIRA_ARG_LITERAL, 0

  currentXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId currentXIdx, TIRA_ARG_SYMBOL, gfxCurrentXIdx

  currentYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId currentYIdx, TIRA_ARG_SYMBOL, gfxCurrentYIdx

  drawColorIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId drawColorIdx, TIRA_ARG_SYMBOL, gfxForegroundIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, drawColorIdx, TIRA_ARG_SYMBOL, drawColorIdx, TIRA_ARG_LITERAL, 255

  blindVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId blindVarIdx, TIRA_ARG_LITERAL, 0

  noMoveVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId noMoveVarIdx, TIRA_ARG_LITERAL, 0

  initDoneLblIdx = tiraLabelCreateNewId&("DRAW_INIT_DONE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, drawInitIdx, TIRA_ARG_LITERAL, 0, initDoneLblIdx

  tiraAssignId drawAngleIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId drawScaleIdx, TIRA_ARG_LITERAL, 4
  tiraAssignId drawInitIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId initDoneLblIdx

  drawSineIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  drawCosineIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraDrawCmdSetRotationId drawAngleIdx, drawSineIdx, drawCosineIdx, degreesToRadiansLiteralIdx, cosFuncIdx, sinFuncIdx

  commandPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  commandByteIdx = tiraDimVarId&("T", TYPE_UBYTE)

  vectorXIdx = tiraDimVarId&("T", TYPE_LONG)
  vectorYIdx = tiraDimVarId&("T", TYPE_LONG)

  numberOneIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  numberTwoIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  numberFoundIdx = tiraDimVarId&("T", TYPE_LONG)
  numberInvalidIdx = tiraDimVarId&("T", TYPE_LONG)
  relativeModeIdx = tiraDimVarId&("T", TYPE_LONG)
  fillMaskIdx = tiraDimVarId&("T", TYPE_LONG)

  drawLoopTopIdx = tiraLabelCreateNewId&("DRAW_LOOP")
  drawDoneLblIdx = tiraLabelCreateNewId&("DRAW_DONE")
  drawInvalidLblIdx = tiraLabelCreateNewId&("DRAW_INVALID")
  commandUpperDoneLblIdx = tiraLabelCreateNewId&("DRAW_UPPER_DONE")

  drawBlindLblIdx = tiraLabelCreateNewId&("DRAW_BLIND")
  drawNoMoveLblIdx = tiraLabelCreateNewId&("DRAW_NOMOVE")
  drawMoveLblIdx = tiraLabelCreateNewId&("DRAW_MOVE")
  drawUpLblIdx = tiraLabelCreateNewId&("DRAW_UP")
  drawDownLblIdx = tiraLabelCreateNewId&("DRAW_DOWN")
  drawLeftLblIdx = tiraLabelCreateNewId&("DRAW_LEFT")
  drawRightLblIdx = tiraLabelCreateNewId&("DRAW_RIGHT")
  drawNELblIdx = tiraLabelCreateNewId&("DRAW_NE")
  drawSELblIdx = tiraLabelCreateNewId&("DRAW_SE")
  drawSWLblIdx = tiraLabelCreateNewId&("DRAW_SW")
  drawNWLblIdx = tiraLabelCreateNewId&("DRAW_NW")
  drawColorLblIdx = tiraLabelCreateNewId&("DRAW_COLOR")
  drawScaleLblIdx = tiraLabelCreateNewId&("DRAW_SCALE")
  drawAngleLblIdx = tiraLabelCreateNewId&("DRAW_ANGLE")
  drawTurnLblIdx = tiraLabelCreateNewId&("DRAW_TURN")
  drawPaintLblIdx = tiraLabelCreateNewId&("DRAW_PAINT")
  directionAmountLblIdx = tiraLabelCreateNewId&("DRAW_DIRECTION_AMOUNT")
  directionHaveAmountLblIdx = tiraLabelCreateNewId&("DRAW_DIRECTION_HAVE_AMOUNT")

  moveRelativeSetLblIdx = tiraLabelCreateNewId&("DRAW_MOVE_RELATIVE_SET")
  moveModeReadyLblIdx = tiraLabelCreateNewId&("DRAW_MOVE_MODE_READY")
  moveRelativeLblIdx = tiraLabelCreateNewId&("DRAW_MOVE_RELATIVE")

  turnReadyLblIdx = tiraLabelCreateNewId&("DRAW_TURN_READY")

  tiraLabelId drawLoopTopIdx

  tiraDrawCmdSkipWhitespaceId drawDataIdx, drawIndexIdx, drawSizeIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, drawIndexIdx, TIRA_ARG_SYMBOL, drawSizeIdx, drawDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, commandPtrIdx, TIRA_ARG_SYMBOL, drawDataIdx, TIRA_ARG_SYMBOL, drawIndexIdx
  tiraReadMemId commandByteIdx, TIRA_ARG_SYMBOL, commandPtrIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, drawIndexIdx, TIRA_ARG_SYMBOL, drawIndexIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, commandByteIdx, TIRA_ARG_LITERAL, 59, drawLoopTopIdx

  ' Fold lower-case command bytes to upper case
