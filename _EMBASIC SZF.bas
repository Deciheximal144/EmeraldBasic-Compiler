''''''''''''''''''''''''
FUNCTION findSubIndex& (passName$)

  returnExtraPrepare

  DIM hashValue AS LONG
  DIM checkIdx AS LONG
  DIM entryIdx AS LONG
  DIM subIdx AS LONG
  DIM aliasCount AS LONG
  DIM aliasIdx AS LONG
  DIM isFound AS LONG

  searchName$ = UCASE$(RTRIM$(passName$))

  IF searchName$ = "" THEN
    return2 0
    findSubIndex = 0
    EXIT FUNCTION
  END IF

  IF routineLookupIndexedSubCount < 1 THEN routineLookupIndexedSubCount = 1

  IF routineLookupIndexedSubCount < subCount THEN
    FOR subIdx = routineLookupIndexedSubCount TO subCount - 1
      routineName$ = RTRIM$(subs(subIdx).RecordName)

      IF routineName$ <> "" THEN
        baseName$ = retRoutineBaseName$(routineName$)
        aliasCount = 1
        IF baseName$ <> "" AND baseName$ <> routineName$ THEN aliasCount = 2

        FOR aliasIdx = 0 TO aliasCount - 1
          lookupName$ = routineName$
          IF aliasIdx = 1 THEN lookupName$ = baseName$

          hashValue = hashString(lookupName$) AND ROUTINE_LOOKUP_HASH_MASK
          checkIdx = routineLookupHash(hashValue)
          isFound = 0

          DO WHILE checkIdx <> NO_VALID_INDEX
            IF routineLookupName$(checkIdx) = lookupName$ THEN
              isFound = 1
              EXIT DO
            END IF

            checkIdx = routineLookupHashNext(checkIdx)
          LOOP

          IF isFound = 0 THEN
            IF routineLookupEntryCount >= MAX_SUBS * 2 THEN
              throwCompilerError "ROUTINE LOOKUP INDEX LIMIT REACHED", ASIS, 0
              return2 0
              findSubIndex = 0
              EXIT FUNCTION
            END IF

            entryIdx = routineLookupEntryCount
            routineLookupName$(entryIdx) = lookupName$
            routineLookupSubIndex(entryIdx) = subIdx
            routineLookupHashNext(entryIdx) = routineLookupHash(hashValue)
            routineLookupHash(hashValue) = entryIdx
            routineLookupEntryCount = routineLookupEntryCount + 1
          END IF
        NEXT
      END IF
    NEXT

    routineLookupIndexedSubCount = subCount
  END IF

  hashValue = hashString(searchName$) AND ROUTINE_LOOKUP_HASH_MASK
  checkIdx = routineLookupHash(hashValue)

  DO WHILE checkIdx <> NO_VALID_INDEX
    IF routineLookupName$(checkIdx) = searchName$ THEN
      subIdx = routineLookupSubIndex(checkIdx)

      IF subIdx > 0 AND subIdx < subCount THEN
        return2 subIdx
        findSubIndex = 1
        EXIT FUNCTION
      END IF
    END IF

    checkIdx = routineLookupHashNext(checkIdx)
  LOOP

  return2 0
  findSubIndex = 0

END FUNCTION ' findSubIndex

