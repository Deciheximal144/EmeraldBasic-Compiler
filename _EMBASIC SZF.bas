''''''''''''''''''''''''
FUNCTION findSymbol& (vName$)

  returnExtraPrepare

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM routineSymbolLink AS LONG
  DIM lastChar AS STRING * 1
  DIM hasTypeSuffix AS _UNSIGNED LONG
  DIM searchName$
  DIM alternateName$

  searchName$ = UCASE$(vName$)

  IF findSymbolCanonical(searchName$) THEN
    findSymbol = SUCCESS
    EXIT FUNCTION
  END IF

  ' Permit $ and AS STRING declarations to identify the same variable
  IF cm.ClassicMode = 0 THEN
    IF cm.StringStrict = 0 THEN
      alternateName$ = ""
      lastChar = RIGHT$(searchName$, 1)

      IF lastChar = "$" THEN
        IF LEN(searchName$) > 1 THEN
          alternateName$ = LEFT$(searchName$, LEN(searchName$) - 1)
        END IF
      ELSE
        SELECT CASE lastChar

          CASE "#", "!", "&", "%", "~"

          CASE ELSE
            IF searchName$ <> "" THEN
              alternateName$ = searchName$ + "$"
            END IF

        END SELECT ' lastChar
      END IF

      IF alternateName$ <> "" THEN
        IF findSymbolCanonical(alternateName$) THEN
          vIdx = returnedData2

          IF symbols(vIdx).DataType = TYPE_STRING THEN
            IF symbols(vIdx).SubIndex = 0 THEN
              return2 vIdx
              findSymbol = SUCCESS
              EXIT FUNCTION
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

  ' Permit an unsuffixed reference to resolve a signed 64-bit function
  hasTypeSuffix = 0
  lastChar = RIGHT$(searchName$, 1)

  SELECT CASE lastChar

    CASE "$", "#", "!", "&", "%", "~"
      hasTypeSuffix = 1

  END SELECT ' lastChar

  IF hasTypeSuffix = 0 THEN
    alternateName$ = searchName$ + "&&"
    IF findSymbolCanonical(alternateName$) THEN
      vIdx = returnedData2
      IF symbols(vIdx).SubIndex <> 0 THEN
        return2 vIdx
        findSymbol = SUCCESS
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF findSubIndexCanonical(searchName$) THEN
    subIdx = returnedData2
    routineSymbolLink = routineSymbolIndex(subIdx)

    IF routineSymbolLink > 0 THEN
      vIdx = routineSymbolLink - 1

      IF vIdx < symbolCount THEN
        return2 vIdx
        findSymbol = SUCCESS
        EXIT FUNCTION
      END IF
    END IF
  END IF

  return2 NO_VALID_INDEX
  findSymbol = FAILURE

END FUNCTION ' findSymbol

''''''''''''''''''''''''
FUNCTION findSymbolCanonical& (searchName$)

  returnExtraPrepare

  DIM hVal AS _UNSIGNED LONG
  DIM checkIdx AS LONG
  DIM firstCh AS STRING * 1
  DIM secondCh AS STRING * 1
  DIM searchKey AS STRING * MAX_IDENTIFIER_LENGTH

  IF LEN(searchName$) > MAX_IDENTIFIER_LENGTH THEN
    return2 NO_VALID_INDEX
    findSymbolCanonical = FAILURE
    EXIT FUNCTION
  END IF

  hVal = hashSymbolString(searchName$)
  searchKey = searchName$

  IF currentScopeID > 0 THEN
    checkIdx = symScope((hVal + (currentScopeID * 257)) AND (SYMBOL_LOOKUP_HASH_MAX - 1))

    DO WHILE checkIdx <> NO_VALID_INDEX
      IF symbols(checkIdx).ScopeID = currentScopeID THEN
        IF symbols(checkIdx).RecordName = searchKey THEN
          return2 checkIdx
          findSymbolCanonical = SUCCESS
          EXIT FUNCTION
        END IF
      END IF

      checkIdx = symHashNext(checkIdx)
    LOOP
  END IF

  checkIdx = symScope(hVal)
  firstCh = LEFT$(searchName$, 1)
  secondCh = MID$(searchName$, 2, 1)

  DO WHILE checkIdx <> NO_VALID_INDEX
    IF symbols(checkIdx).ScopeID = 0 THEN
      IF symbols(checkIdx).RecordName = searchKey THEN
        IF currentScopeID = 0 THEN
          return2 checkIdx
          findSymbolCanonical = SUCCESS
          EXIT FUNCTION
        ELSE
          IF symbols(checkIdx).IsShared = 1 OR symbols(checkIdx).SubIndex <> 0 OR (firstCh = "!" AND (secondCh = "G" OR secondCh = "C")) OR firstCh = "@" THEN
            return2 checkIdx
            findSymbolCanonical = SUCCESS
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF

    checkIdx = symHashNext(checkIdx)
  LOOP

  return2 NO_VALID_INDEX
  findSymbolCanonical = FAILURE

END FUNCTION ' findSymbolCanonical

''''''''''''''''''''''''
FUNCTION findUdtFieldIndex& (passUdtIndex AS LONG, passName$)

  returnExtraPrepare

  DIM hashValue AS LONG
  DIM checkIdx AS LONG
  DIM fieldIdx AS LONG
  DIM searchKey AS STRING * MAX_IDENTIFIER_LENGTH

  IF passUdtIndex < 0 OR passUdtIndex >= udtCount THEN
    return2 NO_VALID_INDEX
    findUdtFieldIndex = FAILURE
    EXIT FUNCTION
  END IF

  searchName$ = RTRIM$(passName$)
  searchKey = searchName$

  IF udtFieldIndexedCount(passUdtIndex) > udts(passUdtIndex).FieldCount THEN
    FOR ii = 0 TO UDT_FIELD_HASH_MASK
      udtFieldHash(passUdtIndex, ii) = NO_VALID_INDEX
    NEXT
    udtFieldIndexedCount(passUdtIndex) = 0
  END IF

  IF udtFieldIndexedCount(passUdtIndex) < udts(passUdtIndex).FieldCount THEN
    FOR fieldIdx = udtFieldIndexedCount(passUdtIndex) TO udts(passUdtIndex).FieldCount - 1
      udtFieldHashNext(passUdtIndex, fieldIdx) = NO_VALID_INDEX
      recordName$ = RTRIM$(udtFields(passUdtIndex, fieldIdx).FieldName)

      IF recordName$ <> "" THEN
        hashValue = hashString(recordName$) AND UDT_FIELD_HASH_MASK
        udtFieldHashNext(passUdtIndex, fieldIdx) = udtFieldHash(passUdtIndex, hashValue)
        udtFieldHash(passUdtIndex, hashValue) = fieldIdx
      END IF
    NEXT

    udtFieldIndexedCount(passUdtIndex) = udts(passUdtIndex).FieldCount
  END IF

  hashValue = hashString(searchName$) AND UDT_FIELD_HASH_MASK
  checkIdx = udtFieldHash(passUdtIndex, hashValue)

  DO WHILE checkIdx <> NO_VALID_INDEX
    IF udtFields(passUdtIndex, checkIdx).FieldName = searchKey THEN
      return2 checkIdx
      findUdtFieldIndex = SUCCESS
      EXIT FUNCTION
    END IF

    checkIdx = udtFieldHashNext(passUdtIndex, checkIdx)
  LOOP

  return2 NO_VALID_INDEX
  findUdtFieldIndex = FAILURE

END FUNCTION ' findUdtFieldIndex

''''''''''''''''''''''''
FUNCTION findUdtIndex& (passName$)

  returnExtraPrepare

  DIM hashValue AS LONG
  DIM checkIdx AS LONG
  DIM udtIdx AS LONG
  DIM globalUdtIdx AS LONG
  DIM searchKey AS STRING * MAX_IDENTIFIER_LENGTH

  searchName$ = RTRIM$(passName$)
  searchKey = searchName$
  globalUdtIdx = NO_VALID_INDEX

  IF udtNameIndexedCount > udtCount THEN
    FOR ii = 0 TO UDT_NAME_HASH_MASK
      udtNameHash(ii) = NO_VALID_INDEX
    NEXT
    udtNameIndexedCount = 0
  END IF

  IF udtNameIndexedCount < udtCount THEN
    FOR udtIdx = udtNameIndexedCount TO udtCount - 1
      udtNameHashNext(udtIdx) = NO_VALID_INDEX
      recordName$ = RTRIM$(udts(udtIdx).RecordName)

      IF recordName$ <> "" THEN
        hashValue = hashString(recordName$) AND UDT_NAME_HASH_MASK
        udtNameHashNext(udtIdx) = udtNameHash(hashValue)
        udtNameHash(hashValue) = udtIdx
      END IF
    NEXT

    udtNameIndexedCount = udtCount
  END IF

  hashValue = hashString(searchName$) AND UDT_NAME_HASH_MASK
  checkIdx = udtNameHash(hashValue)

  DO WHILE checkIdx <> NO_VALID_INDEX
    IF udts(checkIdx).RecordName = searchKey THEN
      IF udts(checkIdx).ScopeID = currentScopeID THEN
        return2 checkIdx
        findUdtIndex = SUCCESS
        EXIT FUNCTION
      END IF
      IF udts(checkIdx).ScopeID = 0 THEN globalUdtIdx = checkIdx
    END IF

    checkIdx = udtNameHashNext(checkIdx)
  LOOP

  IF globalUdtIdx <> NO_VALID_INDEX THEN
    return2 globalUdtIdx
    findUdtIndex = SUCCESS
    EXIT FUNCTION
  END IF

  return2 NO_VALID_INDEX
  findUdtIndex = FAILURE

END FUNCTION ' findUdtIndex

''''''''''''''''''''''''
FUNCTION genAlignedCall (iatConst, backupReg, stackArgBytes AS LONG)

  ' stackArgBytes must be a multiple of 8

  ' Safety check to ensure stack argument allocation is aligned to 8-byte boundaries
  IF (stackArgBytes AND 7) <> 0 THEN ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
    errStr$ = "COMPILER FAIL: genAlignedCall tried to allocate " + LTRIM$(STR$(stackArgBytes)) + " stack argument bytes (not a multiple of 8) while compiling basic line " + retLineNumberStr$
    ESCAPETEXT errStr$
  END IF

  ' Helper function for calling external Windows API functions that require ABI compliance with 16-byte stack alignment and 32-byte shadow space

  DIM pushedFiller AS LONG
  DIM allocSize AS LONG
  DIM remainder AS LONG

  pushedFiller = 0

  ' Calculate total allocation (32 bytes shadow space + extra arguments)
  allocSize = 32 + stackArgBytes

  ' Ensure allocation size is a multiple of 16 to maintain stack alignment
  remainder = allocSize AND 15 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
  IF remainder <> 0 THEN
    allocSize = allocSize + (16 - remainder)
  END IF

  ' Call updateStackAlignment to see if the stack is misaligned by 8 bytes
  IF updateStackAlignment = 0 THEN
    ' Dummy Push - Push a harmless register to snap the stack pointer to a 16-byte boundary
    opPushReg backupReg
    pushedFiller = 1
  END IF

  ' Shadow space allocation - Carve out the mandatory bytes for the Windows API scratchpad
  ff = opALU(ALU_SUB, OP_TYPE_REG, 4, OP_TYPE_IMM, allocSize, 64)
  stack.currentStackOffset = stack.currentStackOffset + allocSize
  ff = updateStackAlignment

  ' The API Call - Execute the OS function safely using the properly formatted stack
  ff = opCall(iatConst, CALLMODE_IAT)

  ' The Cleanup - Destroy the shadow space to restore the stack
  ff = opALU(ALU_ADD, OP_TYPE_REG, 4, OP_TYPE_IMM, allocSize, 64)
  stack.currentStackOffset = stack.currentStackOffset - allocSize
  ff = updateStackAlignment

  ' If we pushed a dummy register above to fix alignment, pop it back off to leave the stack exactly as we found it
  IF pushedFiller = 1 THEN
    opPopReg backupReg
  END IF

  genAlignedCall = 1

END FUNCTION ' genAlignedCall

''''''''''''''''''''''''
SUB genBlockTransfer (srcReg, destReg, lenReg)

  ' The gen prefix indicates a higher-level code generation helper used to reduce boilerplate

  ' Emits an x64 block copy by transferring data from a source address register to a
  ' destination address register for a specified length. This helper automatically
  ' manages architectural register assignment and provides a safety check to skip
  ' the operation if the length is zero

  DIM jmpSkipCopyPos AS _UNSIGNED LONG

  opPushReg 6 ' Save non-volatile RSI
  opPushReg 7 ' Save non-volatile RDI
  opPushReg 1 ' Save volatile RCX

  ' Move to architectural string registers if not already there
  IF srcReg <> 6 THEN ff = opMov(OP_TYPE_REG, 6, OP_TYPE_REG, srcReg, 64)
  IF destReg <> 7 THEN ff = opMov(OP_TYPE_REG, 7, OP_TYPE_REG, destReg, 64)
  IF lenReg <> 1 THEN ff = opMov(OP_TYPE_REG, 1, OP_TYPE_REG, lenReg, 64)

  ' test rcx, rcx
  ff = opTest(OP_TYPE_REG, 1, OP_TYPE_REG, 1, 64)

  ' jle .skip_copy
  jmpSkipCopyPos = opJcc(JCC_JLE, JCC_MODE_FORWARD, 0, JCC_TYPE_SHORT)

  opFlag FLAG_CLD ' Ensure forward copying direction!

  ' rep movsb
  opString STR_MOVS, REP_REP, 8

  ' .skip_copy:
  patch8 jmpSkipCopyPos

  opPopReg 1
  opPopReg 7
  opPopReg 6

END SUB ' genBlockTransfer

''''''''''''''''''''''''
FUNCTION genLoadStringDesc (descReg, dataReg, lenReg)

  ' Extracts the Data Pointer and Length from a 24-byte string descriptor
  ' descReg contains the pointer to the descriptor. dataReg and lenReg receive the unpacked values.

  ' mov dataReg, [descReg] (Data)
  ff = opMov(OP_TYPE_REG, dataReg, OP_TYPE_MEM_REG, descReg, 64)

  ' mov lenReg, [descReg + 8] (Len)
  ff = opMov(OP_TYPE_REG, lenReg, OP_TYPE_MEM_REG_DISP8, descReg + (8 * 256), 64)

  genLoadStringDesc = 1

END FUNCTION ' genLoadStringDesc

''''''''''''''''''''''''
FUNCTION genSymbolRouteALU (aluOpCode AS LONG, destType AS LONG, destInfo AS LONG, srcType AS LONG, srcInfo AS _INTEGER64, opSize AS LONG, vIdx AS LONG)

  DIM subIdx AS LONG
  DIM rbpOffset AS LONG
  DIM fDestType AS LONG
  DIM fDestInfo AS LONG
  DIM fSrcType AS LONG
  DIM fSrcInfo AS _INTEGER64
  DIM isValidLocal AS LONG
  DIM patchPos AS LONG

  IF symbols(vIdx).DataType = TYPE_UNDEFINED THEN
    ESCAPETEXT2 "COMPILER FAIL: genSymbolRouteALU", "TYPE_UNDEFINED on symbol: " + RTRIM$(symbols(vIdx).RecordName)
  END IF

  fDestType = destType
  fDestInfo = destInfo
  fSrcType = srcType
  fSrcInfo = srcInfo

  isValidLocal = 0

  IF (symbols(vIdx).IsLocal = LOCAL_STANDARD OR symbols(vIdx).IsLocal = LOCAL_ABSOLUTE) AND symbols(vIdx).IsShared = 0 THEN
    IF symbols(vIdx).IsLocal = LOCAL_ABSOLUTE THEN
      rbpOffset = symbols(vIdx).LocalOffset
      isValidLocal = 1
    ELSE
      ff = findSubIndexByScope(symbols(vIdx).ScopeID)
      IF ff = 1 THEN
        subIdx = returnedData2
        rbpOffset = symbols(vIdx).LocalOffset - subs(subIdx).LocalFrameSize - 64
        isValidLocal = 1
      END IF
    END IF

    IF isValidLocal = 1 THEN
      IF destType = OP_TYPE_MEM_RIP THEN
        fDestType = OP_TYPE_MEM_RBP
        fDestInfo = rbpOffset
      END IF
      IF srcType = OP_TYPE_MEM_RIP THEN
        fSrcType = OP_TYPE_MEM_RBP
        fSrcInfo = rbpOffset
      END IF

      ff = opALU(aluOpCode, fDestType, fDestInfo, fSrcType, fSrcInfo, opSize)
      genSymbolRouteALU = 1
      EXIT FUNCTION
    END IF
  END IF

  ' Global fallback
  patchPos = opALU(aluOpCode, fDestType, fDestInfo, fSrcType, fSrcInfo, opSize)

  IF symbols(vIdx).DataType = TYPE_LABEL THEN
    addPatch PATCH_GOTO, patchPos, vIdx
  ELSE
    addPatch PATCH_VAR, patchPos, vIdx
  END IF

  genSymbolRouteALU = 1

END FUNCTION ' genSymbolRouteALU

''''''''''''''''''''''''
FUNCTION genSymbolRouteLea (destReg AS LONG, vIdx AS LONG)

  ' Automatically routes variable access to either global memory (RIP-relative) or local SUB/FUNCTION stack frames (RBP-relative)
  ' This prevents the frontend from needing massive boilerplate blocks to determine variable scope on every memory read/write

  DIM subIdx AS LONG
  DIM rbpOffset AS LONG
  DIM isValidLocal AS LONG
  DIM patchPos AS LONG

  IF symbols(vIdx).DataType = TYPE_UNDEFINED THEN
    ESCAPETEXT2 "GSRL FATAL IN genSymbolRouteLea", "TYPE_UNDEFINED on symbol: " + RTRIM$(symbols(vIdx).RecordName)
  END IF

  isValidLocal = 0

  IF (symbols(vIdx).IsLocal = LOCAL_STANDARD OR symbols(vIdx).IsLocal = LOCAL_ABSOLUTE) AND symbols(vIdx).IsShared = 0 THEN
    IF symbols(vIdx).IsLocal = LOCAL_ABSOLUTE THEN
      rbpOffset = symbols(vIdx).LocalOffset
      isValidLocal = 1
    ELSE
      ff = findSubIndexByScope(symbols(vIdx).ScopeID)
      IF ff = 1 THEN
        subIdx = returnedData2
        rbpOffset = symbols(vIdx).LocalOffset - subs(subIdx).LocalFrameSize - 64
        isValidLocal = 1
      END IF
    END IF

    IF isValidLocal = 1 THEN
      ff = opLea(OP_TYPE_REG, destReg, OP_TYPE_MEM_RBP, rbpOffset, 64)
      genSymbolRouteLea = 1
      EXIT FUNCTION
    END IF
  END IF

  ' Global fallback
  IF symbols(vIdx).DataType = TYPE_STRING AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE AND symbols(vIdx).IsTempInternal = 0 THEN
    patchPos = opMov(OP_TYPE_REG, destReg, OP_TYPE_MEM_RIP, 0, 64)
  ELSE
    patchPos = opLea(OP_TYPE_REG, destReg, OP_TYPE_MEM_RIP, 0, 64)
  END IF

  IF symbols(vIdx).DataType = TYPE_LABEL THEN
    addPatch PATCH_GOTO, patchPos, vIdx
  ELSE
    addPatch PATCH_VAR, patchPos, vIdx
  END IF

  genSymbolRouteLea = 1

END FUNCTION ' genSymbolRouteLea

''''''''''''''''''''''''
FUNCTION genSymbolRouteMov (destType AS LONG, destInfo AS LONG, srcType AS LONG, srcInfo AS _INTEGER64, opSize AS LONG, vIdx AS LONG)

  DIM subIdx AS LONG
  DIM rbpOffset AS LONG
  DIM fDestType AS LONG
  DIM fDestInfo AS LONG
  DIM fSrcType AS LONG
  DIM fSrcInfo AS _INTEGER64
  DIM isValidLocal AS LONG
  DIM patchPos AS LONG

  IF symbols(vIdx).DataType = TYPE_UNDEFINED THEN
    ESCAPETEXT2 "COMPILER FAIL: genSymbolRouteMov", "TYPE_UNDEFINED on symbol: " + RTRIM$(symbols(vIdx).RecordName)
  END IF

  fDestType = destType
  fDestInfo = destInfo
  fSrcType = srcType
  fSrcInfo = srcInfo

  isValidLocal = 0

  IF (symbols(vIdx).IsLocal = LOCAL_STANDARD OR symbols(vIdx).IsLocal = LOCAL_ABSOLUTE) AND symbols(vIdx).IsShared = 0 THEN
    IF symbols(vIdx).IsLocal = LOCAL_ABSOLUTE THEN
      rbpOffset = symbols(vIdx).LocalOffset
      isValidLocal = 1
    ELSE
      ff = findSubIndexByScope(symbols(vIdx).ScopeID)
      IF ff = 1 THEN
        subIdx = returnedData2
        rbpOffset = symbols(vIdx).LocalOffset - subs(subIdx).LocalFrameSize - 64
        isValidLocal = 1
      END IF
    END IF

    IF isValidLocal = 1 THEN
      IF destType = OP_TYPE_MEM_RIP THEN
        fDestType = OP_TYPE_MEM_RBP
        fDestInfo = rbpOffset
      END IF
      IF srcType = OP_TYPE_MEM_RIP THEN
        fSrcType = OP_TYPE_MEM_RBP
        fSrcInfo = rbpOffset
      END IF

      ' Local standalone strings and UDTs need their address (LEA) rather than value loaded, because
      ' their descriptors/structs reside inline on the stack instead of having a pointer in the global data segment
      IF (symbols(vIdx).DataType = TYPE_STRING OR symbols(vIdx).DataType = TYPE_UDT) AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE AND symbols(vIdx).IsTempInternal = 0 THEN
        IF srcType = OP_TYPE_MEM_RIP AND destType = OP_TYPE_REG THEN
          ff = opLea(OP_TYPE_REG, fDestInfo, OP_TYPE_MEM_RBP, rbpOffset, 64)
          genSymbolRouteMov = 1
          EXIT FUNCTION
        END IF
      END IF

      ff = opMov(fDestType, fDestInfo, fSrcType, fSrcInfo, opSize)
      genSymbolRouteMov = 1
      EXIT FUNCTION
    END IF
  END IF

  ' Global fallback
  patchPos = opMov(fDestType, fDestInfo, fSrcType, fSrcInfo, opSize)

  IF symbols(vIdx).DataType = TYPE_LABEL THEN
    addPatch PATCH_GOTO, patchPos, vIdx
  ELSE
    addPatch PATCH_VAR, patchPos, vIdx
  END IF

  genSymbolRouteMov = 1

END FUNCTION ' genSymbolRouteMov

''''''''''''''''''''''''
FUNCTION genSymbolRouteSSE (sseOpCode AS LONG, destType AS LONG, destInfo AS LONG, srcType AS LONG, srcInfo AS LONG, opMode AS LONG, vIdx AS LONG)

  DIM subIdx AS LONG
  DIM rbpOffset AS LONG
  DIM fDestType AS LONG
  DIM fDestInfo AS LONG
  DIM fSrcType AS LONG
  DIM fSrcInfo AS LONG
  DIM isValidLocal AS LONG
  DIM patchPos AS LONG

  IF symbols(vIdx).DataType = TYPE_UNDEFINED THEN
    ESCAPETEXT2 "COMPILER FAIL: genSymbolRouteSSE", "TYPE_UNDEFINED on symbol: " + RTRIM$(symbols(vIdx).RecordName)
  END IF

  fDestType = destType
  fDestInfo = destInfo
  fSrcType = srcType
  fSrcInfo = srcInfo

  isValidLocal = 0

  IF (symbols(vIdx).IsLocal = LOCAL_STANDARD OR symbols(vIdx).IsLocal = LOCAL_ABSOLUTE) AND symbols(vIdx).IsShared = 0 THEN
    IF symbols(vIdx).IsLocal = LOCAL_ABSOLUTE THEN
      rbpOffset = symbols(vIdx).LocalOffset
      isValidLocal = 1
    ELSE
      ff = findSubIndexByScope(symbols(vIdx).ScopeID)
      IF ff = 1 THEN
        subIdx = returnedData2
        rbpOffset = symbols(vIdx).LocalOffset - subs(subIdx).LocalFrameSize - 64
        isValidLocal = 1
      END IF
    END IF

    IF isValidLocal = 1 THEN
      IF destType = OP_TYPE_MEM_RIP THEN
        fDestType = OP_TYPE_MEM_RBP
        fDestInfo = rbpOffset
      END IF
      IF srcType = OP_TYPE_MEM_RIP THEN
        fSrcType = OP_TYPE_MEM_RBP
        fSrcInfo = rbpOffset
      END IF

      ff = opSSE(sseOpCode, fDestType, fDestInfo, fSrcType, fSrcInfo, opMode)
      genSymbolRouteSSE = 1
      EXIT FUNCTION
    END IF
  END IF

  ' Global fallback
  patchPos = opSSE(sseOpCode, fDestType, fDestInfo, fSrcType, fSrcInfo, opMode)

  IF symbols(vIdx).DataType = TYPE_LABEL THEN
    addPatch PATCH_GOTO, patchPos, vIdx
  ELSE
    addPatch PATCH_VAR, patchPos, vIdx
  END IF

  genSymbolRouteSSE = 1

END FUNCTION ' genSymbolRouteSSE

''''''''''''''''''''''''
FUNCTION hashString& (wStr$)

  DIM hVal AS _UNSIGNED LONG
  DIM sLen AS _UNSIGNED LONG
  DIM ii AS _UNSIGNED LONG

  hVal = 5381
  sLen = LEN(wStr$)
  FOR ii = 1 TO sLen
    hVal = ((hVal * 33) + ASC(wStr$, ii)) AND SYMBOL_HASH_MASK
  NEXT

  hashString = hVal

END FUNCTION ' hashString

''''''''''''''''''''''''
FUNCTION hashSymbolString& (wStr$)

  DIM hVal AS _UNSIGNED LONG
  DIM sLen AS _UNSIGNED LONG
  DIM ii AS _UNSIGNED LONG

  hVal = 5381 ' Conventional djb2 hash seed, used before processing the string
  sLen = LEN(wStr$)
  FOR ii = 1 TO sLen
    hVal = ((hVal * 33) + ASC(wStr$, ii)) AND (SYMBOL_LOOKUP_HASH_MAX - 1)
  NEXT

  hashSymbolString = hVal

END FUNCTION ' hashSymbolString

''''''''''''''''''''''''
SUB hoistIntrinsics

  DIM iSearch AS LONG
  DIM deepestStart AS LONG
  DIM deepestEnd AS LONG
  DIM tVal AS LONG
  DIM isIntrinsic AS LONG
  DIM isZeroArg AS LONG
  DIM repVar$
  DIM pEnd AS LONG
  DIM parenDepth AS LONG
  DIM hoistTop AS LONG
  DIM hoistStart(MAX_TOKENS) AS LONG
  DIM hoistDepth(MAX_TOKENS) AS LONG
  DIM processNow AS LONG
  DIM clearIdx AS LONG

  FOR clearIdx = 0 TO lineTokenCount - 1
    hoistedTokenSymbolRef(clearIdx) = 0
  NEXT

  IF lineTokenCount = 0 THEN EXIT SUB ' No intrinsic found

  parenDepth = 0
  hoistTop = 0
  iSearch = 0

  ' Find the first migrated intrinsic
  DO WHILE iSearch < lineTokenCount
    tVal = lineTokenVals(iSearch)
    isIntrinsic = 0
    processNow = 0

    ' Only trap intrinsics that have been successfully migrated to the Hoisting Architecture
    IF tVal >= 0 AND tVal <= 1024 THEN
      IF isHoistedIntrinsic(tVal) > 0 THEN
        isIntrinsic = 1

        ' Prevent the _MEM type descriptor from being hoisted as a math intrinsic
        IF iSearch > 0 THEN
          IF lineTokenVals(iSearch - 1) = TOK_AS THEN isIntrinsic = 0
        END IF

        ' Preserve the LEN = record-length clause in OPEN FOR RANDOM statements
        IF tVal = TOK_LEN THEN
          IF iSearch + 1 < lineTokenCount THEN
            IF lineTokenVals(iSearch + 1) = TOK_OP_EQUAL THEN
              IF lineTokenVals(0) = TOK_OPEN THEN isIntrinsic = 0
            END IF
          END IF
        END IF

        ' Prevent statement keywords from being hoisted when they appear at the start of a statement
        IF iSearch = 0 THEN
          IF isHoistedIntrinsic(tVal) = HOIST_CMD_REQ_ARGS OR isHoistedIntrinsic(tVal) = HOIST_CMD_NO_ARGS THEN isIntrinsic = 0
        END IF

        ' Prevent assignable intrinsics from hoisting when they are the target of an assignment
        IF isHoistedIntrinsic(tVal) = HOIST_ASSIGN_REQ_ARGS THEN
          IF iSearch = 0 OR (iSearch = 1 AND lineTokenVals(0) = TOK_LET) THEN
            IF iSearch + 1 < lineTokenCount THEN
              IF lineTokenVals(iSearch + 1) = TOK_OP_LPAREN THEN
                ff = findMatchingParen(iSearch + 1, lineTokenCount - 1)
                IF ff = 1 THEN
                  pEnd = returnedData2
                  IF pEnd + 1 < lineTokenCount THEN
                    IF lineTokenVals(pEnd + 1) = TOK_OP_EQUAL THEN
                      isIntrinsic = 0
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isIntrinsic = 1 THEN
      deepestStart = iSearch
      isZeroArg = 0

      IF isHoistedIntrinsic(tVal) = HOIST_NO_ARGS OR isHoistedIntrinsic(tVal) = HOIST_CMD_NO_ARGS THEN
        isZeroArg = 1
      END IF

      ' Tier 5: Intrinsics that can optionally take arguments (like RND)
      IF isHoistedIntrinsic(tVal) = HOIST_OPT_ARGS THEN
        IF iSearch + 1 < lineTokenCount THEN
          IF lineTokenVals(iSearch + 1) <> TOK_OP_LPAREN THEN
            isZeroArg = 1
          END IF
        ELSE
          isZeroArg = 1
        END IF
      END IF

      IF isZeroArg = 1 THEN
        deepestEnd = iSearch
        processNow = 1
      ELSE
        IF iSearch + 1 < lineTokenCount THEN
          IF lineTokenVals(iSearch + 1) = TOK_OP_LPAREN THEN
            '  Drill down to find the deepest nested one
            hoistTop = hoistTop + 1
            hoistStart(hoistTop) = iSearch
            hoistDepth(hoistTop) = parenDepth + 1
          ELSE
            throwCompilerError "INTRINSIC MISSING (", ASIS, 0
            EXIT SUB
          END IF
        ELSE
          throwCompilerError "INTRINSIC MISSING (", ASIS, 0
          EXIT SUB
        END IF
      END IF
    END IF

    IF processNow = 0 THEN
      IF tVal = TOK_OP_LPAREN THEN parenDepth = parenDepth + 1

      IF tVal = TOK_OP_RPAREN THEN
        IF hoistTop > 0 THEN
          IF hoistDepth(hoistTop) = parenDepth THEN
            deepestStart = hoistStart(hoistTop)
            deepestEnd = iSearch
            hoistTop = hoistTop - 1
            processNow = 1
          END IF
        END IF
        parenDepth = parenDepth - 1
      END IF
    END IF

    IF processNow = 1 THEN
      ' Route the deepest intrinsic to its parser
      hoistResultSymbolRef = 0
      repVar$ = parseIntrinsic$(deepestStart, deepestEnd, cm.ClassicMode) ' Use compile classic mode here, to determine whether to allow or not. Inside the function, specific overrides can be set
      IF repVar$ = "" OR compileError = 1 THEN
        EXIT SUB
      END IF

      ' Flatten the array to replace the intrinsic block with the generated variable
      collapseTokens deepestStart, deepestEnd, repVar$, hoistResultSymbolRef
      iSearch = deepestStart + 1
    ELSE
      iSearch = iSearch + 1
    END IF
  LOOP

  IF hoistTop > 0 THEN
    throwCompilerError "MISSING ) ON INTRINSIC", ASIS, 0
  END IF

END SUB ' hoistIntrinsics

''''''''''''''''''''''''
SUB indexSymbol (vIdx AS LONG)

  DIM hashValue AS LONG
  DIM resolvedCallTarget AS LONG

  IF vIdx < 0 OR vIdx >= symbolCount THEN EXIT SUB

  symbols(vIdx).CallKind = TIRA_CALL_KIND_NONE
  symbols(vIdx).CallTarget = 0
  symbols(vIdx).IsTempInternal = 0
  symbols(vIdx).IsGlobalInternal = 0
  symbols(vIdx).IsInternal = 0
  symbols(vIdx).IsLabelName = 0
  symbols(vIdx).IsRuntimeOrIatName = 0
  symbols(vIdx).IsBss = 0
  symbols(vIdx).IsUserBssArray = 0
  symbols(vIdx).IsFontData = 0
  symbols(vIdx).IsGosubArray = 0
  recordName$ = RTRIM$(symbols(vIdx).RecordName)

  IF recordName$ <> "" THEN
    IF LEFT$(recordName$, 1) = "!" THEN
      symbols(vIdx).IsInternal = 1
      SELECT CASE MID$(recordName$, 2, 1)
        CASE "T"
          symbols(vIdx).IsTempInternal = 1
        CASE "G"
          symbols(vIdx).IsGlobalInternal = 1
      END SELECT
    END IF

    IF LEFT$(recordName$, 1) = "@" OR LEFT$(recordName$, 1) = "%" THEN symbols(vIdx).IsLabelName = 1

    SELECT CASE recordName$
      CASE "!G_SYS_ARR_FONT"
        symbols(vIdx).IsFontData = 1
      CASE "!G_SYS_ARR_GOSUB"
        symbols(vIdx).IsGosubArray = 1
      CASE "!G_GFX_ARR_BUFR_FRONT", "!G_GFX_ARR_BUFR_BACK", "!G_GFX_ARR_BUFR_PAGE2", "!G_GFX_ARR_BUFR_PAGE3", "!G_GFX_ARR_FRMB_FRONT", "!G_GFX_ARR_FRMB_BACK", "!G_GFX_ARR_FRMB_PAGE2", "!G_GFX_ARR_FRMB_PAGE3", "!G_WND_VAL_HWND", "!G_INO_VAL_KBD_HEAD", "!G_INO_VAL_KBD_TAIL", "!G_INO_ARR_KBD_BUF", "!G_INO_ARR_KBD_STATE", "!G_FLS_ARR_HANDLES", "!G_INO_ARR_MOUSE_BUF", "!G_INO_VAL_MOUSE_HEAD", "!G_INO_VAL_MOUSE_TAIL"
        symbols(vIdx).IsBss = 1
    END SELECT

    ' Resolve stable callable prefixes once when the symbol is indexed so TC_CALL can remain numeric
    IF LEFT$(recordName$, 4) = "IAT_" THEN
      symbols(vIdx).IsRuntimeOrIatName = 1
      resolvedCallTarget = retIatConstByName(recordName$, 1)
      IF resolvedCallTarget <> IAT_INVALID THEN
        symbols(vIdx).CallKind = TIRA_CALL_KIND_IAT
        symbols(vIdx).CallTarget = resolvedCallTarget
      END IF
    ELSE
      IF LEFT$(recordName$, 3) = "RT_" THEN
        symbols(vIdx).IsRuntimeOrIatName = 1
        resolvedCallTarget = retRtIdByName(recordName$)
        IF resolvedCallTarget <> RT_INVALID THEN
          symbols(vIdx).CallKind = TIRA_CALL_KIND_RUNTIME
          symbols(vIdx).CallTarget = resolvedCallTarget
        END IF
      END IF
    END IF

    hashValue = hashSymbolString(recordName$)
    indexSymbolHash vIdx, hashValue
  END IF

  symIndexedSymbolCount = symbolCount

END SUB ' indexSymbol

''''''''''''''''''''''''
SUB indexSymbolHash (vIdx AS LONG, rsHashValue AS LONG)

  DIM hashValue AS LONG
  DIM scopeIdx AS LONG
  DIM tailLink AS LONG

  IF vIdx < 0 OR vIdx >= symbolCount THEN EXIT SUB

  hashValue = (rsHashValue + (symbols(vIdx).ScopeID * 257)) AND (SYMBOL_LOOKUP_HASH_MAX - 1)

  symHashNext(vIdx) = symScope(hashValue)
  symScope(hashValue) = vIdx

  scopeSymbolNext(vIdx) = 0
  scopeIdx = symbols(vIdx).ScopeID

  IF scopeIdx >= 0 AND scopeIdx <= MAX_SUBS THEN
    IF scopeSymbolHead(scopeIdx) = 0 THEN
      scopeSymbolHead(scopeIdx) = vIdx + 1
    ELSE
      tailLink = scopeSymbolTail(scopeIdx)
      scopeSymbolNext(tailLink - 1) = vIdx + 1
    END IF

    scopeSymbolTail(scopeIdx) = vIdx + 1
  END IF

END SUB ' indexSymbolHash

