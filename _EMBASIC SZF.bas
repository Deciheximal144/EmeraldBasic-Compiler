  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_ABI_PROLOGUE

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = 0

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

