'' SUB drawStatusPMI ' This is found within Z_EMLINF.BLB
'
' Renders the compiler status output box at the bottom of the screen and allows the user to click errors to jump to the code

''''''''''''''''''''''''
'' SUB drawTopMenuAndScrollPMI ' This is found within Z_EMLINF.BLB
'
' Renders the top menu bar dropdowns and the main vertical editor scrollbar while managing interactions for modal popups

''''''''''''''''''''''''
SUB emitByteCode (wByte AS _UNSIGNED _BYTE)

  IF compileError = 1 THEN EXIT SUB

  ' Measurement passes count bytes without writing to the fixed machine-code array.
  IF isMeasurePass = 1 THEN
    stream.emitPos = stream.emitPos + 1
    EXIT SUB
  END IF

  IF stream.emitPos >= MAX_CODE_SIZE THEN
    throwCompilerError "MACHINE CODE BUFFER OVERFLOW (MAX " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES)", ASIS, 0
    addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
    addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
    EXIT SUB
  END IF

  intermediateCode(stream.emitPos) = wByte
  stream.emitPos = stream.emitPos + 1

END SUB ' emitByteCode

''''''''''''''''''''''''
SUB emitBytes32 (wVal AS LONG)

  DIM uVal AS _UNSIGNED LONG
  DIM writePos AS _UNSIGNED LONG
  DIM writeEnd AS _INTEGER64
  DIM overflowPos AS _INTEGER64

  IF compileError = 1 THEN EXIT SUB

  IF isMeasurePass = 1 THEN
    stream.emitPos = stream.emitPos + 4
    EXIT SUB
  END IF

  writePos = stream.emitPos
  writeEnd = writePos
  writeEnd = writeEnd + 4

  IF writeEnd > MAX_CODE_SIZE THEN
    overflowPos = writePos
    IF overflowPos < MAX_CODE_SIZE THEN overflowPos = MAX_CODE_SIZE

    throwCompilerError "MACHINE CODE BUFFER OVERFLOW (MAX " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES)", ASIS, 0
    addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(overflowPos))
    addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
    EXIT SUB
  END IF

  uVal = wVal
  intermediateCode(writePos) = uVal AND 255
  intermediateCode(writePos + 1) = (uVal \ 256) AND 255
  intermediateCode(writePos + 2) = (uVal \ 65536) AND 255
  intermediateCode(writePos + 3) = (uVal \ 16777216) AND 255
  stream.emitPos = writePos + 4

END SUB ' emitBytes32

''''''''''''''''''''''''
SUB emitEpilogue

  DIM crlfFuncIdx AS LONG
  DIM printStrFuncIdx AS LONG
  DIM getStdHandleFuncIdx AS LONG
  DIM setConsoleModeFuncIdx AS LONG
  DIM readFileFuncIdx AS LONG
  DIM exitProcessFuncIdx AS LONG
  DIM swapBuffersFuncIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM getAsyncKeyStateFuncIdx AS LONG
  DIM pauseDescIdx AS LONG
  DIM exitValueIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM hStdinIdx AS LONG
  DIM bwPtrIdx AS LONG
  DIM bwValIdx AS LONG
  DIM relWaitCountIdx AS LONG
  DIM relLoopIdx AS LONG
  DIM relKeyDownIdx AS LONG
  DIM relDoneIdx AS LONG
  DIM keyIdx AS LONG
  DIM relKeyLoopIdx AS LONG
  DIM stateIdx AS LONG
  DIM pressLoopIdx AS LONG
  DIM pressKeyLoopIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM instantExitIdx AS LONG

  epilogueStartPos = stream.emitPos

  ensureFileWriteBufferSymbols

  tira_Start

  tiraFlushFileWriteBufferId

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  crlfFuncIdx = returnedData2

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrFuncIdx = returnedData2

  ff = resolveSymbol("!G_INO_DSC_PAUSE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  pauseDescIdx = returnedData2

  ff = resolveSymbol("IAT_EXITPROCESS")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  exitProcessFuncIdx = returnedData2

  ff = resolveSymbol("!G_SYS_VAL_EXIT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  exitValueIdx = returnedData2

  ff = resolveSymbol("@INSTANT_EXIT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  instantExitIdx = returnedData2

  SELECT CASE cm.HasGraphics

    CASE 0 ' Console epilogue

      ff = resolveSymbol("IAT_GETSTDHANDLE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      getStdHandleFuncIdx = returnedData2

      ff = resolveSymbol("IAT_SETCONSOLEMODE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      setConsoleModeFuncIdx = returnedData2

      ff = resolveSymbol("IAT_READFILE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      readFileFuncIdx = returnedData2

      ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      tempHeapIdx = returnedData2

      tiraCallId0 crlfFuncIdx
      tiraCallId1 printStrFuncIdx, TIRA_ARG_SYMBOL, pauseDescIdx

      ' hStdin = GetStdHandle(-10)
      tiraCallId1 getStdHandleFuncIdx, TIRA_ARG_LITERAL, -10
      hStdinIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraGetRetId hStdinIdx

      ' SetConsoleMode(hStdin, 0) to disable line input and echo
      tiraCallId2 setConsoleModeFuncIdx, TIRA_ARG_SYMBOL, hStdinIdx, TIRA_ARG_LITERAL, 0

      ' ReadFile (Wait for key)
      bwPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      bwValIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bwPtrIdx, TIRA_ARG_SYMBOL, bwValIdx
      tiraCallId5 readFileFuncIdx, TIRA_ARG_SYMBOL, hStdinIdx, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, bwPtrIdx, TIRA_ARG_LITERAL, 0

      ' Restore Console Mode to standard flags (503) to prevent terminal lockup
      tiraCallId2 setConsoleModeFuncIdx, TIRA_ARG_SYMBOL, hStdinIdx, TIRA_ARG_LITERAL, 503

      tiraLabelId instantExitIdx
      tiraCallId1 exitProcessFuncIdx, TIRA_ARG_SYMBOL, exitValueIdx

    CASE 1 ' Graphics epilogue

      ff = resolveSymbol("RT_SWAP_BUFFERS")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      swapBuffersFuncIdx = returnedData2

      ff = resolveSymbol("IAT_SLEEP")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      sleepFuncIdx = returnedData2

      ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      getAsyncKeyStateFuncIdx = returnedData2

      tiraCallId0 crlfFuncIdx
      tiraCallId0 crlfFuncIdx
      tiraCallId1 printStrFuncIdx, TIRA_ARG_SYMBOL, pauseDescIdx

      ' Flush the backbuffer to ensure final messages are visible before halting
      tiraCallId0 swapBuffersFuncIdx

      '''' Wait until no keys are pressed
      relWaitCountIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId relWaitCountIdx, TIRA_ARG_LITERAL, 0

      relLoopIdx = tiraLabelCreateNewId&("REL_WAIT")
      relKeyDownIdx = tiraLabelCreateNewId&("REL_KEY_DOWN")
      relDoneIdx = tiraLabelCreateNewId&("REL_DONE")
      tiraLabelId relLoopIdx
      tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 10

      keyIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

      relKeyLoopIdx = tiraLabelCreateNewId&("REL_KEY_LOOP")
      tiraLabelId relKeyLoopIdx
      tiraCallId1 getAsyncKeyStateFuncIdx, TIRA_ARG_SYMBOL, keyIdx
      stateIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraGetRetId stateIdx

      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_LITERAL, 32768
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_LITERAL, 0, relKeyDownIdx ' Restart if any key is pressed

      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, relKeyLoopIdx

      tiraJmpId relDoneIdx

      tiraLabelId relKeyDownIdx

      ' Limit the release wait so a latched virtual key cannot trap the program in the epilogue forever
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, relWaitCountIdx, TIRA_ARG_SYMBOL, relWaitCountIdx, TIRA_ARG_LITERAL, 1
      tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, relWaitCountIdx, TIRA_ARG_LITERAL, 50, relDoneIdx
      tiraJmpId relLoopIdx

      tiraLabelId relDoneIdx

      '''' Wait until ANY key is pressed
      pressLoopIdx = tiraLabelCreateNewId&("PRESS_WAIT")
      tiraLabelId pressLoopIdx
      tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 10

      tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

      pressKeyLoopIdx = tiraLabelCreateNewId&("PRESS_KEY_LOOP")
      tiraLabelId pressKeyLoopIdx
      tiraCallId1 getAsyncKeyStateFuncIdx, TIRA_ARG_SYMBOL, keyIdx
      tiraGetRetId stateIdx

      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_LITERAL, 32768
      doneLblIdx = tiraLabelCreateNewId&("DONE")
      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, stateIdx, TIRA_ARG_LITERAL, 0, doneLblIdx ' Exit if any key is pressed

      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, pressKeyLoopIdx

      tiraJmpId pressLoopIdx ' Restart press wait loop

      tiraLabelId doneLblIdx
      tiraLabelId instantExitIdx
      tiraCallId1 exitProcessFuncIdx, TIRA_ARG_SYMBOL, exitValueIdx

  END SELECT ' cm.HasGraphics

  tira_EndAndProcess

  metrics.EpilogueSize = stream.emitPos - epilogueStartPos

END SUB ' emitEpilogue

''''''''''''''''''''''''
SUB emitMemoryOperand (regField AS LONG, baseReg AS LONG, dispType AS LONG, dispVal AS LONG)

  DIM baseRegMod AS LONG
  DIM regFieldMod AS LONG
  DIM modRM AS LONG

  baseRegMod = baseReg AND 7
  regFieldMod = regField AND 7

  IF dispType = 0 THEN
    IF baseRegMod = 5 THEN
      modRM = &H40 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      emitByteCode 0
    ELSE
      modRM = &H00 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      IF baseRegMod = 4 THEN emitByteCode &H24
    END IF
  ELSE
    IF dispType = 8 THEN
      modRM = &H40 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      IF baseRegMod = 4 THEN emitByteCode &H24
      emitByteCode dispVal AND 255
    ELSE
      IF dispType = 32 THEN
        modRM = &H80 + (regFieldMod * 8) + baseRegMod
        emitByteCode modRM
        IF baseRegMod = 4 THEN emitByteCode &H24
        emitBytes32 dispVal
      END IF
    END IF
  END IF

END SUB ' emitMemoryOperand

''''''''''''''''''''''''
SUB emitPrologue

  DIM safeRspIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM frameFrontIdx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM bufferFrontIdx AS LONG
  DIM bufferCountPage1Idx AS LONG
  DIM bufferCountFrontIdx AS LONG
  DIM frameDisplayIdx AS LONG
  DIM bufferDisplayIdx AS LONG
  DIM pagingIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBottomIdx AS LONG
  DIM getCurrentThreadIdIdx AS LONG
  DIM userThreadIdIdx AS LONG
  DIM vehPtrIdx AS LONG
  DIM vehHandlerIdx AS LONG
  DIM addVehIdx AS LONG
  DIM getProcessHeapIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM displayAllocPtrIdx AS LONG
  DIM displayReadyLblIdx AS LONG
  DIM tempBaseIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG
  DIM tempStartIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM spillHeadIdx AS LONG
  DIM dataCountIdx AS LONG
  DIM dataIndexIdx AS LONG

  '''' Prologue
  tira_Start

  ' We allocate the main program frame using TC_MAIN_PROLOGUE instead of TC_ABI_PROLOGUE,
  ' because initStackLayout precisely calculates consoleFrameSize assuming no RBX push,
  ' which TC_ABI_PROLOGUE would alter and misalign hardcoded slot offsets.
  tiraMainPrologueId currentFrameSize

  ' Save the base stack pointer layout so the error handler knows where the stack began cleanly
  ff = resolveSymbol("!G_SYS_PTR_SAFE_RSP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  safeRspIdx = returnedData2
  tiraGetRspId safeRspIdx

  IF cm.HasGraphics = 1 THEN
    ' Keep the active SCREEN coordinate size separate from the physical client size
    ff = resolveSymbol("!G_GFX_V32_SCRNW")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    screenWidthIdx = returnedData2

    ff = resolveSymbol("!G_GFX_V32_SCRNH")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    screenHeightIdx = returnedData2

    tiraAssignId screenWidthIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraAssignId screenHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    ' Preserve fixed page one storage while the FRONT pointers become visual aliases
    ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    framePage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    frameFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    bufferPage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    bufferFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    bufferCountPage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    bufferCountFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    frameDisplayIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    bufferDisplayIdx = returnedData2

    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    pagingIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    visualPageIdx = returnedData2

    tiraAssignId framePage1Idx, TIRA_ARG_SYMBOL, frameFrontIdx
    tiraAssignId bufferPage1Idx, TIRA_ARG_SYMBOL, bufferFrontIdx
    tiraAssignId bufferCountPage1Idx, TIRA_ARG_SYMBOL, bufferCountFrontIdx
    tiraAssignId frameDisplayIdx, TIRA_ARG_SYMBOL, framePage1Idx
    tiraAssignId bufferDisplayIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
    tiraAssignId pagingIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0

    IF compileScreenMode = 9 THEN
      ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      viewTopIdx = returnedData2

      ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
      IF ff = 0 THEN
        tira_Cancel
        EXIT SUB
      END IF
      viewBottomIdx = returnedData2

      tiraAssignId viewTopIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId viewBottomIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
    END IF
  END IF

  IF cm.HasGraphics = 0 THEN
    ' In Console Mode there is only one thread, capture it here safely for the VEH
    ff = resolveSymbol("IAT_GETCURRENTTHREADID")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    getCurrentThreadIdIdx = returnedData2

    ff = resolveSymbol("!G_SYS_VAL_USER_THREAD_ID")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    userThreadIdIdx = returnedData2

    tiraCallId0 getCurrentThreadIdIdx
    tiraGetRetId userThreadIdIdx
  END IF

  ' Register the Vectored Exception Handler Block
  vehPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ff = resolveSymbol("RT_VEH_HANDLER")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  vehHandlerIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, vehPtrIdx, TIRA_ARG_SYMBOL, vehHandlerIdx

  ff = resolveSymbol("IAT_ADDVECTOREDEXCEPTIONHANDLER")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  addVehIdx = returnedData2
  tiraCallId2 addVehIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, vehPtrIdx

  ' Call GetProcessHeap
  ff = resolveSymbol("IAT_GETPROCESSHEAP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  getProcessHeapIdx = returnedData2
  tiraCallId0 getProcessHeapIdx

  ' Save rax into !G_MEM_PTR_PROCESS_HEAP
  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  processHeapIdx = returnedData2
  tiraGetRetId processHeapIdx

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  heapAllocIdx = returnedData2

  IF cm.HasGraphics = 1 THEN
    ' Allocate an isolated automatic-display snapshot without consuming a logical page
    tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, (gfxConfig.SizeX * gfxConfig.SizeY) + (GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize)

    displayAllocPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId displayAllocPtrIdx

    displayReadyLblIdx = tiraLabelCreateNewId&("PROLOGUE_DISPLAY_READY")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, displayAllocPtrIdx, TIRA_ARG_LITERAL, 0, displayReadyLblIdx

    tiraAssignId frameDisplayIdx, TIRA_ARG_SYMBOL, displayAllocPtrIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, bufferDisplayIdx, TIRA_ARG_SYMBOL, displayAllocPtrIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

    tiraLabelId displayReadyLblIdx

    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameDisplayIdx
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferDisplayIdx
    tiraAssignId bufferCountFrontIdx, TIRA_ARG_LITERAL, 0
  END IF

  ' call HeapAlloc
  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, TEMP_HEAP_SIZE

  ' Retrieve allocated pointer into the absolute boundary tracker
  ff = resolveSymbol("!G_MEM_PTR_TEMP_BASE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  tempBaseIdx = returnedData2
  tiraGetRetId tempBaseIdx

  ' Verify the allocation was successful to prevent a null pointer dereference
  skipOomLbl$ = "@PROLOGUE_OOM_SKIP"
  IF isDummyPass = 1 THEN skipOomLbl$ = "@PROLOGUE_OOM_SKIP_DUMMY"

  ff = resolveSymbol(skipOomLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  skipOomLblIdx = returnedData2
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, tempBaseIdx, TIRA_ARG_LITERAL, 0, skipOomLblIdx

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRspId

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = "OUT OF MEMORY"

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId skipOomLblIdx

  ' Add TEMP_HEAP_SIZE to pointer so it points to the END of the allocated block
  ' This allows string operations (like MID$) to safely subtract memory backwards
  ff = resolveSymbol("!G_MEM_PTR_TEMP_START")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  tempStartIdx = returnedData2
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tempStartIdx, TIRA_ARG_SYMBOL, tempBaseIdx, TIRA_ARG_LITERAL, TEMP_HEAP_SIZE

  ' Initialize the dynamic tracking heap pointer to the start location
  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  tempHeapIdx = returnedData2
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, tempStartIdx

  ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  spillHeadIdx = returnedData2
  tiraAssignId spillHeadIdx, TIRA_ARG_LITERAL, 0

  IF cm.HasGraphics = 0 THEN
    ' Initialize console viewport boundaries
    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewTopIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewBottomIdx = returnedData2

    tiraAssignId viewTopIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId viewBottomIdx, TIRA_ARG_LITERAL, 25

    ' Console INKEY$ polls the native console queue directly
  END IF

  ' Setup the DATA and READ layout tracker indexes natively in TIRA memory
  ff = resolveSymbol("!G_SYS_VAL_DATA_COUNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  dataCountIdx = returnedData2

  ff = resolveSymbol("!G_SYS_VAL_DATAINDEX")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  dataIndexIdx = returnedData2

  tiraAssignId dataCountIdx, TIRA_ARG_LITERAL, dataItemCount
  tiraAssignId dataIndexIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  metrics.PrologueSize = stream.emitPos

END SUB ' emitPrologue

''''''''''''''''''''''''
