''''''''''''''''''''''''
SUB tiraOpId4 (opConst AS LONG, arg1Type AS LONG, arg1Val AS _INTEGER64, arg2Type AS LONG, arg2Val AS _INTEGER64, arg3Type AS LONG, arg3Val AS _INTEGER64, arg4Type AS LONG, arg4Val AS _INTEGER64)

  tiraCheckActive ("tiraOpId4")
  IF tiraLineCheckId THEN EXIT SUB

  SELECT CASE opConst

    CASE TC_ADD, TC_SUB, TC_MUL, TC_DIV, TC_IDIV, TC_MOD, TC_AND, TC_OR, TC_XOR, TC_NOR, TC_NAND, TC_XNOR, TC_POW, TC_CONCAT, TC_SHL, TC_SHR, TC_SAR, TC_NEG, TC_NOT, TC_CALL, TC_ADDRESS_OF, TC_CAST, TC_COMPARE, TC_TEST, TC_JCC, TC_LEA_SIB
      ' Valid
    CASE ELSE
      throwCompilerError "UNKNOWN OR UNSUPPORTED TIRA CONSTANT IN OP", ASIS, 0
      EXIT SUB

  END SELECT ' opConst

  tiraNode(t.LineCount).OpCode = opConst

  tiraNode(t.LineCount).Arg1Type = arg1Type
  tiraNode(t.LineCount).Arg1Val = arg1Val

  tiraNode(t.LineCount).Arg2Type = arg2Type
  tiraNode(t.LineCount).Arg2Val = arg2Val

  tiraNode(t.LineCount).Arg3Type = arg3Type
  tiraNode(t.LineCount).Arg3Val = arg3Val

  tiraNode(t.LineCount).Arg4Type = arg4Type
  tiraNode(t.LineCount).Arg4Val = arg4Val

  t.LineCount = t.LineCount + 1

END SUB ' tiraOpId4

