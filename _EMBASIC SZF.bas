''''''''''''''''''''''''
SUB loadIncludesAndBaseCode

  DIM qStart AS LONG
  DIM qEnd AS LONG
  DIM ffTmp AS LONG
  DIM fileLen AS _UNSIGNED LONG
  DIM startPos AS _UNSIGNED LONG
  DIM nextNl AS _UNSIGNED LONG
  DIM chunkLen AS _UNSIGNED LONG
  DIM includeLineNumber AS LONG

  compileLastLine = 0
  FOR iy = 1 TO editor.LastLine
    compileLastLine = compileLastLine + 1
    compileText$(compileLastLine) = editorText$(iy)
    editorLineLinkMap(compileLastLine) = iy
    includeSourceLineMap(compileLastLine) = 0
  NEXT

  FOR iy = 1 TO editor.LastLine
    tempScan$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
    origDir$ = LTRIM$(RTRIM$(editorText$(iy)))

    IF LEFT$(tempScan$, 1) = "'" THEN
      tempScan$ = LTRIM$(MID$(tempScan$, 2))
      origDir$ = LTRIM$(MID$(origDir$, 2))
    ELSE
      IF LEFT$(tempScan$, 4) = "REM " OR tempScan$ = "REM" THEN
        tempScan$ = LTRIM$(MID$(tempScan$, 5))
        origDir$ = LTRIM$(MID$(origDir$, 5))
      END IF
    END IF

    IF LEFT$(tempScan$, 8) = "#INCLUDE" THEN
      qStart = INSTR(origDir$, CHR$(34))
      IF qStart > 0 THEN
        qEnd = INSTR(qStart + 1, origDir$, CHR$(34))
        IF qEnd > 0 THEN
          fName$ = MID$(origDir$, qStart + 1, qEnd - qStart - 1)
          IF _FILEEXISTS(fName$) THEN
            ffTmp = FREEFILE
            OPEN fName$ FOR BINARY AS #ffTmp
            fileLen = LOF(ffTmp)
            IF fileLen > 0 THEN
              fullText$ = SPACE$(fileLen)
              GET #ffTmp, , fullText$
              startPos = 1
              includeLineNumber = 1
              DO WHILE startPos <= fileLen
                nextNl = INSTR(startPos, fullText$, CHR$(10))
                IF nextNl > 0 THEN
                  chunkLen = nextNl - startPos
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                      includeSourceLineMap(compileLastLine) = includeLineNumber
                    ELSE
                      IF chunkLen > 0 THEN
                        CLOSE #ffTmp
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  startPos = nextNl + 1
                  includeLineNumber = includeLineNumber + 1
                ELSE
                  chunkLen = fileLen - startPos + 1
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                      includeSourceLineMap(compileLastLine) = includeLineNumber
                    ELSE
                      IF chunkLen > 0 THEN
                        CLOSE #ffTmp
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  EXIT DO
                END IF
              LOOP
            END IF
            CLOSE #ffTmp
          ELSE
            currentLineNumber = iy
            throwCompilerError "INCLUDE FILE NOT FOUND: " + fName$, ASIS, 0
            EXIT SUB
          END IF
        ELSE
          currentLineNumber = iy
          throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
          EXIT SUB
        END IF
      ELSE
        currentLineNumber = iy
        throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
        EXIT SUB
      END IF
    END IF
  NEXT

END SUB ' loadIncludesAndBaseCode

''''''''''''''''''''''''
SUB op_SafetyCheck (wStr$)

  $IF TIRA_OP_SAFETY = 1 THEN
    IF t.IsActive < 2 THEN ESCAPETEXT "OP FATAL: UNAUTHORIZED OP CALL IN " + wStr$
  $END IF

END SUB ' opSafetyCheck

''''''''''''''''''''''''
SUB opAddRsp32 (wVal AS LONG)

  ' Using opALU instead of this function will output 4 bytes instead of 7 bytes since opALU compresses values under 128

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opAddRsp32"
  $END IF

  emitByteCode &H48 ' REX.W
  emitByteCode &H81 ' ALU format 81
  emitByteCode &HC4 ' ModRM for ADD RSP
  emitBytes32 wVal

  stack.currentStackOffset = stack.currentStackOffset - wVal
  ff = updateStackAlignment

END SUB ' opAddRsp32

''''''''''''''''''''''''
FUNCTION opALU& (aluOpCode, destType, destInfo, srcType, srcInfo, opSizeOrFlag)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opALU"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG
  DIM useImm8 AS LONG

  DIM opBase03 AS LONG
  DIM opBase01 AS LONG
  DIM opBase81 AS LONG
  DIM opBase83 AS LONG

  tempRet = 0 ' Default return value, 0 means no patch position

  ' RSP (4) is permitted because opALU natively handles SUB RSP and ADD RSP for stack frame allocation
  ' RBP (5) is prohibited to prevent accidental modifications to the stable base frame pointer anchoring local variables
  IF destType = OP_TYPE_REG THEN
    IF destInfo < 0 OR destInfo > 15 OR destInfo = 5 THEN
      ESCAPETEXT "COMPILER FAIL: Invalid reg target (" + LTRIM$(STR$(destInfo)) + ") in opALU. RBP (5) is protected."
    END IF
  END IF

  IF opSizeOrFlag = MODE_RIP THEN
    srcReg = srcInfo
    rex = calcRex(64, srcReg, REG_NONE, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &H01 + (aluOpCode * 8)
    modRM = ((srcReg AND 7) * 8) + 5
    emitByteCode modRM
    tempRet = stream.emitPos
    emitBytes32 0
    opALU = tempRet
    EXIT FUNCTION
  END IF

  ' Set dynamic opcode bases based on operation bit size
  opBase03 = &H03
  opBase01 = &H01
  opBase81 = &H81
  opBase83 = &H83

  IF opSizeOrFlag = 8 THEN
    opBase03 = &H02
    opBase01 = &H00
    opBase81 = &H80
    opBase83 = &H80 ' 8-bit immediate operations don't need the sign-extended 83 base
  END IF

  SELECT CASE destType

    CASE OP_TYPE_ACC ' Explicit Accumulator-to-Immediate operations
      ' Requires srcType to be OP_TYPE_IMM
      rex = calcRex(opSizeOrFlag, REG_NONE, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF opSizeOrFlag = 8 THEN
        emitByteCode (aluOpCode * 8) + &H04
        emitByteCode (srcInfo AND 255)
      ELSE
        emitByteCode (aluOpCode * 8) + &H05
        IF opSizeOrFlag = 16 THEN
          emitByteCode (srcInfo AND 255)
          emitByteCode ((srcInfo \ 256) AND 255)
        ELSE
          emitBytes32 srcInfo
        END IF
      END IF

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, destReg, srcReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_REG_ALT
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          rex = calcRex(opSizeOrFlag, 0, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN
            emitByteCode opBase83
            modRM = &HC0 + (aluOpCode * 8) + (destReg AND 7)
            emitByteCode modRM
            emitByteCode (srcInfo AND 255)
          ELSE
            emitByteCode opBase81
            modRM = &HC0 + (aluOpCode * 8) + (destReg AND 7)
            emitByteCode modRM
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

        CASE OP_TYPE_MEM_RIP ' Memory-to-Register (RIP-relative)
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' Memory-to-Register (RSP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory-to-Register (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' Memory-to-Register (Register-Indirect, no displacement)
          baseReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' Memory-to-Register (Register-Indirect with 8-bit disp)
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory-to-Register (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Register-to-Memory (RIP-relative)
      srcReg = srcInfo
      rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex
      emitByteCode opBase01 + (aluOpCode * 8)
      modRM = ((srcReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RSP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RSP-relative)
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand aluOpCode, 4, 8, destInfo
          ELSE
            emitMemoryOperand aluOpCode, 4, 32, destInfo
          END IF

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RBP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, 5, 32, destInfo

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, 5, 32, destInfo

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 0, 0

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 0, 0

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 8, disp8

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 8, disp8

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 32, disp32

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opALU = tempRet

END FUNCTION ' opALU

''''''''''''''''''''''''
FUNCTION opCall& (wInfo, wMode)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opCall"
  $END IF

  DIM tempRet AS LONG
  tempRet = 0

  $IF STACK_SAFETY = 1 THEN

    IF updateStackAlignment = 0 THEN
      err1$ = "FATAL: Unaligned call offset:" + LTRIM$(STR$(stack.currentStackOffset)) + " bytes"

      ' Safely append the line number and subroutine name to the error string so the user knows exactly where it failed
      IF currentLineNumber > 0 AND currentLineNumber <= EDITOR_LINE_MAX THEN
        err1$ = err1$ + " Line: " + LTRIM$(STR$(currentLineNumber))
      END IF
      IF currentSubName$ <> "" THEN
        err1$ = err1$ + " in SUB: " + currentSubName$
      END IF

      ' Grab the actual text of the line from the editor array to print to the screen for visual debugging
      err2$ = ""
      IF currentLineNumber > 0 AND currentLineNumber <= EDITOR_LINE_MAX THEN
        IF compileText$(currentLineNumber) <> "" THEN
          err2$ = "[" + LTRIM$(RTRIM$(compileText$(currentLineNumber))) + "]"
        END IF
      END IF

      ' Append the internal caller metadata (IAT Index or Sub Index) to assist the compiler developer
      err2$ = err2$ + " (wInfo: " + LTRIM$(STR$(wInfo)) + ", wMode: " + LTRIM$(STR$(wMode)) + ")"

      ' Terminate compiler immediately to prevent generating a corrupted executable
      ESCAPETEXT2 err1$, err2$
    END IF

    ' End STACK_SAFETY check:
  $END IF

  IF wMode = CALLMODE_IAT THEN
    ' Emit 0xFF 0x15, which is the x64 opcode for an absolute indirect call (CALL QWORD PTR [RIP+disp])
    emitByteCode &HFF
    emitByteCode &H15

    ' Emit 4 null bytes as a placeholder for the 32-bit displacement value
    tempRet = stream.emitPos
    emitBytes32 0

    IF compileError = 1 THEN
      opCall = 0
      EXIT FUNCTION
    END IF

    ' IAT_INVALID remains the caller-managed patch sentinel
    IF wInfo <> IAT_INVALID THEN
      ' Queue the offset in the IAT patch list so prepareBinary can link it to the OS DLL table later
      addPatch PATCH_IAT, tempRet, wInfo
      IF compileError = 1 THEN
        opCall = 0
        EXIT FUNCTION
      END IF
    END IF

  ELSE
    IF wMode = CALLMODE_REL32 THEN
      ' Internal subroutine / runtime helper emission (relative 32-bit Call)
      emitByteCode &HE8

      ' Emit 4 null bytes as a placeholder for the displacement value
      tempRet = stream.emitPos
      emitBytes32 0

      IF compileError = 1 THEN
        opCall = 0
        EXIT FUNCTION
      END IF
    ELSE
      throwCompilerError "INVALID CALL MODE", ASIS, 0
      addStatusMsgContinuation "CALL MODE: " + LTRIM$(STR$(wMode)) + " | CALL INFO: " + LTRIM$(STR$(wInfo))
      opCall = 0
      EXIT FUNCTION
    END IF
  END IF

  ' Return the stream offset where the 4-byte displacement needs to be patched
  opCall = tempRet

END FUNCTION ' opCall

''''''''''''''''''''''''
SUB opExtend (wExtendType)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opExtend"
  $END IF

  SELECT CASE wExtendType

    CASE EXTEND_CWD
      emitByteCode &H66
      emitByteCode &H99
    CASE EXTEND_CDQ
      emitByteCode &H99

    CASE EXTEND_CQO
      emitByteCode &H48
      emitByteCode &H99

  END SELECT ' wExtendType

END SUB ' opExtend

''''''''''''''''''''''''
SUB opFlag (wFlagType)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opFlag"
  $END IF

  SELECT CASE wFlagType

    CASE FLAG_CLD
      emitByteCode &HFC

    CASE FLAG_STD
      emitByteCode &HFD

    CASE FLAG_CLI
      emitByteCode &HFA

    CASE FLAG_STI
      emitByteCode &HFB

    CASE FLAG_CLC
      emitByteCode &HF8

    CASE FLAG_STC
      emitByteCode &HF9

    CASE FLAG_CMC
      emitByteCode &HF5

  END SELECT ' wFlagType

END SUB ' opFlag

''''''''''''''''''''''''
SUB opHelperEmitSIBoperand (regField AS LONG, baseReg AS LONG, indexReg AS LONG, scaleVal AS LONG, dispVal AS LONG)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opHelperEmitSIBoperand"
  $END IF

  DIM modBits AS LONG
  DIM scaleBits AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM sibByte AS _UNSIGNED _BYTE

  IF dispVal = 0 AND (baseReg AND 7) <> 5 THEN
    modBits = 0
  ELSE
    IF dispVal >= -128 AND dispVal <= 127 THEN
      modBits = 1
    ELSE
      modBits = 2
    END IF
  END IF

  modRM = (modBits * 64) + ((regField AND 7) * 8) + 4
  emitByteCode modRM

  SELECT CASE scaleVal

    CASE 2: scaleBits = 1
    CASE 4: scaleBits = 2
    CASE 8: scaleBits = 3
    CASE ELSE: scaleBits = 0

  END SELECT ' scaleVal

  sibByte = (scaleBits * 64) + ((indexReg AND 7) * 8) + (baseReg AND 7)
  emitByteCode sibByte

  IF modBits = 1 THEN
    emitByteCode dispVal AND 255
  ELSE
    IF modBits = 2 THEN
      emitBytes32 dispVal
    END IF
  END IF

END SUB ' opHelperEmitSIBoperand

''''''''''''''''''''''''
FUNCTION opImul& (destReg AS LONG, srcType AS LONG, srcInfo AS _INTEGER64, immVal AS _INTEGER64, opMode AS LONG)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opImul"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG
  DIM useImm8 AS LONG
  DIM opSize AS LONG
  DIM isImmMode AS LONG

  checkRegisterBounds destReg, "opImul"

  tempRet = 0
  opSize = 32
  isImmMode = 0

  IF opMode = MODE_IMUL64_REG OR opMode = MODE_IMUL64_IMM OR opMode = MODE_IMUL64_IMM32 THEN opSize = 64
  IF opMode = MODE_IMUL32_IMM OR opMode = MODE_IMUL64_IMM OR opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN isImmMode = 1

  SELECT CASE srcType

    CASE OP_TYPE_REG
      srcReg = srcInfo
      rex = calcRex(opSize, destReg, srcReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
      emitByteCode modRM

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(opSize, destReg, REG_NONE, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      modRM = ((destReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_RSP
      rex = calcRex(opSize, destReg, 4, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      IF srcInfo >= -128 AND srcInfo <= 127 THEN
        emitMemoryOperand destReg, 4, 8, srcInfo
      ELSE
        emitMemoryOperand destReg, 4, 32, srcInfo
      END IF

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG
      baseReg = srcInfo AND 15
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 0, 0

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = srcInfo AND 15
      disp8 = ((srcInfo - baseReg) \ 256) AND 255
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 8, disp8

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = srcInfo AND 15
      disp32 = (srcInfo - baseReg) \ 256
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 32, disp32

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

  END SELECT ' srcType

  opImul = tempRet

END FUNCTION ' opImul

''''''''''''''''''''''''
FUNCTION opJcc& (condCode, wMode, wTarget AS _UNSIGNED LONG, wJumpType)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opJcc"
  $END IF

  DIM tempRet AS _UNSIGNED LONG
  DIM relativeOffset AS _INTEGER64

  tempRet = 0

  IF wJumpType = JCC_TYPE_SHORT THEN
    IF condCode = JCC_JMP THEN
      emitByteCode &HEB
    ELSE
      emitByteCode &H70 + condCode
    END IF

    IF wMode = JCC_MODE_FORWARD THEN
      tempRet = stream.emitPos
      emitByteCode 0
    ELSE
      relativeOffset = wTarget
      relativeOffset = relativeOffset - stream.emitPos
      relativeOffset = relativeOffset - 1
      emitByteCode relativeOffset AND 255
    END IF
  ELSE
    IF condCode = JCC_JMP THEN
      emitByteCode &HE9
    ELSE
      emitByteCode &H0F
      emitByteCode &H80 + condCode
    END IF

    IF wMode = JCC_MODE_FORWARD THEN
      ' We must capture the exact placement of the 4 displacement bytes.
      ' Because prepareBinary calculates offsets via (pOffEmit + 4) to find the instruction
      ' endpoint, we must consistently deliver the exact byte address immediately prior to the payload.
      tempRet = stream.emitPos
      emitBytes32 0
    ELSE
      relativeOffset = wTarget
      relativeOffset = relativeOffset - stream.emitPos
      relativeOffset = relativeOffset - 4
      emitBytes32 relativeOffset
    END IF
  END IF

  opJcc = tempRet

END FUNCTION ' opJcc

''''''''''''''''''''''''
FUNCTION opLea& (destType, destReg AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opLea"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  tempRet = 0

  IF destType <> OP_TYPE_REG THEN
    opLea = tempRet
    EXIT FUNCTION
  END IF

  checkRegisterBounds destReg, "opLea"

  SELECT CASE srcType

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      modRM = ((destReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP
      rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      IF srcInfo >= -128 AND srcInfo <= 127 THEN
        emitMemoryOperand destReg, 4, 8, srcInfo
      ELSE
        emitMemoryOperand destReg, 4, 32, srcInfo
      END IF

    CASE OP_TYPE_MEM_RBP
      rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, 5, 32, srcInfo

    CASE OP_TYPE_MEM_REG
      baseReg = srcInfo AND 15
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 0, 0

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = srcInfo AND 15
      disp8 = ((srcInfo - baseReg) \ 256) AND 255
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 8, disp8

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = srcInfo AND 15
      disp32 = (srcInfo - baseReg) \ 256
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 32, disp32

  END SELECT ' srcType

  opLea = tempRet

END FUNCTION ' opLea

''''''''''''''''''''''''
FUNCTION opLea_SIB (destReg AS LONG, baseReg AS LONG, indexReg AS LONG, scaleVal AS LONG, dispVal AS LONG, opSize AS LONG)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opLea_SIB"
  $END IF

  DIM rex AS _UNSIGNED _BYTE
  DIM tempRet AS LONG

  checkRegisterBounds destReg, "opLea_SIB"

  tempRet = 0
  rex = 0

  IF opSize = 64 THEN rex = rex OR &H08
  IF destReg >= 8 THEN rex = rex OR &H04
  IF indexReg >= 8 THEN rex = rex OR &H02
  IF baseReg >= 8 THEN rex = rex OR &H01

  IF rex > 0 THEN emitByteCode &H40 OR rex

  emitByteCode &H8D

  opHelperEmitSIBoperand destReg, baseReg, indexReg, scaleVal, dispVal

  opLea_SIB = tempRet

END FUNCTION ' opLea_SIB

''''''''''''''''''''''''
FUNCTION opMov& (destType, destInfo AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opMov"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM uVal64 AS _UNSIGNED _INTEGER64
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM is8bitSource AS LONG
  DIM is0FPrefix AS LONG
  DIM opCodeByte AS _UNSIGNED _BYTE
  DIM destOpSize AS LONG
  DIM tempRet AS LONG

  tempRet = 0 ' Default return value, 0 means no patch position

  IF destType = OP_TYPE_REG THEN
    ' RSP (4) is blocked because stack pointer modifications must go through explicit stack tracking subroutines
    ' RBP (5) is permitted because opMov natively handles MOV RBP, RSP for stack frame setup
    IF destInfo < 0 OR destInfo > 15 OR destInfo = 4 THEN
      ESCAPETEXT "FATAL: Invalid reg target (" + LTRIM$(STR$(destInfo)) + ") in opMov. RSP (4) is protected."
    END IF
  END IF

  SELECT CASE opSizeOrFlag

    CASE MODE_MOVZX32_8, MODE_MOVZX32_16, MODE_MOVZX64_8, MODE_MOVZX64_16, MODE_MOVSX32_8, MODE_MOVSX32_16, MODE_MOVSX64_8, MODE_MOVSX64_16, MODE_MOVSXD
      ' Handles movzx, movsx, movsxd
      IF destType <> OP_TYPE_REG THEN
        opMov = tempRet
        EXIT FUNCTION
      END IF

      destReg = destInfo
      is8bitSource = 0
      is0FPrefix = 1
      destOpSize = 32

      IF opSizeOrFlag = MODE_MOVZX64_8 OR opSizeOrFlag = MODE_MOVZX64_16 OR opSizeOrFlag = MODE_MOVSX64_8 OR opSizeOrFlag = MODE_MOVSX64_16 OR opSizeOrFlag = MODE_MOVSXD THEN
        destOpSize = 64
      END IF

      IF opSizeOrFlag = MODE_MOVZX32_8 OR opSizeOrFlag = MODE_MOVZX64_8 OR opSizeOrFlag = MODE_MOVSX32_8 OR opSizeOrFlag = MODE_MOVSX64_8 THEN
        is8bitSource = 1
      END IF

      IF opSizeOrFlag = MODE_MOVSXD THEN
        is0FPrefix = 0
        opCodeByte = &H63
      ELSE

        SELECT CASE opSizeOrFlag

          CASE MODE_MOVZX32_8, MODE_MOVZX64_8
            opCodeByte = &HB6
          CASE MODE_MOVZX32_16, MODE_MOVZX64_16
            opCodeByte = &HB7
          CASE MODE_MOVSX32_8, MODE_MOVSX64_8
            opCodeByte = &HBE
          CASE MODE_MOVSX32_16, MODE_MOVSX64_16
            opCodeByte = &HBF

        END SELECT ' opSizeOrFlag

      END IF

      SELECT CASE srcType

        CASE OP_TYPE_REG ' MOVZX/MOVSX r_dest, r_src
          srcReg = srcInfo
          rex = calcRex(destOpSize, destReg, srcReg, REG_NONE)
          IF is8bitSource = 1 THEN
            IF srcReg >= 4 AND srcReg <= 7 THEN rex = rex OR &H40
          END IF

          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_MEM_RIP ' MOVZX/MOVSX r_dest, [rip+disp32]
          rex = calcRex(destOpSize, destReg, REG_NONE, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' MOVZX/MOVSX r_dest, [rsp+disp]
          rex = calcRex(destOpSize, destReg, 4, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' MOVZX/MOVSX r_dest, [rbp+disp32]
          rex = calcRex(destOpSize, destReg, 5, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' MOVZX/MOVSX r_dest, [base_reg]
          baseReg = srcInfo AND 15
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' MOVZX/MOVSX r_dest, [base_reg+disp8]
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' MOVZX/MOVSX r_dest, [base_reg+disp32]
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 32, disp32

        CASE OP_TYPE_MEM_GS_ABS32 ' MOVZX/MOVSX r_dest, gs:[abs32]
          emitByteCode &H65
          rex = calcRex(destOpSize, destReg, REG_NONE, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = ((destReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 srcInfo

        CASE OP_TYPE_MEM_GS_REG_DISP32 ' MOVZX/MOVSX r_dest, gs:[base_reg+disp32]
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          emitByteCode &H65
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

      opMov = tempRet
      EXIT FUNCTION ' Extension logic is complete, exit

  END SELECT ' opSizeOrFlag

  IF opSizeOrFlag = MODE_IMM64 THEN
    destReg = destInfo
    rex = calcRex(64, REG_NONE, destReg, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &HB8 + (destReg AND 7)

    uVal64 = srcInfo
    FOR ii = 1 TO 8
      emitByteCode (uVal64 AND 255)
      uVal64 = uVal64 \ 256
    NEXT
    opMov = tempRet
    EXIT FUNCTION
  END IF

  IF opSizeOrFlag = MODE_RIP THEN
    srcReg = srcInfo
    rex = calcRex(64, srcReg, REG_NONE, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &H89
    modRM = ((srcReg AND 7) * 8) + 5
    emitByteCode modRM
    tempRet = stream.emitPos
    emitBytes32 0
    opMov = tempRet
    EXIT FUNCTION
  END IF

  SELECT CASE destType

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_REG_ALT
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, destReg, srcReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          IF opSizeOrFlag = 8 THEN
            rex = calcRex(8, REG_NONE, destReg, REG_NONE)
            IF rex > 0 THEN emitByteCode rex
            emitByteCode &HB0 + (destReg AND 7)
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 64 THEN
              uVal64 = srcInfo
              IF srcInfo >= -2147483648 AND srcInfo <= 2147483647 THEN
                rex = calcRex(64, 0, destReg, REG_NONE)
                IF rex > 0 THEN emitByteCode rex
                emitByteCode &HC7
                modRM = &HC0 + (destReg AND 7)
                emitByteCode modRM
                emitBytes32 srcInfo
              ELSE
                rex = calcRex(64, REG_NONE, destReg, REG_NONE)
                IF rex > 0 THEN emitByteCode rex
                emitByteCode &HB8 + (destReg AND 7)
                FOR ii = 1 TO 8
                  emitByteCode (uVal64 AND 255)
                  uVal64 = uVal64 \ 256
                NEXT
              END IF
            ELSE ' opSizeOrFlag = 32 or 16
              rex = calcRex(opSizeOrFlag, REG_NONE, destReg, REG_NONE)
              IF opSizeOrFlag = 16 THEN emitByteCode &H66
              IF rex > 0 THEN emitByteCode rex
              emitByteCode &HB8 + (destReg AND 7)
              IF opSizeOrFlag = 16 THEN
                emitByteCode (srcInfo AND 255)
                emitByteCode ((srcInfo \ 256) AND 255)
              ELSE
                emitBytes32 srcInfo
              END IF
            END IF
          END IF

        CASE OP_TYPE_MEM_RIP ' Memory-to-Register (RIP-relative)
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' Memory-to-Register (RSP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory-to-Register (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' Memory-to-Register (Register-Indirect, no displacement)
          baseReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' Memory-to-Register (Register-Indirect with 8-bit disp)
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory-to-Register (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 32, disp32

        CASE OP_TYPE_MEM_GS_ABS32 ' Memory-to-Register (GS Segment Absolute 32-bit)
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = ((destReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 srcInfo

        CASE OP_TYPE_MEM_GS_REG_DISP32 ' Memory-to-Register (GS Segment Register-Indirect 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Register-to-Memory (RIP-relative)
      srcReg = srcInfo
      rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex
      IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
      modRM = ((srcReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RSP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RSP-relative)
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand 0, 4, 8, destInfo
          ELSE
            emitMemoryOperand 0, 4, 32, destInfo
          END IF
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RBP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, 5, 32, destInfo

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, 5, 32, destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 0, 0

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 0, 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 8, disp8

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 8, disp8
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_ABS32 ' Register/Immediate-to-Memory (GS Segment Absolute 32-bit)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = ((srcReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          modRM = 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_REG_DISP32 ' Register/Immediate-to-Memory (GS Segment Register-Indirect 32-bit disp)
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opMov = tempRet

END FUNCTION ' opMov

''''''''''''''''''''''''
SUB opPopReg (wReg)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opPopReg"
  $END IF

  ' RSP (4) and RBP (5) are strictly protected from POP to prevent stack frame desynchronization
  ' The backend epilogues in tira_EndAndProcess manually bypass this to tear down stack frames

  IF wReg < 0 OR wReg > 15 OR wReg = 4 OR wReg = 5 THEN
    ESCAPETEXT2 "FATAL: Invalid reg target (" + LTRIM$(STR$(wReg)) + ") in opPopReg.", "RSP (4) and RBP (5) are protected."
  END IF

  ' Safety bounds check to ensure we do not underflow the compiler's tracked stack frame
  IF stack.currentStackOffset - 8 < 0 THEN
    routineName$ = currentSubName$

    IF routineName$ = "" THEN
      IF isCompilingRT = 1 THEN
        routineName$ = "RUNTIME"
      ELSE
        routineName$ = "MAIN"
      END IF
    END IF

    msg1$ = "FATAL: opPopReg underflow | Reg=" + LTRIM$(STR$(wReg)) + " Stack=" + LTRIM$(STR$(stack.currentStackOffset)) + "->" + LTRIM$(STR$(stack.currentStackOffset - 8)) + " Emit=&H" + HEX$(stream.emitPos)
    msg2$ = "Line=" + LTRIM$(STR$(currentLineNumber)) + " Flat=" + LTRIM$(STR$(pass5.LINE)) + " Routine=" + routineName$ + " Scope=" + LTRIM$(STR$(currentScopeID)) + " Pass=" + LTRIM$(STR$(pass5.Mode)) + " RT=" + LTRIM$(STR$(isCompilingRT))
    ESCAPETEXT2 msg1$, msg2$
  END IF

  IF wReg >= 8 THEN
    emitByteCode &H41
    emitByteCode (&H58 + (wReg AND 7))
  ELSE
    emitByteCode (&H58 + wReg)
  END IF

  stack.currentStackOffset = stack.currentStackOffset - 8
  ff = updateStackAlignment

END SUB ' opPopReg

''''''''''''''''''''''''
SUB opPushReg (wReg)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opPushReg"
  $END IF

  ' Unlike POP which overwrites registers, PUSH only reads them
  ' Therefore RSP (4) and RBP (5) are safe to use here without strict manual protection
  checkRegisterBounds wReg, "opPushReg"

  IF wReg >= 8 THEN
    emitByteCode &H41
    emitByteCode (&H50 + (wReg AND 7))
  ELSE
    emitByteCode (&H50 + wReg)
  END IF

  stack.currentStackOffset = stack.currentStackOffset + 8
  ff = updateStackAlignment

END SUB ' opPushReg

''''''''''''''''''''''''
SUB opRet

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opRet"
  $END IF

  emitByteCode &HC3

END SUB ' opRet

''''''''''''''''''''''''
FUNCTION opSetcc (passCondCode, passDestReg)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opSetcc"
  $END IF

  DIM rex AS _UNSIGNED _BYTE
  DIM modRM AS _UNSIGNED _BYTE
  DIM tempRet AS LONG

  checkRegisterBounds passDestReg, "opSetcc"

  tempRet = 0
  rex = 0

  IF passDestReg >= 8 THEN
    rex = rex OR &H01
  END IF

  ' If using SIL, DIL, BPL, SPL (regs 4-7) for an 8-bit operation, we need an empty REX prefix
  IF passDestReg >= 4 AND passDestReg <= 7 THEN
    rex = rex OR &H40
  END IF

  IF rex > 0 THEN emitByteCode &H40 OR rex

  emitByteCode &H0F
  emitByteCode &H90 + passCondCode

  modRM = &HC0 + (passDestReg AND 7)
  emitByteCode modRM

  opSetcc = tempRet

END FUNCTION ' opSetcc

''''''''''''''''''''''''
FUNCTION opSSE& (sseOpCode AS LONG, destType AS LONG, destInfo AS LONG, srcType AS LONG, srcInfo AS LONG, opMode AS LONG)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opSSE"
  $END IF

  DIM tempRet AS LONG
  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM prefix AS LONG
  DIM opByte AS LONG
  DIM isReverse AS LONG
  DIM primaryReg AS LONG
  DIM rmReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM opSize AS LONG

  tempRet = 0

  IF destType = OP_TYPE_REG THEN checkRegisterBounds destInfo, "opSSE"

  prefix = 0
  opByte = 0
  isReverse = 0
  opSize = 32

  IF opMode = MODE_SSE_SINGLE THEN prefix = &HF3
  IF opMode = MODE_SSE_DOUBLE THEN prefix = &HF2

  SELECT CASE sseOpCode

    CASE SSE_ADD: opByte = &H58
    CASE SSE_SUB: opByte = &H5C
    CASE SSE_MUL: opByte = &H59
    CASE SSE_DIV: opByte = &H5E

    CASE SSE_MOV
      IF destType = OP_TYPE_REG THEN
        opByte = &H10
      ELSE
        opByte = &H11
        isReverse = 1
      END IF

    CASE SSE_CVTSI2SD
      opSize = 64
      opByte = &H2A

    CASE SSE_CVTTSD2SI
      opSize = 64
      opByte = &H2C
      isReverse = 0

    CASE SSE_CVTSD2SI
      opSize = 64
      opByte = &H2D
      isReverse = 0

    CASE SSE_CVTSS2SD, SSE_CVTSD2SS
      opByte = &H5A

    CASE SSE_MOVQ_XMM_REG
      prefix = &H66
      opSize = 64
      opByte = &H6E
      isReverse = 0

    CASE SSE_MOVQ_REG_XMM
      prefix = &H66
      opSize = 64
      opByte = &H7E
      isReverse = 1

    CASE SSE_UCOMI
      IF opMode = MODE_SSE_SINGLE THEN prefix = 0
      IF opMode = MODE_SSE_DOUBLE THEN prefix = &H66
      opByte = &H2E

    CASE SSE_XOR
      IF opMode = MODE_SSE_SINGLE THEN prefix = 0
      IF opMode = MODE_SSE_DOUBLE THEN prefix = &H66
      opByte = &H57

  END SELECT ' sseOpCode

  IF isReverse = 1 THEN
    primaryReg = srcInfo
    rmReg = destInfo
  ELSE
    primaryReg = destInfo
    rmReg = srcInfo
  END IF

  baseReg = REG_NONE
  IF isReverse = 1 THEN
    IF destType = OP_TYPE_REG THEN baseReg = rmReg
    IF destType = OP_TYPE_MEM_RSP THEN baseReg = 4
    IF destType = OP_TYPE_MEM_RBP THEN baseReg = 5
    IF destType = OP_TYPE_MEM_REG OR destType = OP_TYPE_MEM_REG_DISP8 OR destType = OP_TYPE_MEM_REG_DISP32 THEN baseReg = rmReg AND 15
  ELSE
    IF srcType = OP_TYPE_REG THEN baseReg = rmReg
    IF srcType = OP_TYPE_MEM_RSP THEN baseReg = 4
    IF srcType = OP_TYPE_MEM_RBP THEN baseReg = 5
    IF srcType = OP_TYPE_MEM_REG OR srcType = OP_TYPE_MEM_REG_DISP8 OR srcType = OP_TYPE_MEM_REG_DISP32 THEN baseReg = rmReg AND 15
  END IF

  rex = calcRex(opSize, primaryReg, baseReg, REG_NONE)

  IF prefix <> 0 THEN emitByteCode prefix
  IF rex > 0 THEN emitByteCode rex
  emitByteCode &H0F
  emitByteCode opByte

  IF isReverse = 1 THEN

    SELECT CASE destType

      CASE OP_TYPE_REG
        modRM = &HC0 + ((primaryReg AND 7) * 8) + (rmReg AND 7)
        emitByteCode modRM

      CASE OP_TYPE_MEM_RIP
        modRM = ((primaryReg AND 7) * 8) + 5
        emitByteCode modRM
        tempRet = stream.emitPos
        emitBytes32 0

      CASE OP_TYPE_MEM_RSP
        IF rmReg >= -128 AND rmReg <= 127 THEN
          emitMemoryOperand primaryReg, 4, 8, rmReg
        ELSE
          emitMemoryOperand primaryReg, 4, 32, rmReg
        END IF

      CASE OP_TYPE_MEM_RBP
        emitMemoryOperand primaryReg, 5, 32, rmReg

      CASE OP_TYPE_MEM_REG
        baseReg = rmReg AND 15
        emitMemoryOperand primaryReg, baseReg, 0, 0

      CASE OP_TYPE_MEM_REG_DISP8
        baseReg = rmReg AND 15
        disp8 = ((rmReg - baseReg) \ 256) AND 255
        emitMemoryOperand primaryReg, baseReg, 8, disp8

      CASE OP_TYPE_MEM_REG_DISP32
        baseReg = rmReg AND 15
        disp32 = (rmReg - baseReg) \ 256
        emitMemoryOperand primaryReg, baseReg, 32, disp32

    END SELECT ' destType

  ELSE

    SELECT CASE srcType

      CASE OP_TYPE_REG
        modRM = &HC0 + ((primaryReg AND 7) * 8) + (rmReg AND 7)
        emitByteCode modRM

      CASE OP_TYPE_MEM_RIP
        modRM = ((primaryReg AND 7) * 8) + 5
        emitByteCode modRM
        tempRet = stream.emitPos
        emitBytes32 0

      CASE OP_TYPE_MEM_RSP
        IF rmReg >= -128 AND rmReg <= 127 THEN
          emitMemoryOperand primaryReg, 4, 8, rmReg
        ELSE
          emitMemoryOperand primaryReg, 4, 32, rmReg
        END IF

      CASE OP_TYPE_MEM_RBP
        emitMemoryOperand primaryReg, 5, 32, rmReg

      CASE OP_TYPE_MEM_REG
        baseReg = rmReg AND 15
        emitMemoryOperand primaryReg, baseReg, 0, 0

      CASE OP_TYPE_MEM_REG_DISP8
        baseReg = rmReg AND 15
        disp8 = ((rmReg - baseReg) \ 256) AND 255
        emitMemoryOperand primaryReg, baseReg, 8, disp8

      CASE OP_TYPE_MEM_REG_DISP32
        baseReg = rmReg AND 15
        disp32 = (rmReg - baseReg) \ 256
        emitMemoryOperand primaryReg, baseReg, 32, disp32

    END SELECT ' srcType

  END IF

  opSSE = tempRet

END FUNCTION ' opSSE

''''''''''''''''''''''''
SUB opString (wStrOp, wPrefix, wSize)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opString"
  $END IF

  IF wPrefix = REP_REP THEN emitByteCode &HF3
  IF wPrefix = REP_REPNE THEN emitByteCode &HF2

  IF wSize = 16 THEN emitByteCode &H66
  IF wSize = 64 THEN emitByteCode &H48

  baseOp = 0

  SELECT CASE wStrOp

    CASE STR_MOVS
      baseOp = &HA4

    CASE STR_CMPS
      baseOp = &HA6

    CASE STR_STOS
      baseOp = &HAA

    CASE STR_LODS
      baseOp = &HAC

    CASE STR_SCAS
      baseOp = &HAE

  END SELECT ' wStrOp

  IF wSize <> 8 THEN baseOp = baseOp + 1

  emitByteCode baseOp

END SUB ' opString

''''''''''''''''''''''''
SUB opSubRsp32 (wVal AS LONG)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opSubRsp32"
  $END IF

  'Using opALU instead of this function will output 4 bytes instead of 7 bytes since opALU compresses values under 128

  emitByteCode &H48 ' REX.W
  emitByteCode &H81 ' ALU format 81
  emitByteCode &HEC ' ModRM for SUB RSP
  emitBytes32 wVal

  stack.currentStackOffset = stack.currentStackOffset + wVal
  ff = updateStackAlignment

END SUB ' opSubRsp32

''''''''''''''''''''''''
FUNCTION opTest& (destType, destInfo AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opTest"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  DIM opBase85 AS LONG
  DIM opBaseF7 AS LONG

  tempRet = 0

  IF destType = OP_TYPE_REG THEN checkRegisterBounds destInfo, "opTest"

  opBase85 = &H85
  opBaseF7 = &HF7

  IF opSizeOrFlag = 8 THEN
    opBase85 = &H84
    opBaseF7 = &HF6
  END IF

  SELECT CASE destType

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          emitByteCode opBase85
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          rex = calcRex(opSizeOrFlag, 0, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          emitByteCode opBaseF7
          modRM = &HC0 + (destReg AND 7) ' reg field is 0 for TEST imm
          emitByteCode modRM

          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Memory (RIP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          modRM = ((srcReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          modRM = 5 ' reg field is 0
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RSP ' Memory (RSP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand 0, 4, 8, destInfo
          ELSE
            emitMemoryOperand 0, 4, 32, destInfo
          END IF
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP ' Memory (RBP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, 5, 32, destInfo
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, 5, 32, destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 0, 0
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 0, 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 8, disp8
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 8, disp8
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 32, disp32
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_ABS32 ' Register/Immediate-to-Memory (GS Segment Absolute 32-bit)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = ((srcReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          modRM = 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_REG_DISP32 ' Register/Immediate-to-Memory (GS Segment Register-Indirect 32-bit disp)
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opTest = tempRet

END FUNCTION ' opTest

''''''''''''''''''''''''
FUNCTION opUnary& (passOpCode, passDestType, passDestInfo, passOpSize)

  $IF TIRA_OP_SAFETY = 1 THEN
    op_SafetyCheck "opUnary"
  $END IF

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM baseReg AS LONG
  DIM disp AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  tempRet = 0

  IF passDestType = OP_TYPE_REG THEN
    IF passDestInfo < 0 OR passDestInfo > 15 OR passDestInfo = 4 OR passDestInfo = 5 THEN
      ESCAPETEXT "FATAL: Invalid reg target (" + LTRIM$(STR$(passDestInfo)) + ") in opUnary. RSP (4) and RBP (5) are protected."
    END IF
  END IF

  SELECT CASE passDestType

    CASE OP_TYPE_REG
      baseReg = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      modRM = &HC0 + (passOpCode * 8) + (baseReg AND 7)
      emitByteCode modRM

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(passOpSize, REG_NONE, REG_NONE, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      modRM = (passOpCode * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP
      disp = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, 4, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      IF disp >= -128 AND disp <= 127 THEN
        emitMemoryOperand passOpCode, 4, 8, disp
      ELSE
        emitMemoryOperand passOpCode, 4, 32, disp
      END IF

    CASE OP_TYPE_MEM_RBP
      disp = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, 5, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, 5, 32, disp

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = passDestInfo AND 15
      disp8 = ((passDestInfo - baseReg) \ 256) AND 255
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, baseReg, 8, disp8

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = passDestInfo AND 15
      disp32 = (passDestInfo - baseReg) \ 256
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, baseReg, 32, disp32

  END SELECT ' passDestType

  opUnary = tempRet

END FUNCTION ' opUnary

''''''''''''''''''''''''
FUNCTION parse_ASC$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM validAscLblIdx AS LONG
  DIM errStr$
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM endProgramIdx AS LONG
  DIM byteValIdx AS LONG
  DIM comma1 AS LONG
  DIM posVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM jmpDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ASC", 3) = 0 THEN
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "POSITION MUST BE NUMERIC")
    IF ff = 0 THEN
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal
  ELSE
    ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    arg2Type = TIRA_ARG_LITERAL
    arg2Val = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("ASC", "_VAL")
  IF scratchIdx = 0 THEN
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  validAscLblIdx = tiraLabelCreateNewId&("VALID_ASC")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, validAscLblIdx
  tiraJmpCondId JCC_JL, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1, validAscLblIdx
  tiraJmpCondId JCC_JG, arg2Type, arg2Val, TIRA_ARG_SYMBOL, strLenIdx, validAscLblIdx

  posVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, posVarIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, posVarIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, targetAddrIdx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  jmpDoneIdx = tiraLabelCreateNewId&("ASC_DONE")
  tiraJmpId jmpDoneIdx

  tiraLabelId validAscLblIdx

  errStr$ = "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN ASC() ON LINE " + retLineNumberStr$
  ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = errStr$

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId jmpDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_ASC$ = scratchName$

END FUNCTION ' parse_ASC$

''''''''''''''''''''''''
FUNCTION parse_ASC_Assign (startIdx)

  DIM endIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM comma1 AS LONG
  DIM strStartIdx AS LONG
  DIM strEndIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG
  DIM udtFieldNames$(MAX_UDT_FIELDS)
  DIM vTok$
  DIM vName$
  DIM lastCharCheck$
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tempFieldSize AS LONG
  DIM numParsedIndices AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM finalAddrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM posVarType AS LONG
  DIM posVarVal AS _INTEGER64
  DIM posVarIdx AS LONG
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM lblErrIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM posOffsetIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM valByteIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "MALFORMED ASC ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(tokIdx) <> TOK_OP_LPAREN THEN
    throwCompilerError "EXPECTED ( AFTER ASC", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(tokIdx, endIdx)
  IF ff = FAILURE THEN
    throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParenIdx = returnedData2

  IF closeParenIdx + 1 > endIdx OR lineTokenVals(closeParenIdx + 1) <> TOK_OP_EQUAL THEN
    throwCompilerError "EXPECTED = IN ASC ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, closeParenIdx - 1)

  strStartIdx = startIdx + 2
  IF comma1 > 0 THEN
    strEndIdx = comma1 - 1
  ELSE
    strEndIdx = closeParenIdx - 1
  END IF

  vTok$ = lineTokens$(strStartIdx)
  vName$ = UCASE$(vTok$)
  tokIdx = strStartIdx + 1

  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= strEndIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= strEndIdx THEN
    IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, strEndIdx)
      IF ff = SUCCESS THEN
        tokIdx = returnedData2 + 1
      ELSE
        EXIT FUNCTION
      END IF
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= MAX_UDT_FIELDS THEN
        throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= strEndIdx THEN
    throwCompilerError "ASC TARGET MUST BE A SINGLE ADDRESSABLE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  IF findSymbol(vName$) = FAILURE THEN
    lastCharCheck$ = RIGHT$(vName$, 1)
    IF lastCharCheck$ <> "$" AND lastCharCheck$ <> "#" AND lastCharCheck$ <> "!" AND lastCharCheck$ <> "%" AND lastCharCheck$ <> "&" AND lastCharCheck$ <> "~" THEN
      IF findSymbol(vName$ + "$") THEN
        IF symbols(returnedData2).DataType = TYPE_STRING THEN
          vName$ = vName$ + "$"
        END IF
      END IF
    END IF
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = FAILURE THEN EXIT FUNCTION
  vIdx = returnedData2
  targetType = returnedData3

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  ff = validateSymbolArrayScalar(vIdx, vName$, hasIndex, wasNewSymbol, 0, 0)
  IF ff = FAILURE THEN EXIT FUNCTION

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempFieldSize = udtFields(uIdx, iField).Size
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
          iField = returnedData2
          IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
            udtOffset = udtOffset + udtFields(uIdx, iField).Offset
            targetType = udtFields(uIdx, iField).DataType
            tempUdtIndex = udtFields(uIdx, iField).UDTIndex
            tempFieldSize = udtFields(uIdx, iField).Size
            tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
            fieldFound = 1
          END IF
        END IF
      END IF

      IF fieldFound = 0 THEN
        throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  IF targetType <> TYPE_STRING THEN
    throwCompilerError "ASC TARGET MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayId(parenStartIdx, strEndIdx, 0)
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
      throwCompilerError "ARRAY NOT DIMMED", ASIS, 0
      tira_Cancel
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  isFixedStr = 0
  destLen = 0
  IF hasField = 1 THEN
    IF tempIsDynamicString = 0 THEN
      isFixedStr = 1
      destLen = tempFieldSize
    END IF
  ELSE
    destLen = retFixedStringLength(vIdx)
    IF destLen > 0 THEN
      isFixedStr = 1
    END IF
  END IF

  IF isFixedStr = 1 THEN
    dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    strLenIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, destLen
  ELSE
    lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraReadMemId lhsDescPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
  END IF

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntId(comma1 + 1, closeParenIdx - 1, ALIM, "POSITION MUST BE NUMERIC")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    posVarType = tiraParsedArgType
    posVarVal = tiraParsedArgVal
  ELSE
    posVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId posVarIdx, TIRA_ARG_LITERAL, 1
    posVarType = TIRA_ARG_SYMBOL
    posVarVal = posVarIdx
  END IF

  ff = tiraParseExpressionIntId(closeParenIdx + 2, endIdx, ALIM, "VALUE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  lblErrIdx = tiraLabelCreateNewId&("ASC_ERR")
  lblValidIdx = tiraLabelCreateNewId&("ASC_VALID")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblErrIdx
  tiraJmpCondId JCC_JL, posVarType, posVarVal, TIRA_ARG_LITERAL, 1, lblErrIdx
  tiraJmpCondId JCC_JG, posVarType, posVarVal, TIRA_ARG_SYMBOL, strLenIdx, lblErrIdx
  tiraJmpCondId JCC_JL, valVarType, valVarVal, TIRA_ARG_LITERAL, 0, lblErrIdx
  tiraJmpCondId JCC_JG, valVarType, valVarVal, TIRA_ARG_LITERAL, 255, lblErrIdx
  tiraJmpId lblValidIdx

  tiraLabelId lblErrIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId lblValidIdx

  posOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, posOffsetIdx, posVarType, posVarVal, TIRA_ARG_LITERAL, 1

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, posOffsetIdx

  valByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, valByteIdx, valVarType, valVarVal, TIRA_ARG_LITERAL, 255

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, valByteIdx, TIRA_ARG_LITERAL, 1

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_ASC_Assign = SUCCESS

END FUNCTION ' parse_ASC_Assign

''''''''''''''''''''''''
FUNCTION parse_CASE (startIdx)

  DIM endIdx AS LONG
  DIM hiddenVarIdx AS LONG
  DIM selectType AS LONG
  DIM selID AS LONG
  DIM caseID AS LONG
  DIM exprStart AS LONG
  DIM exprEnd AS LONG
  DIM toIdx AS LONG
  DIM hasTo AS LONG
  DIM tVal AS LONG
  DIM opType AS LONG
  DIM relStart AS LONG
  DIM nxtVal AS LONG
  DIM commaIdx AS LONG
  DIM lhsVarType AS LONG
  DIM lhsVarVal AS _INTEGER64
  DIM rhsVarType AS LONG
  DIM rhsVarVal AS _INTEGER64
  DIM endSelLblIdx AS LONG
  DIM nextCaseLblIdx AS LONG
  DIM bodyLblIdx AS LONG
  DIM prevNextLblIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM condConst AS LONG

  IF ctrlCount = 0 THEN
    throwCompilerError "CASE WITHOUT SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_SELECT THEN
    throwCompilerError "CASE NOT INSIDE SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  hiddenVarIdx = ctrls(ctrlCount - 1).SelectVarIdx
  selectType = ctrls(ctrlCount - 1).SelectDataType
  selID = ctrls(ctrlCount - 1).Patch1
  caseID = ctrls(ctrlCount - 1).SelectCaseSeen

  endSelLbl$ = "@SEL_END_" + LTRIM$(RTRIM$(STR$(selID)))
  nextCaseLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID)))
  bodyLbl$ = "@SEL_BODY_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID)))

  IF caseID > 0 THEN
    tira_Start

    ' Jump to end of SELECT block because the PREVIOUS case just finished executing its body
    tiraScheduleHeapResetId

    ff = resolveSymbol(endSelLbl$)
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endSelLblIdx = returnedData2
    tiraJmpId endSelLblIdx

    ' The previous case's conditions would skip to right here if they all failed
    prevNextLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID - 1)))
    ff = resolveSymbol(prevNextLbl$)
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    prevNextLblIdx = returnedData2
    tiraLabelId prevNextLblIdx

    tira_EndAndProcess
  END IF

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  endIdx = lineTokenCount - 1

  tira_Start

  exprStart = startIdx + 1

  IF exprStart <= endIdx THEN
    IF lineTokenVals(exprStart) = 256 + ASC(":") THEN
      exprStart = exprStart + 1
    END IF
  END IF

  ' Check for CASE ELSE
  IF exprStart <= endIdx THEN
    IF lineTokenVals(exprStart) = TOK_ELSE THEN
      ' Since it is CASE ELSE, execution falls right through, no conditions
      tiraScheduleHeapResetId
      tira_EndAndProcess

      ctrls(ctrlCount - 1).SelectCaseSeen = caseID + 1

      parse_CASE = SUCCESS
      EXIT FUNCTION
    END IF
  END IF

  ' Evaluate a comma-separated list of expressions
  DO WHILE exprStart <= endIdx
    exprEnd = endIdx

    commaIdx = findComma(exprStart, endIdx)
    IF commaIdx > 0 THEN
      exprEnd = commaIdx - 1
    END IF

    hasTo = 0
    toIdx = 0
    ff = findNextTokenAtDepth0(exprStart, exprEnd, TOK_TO)
    IF ff = SUCCESS THEN
      hasTo = 1
      toIdx = returnedData2
    END IF

    IF hasTo = 1 THEN
      '''' Case X to Y

      ff = tiraParseExpressionId(exprStart, toIdx - 1, ALIM)
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      lhsVarType = tiraParsedArgType
      lhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = tiraParseExpressionId(toIdx + 1, exprEnd, ALIM)
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      rhsVarType = tiraParsedArgType
      rhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      skipLblIdx = tiraLabelCreateNewId&("SKIP_CASE")
      tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, hiddenVarIdx, lhsVarType, lhsVarVal, skipLblIdx

      ff = resolveSymbol(bodyLbl$)
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bodyLblIdx = returnedData2
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, hiddenVarIdx, rhsVarType, rhsVarVal, bodyLblIdx
      tiraLabelId skipLblIdx

    ELSE
      '''' Case relational / equals

      opType = 0 ' 0 =, 1 <, 2 >, 3 <=, 4 >=, 5 <>
      relStart = exprStart

      IF relStart <= exprEnd THEN
        IF lineTokenVals(relStart) = 0 THEN
          IF UCASE$(lineTokens$(relStart)) = "IS" THEN
            relStart = relStart + 1
          END IF
        END IF
      END IF

      IF relStart <= exprEnd THEN
        tVal = lineTokenVals(relStart)

        SELECT CASE tVal

          CASE TOK_OP_EQUAL
            opType = 0
            relStart = relStart + 1

          CASE TOK_OP_LESS
            IF relStart + 1 <= exprEnd THEN
              nxtVal = lineTokenVals(relStart + 1)
              SELECT CASE nxtVal

                CASE TOK_OP_EQUAL
                  opType = 3
                  relStart = relStart + 2

                CASE TOK_OP_GREATER
                  opType = 5
                  relStart = relStart + 2

                CASE ELSE
                  opType = 1
                  relStart = relStart + 1

              END SELECT ' nxtVal

            ELSE
              opType = 1
              relStart = relStart + 1
            END IF

          CASE TOK_OP_GREATER
            IF relStart + 1 <= exprEnd THEN
              nxtVal = lineTokenVals(relStart + 1)
              IF nxtVal = TOK_OP_EQUAL THEN
                opType = 4
                relStart = relStart + 2
              ELSE
                opType = 2
                relStart = relStart + 1
              END IF
            ELSE
              opType = 2
              relStart = relStart + 1
            END IF

        END SELECT ' tVal

      END IF

      ff = tiraParseExpressionId(relStart, exprEnd, ALIM)
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      rhsVarType = tiraParsedArgType
      rhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      condConst = JCC_JE

      SELECT CASE opType

        CASE 0: condConst = JCC_JE
        CASE 1: condConst = JCC_JL
        CASE 2: condConst = JCC_JG
        CASE 3: condConst = JCC_JLE
        CASE 4: condConst = JCC_JGE
        CASE 5: condConst = JCC_JNE

      END SELECT ' opType

      ff = resolveSymbol(bodyLbl$)
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bodyLblIdx = returnedData2
      tiraJmpCondId condConst, TIRA_ARG_SYMBOL, hiddenVarIdx, rhsVarType, rhsVarVal, bodyLblIdx

    END IF

    exprStart = exprEnd + 2
  LOOP

  ' If not equal to any of the above comma-separated checks, skip to the next CASE
  tiraScheduleHeapResetId

  ff = resolveSymbol(nextCaseLbl$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  nextCaseLblIdx = returnedData2
  tiraJmpId nextCaseLblIdx

  ' Anchor the body execution block here for matches
  ff = resolveSymbol(bodyLbl$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bodyLblIdx = returnedData2
  tiraLabelId bodyLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  ctrls(ctrlCount - 1).SelectCaseSeen = caseID + 1

  parse_CASE = SUCCESS

END FUNCTION ' parse_CASE

''''''''''''''''''''''''
FUNCTION parse_COPYIMAGE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM comma1 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcVarIdx AS LONG
  DIM skipZeroLblIdx AS LONG
  DIM resVarIdx AS LONG
  DIM destPageIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_COPYIMAGE", 3) = 0 THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntId(startIdx + 2, comma1 - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(comma1 + 1, endIdx - 1, allowImplicit, "MODE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
  ELSE
    ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "HANDLE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_COPYIMAGE$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal
  END IF

  scratchIdx = tiraResolveHoistVarId&("CPYIMG", "_VAL")
  IF scratchIdx = 0 THEN
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' If the provided handle is 0, QB64 specifies that it copies the current destination screen
  srcVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId srcVarIdx, arg1Type, arg1Val
  skipZeroLblIdx = tiraLabelCreateNewId&("CPYIMG_SKIP_ZERO")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, srcVarIdx, TIRA_ARG_LITERAL, 0, skipZeroLblIdx

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF
  destPageIdx = returnedData2

  tiraAssignId srcVarIdx, TIRA_ARG_SYMBOL, destPageIdx
  tiraLabelId skipZeroLblIdx

  ' In the current architecture, DEST and PUTIMAGE strictly branch
  ' on handles 0, 1, 2, and 3. Similar to _NEWIMAGE, we map _COPYIMAGE directly
  ' to PAGE3 (3) and leverage the existing RT_PCOPY runtime helper to duplicate
  ' the source surface perfectly without requiring dynamic heap allocations.
  ff = resolveSymbol("RT_PCOPY")
  IF ff = 0 THEN
    tira_Cancel
    parse_COPYIMAGE$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, srcVarIdx, TIRA_ARG_LITERAL, 3

  ' Return the new hardware surface handle
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 3

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_COPYIMAGE$ = scratchName$

END FUNCTION ' parse_COPYIMAGE$

''''''''''''''''''''''''
FUNCTION parse_CHR$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "CHR$", 3) = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "CHR$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("CHR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
  IF compileError = 1 THEN
    tira_Cancel
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF

  ' Write the payload character to the heap natively
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1

  ' Build the String Descriptor directly on the Scratchpad memory
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  ' Ensure Flags are set to 0 (No Free Required on Temp Heap)
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CHR$ = scratchName$

END FUNCTION ' parse_CHR$

''''''''''''''''''''''''
FUNCTION parse_CIRCLE (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM hasArc AS LONG
  DIM hasAspect AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM comma5 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM rEnd AS LONG
  DIM colEnd AS LONG
  DIM radStart AS LONG
  DIM radEnd AS LONG
  DIM aspStart AS LONG
  DIM aspEnd AS LONG
  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM radVarType AS LONG
  DIM radVarVal AS _INTEGER64
  DIM colVarType AS LONG
  DIM colVarVal AS _INTEGER64
  DIM tmpVarType AS LONG
  DIM tmpVarVal AS _INTEGER64
  DIM startVarIdx AS LONG
  DIM endVarIdx AS LONG
  DIM aspectVarIdx AS LONG
  DIM startLiteralIdx AS LONG
  DIM endLiteralIdx AS LONG
  DIM aspectLiteralIdx AS LONG
  DIM stepXIdx AS LONG
  DIM stepYIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM circleFuncIdx AS LONG
  DIM circleChainIdx AS LONG
  DIM circleStateReadyLblIdx AS LONG
  DIM circleNoForceLblIdx AS LONG
  DIM circleWarmupState AS LONG
  DIM displayPendingIdx AS LONG
  DIM displayTimerIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM forceTickIdx AS LONG
  DIM circleWarmup AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "CIRCLE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  hasStep = 0
  IF lineTokenVals(tokIdx) = TOK_STEP THEN
    hasStep = 1
    tokIdx = tokIdx + 1
    IF tokIdx > endIdx THEN
      throwCompilerError "EXPECTED ( AFTER STEP", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF lineTokenVals(tokIdx) <> TOK_OP_LPAREN THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  comma3 = 0
  comma4 = 0
  comma5 = 0

  IF comma1 > 0 THEN comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 > 0 THEN comma3 = findComma(comma2 + 1, endIdx)
  IF comma3 > 0 THEN comma4 = findComma(comma3 + 1, endIdx)
  IF comma4 > 0 THEN comma5 = findComma(comma4 + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(tokIdx, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "CIRCLE MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_FG")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  foregroundIdx = returnedData2

  ff = tiraParseExpressionIntId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  IF hasStep = 1 THEN
    stepXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, stepXIdx, xVarType, xVarVal, TIRA_ARG_SYMBOL, currentXIdx
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = stepXIdx

    stepYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, stepYIdx, yVarType, yVarVal, TIRA_ARG_SYMBOL, currentYIdx
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = stepYIdx
  END IF

  rEnd = endIdx
  IF comma2 > 0 THEN rEnd = comma2 - 1

  IF comma1 + 1 > rEnd THEN
    throwCompilerErrorAndCancelTira "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntId(comma1 + 1, rEnd, ALIM, "RADIUS MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  radVarType = tiraParsedArgType
  radVarVal = tiraParsedArgVal

  IF comma2 > 0 THEN
    colEnd = endIdx
    IF comma3 > 0 THEN colEnd = comma3 - 1
    IF comma2 + 1 > colEnd THEN
      colVarType = TIRA_ARG_SYMBOL
      colVarVal = foregroundIdx
    ELSE
      ff = tiraParseExpressionIntId(comma2 + 1, colEnd, ALIM, "COLOR MUST BE NUMERIC")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      colVarType = tiraParsedArgType
      colVarVal = tiraParsedArgVal
    END IF
  ELSE
    colVarType = TIRA_ARG_SYMBOL
    colVarVal = foregroundIdx
  END IF

  startVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  startLiteralIdx = tiraDoubleLiteralId&(0#)
  IF startLiteralIdx = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraAssignId startVarIdx, TIRA_ARG_SYMBOL, startLiteralIdx

  endVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  endLiteralIdx = tiraDoubleLiteralId&(6.283185307179586#)
  IF endLiteralIdx = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraAssignId endVarIdx, TIRA_ARG_SYMBOL, endLiteralIdx

  aspectVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  aspectLiteralIdx = tiraDoubleLiteralId&(1#)
  IF aspectLiteralIdx = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tiraAssignId aspectVarIdx, TIRA_ARG_SYMBOL, aspectLiteralIdx

  hasArc = 0
  hasAspect = 0

  IF comma3 > 0 THEN
    radStart = comma3 + 1
    radEnd = endIdx
    IF comma4 > 0 THEN radEnd = comma4 - 1
    IF radStart <= radEnd THEN
      ff = tiraParseExpressionNumericId(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tmpVarType = tiraParsedArgType
      tmpVarVal = tiraParsedArgVal
      tiraAssignId startVarIdx, tmpVarType, tmpVarVal
      hasArc = 1
    END IF
  END IF

  IF comma4 > 0 THEN
    radStart = comma4 + 1
    radEnd = endIdx
    IF comma5 > 0 THEN radEnd = comma5 - 1
    IF radStart <= radEnd THEN
      ff = tiraParseExpressionNumericId(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tmpVarType = tiraParsedArgType
      tmpVarVal = tiraParsedArgVal
      tiraAssignId endVarIdx, tmpVarType, tmpVarVal
      hasArc = 1
    END IF
  END IF

  IF comma5 > 0 THEN
    aspStart = comma5 + 1
    aspEnd = endIdx
    IF aspStart <= aspEnd THEN
      ff = tiraParseExpressionNumericId(aspStart, aspEnd, ALIM, "ASPECT MUST BE NUMERIC")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tmpVarType = tiraParsedArgType
      tmpVarVal = tiraParsedArgVal
      tiraAssignId aspectVarIdx, tmpVarType, tmpVarVal
      hasAspect = 1
    END IF
  END IF

  IF compileScreenMode > 0 AND hasArc = 0 THEN
    ' Bit zero marks pending pixels and the remaining bits count consecutive full circles
    ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    displayPendingIdx = returnedData2

    circleChainIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_LITERAL, -2

    ' Ordinary full circles keep immediate presentation while explicit-aspect constructions get a warmup
    circleWarmup = 1
    IF hasAspect = 1 THEN
      circleWarmup = 16
      IF gfxConfig.SizeX >= 640 THEN circleWarmup = 32
    END IF
    circleWarmupState = circleWarmup * 2

    circleStateReadyLblIdx = tiraLabelCreateNewId&("CIRCLE_STATE_READY")
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_LITERAL, circleWarmupState, circleStateReadyLblIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_LITERAL, 2
    tiraLabelId circleStateReadyLblIdx
  END IF

  ff = resolveSymbol("RT_CIRCLE")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  circleFuncIdx = returnedData2

  tiraCallId9 circleFuncIdx, xVarType, xVarVal, yVarType, yVarVal, radVarType, radVarVal, colVarType, colVarVal, TIRA_ARG_SYMBOL, startVarIdx, TIRA_ARG_SYMBOL, endVarIdx, TIRA_ARG_LITERAL, hasArc, TIRA_ARG_SYMBOL, aspectVarIdx, TIRA_ARG_LITERAL, hasAspect

  ' Update graphics tracking coordinates
  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  IF compileScreenMode > 0 AND hasArc = 0 THEN
    circleNoForceLblIdx = tiraLabelCreateNewId&("CIRCLE_NO_FORCE")
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_LITERAL, circleWarmupState, circleNoForceLblIdx
    tiraAssignId circleChainIdx, TIRA_ARG_LITERAL, circleWarmupState

    ' A sustained circle animation retains the faster-than-60 Hz redraw path after construction settles
    ff = resolveSymbol("IAT_GETTICKCOUNT")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getTickCountIdx = returnedData2
    tiraCallId0 getTickCountIdx

    forceTickIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId forceTickIdx

    ff = resolveSymbol("!G_GFX_VAL_DISPLAYI_TIMER")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    displayTimerIdx = returnedData2
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, displayTimerIdx, TIRA_ARG_SYMBOL, forceTickIdx, TIRA_ARG_LITERAL, 16

    tiraLabelId circleNoForceLblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_SYMBOL, circleChainIdx, TIRA_ARG_LITERAL, 1
    tiraInjectPendingDisplayFlushId
  ELSE
    tiraTriggerAutoDisplayId
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CIRCLE = SUCCESS

END FUNCTION ' parse_CIRCLE

''''''''''''''''''''''''
FUNCTION parse_CLS (startIdx)

  DIM endIdx AS LONG
  DIM hasArg AS LONG
  DIM argIsLiteral AS LONG
  DIM argFirst AS STRING * 1
  DIM textRowHeight AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM argDataType AS LONG
  DIM intArgType AS LONG
  DIM intArgVal AS _INTEGER64
  DIM clsType AS LONG
  DIM clsVal AS _INTEGER64
  DIM literalStartIdx AS LONG
  DIM literalEndIdx AS LONG
  DIM clsScratchIdx AS LONG
  DIM inoViewTopIdx AS LONG
  DIM inoViewBotIdx AS LONG
  DIM gfxViewX2Idx AS LONG
  DIM gfxViewX1Idx AS LONG
  DIM gfxViewY2Idx AS LONG
  DIM gfxViewY1Idx AS LONG
  DIM gfxCurXIdx AS LONG
  DIM gfxCurYIdx AS LONG
  DIM inoTextXIdx AS LONG
  DIM inoTextYIdx AS LONG
  DIM gfxDestFrameIdx AS LONG
  DIM gfxDestCountIdx AS LONG
  DIM gfxLastBgIdx AS LONG
  DIM gfxFontHeightIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM setCursorPosIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM topVarIdx AS LONG
  DIM botVarIdx AS LONG
  DIM cursorTopVarIdx AS LONG
  DIM linesVarIdx AS LONG
  DIM strDescIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM coordIdx AS LONG
  DIM coordResetIdx AS LONG
  DIM viewWidthIdx AS LONG
  DIM viewRowsIdx AS LONG
  DIM viewStartOffsetIdx AS LONG
  DIM fbPtrIdx AS LONG
  DIM textTopIdx AS LONG
  DIM textBotIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM textBottomLimitIdx AS LONG
  DIM textRowsIdx AS LONG
  DIM textStartOffsetIdx AS LONG
  DIM textFbPtrIdx AS LONG
  DIM textClearSizeIdx AS LONG
  DIM validArgLblIdx AS LONG
  DIM currentViewLblIdx AS LONG
  DIM fullViewLblIdx AS LONG
  DIM boundsReadyLblIdx AS LONG
  DIM consoleBotOkLblIdx AS LONG
  DIM noLinesLblIdx AS LONG
  DIM loopLblIdx AS LONG
  DIM clearFullFbIdx AS LONG
  DIM clearViewFbIdx AS LONG
  DIM clearTextFbIdx AS LONG
  DIM clearFbDoneIdx AS LONG
  DIM clearViewRowIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM lastTextRowLblIdx AS LONG
  DIM noTextRowsLblIdx AS LONG

  endIdx = lineTokenCount - 1

  hasArg = 0
  argType = TIRA_ARG_LITERAL
  argVal = 0

  tira_Start

  ' Check if there is an argument provided for CLS
  IF endIdx > startIdx THEN
    hasArg = 1
    ff = tiraParseExpressionNumericId(startIdx + 1, endIdx, ALIM, "CLS REQUIRES NUMERIC ARGUMENT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    argType = tiraParsedArgType
    argVal = tiraParsedArgVal
    argDataType = exprIs.DataType

    literalStartIdx = startIdx + 1
    literalEndIdx = endIdx
    DO WHILE literalStartIdx < literalEndIdx
      IF lineTokenVals(literalStartIdx) = TOK_OP_LPAREN THEN
        ff = findMatchingParen(literalStartIdx, literalEndIdx)
        IF ff = 1 THEN
          IF returnedData2 = literalEndIdx THEN
            literalStartIdx = literalStartIdx + 1
            literalEndIdx = literalEndIdx - 1
          ELSE
            EXIT DO
          END IF
        ELSE
          EXIT DO
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    argIsLiteral = 0
    IF literalStartIdx = literalEndIdx THEN
      IF lineTokenVals(literalStartIdx) = 0 THEN
        literalText$ = lineTokens$(literalStartIdx)
        argFirst = LEFT$(literalText$, 1)
        IF (argFirst >= "0" AND argFirst <= "9") OR argFirst = "-" OR argFirst = "." OR argFirst = "&" THEN
          argIsLiteral = 1
        END IF
      END IF
    END IF

    intArgType = argType
    intArgVal = argVal
    IF argIsLiteral = 1 THEN
      IF INSTR(literalText$, ".") > 0 THEN
        intArgType = TIRA_ARG_LITERAL
        intArgVal = INT(VAL(literalText$))
      END IF
    ELSE
      tiraForceIntId argType, argVal, argDataType
      intArgType = tiraParsedArgType
      intArgVal = tiraParsedArgVal
    END IF

    IF cm.ClassicMode = 0 THEN
      IF argIsLiteral = 1 THEN
        IF VAL(literalText$) <> 0 THEN
          throwCompilerErrorAndCancelTira "ONLY CLS 0 SUPPORTED OUTSIDE OF CLASSIC MODE", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF

      validArgLblIdx = tiraLabelCreateNewId&("CLS_ARG_VALID")
      tiraJmpCondId JCC_JE, argType, argVal, TIRA_ARG_LITERAL, 0, validArgLblIdx
      tiraFatalErrorId "ONLY CLS 0 SUPPORTED OUTSIDE OF CLASSIC MODE"
      tiraLabelId validArgLblIdx
    ELSE
      IF argIsLiteral = 1 THEN
        IF VAL(literalText$) <> 0 AND VAL(literalText$) <> 1 AND VAL(literalText$) <> 2 THEN
          throwCompilerErrorAndCancelTira "CLS ARGUMENT MUST BE 0, 1, OR 2", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF

      validArgLblIdx = tiraLabelCreateNewId&("CLS_ARG_VALID")
      tiraJmpCondId JCC_JE, argType, argVal, TIRA_ARG_LITERAL, 0, validArgLblIdx
      tiraJmpCondId JCC_JE, argType, argVal, TIRA_ARG_LITERAL, 1, validArgLblIdx
      tiraJmpCondId JCC_JE, argType, argVal, TIRA_ARG_LITERAL, 2, validArgLblIdx
      tiraFatalErrorId "CLS ARGUMENT MUST BE 0, 1, OR 2"
      tiraLabelId validArgLblIdx
    END IF
  END IF

  ' Handle standard console clearing
  IF cm.HasGraphics = 0 THEN
    ' Get the symbol index for the pre-built clear screen string
    ff = resolveSymbol("!G_INO_DSC_CLSSCR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    clsScratchIdx = returnedData2
    ' Fill the clear screen string with spaces and a newline
    strVarData$(clsScratchIdx) = STRING$(120, 32) + CHR$(13) + CHR$(10)

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoViewTopIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoViewBotIdx = returnedData2

    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setCursorPosIdx = returnedData2

    ff = resolveSymbol("IAT_WRITEFILE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    writeFileIdx = returnedData2

    ' Create a temporary variable to hold the console output handle
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ' Call Windows API to get the standard output handle
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
    ' Retrieve the returned handle into the temp variable
    tiraGetRetId hndVarIdx

    ' Create a variable for the starting row
    topVarIdx = tiraDimVarId&("T", TYPE_LONG)
    ' Create a variable for the bottom row
    botVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ' Create a variable for the cursor row used after clearing
    cursorTopVarIdx = tiraDimVarId&("T", TYPE_LONG)

    IF hasArg = 1 THEN
      currentViewLblIdx = tiraLabelCreateNewId&("CLS_CURRENT_VIEW")
      fullViewLblIdx = tiraLabelCreateNewId&("CLS_FULL_VIEW")
      boundsReadyLblIdx = tiraLabelCreateNewId&("CLS_BOUNDS_READY")

      tiraJmpCondId JCC_JE, intArgType, intArgVal, TIRA_ARG_LITERAL, 0, fullViewLblIdx
      tiraJmpCondId JCC_JE, intArgType, intArgVal, TIRA_ARG_LITERAL, 1, fullViewLblIdx
      tiraJmpId currentViewLblIdx

      tiraLabelId fullViewLblIdx
      tiraAssignId topVarIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId botVarIdx, TIRA_ARG_LITERAL, 25
      tiraAssignId cursorTopVarIdx, TIRA_ARG_LITERAL, 0
      tiraJmpId boundsReadyLblIdx

      tiraLabelId currentViewLblIdx
      tiraAssignId topVarIdx, TIRA_ARG_SYMBOL, inoViewTopIdx
      tiraAssignId botVarIdx, TIRA_ARG_SYMBOL, inoViewBotIdx
      tiraAssignId cursorTopVarIdx, TIRA_ARG_SYMBOL, inoViewTopIdx

      ' CLS two preserves the last physical console row
      consoleBotOkLblIdx = tiraLabelCreateNewId&("CLS_CONSOLE_BOT_OK")
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, botVarIdx, TIRA_ARG_LITERAL, 24, consoleBotOkLblIdx
      tiraAssignId botVarIdx, TIRA_ARG_LITERAL, 24
      tiraLabelId consoleBotOkLblIdx

      tiraLabelId boundsReadyLblIdx
    ELSE
      ' Load the bounds of the current text viewport
      tiraAssignId topVarIdx, TIRA_ARG_SYMBOL, inoViewTopIdx
      tiraAssignId botVarIdx, TIRA_ARG_SYMBOL, inoViewBotIdx
      tiraAssignId cursorTopVarIdx, TIRA_ARG_SYMBOL, inoViewTopIdx
    END IF

    ' Create a variable for the total lines to clear
    linesVarIdx = tiraDimVarId&("T", TYPE_LONG)
    ' Calculate total lines by subtracting top from bottom
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, linesVarIdx, TIRA_ARG_SYMBOL, botVarIdx, TIRA_ARG_SYMBOL, topVarIdx

    noLinesLblIdx = tiraLabelCreateNewId&("CLS_NO_LINES")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, linesVarIdx, TIRA_ARG_LITERAL, 0, noLinesLblIdx

    ' Create a variable for the string descriptor pointer
    strDescIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ' Assign the value of the clear screen string to the descriptor pointer
    tiraAssignId strDescIdx, TIRA_ARG_SYMBOL, clsScratchIdx

    ' Create a variable for the string data pointer
    strDataIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ' Read the memory address of the string data from the descriptor
    tiraReadMemId strDataIdx, TIRA_ARG_SYMBOL, strDescIdx

    ' Create a variable for the string length
    strLenIdx = tiraDimVarId&("T", TYPE_LONG)
    ' Advance the descriptor pointer by eight bytes to point to the length
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, strDescIdx, TIRA_ARG_SYMBOL, strDescIdx, TIRA_ARG_LITERAL, 8
    ' Read the length from the descriptor memory
    tiraReadMemId strLenIdx, TIRA_ARG_SYMBOL, strDescIdx

    ' Create a variable for the bytes written pointer used by WriteFile
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Create a new jump label for the clearing loop
    loopLblIdx = tiraLabelCreateNewId&("CLS_LOOP")
    ' Place the loop label in the TIRA queue
    tiraLabelId loopLblIdx

    ' Create a variable for the Windows API COORD structure
    coordIdx = tiraDimVarId&("T", TYPE_LONG)
    ' Shift the Y coordinate to the high word to format the COORD value
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, coordIdx, TIRA_ARG_SYMBOL, topVarIdx, TIRA_ARG_LITERAL, 65536

    ' Move the console cursor to the current row
    tiraCallId2 setCursorPosIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, coordIdx
    ' Write the blank spaces to the row
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0

    ' Increment the current row variable
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, topVarIdx, TIRA_ARG_SYMBOL, topVarIdx, TIRA_ARG_LITERAL, 1
    ' Decrement the remaining lines counter
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, linesVarIdx, TIRA_ARG_SYMBOL, linesVarIdx, TIRA_ARG_LITERAL, 1
    ' Jump back to the top of the loop if lines remain
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, linesVarIdx, TIRA_ARG_LITERAL, 0, loopLblIdx

    tiraLabelId noLinesLblIdx

    ' Calculate the reset coordinate for the top-left of the viewport
    coordResetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, coordResetIdx, TIRA_ARG_SYMBOL, cursorTopVarIdx, TIRA_ARG_LITERAL, 65536

    ' Reset the cursor to the top left of the active viewport when finished
    tiraCallId2 setCursorPosIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, coordResetIdx

  ELSE
    ' Handle graphics window clearing
    ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewX2Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewX1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewY2Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewY1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_CUR_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxCurXIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxCurYIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoTextXIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoTextYIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxDestFrameIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxDestCountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxLastBgIdx = returnedData2

    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxFontHeightIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoViewTopIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    inoViewBotIdx = returnedData2

    ' Default to using the parsed argument for the clear type
    clsType = TIRA_ARG_LITERAL
    clsVal = 1
    ' With no argument QuickBASIC clears the active graphics viewport
    IF hasArg = 1 THEN
      clsType = intArgType
      clsVal = intArgVal
    END IF

    clearFullFbIdx = tiraLabelCreateNewId&("CLS_FULL_FB")
    clearViewFbIdx = tiraLabelCreateNewId&("CLS_VIEW_FB")
    clearTextFbIdx = tiraLabelCreateNewId&("CLS_TEXT_FB")
    clearFbDoneIdx = tiraLabelCreateNewId&("CLS_FB_DONE")

    tiraJmpCondId JCC_JE, clsType, clsVal, TIRA_ARG_LITERAL, 0, clearFullFbIdx
    tiraJmpCondId JCC_JE, clsType, clsVal, TIRA_ARG_LITERAL, 1, clearViewFbIdx
    tiraJmpId clearTextFbIdx

    ' CLS one clears only the active graphics viewport
    tiraLabelId clearViewFbIdx

    viewWidthIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, viewWidthIdx, TIRA_ARG_SYMBOL, gfxViewX2Idx, TIRA_ARG_SYMBOL, gfxViewX1Idx

    viewRowsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, viewRowsIdx, TIRA_ARG_SYMBOL, gfxViewY2Idx, TIRA_ARG_SYMBOL, gfxViewY1Idx

    tiraAssignId gfxCurXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId gfxCurYIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId inoTextXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId inoTextYIdx, TIRA_ARG_LITERAL, 0

    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, viewWidthIdx, TIRA_ARG_LITERAL, 0, clearFbDoneIdx
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, viewRowsIdx, TIRA_ARG_LITERAL, 0, clearFbDoneIdx

    viewStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, gfxViewY1Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, gfxViewX1Idx

    fbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbPtrIdx, TIRA_ARG_SYMBOL, gfxDestFrameIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx

    clearViewRowIdx = tiraLabelCreateNewId&("CLS_VIEW_ROW")
    tiraLabelId clearViewRowIdx
    tiraMemSetId TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_SYMBOL, gfxLastBgIdx, TIRA_ARG_SYMBOL, viewWidthIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, viewRowsIdx, TIRA_ARG_SYMBOL, viewRowsIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, viewRowsIdx, TIRA_ARG_LITERAL, 0, clearViewRowIdx
    tiraJmpId clearFbDoneIdx

    ' CLS zero clears the complete graphics screen regardless of VIEW PRINT
    tiraLabelId clearFullFbIdx
    fbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbPtrIdx, TIRA_ARG_SYMBOL, gfxDestFrameIdx
    tiraMemSetId TIRA_ARG_SYMBOL, fbPtrIdx, TIRA_ARG_SYMBOL, gfxLastBgIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

    tiraAssignId gfxCurXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId gfxCurYIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId inoTextXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId inoTextYIdx, TIRA_ARG_LITERAL, 0
    tiraWriteMemId TIRA_ARG_SYMBOL, gfxDestCountIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 4
    tiraJmpId clearFbDoneIdx

    ' CLS two clears the framebuffer rows occupied by the active text viewport
    tiraLabelId clearTextFbIdx

    textTopIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId textTopIdx, TIRA_ARG_SYMBOL, inoViewTopIdx

    textBotIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId textBotIdx, TIRA_ARG_SYMBOL, inoViewBotIdx

    textRowHeight = 8
    IF cm.ClassicMode = 1 THEN
      SELECT CASE compileScreenMode

        CASE 9, 10
          textRowHeight = 14

        CASE 11, 12
          textRowHeight = 16

      END SELECT ' compileScreenMode
    END IF

    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, gfxFontHeightIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("CLS_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx

    ' QuickBASIC reserves the last physical text row when processing CLS two
    textBottomLimitIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId textBottomLimitIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textBottomLimitIdx, TIRA_ARG_SYMBOL, textBottomLimitIdx, TIRA_ARG_SYMBOL, fontHeightIdx

    lastTextRowLblIdx = tiraLabelCreateNewId&("CLS_LAST_TEXT_ROW")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textBotIdx, TIRA_ARG_SYMBOL, textBottomLimitIdx, lastTextRowLblIdx
    tiraAssignId textBotIdx, TIRA_ARG_SYMBOL, textBottomLimitIdx
    tiraLabelId lastTextRowLblIdx

    textRowsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textRowsIdx, TIRA_ARG_SYMBOL, textBotIdx, TIRA_ARG_SYMBOL, textTopIdx

    noTextRowsLblIdx = tiraLabelCreateNewId&("CLS_NO_TEXT_ROWS")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textRowsIdx, TIRA_ARG_LITERAL, 0, noTextRowsLblIdx

    textStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, textStartOffsetIdx, TIRA_ARG_SYMBOL, textTopIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    textFbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId textFbPtrIdx, TIRA_ARG_SYMBOL, gfxDestFrameIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textFbPtrIdx, TIRA_ARG_SYMBOL, textFbPtrIdx, TIRA_ARG_SYMBOL, textStartOffsetIdx

    textClearSizeIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, textClearSizeIdx, TIRA_ARG_SYMBOL, textRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraMemSetId TIRA_ARG_SYMBOL, textFbPtrIdx, TIRA_ARG_SYMBOL, gfxLastBgIdx, TIRA_ARG_SYMBOL, textClearSizeIdx

    tiraLabelId noTextRowsLblIdx

    tiraAssignId gfxCurXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId gfxCurYIdx, TIRA_ARG_SYMBOL, textTopIdx
    tiraAssignId inoTextXIdx, TIRA_ARG_LITERAL, 0
    tiraAssignId inoTextYIdx, TIRA_ARG_SYMBOL, textTopIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, gfxDestCountIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 4

    tiraLabelId clearFbDoneIdx

    tiraTriggerAutoDisplayId
  END IF

  tiraScheduleHeapResetId
  ' Compile the queued TIRA commands into machine code
  tira_EndAndProcess

  parse_CLS = 1

END FUNCTION ' parse_CLS

''''''''''''''''''''''''
FUNCTION parse_DELAY (startIdx)

  parse_DELAY = parse_DELAY_Core(startIdx, 0)

END FUNCTION ' parse_DELAY

''''''''''''''''''''''''
FUNCTION parse_DIM (startIdx)

  parse_DIM = parse_DIM_Core(startIdx, 0)

END FUNCTION ' parse_DIM

''''''''''''''''''''''''
FUNCTION parse_DIM_Core (startIdx, isStaticVar AS LONG)

  ' Reallocates memory for a dynamic array with new dimensions

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isShared AS LONG
  DIM isArray AS LONG
  DIM parenStart AS LONG
  DIM parenEnd AS LONG
  DIM commaIdx AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM evalStart AS LONG
  DIM isNum AS LONG
  DIM vIdx AS LONG
  DIM fixedLen AS LONG
  DIM dtMapped AS LONG
  DIM elemSize AS LONG
  DIM actualName$
  DIM typeData AS LONG

  DIM dynDimTotalVars(255) AS LONG
  DIM dynDimLBoundVars(255) AS LONG
  DIM numDims AS LONG
  DIM isNumArray AS LONG
  DIM totalStaticElems AS _INTEGER64
  DIM staticStride AS _INTEGER64
  DIM staticLayoutStart AS LONG
  DIM dimEnd AS LONG
  DIM tokParseIdx AS LONG
  DIM elementCount AS LONG
  DIM parsedLBoundType AS LONG
  DIM parsedLBoundVal AS _INTEGER64
  DIM lBoundVarIdx AS LONG
  DIM dynAxType AS LONG
  DIM dynAxVal AS _INTEGER64
  DIM numElemsVarIdx AS LONG
  DIM numElems64Idx AS LONG
  DIM lBoundTok$

  DIM prevIsExplicit AS LONG
  DIM prevDataType AS LONG
  DIM prevUDTIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM tokText$
  DIM firstCh$

  DIM dimOkLblIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM totalElemsIdx AS LONG
  DIM numDimsVarIdx AS LONG
  DIM prevTotalIdx AS LONG
  DIM checkDivIdx AS LONG
  DIM multOkLblIdx AS LONG
  DIM elemSizeVarIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM allocOkLblIdx AS LONG
  DIM checkAllocDivIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM arrPtrIdx AS LONG
  DIM skipOkLblIdx AS LONG
  DIM elemSizeDWordIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  isShared = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_SHARED THEN
      isShared = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  IF endIdx < tokIdx THEN
    IF isStaticVar = 1 THEN
      throwCompilerError "MALFORMED STATIC", ASIS, 0
    ELSE
      throwCompilerError "MALFORMED DIM", ASIS, 0
    END IF
    EXIT FUNCTION
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    aTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED IDENTIFIER", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1
    isArray = ARRAY_TYPE_NONE
    numDims = 0
    totalStaticElems = 1
    isNumArray = 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        isArray = ARRAY_TYPE_STATIC
        parenStart = tokIdx

        ff = findMatchingParen(parenStart, endIdx)
        IF ff = 0 THEN
          throwCompilerErrorAndCancelTira "MALFORMED ARRAY DIMENSION", ASIS, 0
          EXIT FUNCTION
        END IF
        parenEnd = returnedData2

        tokParseIdx = parenStart + 1
        DO
          commaIdx = findComma(tokParseIdx, parenEnd - 1)
          IF commaIdx > 0 THEN
            dimEnd = commaIdx - 1
          ELSE
            dimEnd = parenEnd - 1
          END IF

          numDims = numDims + 1
          IF numDims > 255 THEN
            throwCompilerErrorAndCancelTira "TOO MANY DIMENSIONS", ASIS, 0
            EXIT FUNCTION
          END IF

          hasTo = 0
          toIdx = 0
          ff = findNextTokenAtDepth0(tokParseIdx, dimEnd, TOK_TO)
          IF ff = 1 THEN
            hasTo = 1
            toIdx = returnedData2
          END IF

          lBoundVarIdx = tiraDimVarId&("T", TYPE_LONG)
          IF hasTo = 1 THEN
            ff = tiraParseExpressionIntId(tokParseIdx, toIdx - 1, ALIM, "ARRAY DIM MUST BE NUMERIC")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            parsedLBoundType = tiraParsedArgType
            parsedLBoundVal = tiraParsedArgVal
            tiraAssignId lBoundVarIdx, parsedLBoundType, parsedLBoundVal
          ELSE
            tiraAssignId lBoundVarIdx, TIRA_ARG_LITERAL, optionBaseValue
          END IF

          evalStart = tokParseIdx
          IF hasTo = 1 THEN evalStart = toIdx + 1

          ff = tiraParseExpressionIntId(evalStart, dimEnd, ALIM, "ARRAY DIM MUST BE NUMERIC")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          dynAxType = tiraParsedArgType
          dynAxVal = tiraParsedArgVal

          numElemsVarIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, numElemsVarIdx, dynAxType, dynAxVal, TIRA_ARG_SYMBOL, lBoundVarIdx
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_LITERAL, 1

          numElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, numElems64Idx, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

          dimOkLblIdx = tiraLabelCreateNewId&("DIM_OK")
          tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, numElems64Idx, TIRA_ARG_LITERAL, 0, dimOkLblIdx
          tiraFatalErrorId "INVALID ARRAY DIMENSION"
          tiraLabelId dimOkLblIdx

          dynDimLBoundVars(numDims) = lBoundVarIdx
          dynDimTotalVars(numDims) = numElems64Idx

          sizeTok$ = ""
          lBoundTok$ = LTRIM$(STR$(optionBaseValue))
          isNum = 1

          IF hasTo = 1 THEN
            lBoundTok$ = ""
            FOR ii = tokParseIdx TO toIdx - 1
              tokText$ = lineTokens$(ii)
              lBoundTok$ = lBoundTok$ + retTokenText$(tokText$)
              IF lineTokenVals(ii) = 0 THEN
                firstCh$ = LEFT$(tokText$, 1)
                IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                  isNum = 0
                END IF
              END IF
            NEXT
          END IF

          FOR ii = evalStart TO dimEnd
            tokText$ = lineTokens$(ii)
            sizeTok$ = sizeTok$ + retTokenText$(tokText$)
            IF lineTokenVals(ii) = 0 THEN
              firstCh$ = LEFT$(tokText$, 1)
              IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                isNum = 0
              END IF
            END IF
          NEXT

          IF isNum = 1 THEN
            sizeTok$ = evalMathConst$(sizeTok$)
            lBoundTok$ = evalMathConst$(lBoundTok$)

            FOR i2 = 1 TO LEN(sizeTok$)
              chCheck$ = MID$(sizeTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
            FOR i2 = 1 TO LEN(lBoundTok$)
              chCheck$ = MID$(lBoundTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
          END IF

          IF isNum = 0 OR sizeTok$ = "" OR lBoundTok$ = "" THEN
            isNumArray = 0
          ELSE
            elementCount = VAL(sizeTok$) - VAL(lBoundTok$) + 1
            IF elementCount <= 0 THEN
              throwCompilerErrorAndCancelTira "DIMENSION CANNOT BE NEGATIVE OR ZERO", ASIS, 0
              EXIT FUNCTION
            END IF
            staticArrayDimensionScratch(numDims).LowerBound = VAL(lBoundTok$)
            staticArrayDimensionScratch(numDims).ElementCount = elementCount
            totalStaticElems = totalStaticElems * elementCount
          END IF

          IF isNumArray = 0 AND (currentScopeID = 0 OR isShared = 1) THEN
            IF cm.ClassicMode = 0 THEN
              throwCompilerErrorAndCancelTira "GLOBAL ARRAYS MUST HAVE CONSTANT DIMENSIONS", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF

          IF commaIdx > 0 THEN
            tokParseIdx = commaIdx + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF isNumArray = 0 THEN
          totalStaticElems = 0
          isArray = ARRAY_TYPE_RUNTIME
        END IF
        IF defaultArrayDynamic = 1 THEN isArray = ARRAY_TYPE_RUNTIME

        tokIdx = parenEnd + 1
      END IF
    END IF

    vName$ = UCASE$(aTok$)

    IF currentScopeID > 0 THEN
      IF isDummyPass = 1 THEN
        ff = findSymbol(vName$)
        IF ff = 1 THEN
          vIdx = returnedData2
          IF symbols(vIdx).ScopeID = currentScopeID THEN

            IF isCompilingRT = 0 AND cm.ClassicMode = 0 THEN
              IF symbols(vIdx).SubIndex = 0 THEN
                IF isArray > ARRAY_TYPE_NONE AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
                  throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
                  EXIT FUNCTION
                END IF

                IF isArray = ARRAY_TYPE_NONE AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                  throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            SELECT CASE symbols(vIdx).IsExplicit

              CASE DECL_IMPLICIT, DECL_QUIET
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN SUB/FUNC (IMPLICIT)", ASIS, 0
              CASE DECL_EXPLICIT
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN SUB/FUNC (EXPLICIT)", ASIS, 0
              CASE ELSE
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN THIS SUB OR FUNCTION", ASIS, 0

            END SELECT

            EXIT FUNCTION
          ELSE
            IF isShared = 0 THEN
              declaredKind$ = "LOCAL VARIABLE"
              IF isArray > ARRAY_TYPE_NONE THEN declaredKind$ = "LOCAL ARRAY"

              existingKind$ = "GLOBAL VARIABLE"
              IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN existingKind$ = "GLOBAL ARRAY"

              IF symbols(vIdx).SubIndex <> 0 THEN
                IF subs(symbols(vIdx).SubIndex).IsFunction = 1 THEN
                  existingKind$ = "GLOBAL FUNCTION"
                ELSE
                  existingKind$ = "GLOBAL SUB"
                END IF
              END IF

              throwCompilerErrorAndCancelTira declaredKind$ + " " + vName$ + " CLASHES WITH " + existingKind$, ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Dimension expressions must not override the declared variable's implicit DEFINT type
    expectedSymType = TYPE_ANY
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF isArray > ARRAY_TYPE_NONE AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
          EXIT FUNCTION
        END IF

        IF isArray = ARRAY_TYPE_NONE AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    prevIsExplicit = symbols(vIdx).IsExplicit
    prevDataType = symbols(vIdx).DataType
    prevUDTIndex = symbols(vIdx).UDTIndex

    IF isStaticVar = 1 THEN
      symbols(vIdx).IsLocal = LOCAL_GLOBAL
    END IF

    IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
      IF isDummyPass = 1 THEN
        throwCompilerErrorAndCancelTira "ARRAY ALREADY DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    symbols(vIdx).IsArray = isArray
    symbols(vIdx).IsExplicit = DECL_EXPLICIT
    IF isShared = 1 THEN symbols(vIdx).IsShared = 1

    symbols(vIdx).Size = totalStaticElems
    symbols(vIdx).NumDimensions = numDims

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF prevIsExplicit = DECL_EXPLICIT THEN
          IF dtMapped <> prevDataType THEN
            throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
            EXIT FUNCTION
          END IF
          IF dtMapped = TYPE_UDT THEN
            IF typeData <> prevUDTIndex THEN
              throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isArray = ARRAY_TYPE_STATIC AND isNumArray = 1 THEN
      staticLayoutStart = retStaticArrayLayoutStart(vIdx, numDims)

      IF staticLayoutStart > 0 THEN
        staticStride = 1

        FOR iDim = 1 TO numDims
          staticArrayDimensions(staticLayoutStart + iDim - 1).LowerBound = staticArrayDimensionScratch(iDim).LowerBound
          staticArrayDimensions(staticLayoutStart + iDim - 1).ElementCount = staticArrayDimensionScratch(iDim).ElementCount
          staticArrayDimensions(staticLayoutStart + iDim - 1).Stride = staticStride

          IF iDim < numDims THEN staticStride = staticStride * staticArrayDimensionScratch(iDim).ElementCount
        NEXT
      END IF
    ELSE
      staticArrayLayoutStart(vIdx) = 0
    END IF

    IF isArray = ARRAY_TYPE_RUNTIME THEN
      tiraScheduleArrayFreeId vIdx
    END IF

    IF isArray > ARRAY_TYPE_NONE THEN
      elemSize = retElementByteSize(vIdx)

      descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

      totalElemsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId totalElemsIdx, TIRA_ARG_LITERAL, 1

      numDimsVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId numDimsVarIdx, TIRA_ARG_LITERAL, numDims
      tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 12, TIRA_ARG_SYMBOL, numDimsVarIdx, TIRA_ARG_LITERAL, 4

      FOR iDim = 1 TO numDims
        tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8), TIRA_ARG_SYMBOL, dynDimLBoundVars(iDim), TIRA_ARG_LITERAL, 4
        tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim), TIRA_ARG_LITERAL, 4

        prevTotalIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraAssignId prevTotalIdx, TIRA_ARG_SYMBOL, totalElemsIdx

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim)

        checkDivIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, checkDivIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, prevTotalIdx

        multOkLblIdx = tiraLabelCreateNewId&("MULT_OK")
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, checkDivIdx, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim), multOkLblIdx
        tiraFatalErrorId "ARRAY ALLOCATION OVERFLOW"
        tiraLabelId multOkLblIdx
      NEXT iDim

      IF isArray = ARRAY_TYPE_RUNTIME THEN
        elemSizeVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraAssignId elemSizeVarIdx, TIRA_ARG_LITERAL, elemSize

        allocSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, elemSizeVarIdx

        allocOkLblIdx = tiraLabelCreateNewId&("ALLOC_OK")
        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, elemSizeVarIdx, TIRA_ARG_LITERAL, 1, allocOkLblIdx

        checkAllocDivIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, checkAllocDivIdx, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, elemSizeVarIdx

        tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, checkAllocDivIdx, TIRA_ARG_SYMBOL, totalElemsIdx, allocOkLblIdx
        tiraFatalErrorId "ARRAY ALLOCATION OVERFLOW"
        tiraLabelId allocOkLblIdx

        ff = resolveSymbol("IAT_HEAPALLOC")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        heapAllocIdx = returnedData2

        ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        processHeapIdx = returnedData2

        tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_SYMBOL, allocSizeIdx
        arrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraGetRetId arrPtrIdx

        skipOkLblIdx = tiraLabelCreateNewId&("HEAP_OK")
        tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 0, skipOkLblIdx
        tiraFatalErrorId "OUT OF MEMORY ALLOCATING ARRAY"
        tiraLabelId skipOkLblIdx

        tiraWriteMemId TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 8
      ELSE
        arrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_LITERAL, 16 + (numDims * 8)
        tiraWriteMemId TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 8
      END IF

      elemSizeDWordIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId elemSizeDWordIdx, TIRA_ARG_LITERAL, elemSize
      tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 8, TIRA_ARG_SYMBOL, elemSizeDWordIdx, TIRA_ARG_LITERAL, 4
    END IF

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        IF isStaticVar = 1 THEN
          throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER STATIC", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER DIM", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DIM_Core = 1

END FUNCTION ' parse_DIM_Core

''''''''''''''''''''''''
FUNCTION parse_DISPLAY (startIdx)

  parse_DISPLAY = parse_DISPLAY_Core(startIdx, 0)

END FUNCTION ' parse_DISPLAY

''''''''''''''''''''''''
FUNCTION parse_DISPLAYI (startIdx)

  parse_DISPLAYI = parse_DISPLAY_Core(startIdx, 1)

END FUNCTION ' parse_DISPLAYI

''''''''''''''''''''''''
FUNCTION parse_DO (startIdx)

  DIM endIdx AS LONG
  DIM hasCond AS LONG
  DIM tVal AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64

  ' Generate a globally unique ID for this loop structure
  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_DO = 0
    EXIT FUNCTION
  END IF

  topLbl$ = "@DO_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@DO_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  ' Anchor the top of the loop in the TIRA symbol table
  tira_Start

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx

  tira_EndAndProcess

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  endIdx = lineTokenCount - 1

  hasCond = 0

  IF endIdx > startIdx THEN
    tVal = lineTokenVals(startIdx + 1)
    IF tVal = TOK_UNTIL OR tVal = TOK_WHILE THEN
      hasCond = 1
    ELSE
      throwCompilerError "EXPECTED UNTIL OR WHILE", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF hasCond = 1 THEN
    ff = tiraParseExpressionNumericId(startIdx + 2, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    exprVarType = tiraParsedArgType
    exprVarVal = tiraParsedArgVal

    ff = resolveSymbol(doneLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    doneLblIdx = returnedData2

    IF tVal = TOK_UNTIL THEN
      tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    ELSE
      tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_DO
  ctrls(ctrlCount).Patch1 = loopID ' Save the Loop ID for parse_LOOP and parse_EXIT
  ctrls(ctrlCount).Patch2 = 0 ' Unused for loop structures as TIRA labels manage exit jumps
  ctrlCount = ctrlCount + 1

  parse_DO = 1

END FUNCTION ' parse_DO

''''''''''''''''''''''''
FUNCTION parse_DRAW (startIdx)

  DIM endIdx AS LONG
  DIM drawVarType AS LONG
  DIM drawVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG
  DIM savedScopeID AS LONG
  DIM drawRuntimeIdx AS _UNSIGNED LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "DRAW REQUIRES STRING EXPRESSION", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Registers the persistent DRAW state and runtime entry

  savedScopeID = currentScopeID
  currentScopeID = 0

  ff = resolveSymbol("!G_GFX_V32_DRAWANGLE")
  ff = resolveSymbol("!G_GFX_V32_DRAWSCALE")
  ff = resolveSymbol("!G_GFX_FLG_DRAWINIT")

  ff = resolveSymbol("RT_DRAW")
  IF ff = 1 THEN
    drawRuntimeIdx = returnedData2
    symbols(drawRuntimeIdx).ScopeID = 0
    symbols(drawRuntimeIdx).IsLocal = LOCAL_GLOBAL
  END IF

  currentScopeID = savedScopeID

  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  drawVarType = tiraParsedArgType
  drawVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "DRAW REQUIRES STRING EXPRESSION", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol("RT_DRAW")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, drawVarType, drawVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DRAW = 1

END FUNCTION ' parse_DRAW

''''''''''''''''''''''''
FUNCTION parse_END (startIdx)

  DIM endIdx AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG
  DIM endRoutineLblIdx AS LONG
  DIM skipRoutineLblIdx AS LONG
  DIM falseLblIdx AS LONG
  DIM endLblIdx AS LONG
  DIM prevNextLblIdx AS LONG
  DIM endSelLblIdx AS LONG
  DIM exprType AS LONG
  DIM exprVal AS _INTEGER64
  DIM vIdxExit AS LONG
  DIM endProgramLblIdx AS LONG

  endIdx = lineTokenCount - 1

  isBlockEnd = 0
  IF endIdx > startIdx THEN
    tok2 = lineTokenVals(startIdx + 1)
    IF tok2 = TOK_SUB OR tok2 = TOK_FUNCTION THEN isBlockEnd = 1
    IF tok2 = TOK_IF THEN isBlockEnd = 1
    IF tok2 = TOK_SELECT THEN isBlockEnd = 1
  END IF

  IF isBlockEnd = 1 THEN
    tok2 = lineTokenVals(startIdx + 1)
    SELECT CASE tok2

      CASE TOK_SUB, TOK_FUNCTION
        IF tok2 = TOK_SUB AND insideSub <> 1 THEN
          throwCompilerError "END SUB WITHOUT SUB", ASIS, 0
          EXIT FUNCTION
        END IF
        IF tok2 = TOK_FUNCTION AND insideSub <> 2 THEN
          throwCompilerError "FUNCTION END WITHOUT FUNCTION", ASIS, 0
          EXIT FUNCTION
        END IF

        ' Resolve all early EXIT SUB / EXIT FUNCTION jumps to land here via TIRA labels
        tira_Start

        ff = resolveSymbol("@END_ROUTINE_" + currentSubName$)
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        endRoutineLblIdx = returnedData2
        tiraLabelId endRoutineLblIdx

        tiraScheduleGCId

        ' Restore stack alignment, pop ABI non-volatile registers, and return
        tiraScheduleSubEpilogueId

        ' Land the jump over the SUB/FUNCTION
        ff = resolveSymbol("@SKIP_ROUTINE_" + currentSubName$)
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        skipRoutineLblIdx = returnedData2
        tiraLabelId skipRoutineLblIdx

        tira_EndAndProcess

        currentScopeID = 0
        insideSub = 0
        currentSubName$ = ""
        stack.currentStackOffset = stack.consoleFrameSize
        ff = updateStackAlignment

        parse_END = 1
        EXIT FUNCTION

      CASE TOK_IF
        IF ctrlCount = 0 THEN
          throwCompilerError "END IF WITHOUT IF", ASIS, 0
          EXIT FUNCTION
        END IF

        ctrlCount = ctrlCount - 1

        IF ctrls(ctrlCount).TYPE = CTRL_IF OR ctrls(ctrlCount).TYPE = CTRL_ELSE THEN
          ifID_end = ctrls(ctrlCount).Patch1
          ifID_false = ctrls(ctrlCount).Patch2

          falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
          endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

          tira_Start

          ' If we never saw an ELSE statement, the FALSE condition must skip to here
          IF ctrls(ctrlCount).TYPE = CTRL_IF THEN
            ff = resolveSymbol(falseLbl$)
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            falseLblIdx = returnedData2
            tiraLabelId falseLblIdx
          END IF

          ' Any executed blocks will jump directly here to bypass trailing conditions
          ff = resolveSymbol(endLbl$)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          endLblIdx = returnedData2
          tiraLabelId endLblIdx

          tira_EndAndProcess
        ELSE
          throwCompilerError "END IF MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        parse_END = 1
        EXIT FUNCTION

      CASE TOK_SELECT
        IF ctrlCount = 0 THEN
          throwCompilerError "END SELECT WITHOUT SELECT", ASIS, 0
          EXIT FUNCTION
        END IF

        ctrlCount = ctrlCount - 1

        IF ctrls(ctrlCount).TYPE = CTRL_SELECT THEN
          selID = ctrls(ctrlCount).Patch1
          caseID = ctrls(ctrlCount).SelectCaseSeen

          tira_Start

          IF caseID > 0 THEN
            ' The final case's conditions would skip to right here if they all failed
            prevNextLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID - 1)))
            ff = resolveSymbol(prevNextLbl$)
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            prevNextLblIdx = returnedData2
            tiraLabelId prevNextLblIdx
          END IF

          endSelLbl$ = "@SEL_END_" + LTRIM$(RTRIM$(STR$(selID)))
          ff = resolveSymbol(endSelLbl$)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          endSelLblIdx = returnedData2
          tiraLabelId endSelLblIdx

          tira_EndAndProcess

        ELSE
          throwCompilerError "END SELECT MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        parse_END = 1
        EXIT FUNCTION

    END SELECT ' tok2
  END IF

  ' Standalone END with optional return code
  tira_Start

  IF endIdx > startIdx THEN
    ff = tiraParseExpressionIntId(startIdx + 1, endIdx, ALIM, "END REQUIRES NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    exprType = tiraParsedArgType
    exprVal = tiraParsedArgVal

    ff = resolveSymbol("!G_SYS_VAL_EXIT")
    IF ff = 1 THEN
      vIdxExit = returnedData2
      tiraAssignId vIdxExit, exprType, exprVal
    END IF
  END IF

  ' Jump to the end of the program
  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endProgramLblIdx = returnedData2
  tiraJmpId endProgramLblIdx

  tira_EndAndProcess

  parse_END = 1

END FUNCTION ' parse_END

''''''''''''''''''''''''
FUNCTION parse_EXIT (startIdx)

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM isCtrlFound AS LONG
  DIM foundCtrlIdx AS LONG
  DIM endIdx AS LONG
  DIM tok2 AS LONG
  DIM cIdx AS LONG
  DIM selID AS LONG
  DIM loopID AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "EXPECTED SUB OR FUNCTION", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "EXIT")
  IF ff = 0 THEN EXIT FUNCTION

  tok2 = lineTokenVals(startIdx + 1)

  SELECT CASE tok2

    CASE TOK_SUB, TOK_FUNCTION
      IF tok2 = TOK_SUB AND insideSub <> 1 THEN
        throwCompilerError "EXIT SUB OUTSIDE SUB", ASIS, 0
        EXIT FUNCTION
      END IF
      IF tok2 = TOK_FUNCTION AND insideSub <> 2 THEN
        throwCompilerError "EXIT FUNCTION OUTSIDE FUNCTION", ASIS, 0
        EXIT FUNCTION
      END IF

      ' Route control flow to the subroutine epilogue via a forward jump
      ' This jump targets the end routine label defined and placed by parse_END
      ' This ensures early exits execute unified garbage collection and stack restoration

      ff = findSubIndex(currentSubName$)
      IF ff = 1 THEN
        subIdx = returnedData2
        IF subIdx > 0 THEN
          tira_Start
          tiraScheduleHeapResetId

          ff = resolveSymbol("@END_ROUTINE_" + currentSubName$)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          vIdx = returnedData2

          tiraJmpId vIdx
          tira_EndAndProcess
        END IF
      END IF

    CASE TOK_CASE, TOK_SELECT
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).TYPE = CTRL_SELECT THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT CASE OUTSIDE SELECT", ASIS, 0
        EXIT FUNCTION
      END IF

      selID = ctrls(foundCtrlIdx).Patch1

      tira_Start
      tiraScheduleHeapResetId

      ff = resolveSymbol("@SEL_END_" + LTRIM$(RTRIM$(STR$(selID))))
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      vIdx = returnedData2

      tiraJmpId vIdx
      tira_EndAndProcess

    CASE TOK_DO
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).TYPE = CTRL_DO THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT DO OUTSIDE DO LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      ' Native TIRA integration completely negates the need to walk raw machine code patches
      tira_Start
      tiraScheduleHeapResetId

      ff = resolveSymbol("@DO_DONE_" + LTRIM$(RTRIM$(STR$(loopID))))
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      vIdx = returnedData2

      tiraJmpId vIdx
      tira_EndAndProcess

    CASE TOK_FOR
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).TYPE = CTRL_FOR THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT FOR OUTSIDE FOR LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      ' Native TIRA integration handles the forward jump via the symbol table
      tira_Start
      tiraScheduleHeapResetId

      ff = resolveSymbol("@FOR_DONE_" + LTRIM$(RTRIM$(STR$(loopID))))
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      vIdx = returnedData2

      tiraJmpId vIdx
      tira_EndAndProcess

    CASE TOK_WHILE
      isCtrlFound = 0
      foundCtrlIdx = 0
      FOR cIdx = ctrlCount - 1 TO 0 STEP -1
        IF ctrls(cIdx).TYPE = CTRL_WHILE THEN
          foundCtrlIdx = cIdx
          isCtrlFound = 1
          EXIT FOR
        END IF
      NEXT

      IF isCtrlFound = 0 THEN
        throwCompilerError "EXIT WHILE OUTSIDE WHILE LOOP", ASIS, 0
        EXIT FUNCTION
      END IF

      loopID = ctrls(foundCtrlIdx).Patch1

      tira_Start
      tiraScheduleHeapResetId

      ff = resolveSymbol("@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID))))
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      vIdx = returnedData2

      tiraJmpId vIdx
      tira_EndAndProcess

    CASE ELSE
      throwCompilerError "UNRECOGNIZED EXIT", ASIS, 0
      EXIT FUNCTION

  END SELECT ' tok2

  parse_EXIT = 1

END FUNCTION ' parse_EXIT

''''''''''''''''''''''''
FUNCTION parse_FOR (startIdx)

  DIM endIdx AS LONG
  DIM vIdx AS LONG
  DIM vDataType AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM hasStep AS LONG
  DIM stepIdx AS LONG
  DIM loopID AS LONG
  DIM endExprEnd AS LONG
  DIM endVarIdx AS LONG
  DIM stepVarIdx AS LONG
  DIM startVarType AS LONG
  DIM startVarVal AS _INTEGER64
  DIM endVarType AS LONG
  DIM endVarVal AS _INTEGER64
  DIM stepVarType AS LONG
  DIM stepVarVal AS _INTEGER64
  DIM topLblIdx AS LONG
  DIM condLblIdx AS LONG
  DIM isUdtBase AS LONG
  DIM tokIdx AS LONG
  DIM parenDepth AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 3 THEN
    throwCompilerError "MALFORMED FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  parenDepth = 0

  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
      parenDepth = parenDepth + 1
      tokIdx = tokIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx > endIdx THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 OR RIGHT$(vTok$, 1) = "$" THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Legacy dot variable check
  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = TOK_OP_RPAREN THEN
      parenDepth = parenDepth - 1
      tokIdx = tokIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  IF parenDepth <> 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS IN FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(vName$)
  IF ff = FAILURE THEN EXIT FUNCTION
  vIdx = returnedData2
  vDataType = returnedData3

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF vDataType = TYPE_STRING THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF lineTokenVals(tokIdx) <> TOK_OP_EQUAL THEN
    throwCompilerError "FOR MISSING =", ASIS, 0
    EXIT FUNCTION
  END IF

  hasTo = 0
  toIdx = 0
  hasStep = 0
  stepIdx = 0

  ff = findNextTokenAtDepth0(tokIdx + 1, endIdx, TOK_TO)
  IF ff = SUCCESS THEN
    hasTo = 1
    toIdx = returnedData2
  END IF

  ff = findNextTokenAtDepth0(tokIdx + 1, endIdx, TOK_STEP)
  IF ff = SUCCESS THEN
    hasStep = 1
    stepIdx = returnedData2
  END IF

  IF hasTo = 0 THEN
    throwCompilerError "FOR MISSING TO", ASIS, 0
    EXIT FUNCTION
  END IF

  IF toIdx <= tokIdx THEN
    throwCompilerError "FOR MISSING START EXPR", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    IF stepIdx <= toIdx + 1 THEN
      throwCompilerError "FOR MISSING END EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
    IF stepIdx = endIdx THEN
      throwCompilerError "FOR MISSING STEP EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
  ELSE
    IF toIdx = endIdx THEN
      throwCompilerError "FOR MISSING END EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  ' Generate a globally unique ID for this loop structure
  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_FOR = FAILURE
    EXIT FUNCTION
  END IF

  tira_Start

  '''' Evaluate Start Value
  ff = tiraParseExpressionNumericId(tokIdx + 1, toIdx - 1, cm.ClassicMode, "FOR NEEDS NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  startVarType = tiraParsedArgType
  startVarVal = tiraParsedArgVal

  endExprEnd = endIdx
  IF hasStep = 1 THEN endExprEnd = stepIdx - 1

  endName$ = "!C_SYS_VAL_FOR_END_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(endName$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endVarIdx = returnedData2
  symbols(endVarIdx).DataType = vDataType

  IF currentScopeID > 0 THEN
    symbols(endVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  '''' Evaluate End Value
  ff = tiraParseExpressionNumericId(toIdx + 1, endExprEnd, cm.ClassicMode, "FOR NEEDS NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endVarType = tiraParsedArgType
  endVarVal = tiraParsedArgVal

  stepName$ = "!C_SYS_VAL_FOR_STEP_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(stepName$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  stepVarIdx = returnedData2
  symbols(stepVarIdx).DataType = vDataType

  IF currentScopeID > 0 THEN
    symbols(stepVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  '''' Evaluate Step Value
  IF hasStep = 1 THEN
    ff = tiraParseExpressionNumericId(stepIdx + 1, endIdx, cm.ClassicMode, "FOR NEEDS NUMERIC")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    stepVarType = tiraParsedArgType
    stepVarVal = tiraParsedArgVal
  ELSE
    stepVarType = TIRA_ARG_LITERAL
    stepVarVal = 1
  END IF

  tiraAssignId vIdx, startVarType, startVarVal

  tiraAssignId endVarIdx, endVarType, endVarVal

  tiraAssignId stepVarIdx, stepVarType, stepVarVal

  lblCond$ = "@FOR_COND_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(lblCond$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  condLblIdx = returnedData2
  tiraJmpId condLblIdx

  lblTop$ = "@FOR_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(lblTop$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_FOR
  ctrls(ctrlCount).ForVarIdx = vIdx
  ctrls(ctrlCount).Patch1 = loopID ' Save the Loop ID for parse_NEXT and parse_EXIT
  ctrls(ctrlCount).Patch2 = 0 ' Unused
  ctrlCount = ctrlCount + 1

  parse_FOR = SUCCESS

END FUNCTION ' parse_FOR

''''''''''''''''''''''''
FUNCTION parse_GET (startIdx)

  ' Captures a portion of the graphics screen

  DIM dashIdx AS LONG
  DIM isFileIO AS LONG
  DIM cComma AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM commaIdx AS LONG
  DIM cComma2 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vIdx AS LONG
  DIM elemSize AS LONG
  DIM endIdx AS LONG
  DIM numParsedIndices AS LONG
  DIM x1Type AS LONG
  DIM x1Val AS _INTEGER64
  DIM y1Type AS LONG
  DIM y1Val AS _INTEGER64
  DIM x2Type AS LONG
  DIM x2Val AS _INTEGER64
  DIM y2Type AS LONG
  DIM y2Val AS _INTEGER64
  DIM ptrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM totalElemsIdx AS LONG
  DIM dimItrIdx AS LONG
  DIM lblDimTopIdx AS LONG
  DIM lblDimDoneIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM byteSizeIdx AS LONG
  DIM baseAddrIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM rtGetIdx AS LONG

  endIdx = lineTokenCount - 1

  dashIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_OP_MINUS)
  IF ff = 1 THEN
    dashIdx = returnedData2
  END IF

  isFileIO = 0
  IF dashIdx = 0 THEN
    isFileIO = 1
  END IF

  IF isFileIO = 1 THEN
    parse_GET = parse_GET_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GRAPHICS GET REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(startIdx + 1, dashIdx - 1)
  IF cComma = 0 THEN
    throwCompilerError "GET MISSING X1, Y1", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart1 = returnedData2
  cEnd1 = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x1Type = tiraParsedArgType
  x1Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y1Type = tiraParsedArgType
  y1Val = tiraParsedArgVal

  commaIdx = findComma(dashIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerErrorAndCancelTira "GET MISSING ARRAY VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma2 = retCoordinateBoundaries(dashIdx + 1, commaIdx - 1)
  IF cComma2 = 0 THEN
    throwCompilerErrorAndCancelTira "GET MISSING X2, Y2", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart2 = returnedData2
  cEnd2 = returnedData3

  ff = tiraParseExpressionIntId(cStart2, cComma2 - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2Type = tiraParsedArgType
  x2Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma2 + 1, cEnd2, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2Type = tiraParsedArgType
  y2Val = tiraParsedArgVal

  tokIdx = commaIdx + 1
  vTok$ = lineTokens$(tokIdx)
  vName$ = UCASE$(vTok$)
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
    throwCompilerErrorAndCancelTira "GET TARGET MUST BE AN ARRAY", ASIS, 0
    EXIT FUNCTION
  END IF

  numParsedIndices = 0

  tokIdx = tokIdx + 1
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
      ff = tiraParseArrayId(tokIdx, endIdx, 0)
      IF ff = 0 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ptrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
  IF ptrIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  elemSize = retElementByteSize(vIdx)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  totalElemsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId totalElemsIdx, TIRA_ARG_LITERAL, 1

  dimItrIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId dimItrIdx, TIRA_ARG_LITERAL, 0
  lblDimTopIdx = tiraLabelCreateNewId&("DIM_TOP")
  lblDimDoneIdx = tiraLabelCreateNewId&("DIM_DONE")

  tiraLabelId lblDimTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, numDimsIdx, lblDimDoneIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 4

  dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblDimTopIdx

  tiraLabelId lblDimDoneIdx

  byteSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteSizeIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_LITERAL, elemSize

  baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId baseAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, byteSizeIdx

  ff = resolveSymbol("RT_GET")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  rtGetIdx = returnedData2

  tiraCallId6 rtGetIdx, x1Type, x1Val, y1Type, y1Val, x2Type, x2Val, y2Type, y2Val, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, endPtrIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_GET = 1

END FUNCTION ' parse_GET

''''''''''''''''''''''''
FUNCTION parse_GOTO (startIdx)

  DIM endIdx AS LONG
  DIM vIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "GOTO NEEDS LABEL", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "GOTO")
  IF ff = 0 THEN EXIT FUNCTION

  targetTok$ = lineTokens$(startIdx + 1)
  targetLabelName$ = "%" + UCASE$(targetTok$)

  expectedSymType = TYPE_LABEL
  ff = resolveSymbol(targetLabelName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  tira_Start

  tiraScheduleHeapResetId
  tiraJmpUserId vIdx

  tira_EndAndProcess

  parse_GOTO = 1

END FUNCTION ' parse_GOTO

''''''''''''''''''''''''
FUNCTION parse_INKEY$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM emptyLblIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charValIdx AS LONG
  DIM allocPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM extendedLblIdx AS LONG
  DIM secondValIdx AS LONG
  DIM secondAddrIdx AS LONG
  DIM kbHitIdx AS LONG
  DIM getChIdx AS LONG
  DIM kbdHeadIdx AS LONG
  DIM kbdTailIdx AS LONG
  DIM kbdBufIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED INKEY$", ASIS, 0
    parse_INKEY$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("INKEY", "_DSC")
  IF scratchIdx = 0 THEN
    parse_INKEY$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_LITERAL, 0

  emptyLblIdx = tiraLabelCreateNewId&("INKEY_EMPTY")

  IF cm.HasGraphics = 0 THEN
    ' Poll the console keyboard queue without blocking
    ff = resolveSymbol("IAT_KBHIT")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbHitIdx = returnedData2
    tiraCallId0 kbHitIdx
    keyStateIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId keyStateIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, emptyLblIdx

    ' Retrieve the waiting character
    ff = resolveSymbol("IAT_GETCH")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    getChIdx = returnedData2
    tiraCallId0 getChIdx
    charValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId charValIdx

    ' Extended console keys begin with zero or 224
    extendedLblIdx = tiraLabelCreateNewId&("INKEY_EXTENDED")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, extendedLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 224, extendedLblIdx

    ' Build a normal one-byte INKEY$ result
    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId emptyLblIdx

    ' Build the traditional two-byte extended-key result
    tiraLabelId extendedLblIdx

    tiraCallId0 getChIdx
    secondValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId secondValIdx

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 2)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemId TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 1

    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 2
  ELSE
    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdHeadIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, kbdHeadIdx
    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdTailIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, kbdTailIdx
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, emptyLblIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdBufIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, kbdBufIdx

    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255

    ' Extended graphical keys are queued as CHR$(0), followed by a BIOS scan code
    extendedLblIdx = tiraLabelCreateNewId&("INKEY_GFX_EXTENDED")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, extendedLblIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId emptyLblIdx

    tiraLabelId extendedLblIdx

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    secondValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId secondValIdx, TIRA_ARG_SYMBOL, secondAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 2)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemId TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 1

    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 2
  END IF

  tiraLabelId emptyLblIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tiraInjectPendingDisplayFlushId

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_INKEY$ = scratchName$

END FUNCTION ' parse_INKEY$

''''''''''''''''''''''''
FUNCTION parse_LINE (startIdx)

  DIM boxType AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM dashIdx AS LONG
  DIM hasDash AS LONG
  DIM hasFirstCoord AS LONG
  DIM isStep1 AS LONG
  DIM secondCoordStart AS LONG
  DIM isStep2 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM p2End AS LONG
  DIM colEnd AS LONG
  DIM x1Type AS LONG
  DIM x1Val AS _INTEGER64
  DIM y1Type AS LONG
  DIM y1Val AS _INTEGER64
  DIM x2Type AS LONG
  DIM x2Val AS _INTEGER64
  DIM y2Type AS LONG
  DIM y2Val AS _INTEGER64
  DIM colorType AS LONG
  DIM colorVal AS _INTEGER64
  DIM newX1Idx AS LONG
  DIM newY1Idx AS LONG
  DIM newX2Idx AS LONG
  DIM newY2Idx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM x2GlobalIdx AS LONG
  DIM y2GlobalIdx AS LONG
  DIM fgIdx AS LONG
  DIM lineFuncIdx AS LONG
  DIM boxStr$

  tokIdx = startIdx + 1

  endIdx = lineTokenCount - 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED ( OR - AFTER LINE", ASIS, 0
    EXIT FUNCTION
  END IF

  hasFirstCoord = 1
  hasDash = 0
  isStep1 = 0

  IF lineTokenVals(tokIdx) = TOK_OP_MINUS THEN
    hasFirstCoord = 0
    hasDash = 1
    dashIdx = tokIdx
  ELSE
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      isStep1 = 1
      tokIdx = tokIdx + 1
      IF tokIdx > endIdx THEN
        throwCompilerError "EXPECTED ( AFTER STEP", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    IF lineTokenVals(tokIdx) <> TOK_OP_LPAREN THEN
      throwCompilerError "EXPECTED ( OR - AFTER LINE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = findNextTokenAtDepth0(tokIdx, endIdx, TOK_OP_MINUS)
    IF ff = SUCCESS THEN
      hasDash = 1
      dashIdx = returnedData2
    END IF
  END IF

  IF hasDash = 0 THEN
    throwCompilerError "LINE MISSING -", ASIS, 0
    EXIT FUNCTION
  END IF

  IF dashIdx + 1 > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  secondCoordStart = dashIdx + 1
  isStep2 = 0

  IF lineTokenVals(secondCoordStart) = TOK_STEP THEN
    isStep2 = 1
    secondCoordStart = secondCoordStart + 1
  END IF

  IF secondCoordStart > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(secondCoordStart) <> TOK_OP_LPAREN THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  '''' Parse X1, Y1
  IF hasFirstCoord = 1 THEN
    cComma = retCoordinateBoundaries(tokIdx, dashIdx - 1)
    IF cComma = 0 THEN
      throwCompilerErrorAndCancelTira "LINE MISSING X1, Y1", ASIS, 0
      EXIT FUNCTION
    END IF
    cStart = returnedData2
    cEnd = returnedData3

    ff = tiraParseExpressionIntId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    x1Type = tiraParsedArgType
    x1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    y1Type = tiraParsedArgType
    y1Val = tiraParsedArgVal

    IF isStep1 = 1 THEN
      newX1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX1Idx, TIRA_ARG_SYMBOL, currentXIdx, x1Type, x1Val
      x1Type = TIRA_ARG_SYMBOL
      x1Val = newX1Idx

      newY1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY1Idx, TIRA_ARG_SYMBOL, currentYIdx, y1Type, y1Val
      y1Type = TIRA_ARG_SYMBOL
      y1Val = newY1Idx
    END IF
  ELSE
    x1Type = TIRA_ARG_SYMBOL
    x1Val = currentXIdx
    y1Type = TIRA_ARG_SYMBOL
    y1Val = currentYIdx
  END IF

  '''' Parse X2, Y2, Color, Box
  comma3 = findComma(secondCoordStart, endIdx)
  comma4 = 0
  IF comma3 > 0 THEN
    comma4 = findComma(comma3 + 1, endIdx)
  END IF

  p2End = endIdx
  IF comma3 > 0 THEN p2End = comma3 - 1

  cComma = retCoordinateBoundaries(secondCoordStart, p2End)
  IF cComma = 0 THEN
    throwCompilerErrorAndCancelTira "LINE MISSING X2, Y2", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  ff = tiraParseExpressionIntId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2Type = tiraParsedArgType
  x2Val = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2Type = tiraParsedArgType
  y2Val = tiraParsedArgVal

  IF isStep2 = 1 THEN
    newX2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX2Idx, x1Type, x1Val, x2Type, x2Val
    x2Type = TIRA_ARG_SYMBOL
    x2Val = newX2Idx

    newY2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY2Idx, y1Type, y1Val, y2Type, y2Val
    y2Type = TIRA_ARG_SYMBOL
    y2Val = newY2Idx
  END IF

  '''' Parse color
  IF comma3 > 0 THEN
    colEnd = endIdx
    IF comma4 > 0 THEN colEnd = comma4 - 1
    IF comma3 + 1 > colEnd THEN
      ff = resolveSymbol("!G_GFX_VAL_FG")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgIdx = returnedData2
      colorType = TIRA_ARG_SYMBOL
      colorVal = fgIdx
    ELSE
      ff = tiraParseExpressionIntId(comma3 + 1, colEnd, ALIM, "COLOR MUST BE NUMERIC")
      IF ff = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      colorType = tiraParsedArgType
      colorVal = tiraParsedArgVal
    END IF
  ELSE
    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgIdx = returnedData2
    colorType = TIRA_ARG_SYMBOL
    colorVal = fgIdx
  END IF

  '''' Parse box flag
  boxType = 0
  IF comma4 > 0 THEN
    boxStr$ = UCASE$(lineTokens$(comma4 + 1))
    IF boxStr$ = "B" THEN boxType = 1
    IF boxStr$ = "BF" THEN boxType = 2
  END IF

  ' Compile arguments and invoke the runtime routine natively via TIRA
  ff = resolveSymbol("RT_LINE")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  lineFuncIdx = returnedData2

  tiraCallId7 lineFuncIdx, x1Type, x1Val, y1Type, y1Val, x2Type, x2Val, y2Type, y2Val, colorType, colorVal, TIRA_ARG_LITERAL, boxType, TIRA_ARG_LITERAL, 65535

  ' Update global cursor coordinates so subsequent STEP or -() calls originate from the correct endpoint
  ff = resolveSymbol("!G_GFX_VAL_X2")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2GlobalIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y2")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2GlobalIdx = returnedData2

  tiraAssignId x2GlobalIdx, x2Type, x2Val
  tiraAssignId y2GlobalIdx, y2Type, y2Val
  tiraAssignId currentXIdx, x2Type, x2Val
  tiraAssignId currentYIdx, y2Type, y2Val

  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LINE = SUCCESS

END FUNCTION ' parse_LINE

''''''''''''''''''''''''
FUNCTION parse_MEMCOPY (startIdx)

  ' Copies a validated byte range using the existing native block-copy operation

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM tokenValue AS LONG
  DIM parenDepth AS LONG
  DIM separatorCount AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM toIdx AS LONG
  DIM blockNumber AS LONG
  DIM blockStart AS LONG
  DIM blockEnd AS LONG
  DIM memUdtIndex AS LONG
  DIM sourceDescIdx AS LONG
  DIM targetDescIdx AS LONG
  DIM sourceOffsetIdx AS LONG
  DIM targetOffsetIdx AS LONG
  DIM byteCountIdx AS LONG
  DIM parsedArgType AS LONG
  DIM parsedArgVal AS _INTEGER64
  DIM sourceBaseIdx AS LONG
  DIM sourceSizeIdx AS LONG
  DIM targetBaseIdx AS LONG
  DIM targetSizeIdx AS LONG
  DIM deltaIdx AS LONG
  DIM remainingIdx AS LONG
  DIM gapIdx AS LONG
  DIM chunkIdx AS LONG
  DIM sourceChunkIdx AS LONG
  DIM targetChunkIdx AS LONG
  DIM forwardLblIdx AS LONG
  DIM backwardLblIdx AS LONG
  DIM chunkReadyLblIdx AS LONG
  DIM invalidCountLblIdx AS LONG
  DIM invalidSourceLblIdx AS LONG
  DIM invalidTargetLblIdx AS LONG
  DIM doneLblIdx AS LONG

  endIdx = lineTokenCount - 1

  FOR tokIdx = startIdx + 1 TO endIdx
    tokenValue = lineTokenVals(tokIdx)

    SELECT CASE tokenValue

      CASE TOK_OP_LPAREN
        parenDepth = parenDepth + 1

      CASE TOK_OP_RPAREN
        parenDepth = parenDepth - 1
        IF parenDepth < 0 THEN
          throwCompilerError "UNMATCHED PARENTHESIS IN _MEMCOPY", ASIS, 0
          EXIT FUNCTION
        END IF

      CASE 256 + ASC(",")
        IF parenDepth = 0 THEN
          SELECT CASE separatorCount
            CASE 0: comma1 = tokIdx
            CASE 1: comma2 = tokIdx
            CASE 3: comma3 = tokIdx
            CASE ELSE
              throwCompilerError "_MEMCOPY REQUIRES SOURCE, OFFSET, BYTES TO DESTINATION, OFFSET", ASIS, 0
              EXIT FUNCTION
          END SELECT
          separatorCount = separatorCount + 1
        END IF

      CASE TOK_TO
        IF parenDepth = 0 THEN
          IF separatorCount <> 2 THEN
            throwCompilerError "MISPLACED TO IN _MEMCOPY", ASIS, 0
            EXIT FUNCTION
          END IF
          toIdx = tokIdx
          separatorCount = separatorCount + 1
        END IF

    END SELECT
  NEXT

  IF parenDepth <> 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS IN _MEMCOPY", ASIS, 0
    EXIT FUNCTION
  END IF

  IF separatorCount <> 4 THEN
    throwCompilerError "_MEMCOPY REQUIRES SOURCE, OFFSET, BYTES TO DESTINATION, OFFSET", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 <= startIdx + 1 OR comma2 <= comma1 + 1 OR toIdx <= comma2 + 1 OR comma3 <= toIdx + 1 OR comma3 >= endIdx THEN
    throwCompilerError "_MEMCOPY HAS A MISSING ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Require complete memory-block references before resolving their UDT addresses
  FOR blockNumber = 1 TO 2
    IF blockNumber = 1 THEN
      blockStart = startIdx + 1
      blockEnd = comma1 - 1
    ELSE
      blockStart = toIdx + 1
      blockEnd = comma3 - 1
    END IF

    IF lineTokenVals(blockStart) <> 0 THEN
      throwCompilerError "_MEMCOPY EXPECTED A MEMORY-BLOCK VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = blockStart + 1
    IF tokIdx <= blockEnd THEN
      IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
        ff = findMatchingParen(tokIdx, blockEnd)
        IF ff = 0 THEN
          throwCompilerError "UNMATCHED PARENTHESIS IN _MEMCOPY", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = returnedData2 + 1
      END IF
    END IF

    DO WHILE tokIdx <= blockEnd
      IF lineTokenVals(tokIdx) <> 256 + ASC(".") OR tokIdx = blockEnd THEN
        throwCompilerError "INVALID MEMORY-BLOCK REFERENCE IN _MEMCOPY", ASIS, 0
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    LOOP
  NEXT

  ff = findUdtIndex("_MEM")
  IF ff = 0 THEN
    throwCompilerError "INTERNAL _MEM TYPE NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF
  memUdtIndex = returnedData2

  tira_Start

  sourceDescIdx = tiraParseRhsUdtBaseId&(startIdx + 1, comma1 - 1, memUdtIndex)
  IF sourceDescIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  targetDescIdx = tiraParseRhsUdtBaseId&(toIdx + 1, comma3 - 1, memUdtIndex)
  IF targetDescIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionNumericId(comma1 + 1, comma2 - 1, ALIM, "_MEMCOPY SOURCE OFFSET MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType = TYPE_UDT OR exprIs.DataType = TYPE_ANY THEN
    throwCompilerErrorAndCancelTira "_MEMCOPY SOURCE OFFSET MUST BE NUMERIC", ASIS, 0
    EXIT FUNCTION
  END IF
  parsedArgType = tiraParsedArgType
  parsedArgVal = tiraParsedArgVal
  sourceOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId sourceOffsetIdx, parsedArgType, parsedArgVal

  ff = tiraParseExpressionNumericId(comma2 + 1, toIdx - 1, ALIM, "_MEMCOPY BYTE COUNT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType = TYPE_UDT OR exprIs.DataType = TYPE_ANY THEN
    throwCompilerErrorAndCancelTira "_MEMCOPY BYTE COUNT MUST BE NUMERIC", ASIS, 0
    EXIT FUNCTION
  END IF
  parsedArgType = tiraParsedArgType
  parsedArgVal = tiraParsedArgVal
  byteCountIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId byteCountIdx, parsedArgType, parsedArgVal

  ff = tiraParseExpressionNumericId(comma3 + 1, endIdx, ALIM, "_MEMCOPY DESTINATION OFFSET MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType = TYPE_UDT OR exprIs.DataType = TYPE_ANY THEN
    throwCompilerErrorAndCancelTira "_MEMCOPY DESTINATION OFFSET MUST BE NUMERIC", ASIS, 0
    EXIT FUNCTION
  END IF
  parsedArgType = tiraParsedArgType
  parsedArgVal = tiraParsedArgVal
  targetOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId targetOffsetIdx, parsedArgType, parsedArgVal

  sourceBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId sourceBaseIdx, TIRA_ARG_SYMBOL, sourceDescIdx
  sourceSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemOffsetId sourceSizeIdx, TIRA_ARG_SYMBOL, sourceDescIdx, 8

  targetBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId targetBaseIdx, TIRA_ARG_SYMBOL, targetDescIdx
  targetSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemOffsetId targetSizeIdx, TIRA_ARG_SYMBOL, targetDescIdx, 8

  deltaIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  remainingIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  gapIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  chunkIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  sourceChunkIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  targetChunkIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  forwardLblIdx = tiraLabelCreateNewId&("MEMCOPY_FORWARD")
  backwardLblIdx = tiraLabelCreateNewId&("MEMCOPY_BACKWARD")
  chunkReadyLblIdx = tiraLabelCreateNewId&("MEMCOPY_CHUNK_READY")
  invalidCountLblIdx = tiraLabelCreateNewId&("MEMCOPY_INVALID_COUNT")
  invalidSourceLblIdx = tiraLabelCreateNewId&("MEMCOPY_INVALID_SOURCE")
  invalidTargetLblIdx = tiraLabelCreateNewId&("MEMCOPY_INVALID_TARGET")
  doneLblIdx = tiraLabelCreateNewId&("MEMCOPY_DONE")

  IF compileError = 1 OR t.IsActive <> 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteCountIdx, TIRA_ARG_LITERAL, 0, invalidCountLblIdx

  ' Subtract only after checking the lower bound, then compare the remaining size
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, sourceBaseIdx, TIRA_ARG_LITERAL, 0, invalidSourceLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, sourceSizeIdx, TIRA_ARG_LITERAL, 0, invalidSourceLblIdx
  tiraJmpCondId JCC_JB, TIRA_ARG_SYMBOL, sourceOffsetIdx, TIRA_ARG_SYMBOL, sourceBaseIdx, invalidSourceLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, deltaIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx, TIRA_ARG_SYMBOL, sourceBaseIdx
  tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, deltaIdx, TIRA_ARG_SYMBOL, sourceSizeIdx, invalidSourceLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, sourceSizeIdx, TIRA_ARG_SYMBOL, deltaIdx
  tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, byteCountIdx, TIRA_ARG_SYMBOL, remainingIdx, invalidSourceLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, targetBaseIdx, TIRA_ARG_LITERAL, 0, invalidTargetLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, targetSizeIdx, TIRA_ARG_LITERAL, 0, invalidTargetLblIdx
  tiraJmpCondId JCC_JB, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, targetBaseIdx, invalidTargetLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, deltaIdx, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, targetBaseIdx
  tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, deltaIdx, TIRA_ARG_SYMBOL, targetSizeIdx, invalidTargetLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, targetSizeIdx, TIRA_ARG_SYMBOL, deltaIdx
  tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, byteCountIdx, TIRA_ARG_SYMBOL, remainingIdx, invalidTargetLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteCountIdx, TIRA_ARG_LITERAL, 0, doneLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx, doneLblIdx
  tiraJmpCondId JCC_JB, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx, forwardLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, gapIdx, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, gapIdx, TIRA_ARG_SYMBOL, byteCountIdx, forwardLblIdx

  ' For overlapping copies to higher addresses, copy from the end in disjoint blocks
  tiraAssignId remainingIdx, TIRA_ARG_SYMBOL, byteCountIdx
  tiraLabelId backwardLblIdx
  tiraAssignId chunkIdx, TIRA_ARG_SYMBOL, remainingIdx
  tiraJmpCondId JCC_JBE, TIRA_ARG_SYMBOL, chunkIdx, TIRA_ARG_SYMBOL, gapIdx, chunkReadyLblIdx
  tiraAssignId chunkIdx, TIRA_ARG_SYMBOL, gapIdx
  tiraLabelId chunkReadyLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, chunkIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, sourceChunkIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx, TIRA_ARG_SYMBOL, remainingIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetChunkIdx, TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, remainingIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, targetChunkIdx, TIRA_ARG_SYMBOL, sourceChunkIdx, TIRA_ARG_SYMBOL, chunkIdx
  tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_LITERAL, 0, backwardLblIdx
  tiraJmpId doneLblIdx

  tiraLabelId forwardLblIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, targetOffsetIdx, TIRA_ARG_SYMBOL, sourceOffsetIdx, TIRA_ARG_SYMBOL, byteCountIdx
  tiraJmpId doneLblIdx

  tiraLabelId invalidCountLblIdx
  tiraFatalErrorId "_MEMCOPY BYTE COUNT CANNOT BE NEGATIVE"
  tiraLabelId invalidSourceLblIdx
  tiraFatalErrorId "_MEMCOPY SOURCE RANGE OUTSIDE MEMORY BLOCK"
  tiraLabelId invalidTargetLblIdx
  tiraFatalErrorId "_MEMCOPY DESTINATION RANGE OUTSIDE MEMORY BLOCK"

  tiraLabelId doneLblIdx
  tiraScheduleHeapResetId
  IF compileError = 1 OR t.IsActive <> 1 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  tira_EndAndProcess
  IF compileError = 1 THEN EXIT FUNCTION

  parse_MEMCOPY = 1

END FUNCTION ' parse_MEMCOPY

''''''''''''''''''''''''
FUNCTION parse_MEMFILL (startIdx)

  ' Fills a validated portion of the _MEM block with a converted numeric value

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM asIdx AS LONG
  DIM valueEndIdx AS LONG
  DIM typeEndIdx AS LONG
  DIM memUdtIndex AS LONG
  DIM fillType AS LONG
  DIM valueType AS LONG
  DIM fillTypeSize AS LONG
  DIM trailingByte AS LONG
  DIM memDescAddrIdx AS LONG
  DIM memBlockOffsetIdx AS LONG
  DIM memBlockSizeIdx AS LONG
  DIM fillOffsetType AS LONG
  DIM fillOffsetVal AS _INTEGER64
  DIM fillBytesType AS LONG
  DIM fillBytesVal AS _INTEGER64
  DIM fillValueArgType AS LONG
  DIM fillValueArgVal AS _INTEGER64
  DIM convertedValueIdx AS LONG
  DIM rawValueIdx AS LONG
  DIM valueAddrIdx AS LONG
  DIM blockDeltaIdx AS LONG
  DIM blockRemainingIdx AS LONG
  DIM fullValueCountIdx AS LONG
  DIM fullValueBytesIdx AS LONG
  DIM trailingBytesIdx AS LONG
  DIM trailingAddrIdx AS LONG
  DIM wideRawValueIdx AS LONG
  DIM trailingValueIdx AS LONG
  DIM trailingSkipLblIdx AS LONG
  DIM validDeltaLblIdx AS LONG
  DIM validLengthLblIdx AS LONG
  DIM valueName$
  DIM valueTokenIdx AS LONG
  DIM valueCloseParen AS LONG
  DIM valueSymbolIdx AS LONG
  DIM valueIsName AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma3 = findComma(comma2 + 1, endIdx)
  IF comma3 = 0 THEN
    throwCompilerError "_MEMFILL REQUIRES MEMORY BLOCK, OFFSET, BYTE COUNT, AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma4 = findComma(comma3 + 1, endIdx)
  IF comma4 > 0 THEN
    throwCompilerError "_MEMFILL ACCEPTS FOUR ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 <= startIdx + 1 OR comma2 <= comma1 + 1 OR comma3 <= comma2 + 1 OR comma3 >= endIdx THEN
    throwCompilerError "_MEMFILL HAS A MISSING ARGUMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  asIdx = 0
  ff = findNextTokenAtDepth0(comma3 + 1, endIdx, TOK_AS)
  IF ff = 1 THEN asIdx = returnedData2

  valueEndIdx = endIdx
  fillType = TYPE_UNDEFINED

  IF asIdx > 0 THEN
    IF asIdx <= comma3 + 1 OR asIdx >= endIdx THEN
      throwCompilerError "_MEMFILL REQUIRES A VALUE AND TYPE AROUND AS", ASIS, 0
      EXIT FUNCTION
    END IF

    valueEndIdx = asIdx - 1
    typeEndIdx = parseTypeClause(asIdx + 1, endIdx, 0)
    fillType = returnedData2

    IF fillType = TYPE_UNDEFINED OR compileError = 1 THEN EXIT FUNCTION

    IF typeEndIdx <> endIdx + 1 THEN
      throwCompilerError "UNEXPECTED TOKENS AFTER _MEMFILL TYPE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF fillType = TYPE_STRING OR fillType = TYPE_UDT OR fillType = TYPE_ANY THEN
      throwCompilerError "_MEMFILL TYPE MUST BE NUMERIC", ASIS, 0
      EXIT FUNCTION
    END IF
  ELSE
    ' QB64 requires an untyped fill value to be a named scalar or array element
    valueIsName = 0
    valueTokenIdx = comma3 + 1

    IF lineTokenVals(valueTokenIdx) = 0 THEN
      valueName$ = UCASE$(lineTokens$(valueTokenIdx))
      ff = findSymbol(valueName$)

      IF ff = 1 THEN
        valueSymbolIdx = returnedData2

        IF symbols(valueSymbolIdx).SubIndex = 0 THEN
          valueTokenIdx = valueTokenIdx + 1

          IF symbols(valueSymbolIdx).IsArray = ARRAY_TYPE_NONE THEN
            valueIsName = 1
          ELSE
            IF valueTokenIdx <= valueEndIdx THEN
              IF lineTokenVals(valueTokenIdx) = 256 + ASC("(") THEN
                ff = findMatchingParen(valueTokenIdx, valueEndIdx)
                IF ff = 1 THEN
                  valueCloseParen = returnedData2
                  IF valueCloseParen > valueTokenIdx + 1 THEN
                    valueTokenIdx = valueCloseParen + 1
                    valueIsName = 1
                  END IF
                END IF
              END IF
            END IF
          END IF

          IF valueIsName = 1 THEN
            DO WHILE valueTokenIdx <= valueEndIdx
              IF lineTokenVals(valueTokenIdx) = 256 + ASC(".") THEN
                IF valueTokenIdx + 1 <= valueEndIdx THEN
                  valueTokenIdx = valueTokenIdx + 2
                ELSE
                  valueIsName = 0
                  EXIT DO
                END IF
              ELSE
                valueIsName = 0
                EXIT DO
              END IF
            LOOP
          END IF
        END IF
      END IF
    END IF

    IF valueIsName = 0 THEN
      throwCompilerError "EXPECTED NAME/ARRAY ELEMENT", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  ff = findUdtIndex("_MEM")
  IF ff = 0 THEN
    throwCompilerError "INTERNAL _MEM TYPE NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF
  memUdtIndex = returnedData2

  tira_Start

  memDescAddrIdx = tiraParseRhsUdtBaseId&(startIdx + 1, comma1 - 1, memUdtIndex)
  IF memDescAddrIdx = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntId(comma1 + 1, comma2 - 1, ALIM, "_MEMFILL OFFSET MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fillOffsetType = tiraParsedArgType
  fillOffsetVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma2 + 1, comma3 - 1, ALIM, "_MEMFILL BYTE COUNT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fillBytesType = tiraParsedArgType
  fillBytesVal = tiraParsedArgVal

  ff = tiraParseExpressionId(comma3 + 1, valueEndIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fillValueArgType = tiraParsedArgType
  fillValueArgVal = tiraParsedArgVal
  valueType = exprIs.DataType

  IF valueType = TYPE_STRING OR valueType = TYPE_UDT OR valueType = TYPE_ANY THEN
    throwCompilerErrorAndCancelTira "_MEMFILL VALUE MUST BE NUMERIC", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fillType = TYPE_UNDEFINED THEN fillType = valueType

  fillTypeSize = 0

  SELECT CASE fillType

    CASE TYPE_BYTE, TYPE_UBYTE
      fillTypeSize = 1

    CASE TYPE_INTEGER, TYPE_UINTEGER
      fillTypeSize = 2

    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE
      fillTypeSize = 4

    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE
      fillTypeSize = 8

  END SELECT ' fillType

  IF fillTypeSize = 0 THEN
    throwCompilerErrorAndCancelTira "UNSUPPORTED _MEMFILL TYPE", ASIS, 0
    EXIT FUNCTION
  END IF

  convertedValueIdx = tiraDimVarId&("T", fillType)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, convertedValueIdx, fillValueArgType, fillValueArgVal, TIRA_ARG_LITERAL, fillType
  rawValueIdx = convertedValueIdx

  IF fillType = TYPE_SINGLE OR fillType = TYPE_DOUBLE THEN
    valueAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, valueAddrIdx, TIRA_ARG_SYMBOL, convertedValueIdx

    IF fillType = TYPE_SINGLE THEN
      rawValueIdx = tiraDimVarId&("T", TYPE_ULONG)
    ELSE
      rawValueIdx = tiraDimVarId&("T", TYPE_UINT64)
    END IF

    tiraReadMemId rawValueIdx, TIRA_ARG_SYMBOL, valueAddrIdx
  END IF

  memBlockOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId memBlockOffsetIdx, TIRA_ARG_SYMBOL, memDescAddrIdx

  memBlockSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemOffsetId memBlockSizeIdx, TIRA_ARG_SYMBOL, memDescAddrIdx, 8

  validDeltaLblIdx = tiraLabelCreateNewId&("MEMFILL_DELTA_VALID")
  tiraJmpCondId JCC_JGE, fillOffsetType, fillOffsetVal, TIRA_ARG_SYMBOL, memBlockOffsetIdx, validDeltaLblIdx
  tiraFatalErrorId "_MEMFILL OFFSET OUTSIDE MEMORY BLOCK"
  tiraLabelId validDeltaLblIdx

  blockDeltaIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, blockDeltaIdx, fillOffsetType, fillOffsetVal, TIRA_ARG_SYMBOL, memBlockOffsetIdx

  validLengthLblIdx = tiraLabelCreateNewId&("MEMFILL_LENGTH_VALID")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, memBlockSizeIdx, TIRA_ARG_LITERAL, 0, validLengthLblIdx
  tiraFatalErrorId "INVALID _MEM BLOCK SIZE"
  tiraLabelId validLengthLblIdx

  blockRemainingIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, blockRemainingIdx, TIRA_ARG_SYMBOL, memBlockSizeIdx, TIRA_ARG_SYMBOL, blockDeltaIdx

  validLengthLblIdx = tiraLabelCreateNewId&("MEMFILL_RANGE_VALID")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, blockRemainingIdx, TIRA_ARG_LITERAL, 0, validLengthLblIdx
  tiraFatalErrorId "_MEMFILL OFFSET OUTSIDE MEMORY BLOCK"
  tiraLabelId validLengthLblIdx

  validLengthLblIdx = tiraLabelCreateNewId&("MEMFILL_BYTES_NONNEGATIVE")
  tiraJmpCondId JCC_JGE, fillBytesType, fillBytesVal, TIRA_ARG_LITERAL, 0, validLengthLblIdx
  tiraFatalErrorId "_MEMFILL BYTE COUNT CANNOT BE NEGATIVE"
  tiraLabelId validLengthLblIdx

  validLengthLblIdx = tiraLabelCreateNewId&("MEMFILL_BYTES_VALID")
  tiraJmpCondId JCC_JLE, fillBytesType, fillBytesVal, TIRA_ARG_SYMBOL, blockRemainingIdx, validLengthLblIdx
  tiraFatalErrorId "_MEMFILL RANGE EXCEEDS MEMORY BLOCK"
  tiraLabelId validLengthLblIdx

  IF fillTypeSize = 1 THEN
    tiraMemSetId fillOffsetType, fillOffsetVal, TIRA_ARG_SYMBOL, rawValueIdx, fillBytesType, fillBytesVal
  ELSE
    fullValueCountIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, fullValueCountIdx, fillBytesType, fillBytesVal, TIRA_ARG_LITERAL, fillTypeSize

    trailingBytesIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, trailingBytesIdx, fillBytesType, fillBytesVal, TIRA_ARG_LITERAL, fillTypeSize

    tiraCheckActive ("parse_MEMFILL")
    IF tiraLineCheckId = 0 THEN
      tiraNode(t.LineCount).OpCode = TC_MEMSET

      tiraNode(t.LineCount).Arg1Type = fillOffsetType
      tiraNode(t.LineCount).Arg1Val = fillOffsetVal

      tiraNode(t.LineCount).Arg2Type = TIRA_ARG_SYMBOL
      tiraNode(t.LineCount).Arg2Val = rawValueIdx

      tiraNode(t.LineCount).Arg3Type = TIRA_ARG_SYMBOL
      tiraNode(t.LineCount).Arg3Val = fullValueCountIdx

      tiraNode(t.LineCount).Arg4Type = TIRA_ARG_LITERAL
      tiraNode(t.LineCount).Arg4Val = fillTypeSize

      t.LineCount = t.LineCount + 1
    END IF

    fullValueBytesIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fullValueBytesIdx, TIRA_ARG_SYMBOL, fullValueCountIdx, TIRA_ARG_LITERAL, fillTypeSize

    trailingAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, trailingAddrIdx, fillOffsetType, fillOffsetVal, TIRA_ARG_SYMBOL, fullValueBytesIdx

    wideRawValueIdx = tiraDimVarId&("T", TYPE_UINT64)
    tiraAssignId wideRawValueIdx, TIRA_ARG_SYMBOL, rawValueIdx

    FOR trailingByte = 0 TO fillTypeSize - 2
      trailingSkipLblIdx = tiraLabelCreateNewId&("MEMFILL_TRAILING_SKIP")
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, trailingBytesIdx, TIRA_ARG_LITERAL, trailingByte, trailingSkipLblIdx

      trailingValueIdx = tiraDimVarId&("T", TYPE_UINT64)
      tiraAssignId trailingValueIdx, TIRA_ARG_SYMBOL, wideRawValueIdx
      IF trailingByte > 0 THEN tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, trailingValueIdx, TIRA_ARG_SYMBOL, trailingValueIdx, TIRA_ARG_LITERAL, trailingByte * 8
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, trailingValueIdx, TIRA_ARG_SYMBOL, trailingValueIdx, TIRA_ARG_LITERAL, 255
      tiraWriteMemOffsetId TIRA_ARG_SYMBOL, trailingAddrIdx, trailingByte, TIRA_ARG_SYMBOL, trailingValueIdx, TIRA_ARG_LITERAL, 1

      tiraLabelId trailingSkipLblIdx
    NEXT
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_MEMFILL = 1

END FUNCTION ' parse_MEMFILL

''''''''''''''''''''''''
FUNCTION parse_OPEN (startIdx)

  ' Opens a file for data access

  DIM hasFor AS LONG
  DIM hasLen AS LONG
  DIM forIdx AS LONG
  DIM asIdx AS LONG
  DIM lenIdx AS LONG
  DIM fileNameStart AS LONG
  DIM fileNameEnd AS LONG
  DIM fileNumStart AS LONG
  DIM fileNumEnd AS LONG
  DIM recordLenStart AS LONG
  DIM fileNameType AS LONG
  DIM fileNameVal AS _INTEGER64
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM recordLenType AS LONG
  DIM recordLenVal AS _INTEGER64
  DIM tokVal AS LONG
  DIM modeName$
  DIM modeCode AS LONG
  DIM accessVal AS _INTEGER64
  DIM dispVal AS _INTEGER64
  DIM strDataPtrIdx AS LONG
  DIM createFileIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM openHandleValidLblIdx AS LONG
  DIM handlesArrayIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM stateRecordLenIdx AS LONG
  DIM recordLenValidLblIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  hasFor = 0
  forIdx = 0
  modeName$ = ""
  modeCode = FS_MODE_RANDOM
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_FOR)
  IF ff = SUCCESS THEN
    hasFor = 1
    forIdx = returnedData2
  END IF

  asIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_AS)
  IF ff = SUCCESS THEN
    asIdx = returnedData2
  ELSE
    throwCompilerError "OPEN MISSING AS", ASIS, 0
    EXIT FUNCTION
  END IF

  fileNameStart = startIdx + 1
  fileNameEnd = asIdx - 1
  IF hasFor = 1 THEN fileNameEnd = forIdx - 1

  IF hasFor = 1 THEN
    IF forIdx + 1 < asIdx THEN
      tokVal = lineTokenVals(forIdx + 1)
      modeName$ = UCASE$(lineTokens$(forIdx + 1))

      SELECT CASE tokVal

        CASE TOK_BINARY
          modeCode = FS_MODE_BINARY
        CASE TOK_RANDOM
          modeCode = FS_MODE_RANDOM
        CASE TOK_INPUT
          modeCode = FS_MODE_INPUT
        CASE ELSE
          IF modeName$ = "OUTPUT" THEN
            modeCode = FS_MODE_OUTPUT
          ELSE
            throwCompilerError "INVALID FILE MODE (ONLY BINARY/RANDOM/INPUT/OUTPUT SUPPORTED)", ASIS, 0
            EXIT FUNCTION
          END IF

      END SELECT ' tokVal

    ELSE
      throwCompilerError "OPEN MISSING MODE AFTER FOR", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  fileNumStart = asIdx + 1
  fileNumEnd = endIdx
  hasLen = 0
  lenIdx = 0

  ' Separate the optional LEN clause from the file-number expression
  ff = findNextTokenAtDepth0(fileNumStart, endIdx, TOK_LEN)
  IF ff = SUCCESS THEN
    hasLen = 1
    lenIdx = returnedData2
    fileNumEnd = lenIdx - 1

    IF lenIdx + 1 > endIdx THEN
      throwCompilerError "OPEN LEN MISSING =", ASIS, 0
      EXIT FUNCTION
    END IF

    IF lineTokenVals(lenIdx + 1) <> TOK_OP_EQUAL THEN
      throwCompilerError "OPEN LEN MISSING =", ASIS, 0
      EXIT FUNCTION
    END IF

    recordLenStart = lenIdx + 2
    IF recordLenStart > endIdx THEN
      throwCompilerError "OPEN LEN MISSING RECORD LENGTH", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF fileNumStart > fileNumEnd THEN
    throwCompilerError "OPEN MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fileNumStart <= fileNumEnd THEN
    ' Strip the # symbol so the expression evaluates properly
    IF lineTokens$(fileNumStart) = "#" THEN
      fileNumStart = fileNumStart + 1
    ELSE
      IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
        lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
      END IF
    END IF
  END IF

  IF fileNumStart > fileNumEnd THEN
    throwCompilerError "OPEN MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ff = tiraParseExpressionId(fileNameStart, fileNameEnd, ALIM)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNameType = tiraParsedArgType
  fileNameVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntId(fileNumStart, fileNumEnd, ALIM, "FILENUM MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileNumType = tiraParsedArgType
  fileNumVal = tiraParsedArgVal

  IF hasLen = 1 THEN
    ff = tiraParseExpressionIntId(recordLenStart, endIdx, ALIM, "RECORD LENGTH MUST BE NUMERIC")
    IF ff = FAILURE THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    recordLenType = tiraParsedArgType
    recordLenVal = tiraParsedArgVal
  END IF

  stateRecordLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId stateRecordLenIdx, TIRA_ARG_LITERAL, 0

  IF modeCode <> FS_MODE_BINARY THEN
    IF hasLen = 1 THEN
      tiraAssignId stateRecordLenIdx, recordLenType, recordLenVal
    ELSE
      IF modeCode = FS_MODE_RANDOM THEN
        tiraAssignId stateRecordLenIdx, TIRA_ARG_LITERAL, FS_DEFAULT_RANDOM_RECORD_LENGTH
      ELSE
        tiraAssignId stateRecordLenIdx, TIRA_ARG_LITERAL, FS_DEFAULT_SEQUENTIAL_RECORD_LENGTH
      END IF
    END IF

    recordLenValidLblIdx = tiraLabelCreateNewId&("OPEN_RECORD_LENGTH_VALID")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, stateRecordLenIdx, TIRA_ARG_LITERAL, 0, recordLenValidLblIdx
    tiraFatalErrorId "INVALID RECORD LENGTH"
    tiraLabelId recordLenValidLblIdx
  END IF

  ' Setup generic OS constants mapping to the required behavior natively to bypass CPU register constraints
  IF modeCode = FS_MODE_INPUT THEN
    accessVal = -2147483648 ' read only access
    dispVal = 3 ' opens an existing file
  ELSE
    IF modeCode = FS_MODE_OUTPUT THEN
      accessVal = 1073741824 ' write only access
      dispVal = 2 ' creates or truncates the file
    ELSE
      accessVal = -1073741824 ' GENERIC_READ OR GENERIC_WRITE
      dispVal = 4 ' OPEN_ALWAYS
    END IF
  END IF

  ' String arrays naturally track null terminators so it resolves seamlessly here to map directly into OS requirements
  strDataPtrIdx = tiraGetStringDataId&(fileNameType, fileNameVal)

  ' Execute the CreateFileA procedure and allow the OS to perform file locking tracking
  ' ShareMode = 3 (FILE_SHARE_READ OR FILE_SHARE_WRITE)
  ff = resolveSymbol("IAT_CREATEFILEA")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  createFileIdx = returnedData2

  tiraCallId7 createFileIdx, TIRA_ARG_SYMBOL, strDataPtrIdx, TIRA_ARG_LITERAL, accessVal, TIRA_ARG_LITERAL, 3, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, dispVal, TIRA_ARG_LITERAL, 128, TIRA_ARG_LITERAL, 0

  handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId handleVarIdx

  ' Reject a failed CreateFileA result before recording an invalid file handle
  openHandleValidLblIdx = tiraLabelCreateNewId&("OPEN_HANDLE_VALID")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, openHandleValidLblIdx

  IF modeCode = FS_MODE_INPUT THEN
    tiraFatalErrorId "FILE NOT FOUND"
  ELSE
    tiraFatalErrorId "FILE OPEN FAILED"
  END IF

  tiraLabelId openHandleValidLblIdx

  ' Push OS Pointer Handle directly into the corresponding layout array index utilizing the provided File Number
  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  handlesArrayIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

  slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

  tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 8

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES

  tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, modeCode, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, stateSlotIdx, FS_STATE_RECORD_LENGTH_OFFSET, TIRA_ARG_SYMBOL, stateRecordLenIdx, TIRA_ARG_LITERAL, 4

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_OPEN = SUCCESS

END FUNCTION ' parse_OPEN

''''''''''''''''''''''''
FUNCTION parse_PALETTE (startIdx)

  DIM comma1 AS LONG
  DIM idxVarType AS LONG
  DIM idxVarVal AS _INTEGER64
  DIM colorVarType AS LONG
  DIM colorVarVal AS _INTEGER64
  DIM mappedColorIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM srcDefaultIdx AS LONG
  DIM srcDescPtrIdx AS LONG
  DIM srcDataAddrIdx AS LONG
  DIM srcOffsetVarIdx AS LONG
  DIM srcAddrIdx AS LONG
  DIM destPaletteIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM destDataAddrIdx AS LONG
  DIM destOffsetVarIdx AS LONG
  DIM destAddrIdx AS LONG
  DIM colorValIdx AS LONG
  DIM redPrimaryIdx AS LONG
  DIM redSecondaryIdx AS LONG
  DIM redValueIdx AS LONG
  DIM greenPrimaryIdx AS LONG
  DIM greenSecondaryIdx AS LONG
  DIM greenValueIdx AS LONG
  DIM bluePrimaryIdx AS LONG
  DIM blueSecondaryIdx AS LONG
  DIM blueValueIdx AS LONG
  DIM pagingIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM paletteAutoLblIdx AS LONG
  DIM paletteDisplayDoneLblIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    tira_Start

    ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcDefaultIdx = returnedData2

    ff = resolveSymbol("!G_GFX_DSC_PALETTE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPaletteIdx = returnedData2

    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    pagingIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageIdx = returnedData2

    ' A bare PALETTE statement restores every entry from the pristine default palette
    srcDataAddrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, srcDefaultIdx)
    destDataAddrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, destPaletteIdx)
    tiraMemcpyId TIRA_ARG_SYMBOL, destDataAddrIdx, TIRA_ARG_SYMBOL, srcDataAddrIdx, TIRA_ARG_LITERAL, 1024

    paletteAutoLblIdx = tiraLabelCreateNewId&("PALETTE_RESET_AUTO")
    paletteDisplayDoneLblIdx = tiraLabelCreateNewId&("PALETTE_RESET_DISPLAY_DONE")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, paletteAutoLblIdx
    tiraRefreshVisualPageId TIRA_ARG_SYMBOL, visualPageIdx
    tiraJmpId paletteDisplayDoneLblIdx

    tiraLabelId paletteAutoLblIdx
    tiraTriggerAutoDisplayId

    tiraLabelId paletteDisplayDoneLblIdx

    tiraScheduleHeapResetId
    tira_EndAndProcess

    parse_PALETTE = 1
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "PALETTE REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  idxVarType = tiraParsedArgType
  idxVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  colorVarType = tiraParsedArgType
  colorVarVal = tiraParsedArgVal

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PAL")

  tiraJmpCondId JCC_JL, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraJmpCondId JCC_JG, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 255, skipLblIdx

  colorValIdx = tiraDimVarId&("T", TYPE_LONG)

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      ' These modes use sixteen attributes selected from the 64-color EGA range
      mappedColorIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, mappedColorIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 63

      redPrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 4
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_LITERAL, 2
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_LITERAL, 170

      redSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 32
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_LITERAL, 5
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_LITERAL, 85

      redValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx

      greenPrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 2
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_LITERAL, 170

      greenSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_LITERAL, 4
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_LITERAL, 85

      greenValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx

      bluePrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_LITERAL, 170

      blueSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 8
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_LITERAL, 3
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_LITERAL, 85

      blueValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx

      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 8

      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, greenValueIdx
      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, blueValueIdx

    CASE 13
      ' SCREEN 13 PALETTE colors pack six-bit red, green, and blue components into one LONG
      redValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 4

      greenValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 8
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 4

      blueValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, blueValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_LITERAL, 4

      ' Store the converted color in the framebuffer palette's native BGR byte order
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 8

      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, greenValueIdx
      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, blueValueIdx

    CASE ELSE
      ' Map non-EGA PALETTE values through the standard sixteen-color block
      mappedColorIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, mappedColorIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 15

      ' Read from the pristine default palette to prevent cumulative mapping corruption bugs
      ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcDefaultIdx = returnedData2

      srcDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId srcDescPtrIdx, TIRA_ARG_SYMBOL, srcDefaultIdx

      srcDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId srcDataAddrIdx, TIRA_ARG_SYMBOL, srcDescPtrIdx

      srcOffsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, srcOffsetVarIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 4

      srcAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcAddrIdx, TIRA_ARG_SYMBOL, srcDataAddrIdx, TIRA_ARG_SYMBOL, srcOffsetVarIdx

      tiraReadMemId colorValIdx, TIRA_ARG_SYMBOL, srcAddrIdx

  END SELECT ' compileScreenMode

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destPaletteIdx = returnedData2

  destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destDescPtrIdx, TIRA_ARG_SYMBOL, destPaletteIdx

  destDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId destDataAddrIdx, TIRA_ARG_SYMBOL, destDescPtrIdx

  destOffsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, destOffsetVarIdx, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 4

  destAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, destDataAddrIdx, TIRA_ARG_SYMBOL, destOffsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_LITERAL, 4

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  pagingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  visualPageIdx = returnedData2

  paletteAutoLblIdx = tiraLabelCreateNewId&("PALETTE_AUTO")
  paletteDisplayDoneLblIdx = tiraLabelCreateNewId&("PALETTE_DISPLAY_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, paletteAutoLblIdx
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, visualPageIdx
  tiraJmpId paletteDisplayDoneLblIdx

  tiraLabelId paletteAutoLblIdx
  tiraTriggerAutoDisplayId

  tiraLabelId paletteDisplayDoneLblIdx

  tiraLabelId skipLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PALETTE = 1

END FUNCTION ' parse_PALETTE

''''''''''''''''''''''''
FUNCTION parse_PCOPY (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM srcVarType AS LONG
  DIM srcVarVal AS _INTEGER64
  DIM destVarType AS LONG
  DIM destVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "PCOPY REQUIRES SOURCE AND DESTINATION", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 1, comma1 - 1, ALIM, "SOURCE PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcVarType = tiraParsedArgType
  srcVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(comma1 + 1, endIdx, ALIM, "DESTINATION PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destVarType = tiraParsedArgType
  destVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_PCOPY")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, srcVarType, srcVarVal, destVarType, destVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PCOPY = 1

END FUNCTION ' parse_PCOPY

''''''''''''''''''''''''
FUNCTION parse_PLAY (startIdx)

  parse_PLAY = parse_DELAY_Core(startIdx, 2)

END FUNCTION ' parse_PLAY

''''''''''''''''''''''''
FUNCTION parse_PRINT (startIdx)

  DIM endIdx AS LONG
  DIM suppressNewline AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM parenDepth AS LONG
  DIM tVal AS LONG
  DIM exprArgType AS LONG
  DIM exprArgVal AS _INTEGER64
  DIM castVarIdx AS LONG
  DIM fmtDescIdx AS LONG
  DIM fmtPtrIdx AS LONG
  DIM tabArgType AS LONG
  DIM tabArgVal AS _INTEGER64
  DIM curColIdx AS LONG
  DIM spacesNeededIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM csbiIdx AS LONG
  DIM coordVarIdx AS LONG
  DIM skipTabLblIdx AS LONG
  DIM isTab AS LONG
  DIM usingIdx AS LONG
  DIM isFilePrint AS LONG
  DIM fileNumStart AS LONG
  DIM fileCommaIdx AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM baseArrIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM fileModeIdx AS LONG
  DIM fileModeOkLblIdx AS LONG
  DIM fileHandleIdx AS LONG
  DIM fileHandleNotZeroLblIdx AS LONG
  DIM fileHandleValidLblIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM crlfDataIdx AS LONG
  DIM crlfLenIdx AS LONG
  DIM valVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipNegLblIdx AS LONG
  DIM loopTopLblIdx AS LONG
  DIM digitIdx AS LONG
  DIM skipDigitNegLblIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipSpaceLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM handlesArrayIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM sprintfIdx AS LONG
  DIM crlfDescIdx AS LONG
  DIM textXIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM getConsoleInfoIdx AS LONG
  DIM printStrIdx AS LONG
  DIM printFloatIdx AS LONG
  DIM printIntIdx AS LONG
  DIM crlfFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  isFilePrint = 0
  fileNumStart = startIdx + 1

  IF fileNumStart <= endIdx THEN
    IF lineTokens$(fileNumStart) = "#" THEN
      isFilePrint = 1
      fileNumStart = fileNumStart + 1
    ELSE
      IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
        isFilePrint = 1
        lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
      END IF
    END IF
  END IF

  IF isFilePrint = 1 THEN
    fileCommaIdx = findComma(fileNumStart, endIdx)

    IF fileCommaIdx = 0 THEN
      throwCompilerError "PRINT # MISSING COMMA", ASIS, 0
      EXIT FUNCTION
    END IF

    IF fileNumStart > fileCommaIdx - 1 THEN
      throwCompilerError "PRINT # MISSING FILE NUMBER", ASIS, 0
      EXIT FUNCTION
    END IF

    ensureFileStateSymbol
    IF compileError = 1 THEN EXIT FUNCTION

    ensureFileWriteBufferSymbols
    IF compileError = 1 THEN EXIT FUNCTION

    tira_Start

    ff = tiraParseExpressionIntId(fileNumStart, fileCommaIdx - 1, ALIM, "FILE NUM MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fileNumType = tiraParsedArgType
    fileNumVal = tiraParsedArgVal

    ff = resolveSymbol("!G_FLS_ARR_HANDLES")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    handlesArrayIdx = returnedData2

    baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

    slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

    fileHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId fileHandleIdx, TIRA_ARG_SYMBOL, slotAddrIdx

    fileHandleNotZeroLblIdx = tiraLabelCreateNewId&("PRINT_FILE_HANDLE_NOT_ZERO")
    fileHandleValidLblIdx = tiraLabelCreateNewId&("PRINT_FILE_HANDLE_VALID")

    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_LITERAL, 0, fileHandleNotZeroLblIdx
    tiraFatalErrorId "BAD FILE NUMBER"
    tiraLabelId fileHandleNotZeroLblIdx

    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_LITERAL, -1, fileHandleValidLblIdx
    tiraFatalErrorId "BAD FILE NUMBER"
    tiraLabelId fileHandleValidLblIdx

    ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fileStateIdx = returnedData2

    stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

    stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES

    fileModeIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId fileModeIdx, TIRA_ARG_SYMBOL, stateSlotIdx

    fileModeOkLblIdx = tiraLabelCreateNewId&("PRINT_FILE_MODE_OK")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_OUTPUT, fileModeOkLblIdx
    tiraFatalErrorId "BAD FILE MODE"
    tiraLabelId fileModeOkLblIdx

    tiraFlushFileWriteBufferId

    ff = resolveSymbol("IAT_WRITEFILE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    writeFileIdx = returnedData2

    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    suppressNewline = 0
    IF endIdx >= fileCommaIdx + 1 THEN
      tVal = lineTokenVals(endIdx)

      SELECT CASE tVal

        CASE 256 + ASC(";"), 256 + ASC(",")
          suppressNewline = 1
          endIdx = endIdx - 1

      END SELECT ' tVal

    END IF

    itemStart = fileCommaIdx + 1

    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      parenDepth = 0

      FOR ii = itemStart TO endIdx
        tVal = lineTokenVals(ii)
        IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
        IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

        IF parenDepth = 0 THEN
          IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
            itemEnd = ii - 1
            EXIT FOR
          END IF
        END IF
      NEXT

      IF itemEnd >= itemStart THEN
        ff = tiraParseExpressionId(itemStart, itemEnd, ALIM)
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        exprArgType = tiraParsedArgType
        exprArgVal = tiraParsedArgVal

        IF exprIs.DataType = TYPE_STRING THEN
          strDataIdx = tiraGetStringDataId&(exprArgType, exprArgVal)
          strLenIdx = tiraGetStringLenId&(exprArgType, exprArgVal)
        ELSE
          IF exprIs.DataType = TYPE_SINGLE OR exprIs.DataType = TYPE_DOUBLE THEN
            ' Determine format string based on original datatype BEFORE cast
            IF exprIs.DataType = TYPE_SINGLE THEN
              ff = resolveSymbol("!G_INO_DSC_FMT_G_SNG")
            ELSE
              ff = resolveSymbol("!G_INO_DSC_FMT_G_DBL")
            END IF
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            fmtDescIdx = returnedData2

            ' Safely promote Singles to Doubles for the sprintf varargs requirement
            IF exprIs.DataType = TYPE_SINGLE THEN
              castVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
              tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, castVarIdx, exprArgType, exprArgVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
              exprArgType = TIRA_ARG_SYMBOL
              exprArgVal = castVarIdx
            END IF

            strDataIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 64)
            fmtPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, fmtDescIdx)

            ff = resolveSymbol("IAT_SPRINTF")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            sprintfIdx = returnedData2

            tiraCallId3 sprintfIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, fmtPtrIdx, exprArgType, exprArgVal

            strLenIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraGetRetId strLenIdx
          ELSE
            ' Reserve an integer buffer and build the formatted value backward
            basePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 32)

            strDataIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32

            valVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraAssignId valVarIdx, exprArgType, exprArgVal

            isNegIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

            skipNegLblIdx = tiraLabelCreateNewId&("PRINT_FILE_INT_SKIP_NEG")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, skipNegLblIdx
            tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
            tiraLabelId skipNegLblIdx

            ' Add the trailing space required by PRINT formatting
            tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 1
            tiraWriteMemId TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1

            loopTopLblIdx = tiraLabelCreateNewId&("PRINT_FILE_INT_LOOP")
            tiraLabelId loopTopLblIdx

            digitIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

            skipDigitNegLblIdx = tiraLabelCreateNewId&("PRINT_FILE_INT_SKIP_DNEG")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 0, skipDigitNegLblIdx
            tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, digitIdx
            tiraLabelId skipDigitNegLblIdx

            charVarIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48

            tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 1
            tiraWriteMemId TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

            tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10
            tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, loopTopLblIdx

            ' Add the leading minus sign or space required by PRINT formatting
            tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 1

            skipSpaceLblIdx = tiraLabelCreateNewId&("PRINT_FILE_INT_SKIP_SPACE")
            tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, skipSpaceLblIdx
            tiraWriteMemId TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 45, TIRA_ARG_LITERAL, 1

            jmpDoneLblIdx = tiraLabelCreateNewId&("PRINT_FILE_INT_DONE")
            tiraJmpId jmpDoneLblIdx

            tiraLabelId skipSpaceLblIdx
            tiraWriteMemId TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1
            tiraLabelId jmpDoneLblIdx

            strLenIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32
            tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, strDataIdx
          END IF
        END IF

        tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
      END IF

      itemStart = itemEnd + 2
    LOOP

    IF suppressNewline = 0 THEN
      ff = resolveSymbol("!G_INO_DSC_CRLF")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      crlfDescIdx = returnedData2

      crlfDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, crlfDescIdx)
      crlfLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, crlfDescIdx)

      tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_SYMBOL, crlfDataIdx, TIRA_ARG_SYMBOL, crlfLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
    END IF

    tiraScheduleHeapResetId
    tira_EndAndProcess

    parse_PRINT = 1
    EXIT FUNCTION
  END IF

  usingIdx = 0
  parenDepth = 0

  FOR ii = startIdx + 1 TO endIdx
    tVal = lineTokenVals(ii)
    IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
    IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

    IF parenDepth = 0 AND tVal = 0 THEN
      IF UCASE$(lineTokens$(ii)) = "USING" THEN
        usingIdx = ii
        EXIT FOR
      END IF
    END IF
  NEXT

  IF usingIdx > 0 THEN
    parse_PRINT = parse_PRINT_USING(startIdx, usingIdx)
    EXIT FUNCTION
  END IF

  suppressNewline = 0
  IF endIdx >= startIdx + 1 THEN
    tVal = lineTokenVals(endIdx)

    SELECT CASE tVal

      CASE 256 + ASC(";"), 256 + ASC(",")
        suppressNewline = 1
        endIdx = endIdx - 1

    END SELECT ' tVal

  END IF

  tira_Start

  IF endIdx < startIdx + 1 THEN
    IF suppressNewline = 0 THEN
      ff = resolveSymbol("RT_CRLF")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      crlfFuncIdx = returnedData2
      tiraCallId0 crlfFuncIdx
    END IF
  ELSE
    itemStart = startIdx + 1
    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      parenDepth = 0
      FOR ii = itemStart TO endIdx
        tVal = lineTokenVals(ii)
        IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
        IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1
        IF parenDepth = 0 THEN
          IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
            itemEnd = ii - 1
            EXIT FOR
          END IF
        END IF
      NEXT

      IF itemEnd >= itemStart THEN
        isTab = 0

        IF lineTokenVals(itemStart) = TOK_TAB THEN
          isTab = 1
        END IF

        IF isTab = 1 THEN
          IF checkIntrinsicSyntax(itemStart, itemEnd, "TAB", 3) = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          ff = tiraParseExpressionIntId(itemStart + 2, itemEnd - 1, ALIM, "TAB REQUIRES NUMERIC ARGUMENT")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          tabArgType = tiraParsedArgType
          tabArgVal = tiraParsedArgVal

          curColIdx = tiraDimVarId&("T", TYPE_LONG)
          IF cm.HasGraphics = 1 THEN
            ff = resolveSymbol("!G_INO_VAL_TEXT_X")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            textXIdx = returnedData2

            tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_LITERAL, 8
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_LITERAL, 1
          ELSE
            ff = resolveSymbol("IAT_GETSTDHANDLE")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            getStdHandleIdx = returnedData2

            hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
            tiraGetRetId hndVarIdx

            csbiIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)

            ff = resolveSymbol("IAT_GETCONSOLESCREENBUFFERINFO")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            getConsoleInfoIdx = returnedData2

            tiraCallId2 getConsoleInfoIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, csbiIdx

            coordVarIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId coordVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 4

            tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 65535
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_SYMBOL, curColIdx, TIRA_ARG_LITERAL, 1
          END IF

          spacesNeededIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, spacesNeededIdx, tabArgType, tabArgVal, TIRA_ARG_SYMBOL, curColIdx

          skipTabLblIdx = tiraLabelCreateNewId&("SKIP_TAB")
          tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, spacesNeededIdx, TIRA_ARG_LITERAL, 0, skipTabLblIdx

          dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, spacesNeededIdx)
          tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, spacesNeededIdx

          descPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
          tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, spacesNeededIdx, TIRA_ARG_LITERAL, 0

          ff = resolveSymbol("RT_PRINT_STR")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          printStrIdx = returnedData2

          tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, descPtrIdx

          tiraLabelId skipTabLblIdx

        ELSE
          ff = tiraParseExpressionId(itemStart, itemEnd, ALIM)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          exprArgType = tiraParsedArgType
          exprArgVal = tiraParsedArgVal

          IF exprIs.DataType = TYPE_STRING THEN
            ff = resolveSymbol("RT_PRINT_STR")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            printStrIdx = returnedData2

            tiraCallId1 printStrIdx, exprArgType, exprArgVal
          ELSE
            IF exprIs.DataType = TYPE_SINGLE OR exprIs.DataType = TYPE_DOUBLE THEN
              ' Determine format string based on original datatype BEFORE cast
              IF exprIs.DataType = TYPE_SINGLE THEN
                ff = resolveSymbol("!G_INO_DSC_FMT_G_SNG")
              ELSE
                ff = resolveSymbol("!G_INO_DSC_FMT_G_DBL")
              END IF
              IF ff = 0 THEN
                tira_Cancel
                EXIT FUNCTION
              END IF
              fmtDescIdx = returnedData2

              ' Safely promote Singles to Doubles for the RT_PRINT_FLOAT varargs requirement
              IF exprIs.DataType = TYPE_SINGLE THEN
                castVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
                tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, castVarIdx, exprArgType, exprArgVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
                exprArgType = TIRA_ARG_SYMBOL
                exprArgVal = castVarIdx
              END IF

              ff = resolveSymbol("RT_PRINT_FLOAT")
              IF ff = 0 THEN
                tira_Cancel
                EXIT FUNCTION
              END IF
              printFloatIdx = returnedData2

              tiraCallId2 printFloatIdx, exprArgType, exprArgVal, TIRA_ARG_SYMBOL, fmtDescIdx
            ELSE
              ff = resolveSymbol("RT_PRINT_INT")
              IF ff = 0 THEN
                tira_Cancel
                EXIT FUNCTION
              END IF
              printIntIdx = returnedData2

              tiraCallId1 printIntIdx, exprArgType, exprArgVal
            END IF
          END IF
        END IF
      END IF

      itemStart = itemEnd + 2
    LOOP

    IF suppressNewline = 0 THEN
      ff = resolveSymbol("RT_CRLF")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      crlfFuncIdx = returnedData2

      tiraCallId0 crlfFuncIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PRINT = 1

END FUNCTION ' parse_PRINT

''''''''''''''''''''''''
FUNCTION parse_PRINT_USING (startIdx, usingIdx)

  DIM endIdx AS LONG
  DIM prefixStart AS LONG
  DIM prefixEnd AS LONG
  DIM prefixSeparator AS LONG
  DIM templateStart AS LONG
  DIM templateEnd AS LONG
  DIM templateSeparator AS LONG
  DIM valueStart AS LONG
  DIM valueEnd AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM parenDepth AS LONG
  DIM tokenVal AS LONG
  DIM trailingSeparator AS LONG
  DIM valueType AS LONG
  DIM prefixType AS LONG
  DIM prefixVal AS _INTEGER64
  DIM templateType AS LONG
  DIM templateVal AS _INTEGER64
  DIM valueArgType AS LONG
  DIM valueArgVal AS _INTEGER64
  DIM rtPrintStrIdx AS LONG
  DIM rtPrintUsingIdx AS LONG
  DIM rtCrlfIdx AS LONG
  DIM templateDataIdx AS LONG
  DIM templateLenIdx AS LONG
  DIM templateCopyDataIdx AS LONG
  DIM templateCopyDescIdx AS LONG
  DIM formatPosIdx AS LONG
  DIM formatPosPtrIdx AS LONG
  DIM zeroIntIdx AS LONG
  DIM zeroDoubleIdx AS LONG
  DIM castVarIdx AS LONG

  endIdx = lineTokenCount - 1

  prefixStart = startIdx + 1
  prefixEnd = usingIdx - 1
  prefixSeparator = 0

  IF prefixEnd >= prefixStart THEN
    tokenVal = lineTokenVals(prefixEnd)
    IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
      prefixSeparator = tokenVal
      prefixEnd = prefixEnd - 1
    END IF
  END IF

  IF prefixSeparator <> 0 AND prefixEnd < prefixStart THEN
    throwCompilerError "PRINT USING HAS AN EMPTY LEADING ITEM", ASIS, 0
    EXIT FUNCTION
  END IF

  templateStart = usingIdx + 1
  IF templateStart > endIdx THEN
    throwCompilerError "PRINT USING REQUIRES A TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  templateSeparator = 0
  parenDepth = 0
  FOR ii = templateStart TO endIdx
    tokenVal = lineTokenVals(ii)
    IF tokenVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
    IF tokenVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1
    IF parenDepth = 0 THEN
      IF tokenVal = 256 + ASC(",") THEN
        throwCompilerError "PRINT USING REQUIRES ; AFTER THE TEMPLATE", ASIS, 0
        EXIT FUNCTION
      END IF
      IF tokenVal = 256 + ASC(";") THEN
        templateSeparator = ii
        EXIT FOR
      END IF
    END IF
  NEXT

  IF templateSeparator = 0 THEN
    throwCompilerError "PRINT USING REQUIRES ; AFTER THE TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  templateEnd = templateSeparator - 1
  IF templateEnd < templateStart THEN
    throwCompilerError "PRINT USING REQUIRES A TEMPLATE", ASIS, 0
    EXIT FUNCTION
  END IF

  valueStart = templateSeparator + 1
  IF valueStart > endIdx THEN
    throwCompilerError "PRINT USING REQUIRES AT LEAST ONE VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  trailingSeparator = 0
  valueEnd = endIdx
  tokenVal = lineTokenVals(valueEnd)
  IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
    trailingSeparator = tokenVal
    valueEnd = valueEnd - 1
  END IF

  IF valueEnd < valueStart THEN
    throwCompilerError "PRINT USING REQUIRES AT LEAST ONE VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tokenVal = lineTokenVals(valueEnd)
  IF tokenVal = 256 + ASC(";") OR tokenVal = 256 + ASC(",") THEN
    throwCompilerError "PRINT USING HAS AN EMPTY VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  rtPrintStrIdx = returnedData2

  ff = resolveSymbol("RT_PRINT_USING")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  rtPrintUsingIdx = returnedData2

  IF prefixEnd >= prefixStart THEN
    ff = tiraParseExpressionId(prefixStart, prefixEnd, ALIM)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    prefixType = tiraParsedArgType
    prefixVal = tiraParsedArgVal

    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "TEXT BEFORE USING MUST BE A STRING", ASIS, 0
      EXIT FUNCTION
    END IF

    tiraCallId1 rtPrintStrIdx, prefixType, prefixVal

    IF prefixSeparator = 256 + ASC(",") THEN
      tiraPrintUsingCommaZoneId rtPrintStrIdx
      IF compileError = 1 THEN EXIT FUNCTION
    END IF
  END IF

  ff = tiraParseExpressionId(templateStart, templateEnd, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  templateType = tiraParsedArgType
  templateVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "PRINT USING TEMPLATE MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  templateDataIdx = tiraGetStringDataId&(templateType, templateVal)
  templateLenIdx = tiraGetStringLenId&(templateType, templateVal)
  templateCopyDataIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, templateLenIdx)
  tiraMemcpyId TIRA_ARG_SYMBOL, templateCopyDataIdx, TIRA_ARG_SYMBOL, templateDataIdx, TIRA_ARG_SYMBOL, templateLenIdx

  templateCopyDescIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
  tiraBuildStrDescId TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, templateCopyDataIdx, TIRA_ARG_SYMBOL, templateLenIdx, TIRA_ARG_LITERAL, 0

  formatPosIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId formatPosIdx, TIRA_ARG_LITERAL, 0

  formatPosPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_SYMBOL, formatPosIdx

  zeroIntIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId zeroIntIdx, TIRA_ARG_LITERAL, 0

  zeroDoubleIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId zeroDoubleIdx, TIRA_ARG_LITERAL, 0

  itemStart = valueStart
  DO WHILE itemStart <= valueEnd
    itemEnd = valueEnd
    parenDepth = 0

    FOR ii = itemStart TO valueEnd
      tokenVal = lineTokenVals(ii)
      IF tokenVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
      IF tokenVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

      IF parenDepth = 0 THEN
        IF tokenVal = 256 + ASC(",") THEN
          throwCompilerErrorAndCancelTira "PRINT USING VALUES MUST BE SEPARATED BY ;", ASIS, 0
          EXIT FUNCTION
        END IF

        IF tokenVal = 256 + ASC(";") THEN
          itemEnd = ii - 1
          EXIT FOR
        END IF
      END IF
    NEXT

    IF itemEnd < itemStart THEN
      throwCompilerErrorAndCancelTira "PRINT USING HAS AN EMPTY VALUE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = tiraParseExpressionId(itemStart, itemEnd, ALIM)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    valueArgType = tiraParsedArgType
    valueArgVal = tiraParsedArgVal

    valueType = exprIs.DataType

    IF valueType = TYPE_STRING THEN
      tiraCallId6 rtPrintUsingIdx, TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_LITERAL, 5, TIRA_ARG_SYMBOL, zeroIntIdx, TIRA_ARG_SYMBOL, zeroDoubleIdx, valueArgType, valueArgVal
    ELSE
      IF valueType = TYPE_SINGLE OR valueType = TYPE_DOUBLE THEN
        IF valueType = TYPE_SINGLE THEN
          castVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
          tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, castVarIdx, valueArgType, valueArgVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
          valueArgType = TIRA_ARG_SYMBOL
          valueArgVal = castVarIdx
          tiraCallId6 rtPrintUsingIdx, TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_LITERAL, 3, TIRA_ARG_SYMBOL, zeroIntIdx, valueArgType, valueArgVal, TIRA_ARG_LITERAL, 0
        ELSE
          tiraCallId6 rtPrintUsingIdx, TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_LITERAL, 4, TIRA_ARG_SYMBOL, zeroIntIdx, valueArgType, valueArgVal, TIRA_ARG_LITERAL, 0
        END IF
      ELSE
        IF valueType = TYPE_UBYTE OR valueType = TYPE_UINTEGER OR valueType = TYPE_ULONG OR valueType = TYPE_UINT64 THEN
          tiraCallId6 rtPrintUsingIdx, TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_LITERAL, 2, valueArgType, valueArgVal, TIRA_ARG_SYMBOL, zeroDoubleIdx, TIRA_ARG_LITERAL, 0
        ELSE
          IF valueType = TYPE_BYTE OR valueType = TYPE_INTEGER OR valueType = TYPE_LONG OR valueType = TYPE_INTEGER64 THEN
            tiraCallId6 rtPrintUsingIdx, TIRA_ARG_SYMBOL, templateCopyDescIdx, TIRA_ARG_SYMBOL, formatPosPtrIdx, TIRA_ARG_LITERAL, 1, valueArgType, valueArgVal, TIRA_ARG_SYMBOL, zeroDoubleIdx, TIRA_ARG_LITERAL, 0
          ELSE
            throwCompilerErrorAndCancelTira "PRINT USING VALUE MUST BE STRING OR NUMERIC", ASIS, 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF

    itemStart = itemEnd + 2
  LOOP

  IF trailingSeparator = 256 + ASC(",") THEN
    tiraPrintUsingCommaZoneId rtPrintStrIdx
    IF compileError = 1 THEN EXIT FUNCTION
  ELSE
    IF trailingSeparator = 0 THEN
      ff = resolveSymbol("RT_CRLF")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      rtCrlfIdx = returnedData2

      tiraCallId0 rtCrlfIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PRINT_USING = 1

END FUNCTION ' parse_PRINT_USING

''''''''''''''''''''''''
FUNCTION parse_PSET (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM coordStart AS LONG
  DIM coordEnd AS LONG
  DIM colorStart AS LONG
  DIM colorEnd AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG
  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM cVarType AS LONG
  DIM cVarVal AS _INTEGER64
  DIM newXIdx AS LONG
  DIM newYIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM fgIdx AS LONG
  DIM colorVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM cMaskIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM pixelMask AS LONG

  pixelMask = 255

  SELECT CASE compileScreenMode

    CASE 1, 10
      pixelMask = 3

    CASE 2, 11
      pixelMask = 1

    CASE 7, 8, 9, 12
      pixelMask = 15

  END SELECT ' compileScreenMode

  endIdx = lineTokenCount - 1

  hasStep = 0
  coordStart = startIdx + 1

  IF coordStart <= endIdx THEN
    IF lineTokenVals(coordStart) = TOK_STEP THEN
      hasStep = 1
      coordStart = coordStart + 1
    END IF
  END IF

  IF coordStart > endIdx THEN
    throwCompilerError "PSET EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ' QB64 requires the coordinate pair to be enclosed in parentheses,
  ' including when STEP is used.
  IF lineTokenVals(coordStart) <> TOK_OP_LPAREN THEN
    throwCompilerError "PSET EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(coordStart, endIdx)
  IF ff = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN PSET", ASIS, 0
    EXIT FUNCTION
  END IF
  coordEnd = returnedData2

  colorStart = 0
  colorEnd = 0

  ' Anything following the coordinate pair must begin with the
  ' optional color comma.
  IF coordEnd < endIdx THEN
    IF lineTokenVals(coordEnd + 1) <> 256 + ASC(",") THEN
      throwCompilerError "PSET EXPECTS COMMA AFTER COORDINATES", ASIS, 0
      EXIT FUNCTION
    END IF

    colorStart = coordEnd + 2
    colorEnd = endIdx

    IF colorStart > colorEnd THEN
      throwCompilerError "PSET EXPECTS COLOR AFTER COMMA", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  cComma = retCoordinateBoundaries(coordStart, coordEnd)
  IF cComma = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN PSET", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  IF hasStep = 1 THEN
    newXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newXIdx, TIRA_ARG_SYMBOL, currentXIdx, xVarType, xVarVal
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = newXIdx

    newYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newYIdx, TIRA_ARG_SYMBOL, currentYIdx, yVarType, yVarVal
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = newYIdx
  END IF

  ' PSET establishes the graphics cursor used by STEP and DRAW.
  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  IF colorStart > 0 THEN
    ff = tiraParseExpressionIntId(colorStart, colorEnd, ALIM, "COLOR MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    cVarType = tiraParsedArgType
    cVarVal = tiraParsedArgVal
  ELSE
    colorVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgIdx = returnedData2

    tiraAssignId colorVarIdx, TIRA_ARG_SYMBOL, fgIdx
    cVarType = TIRA_ARG_SYMBOL
    cVarVal = colorVarIdx
  END IF

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PSET")

  ' Unsigned bounds checks reject both negative and oversized coordinates.
  tiraJmpCondId JCC_JAE, xVarType, xVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipLblIdx
  tiraJmpCondId JCC_JAE, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipLblIdx

  cMaskIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cMaskIdx, cVarType, cVarVal, TIRA_ARG_LITERAL, pixelMask

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, xVarType, xVarVal

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gfxDestIdx = returnedData2

  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, cMaskIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipLblIdx

  tiraTriggerAutoDisplayId

  tira_EndAndProcess

  parse_PSET = 1

END FUNCTION ' parse_PSET

''''''''''''''''''''''''
FUNCTION parse_PUT (startIdx)

  ' Writes data to a file or draws a stored image array to the screen

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM isFileIO AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vIdx AS LONG
  DIM elemSize AS LONG
  DIM endIdx AS LONG
  DIM putMode AS LONG
  DIM numParsedIndices AS LONG
  DIM dimEnd AS LONG
  DIM xType AS LONG
  DIM xVal AS _INTEGER64
  DIM yType AS LONG
  DIM yVal AS _INTEGER64
  DIM ptrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM totalElemsIdx AS LONG
  DIM dimItrIdx AS LONG
  DIM lblDimTopIdx AS LONG
  DIM lblDimDoneIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM byteSizeIdx AS LONG
  DIM baseAddrIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM rtPutIdx AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)

  cComma = 0
  IF comma1 > 0 THEN
    cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  END IF

  isFileIO = 0
  IF cComma = 0 THEN
    isFileIO = 1
  END IF

  IF isFileIO = 1 THEN
    parse_PUT = parse_PUT_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GRAPHICS PUT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 = 0 THEN
    throwCompilerError "PUT MISSING ARRAY VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "PUT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xType = tiraParsedArgType
  xVal = tiraParsedArgVal

  ff = tiraParseExpressionIntId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yType = tiraParsedArgType
  yVal = tiraParsedArgVal

  comma2 = findComma(comma1 + 1, endIdx)

  dimEnd = endIdx
  IF comma2 > 0 THEN dimEnd = comma2 - 1

  tokIdx = comma1 + 1
  vTok$ = lineTokens$(tokIdx)
  vName$ = UCASE$(vTok$)
  ff = resolveSymbol(vName$)
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
    throwCompilerErrorAndCancelTira "PUT TARGET MUST BE AN ARRAY", ASIS, 0
    EXIT FUNCTION
  END IF

  numParsedIndices = 0

  tokIdx = tokIdx + 1
  IF tokIdx <= dimEnd THEN
    IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
      ff = tiraParseArrayId(tokIdx, dimEnd, 0)
      IF ff = FAILURE THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ptrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, 0)
  IF ptrIdx = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  elemSize = retElementByteSize(vIdx)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  totalElemsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId totalElemsIdx, TIRA_ARG_LITERAL, 1

  dimItrIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId dimItrIdx, TIRA_ARG_LITERAL, 0
  lblDimTopIdx = tiraLabelCreateNewId&("DIM_TOP")
  lblDimDoneIdx = tiraLabelCreateNewId&("DIM_DONE")

  tiraLabelId lblDimTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, numDimsIdx, lblDimDoneIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 4

  dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblDimTopIdx

  tiraLabelId lblDimDoneIdx

  byteSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteSizeIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_LITERAL, elemSize

  baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId baseAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, byteSizeIdx

  putMode = 1
  IF comma2 > 0 THEN

    SELECT CASE lineTokenVals(comma2 + 1)

      CASE TOK_PSET
        putMode = 0
      CASE TOK_XOR
        putMode = 1
      CASE TOK_AND
        putMode = 2
      CASE TOK_OR
        putMode = 3
      CASE TOK_PRESET
        putMode = 4
      CASE ELSE
        throwCompilerErrorAndCancelTira "UNSUPPORTED GRAPHIC STYLE FOR PUT", ASIS, 0
        EXIT FUNCTION

    END SELECT ' lineTokenVals(comma2 + 1)

  END IF

  ff = resolveSymbol("RT_PUT")
  IF ff = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  rtPutIdx = returnedData2

  tiraCallId5 rtPutIdx, xType, xVal, yType, yVal, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, putMode

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PUT = SUCCESS

END FUNCTION ' parse_PUT

''''''''''''''''''''''''
FUNCTION parse_REDIM (startIdx)

  ' Reallocates memory for a dynamic array with new dimensions

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isShared AS LONG
  DIM isArray AS LONG
  DIM parenStart AS LONG
  DIM parenEnd AS LONG
  DIM commaIdx AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM evalStart AS LONG
  DIM isNum AS LONG
  DIM vIdx AS LONG
  DIM fixedLen AS LONG
  DIM dtMapped AS LONG
  DIM elemSize AS LONG
  DIM actualName$
  DIM typeData AS LONG
  DIM dynDimTotalVars(255) AS LONG
  DIM dynDimLBoundVars(255) AS LONG
  DIM numDims AS LONG
  DIM isNumArray AS LONG
  DIM totalStaticElems AS _INTEGER64
  DIM dimEnd AS LONG
  DIM tokParseIdx AS LONG
  DIM elementCount AS LONG
  DIM parsedLBoundType AS LONG
  DIM parsedLBoundVal AS _INTEGER64
  DIM lBoundVarIdx AS LONG
  DIM dynAxType AS LONG
  DIM dynAxVal AS _INTEGER64
  DIM numElemsVarIdx AS LONG
  DIM numElems64Idx AS LONG
  DIM lBoundTok$

  DIM prevIsExplicit AS LONG
  DIM prevDataType AS LONG
  DIM prevUDTIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM tokText$
  DIM firstCh$

  DIM dimOkLblIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM elemSizeVarIdx AS LONG
  DIM totalElemsIdx AS LONG
  DIM numDimsVarIdx AS LONG
  DIM prevTotalIdx AS LONG
  DIM checkDivIdx AS LONG
  DIM multOkLblIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM allocOkLblIdx AS LONG
  DIM checkAllocDivIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM arrPtrIdx AS LONG
  DIM skipOkLblIdx AS LONG
  DIM elemSizeDWordIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  isShared = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_SHARED THEN
      isShared = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  IF endIdx < tokIdx THEN
    throwCompilerError "MALFORMED REDIM", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    aTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED IDENTIFIER", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1
    isArray = ARRAY_TYPE_RUNTIME ' REDIM always maps to dynamically allocated arrays
    numDims = 0
    totalStaticElems = 1
    isNumArray = 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        parenStart = tokIdx

        ff = findMatchingParen(parenStart, endIdx)
        IF ff = 0 THEN
          throwCompilerErrorAndCancelTira "MALFORMED ARRAY DIMENSION", ASIS, 0
          EXIT FUNCTION
        END IF
        parenEnd = returnedData2

        '''' Dimension loop
        tokParseIdx = parenStart + 1
        DO
          commaIdx = findComma(tokParseIdx, parenEnd - 1)
          IF commaIdx > 0 THEN
            dimEnd = commaIdx - 1
          ELSE
            dimEnd = parenEnd - 1
          END IF

          numDims = numDims + 1
          IF numDims > 255 THEN
            throwCompilerErrorAndCancelTira "TOO MANY DIMENSIONS", ASIS, 0
            EXIT FUNCTION
          END IF

          hasTo = 0
          toIdx = 0
          ff = findNextTokenAtDepth0(tokParseIdx, dimEnd, TOK_TO)
          IF ff = 1 THEN
            hasTo = 1
            toIdx = returnedData2
          END IF

          lBoundVarIdx = tiraDimVarId&("T", TYPE_LONG)
          IF hasTo = 1 THEN
            ff = tiraParseExpressionIntId(tokParseIdx, toIdx - 1, ALIM, "ARRAY DIM MUST BE NUMERIC")
            IF ff = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            parsedLBoundType = tiraParsedArgType
            parsedLBoundVal = tiraParsedArgVal
            tiraAssignId lBoundVarIdx, parsedLBoundType, parsedLBoundVal
          ELSE
            tiraAssignId lBoundVarIdx, TIRA_ARG_LITERAL, optionBaseValue
          END IF

          evalStart = tokParseIdx
          IF hasTo = 1 THEN evalStart = toIdx + 1

          ff = tiraParseExpressionIntId(evalStart, dimEnd, ALIM, "ARRAY DIM MUST BE NUMERIC")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          dynAxType = tiraParsedArgType
          dynAxVal = tiraParsedArgVal

          numElemsVarIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, numElemsVarIdx, dynAxType, dynAxVal, TIRA_ARG_SYMBOL, lBoundVarIdx
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_LITERAL, 1

          numElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, numElems64Idx, TIRA_ARG_SYMBOL, numElemsVarIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

          dimOkLblIdx = tiraLabelCreateNewId&("DIM_OK")
          tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, numElems64Idx, TIRA_ARG_LITERAL, 0, dimOkLblIdx
          tiraFatalErrorId "INVALID ARRAY DIMENSION"
          tiraLabelId dimOkLblIdx

          dynDimLBoundVars(numDims) = lBoundVarIdx
          dynDimTotalVars(numDims) = numElems64Idx

          sizeTok$ = ""
          lBoundTok$ = LTRIM$(STR$(optionBaseValue))
          isNum = 1

          IF hasTo = 1 THEN
            lBoundTok$ = ""
            FOR ii = tokParseIdx TO toIdx - 1
              tokText$ = lineTokens$(ii)
              lBoundTok$ = lBoundTok$ + retTokenText$(tokText$)
              IF lineTokenVals(ii) = 0 THEN
                firstCh$ = LEFT$(tokText$, 1)
                IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                  isNum = 0
                END IF
              END IF
            NEXT
          END IF

          FOR ii = evalStart TO dimEnd
            tokText$ = lineTokens$(ii)
            sizeTok$ = sizeTok$ + retTokenText$(tokText$)
            IF lineTokenVals(ii) = 0 THEN
              firstCh$ = LEFT$(tokText$, 1)
              IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                isNum = 0
              END IF
            END IF
          NEXT

          IF isNum = 1 THEN
            sizeTok$ = evalMathConst$(sizeTok$)
            lBoundTok$ = evalMathConst$(lBoundTok$)

            FOR i2 = 1 TO LEN(sizeTok$)
              chCheck$ = MID$(sizeTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
            FOR i2 = 1 TO LEN(lBoundTok$)
              chCheck$ = MID$(lBoundTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
          END IF

          IF isNum = 0 OR sizeTok$ = "" OR lBoundTok$ = "" THEN
            isNumArray = 0
          ELSE
            elementCount = VAL(sizeTok$) - VAL(lBoundTok$) + 1
            IF elementCount <= 0 THEN
              throwCompilerErrorAndCancelTira "DIMENSION CANNOT BE NEGATIVE OR ZERO", ASIS, 0
              EXIT FUNCTION
            END IF
            totalStaticElems = totalStaticElems * elementCount
          END IF

          IF commaIdx > 0 THEN
            tokParseIdx = commaIdx + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF isNumArray = 0 THEN totalStaticElems = 0

        tokIdx = parenEnd + 1
      ELSE
        throwCompilerErrorAndCancelTira "REDIM REQUIRES DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    ELSE
      throwCompilerErrorAndCancelTira "REDIM REQUIRES DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(aTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    prevIsExplicit = symbols(vIdx).IsExplicit
    prevDataType = symbols(vIdx).DataType
    prevUDTIndex = symbols(vIdx).UDTIndex

    ' Catch instances where the array was already established as STATIC via DIM and throw cleanly
    IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
      IF isDummyPass = 1 THEN
        throwCompilerErrorAndCancelTira "ARRAY ALREADY DIMMED AS STATIC", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    symbols(vIdx).IsArray = isArray
    symbols(vIdx).IsExplicit = DECL_EXPLICIT
    IF isShared = 1 THEN symbols(vIdx).IsShared = 1

    symbols(vIdx).Size = totalStaticElems
    symbols(vIdx).NumDimensions = numDims

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF prevIsExplicit = DECL_EXPLICIT THEN
          IF dtMapped <> prevDataType THEN
            throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
            EXIT FUNCTION
          END IF
          IF dtMapped = TYPE_UDT THEN
            IF typeData <> prevUDTIndex THEN
              throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Since this is REDIM, free the previously allocated heap memory natively if it exists
    ' This is done AFTER setting IsArray and DataType so that Pass 5A and Pass 5B generate
    ' the exact same TIRA code and avoid a stack alignment drift error
    tiraScheduleArrayFreeId vIdx

    elemSize = retElementByteSize(vIdx)

    descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

    elemSizeVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId elemSizeVarIdx, TIRA_ARG_LITERAL, elemSize

    totalElemsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId totalElemsIdx, TIRA_ARG_LITERAL, 1

    numDimsVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId numDimsVarIdx, TIRA_ARG_LITERAL, numDims
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 12, TIRA_ARG_SYMBOL, numDimsVarIdx, TIRA_ARG_LITERAL, 4

    FOR iDim = 1 TO numDims
      tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8), TIRA_ARG_SYMBOL, dynDimLBoundVars(iDim), TIRA_ARG_LITERAL, 4
      tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim), TIRA_ARG_LITERAL, 4

      prevTotalIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId prevTotalIdx, TIRA_ARG_SYMBOL, totalElemsIdx

      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim)

      checkDivIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, checkDivIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, prevTotalIdx

      multOkLblIdx = tiraLabelCreateNewId&("MULT_OK")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, checkDivIdx, TIRA_ARG_SYMBOL, dynDimTotalVars(iDim), multOkLblIdx
      tiraFatalErrorId "ARRAY ALLOCATION OVERFLOW"
      tiraLabelId multOkLblIdx
    NEXT iDim

    allocSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, elemSizeVarIdx

    allocOkLblIdx = tiraLabelCreateNewId&("ALLOC_OK")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, elemSizeVarIdx, TIRA_ARG_LITERAL, 1, allocOkLblIdx

    checkAllocDivIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, checkAllocDivIdx, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, elemSizeVarIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, checkAllocDivIdx, TIRA_ARG_SYMBOL, totalElemsIdx, allocOkLblIdx
    tiraFatalErrorId "ARRAY ALLOCATION OVERFLOW"
    tiraLabelId allocOkLblIdx

    ff = resolveSymbol("IAT_HEAPALLOC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    heapAllocIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    processHeapIdx = returnedData2

    tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_SYMBOL, allocSizeIdx
    arrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId arrPtrIdx

    skipOkLblIdx = tiraLabelCreateNewId&("HEAP_OK")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 0, skipOkLblIdx
    tiraFatalErrorId "OUT OF MEMORY ALLOCATING ARRAY"
    tiraLabelId skipOkLblIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 8

    elemSizeDWordIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId elemSizeDWordIdx, TIRA_ARG_LITERAL, elemSize
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 8, TIRA_ARG_SYMBOL, elemSizeDWordIdx, TIRA_ARG_LITERAL, 4

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER REDIM", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_REDIM = 1

END FUNCTION ' parse_REDIM

''''''''''''''''''''''''
FUNCTION parse_RUN (startIdx)

  DIM endIdx AS LONG
  DIM imagePathIdx AS LONG
  DIM imageLengthIdx AS LONG
  DIM pathEndIdx AS LONG
  DIM startupInfoIdx AS LONG
  DIM processInfoIdx AS LONG
  DIM createResultIdx AS LONG
  DIM processHandleIdx AS LONG
  DIM threadHandleIdx AS LONG
  DIM pathFoundLblIdx AS LONG
  DIM pathReadyLblIdx AS LONG
  DIM processReadyLblIdx AS LONG
  DIM getModuleFilenameIdx AS LONG
  DIM createProcessIdx AS LONG
  DIM closeHandleIdx AS LONG
  DIM exitProcessIdx AS LONG

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "RUN")
  IF ff = 0 THEN EXIT FUNCTION

  ' Reuse CLOSE with no file numbers so buffered output is written and every BASIC file handle is released
  ff = parse_CLOSE(startIdx)
  IF ff = 0 OR compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ' Get the exact path of the running executable
  imagePathIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 32768)

  ff = resolveSymbol("IAT_GETMODULEFILENAMEA")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  getModuleFilenameIdx = returnedData2

  tiraCallId3 getModuleFilenameIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, imagePathIdx, TIRA_ARG_LITERAL, 32768
  imageLengthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId imageLengthIdx

  pathFoundLblIdx = tiraLabelCreateNewId&("RUN_PATH_FOUND")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, imageLengthIdx, TIRA_ARG_LITERAL, 0, pathFoundLblIdx
  tiraFatalErrorId "RUN COULD NOT LOCATE EXECUTABLE"
  tiraLabelId pathFoundLblIdx

  pathReadyLblIdx = tiraLabelCreateNewId&("RUN_PATH_READY")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, imageLengthIdx, TIRA_ARG_LITERAL, 32768, pathReadyLblIdx
  tiraFatalErrorId "RUN EXECUTABLE PATH IS TOO LONG"
  tiraLabelId pathReadyLblIdx

  ' Terminate the path explicitly inside the validated buffer
  pathEndIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pathEndIdx, TIRA_ARG_SYMBOL, imagePathIdx, TIRA_ARG_SYMBOL, imageLengthIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, pathEndIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ' STARTUPINFOA is 104 bytes and PROCESS_INFORMATION is 24 bytes on Win64
  startupInfoIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 104)
  processInfoIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)

  ' STARTUPINFOA.cb
  tiraWriteMemId TIRA_ARG_SYMBOL, startupInfoIdx, TIRA_ARG_LITERAL, 104, TIRA_ARG_LITERAL, 4

  ff = resolveSymbol("IAT_CREATEPROCESSA")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  createProcessIdx = returnedData2

  tiraCallId10 createProcessIdx, TIRA_ARG_SYMBOL, imagePathIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, startupInfoIdx, TIRA_ARG_SYMBOL, processInfoIdx
  createResultIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId createResultIdx

  processReadyLblIdx = tiraLabelCreateNewId&("RUN_PROCESS_READY")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, createResultIdx, TIRA_ARG_LITERAL, 0, processReadyLblIdx
  tiraFatalErrorId "RUN COULD NOT START EXECUTABLE"
  tiraLabelId processReadyLblIdx

  ' The replacement process continues independently after its returned handles are closed
  processHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId processHandleIdx, TIRA_ARG_SYMBOL, processInfoIdx

  threadHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemOffsetId threadHandleIdx, TIRA_ARG_SYMBOL, processInfoIdx, 8

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  closeHandleIdx = returnedData2

  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, threadHandleIdx
  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, processHandleIdx

  ' Bypass the normal pause epilogue because RUN is an immediate restart
  ff = resolveSymbol("IAT_EXITPROCESS")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  exitProcessIdx = returnedData2

  tiraCallId1 exitProcessIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  parse_RUN = 1

END FUNCTION ' parse_RUN

''''''''''''''''''''''''
FUNCTION parse_RESUME (startIdx)

  ' Returns execution to the line that triggered the active error handler

  DIM endIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start
  tiraScheduleHeapResetId
  tiraOpId0 TC_RESUME
  tira_EndAndProcess

  parse_RESUME = 1

END FUNCTION ' parse_RESUME

''''''''''''''''''''''''
FUNCTION parse_SCREEN (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM modeStart AS LONG
  DIM modeEnd AS LONG
  DIM activeStart AS LONG
  DIM activeEnd AS LONG
  DIM visualStart AS LONG
  DIM visualEnd AS LONG
  DIM hasMode AS LONG
  DIM hasActive AS LONG
  DIM hasVisual AS LONG
  DIM hasPageArgs AS LONG
  DIM stateChange AS LONG
  DIM textRowHeight AS LONG
  DIM activePageType AS LONG
  DIM activePageVal AS _INTEGER64
  DIM visualPageType AS LONG
  DIM visualPageVal AS _INTEGER64
  DIM invalidPageLblIdx AS LONG
  DIM validPageLblIdx AS LONG
  DIM pagingIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM frameFrontIdx AS LONG
  DIM bufferFrontIdx AS LONG
  DIM frameDisplayIdx AS LONG
  DIM bufferDisplayIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM destBufferIdx AS LONG
  DIM destCountPtrIdx AS LONG
  DIM destPageIdx AS LONG
  DIM srcFrameIdx AS LONG
  DIM srcBufferIdx AS LONG
  DIM srcCountPtrIdx AS LONG
  DIM srcPageIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM backCountIdx AS LONG
  DIM screenSpinLblIdx AS LONG
  DIM screenAcqLblIdx AS LONG
  DIM screenSpinVarIdx AS LONG
  DIM renderLockIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM lastBackgroundIdx AS LONG
  DIM defaultPaletteDescIdx AS LONG
  DIM paletteDescIdx AS LONG
  DIM srcDescPtrIdx AS LONG
  DIM srcDataAddrIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM destDataAddrIdx AS LONG
  DIM screenFbPtrIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBotIdx AS LONG
  DIM gfxViewX1Idx AS LONG
  DIM gfxViewY1Idx AS LONG
  DIM gfxViewX2Idx AS LONG
  DIM gfxViewY2Idx AS LONG
  DIM gfxViewOffsetXIdx AS LONG
  DIM gfxViewOffsetYIdx AS LONG
  DIM active0LblIdx AS LONG
  DIM active1LblIdx AS LONG
  DIM active2LblIdx AS LONG
  DIM active3LblIdx AS LONG
  DIM activeDoneLblIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM countPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM countPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM countPage3Idx AS LONG
  DIM visual0LblIdx AS LONG
  DIM visual1LblIdx AS LONG
  DIM visual2LblIdx AS LONG
  DIM visual3LblIdx AS LONG
  DIM visualDoneLblIdx AS LONG
  DIM frontCountIdx AS LONG

  IF cm.HasGraphics = 0 THEN
    parse_SCREEN = 1
    EXIT FUNCTION
  END IF

  endIdx = lineTokenCount - 1

  comma1 = 0
  comma2 = 0
  comma3 = 0
  comma4 = 0

  modeStart = startIdx + 1
  modeEnd = endIdx
  activeStart = 0
  activeEnd = -1
  visualStart = 0
  visualEnd = -1

  IF startIdx + 1 <= endIdx THEN
    comma1 = findComma(startIdx + 1, endIdx)
  END IF

  IF comma1 > 0 THEN
    modeEnd = comma1 - 1

    IF comma1 + 1 <= endIdx THEN
      comma2 = findComma(comma1 + 1, endIdx)
    END IF

    IF comma2 > 0 THEN
      activeStart = comma2 + 1
      activeEnd = endIdx

      IF activeStart <= endIdx THEN
        comma3 = findComma(activeStart, endIdx)
      END IF

      IF comma3 > 0 THEN
        activeEnd = comma3 - 1
        visualStart = comma3 + 1
        visualEnd = endIdx

        IF visualStart <= endIdx THEN
          comma4 = findComma(visualStart, endIdx)
        END IF
      END IF
    END IF
  END IF

  IF comma4 > 0 THEN
    throwCompilerError "SCREEN TAKES AT MOST 4 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  hasMode = 0
  IF modeStart <= modeEnd THEN hasMode = 1

  hasActive = 0
  IF activeStart > 0 AND activeStart <= activeEnd THEN hasActive = 1

  hasVisual = 0
  IF visualStart > 0 AND visualStart <= visualEnd THEN hasVisual = 1

  hasPageArgs = 0
  IF hasActive = 1 THEN
    hasPageArgs = 1
  ELSE
    IF hasVisual = 1 THEN hasPageArgs = 1
  END IF

  stateChange = 0
  IF hasMode = 1 THEN stateChange = 1
  IF hasPageArgs = 1 THEN stateChange = 1

  textRowHeight = 8
  IF compileScreenMode = 9 THEN textRowHeight = 14
  IF compileScreenMode = 11 OR compileScreenMode = 12 THEN textRowHeight = 16

  tira_Start

  IF hasMode = 1 THEN
    ' Evaluate the requested mode even though Pass 3 selected the output dimensions
    ff = tiraParseExpressionIntId(modeStart, modeEnd, ALIM, "SCREEN MODE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  IF hasActive = 1 THEN
    ff = tiraParseExpressionIntId(activeStart, activeEnd, ALIM, "ACTIVE PAGE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    activePageType = tiraParsedArgType
    activePageVal = tiraParsedArgVal
  END IF

  IF hasVisual = 1 THEN
    ff = tiraParseExpressionIntId(visualStart, visualEnd, ALIM, "VISUAL PAGE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageType = tiraParsedArgType
    visualPageVal = tiraParsedArgVal
  END IF

  IF hasPageArgs = 1 THEN
    invalidPageLblIdx = tiraLabelCreateNewId&("SCREEN_INVALID_PAGE")
    validPageLblIdx = tiraLabelCreateNewId&("SCREEN_VALID_PAGE")

    IF hasActive = 1 THEN
      tiraJmpCondId JCC_JL, activePageType, activePageVal, TIRA_ARG_LITERAL, 0, invalidPageLblIdx
      tiraJmpCondId JCC_JG, activePageType, activePageVal, TIRA_ARG_LITERAL, 3, invalidPageLblIdx
    END IF

    IF hasVisual = 1 THEN
      tiraJmpCondId JCC_JL, visualPageType, visualPageVal, TIRA_ARG_LITERAL, 0, invalidPageLblIdx
      tiraJmpCondId JCC_JG, visualPageType, visualPageVal, TIRA_ARG_LITERAL, 3, invalidPageLblIdx
    END IF

    tiraJmpId validPageLblIdx

    tiraLabelId invalidPageLblIdx

    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    pagingIdx = returnedData2
    tiraAssignId pagingIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageIdx = returnedData2
    tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameDisplayIdx = returnedData2
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameDisplayIdx

    ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferDisplayIdx = returnedData2
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferDisplayIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destFrameIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameBackIdx = returnedData2
    tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destBufferIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferBackIdx = returnedData2
    tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destCountPtrIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    backCountIdx = returnedData2
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx

    ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPageIdx = returnedData2
    tiraAssignId destPageIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcFrameIdx = returnedData2
    tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

    ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcBufferIdx = returnedData2
    tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

    ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcCountPtrIdx = returnedData2
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx

    ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcPageIdx = returnedData2
    tiraAssignId srcPageIdx, TIRA_ARG_LITERAL, 0

    tiraFatalErrorId "ILLEGAL FUNCTION CALL"

    tiraLabelId validPageLblIdx
  END IF

  IF stateChange = 1 THEN
    ' Protect visual pointer selection from the window paint procedure
    screenSpinLblIdx = tiraLabelCreateNewId&("SCREEN_SPIN")
    screenAcqLblIdx = tiraLabelCreateNewId&("SCREEN_ACQ")
    tiraLabelId screenSpinLblIdx
    screenSpinVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId screenSpinVarIdx, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    renderLockIdx = returnedData2
    tiraOpId3 TC_XCHG, TIRA_ARG_SYMBOL, renderLockIdx, TIRA_ARG_SYMBOL, screenSpinVarIdx, TIRA_ARG_LITERAL, 4
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, screenSpinVarIdx, TIRA_ARG_LITERAL, 0, screenAcqLblIdx

    ff = resolveSymbol("IAT_SLEEP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    sleepFuncIdx = returnedData2
    tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 0
    tiraJmpId screenSpinLblIdx
    tiraLabelId screenAcqLblIdx
  END IF

  IF hasMode = 1 THEN
    ' A mode-bearing SCREEN statement restores default page selection
    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    pagingIdx = returnedData2
    tiraAssignId pagingIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageIdx = returnedData2
    tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameDisplayIdx = returnedData2
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameDisplayIdx

    ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_DISPLAY")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferDisplayIdx = returnedData2
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferDisplayIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destFrameIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameBackIdx = returnedData2
    tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destBufferIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferBackIdx = returnedData2
    tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destCountPtrIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    backCountIdx = returnedData2
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx

    ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPageIdx = returnedData2
    tiraAssignId destPageIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcFrameIdx = returnedData2
    tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx

    ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcBufferIdx = returnedData2
    tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx

    ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcCountPtrIdx = returnedData2
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx

    ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcPageIdx = returnedData2
    tiraAssignId srcPageIdx, TIRA_ARG_LITERAL, 0

    ' SCREEN restores the default text colors before clearing the display
    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    foregroundIdx = returnedData2
    tiraAssignId foregroundIdx, TIRA_ARG_LITERAL, 15

    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBackgroundIdx = returnedData2
    tiraAssignId lastBackgroundIdx, TIRA_ARG_LITERAL, 0

    ' SCREEN restores the default palette before clearing the display
    srcDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    defaultPaletteDescIdx = returnedData2
    tiraAssignId srcDescPtrIdx, TIRA_ARG_SYMBOL, defaultPaletteDescIdx

    srcDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId srcDataAddrIdx, TIRA_ARG_SYMBOL, srcDescPtrIdx

    destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_GFX_DSC_PALETTE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    paletteDescIdx = returnedData2
    tiraAssignId destDescPtrIdx, TIRA_ARG_SYMBOL, paletteDescIdx

    destDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId destDataAddrIdx, TIRA_ARG_SYMBOL, destDescPtrIdx

    tiraMemcpyId TIRA_ARG_SYMBOL, destDataAddrIdx, TIRA_ARG_SYMBOL, srcDataAddrIdx, TIRA_ARG_LITERAL, 1024

    ' Clear the complete destination framebuffer before later GET operations can capture stale pixels
    screenFbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId screenFbPtrIdx, TIRA_ARG_SYMBOL, destFrameIdx
    tiraMemSetId TIRA_ARG_SYMBOL, screenFbPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

    tiraWriteMemId TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 4

    ' Restore the text cursor and full text viewport
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fontHeightIdx = returnedData2
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight

    ff = resolveSymbol("!G_GFX_VAL_CUR_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    currentXIdx = returnedData2
    tiraAssignId currentXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    currentYIdx = returnedData2
    tiraAssignId currentYIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textXIdx = returnedData2
    tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textYIdx = returnedData2
    tiraAssignId textYIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    viewTopIdx = returnedData2
    tiraAssignId viewTopIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    viewBotIdx = returnedData2
    tiraAssignId viewBotIdx, TIRA_ARG_LITERAL, (gfxConfig.SizeY \ textRowHeight) * textRowHeight

    ' Restore the complete graphics viewport
    ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewX1Idx = returnedData2
    tiraAssignId gfxViewX1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewY1Idx = returnedData2
    tiraAssignId gfxViewY1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewX2Idx = returnedData2
    tiraAssignId gfxViewX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewY2Idx = returnedData2
    tiraAssignId gfxViewY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewOffsetXIdx = returnedData2
    tiraAssignId gfxViewOffsetXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxViewOffsetYIdx = returnedData2
    tiraAssignId gfxViewOffsetYIdx, TIRA_ARG_LITERAL, 0
  END IF

  IF hasPageArgs = 1 THEN
    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    pagingIdx = returnedData2
    tiraAssignId pagingIdx, TIRA_ARG_LITERAL, 1

    IF hasActive = 1 THEN
      active0LblIdx = tiraLabelCreateNewId&("SCREEN_ACTIVE_0")
      active1LblIdx = tiraLabelCreateNewId&("SCREEN_ACTIVE_1")
      active2LblIdx = tiraLabelCreateNewId&("SCREEN_ACTIVE_2")
      active3LblIdx = tiraLabelCreateNewId&("SCREEN_ACTIVE_3")
      activeDoneLblIdx = tiraLabelCreateNewId&("SCREEN_ACTIVE_DONE")

      ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      destFrameIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      destBufferIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      destCountPtrIdx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      destPageIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcFrameIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcBufferIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcCountPtrIdx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcPageIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      frameBackIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bufferBackIdx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      backCountIdx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      framePage1Idx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bufferPage1Idx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      countPage1Idx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      framePage2Idx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bufferPage2Idx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      countPage2Idx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      framePage3Idx = returnedData2

      ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bufferPage3Idx = returnedData2

      ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      countPage3Idx = returnedData2

      tiraJmpCondId JCC_JE, activePageType, activePageVal, TIRA_ARG_LITERAL, 0, active0LblIdx
      tiraJmpCondId JCC_JE, activePageType, activePageVal, TIRA_ARG_LITERAL, 1, active1LblIdx
      tiraJmpCondId JCC_JE, activePageType, activePageVal, TIRA_ARG_LITERAL, 2, active2LblIdx
      tiraJmpCondId JCC_JE, activePageType, activePageVal, TIRA_ARG_LITERAL, 3, active3LblIdx

      tiraLabelId active0LblIdx
      tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
      tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx
      tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
      tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, backCountIdx
      tiraJmpId activeDoneLblIdx

      tiraLabelId active1LblIdx
      tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
      tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage1Idx
      tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
      tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, countPage1Idx
      tiraJmpId activeDoneLblIdx

      tiraLabelId active2LblIdx
      tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
      tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage2Idx
      tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
      tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, countPage2Idx
      tiraJmpId activeDoneLblIdx

      tiraLabelId active3LblIdx
      tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
      tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountPtrIdx, TIRA_ARG_SYMBOL, countPage3Idx
      tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
      tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountPtrIdx, TIRA_ARG_SYMBOL, countPage3Idx

      tiraLabelId activeDoneLblIdx
      tiraAssignId destPageIdx, activePageType, activePageVal
      tiraAssignId srcPageIdx, activePageType, activePageVal
    END IF

    IF hasVisual = 1 THEN
      ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      visualPageIdx = returnedData2
      tiraAssignId visualPageIdx, visualPageType, visualPageVal
    END IF

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferFrontIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frontCountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    frameBackIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferBackIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    backCountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    framePage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferPage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    countPage1Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    framePage2Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferPage2Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    countPage2Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    framePage3Idx = returnedData2

    ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    bufferPage3Idx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    countPage3Idx = returnedData2

    visual0LblIdx = tiraLabelCreateNewId&("SCREEN_VISUAL_0")
    visual1LblIdx = tiraLabelCreateNewId&("SCREEN_VISUAL_1")
    visual2LblIdx = tiraLabelCreateNewId&("SCREEN_VISUAL_2")
    visual3LblIdx = tiraLabelCreateNewId&("SCREEN_VISUAL_3")
    visualDoneLblIdx = tiraLabelCreateNewId&("SCREEN_VISUAL_DONE")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 0, visual0LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 1, visual1LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 2, visual2LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 3, visual3LblIdx
    tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0
    tiraJmpId visual0LblIdx

    tiraLabelId visual0LblIdx
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameBackIdx
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferBackIdx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, backCountIdx
    tiraJmpId visualDoneLblIdx

    tiraLabelId visual1LblIdx
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage1Idx
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, countPage1Idx
    tiraJmpId visualDoneLblIdx

    tiraLabelId visual2LblIdx
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage2Idx
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, countPage2Idx
    tiraJmpId visualDoneLblIdx

    tiraLabelId visual3LblIdx
    tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage3Idx
    tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, countPage3Idx

    tiraLabelId visualDoneLblIdx
  END IF

  IF stateChange = 1 THEN
    tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0
  END IF

  IF hasPageArgs = 1 THEN
    tiraRefreshVisualPageId TIRA_ARG_SYMBOL, visualPageIdx
  ELSE
    IF hasMode = 1 THEN tiraTriggerAutoDisplayId
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SCREEN = 1

END FUNCTION ' parse_SCREEN

''''''''''''''''''''''''
FUNCTION parse_SLEEP (startIdx)

  parse_SLEEP = parse_DELAY_Core(startIdx, 1)

END FUNCTION ' parse_SLEEP

''''''''''''''''''''''''
FUNCTION parse_STATIC (startIdx)

  parse_STATIC = parse_DIM_Core(startIdx, 1)

END FUNCTION ' parse_STATIC

''''''''''''''''''''''''
FUNCTION parse_STOP (startIdx)

  DIM endIdx AS LONG
  DIM endProgramIdx AS LONG
  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "STOP")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endProgramIdx = returnedData2

  tiraJmpId endProgramIdx

  tira_EndAndProcess

  parse_STOP = 1

END FUNCTION ' parse_STOP

''''''''''''''''''''''''
FUNCTION parse_STR$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM ptrIdx AS LONG
  DIM valVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipNegLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM skipDigitNegLblIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipSpaceLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "STR$", 3) = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("STR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  basePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 32)

  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32 ' start at the end of the buffer

  valVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId valVarIdx, arg1Type, arg1Val

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipNegLblIdx = tiraLabelCreateNewId&("STR_SKIP_NEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, skipNegLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipNegLblIdx

  loopTopIdx = tiraLabelCreateNewId&("STR_LOOP")
  tiraLabelId loopTopIdx

  ' digit = val MOD 10
  digitIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  skipDigitNegLblIdx = tiraLabelCreateNewId&("STR_SKIP_DNEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 0, skipDigitNegLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, digitIdx
  tiraLabelId skipDigitNegLblIdx

  ' char = digit + 48
  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48

  ' ptr = ptr - 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' val = val / 10
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  ' Apply sign or space
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  skipSpaceLblIdx = tiraLabelCreateNewId&("STR_SKIP_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 45, TIRA_ARG_LITERAL, 1 ' -
  jmpDoneLblIdx = tiraLabelCreateNewId&("STR_DONE")
  tiraJmpId jmpDoneLblIdx
  tiraLabelId skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1 ' Space
  tiraLabelId jmpDoneLblIdx

  ' Calculate final length
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, ptrIdx

  dataPtrIdx = ptrIdx

  ' Build descriptor
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_STR$ = scratchName$

END FUNCTION ' parse_STR$

''''''''''''''''''''''''
FUNCTION parse_VIEW (startIdx)

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF startIdx + 1 <= endIdx THEN
    IF lineTokenVals(startIdx + 1) = TOK_PRINT THEN
      parse_VIEW = parse_VIEW_PRINT(startIdx + 2, endIdx)
      EXIT FUNCTION
    END IF
  END IF

  parse_VIEW = parse_VIEW_GRAPHICS(startIdx + 1, endIdx)

END FUNCTION ' parse_VIEW

''''''''''''''''''''''''
FUNCTION parseAssign (startIdx)

  DIM vTokVal AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM closeParenIdx AS LONG
  DIM eqIdx AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM lhsUdtIndex AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM tempUdtIndex AS LONG
  DIM tempIsDynamicString AS LONG
  DIM tempFieldSize AS LONG
  DIM isUdtBase AS LONG
  DIM functionSubIdx AS LONG
  DIM functionReturnIdx AS LONG
  DIM assignmentSuffixType AS LONG
  DIM functionReturnType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM numParsedIndices AS LONG
  DIM iIndex AS LONG
  DIM rhsType AS LONG
  DIM rhsVal AS _INTEGER64
  DIM rhsDataType AS LONG
  DIM rhsBaseIdx AS LONG
  DIM lhsBaseIdx AS LONG
  DIM lhsDataPtrIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM rhsDataPtrIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM padLenIdx AS LONG
  DIM skipPadLblIdx AS LONG
  DIM padAddrIdx AS LONG
  DIM finalAddrIdx AS LONG
  DIM destAddrIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM sizeModeType AS LONG
  DIM sizeModeVal AS _INTEGER64

  DIM udtFieldStartIdx AS LONG
  DIM udtFieldName$
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG

  vTok$ = lineTokens$(startIdx)
  vTokVal = lineTokenVals(startIdx)

  IF vTokVal = 0 AND LEN(vTok$) > 0 THEN
    vName$ = UCASE$(vTok$)

    endIdx = lineTokenCount - 1
    tokIdx = startIdx + 1

    ' 1. Check for legacy dot variable BEFORE resolving as LHS
    DO WHILE tokIdx <= endIdx
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        IF findSymbol(vName$) THEN
          IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
        END IF
        IF cm.ClassicMode = 1 THEN
          IF tokIdx + 1 <= endIdx THEN
            vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
            tokIdx = tokIdx + 2
          ELSE
            EXIT DO
          END IF
        ELSE
          throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
          addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ' 2. Identify and validate array index boundaries
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        parenStartIdx = tokIdx
        IF findMatchingParen(tokIdx, endIdx) = 1 THEN ' Close parenthesis found
          closeParenIdx = returnedData2
        ELSE
          EXIT FUNCTION
        END IF

        tokIdx = closeParenIdx + 1
      END IF
    END IF

    ' 3. Detect and process UDT field separators iteratively (Now immune to legacy dot variables)
    udtFieldCount = 0
    udtFieldStartIdx = tokIdx
    hasField = 0
    DO WHILE tokIdx <= endIdx
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        udtFieldCount = udtFieldCount + 1
        IF udtFieldCount >= 256 THEN
          throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = tokIdx + 2 ' Skip the dot and the field name
      ELSE
        EXIT DO
      END IF
    LOOP

    ' Verify the presence of assignment operator
    IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("=") THEN EXIT FUNCTION
    eqIdx = tokIdx

    ' Match QB64 function-return suffix behavior before ordinary symbol resolution
    IF insideSub = 2 AND currentSubName$ <> "" THEN
      functionName$ = UCASE$(RTRIM$(currentSubName$))
      functionBaseName$ = functionName$

      IF RIGHT$(functionBaseName$, 2) = "&&" THEN
        functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 2)
      ELSE
        IF RIGHT$(functionBaseName$, 2) = "~&" THEN
          functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 2)
        ELSE
          functionSuffix$ = RIGHT$(functionBaseName$, 1)

          SELECT CASE functionSuffix$

            CASE "$", "#", "!", "&", "%", "~"
              functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 1)

          END SELECT ' functionSuffix$

        END IF
      END IF

      assignmentBaseName$ = vName$
      assignmentSuffix$ = ""

      IF RIGHT$(assignmentBaseName$, 2) = "&&" THEN
        assignmentSuffix$ = "&&"
        assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 2)
      ELSE
        IF RIGHT$(assignmentBaseName$, 2) = "~&" THEN
          assignmentSuffix$ = "~&"
          assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 2)
        ELSE
          assignmentSuffix$ = RIGHT$(assignmentBaseName$, 1)

          SELECT CASE assignmentSuffix$

            CASE "$", "#", "!", "&", "%", "~"
              assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 1)

            CASE ELSE
              assignmentSuffix$ = ""

          END SELECT ' assignmentSuffix$

        END IF
      END IF

      IF assignmentBaseName$ = functionBaseName$ THEN
        ff = findSubIndex(functionName$)
        IF ff = 0 THEN
          throwCompilerError "FUNCTION RETURN TARGET NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        functionSubIdx = returnedData2
        functionReturnIdx = subs(functionSubIdx).ReturnVarIdx
        functionReturnType = symbols(functionReturnIdx).DataType

        IF assignmentSuffix$ <> "" THEN
          assignmentSuffixType = TYPE_UNDEFINED

          SELECT CASE assignmentSuffix$

            CASE "$"
              assignmentSuffixType = TYPE_STRING

            CASE "#"
              assignmentSuffixType = TYPE_DOUBLE

            CASE "!"
              assignmentSuffixType = TYPE_SINGLE

            CASE "&"
              assignmentSuffixType = TYPE_LONG

            CASE "%"
              assignmentSuffixType = TYPE_INTEGER

            CASE "&&"
              assignmentSuffixType = TYPE_INTEGER64

            CASE "~", "~&"
              assignmentSuffixType = TYPE_ULONG

          END SELECT ' assignmentSuffix$

          IF assignmentSuffixType <> functionReturnType THEN
            throwCompilerError "FUNCTION RETURN SUFFIX MISMATCH: " + vName$ + " DOES NOT MATCH " + functionName$, ASIS, 0
            EXIT FUNCTION
          END IF
        END IF

        vName$ = functionName$
      END IF
    END IF

    expectedSymType = TYPE_ANY

    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN EXIT FUNCTION
    vIdx = returnedData2
    targetType = returnedData3

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    ' Extract and process UDT field metadata through nested command stack
    IF hasField = 1 THEN
      IF targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF

      tempUdtIndex = symbols(vIdx).UDTIndex
      udtOffset = 0
      tempIsDynamicString = 0

      FOR iDot = 0 TO udtFieldCount - 1
        udtFieldName$ = UCASE$(lineTokens$(udtFieldStartIdx + iDot * 2 + 1))
        uIdx = tempUdtIndex
        fieldFound = 0

        IF findUdtFieldIndex(uIdx, udtFieldName$) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(uIdx, iField).Offset
          targetType = udtFields(uIdx, iField).DataType
          tempUdtIndex = udtFields(uIdx, iField).UDTIndex
          tempFieldSize = udtFields(uIdx, iField).Size
          tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          IF findUdtFieldIndex(uIdx, udtFieldName$ + "$") THEN
            iField = returnedData2
            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
              udtOffset = udtOffset + udtFields(uIdx, iField).Offset
              targetType = udtFields(uIdx, iField).DataType
              tempUdtIndex = udtFields(uIdx, iField).UDTIndex
              tempFieldSize = udtFields(uIdx, iField).Size
              tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
              fieldFound = 1
            END IF
          END IF
        END IF

        IF fieldFound = 0 THEN
          throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
          throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF
      NEXT iDot
    END IF

    expectedSymType = TYPE_ANY

    tira_Start

    ' Parse the left side array indices
    numParsedIndices = 0
    IF hasIndex = 1 THEN
      IF tiraParseArrayId(parenStartIdx, closeParenIdx, cm.ClassicMode) = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      closeParenIdx = returnedData2
      numParsedIndices = returnedData3

      FOR iIndex = 1 TO numParsedIndices
        assignIndexScratch(iIndex).ArgType = tiraParsedArrayArgType(iIndex)
        assignIndexScratch(iIndex).ArgVal = tiraParsedArrayArgVal(iIndex)
      NEXT iIndex
    END IF

    ' Validate array dimensions against declaration status
    IF hasIndex = 1 THEN
      IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
        throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    expectedSymType = targetType

    IF targetType = TYPE_UDT THEN
      lhsUdtIndex = symbols(vIdx).UDTIndex
      IF hasField = 1 THEN lhsUdtIndex = tempUdtIndex

      ' Call the isolated helper function to evaluate and validate the right side UDT
      rhsBaseIdx = tiraParseRhsUdtBaseId&(eqIdx + 1, endIdx, lhsUdtIndex)
      IF rhsBaseIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      FOR iIndex = 1 TO numParsedIndices
        tiraParsedArrayArgType(iIndex) = assignIndexScratch(iIndex).ArgType
        tiraParsedArrayArgVal(iIndex) = assignIndexScratch(iIndex).ArgVal
      NEXT iIndex

      lhsBaseIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
      IF lhsBaseIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      ' Perform deep cloning of UDT field data
      tiraCopyUdtValueId TIRA_ARG_SYMBOL, lhsBaseIdx, TIRA_ARG_SYMBOL, rhsBaseIdx, lhsUdtIndex
      IF compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    ELSE
      ' Parse the right side scalar or string expression
      IF tiraParseExpressionId(eqIdx + 1, endIdx, cm.ClassicMode) = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      rhsType = tiraParsedArgType
      rhsVal = tiraParsedArgVal
      rhsDataType = exprIs.DataType

      IF targetType = TYPE_STRING AND rhsDataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH: ATTEMPTED ASSIGN NUM TO STRING", ASIS, 0
        EXIT FUNCTION
      END IF
      IF targetType <> TYPE_STRING AND rhsDataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH: ATTEMPTED ASSIGN STRING TO NUM", ASIS, 0
        EXIT FUNCTION
      END IF

      IF targetType = TYPE_STRING THEN
        isFixedStr = 0
        destLen = 0
        IF hasField = 1 THEN
          IF tempIsDynamicString = 0 THEN
            isFixedStr = 1
            destLen = tempFieldSize
          END IF
        ELSE
          destLen = retFixedStringLength(vIdx)
          IF destLen > 0 THEN
            isFixedStr = 1
          END IF
        END IF

        IF isFixedStr = 1 THEN
          lhsDataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          IF hasField = 0 AND numParsedIndices = 0 THEN
            lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, vIdx
            tiraReadMemId lhsDataPtrIdx, TIRA_ARG_SYMBOL, lhsDescPtrIdx
          ELSE
            FOR iIndex = 1 TO numParsedIndices
              tiraParsedArrayArgType(iIndex) = assignIndexScratch(iIndex).ArgType
              tiraParsedArrayArgVal(iIndex) = assignIndexScratch(iIndex).ArgVal
            NEXT iIndex

            finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
            IF finalAddrIdx = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraAssignId lhsDataPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
          END IF

          rhsDataPtrIdx = tiraGetStringDataId&(rhsType, rhsVal)
          rhsLenIdx = tiraGetStringLenId&(rhsType, rhsVal)

          minLenIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
          tiraClampId minLenIdx, TA_EMPTY, 0, TIRA_ARG_LITERAL, destLen

          tiraMemcpyId TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, rhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx

          padLenIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, destLen, TIRA_ARG_SYMBOL, minLenIdx
          skipPadLblIdx = tiraLabelCreateNewId&("SKIP_PAD")
          tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, 0, skipPadLblIdx

          padAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx
          tiraMemSetId TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, padLenIdx

          tiraLabelId skipPadLblIdx
        ELSE
          lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          IF hasField = 0 AND numParsedIndices = 0 THEN
            tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, vIdx
          ELSE
            FOR iIndex = 1 TO numParsedIndices
              tiraParsedArrayArgType(iIndex) = assignIndexScratch(iIndex).ArgType
              tiraParsedArrayArgVal(iIndex) = assignIndexScratch(iIndex).ArgVal
            NEXT iIndex

            finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
            IF finalAddrIdx = 0 THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraReadMemId lhsDescPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx

            tiraEnsureStringAllocId lhsDescPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
          END IF

          ff = resolveSymbol("RT_STR_ASSIGN")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          strAssignIdx = returnedData2
          tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, lhsDescPtrIdx, rhsType, rhsVal
        END IF

      ELSE
        ' Scalar write
        IF hasIndex = 0 AND hasField = 0 THEN
          tiraAssignId vIdx, rhsType, rhsVal
        ELSE
          FOR iIndex = 1 TO numParsedIndices
            tiraParsedArrayArgType(iIndex) = assignIndexScratch(iIndex).ArgType
            tiraParsedArrayArgVal(iIndex) = assignIndexScratch(iIndex).ArgVal
          NEXT iIndex

          destAddrIdx = tiraFrontendCalcAddressId&(vIdx, numParsedIndices, udtOffset)
          IF destAddrIdx = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          SELECT CASE targetType

            CASE TYPE_BYTE, TYPE_UBYTE
              sizeModeType = TIRA_ARG_LITERAL
              sizeModeVal = 1

            CASE TYPE_INTEGER, TYPE_UINTEGER
              sizeModeType = TIRA_ARG_LITERAL
              sizeModeVal = 2

            CASE TYPE_LONG, TYPE_ULONG
              sizeModeType = TIRA_ARG_LITERAL
              sizeModeVal = 4

            CASE TYPE_SINGLE
              sizeModeType = TIRA_ARG_STR_LITERAL
              sizeModeVal = 32

            CASE TYPE_DOUBLE
              sizeModeType = TIRA_ARG_STR_LITERAL
              sizeModeVal = 64

            CASE ELSE
              sizeModeType = TIRA_ARG_LITERAL
              sizeModeVal = 8

          END SELECT ' targetType

          tiraWriteMemId TIRA_ARG_SYMBOL, destAddrIdx, rhsType, rhsVal, sizeModeType, sizeModeVal
        END IF
      END IF
    END IF

    tiraScheduleHeapResetId
    tira_EndAndProcess

    parseAssign = 1
    EXIT FUNCTION
  END IF

END FUNCTION ' parseAssign

''''''''''''''''''''''''
FUNCTION parseAssignRouter (startIdx)

  ' This routing function serves as the gateway for implict typing
  ' By detecting the '=' assignment operator *before* the variable is resolved,
  ' we enable the backend (parseAssign) to evaluate the right-hand side first.
  ' This lookahead establishes the expected type (e.g., TYPE_STRING) so that
  ' when the left-hand implicit variable is finally registered, it perfectly
  ' inherits the nature of the data being assigned to it

  ' If the line starts with an identifier (variables, arrays, function names, labels) this function acts as
  ' a probe. It scans forward, cleanly skipping over array indices (1, 2) and UDT fields .X,
  ' looking for an = sign. If it finds one, the line goes to parseAssign. If it doesn't,
  ' it returns IMPLICIT_NOT_ASSIGN to tell parseStatement to try evaluating it as a subroutine call instead.

  DIM tempSuccess AS LONG
  DIM checkIdx AS LONG
  DIM pDepth AS LONG
  DIM tVal AS LONG
  DIM assignRes AS LONG

  tempSuccess = IMPLICIT_NOT_ASSIGN
  checkIdx = startIdx + 1

  ' Fast-fail lookahead: Skip over any array parentheses
  IF checkIdx < lineTokenCount THEN
    IF lineTokenVals(checkIdx) = TOK_OP_LPAREN THEN
      ff = findMatchingParen(checkIdx, lineTokenCount - 1)
      IF ff = SUCCESS THEN
        checkIdx = returnedData2 + 1
      END IF
    END IF
  END IF

  ' Fast-fail lookahead: Skip over any number of UDT fields
  DO WHILE checkIdx < lineTokenCount
    IF lineTokenVals(checkIdx) = 256 + ASC(".") THEN
      checkIdx = checkIdx + 2 ' Skip the dot and the field name
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Check if the resulting token is an equals sign
  IF checkIdx < lineTokenCount THEN
    IF lineTokenVals(checkIdx) = TOK_OP_EQUAL THEN
      ' We found an equals sign, and thus this is definitively an assignment
      assignRes = parseAssign(startIdx)

      IF assignRes = FAILURE OR compileError = 1 THEN
        tempSuccess = IMPLICIT_FAIL
        IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
      ELSE
        tempSuccess = IMPLICIT_SUCCESS
      END IF
      parseAssignRouter = tempSuccess
      EXIT FUNCTION
    END IF
  END IF

  ' No equals sign found. Return IMPLICIT_NOT_ASSIGN so the parser can try treating it as a SUB call.
  parseAssignRouter = tempSuccess

END FUNCTION ' parseAssignRouter

''''''''''''''''''''''''
FUNCTION parseIntrinsic$ (startIdx, endIdx, allowImplicit)

  DIM tVal AS LONG
  tVal = lineTokenVals(startIdx)

  SELECT CASE tVal

    CASE TOK_ABS
      parseIntrinsic$ = parse_ABS$(startIdx, endIdx, allowImplicit)

    CASE TOK_SGN
      parseIntrinsic$ = parse_SGN$(startIdx, endIdx, allowImplicit)

    CASE TOK_HEX
      parseIntrinsic$ = parse_HEX$(startIdx, endIdx, allowImplicit)

    CASE TOK_SPACE
      parseIntrinsic$ = parse_SPACE$(startIdx, endIdx, allowImplicit)

    CASE TOK_CHR
      parseIntrinsic$ = parse_CHR$(startIdx, endIdx, ALIM) ' Extra tolerance for allowing implicit with CHR

    CASE TOK_LEN
      parseIntrinsic$ = parse_LEN$(startIdx, endIdx, allowImplicit)

    CASE TOK_ASC
      parseIntrinsic$ = parse_ASC$(startIdx, endIdx, allowImplicit)

    CASE TOK_LTRIM
      parseIntrinsic$ = parse_LTRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_RTRIM
      parseIntrinsic$ = parse_RTRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_UCASE
      parseIntrinsic$ = parse_UCASE$(startIdx, endIdx, allowImplicit)

    CASE TOK_LCASE
      parseIntrinsic$ = parse_LCASE$(startIdx, endIdx, allowImplicit)

    CASE TOK_LEFT
      parseIntrinsic$ = parse_LEFT$(startIdx, endIdx, allowImplicit)

    CASE TOK_RIGHT
      parseIntrinsic$ = parse_RIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_STR
      parseIntrinsic$ = parse_STR$(startIdx, endIdx, allowImplicit)

    CASE TOK_VAL
      parseIntrinsic$ = parse_VAL$(startIdx, endIdx, allowImplicit)

    CASE TOK_MID
      parseIntrinsic$ = parse_MID$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKD
      parseIntrinsic$ = parse_MKD$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKL
      parseIntrinsic$ = parse_MKL$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKS
      parseIntrinsic$ = parse_MKS$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKI
      parseIntrinsic$ = parse_MKI$(startIdx, endIdx, allowImplicit)

    CASE TOK_INT
      parseIntrinsic$ = parse_INT$(startIdx, endIdx, allowImplicit)

    CASE TOK_FIX
      parseIntrinsic$ = parse_FIX$(startIdx, endIdx, allowImplicit)

    CASE TOK_ATN
      parseIntrinsic$ = parse_ATN$(startIdx, endIdx, allowImplicit)

    CASE TOK_KEYDOWN
      parseIntrinsic$ = parse_KEYDOWN$(startIdx, endIdx, allowImplicit)

    CASE TOK_INKEY
      parseIntrinsic$ = parse_INKEY$(startIdx, endIdx, allowImplicit)

    CASE TOK_INPUT_STR
      parseIntrinsic$ = parse_INPUT_STR$(startIdx, endIdx, allowImplicit)

    CASE TOK_INSTR
      parseIntrinsic$ = parse_INSTR$(startIdx, endIdx, allowImplicit)

    CASE TOK_LBOUND
      parseIntrinsic$ = parse_LBOUND$(startIdx, endIdx, allowImplicit)

    CASE TOK_UBOUND
      parseIntrinsic$ = parse_UBOUND$(startIdx, endIdx, allowImplicit)

    CASE TOK_SEEK
      parseIntrinsic$ = parse_SEEK_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_LOF
      parseIntrinsic$ = parse_LOF$(startIdx, endIdx, allowImplicit)

    CASE TOK_POINT
      parseIntrinsic$ = parse_POINT$(startIdx, endIdx, allowImplicit)

    CASE TOK_RGB32
      parseIntrinsic$ = parse_RGB32$(startIdx, endIdx, allowImplicit)

    CASE TOK_PEEK
      parseIntrinsic$ = parse_PEEK$(startIdx, endIdx, allowImplicit)

    CASE TOK_RND
      parseIntrinsic$ = parse_RND$(startIdx, endIdx, allowImplicit)

    CASE TOK_SIN
      parseIntrinsic$ = parse_SIN$(startIdx, endIdx, allowImplicit)

    CASE TOK_COS
      parseIntrinsic$ = parse_COS$(startIdx, endIdx, allowImplicit)

    CASE TOK_TIMER
      parseIntrinsic$ = parse_TIMER$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEINPUT
      parseIntrinsic$ = parse_MOUSEINPUT$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEX
      parseIntrinsic$ = parse_MOUSEX$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEY
      parseIntrinsic$ = parse_MOUSEY$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEBUTTON
      parseIntrinsic$ = parse_MOUSEBUTTON$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEWHEEL
      parseIntrinsic$ = parse_MOUSEWHEEL$(startIdx, endIdx, allowImplicit)

    CASE TOK_RGB
      parseIntrinsic$ = parse_RGB$(startIdx, endIdx, allowImplicit)

    CASE TOK_MEM
      parseIntrinsic$ = parse_MEM$(startIdx, endIdx, allowImplicit)

    CASE TOK_PALETTECOLOR
      parseIntrinsic$ = parse_PALETTECOLOR_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_RED32
      parseIntrinsic$ = parse_RED32$(startIdx, endIdx, allowImplicit)

    CASE TOK_GREEN32
      parseIntrinsic$ = parse_GREEN32$(startIdx, endIdx, allowImplicit)

    CASE TOK_BLUE32
      parseIntrinsic$ = parse_BLUE32$(startIdx, endIdx, allowImplicit)

    CASE TOK_STRINGFUNC
      parseIntrinsic$ = parse_STRINGFUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_FILEEXISTS
      parseIntrinsic$ = parse_FILEEXISTS$(startIdx, endIdx, allowImplicit)

    CASE TOK_FREEFILE
      parseIntrinsic$ = parse_FREEFILE$(startIdx, endIdx, allowImplicit)

    CASE TOK_EOF
      parseIntrinsic$ = parse_EOF$(startIdx, endIdx, allowImplicit)

    CASE TOK_KEYHIT
      parseIntrinsic$ = parse_KEYHIT$(startIdx, endIdx, allowImplicit)

    CASE TOK_CLIPBOARD
      parseIntrinsic$ = parse_CLIPBOARD_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICE
      parseIntrinsic$ = parse_DEVICE$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICES
      parseIntrinsic$ = parse_DEVICES$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICEINPUT
      parseIntrinsic$ = parse_DEVICEINPUT$(startIdx, endIdx, allowImplicit)

    CASE TOK_AXIS
      parseIntrinsic$ = parse_AXIS$(startIdx, endIdx, allowImplicit)

    CASE TOK_WHEEL
      parseIntrinsic$ = parse_WHEEL$(startIdx, endIdx, allowImplicit)

    CASE TOK_BUTTON
      parseIntrinsic$ = parse_BUTTON$(startIdx, endIdx, allowImplicit)

    CASE TOK_SNDOPEN
      ' Ignore _SNDOPEN by consuming its syntax and returning a dummy nonzero literal
      IF checkIntrinsicSyntax(startIdx, endIdx, "_SNDOPEN", 3) = 0 THEN
        parseIntrinsic$ = ""
        EXIT FUNCTION
      END IF
      exprIs.DataType = TYPE_LONG
      exprIs.IsTemp = 0
      parseIntrinsic$ = "1"

    CASE TOK_CVD
      parseIntrinsic$ = parse_CVD$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVI
      parseIntrinsic$ = parse_CVI$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVL
      parseIntrinsic$ = parse_CVL$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVS
      parseIntrinsic$ = parse_CVS$(startIdx, endIdx, allowImplicit)

    CASE TOK_NEWIMAGE
      parseIntrinsic$ = parse_NEWIMAGE$(startIdx, endIdx, allowImplicit)

    CASE TOK_SCREENEXISTS
      parseIntrinsic$ = parse_SCREENEXISTS$(startIdx, endIdx, allowImplicit)

    CASE TOK_WINDOWHANDLE
      parseIntrinsic$ = parse_WINDOWHANDLE$(startIdx, endIdx, allowImplicit)

    CASE TOK_OFFSET
      parseIntrinsic$ = parse_OFFSET$(startIdx, endIdx, allowImplicit)

    CASE TOK_DESKTOPWIDTH
      parseIntrinsic$ = parse_DESKTOPWIDTH$(startIdx, endIdx, allowImplicit)

    CASE TOK_DESKTOPHEIGHT
      parseIntrinsic$ = parse_DESKTOPHEIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_HEIGHT_FUNC
      parseIntrinsic$ = parse_HEIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_WIDTH_FUNC
      parseIntrinsic$ = parse_WIDTH$(startIdx, endIdx, allowImplicit)

    CASE TOK_TRIM
      parseIntrinsic$ = parse_TRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEST
      parseIntrinsic$ = parse_DEST_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_SOURCE
      parseIntrinsic$ = parse_SOURCE_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_COPYIMAGE
      parseIntrinsic$ = parse_COPYIMAGE$(startIdx, endIdx, allowImplicit)

    CASE TOK_INP
      parseIntrinsic$ = parse_INP$(startIdx, endIdx, allowImplicit)

    CASE 717 ' TOK_VARPTR
      parseIntrinsic$ = parse_VARPTR$(startIdx, endIdx, allowImplicit)

    CASE 718 ' TOK_VARSEG
      parseIntrinsic$ = parse_VARSEG$(startIdx, endIdx, allowImplicit)

    CASE TOK_CWD
      parseIntrinsic$ = parse_CWD$(startIdx, endIdx, allowImplicit)

    CASE TOK_DIREXISTS
      parseIntrinsic$ = parse_DIREXISTS$(startIdx, endIdx, allowImplicit)

    CASE ELSE
      throwCompilerError "UNIMPLEMENTED HOISTED INTRINSIC", ASIS, 0
      parseIntrinsic$ = ""

  END SELECT ' tVal

END FUNCTION ' parseIntrinsic$

''''''''''''''''''''''''
FUNCTION parseStatement (startIdx)

  DIM tempSuccess AS LONG
  DIM tVal AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isDefFnSpace AS LONG
  DIM nameIdx AS LONG
  DIM subIdx AS LONG
  DIM hasEq AS LONG
  DIM eqIdx AS LONG
  DIM retVarIdx AS LONG
  DIM targetType AS LONG
  DIM assignRes AS LONG
  DIM vIdx AS LONG
  DIM isUnrecognized AS LONG
  DIM matchPosErr AS LONG
  DIM chunkStartErr AS LONG
  DIM chunkEndErr AS LONG
  DIM chPrevErr AS STRING * 1
  DIM chNextErr AS STRING * 1
  DIM inQuotesErr AS LONG
  DIM iScan AS LONG
  DIM chScan AS STRING * 1
  DIM isLineInput AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG
  DIM savedStackOffset AS LONG
  DIM parseFunctionResult AS LONG
  DIM wasStandardCommandParsed AS LONG
  DIM skipRoutineLblIdx AS LONG
  DIM keyEventFuncIdx AS LONG
  DIM endLblIdx AS LONG
  DIM falseLblIdx AS LONG
  DIM exprType AS LONG
  DIM exprVal AS _INTEGER64
  DIM commandNameStr$

  tempSuccess = 1

  expectedSymType = TYPE_ANY

  firstTok$ = lineTokens$(startIdx)
  tVal = lineTokenVals(startIdx)
  isUnrecognized = 0

  ' Inserts an ON KEY polling checkpoint before a BASIC statement executes
  IF isCompilingRT <> 1 THEN
    IF rtIsUsed(RT_KEY_EVENT) <> 0 THEN
      tira_Start
      ff = resolveSymbol("RT_KEY_EVENT")
      IF ff = 0 THEN
        tira_Cancel
        tempSuccess = 0
      ELSE
        keyEventFuncIdx = returnedData2
        tiraCallId0 keyEventFuncIdx
        tira_EndAndProcess
      END IF
    END IF
  END IF

  IF compileError = 1 THEN
    parseStatement = 0
    EXIT FUNCTION
  END IF

  ' Handle loop structures that need their labels emitted BEFORE intrinsic hoisting
  IF tVal = TOK_DO THEN
    IF parse_DO(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "DO", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_WHILE THEN
    IF parse_WHILE(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "WHILE", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_CASE THEN
    IF parse_CASE(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "CASE", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_ELSEIF THEN
    IF parse_ELSEIF(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "ELSEIF", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  ' DEF establishes its routine frame and scope before hoisting its right-hand expression
  IF tVal <> TOK_DEF THEN
    hoistIntrinsics
  END IF
  IF compileError = 1 THEN
    parseStatement = 0
    EXIT FUNCTION
  END IF

  ' Restore the expected symbol type to a clean slate, as intrinsic evaluations
  ' may have leaked their implicit typing lookahead values into the global scope
  expectedSymType = TYPE_ANY

  ' Re-read first token in case it was an intrinsic that got hoisted!
  firstTok$ = lineTokens$(startIdx)
  tVal = lineTokenVals(startIdx)

  parseFunctionResult = 0
  wasStandardCommandParsed = 0

  IF tVal >= 512 AND tVal <= 1024 THEN
    wasStandardCommandParsed = voc(tVal).IsStandardCmd
  END IF

  SELECT CASE tVal

    CASE TOK_WIDTH, TOK_SNDOPEN, TOK_SNDPLAY, TOK_INCLUDE, TOK_SOUND:

      ' Ignored statements

    CASE TOK_STRINGSTRICT, TOK_EMERALD, TOK_CLASSIC, TOK_GLDEFINT, TOK_NOREF, TOK_GRAPHICS:
      ' Global preprocessor directives are completely handled by Pass Zero.
      ' We gracefully skip over them during the sequential emission pass.

    CASE TOK_STATIC_META:
      defaultArrayDynamic = 0

    CASE TOK_DYNAMIC_META:
      defaultArrayDynamic = 1

    CASE TOK_ASC:
      IF parse_ASC_Assign(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "ASC ASSIGN", WITHFAILED, 0
      END IF

    CASE TOK_MID:
      IF parse_MID_Assign(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "MID$ ASSIGN", WITHFAILED, 0
      END IF

    CASE TOK_DEFINT: parseFunctionResult = parse_DEFINT(startIdx)

    CASE TOK_BEEP: parseFunctionResult = parse_BEEP(startIdx)

    CASE TOK_CALL:
      subName$ = UCASE$(lineTokens$(startIdx + 1))
      ff = findSymbol(subName$)
      IF ff = 1 THEN
        vIdx = returnedData2
      ELSE
        vIdx = -1
      END IF
      IF parseSubCall(startIdx, 1, vIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "CALL", WITHFAILED, 0
      END IF

    CASE TOK_CASE: parseFunctionResult = parse_CASE(startIdx)

    CASE TOK_CHDIR: parseFunctionResult = parse_CHDIR(startIdx)

    CASE TOK_CIRCLE: parseFunctionResult = parse_CIRCLE(startIdx)

    CASE TOK_CLEAR: parseFunctionResult = parse_CLEAR(startIdx)

    CASE TOK_CLIPBOARD: parseFunctionResult = parse_CLIPBOARD_Assign(startIdx)

    CASE TOK_CLOSE: parseFunctionResult = parse_CLOSE(startIdx)

    CASE TOK_CLS: parseFunctionResult = parse_CLS(startIdx)

    CASE TOK_COLOR: parseFunctionResult = parse_COLOR(startIdx)

    CASE TOK_COMMON: parseFunctionResult = parse_COMMON(startIdx)

    CASE TOK_DEF:
      endIdx = lineTokenCount - 1

      IF endIdx >= startIdx + 1 THEN
        IF UCASE$(lineTokens$(startIdx + 1)) = "SEG" THEN

        ELSE
          IF endIdx < startIdx + 2 THEN
            throwCompilerError "MALFORMED DEF", ASIS, 0
            tempSuccess = 0
          ELSE
            defNameTok$ = lineTokens$(startIdx + 1)
            isDefFnSpace = 0
            IF UCASE$(defNameTok$) = "FN" THEN isDefFnSpace = 1

            IF isDefFnSpace = 0 AND LEFT$(defNameTok$, 2) <> "Fn" THEN
              throwCompilerError "DEF MUST BE FOLLOWED BY FN OR Fn*()", ASIS, 0
              tempSuccess = 0
            ELSE
              nameIdx = startIdx + 1
              subName$ = UCASE$(defNameTok$)

              IF isDefFnSpace = 1 THEN
                IF endIdx >= startIdx + 2 THEN
                  nameIdx = startIdx + 2
                  subName$ = "FN" + UCASE$(lineTokens$(startIdx + 2))
                ELSE
                  throwCompilerError "MALFORMED DEF", ASIS, 0
                  tempSuccess = 0
                END IF
              END IF

              IF tempSuccess = 1 THEN
                ff = findSubIndex(subName$)
                IF ff = 0 THEN
                  throwCompilerError "DEF NOT FOUND", ASIS, 0
                  tempSuccess = 0
                ELSE
                  subIdx = returnedData2

                  hasEq = 0
                  eqIdx = 0
                  ff = findNextTokenAtDepth0(nameIdx + 1, endIdx, 256 + ASC("="))
                  IF ff = 1 THEN
                    hasEq = 1
                    eqIdx = returnedData2
                  END IF

                  IF hasEq = 0 THEN
                    throwCompilerError "DEF MISSING =", ASIS, 0
                    tempSuccess = 0
                  ELSE
                    savedStackOffset = stack.currentStackOffset
                    currentScopeID = subs(subIdx).ScopeID
                    insideSub = 2
                    currentSubName$ = subName$

                    tira_Start
                    ff = resolveSymbol("@SKIP_ROUTINE_" + subName$)
                    IF ff = 0 THEN
                      tira_Cancel
                      tempSuccess = 0
                    ELSE
                      skipRoutineLblIdx = returnedData2
                      tiraJmpId skipRoutineLblIdx
                      tiraSetSubOffsetId subIdx
                      tiraScheduleSubPrologueId
                      tira_EndAndProcess
                    END IF

                    IF compileError = 1 OR tempSuccess = 0 THEN
                      tempSuccess = 0
                    ELSE
                      hoistIntrinsics

                      IF compileError = 1 THEN
                        tempSuccess = 0
                      ELSE
                        expectedSymType = TYPE_ANY
                        endIdx = lineTokenCount - 1

                        tira_Start

                        IF tiraParseExpressionId(eqIdx + 1, endIdx, 0) = 0 THEN
                          tira_Cancel
                          tempSuccess = 0
                        ELSE
                          exprType = tiraParsedArgType
                          exprVal = tiraParsedArgVal
                          retVarIdx = subs(subIdx).ReturnVarIdx
                          targetType = symbols(retVarIdx).DataType

                          IF targetType = TYPE_STRING THEN
                            throwCompilerErrorAndCancelTira "DEF FN CANNOT RETURN STRING", ASIS, 0
                            tempSuccess = 0
                          ELSE
                            tiraAssignId retVarIdx, exprType, exprVal

                            tiraScheduleGCId
                            tiraScheduleSubEpilogueId
                            tiraLabelId skipRoutineLblIdx
                            tira_EndAndProcess
                          END IF
                        END IF
                      END IF
                    END IF

                    currentScopeID = 0
                    insideSub = 0
                    currentSubName$ = ""

                    stack.currentStackOffset = savedStackOffset
                    ff = updateStackAlignment
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      ELSE
        throwCompilerError "MALFORMED DEF", ASIS, 0
        tempSuccess = 0
      END IF

    CASE TOK_DELAY: parseFunctionResult = parse_DELAY(startIdx)

    CASE TOK_DEST: parseFunctionResult = parse_DEST(startIdx)

    CASE TOK_DIM: parseFunctionResult = parse_DIM(startIdx)

    CASE TOK_DISPLAY: parseFunctionResult = parse_DISPLAY(startIdx)

    CASE TOK_DISPLAYI: parseFunctionResult = parse_DISPLAYI(startIdx)

    CASE TOK_DRAW:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "DRAW REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_DRAW(startIdx)

    CASE TOK_DO:
      ' Handled above to prevent structural breakage

    CASE TOK_ELSE:
      endIdx = lineTokenCount - 1

      IF ctrlCount = 0 THEN
        throwCompilerError "ELSE WITHOUT IF", ASIS, 0
        EXIT FUNCTION
      END IF
      IF ctrls(ctrlCount - 1).TYPE <> CTRL_IF THEN
        throwCompilerError "ELSE WITHOUT IF", ASIS, 0
        EXIT FUNCTION
      END IF

      ifID_end = ctrls(ctrlCount - 1).Patch1
      ifID_false = ctrls(ctrlCount - 1).Patch2

      falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
      endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

      tira_Start
      tiraScheduleHeapResetId
      ff = resolveSymbol(endLbl$)
      IF ff = 0 THEN
        tira_Cancel
        tempSuccess = 0
      ELSE
        endLblIdx = returnedData2
        tiraJmpId endLblIdx

        ff = resolveSymbol(falseLbl$)
        IF ff = 0 THEN
          tira_Cancel
          tempSuccess = 0
        ELSE
          falseLblIdx = returnedData2
          tiraLabelId falseLblIdx
          tiraScheduleHeapResetId
          tira_EndAndProcess
        END IF
      END IF

      ctrls(ctrlCount - 1).TYPE = CTRL_ELSE

    CASE TOK_END: parseFunctionResult = parse_END(startIdx)

    CASE TOK_EXIT: parseFunctionResult = parse_EXIT(startIdx)

    CASE TOK_FONT:
      IF parse_FONT(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "_FONT", WITHFAILED, 0
      END IF

    CASE TOK_FOR: parseFunctionResult = parse_FOR(startIdx)

    CASE TOK_FREEIMAGE: parseFunctionResult = parse_FREEIMAGE(startIdx)

    CASE TOK_FULLSCREEN: parseFunctionResult = parse_FULLSCREEN(startIdx)

    CASE TOK_FUNCTION:
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "MALFORMED FUNCTION", ASIS, 0
        tempSuccess = 0
      ELSE
        subName$ = UCASE$(lineTokens$(startIdx + 1))
        ff = findSubIndex(subName$)
        IF ff = 0 THEN
          throwCompilerError "FUNCTION NOT FOUND", ASIS, 0
          tempSuccess = 0
        ELSE
          subIdx = returnedData2
          currentScopeID = subs(subIdx).ScopeID
          insideSub = 2
          currentSubName$ = subName$

          tira_Start
          ff = resolveSymbol("@SKIP_ROUTINE_" + subName$)
          IF ff = 0 THEN
            tira_Cancel
            tempSuccess = 0
          ELSE
            skipRoutineLblIdx = returnedData2
            tiraJmpId skipRoutineLblIdx
            tiraSetSubOffsetId subIdx
            tiraScheduleSubPrologueId
            tira_EndAndProcess
          END IF
        END IF
      END IF

    CASE TOK_GDOUBLE: parseFunctionResult = parse_GDOUBLE(startIdx)

    CASE TOK_GET: parseFunctionResult = parse_GET(startIdx)

    CASE TOK_GLOBAL: parseFunctionResult = parse_GLOBAL(startIdx)

    CASE TOK_GOSUB: parseFunctionResult = parse_GOSUB(startIdx)

    CASE TOK_GOTO: parseFunctionResult = parse_GOTO(startIdx)

    CASE TOK_IF: parseFunctionResult = parse_IF(startIdx)

    CASE TOK_INPUT: parseFunctionResult = parse_INPUT(startIdx)

    CASE TOK_KEY: parseFunctionResult = parse_KEY(startIdx)

    CASE TOK_KEYCLEAR: parseFunctionResult = parse_KEYCLEAR(startIdx)

    CASE TOK_KILL: parseFunctionResult = parse_KILL(startIdx)

    CASE TOK_LET:
      IF lineTokenVals(startIdx + 1) = TOK_ASC THEN
        IF parse_ASC_Assign(startIdx + 1) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "ASC ASSIGN", WITHFAILED, 0
        END IF
      ELSE
        IF lineTokenVals(startIdx + 1) = TOK_MID THEN
          IF parse_MID_Assign(startIdx + 1) = 0 OR compileError = 1 THEN
            tempSuccess = 0
            IF compileStatusMsg$ = "" THEN throwCompilerError "MID$ ASSIGN", WITHFAILED, 0
          END IF
        ELSE
          IF parseAssign(startIdx + 1) = 0 OR compileError = 1 THEN
            tempSuccess = 0
            IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
          END IF
        END IF
      END IF

    CASE TOK_LIMIT: parseFunctionResult = parse_LIMIT(startIdx)

    CASE TOK_MEMCOPY: parseFunctionResult = parse_MEMCOPY(startIdx)

    CASE TOK_MEMFILL: parseFunctionResult = parse_MEMFILL(startIdx)

    CASE TOK_MEMFREE: parseFunctionResult = parse_MEMFREE(startIdx)

    CASE TOK_LINE:
      isLineInput = 0
      IF startIdx + 1 <= lineTokenCount - 1 THEN
        IF lineTokenVals(startIdx + 1) = TOK_INPUT THEN
          isLineInput = 1
        END IF
      END IF

      IF isLineInput = 1 THEN
        IF parse_LINE_INPUT(startIdx) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "LINE INPUT", WITHFAILED, 0
        END IF
      ELSE
        IF cm.HasGraphics = 0 THEN
          throwCompilerError "LINE REQUIRES #GRAPHICS", ASIS, 0
          EXIT FUNCTION
        END IF
        IF parse_LINE(startIdx) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "LINE", WITHFAILED, 0
        END IF
      END IF

    CASE TOK_LOCATE: parseFunctionResult = parse_LOCATE(startIdx)

    CASE TOK_THROWERR: parseFunctionResult = parse_THROWERR(startIdx)

    CASE TOK_LOOP: parseFunctionResult = parse_LOOP(startIdx)

    CASE TOK_NEXT: parseFunctionResult = parse_NEXT(startIdx)

    CASE TOK_ON: parseFunctionResult = parse_ON(startIdx)

    CASE TOK_OPEN: parseFunctionResult = parse_OPEN(startIdx)

    CASE TOK_OUT:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "OUT REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_OUT(startIdx)

    CASE TOK_PAINT:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PAINT REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PAINT(startIdx)

    CASE TOK_PALETTE: parseFunctionResult = parse_PALETTE(startIdx)

    CASE TOK_PALETTECOLOR: parseFunctionResult = parse_PALETTECOLOR(startIdx)

    CASE TOK_PCOPY:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PCOPY REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PCOPY(startIdx)

    CASE TOK_PLAY: parseFunctionResult = parse_PLAY(startIdx)

    CASE TOK_POKE: parseFunctionResult = parse_POKE_Compat(startIdx)

    CASE TOK_PRESET:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PRESET REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PRESET(startIdx)

    CASE TOK_PRINT: parseFunctionResult = parse_PRINT(startIdx)

    CASE TOK_PRINTSTRING: parseFunctionResult = parse_PRINTSTRING(startIdx)

    CASE TOK_PSET:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PSET REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PSET(startIdx)

    CASE TOK_PUT: parseFunctionResult = parse_PUT(startIdx)

    CASE TOK_PUTIMAGE: parseFunctionResult = parse_PUTIMAGE(startIdx)

    CASE TOK_RANDOMIZE: parseFunctionResult = parse_RANDOMIZE(startIdx)

    CASE TOK_READ: parseFunctionResult = parse_READ(startIdx)

    CASE TOK_REDIM: parseFunctionResult = parse_REDIM(startIdx)

    CASE TOK_RESTORE: parseFunctionResult = parse_RESTORE(startIdx)

    CASE TOK_RESUME: parseFunctionResult = parse_RESUME(startIdx)

    CASE TOK_RETURN: parseFunctionResult = parse_RETURN(startIdx)

    CASE TOK_RUN: parseFunctionResult = parse_RUN(startIdx)

    CASE TOK_SCREEN: parseFunctionResult = parse_SCREEN(startIdx)

    CASE TOK_SLEEP: parseFunctionResult = parse_SLEEP(startIdx)

    CASE TOK_SOURCE: parseFunctionResult = parse_SOURCE(startIdx)

    CASE TOK_SCREENICON: parseFunctionResult = parse_SCREENICON(startIdx)

    CASE TOK_SELECT: parseFunctionResult = parse_SELECT(startIdx)

    CASE TOK_SEEK: parseFunctionResult = parse_SEEK(startIdx)

    CASE TOK_SHELL: parseFunctionResult = parse_SHELL(startIdx)

    CASE TOK_STATIC_VAR: parseFunctionResult = parse_STATIC(startIdx)

    CASE TOK_STOP: parseFunctionResult = parse_STOP(startIdx)

    CASE TOK_SWAP: parseFunctionResult = parse_SWAP(startIdx)

    CASE TOK_SYSTEM: parseFunctionResult = parse_SYSTEM(startIdx)

    CASE TOK_STRING:
      endIdx = lineTokenCount - 1

      IF endIdx < startIdx + 1 THEN
        throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
        tempSuccess = 0
      ELSE
        vTok$ = lineTokens$(startIdx + 1)
        IF lineTokenVals(startIdx + 1) <> 0 THEN
          throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
          tempSuccess = 0
        ELSE
          vName$ = UCASE$(vTok$)

          ff = resolveSymbol(vName$)
          IF ff = 0 THEN
            tempSuccess = 0
          ELSE
            vIdx = returnedData2

            IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
              IF symbols(vIdx).SubIndex = 0 THEN
                IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                  throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            IF endIdx >= startIdx + 2 THEN
              IF lineTokenVals(startIdx + 2) = 256 + ASC("=") THEN
                IF parseAssign(startIdx + 1) = 0 OR compileError = 1 THEN
                  tempSuccess = 0
                  IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
                END IF
              ELSE
                throwCompilerError "EXPECTED =", ASIS, 0
                tempSuccess = 0
              END IF
            END IF
          END IF
        END IF
      END IF

    CASE TOK_SUB:
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "MALFORMED SUB", ASIS, 0
        tempSuccess = 0
      ELSE
        subName$ = UCASE$(lineTokens$(startIdx + 1))
        ff = findSubIndex(subName$)
        IF ff = 0 THEN
          throwCompilerError "SUB NOT FOUND", ASIS, 0
          tempSuccess = 0
        ELSE
          subIdx = returnedData2
          currentScopeID = subs(subIdx).ScopeID
          insideSub = 1
          currentSubName$ = subName$

          tira_Start
          ff = resolveSymbol("@SKIP_ROUTINE_" + subName$)
          IF ff = 0 THEN
            tira_Cancel
            tempSuccess = 0
          ELSE
            skipRoutineLblIdx = returnedData2
            tiraJmpId skipRoutineLblIdx
            tiraSetSubOffsetId subIdx
            tiraScheduleSubPrologueId
            tira_EndAndProcess
          END IF
        END IF
      END IF

    CASE TOK_VIEW: parseFunctionResult = parse_VIEW(startIdx)

    CASE TOK_WAIT: parseFunctionResult = parse_WAIT(startIdx)

    CASE TOK_WEND: parseFunctionResult = parse_WEND(startIdx)

    CASE TOK_BLOAD: parseFunctionResult = parse_BLOAD(startIdx) ' TOK_BLOAD

    CASE TOK_BSAVE: parseFunctionResult = parse_BSAVE(startIdx) ' TOK_BSAVE

    CASE TOK_OP_EQUAL:
      tempSuccess = 0
      throwCompilerError "EXPECTED VARIABLE BEFORE =", ASIS, 0

    CASE TOK_OP_PLUS, TOK_OP_MINUS, TOK_OP_MUL, TOK_OP_DIV, TOK_OP_IDIV, TOK_OP_POW, TOK_OP_LESS, TOK_OP_GREATER, TOK_OP_LESS_EQUAL, TOK_OP_NOT_EQUAL:
      tempSuccess = 0
      throwCompilerError "EXPECTED STATEMENT, GOT OPERATOR", ASIS, 0

    CASE 0:
      IF LEN(firstTok$) > 0 THEN
        firstChar$ = LEFT$(firstTok$, 1)
        IF (firstChar$ >= "A" AND firstChar$ <= "Z") OR (firstChar$ >= "a" AND firstChar$ <= "z") OR firstChar$ = "!" OR firstChar$ = "_" THEN

          assignRes = parseAssignRouter(startIdx)
          IF assignRes <> IMPLICIT_NOT_ASSIGN THEN
            IF assignRes = IMPLICIT_FAIL THEN
              tempSuccess = 0
            END IF
          ELSE
            subName$ = UCASE$(firstTok$)
            ff = findSymbol(subName$)

            IF ff = 1 THEN
              vIdx = returnedData2
              IF symbols(vIdx).SubIndex <> 0 THEN
                IF parseSubCall(startIdx, 0, vIdx) = 0 OR compileError = 1 THEN
                  tempSuccess = 0
                  IF compileStatusMsg$ = "" THEN throwCompilerError "CALL", WITHFAILED, 0
                END IF
              ELSE
                tempSuccess = 0
                isUnrecognized = 1
              END IF
            ELSE
              tempSuccess = 0
              isUnrecognized = 1
            END IF
          END IF
        ELSE
          tempSuccess = 0
          IF firstChar$ = CHR$(34) THEN
            throwCompilerError "EXPECTED STATEMENT, GOT STRING LITERAL", ASIS, 0
          ELSE
            IF (firstChar$ >= "0" AND firstChar$ <= "9") OR firstChar$ = "." OR firstChar$ = "-" THEN
              throwCompilerError "EXPECTED STATEMENT, GOT NUMERIC LITERAL", ASIS, 0
            ELSE
              isUnrecognized = 1
            END IF
          END IF
        END IF
      ELSE
        tempSuccess = 0
        throwCompilerError "UNRECOGNIZED KEYWORD", ASIS, 0
      END IF

    CASE ELSE:
      tempSuccess = 0
      isUnrecognized = 1

  END SELECT ' tVal

  IF wasStandardCommandParsed = 1 THEN
    IF parseFunctionResult = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN
        commandNameStr$ = UCASE$(RTRIM$(retTokenText$(firstTok$)))
        throwCompilerError commandNameStr$, WITHFAILED, 0
      END IF
    END IF
  END IF

  IF isUnrecognized = 1 THEN
    errTokStr$ = retTokenText$(firstTok$)

    IF errTokStr$ <> "" THEN
      rawLineErr$ = editorText$(currentLineNumber)
      matchPosErr = 0
      inQuotesErr = 0
      FOR iScan = 1 TO LEN(rawLineErr$)
        chScan = MID$(rawLineErr$, iScan, 1)
        IF chScan = CHR$(34) THEN inQuotesErr = 1 - inQuotesErr
        IF inQuotesErr = 0 THEN
          IF MID$(rawLineErr$, iScan, LEN(errTokStr$)) = errTokStr$ THEN
            matchPosErr = iScan
            EXIT FOR
          END IF
        END IF
      NEXT

      IF matchPosErr > 0 THEN
        chunkStartErr = matchPosErr
        DO WHILE chunkStartErr > 1
          chPrevErr = MID$(rawLineErr$, chunkStartErr - 1, 1)
          IF chPrevErr = " " OR chPrevErr = CHR$(9) OR chPrevErr = ":" THEN EXIT DO
          chunkStartErr = chunkStartErr - 1
        LOOP
        chunkEndErr = matchPosErr
        DO WHILE chunkEndErr <= LEN(rawLineErr$)
          chNextErr = MID$(rawLineErr$, chunkEndErr, 1)
          IF chNextErr = " " OR chNextErr = CHR$(9) OR chNextErr = ":" THEN EXIT DO
          chunkEndErr = chunkEndErr + 1
        LOOP
        errTokStr$ = MID$(rawLineErr$, chunkStartErr, chunkEndErr - chunkStartErr)
      END IF
    END IF

    throwCompilerError "UNRECOGNIZED KEYWORD: '[" + errTokStr$ + "] RLE=" + rawLineErr$, ASIS, 0
  END IF

  IF tempSuccess = 0 OR compileError = 1 THEN
    EXIT FUNCTION
  END IF

  parseStatement = 1 ' Success

  ' Return 2 for routine boundaries that legitimately span a stack-offset change
  IF tVal = TOK_SUB OR tVal = TOK_FUNCTION THEN parseStatement = 2

  IF tVal = TOK_END THEN
    IF startIdx + 1 < lineTokenCount THEN
      IF lineTokenVals(startIdx + 1) = TOK_SUB OR lineTokenVals(startIdx + 1) = TOK_FUNCTION THEN parseStatement = 2
    END IF
  END IF

END FUNCTION ' parseStatement

''''''''''''''''''''''''
FUNCTION parseSubCall (startIdx, isExplicit, passVIdx)

  DIM targetType AS LONG
  DIM lhsUdtIndex AS LONG
  DIM argStartIdx AS LONG
  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM argIdx AS LONG
  DIM hasParens AS LONG
  DIM exprEndIdx AS LONG
  DIM hasExprEnd AS LONG
  DIM formalVarIdx AS LONG
  DIM iArg AS LONG
  DIM rhsBaseIdx AS LONG

  endIdx = lineTokenCount - 1

  IF isExplicit = 1 THEN
    argStartIdx = startIdx + 2
  ELSE
    argStartIdx = startIdx + 1
  END IF

  IF passVIdx <> -1 THEN
    vIdx = passVIdx
    subName$ = RTRIM$(symbols(vIdx).RecordName)
  ELSE
    IF isExplicit = 1 THEN
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "EXPECTED SUB NAME", ASIS, 0
        EXIT FUNCTION
      END IF
      subName$ = UCASE$(lineTokens$(startIdx + 1))
    ELSE
      subName$ = UCASE$(lineTokens$(startIdx))
    END IF
    ff = resolveSymbol(subName$)
    IF ff = FAILURE THEN EXIT FUNCTION
    vIdx = returnedData2
  END IF

  subIdx = symbols(vIdx).SubIndex
  IF subIdx = 0 THEN
    throwCompilerError "SUB NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = argStartIdx
  argIdx = 0

  hasParens = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_OP_LPAREN THEN
      IF findMatchingParen(tokIdx, endIdx) = SUCCESS THEN
        IF returnedData2 = endIdx THEN
          hasParens = 1
          tokIdx = tokIdx + 1
          endIdx = endIdx - 1
        END IF
      END IF
    END IF
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    hasExprEnd = 0
    exprEndIdx = 0
    IF findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC(",")) = SUCCESS THEN
      hasExprEnd = 1
      exprEndIdx = returnedData2
    END IF
    IF hasExprEnd = 0 THEN
      exprEndIdx = endIdx + 1
    END IF

    IF tokIdx > exprEndIdx - 1 THEN
      throwCompilerErrorAndCancelTira "MISSING ARGUMENT", ASIS, 0
      EXIT FUNCTION
    END IF

    IF argIdx >= subs(subIdx).ArgCount THEN
      throwCompilerErrorAndCancelTira "TOO MANY ARGS FOR " + subName$, ASIS, 0
      EXIT FUNCTION
    END IF

    formalVarIdx = subArgVarIdx(subIdx, argIdx)
    targetType = symbols(formalVarIdx).DataType

    IF targetType = TYPE_UDT AND symbols(formalVarIdx).IsArray <> ARRAY_TYPE_RUNTIME THEN
      lhsUdtIndex = symbols(formalVarIdx).UDTIndex

      ' Evaluate and validate the right side UDT before the call boundary is staged
      rhsBaseIdx = tiraParseRhsUdtBaseId&(tokIdx, exprEndIdx - 1, lhsUdtIndex)
      IF rhsBaseIdx = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      subCallArgScratch(argIdx).ArgType = TIRA_ARG_SYMBOL
      subCallArgScratch(argIdx).ArgVal = rhsBaseIdx
      subCallArgScratch(argIdx).DataType = TYPE_UDT
      subCallArgScratch(argIdx).AddrType = TIRA_ARG_SYMBOL
      subCallArgScratch(argIdx).AddrVal = rhsBaseIdx

      ff = resolveSymbol(UCASE$(lineTokens$(tokIdx)))
      IF ff = SUCCESS THEN
        subCallArgScratch(argIdx).VIdx = returnedData2
      ELSE
        subCallArgScratch(argIdx).VIdx = -1
      END IF

      IF tokIdx = exprEndIdx - 1 THEN
        subCallArgScratch(argIdx).IsComplex = 0
      ELSE
        subCallArgScratch(argIdx).IsComplex = 1
      END IF
    ELSE
      IF tiraParseExpressionId(tokIdx, exprEndIdx - 1, ALIM) = FAILURE THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      subCallArgScratch(argIdx).ArgType = tiraParsedArgType
      subCallArgScratch(argIdx).ArgVal = tiraParsedArgVal
      subCallArgScratch(argIdx).DataType = exprIs.DataType
      subCallArgScratch(argIdx).VIdx = shuntVal(0).VIdx
      subCallArgScratch(argIdx).IsComplex = shuntVal(0).IsComplex
      subCallArgScratch(argIdx).AddrType = tiraParsedAddrType
      subCallArgScratch(argIdx).AddrVal = tiraParsedAddrVal
    END IF

    argIdx = argIdx + 1
    tokIdx = exprEndIdx + 1
  LOOP

  IF argIdx < subs(subIdx).ArgCount THEN
    throwCompilerErrorAndCancelTira "TOO FEW ARGS FOR " + subName$, ASIS, 0
    EXIT FUNCTION
  END IF

  FOR iArg = 0 TO argIdx - 1
    shuntVal(iArg).VarName = ""
    shuntVal(iArg).ArgType = subCallArgScratch(iArg).ArgType
    shuntVal(iArg).ArgVal = subCallArgScratch(iArg).ArgVal
    shuntVal(iArg).DataType = subCallArgScratch(iArg).DataType
    shuntVal(iArg).VIdx = subCallArgScratch(iArg).VIdx
    shuntVal(iArg).IsComplex = subCallArgScratch(iArg).IsComplex
    shuntVal(iArg).AddrType = subCallArgScratch(iArg).AddrType
    shuntVal(iArg).AddrVal = subCallArgScratch(iArg).AddrVal
  NEXT iArg

  shuntOp(0).OpCode = SHUNT_SUB_CALL
  shuntOp(0).VIdx = subIdx
  shuntOp(0).ArgCount = argIdx

  IF tiraScheduleFuncOrArrayId(0, argIdx) = FAILURE THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parseSubCall = SUCCESS

END FUNCTION ' parseSubCall

''''''''''''''''''''''''
FUNCTION parseTypeClause (startTokIdx, endIdx, isUdtContext AS LONG)

  returnExtraPrepare

  DIM tempTokIdx AS LONG
  DIM tType AS LONG
  DIM dtMapped AS LONG
  DIM uTok$
  DIM sizeTok$
  DIM isNum AS LONG
  DIM fixedLen AS LONG
  DIM tempType AS LONG
  DIM typeData AS LONG
  DIM chCheck$
  DIM hasAsterisk AS LONG

  tempTokIdx = startTokIdx
  tempType = TYPE_UNDEFINED
  typeData = 0

  IF tempTokIdx <= endIdx THEN
    IF lineTokenVals(tempTokIdx) = TOK_UNSIGNED THEN
      tempTokIdx = tempTokIdx + 1
      IF tempTokIdx <= endIdx THEN
        tType = lineTokenVals(tempTokIdx)
        dtMapped = retTypeFromToken(tType, 1)

        IF dtMapped <> TYPE_UNDEFINED THEN
          tempTokIdx = tempTokIdx + 1
          tempType = dtMapped
        ELSE
          throwCompilerError "EXPECTED _BYTE, INTEGER, LONG, OR _INTEGER64 BUT GOT " + CHR$(34) + retTokenText$(lineTokens$(tempTokIdx)) + CHR$(34), ASIS, 0
        END IF
      ELSE
        throwCompilerError "EXPECTED TYPE AFTER _UNSIGNED", ASIS, 0
      END IF
    ELSE
      tType = lineTokenVals(tempTokIdx)
      dtMapped = retTypeFromToken(tType, 0)

      IF dtMapped <> TYPE_UNDEFINED THEN
        tempTokIdx = tempTokIdx + 1
        tempType = dtMapped

        SELECT CASE tType

          CASE TOK_STRINGD
            IF tempTokIdx <= endIdx THEN
              IF lineTokenVals(tempTokIdx) = TOK_OP_MUL THEN
                throwCompilerError "STRINGD CANNOT HAVE * LENGTH", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            END IF

          CASE TOK_STRING
            hasAsterisk = 0
            IF tempTokIdx <= endIdx THEN
              IF lineTokenVals(tempTokIdx) = TOK_OP_MUL THEN hasAsterisk = 1
            END IF

            IF hasAsterisk = 1 THEN
              tempTokIdx = tempTokIdx + 1
              IF tempTokIdx <= endIdx THEN
                sizeTok$ = lineTokens$(tempTokIdx)
                isNum = 1
                FOR ii = 1 TO LEN(sizeTok$)
                  chCheck$ = MID$(sizeTok$, ii, 1)
                  IF chCheck$ < "0" OR chCheck$ > "9" THEN
                    isNum = 0
                    EXIT FOR
                  END IF
                NEXT
                IF isNum = 0 THEN
                  throwCompilerError "STRING LENGTH MUST BE CONSTANT", ASIS, 0
                  tempType = TYPE_UNDEFINED
                ELSE
                  fixedLen = VAL(sizeTok$)
                  typeData = fixedLen
                  tempTokIdx = tempTokIdx + 1
                END IF
              ELSE
                throwCompilerError "EXPECTED STRING LENGTH", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            ELSE
              IF cm.StringStrict = 1 AND isUdtContext = 0 THEN
                throwCompilerError "STRING REQUIRES * LENGTH (USE STRINGD FOR DYNAMIC)", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            END IF

        END SELECT ' tType

      ELSE
        IF tType = 0 OR tType = TOK_MEM THEN ' UDT Identifier Match
          IF tType = TOK_MEM THEN
            uTok$ = "_MEM"
          ELSE
            uTok$ = UCASE$(lineTokens$(tempTokIdx))
          END IF

          IF uTok$ = "_OFFSET" THEN
            tempTokIdx = tempTokIdx + 1
            tempType = TYPE_INTEGER64
          ELSE
            ff = findUdtIndex(uTok$)
            IF ff = SUCCESS THEN
              typeData = returnedData2
              tempTokIdx = tempTokIdx + 1
              tempType = TYPE_UDT
            ELSE
              IF tType = TOK_MEM THEN
                throwCompilerError "UNSUPPORTED TYPE OR UNKNOWN UDT _MEM", ASIS, 0
              ELSE
                throwCompilerError "UNSUPPORTED TYPE OR UNKNOWN UDT " + CHR$(34) + lineTokens$(tempTokIdx) + CHR$(34), ASIS, 0
              END IF
            END IF
          END IF
        ELSE
          throwCompilerError "UNSUPPORTED TYPE " + CHR$(34) + retTokenText$(lineTokens$(tempTokIdx)) + CHR$(34), ASIS, 0
        END IF
      END IF
    END IF
  ELSE
    throwCompilerError "EXPECTED TYPE", ASIS, 0
  END IF

  return3 typeData
  return2 tempType
  parseTypeClause = tempTokIdx

END FUNCTION ' parseTypeClause

''''''''''''''
'' SUB pasteClipboardText (wStr$) ' This is found within Z_EMLINF.BLB
'
' Copies from clipboard into the editor

''''''''''''''''''''''''
SUB patch8 (wPos AS _UNSIGNED LONG)

  ' Calculates and patches an 8-bit short jump displacement
  ' Includes a safety check to prevent silent overflow crashes

  DIM patchOffset AS LONG

  patchOffset = stream.emitPos - (wPos + 1)

  IF patchOffset > 127 OR patchOffset < -128 THEN
    ESCAPETEXT "FATAL: 8-bit jump displacement out of bounds (" + LTRIM$(STR$(patchOffset)) + ") in patch8"
  END IF

  IF isMeasurePass = 1 THEN EXIT SUB

  intermediateCode(wPos) = patchOffset AND 255

END SUB ' patch8

''''''''''''''''''''''''
SUB patch32 (wPos AS LONG, wVal AS LONG)

  DIM uVal AS _UNSIGNED LONG
  DIM patchEnd AS _INTEGER64
  DIM previousByte AS LONG
  DIM previousByte2 AS LONG
  DIM isPatchField AS LONG

  patchEnd = wPos
  patchEnd = patchEnd + 3

  IF wPos <= 0 OR patchEnd >= stream.emitPos OR patchEnd >= MAX_CODE_SIZE THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 out of bounds", "OFFSET: " + LTRIM$(STR$(wPos)) + " | PATCH END: " + LTRIM$(STR$(patchEnd)) + " | EMITTED BYTES: " + LTRIM$(STR$(stream.emitPos))
    EXIT SUB
  END IF

  IF intermediateCode(wPos) <> 0 OR intermediateCode(wPos + 1) <> 0 OR intermediateCode(wPos + 2) <> 0 OR intermediateCode(wPos + 3) <> 0 THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 target was already patched or is not a placeholder", "OFFSET: " + LTRIM$(STR$(wPos))
    EXIT SUB
  END IF

  previousByte = intermediateCode(wPos - 1)
  previousByte2 = 0

  IF wPos >= 2 THEN
    previousByte2 = intermediateCode(wPos - 2)
  END IF

  isPatchField = 0

  IF (previousByte AND &HC7) = &H05 THEN
    isPatchField = 1
  END IF

  IF previousByte = &HE8 OR previousByte = &HE9 THEN
    isPatchField = 1
  END IF

  IF wPos >= 2 THEN
    IF previousByte2 = &H0F THEN
      IF previousByte >= &H80 AND previousByte <= &H8F THEN
        isPatchField = 1
      END IF
    END IF
  END IF

  IF isPatchField = 0 THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 target is not a recognized displacement field", "OFFSET: " + LTRIM$(STR$(wPos)) + " | PREVIOUS BYTE: $" + hexLen$(previousByte, 2) + " | SECOND PREVIOUS BYTE: $" + hexLen$(previousByte2, 2)
    EXIT SUB
  END IF

  uVal = wVal
  intermediateCode(wPos) = uVal AND 255
  intermediateCode(wPos + 1) = (uVal \ 256) AND 255
  intermediateCode(wPos + 2) = (uVal \ 65536) AND 255
  intermediateCode(wPos + 3) = (uVal \ 16777216) AND 255

END SUB ' patch32

''''''''''''''''''''''''
SUB prepareBinary

  ' Effectively the linker

  DIM prologueBoundary AS LONG
  DIM pOffEmit AS LONG
  DIM vIdx AS LONG
  DIM varRVA AS LONG
  DIM actualVarOffset AS LONG
  DIM ripAfter AS LONG
  DIM disp AS LONG
  DIM iatConst AS LONG
  DIM mappedIdx AS LONG
  DIM iatEntryRVA AS LONG
  DIM targetOffset AS LONG
  DIM targetSubIdx AS LONG
  DIM targetOpcode AS LONG
  DIM bssRVA AS LONG
  DIM bssCurrent AS LONG
  DIM textVirtualSize AS LONG
  DIM wTextRawSize AS LONG
  DIM localIdataRVA AS LONG
  DIM descVA AS LONG
  DIM strVA AS LONG
  DIM strLen AS LONG
  DIM gfxBufTotalSize AS LONG
  DIM userCodeLen AS LONG
  DIM userPatchCount AS LONG
  DIM userIatPatchCount AS LONG
  DIM userGotoPatchCount AS LONG
  DIM userCallPatchCount AS LONG
  DIM userRtPatchCount AS LONG
  DIM userSubCount AS LONG
  DIM userSymbolCount AS LONG
  DIM mergedCodeSize AS _INTEGER64
  DIM layoutRemainder AS LONG
  DIM sourceEnd AS _INTEGER64
  DIM targetEnd AS _INTEGER64
  DIM iLong AS _UNSIGNED LONG
  DIM i2Long AS _UNSIGNED LONG
  DIM i3Long AS _UNSIGNED LONG
  DIM copyBlockSize AS _UNSIGNED LONG
  DIM copyOffset AS _UNSIGNED LONG
  DIM copyCount AS _UNSIGNED LONG
  DIM sourceMem AS _MEM
  DIM targetMem AS _MEM

  copyBlockSize = 1048576

  compileSaveTracker "MAPPING GLOBALS", 0, symbolCount, 1

  compilePass6GlobalMap
  IF compileError = 1 THEN EXIT SUB

  outputFileIdx = 0

  rwVar$ = " " ' Necessary

  userCodeLen = stream.emitPos
  IF userCodeLen < 0 OR userCodeLen > MAX_CODE_SIZE THEN
    throwCompilerErrorNoLineNum "GENERATED MACHINE CODE EXCEEDS MAX_CODE_SIZE"
    addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(userCodeLen)) + " BYTES"
    addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
    EXIT SUB
  END IF

  compileSaveTracker "COPYING GENERATED CODE", 0, userCodeLen, 0
  REDIM userCode(userCodeLen + 1) AS _UNSIGNED _BYTE
  IF userCodeLen > 0 THEN
    sourceMem = _MEM(intermediateCode())
    targetMem = _MEM(userCode())
    copyOffset = 0

    DO WHILE copyOffset < userCodeLen
      copyCount = userCodeLen - copyOffset
      IF copyCount > copyBlockSize THEN copyCount = copyBlockSize

      sourceEnd = copyOffset
      sourceEnd = sourceEnd + copyCount
      targetEnd = sourceEnd
      IF sourceEnd > userCodeLen OR sourceEnd > sourceMem.SIZE OR targetEnd > targetMem.SIZE THEN
        _MEMFREE targetMem
        _MEMFREE sourceMem
        throwCompilerErrorNoLineNum "GENERATED CODE COPY EXCEEDS BUFFER"
        addStatusMsgContinuation "COPY OFFSET: " + LTRIM$(STR$(copyOffset))
        addStatusMsgContinuation "COPY SIZE: " + LTRIM$(STR$(copyCount)) + " BYTES"
        EXIT SUB
      END IF

      _MEMCOPY sourceMem, sourceMem.OFFSET + copyOffset, copyCount TO targetMem, targetMem.OFFSET + copyOffset
      copyOffset = copyOffset + copyCount
      compileSaveTracker "COPYING GENERATED CODE", copyOffset, userCodeLen, 0
    LOOP

    _MEMFREE targetMem
    _MEMFREE sourceMem
  END IF
  stream.emitPos = 0

  IF cm.HasGraphics = 0 THEN
    userPatchCount = patchCount
    userIatPatchCount = iatPatchCount
    userGotoPatchCount = gotoPatchCount
    userCallPatchCount = callPatchCount
    userRtPatchCount = rt.PatchCount
    userSubCount = subCount
    userSymbolCount = symbolCount

    compileSaveTracker "BUILDING PROLOGUE", 0, 0, 0
    emitPrologue
    IF compileError = 1 THEN EXIT SUB

    prologueBoundary = stream.emitPos

    ' Preflight the complete native-code image before copying the saved user code.
    ' Pass 5 only measured the runtime and user-code portion; prepareBinary adds
    ' the prologue and epilogue around it, so all three portions must fit.
    mergedCodeSize = prologueBoundary
    mergedCodeSize = mergedCodeSize + userCodeLen
    mergedCodeSize = mergedCodeSize + metrics.EpilogueSize

    IF mergedCodeSize > MAX_CODE_SIZE THEN
      throwCompilerErrorNoLineNum "GENERATED MACHINE CODE EXCEEDS MAX_CODE_SIZE"
      addStatusMsgContinuation "PROLOGUE: " + LTRIM$(STR$(prologueBoundary)) + " BYTES"
      addStatusMsgContinuation "RUNTIME + USER CODE: " + LTRIM$(STR$(userCodeLen)) + " BYTES"
      addStatusMsgContinuation "EPILOGUE: " + LTRIM$(STR$(metrics.EpilogueSize)) + " BYTES"
      addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(mergedCodeSize)) + " BYTES"
      addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
      addStatusMsgContinuation "OVER BY: " + LTRIM$(STR$(mergedCodeSize - MAX_CODE_SIZE)) + " BYTES"
      EXIT SUB
    END IF

    compileSaveTracker "SHIFTING OFFSETS", 0, 0, 0
    adjustAllPatchOffsets prologueBoundary, userPatchCount, userIatPatchCount, userGotoPatchCount, userCallPatchCount, userRtPatchCount, userSubCount, userSymbolCount

    IF userCodeLen > 0 THEN
      sourceMem = _MEM(userCode())
      targetMem = _MEM(intermediateCode())
      copyOffset = 0

      DO WHILE copyOffset < userCodeLen
        copyCount = userCodeLen - copyOffset
        IF copyCount > copyBlockSize THEN copyCount = copyBlockSize

        sourceEnd = copyOffset
        sourceEnd = sourceEnd + copyCount
        targetEnd = stream.emitPos
        targetEnd = targetEnd + copyCount

        IF stream.emitPos < 0 OR sourceEnd > userCodeLen OR sourceEnd > sourceMem.SIZE OR targetEnd > MAX_CODE_SIZE OR targetEnd > targetMem.SIZE THEN
          _MEMFREE targetMem
          _MEMFREE sourceMem
          throwCompilerErrorNoLineNum "MACHINE CODE BUFFER OVERFLOW DURING LINK"
          addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
          addStatusMsgContinuation "COPY SIZE: " + LTRIM$(STR$(copyCount)) + " BYTES"
          addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
          EXIT SUB
        END IF

        _MEMCOPY sourceMem, sourceMem.OFFSET + copyOffset, copyCount TO targetMem, targetMem.OFFSET + stream.emitPos
        stream.emitPos = stream.emitPos + copyCount
        copyOffset = copyOffset + copyCount
        compileSaveTracker "LINKING GENERATED CODE", copyOffset, userCodeLen, 0
      LOOP

      _MEMFREE targetMem
      _MEMFREE sourceMem
    END IF

  ELSE
    userPatchCount = patchCount
    userIatPatchCount = iatPatchCount
    userGotoPatchCount = gotoPatchCount
    userCallPatchCount = callPatchCount
    userRtPatchCount = rt.PatchCount
    userSubCount = subCount
    userSymbolCount = symbolCount

    compileSaveTracker "BUILDING WINDOW STARTUP", 0, 0, 0
    IF USE_DIB_SECTION = 1 THEN
      ESCAPETEXT "USE_DIB_SECTION SET TO 1, HARDWARE GRAPHICS NOT SUPPORTED YET"
    ELSE
      emitPrologueWindowSetup
    END IF
    IF compileError = 1 THEN EXIT SUB

    compileSaveTracker "BUILDING PROLOGUE", 0, 0, 0
    emitPrologue
    IF compileError = 1 THEN EXIT SUB

    prologueBoundary = stream.emitPos

    ' Preflight the complete native-code image before copying the saved user code.
    ' Pass 5 only measured the runtime and user-code portion; prepareBinary adds
    ' the prologue and epilogue around it, so all three portions must fit.
    mergedCodeSize = prologueBoundary
    mergedCodeSize = mergedCodeSize + userCodeLen
    mergedCodeSize = mergedCodeSize + metrics.EpilogueSize

    IF mergedCodeSize > MAX_CODE_SIZE THEN
      throwCompilerErrorNoLineNum "GENERATED MACHINE CODE EXCEEDS MAX_CODE_SIZE"
      addStatusMsgContinuation "PROLOGUE: " + LTRIM$(STR$(prologueBoundary)) + " BYTES"
      addStatusMsgContinuation "RUNTIME + USER CODE: " + LTRIM$(STR$(userCodeLen)) + " BYTES"
      addStatusMsgContinuation "EPILOGUE: " + LTRIM$(STR$(metrics.EpilogueSize)) + " BYTES"
      addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(mergedCodeSize)) + " BYTES"
      addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
      addStatusMsgContinuation "OVER BY: " + LTRIM$(STR$(mergedCodeSize - MAX_CODE_SIZE)) + " BYTES"
      EXIT SUB
    END IF

    compileSaveTracker "SHIFTING OFFSETS", 0, 0, 0
    adjustAllPatchOffsets prologueBoundary, userPatchCount, userIatPatchCount, userGotoPatchCount, userCallPatchCount, userRtPatchCount, userSubCount, userSymbolCount

    IF userCodeLen > 0 THEN
      sourceMem = _MEM(userCode())
      targetMem = _MEM(intermediateCode())
      copyOffset = 0

      DO WHILE copyOffset < userCodeLen
        copyCount = userCodeLen - copyOffset
        IF copyCount > copyBlockSize THEN copyCount = copyBlockSize

        sourceEnd = copyOffset
        sourceEnd = sourceEnd + copyCount
        targetEnd = stream.emitPos
        targetEnd = targetEnd + copyCount

        IF stream.emitPos < 0 OR sourceEnd > userCodeLen OR sourceEnd > sourceMem.SIZE OR targetEnd > MAX_CODE_SIZE OR targetEnd > targetMem.SIZE THEN
          _MEMFREE targetMem
          _MEMFREE sourceMem
          throwCompilerErrorNoLineNum "MACHINE CODE BUFFER OVERFLOW DURING LINK"
          addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
          addStatusMsgContinuation "COPY SIZE: " + LTRIM$(STR$(copyCount)) + " BYTES"
          addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
          EXIT SUB
        END IF

        _MEMCOPY sourceMem, sourceMem.OFFSET + copyOffset, copyCount TO targetMem, targetMem.OFFSET + stream.emitPos
        stream.emitPos = stream.emitPos + copyCount
        copyOffset = copyOffset + copyCount
        compileSaveTracker "LINKING GENERATED CODE", copyOffset, userCodeLen, 0
      LOOP

      _MEMFREE targetMem
      _MEMFREE sourceMem
    END IF

  END IF

  compileSaveTracker "LAYING OUT IMAGE", 0, 0, 0

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 1 THEN
    vIdx = returnedData2
    symbols(vIdx).DataType = TYPE_LABEL
    symbols(vIdx).Offset = stream.emitPos
  END IF

  emitEpilogue
  IF compileError = 1 THEN EXIT SUB

  gfxBufTotalSize = GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize

  textLayout.CodeOffset = PE_FILE_HEADER_OFFSET
  textLayout.CodeSize = stream.emitPos
  textLayout.StrBase = textLayout.CodeOffset + textLayout.CodeSize
  textLayout.VarBase = textLayout.StrBase + textLayout.TotalStrSize

  ' Keep the initialized global variable block naturally aligned
  layoutRemainder = textLayout.VarBase AND 7
  IF layoutRemainder <> 0 THEN
    textLayout.VarBase = textLayout.VarBase + (8 - layoutRemainder)
  END IF

  textLayout.DescBase = textLayout.VarBase + textLayout.TotalVarSize
  textLayout.DataPtrArrBase = textLayout.DescBase + textLayout.TotalDescSize

  textLayout.TotalSize = (textLayout.DataPtrArrBase + (dataItemCount * 8)) - textLayout.CodeOffset

  ff = resolveSymbol("!G_SYS_ARR_DATA_LIST")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.DataPtrArrBase - textLayout.VarBase

  ' Set up purely virtual BSS layout offsets
  bssCurrent = textLayout.TotalBssSize

  textLayout.GfxBufFrontBase = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufBackBase = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufPage2Base = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufPage3Base = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.HwndBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.FramebufFrontBase = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufBackBase = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufPage2Base = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufPage3Base = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.KbdBufBase = bssCurrent
  bssCurrent = bssCurrent + 256

  textLayout.KbdHeadBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.KbdTailBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.FileHandlesBase = bssCurrent
  bssCurrent = bssCurrent + 2048

  textLayout.KbdStateBase = bssCurrent
  bssCurrent = bssCurrent + 256

  textLayout.MouseBufBase = bssCurrent
  bssCurrent = bssCurrent + 8192

  textLayout.MouseHeadBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.MouseTailBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.TotalBssSize = bssCurrent

  ' Force Internal Uninitialized Layout buffers natively into BSS
  ff = resolveSymbol("!G_GFX_ARR_BUFR_FRONT")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufFrontBase

  ff = resolveSymbol("!G_GFX_ARR_BUFR_BACK")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufBackBase

  ff = resolveSymbol("!G_GFX_ARR_BUFR_PAGE2")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufPage2Base

  ff = resolveSymbol("!G_GFX_ARR_BUFR_PAGE3")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufPage3Base

  ff = resolveSymbol("!G_GFX_ARR_FRMB_FRONT")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufFrontBase

  ff = resolveSymbol("!G_GFX_ARR_FRMB_BACK")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufBackBase

  ff = resolveSymbol("!G_GFX_ARR_FRMB_PAGE2")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufPage2Base

  ff = resolveSymbol("!G_GFX_ARR_FRMB_PAGE3")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufPage3Base

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.HwndBase

  ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdHeadBase

  ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdTailBase

  ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdBufBase

  ff = resolveSymbol("!G_INO_ARR_KBD_STATE")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdStateBase

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FileHandlesBase

  ff = resolveSymbol("!G_INO_ARR_MOUSE_BUF")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseBufBase

  ff = resolveSymbol("!G_INO_VAL_MOUSE_HEAD")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseHeadBase

  ff = resolveSymbol("!G_INO_VAL_MOUSE_TAIL")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseTailBase

  textVirtualSize = textLayout.TotalSize
  wTextRawSize = (((textVirtualSize) + PE_FILE_ALIGNMENT - 1) \ PE_FILE_ALIGNMENT) * PE_FILE_ALIGNMENT
  localIdataRVA = ((PE_TEXT_RVA + textVirtualSize + PE_SECTION_ALIGNMENT - 1) \ PE_SECTION_ALIGNMENT) * PE_SECTION_ALIGNMENT

  impTbl.baseRVA = localIdataRVA
  compileSaveTracker "BUILDING IMPORT TABLE", 0, 0, 0
  buildImportTable

  bssRVA = ((localIdataRVA + impTbl.idataRawSize + PE_SECTION_ALIGNMENT - 1) \ PE_SECTION_ALIGNMENT) * PE_SECTION_ALIGNMENT

  IF patchCount > 0 THEN
    FOR iLong = 0 TO patchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING VARIABLES", iLong + 1, patchCount, 0
      END IF

      pOffEmit = patches(iLong).Offset
      vIdx = patches(iLong).VarIdx

      ' Determine if variable was shunted to the uninitialized BSS section
      ' using strict explicit name matching.
      IF symbols(vIdx).IsBss = 1 THEN
        varRVA = bssRVA + symbols(vIdx).Offset
      ELSE
        actualVarOffset = textLayout.VarBase + symbols(vIdx).Offset
        varRVA = PE_TEXT_RVA + (actualVarOffset - PE_FILE_HEADER_OFFSET)
      END IF

      ripAfter = PE_TEXT_VA + pOffEmit + 4
      disp = (PE_IMAGE_BASE + varRVA) - ripAfter
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF iatPatchCount > 0 THEN
    FOR iLong = 0 TO iatPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING IMPORTS", iLong + 1, iatPatchCount, 0
      END IF

      pOffEmit = iatPatches(iLong).Offset
      iatConst = iatPatches(iLong).IATIdx

      IF iatConst >= 1000 THEN
        targetSubIdx = iatConst - 1000
        mappedIdx = subs(targetSubIdx).IatFlatIdx
      ELSE
        mappedIdx = impIatFlatIdx(iatConst)
      END IF

      iatEntryRVA = PE_IMAGE_BASE + impFlatIatRVA(mappedIdx)

      ripAfter = PE_TEXT_VA + pOffEmit + 4
      disp = iatEntryRVA - ripAfter

      patch32 pOffEmit, disp
    NEXT
  END IF

  IF gotoPatchCount > 0 THEN
    FOR iLong = 0 TO gotoPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING JUMPS", iLong + 1, gotoPatchCount, 0
      END IF

      pOffEmit = gotoPatches(iLong).Offset
      vIdx = gotoPatches(iLong).VarIdx
      targetOffset = symbols(vIdx).Offset

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF callPatchCount > 0 THEN
    FOR iLong = 0 TO callPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING CALLS", iLong + 1, callPatchCount, 0
      END IF

      pOffEmit = callPatches(iLong).Offset
      targetSubIdx = callPatches(iLong).SubIndex

      targetOffset = subs(targetSubIdx).Offset

      IF targetOffset < prologueBoundary OR targetOffset >= stream.emitPos THEN
        targetName$ = RTRIM$(subs(targetSubIdx).RecordName)
        throwCompilerErrorNoLineNum "GPF FATAL: SUB " + targetName$ + " TARGET OUT OF BOUNDS"
        EXIT SUB
      END IF

      targetOpcode = intermediateCode(targetOffset)
      IF targetOpcode <> &H55 THEN
        targetName$ = RTRIM$(subs(targetSubIdx).RecordName)
        throwCompilerErrorNoLineNum "GPF FATAL: SUB " + targetName$ + " OFFSET DOES NOT POINT TO FUNCTION START"
        EXIT SUB
      END IF

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF rt.PatchCount > 0 THEN
    FOR iLong = 0 TO rt.PatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING RUNTIMES", iLong + 1, rt.PatchCount, 0
      END IF

      pOffEmit = rtPatches(iLong).Offset
      targetOffset = rtOffset(rtPatches(iLong).Routine)

      IF targetOffset < prologueBoundary OR targetOffset >= stream.emitPos THEN
        rtMsg1$ = "GPF RT=" + LTRIM$(STR$(rtPatches(iLong).Routine)) + " OOB IX=" + LTRIM$(STR$(iLong)) + " CNT=" + LTRIM$(STR$(rt.PatchCount)) + " PRE=" + LTRIM$(STR$(userRtPatchCount))
        rtMsg2$ = "P=" + LTRIM$(STR$(pOffEmit)) + " T=" + LTRIM$(STR$(targetOffset)) + " RAW=" + LTRIM$(STR$(targetOffset - prologueBoundary)) + " PB=" + LTRIM$(STR$(prologueBoundary)) + " END=" + LTRIM$(STR$(stream.emitPos)) + " G=" + LTRIM$(STR$(cm.HasGraphics))
        ESCAPETEXT2 rtMsg1$, rtMsg2$
        EXIT SUB
      END IF

      targetOpcode = intermediateCode(targetOffset)
      IF targetOpcode <> &H55 AND targetOpcode <> &H53 THEN
        rtMsg1$ = "GPF RT=" + LTRIM$(STR$(rtPatches(iLong).Routine)) + " OP=$" + HEX$(targetOpcode) + " IX=" + LTRIM$(STR$(iLong)) + " CNT=" + LTRIM$(STR$(rt.PatchCount)) + " PRE=" + LTRIM$(STR$(userRtPatchCount))
        rtMsg2$ = "P=" + LTRIM$(STR$(pOffEmit)) + " T=" + LTRIM$(STR$(targetOffset)) + " RAW=" + LTRIM$(STR$(targetOffset - prologueBoundary)) + " PB=" + LTRIM$(STR$(prologueBoundary)) + " END=" + LTRIM$(STR$(stream.emitPos)) + " G=" + LTRIM$(STR$(cm.HasGraphics))
        ESCAPETEXT2 rtMsg1$, rtMsg2$
        EXIT SUB
      END IF

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  compileSaveTracker "BUILDING EXECUTABLE", 0, 0, 0
  writePEHeader wTextRawSize, textVirtualSize, bssRVA

  IF stream.emitPos > 0 THEN
    sourceMem = _MEM(intermediateCode())
    targetMem = _MEM(outputFile())
    copyOffset = 0

    DO WHILE copyOffset < stream.emitPos
      copyCount = stream.emitPos - copyOffset
      IF copyCount > copyBlockSize THEN copyCount = copyBlockSize

      sourceEnd = copyOffset
      sourceEnd = sourceEnd + copyCount
      targetEnd = outputFileIdx
      targetEnd = targetEnd + copyCount
      IF sourceEnd > stream.emitPos OR sourceEnd > MAX_CODE_SIZE OR sourceEnd > sourceMem.SIZE OR targetEnd > MAX_OUTPUT_SIZE OR targetEnd > targetMem.SIZE THEN
        _MEMFREE targetMem
        _MEMFREE sourceMem
        IF compileError = 0 THEN throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
        EXIT SUB
      END IF

      _MEMCOPY sourceMem, sourceMem.OFFSET + copyOffset, copyCount TO targetMem, targetMem.OFFSET + outputFileIdx
      outputFileIdx = outputFileIdx + copyCount
      copyOffset = copyOffset + copyCount
      compileSaveTracker "WRITING CODE", copyOffset, stream.emitPos, 0
    LOOP

    _MEMFREE targetMem
    _MEMFREE sourceMem
  END IF

  arrayPadUpTo textLayout.StrBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING STRINGS", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = ARRAY_TYPE_NONE THEN
          IF strVarData$(iLong) <> "" THEN
            strData$ = strVarData$(iLong)
            strLen = LEN(strData$)

            FOR i2Long = 1 TO strLen
              IF (i2Long AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
                compileSaveTracker "WRITING STRING DATA", i2Long, strLen, 0
              END IF

              IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
              END IF

              outputFile(outputFileIdx) = ASC(MID$(strData$, i2Long, 1))
              outputFileIdx = outputFileIdx + 1
            NEXT

            IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
              ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
            END IF

            outputFile(outputFileIdx) = 0
            outputFileIdx = outputFileIdx + 1
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.VarBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING VARIABLES", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        ' Ignore BSS mapped arrays so we don't accidentally write to
        ' the .text variable block.
        IF symbols(iLong).IsUserBssArray = 1 THEN
        ELSE
          IF symbols(iLong).DataType = TYPE_DOUBLE AND floatVarData(iLong) <> 0 AND symbols(iLong).IsArray = ARRAY_TYPE_NONE THEN
            arrayWrite64F floatVarData(iLong)
          ELSE
            IF symbols(iLong).DataType = TYPE_SINGLE AND floatVarData(iLong) <> 0 AND symbols(iLong).IsArray = ARRAY_TYPE_NONE THEN
              arrayWrite32F floatVarData(iLong)
              arrayPadNumBytes 4, 0
            ELSE
              IF symbols(iLong).IsFontData = 1 THEN
                FOR iFY = 0 TO 127
                  FOR iFX = 0 TO 127
                    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                      ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
                    END IF

                    outputFile(outputFileIdx) = fontData(iFX, iFY)
                    outputFileIdx = outputFileIdx + 1
                  NEXT
                NEXT

                FOR iFY = 0 TO 255
                  FOR iFX = 0 TO 127
                    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                      ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
                    END IF

                    outputFile(outputFileIdx) = fontData16(iFX, iFY)
                    outputFileIdx = outputFileIdx + 1
                  NEXT
                NEXT
              ELSE
                IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = ARRAY_TYPE_NONE THEN
                  descVA = textFileRVA(textLayout.DescBase + symbols(iLong).DescOffset)
                  arrayWrite32LE descVA
                  arrayWrite32LE 0
                ELSE
                  arrayPadNumBytes retSymbolByteSize(iLong), 0
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.DescBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING DESCRIPTORS", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = ARRAY_TYPE_NONE THEN
          IF strVarData$(iLong) <> "" THEN
            strVA = textFileRVA(textLayout.StrBase + symbols(iLong).StrOffset)
            strLen = LEN(strVarData$(iLong))

            arrayWrite32LE strVA
            arrayWrite32LE 0
            arrayWrite32LE strLen
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
          ELSE
            strVA = textFileRVA(textLayout.StrBase)

            arrayWrite32LE strVA
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.DataPtrArrBase, 0

  IF dataItemCount > 0 THEN
    FOR i3Long = 0 TO dataItemCount - 1
      IF (i3Long AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING DATA", i3Long + 1, dataItemCount, 0
      END IF

      descVA = textFileRVA(textLayout.DescBase + symbols(dataItemDescIdx(i3Long)).DescOffset)
      arrayWrite32LE descVA
      arrayWrite32LE 0
    NEXT
  END IF

  arrayPadUpTo PE_FILE_HEADER_OFFSET + wTextRawSize, 0

  compileSaveTracker "WRITING IMPORTS", 0, 0, 0
  writeIdataSection wTextRawSize
  compileSaveTracker "FINALIZING EXECUTABLE", 0, 0, 0

  ' The BSS section guarantees we no longer need to physically inject
  ' padding zeros at the end of the file.

END SUB ' prepareBinary

''''''''''''''''''''''''
SUB PrintChr (wPosPixelsX, wPosPixelsY, wStr$, fgClr, bgClr, useTransparent)

  IF LEN(wStr$) <> 1 THEN
    ESCAPETEXT "COMPILER FAIL: Only send one character to PrintChr. Character string sent was '" + wStr$ + "'"
  END IF

  wTile = ASC(wStr$)

  offsetY = wTile \ 16
  offsetX = wTile AND 15

  FOR iy = 0 TO FONT_HEIGHT - 1
    FOR ix = 0 TO FONT_WIDTH - 1
      drawPosX = (wPosPixelsX + ix)
      drawPosY = (wPosPixelsY + iy)

      SELECT CASE FONT_WIDTH
        CASE 8
          wClr = fontData((offsetX * 8) + ix, (offsetY * 8) + iy)
        CASE 9
          wClr = fontData9((offsetX * 9) + ix, (offsetY * FONT_HEIGHT) + iy)
      END SELECT

      IF wClr = 0 THEN
        IF useTransparent = 0 THEN
          PSET (drawPosX, drawPosY), bgClr
        END IF
      ELSE
        IF wClr = 15 THEN
          PSET (drawPosX, drawPosY), fgClr
        ELSE
          PSET (drawPosX, drawPosY), wClr
        END IF
      END IF
    NEXT
  NEXT

END SUB ' PrintChr

''''''''''''''''''''''''
SUB PrintStr (wPosPixelsX, wPosPixelsY, wStr$, fgClr, bgClr, useTransparent)

  FOR ii = 1 TO LEN(wStr$)
    toSend$ = MID$(wStr$, ii, 1)
    PrintChr wPosPixelsX + ((ii - 1) * FONT_WIDTH), wPosPixelsY, toSend$, fgClr, bgClr, useTransparent
  NEXT

END SUB ' PrintStr

''''''''''''''''''''''''
SUB processCompileState

  DIM statusCompileElapsedSeconds AS DOUBLE
  DIM statusBeforeLinkSeconds AS DOUBLE
  DIM statusLinkSeconds AS DOUBLE
  DIM statusDiskSeconds AS DOUBLE
  DIM statusPauseSeconds AS DOUBLE
  DIM statusTimingMark AS DOUBLE
  DIM statusCompileHundredths AS _UNSIGNED LONG
  DIM statusPhaseHundredths AS _UNSIGNED LONG
  DIM statusCompileElapsedText$
  DIM statusBeforeLinkText$
  DIM statusLinkText$
  DIM statusDiskText$
  DIM compRes AS LONG
  DIM savedFileNumber AS LONG
  DIM succMsg$
  DIM runCmd$
  DIM runBase$

  SELECT CASE compileState

    CASE COMP_REFINE
      compileSaveStatus.CompileStartSeconds = TIMER
      compileSaveStatus.RefineSeconds = 0

      hasCode = 0
      IF editor.LastLine > 1 THEN
        hasCode = 1
      ELSE
        IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
      END IF

      IF hasCode = 0 THEN
        compileWrapUp
        compileStatusMsg$ = ""
        EXIT SUB
      END IF

      compileError = 0
      compileStatusMsg$ = ""

      IF statusMsgCount = 0 THEN statusMsgCount = 1

      curExt$ = ".BAS"
      IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
      IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

      editor.StatusSelectedIndex = 0
      addStatusMsg "STARTING COMPILE OF " + fileNameBase$ + curExt$
      editor.StatusScrollY = statusMsgCount - 1
      IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
      redrawAll
      dispScreenFlushUpdate

      addStatusMsg "REFINING..."
      editor.StatusScrollY = statusMsgCount - 2
      IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
      redrawAll
      dispScreenFlushUpdate

      statusTimingMark = TIMER
      refineCode 0, 1
      compileSaveStatus.RefineSeconds = TIMER - statusTimingMark
      IF compileSaveStatus.RefineSeconds < 0 THEN compileSaveStatus.RefineSeconds = compileSaveStatus.RefineSeconds + 86400
      IF compileError = 1 THEN
        compileWrapUp
      ELSE
        addStatusMsg "COMPILING (PASS 1-4)..."
        compileState = COMP_COMPILE
        pass5.SubState = PASS5_STATE_START
      END IF

    CASE COMP_COMPILE

      SELECT CASE pass5.SubState

        CASE PASS5_STATE_START
          compRes = compile
          IF compRes = 1 THEN
            addStatusMsg "DISCOVERING SYMBOLS (PASS 5A)..."
            compilePass5Prepare PASS5_MODE_DISCOVERY

            IF compileError = 1 THEN
              compileWrapUp
            ELSE
              pass5.SubState = PASS5_STATE_DISCOVERY
            END IF
          ELSE
            compileWrapUp
          END IF

        CASE PASS5_STATE_DISCOVERY
          compilePass5ScanOrEmit
          IF compileError = 1 OR pass5.SUCCESS = 0 THEN
            compileWrapUp
          ELSE
            IF pass5.SubState = PASS5_STATE_COMPLETE THEN
              ' Pass 5A has discovered every source and TIRA symbol
              ' Finalize local offsets and frame sizes before measuring code
              compilePass5bLocalVariables

              IF compileError = 1 THEN
                compileWrapUp
                EXIT SUB
              END IF

              addStatusMsg "GENERATING CODE (PASS 5B)..."
              compilePass5Prepare PASS5_MODE_LAYOUT

              IF compileError = 1 THEN
                compileWrapUp
              ELSE
                pass5.SubState = PASS5_STATE_LAYOUT
              END IF
            END IF
          END IF

        CASE PASS5_STATE_LAYOUT
          compilePass5ScanOrEmit

          IF compileError = 1 OR pass5.SUCCESS = 0 THEN
            compileWrapUp
          ELSE

            IF pass5.SubState = PASS5_STATE_COMPLETE THEN

              ' Repeat local finalization when the layout scan exposes additional TIRA symbols
              IF symbolCount <> pass5.ScanStartSymbolCount THEN
                compilePass5bLocalVariables

                IF compileError = 1 THEN
                  compileWrapUp
                  EXIT SUB
                END IF

                addStatusMsg "REGENERATING CODE (PASS 5B)..."

                compilePass5Prepare PASS5_MODE_LAYOUT

                IF compileError = 1 THEN
                  compileWrapUp
                ELSE
                  pass5.SubState = PASS5_STATE_LAYOUT
                END IF

                EXIT SUB
              END IF

              ff = compilePass5ScanStateStable

              IF ff = 0 THEN
                compileWrapUp
                EXIT SUB
              END IF

              addStatusMsg "SAVING FOR COMPILE..."
              compileState = COMP_SAVE
            END IF
          END IF

      END SELECT ' pass5.SubState

    CASE COMP_SAVE
      statusBeforeLinkSeconds = TIMER - compileSaveStatus.CompileStartSeconds
      IF statusBeforeLinkSeconds < 0 THEN statusBeforeLinkSeconds = statusBeforeLinkSeconds + 86400
      statusBeforeLinkSeconds = statusBeforeLinkSeconds - compileSaveStatus.RefineSeconds
      IF statusBeforeLinkSeconds < 0 THEN statusBeforeLinkSeconds = 0

      statusTimingMark = TIMER
      prepareBinary
      statusLinkSeconds = TIMER - statusTimingMark
      IF statusLinkSeconds < 0 THEN statusLinkSeconds = statusLinkSeconds + 86400

      IF compileError = 0 THEN
        statusTimingMark = TIMER
        fileSaveBinary
        savedFileNumber = returnedData2
        statusPauseSeconds = returnedData3
        statusDiskSeconds = TIMER - statusTimingMark
        IF statusDiskSeconds < 0 THEN statusDiskSeconds = statusDiskSeconds + 86400
        statusDiskSeconds = statusDiskSeconds - statusPauseSeconds
        IF statusDiskSeconds < 0 THEN statusDiskSeconds = 0
        statusDiskSeconds = statusDiskSeconds + compileSaveStatus.RefineSeconds

        ' Only print SUCCESS and run the program if fileSaveBinary didn't throw a file lock error
        IF compileError = 0 THEN
          statusCompileElapsedSeconds = TIMER - compileSaveStatus.CompileStartSeconds
          IF statusCompileElapsedSeconds < 0 THEN statusCompileElapsedSeconds = statusCompileElapsedSeconds + 86400
          statusCompileElapsedSeconds = statusCompileElapsedSeconds - statusPauseSeconds
          IF statusCompileElapsedSeconds < 0 THEN statusCompileElapsedSeconds = 0

          statusCompileHundredths = INT((statusCompileElapsedSeconds * 100) + .5)
          statusCompileElapsedText$ = LTRIM$(STR$(statusCompileHundredths \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(statusCompileHundredths MOD 100)), 2)

          statusPhaseHundredths = INT((statusBeforeLinkSeconds * 100) + .5)
          statusBeforeLinkText$ = LTRIM$(STR$(statusPhaseHundredths \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(statusPhaseHundredths MOD 100)), 2)
          statusPhaseHundredths = INT((statusLinkSeconds * 100) + .5)
          statusLinkText$ = LTRIM$(STR$(statusPhaseHundredths \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(statusPhaseHundredths MOD 100)), 2)
          statusPhaseHundredths = INT((statusDiskSeconds * 100) + .5)
          statusDiskText$ = LTRIM$(STR$(statusPhaseHundredths \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(statusPhaseHundredths MOD 100)), 2)

          addStatusMsg "BEFORE LINK " + statusBeforeLinkText$ + "s, LINK " + statusLinkText$ + "s, SAVE " + statusDiskText$ + "s"
          succMsg$ = "SUCCESS IN " + statusCompileElapsedText$ + "s (Prologue: " + LTRIM$(STR$(metrics.PrologueSize)) + "b, Epilogue: " + LTRIM$(STR$(metrics.EpilogueSize)) + "b)"
          addStatusMsg succMsg$

          runBase$ = fileNameBase$
          IF savedFileNumber > 0 THEN
            IF savedFileNumber < 10 THEN
              runBase$ = runBase$ + "_0" + LTRIM$(STR$(savedFileNumber))
            ELSE
              runBase$ = runBase$ + "_" + LTRIM$(STR$(savedFileNumber))
            END IF
          END IF

          runCmd$ = CHR$(34) + runBase$ + ".exe" + CHR$(34)
          SHELL _DONTWAIT runCmd$
        END IF
      END IF

      compileWrapUp

  END SELECT ' compileState

END SUB ' processCompileState

''''''''''''''''''''''''
'' SUB processInput ' This is found within Z_EMLINF.BLB
'
' Process input for the IDE

''''''''''''''''''''''''
SUB rebuildSymbolHash

  DIM clearMem AS _MEM
  DIM scopeIdx AS LONG

  ' Mark the scope index unavailable until every active symbol has been inserted
  symIndexedSymbolCount = 0

  clearMem = _MEM(symScope())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  FOR scopeIdx = 0 TO MAX_SUBS
    scopeSymbolHead(scopeIdx) = 0
    scopeSymbolTail(scopeIdx) = 0
  NEXT

  syncSymbolHashIndex

  ' Matching counts certify that the index contains every currently active symbol
  symIndexedSymbolCount = symbolCount

END SUB ' rebuildSymbolHash

''''''''''''''''''''''''
SUB refineCode (targetLine AS LONG, isCompileClick AS LONG)

  DIM activeScope AS LONG

  DIM isVarFound AS LONG
  DIM foundVarIdx AS LONG
  DIM refineBaseHash AS LONG
  DIM refineActiveHash AS LONG
  DIM refineCheckIdx AS LONG

  DIM isDirStart AS LONG
  DIM newRawString AS STRING
  DIM newLen AS LONG
  DIM tempPart$
  DIM tempPartLen AS LONG

  DIM builtLine$
  DIM trimmedLine$
  DIM uTrimmed$
  DIM leadingSpaces AS LONG
  DIM sIdx AS LONG

  newRawString = SPACE$(16384)

  refCount = 0

  FOR ii = 0 TO SYMBOL_HASH_MASK
    refineScratchHash(ii) = -1
  NEXT

  IF targetLine = 0 THEN
    startLine = 1
    endLine = editor.LastLine
    uiSubCount = 0
    activeScope = 0
    scopeCounter = 0
    IF isCompileClick <> 1 THEN
      scanGlobalDirectives 0
    END IF
  ELSE
    startLine = targetLine
    endLine = targetLine

    ' Fast-scan upward to establish the correct scope context for the dirty line
    activeScope = 0
    scopeCounter = 0
    FOR iy = 1 TO startLine - 1
      uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
      IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
      IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
        activeScope = 0
      END IF
    NEXT
  END IF

  sysColor.focusBorder = 9

  FOR iy = startLine TO endLine
    currentLineNumber = iy
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    curLine$ = editorText$(iy)
    tempLine$ = LTRIM$(RTRIM$(curLine$))

    uTemp$ = UCASE$(tempLine$)
    IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
      IF targetLine = 0 THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      ELSE
        ' Make sure activeScope registers if the user specifically edited the SUB definition line itself
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
    END IF

    IF LEN(tempLine$) > 0 THEN
      newLen = 0
      ix = 1
      lineLen = LEN(curLine$)
      hasNonSpace = 0
      lastKwVal = 0

      parenDepth = 0

      isValidLine = 0
      IF INSTR(curLine$, "=") > 0 THEN isValidLine = 1
      firstIdent$ = ""

      FOR i_scan = 1 TO lineLen
        cAs = ASC(curLine$, i_scan)
        isDirScan = 0

        IF cAs = 35 OR cAs = 36 THEN ' # or $
          IF i_scan < lineLen THEN
            nAs = ASC(curLine$, i_scan + 1)
            IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirScan = 1
          END IF
        END IF

        IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirScan = 1 THEN
          tStart = i_scan
          FOR j_scan = i_scan TO lineLen
            c2As = ASC(curLine$, j_scan)
            IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (j_scan = i_scan AND (c2As = 35 OR c2As = 36)) THEN
              ' Continue scanning
            ELSE
              EXIT FOR
            END IF
          NEXT
          firstIdent$ = MID$(curLine$, tStart, j_scan - tStart)
          EXIT FOR
        END IF
      NEXT

      IF firstIdent$ <> "" THEN
        uFirst$ = UCASE$(firstIdent$)

        uIdentSearch$ = uFirst$
        IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
        IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
        IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
        IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
        IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
        IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
        IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
        IF uIdentSearch$ = "_STRINGD" THEN uIdentSearch$ = "STRINGD"
        IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
        IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

        ff = findKeywordIndex(uIdentSearch$)
        IF ff = 1 THEN isValidLine = 1
      END IF

      DO WHILE ix <= lineLen
        cAs = ASC(curLine$, ix)

        IF cAs = 32 OR cAs = 9 THEN
          IF hasNonSpace = 0 THEN
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = cAs
            ix = ix + 1
          ELSE
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = 32
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              IF c2As = 32 OR c2As = 9 THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP
          END IF
        ELSE
          hasNonSpace = 1

          IF cAs = 39 THEN ' '
            tempPart$ = MID$(curLine$, ix)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              FOR i2 = 1 TO tempPartLen
                ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
              NEXT
              newLen = newLen + tempPartLen
            END IF
            EXIT DO
          END IF

          IF cAs = 34 THEN ' "
            tStart = ix
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              ix = ix + 1
              IF c2As = 34 THEN EXIT DO
            LOOP
            tempPart$ = MID$(curLine$, tStart, ix - tStart)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              FOR i2 = 1 TO tempPartLen
                ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
              NEXT
              newLen = newLen + tempPartLen
            END IF
            lastKwVal = 0
          ELSE
            isDirStart = 0
            IF cAs = 35 OR cAs = 36 THEN ' # or $
              IF ix < lineLen THEN
                nAs = ASC(curLine$, ix + 1)
                IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirStart = 1
              END IF
            END IF

            IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirStart = 1 THEN
              tStart = ix
              DO WHILE ix <= lineLen
                c2As = ASC(curLine$, ix)
                IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (ix = tStart AND (c2As = 35 OR c2As = 36)) THEN
                  ix = ix + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              IF ix <= lineLen THEN
                c2As = ASC(curLine$, ix)
                IF c2As = 126 THEN ' ~
                  ix = ix + 1
                  IF ix <= lineLen THEN
                    c3As = ASC(curLine$, ix)
                    IF c3As = 38 THEN ' &
                      ix = ix + 1
                    END IF
                  END IF
                ELSE
                  IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 38 OR c2As = 37 THEN
                    ix = ix + 1
                  END IF
                END IF
              END IF

              ident$ = MID$(curLine$, tStart, ix - tStart)
              uIdent$ = UCASE$(ident$)

              uIdentSearch$ = uIdent$
              IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
              IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
              IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
              IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
              IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
              IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
              IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
              IF uIdentSearch$ = "_STRINGD" THEN uIdentSearch$ = "STRINGD"
              IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
              IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

              ff = findKeywordIndex(uIdentSearch$)
              IF ff = 1 THEN
                isKey = 1
                kwVal = returnedData2
              ELSE
                isKey = 0
                kwVal = 0
              END IF

              IF isKey = 1 THEN
                tempPart$ = uIdent$
                tempPartLen = LEN(tempPart$)
                IF tempPartLen > 0 THEN
                  IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                  FOR i2 = 1 TO tempPartLen
                    ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
                  NEXT
                  newLen = newLen + tempPartLen
                END IF
                lastKwVal = kwVal
              ELSE
                ' Is Variable / Label / Sub Call
                IF lastKwVal = TOK_DEF THEN
                  IF UCASE$(LEFT$(ident$, 2)) = "FN" THEN
                    IF LEN(ident$) = 2 THEN
                      ident$ = "FN"
                    ELSE
                      ident$ = "Fn" + MID$(ident$, 3)
                    END IF
                  END IF
                END IF
                lastKwVal = 0

                isVarFound = 0
                foundVarIdx = 0

                refineBaseHash = hashString(uIdent$)
                refineActiveHash = (refineBaseHash + (activeScope * 257)) AND SYMBOL_HASH_MASK
                refineCheckIdx = refineScratchHash(refineActiveHash)

                DO WHILE refineCheckIdx <> -1
                  IF refineScratchScope(refineCheckIdx) = activeScope THEN
                    IF UCASE$(refineScratchName$(refineCheckIdx)) = uIdent$ THEN
                      foundVarIdx = refineCheckIdx
                      isVarFound = 1
                      EXIT DO
                    END IF
                  END IF
                  refineCheckIdx = refineScratchHashNext(refineCheckIdx)
                LOOP

                IF isVarFound = 0 AND activeScope > 0 THEN
                  refineCheckIdx = refineScratchHash(refineBaseHash)

                  DO WHILE refineCheckIdx <> -1
                    IF refineScratchScope(refineCheckIdx) = 0 THEN
                      IF UCASE$(refineScratchName$(refineCheckIdx)) = uIdent$ THEN
                        foundVarIdx = refineCheckIdx
                        isVarFound = 1
                        EXIT DO
                      END IF
                    END IF
                    refineCheckIdx = refineScratchHashNext(refineCheckIdx)
                  LOOP
                END IF

                IF isVarFound = 0 THEN
                  IF isValidLine = 1 THEN
                    IF refCount < MAX_SYMBOLS THEN
                      foundVarIdx = refCount
                      refineScratchName$(foundVarIdx) = ident$
                      refineScratchScope(foundVarIdx) = activeScope
                      refineScratchHashNext(foundVarIdx) = refineScratchHash(refineActiveHash)
                      refineScratchHash(refineActiveHash) = foundVarIdx
                      refCount = refCount + 1
                    END IF
                  END IF
                  tempPart$ = ident$
                ELSE
                  tempPart$ = refineScratchName$(foundVarIdx)
                END IF

                tempPartLen = LEN(tempPart$)
                IF tempPartLen > 0 THEN
                  IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                  FOR i2 = 1 TO tempPartLen
                    ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
                  NEXT
                  newLen = newLen + tempPartLen
                END IF
              END IF
            ELSE
              ' Symbol
              IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              newLen = newLen + 1
              ASC(newRawString, newLen) = cAs

              ix = ix + 1
              lastKwVal = 0

              IF cAs = 40 THEN parenDepth = parenDepth + 1
              IF cAs = 41 THEN parenDepth = parenDepth - 1
            END IF
          END IF
        END IF
      LOOP

      builtLine$ = RTRIM$(LEFT$(newRawString, newLen))
      trimmedLine$ = LTRIM$(builtLine$)
      uTrimmed$ = UCASE$(trimmedLine$)

      IF trimmedLine$ <> "" THEN
        IF LEFT$(uTrimmed$, 4) = "SUB " OR LEFT$(uTrimmed$, 9) = "FUNCTION " THEN
          editorText$(iy) = trimmedLine$
        ELSE
          IF LEFT$(uTrimmed$, 7) = "END SUB" OR LEFT$(uTrimmed$, 12) = "END FUNCTION" THEN
            editorText$(iy) = trimmedLine$
          ELSE
            IF activeScope > 0 THEN
              IF LEFT$(trimmedLine$, 1) = "'" THEN
                editorText$(iy) = builtLine$
              ELSE
                leadingSpaces = 0
                FOR sIdx = 1 TO LEN(builtLine$)
                  IF MID$(builtLine$, sIdx, 1) = " " THEN
                    leadingSpaces = leadingSpaces + 1
                  ELSE
                    EXIT FOR
                  END IF
                NEXT

                IF leadingSpaces < editor.TabSize THEN
                  IF editor.TabSize > 0 THEN
                    editorText$(iy) = SPACE$(editor.TabSize) + trimmedLine$
                  ELSE
                    editorText$(iy) = trimmedLine$
                  END IF
                ELSE
                  editorText$(iy) = builtLine$
                END IF
              END IF
            ELSE
              editorText$(iy) = builtLine$
            END IF
          END IF
        END IF
      ELSE
        editorText$(iy) = ""
      END IF

      ' Only update global UI Sub list safely during a full sweep load to avoid visual glitches
      IF targetLine = 0 THEN
        testSub$ = LTRIM$(editorText$(iy))
        IF LEFT$(testSub$, 4) = "SUB " OR LEFT$(testSub$, 9) = "FUNCTION " THEN
          IF uiSubCount < MAX_UI_SUBS THEN
            IF LEFT$(testSub$, 4) = "SUB " THEN
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 5)))
            ELSE
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 10)))
            END IF

            cleanName$ = ""
            FOR nameIdx = 1 TO LEN(sName$)
              nameChar = ASC(sName$, nameIdx)
              IF (nameChar >= 65 AND nameChar <= 90) OR (nameChar >= 97 AND nameChar <= 122) OR (nameChar >= 48 AND nameChar <= 57) OR nameChar = 95 OR nameChar = 36 OR nameChar = 35 OR nameChar = 33 OR nameChar = 37 OR nameChar = 38 OR nameChar = 126 THEN
                cleanName$ = cleanName$ + CHR$(nameChar)
              ELSE
                EXIT FOR
              END IF
            NEXT
            sName$ = cleanName$

            uiSubName$(uiSubCount) = sName$
            uiSubLine(uiSubCount) = iy
            uiSubCount = uiSubCount + 1
          ELSE
            throwCompilerError "UI SUB LIMIT EXCEEDED", ASIS, 0
            EXIT SUB
          END IF
        END IF
      END IF

    ELSE
      editorText$(iy) = ""
    END IF

    IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
      activeScope = 0
    END IF
  NEXT

END SUB ' refineCode

''''''''''''''''''''''''
FUNCTION regClassicImplArrayIndiv (vIdx AS LONG, numDimensions AS LONG)

  DIM totalStaticElems AS _INTEGER64
  DIM staticStride AS _INTEGER64
  DIM implicitElementCount AS LONG
  DIM staticLayoutStart AS LONG

  IF cm.ClassicMode = 0 THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF vIdx < 0 OR vIdx >= symbolCount THEN
    throwCompilerError "INVALID IMPLICIT ARRAY SYMBOL", ASIS, 0
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF numDimensions < 1 OR numDimensions > 255 THEN
    throwCompilerError "INVALID IMPLICIT ARRAY DIMENSION COUNT", ASIS, 0
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
    IF symbols(vIdx).NumDimensions > 0 THEN
      IF symbols(vIdx).NumDimensions <> numDimensions THEN
        throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        regClassicImplArrayIndiv = 0
        EXIT FUNCTION
      END IF
    END IF

    regClassicImplArrayIndiv = 1
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).SubIndex <> 0 THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsExplicit <> DECL_IMPLICIT AND symbols(vIdx).IsExplicit <> DECL_QUIET THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  totalStaticElems = 1
  implicitElementCount = 11 - optionBaseValue

  ' QBASIC creates each implicit array dimension with bounds 0 TO 10
  ' OPTION BASE 1 changes the implicit lower bound while leaving the upper bound at 10
  FOR ii = 1 TO numDimensions
    IF totalStaticElems > PE_SIGNED_LAYOUT_MAX \ implicitElementCount THEN
      throwCompilerError "IMPLICIT ARRAY EXCEEDS STATIC ELEMENT LIMIT", ASIS, 0
      regClassicImplArrayIndiv = 0
      EXIT FUNCTION
    END IF
    totalStaticElems = totalStaticElems * implicitElementCount
  NEXT

  symbols(vIdx).IsArray = ARRAY_TYPE_STATIC
  symbols(vIdx).Size = totalStaticElems
  symbols(vIdx).NumDimensions = numDimensions

  staticLayoutStart = retStaticArrayLayoutStart(vIdx, numDimensions)

  IF staticLayoutStart > 0 THEN
    staticStride = 1

    FOR ii = 1 TO numDimensions
      staticArrayDimensions(staticLayoutStart + ii - 1).LowerBound = optionBaseValue
      staticArrayDimensions(staticLayoutStart + ii - 1).ElementCount = implicitElementCount
      staticArrayDimensions(staticLayoutStart + ii - 1).Stride = staticStride

      IF ii < numDimensions THEN staticStride = staticStride * implicitElementCount
    NEXT
  END IF

  regClassicImplArrayIndiv = 1

END FUNCTION ' regClassicImplArrayIndiv

''''''''''''''''''''''''
SUB regClassicImplArrays

  DIM tokenIdx AS LONG
  DIM nameStartIdx AS LONG
  DIM statementStart AS LONG
  DIM statementToken AS LONG
  DIM parenDepth AS LONG
  DIM nameEndIdx AS LONG
  DIM parenStartIdx AS LONG
  DIM parenEndIdx AS LONG
  DIM scanIdx AS LONG
  DIM nestedDepth AS LONG
  DIM numDimensions AS LONG
  DIM vIdx AS LONG
  DIM skipStatement AS LONG
  DIM canStartName AS LONG
  DIM baseIsUdt AS LONG
  DIM isRoutineName AS LONG
  DIM hasSymbol AS LONG
  DIM hasScalarSyntax AS LONG
  DIM preserveBareArray AS LONG
  DIM isDeclarationStatement AS LONG
  DIM isDeclarationName AS LONG
  DIM declarationStartIdx AS LONG
  DIM declarationDepth AS LONG
  DIM declarationIsArray AS LONG
  DIM declarationConflict AS LONG
  DIM declarationUsesAlternate AS LONG
  DIM hasScalarDeclaration AS LONG
  DIM hasArrayDeclaration AS LONG
  DIM arrayDeclarationUsesAlternate AS LONG
  DIM hasGraphicsCommand AS LONG
  DIM graphicsCommandIdx AS LONG
  DIM graphicsCoordStartIdx AS LONG
  DIM graphicsTargetStartIdx AS LONG
  DIM graphicsDepth AS LONG
  DIM firstChar AS STRING * 1
  DIM arrayName$
  DIM implicitArrayName$
  DIM implicitScalarName$
  DIM declarationKey$
  DIM scalarDeclarations$
  DIM alternateScalarDeclarations$
  DIM arrayDeclarations$
  DIM alternateArrayDeclarations$

  IF lineTokenCount = 0 THEN EXIT SUB

  statementStart = 0
  parenDepth = 0
  tokenIdx = 0

  DO WHILE tokenIdx < lineTokenCount
    tVal = lineTokenVals(tokenIdx)

    IF tVal = 256 + ASC(":") AND parenDepth = 0 THEN
      statementStart = tokenIdx + 1
    ELSE
      IF tVal = TOK_OP_LPAREN THEN parenDepth = parenDepth + 1
      IF tVal = TOK_OP_RPAREN THEN
        IF parenDepth > 0 THEN parenDepth = parenDepth - 1
      END IF

      IF tVal = 0 THEN
        canStartName = 1
        IF tokenIdx > statementStart THEN
          IF lineTokenVals(tokenIdx - 1) = 256 + ASC(".") THEN canStartName = 0
        END IF

        firstChar = LEFT$(lineTokens$(tokenIdx), 1)
        IF (firstChar < "A" OR firstChar > "Z") AND (firstChar < "a" OR firstChar > "z") THEN canStartName = 0

        skipStatement = 0
        isDeclarationStatement = 0
        IF statementStart < lineTokenCount THEN
          statementToken = lineTokenVals(statementStart)

          SELECT CASE statementToken

            CASE TOK_DIM, TOK_REDIM, TOK_STATIC_VAR, TOK_COMMON, TOK_GLOBAL
              skipStatement = 1
              isDeclarationStatement = 1

            CASE TOK_DECLARE, TOK_DECLARE_META, TOK_SUB, TOK_FUNCTION
              skipStatement = 1

          END SELECT ' statementToken
        END IF

        isDeclarationName = 0
        IF canStartName = 1 AND isDeclarationStatement = 1 THEN
          declarationStartIdx = statementStart + 1

          IF declarationStartIdx < lineTokenCount THEN
            IF lineTokenVals(declarationStartIdx) = TOK_SHARED THEN declarationStartIdx = declarationStartIdx + 1
          END IF

          declarationDepth = 0
          IF declarationStartIdx < tokenIdx THEN
            FOR scanIdx = declarationStartIdx TO tokenIdx - 1
              IF lineTokenVals(scanIdx) = TOK_OP_LPAREN THEN declarationDepth = declarationDepth + 1
              IF lineTokenVals(scanIdx) = TOK_OP_RPAREN THEN
                IF declarationDepth > 0 THEN declarationDepth = declarationDepth - 1
              END IF
              IF lineTokenVals(scanIdx) = 256 + ASC(",") AND declarationDepth = 0 THEN declarationStartIdx = scanIdx + 1
            NEXT
          END IF

          IF declarationStartIdx = tokenIdx THEN isDeclarationName = 1
        END IF

        IF isDeclarationName = 1 THEN
          nameStartIdx = tokenIdx
          arrayName$ = UCASE$(lineTokens$(tokenIdx))
          nameEndIdx = tokenIdx

          DO WHILE nameEndIdx + 2 < lineTokenCount
            IF lineTokenVals(nameEndIdx + 1) = 256 + ASC(".") AND lineTokenVals(nameEndIdx + 2) = 0 THEN
              arrayName$ = arrayName$ + "." + UCASE$(lineTokens$(nameEndIdx + 2))
              nameEndIdx = nameEndIdx + 2
            ELSE
              EXIT DO
            END IF
          LOOP

          declarationIsArray = 0
          IF statementToken = TOK_REDIM THEN declarationIsArray = 1
          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN declarationIsArray = 1
          END IF

          declarationKey$ = "|" + arrayName$ + "|"
          declarationConflict = 0
          declarationUsesAlternate = 0

          IF findSymbol(arrayName$) THEN
            vIdx = returnedData2
            IF symbols(vIdx).SubIndex = 0 THEN
              IF declarationIsArray = 1 AND symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN declarationConflict = 1
              IF declarationIsArray = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN declarationConflict = 1
            END IF
          END IF

          IF declarationIsArray = 1 THEN
            IF INSTR(scalarDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
            IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
          ELSE
            IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
            IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
          END IF

          IF declarationConflict = 1 THEN
            IF cm.ClassicMode = 1 THEN
              lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              declarationUsesAlternate = 1
            ELSE
              IF declarationIsArray = 1 THEN
                throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + arrayName$ + "()", ASIS, 0
              ELSE
                throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + arrayName$, ASIS, 0
              END IF
              EXIT SUB
            END IF
          END IF

          IF declarationIsArray = 1 THEN
            IF declarationUsesAlternate = 1 THEN
              alternateArrayDeclarations$ = alternateArrayDeclarations$ + declarationKey$
            ELSE
              arrayDeclarations$ = arrayDeclarations$ + declarationKey$
            END IF
          ELSE
            IF declarationUsesAlternate = 1 THEN
              alternateScalarDeclarations$ = alternateScalarDeclarations$ + declarationKey$
            ELSE
              scalarDeclarations$ = scalarDeclarations$ + declarationKey$
            END IF
          END IF

          tokenIdx = nameEndIdx
          canStartName = 0
        END IF

        ' Array dimension bounds remain ordinary expression syntax
        IF isDeclarationStatement = 1 AND isDeclarationName = 0 THEN
          IF parenDepth > 0 THEN skipStatement = 0
        END IF

        IF canStartName = 1 AND skipStatement = 0 THEN
          nameStartIdx = tokenIdx
          arrayName$ = UCASE$(lineTokens$(tokenIdx))
          nameEndIdx = tokenIdx

          DO WHILE nameEndIdx + 2 < lineTokenCount
            IF lineTokenVals(nameEndIdx + 1) = 256 + ASC(".") AND lineTokenVals(nameEndIdx + 2) = 0 THEN
              baseIsUdt = 0
              IF findSymbol(arrayName$) THEN
                IF symbols(returnedData2).DataType = TYPE_UDT THEN baseIsUdt = 1
              END IF

              IF baseIsUdt = 1 THEN
                EXIT DO
              ELSE
                arrayName$ = arrayName$ + "." + UCASE$(lineTokens$(nameEndIdx + 2))
                nameEndIdx = nameEndIdx + 2
              END IF
            ELSE
              EXIT DO
            END IF
          LOOP

          tokenIdx = nameEndIdx
          declarationKey$ = "|" + arrayName$ + "|"

          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN
              parenStartIdx = nameEndIdx + 1
              ff = findMatchingParen(parenStartIdx, lineTokenCount - 1)
              IF ff = 0 THEN EXIT SUB
              parenEndIdx = returnedData2

              numDimensions = 0
              IF parenEndIdx > parenStartIdx + 1 THEN
                numDimensions = 1
                nestedDepth = 0

                FOR scanIdx = parenStartIdx + 1 TO parenEndIdx - 1
                  SELECT CASE lineTokenVals(scanIdx)

                    CASE TOK_OP_LPAREN
                      nestedDepth = nestedDepth + 1

                    CASE TOK_OP_RPAREN
                      IF nestedDepth > 0 THEN nestedDepth = nestedDepth - 1

                    CASE 256 + ASC(",")
                      IF nestedDepth = 0 THEN numDimensions = numDimensions + 1

                  END SELECT ' lineTokenVals(scanIdx)
                NEXT
              END IF

              vIdx = 0
              isRoutineName = 0
              hasSymbol = 0

              IF findSubIndexCanonical(arrayName$) THEN isRoutineName = 1

              IF isRoutineName = 0 THEN
                IF findSymbol(arrayName$) THEN
                  vIdx = returnedData2
                  hasSymbol = 1
                END IF

                hasScalarDeclaration = 0
                hasArrayDeclaration = 0
                arrayDeclarationUsesAlternate = 0

                IF INSTR(scalarDeclarations$, declarationKey$) > 0 THEN hasScalarDeclaration = 1
                IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN hasScalarDeclaration = 1
                IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN hasArrayDeclaration = 1
                IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN
                  hasArrayDeclaration = 1
                  arrayDeclarationUsesAlternate = 1
                END IF

                IF hasArrayDeclaration = 1 THEN
                  IF cm.ClassicMode = 1 THEN
                    IF arrayDeclarationUsesAlternate = 1 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                  END IF
                ELSE
                  IF numDimensions > 0 THEN
                    IF hasSymbol = 0 OR symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
                      IF cm.ClassicMode = 1 THEN
                        ' Keep CLASSIC scalar and array namespaces separate while preserving the source type suffix
                        lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                        implicitArrayName$ = UCASE$(lineTokens$(nameStartIdx))

                        IF nameEndIdx > nameStartIdx THEN
                          FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                            implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                          NEXT
                        END IF

                        expectedSymType = TYPE_ANY
                        ff = resolveSymbol(implicitArrayName$)
                        IF ff = 0 THEN EXIT SUB
                        vIdx = returnedData2
                        hasSymbol = 1
                      ELSE
                        IF hasSymbol = 1 OR hasScalarDeclaration = 1 THEN
                          throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + arrayName$ + "()", ASIS, 0
                        ELSE
                          throwCompilerError "UNDECLARED ARRAY " + arrayName$ + "()", ASIS, 0
                        END IF
                        EXIT SUB
                      END IF
                    END IF

                    IF cm.ClassicMode = 1 THEN
                      ff = regClassicImplArrayIndiv(vIdx, numDimensions)
                      IF compileError = 1 THEN EXIT SUB
                    END IF
                  ELSE
                    IF hasSymbol = 0 OR symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
                      implicitArrayName$ = UCASE$(retClassicImplicitArrayName$(lineTokens$(nameStartIdx)))

                      IF nameEndIdx > nameStartIdx THEN
                        FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                          implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                        NEXT
                      END IF

                      IF cm.ClassicMode = 1 THEN
                        IF findSymbol(implicitArrayName$) THEN
                          vIdx = returnedData2
                          IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                        END IF
                      ELSE
                        IF hasSymbol = 1 OR hasScalarDeclaration = 1 THEN
                          throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + arrayName$ + "()", ASIS, 0
                        ELSE
                          throwCompilerError "UNDECLARED ARRAY " + arrayName$ + "()", ASIS, 0
                        END IF
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF

          ' QBASIC keeps a simple scalar and an array with the same source name in separate namespaces
          ' If the ordinary symbol is already an array, route a bare occurrence through the alternate CLASSIC name
          hasScalarSyntax = 1
          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN hasScalarSyntax = 0
          END IF

          ' LBOUND and UBOUND take a bare array name, so those operands must retain the array namespace
          preserveBareArray = 0
          IF nameStartIdx >= 2 THEN
            IF lineTokenVals(nameStartIdx - 1) = TOK_OP_LPAREN THEN
              IF lineTokenVals(nameStartIdx - 2) = TOK_LBOUND OR lineTokenVals(nameStartIdx - 2) = TOK_UBOUND THEN preserveBareArray = 1
            END IF
          END IF

          ' Graphics GET and PUT also take a bare array name after their coordinate arguments
          IF preserveBareArray = 0 THEN
            hasGraphicsCommand = 0
            IF nameStartIdx > statementStart THEN
              FOR scanIdx = nameStartIdx - 1 TO statementStart STEP -1
                IF lineTokenVals(scanIdx) = TOK_GET OR lineTokenVals(scanIdx) = TOK_PUT THEN
                  graphicsCommandIdx = scanIdx
                  hasGraphicsCommand = 1
                  EXIT FOR
                END IF
              NEXT
            END IF

            IF hasGraphicsCommand = 1 THEN
              graphicsCoordStartIdx = graphicsCommandIdx + 1
              IF graphicsCoordStartIdx < lineTokenCount THEN
                IF lineTokenVals(graphicsCoordStartIdx) = TOK_STEP THEN graphicsCoordStartIdx = graphicsCoordStartIdx + 1
              END IF

              IF graphicsCoordStartIdx < nameStartIdx THEN
                IF lineTokenVals(graphicsCoordStartIdx) = TOK_OP_LPAREN THEN
                  graphicsTargetStartIdx = 0
                  graphicsDepth = 0

                  FOR scanIdx = graphicsCoordStartIdx TO nameStartIdx - 1
                    SELECT CASE lineTokenVals(scanIdx)

                      CASE TOK_OP_LPAREN
                        graphicsDepth = graphicsDepth + 1

                      CASE TOK_OP_RPAREN
                        IF graphicsDepth > 0 THEN graphicsDepth = graphicsDepth - 1

                      CASE 256 + ASC(",")
                        IF graphicsDepth = 0 THEN graphicsTargetStartIdx = scanIdx + 1

                    END SELECT ' lineTokenVals(scanIdx)
                  NEXT

                  IF graphicsTargetStartIdx = nameStartIdx THEN preserveBareArray = 1
                END IF
              END IF
            END IF
          END IF

          IF preserveBareArray = 1 AND cm.ClassicMode = 1 THEN
            hasSymbol = 0
            IF findSymbol(arrayName$) THEN
              vIdx = returnedData2
              IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN hasSymbol = 1
            END IF

            IF hasSymbol = 0 THEN
              implicitArrayName$ = UCASE$(retClassicImplicitArrayName$(lineTokens$(nameStartIdx)))

              IF nameEndIdx > nameStartIdx THEN
                FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                  implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                NEXT
              END IF

              IF findSymbol(implicitArrayName$) THEN
                vIdx = returnedData2
                IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              END IF

              IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
            END IF
          END IF

          IF hasScalarSyntax = 1 AND preserveBareArray = 0 THEN
            IF findSymbol(arrayName$) THEN
              vIdx = returnedData2

              IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                IF cm.ClassicMode = 1 THEN
                  lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                  implicitScalarName$ = UCASE$(lineTokens$(nameStartIdx))

                  IF nameEndIdx > nameStartIdx THEN
                    FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                      implicitScalarName$ = implicitScalarName$ + retTokenText$(lineTokens$(scanIdx))
                    NEXT
                  END IF

                  expectedSymType = TYPE_ANY
                  ff = resolveSymbol(implicitScalarName$)
                  IF ff = 0 THEN EXIT SUB

                  vIdx = returnedData2
                  IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                    throwCompilerError "CLASSIC SCALAR NAMESPACE CLASH", ASIS, 0
                    EXIT SUB
                  END IF
                ELSE
                  throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + arrayName$, ASIS, 0
                  EXIT SUB
                END IF
              END IF
            ELSE
              IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN
                IF cm.ClassicMode = 1 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              ELSE
                IF INSTR(scalarDeclarations$, declarationKey$) = 0 THEN
                  IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN
                    IF cm.ClassicMode = 1 THEN
                      lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                      implicitScalarName$ = UCASE$(lineTokens$(nameStartIdx))

                      IF nameEndIdx > nameStartIdx THEN
                        FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                          implicitScalarName$ = implicitScalarName$ + retTokenText$(lineTokens$(scanIdx))
                        NEXT
                      END IF

                      expectedSymType = TYPE_ANY
                      ff = resolveSymbol(implicitScalarName$)
                      IF ff = 0 THEN EXIT SUB
                    ELSE
                      throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + arrayName$, ASIS, 0
                      EXIT SUB
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF

    tokenIdx = tokenIdx + 1
  LOOP

END SUB ' regClassicImplArrays

''''''''''''''''''''''''
FUNCTION resolveSymbol (vName$)

  returnExtraPrepare

  DIM dType AS LONG
  DIM vIdx AS LONG
  DIM isExp AS LONG
  DIM charIdx AS LONG
  DIM conflictIdx AS LONG
  DIM roleStr$
  DIM secondChar$
  DIM isInternal AS LONG
  DIM isGlobalInternal AS LONG
  DIM isTempInternal AS LONG
  DIM isCallTarget AS LONG
  DIM searchName$

  searchName$ = UCASE$(vName$)

  IF LEN(searchName$) > 64 THEN
    throwCompilerError "ERROR: IDENTIFIER EXCEEDS 64 CHARACTER LIMIT", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 NO_VALID_INDEX
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  IF searchName$ = "" THEN
    throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 NO_VALID_INDEX
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  firstChar$ = LEFT$(searchName$, 1)

  IF firstChar$ = "_" THEN
    throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 NO_VALID_INDEX
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  isInternal = 0
  isGlobalInternal = 0
  isTempInternal = 0

  IF firstChar$ = "!" THEN
    isInternal = 1
    secondChar$ = MID$(searchName$, 2, 1)

    IF secondChar$ <> "G" AND secondChar$ <> "C" AND secondChar$ <> "T" AND secondChar$ <> "R" THEN
      throwCompilerError "INTERNAL VARIABLE MUST START WITH !G, !C, !T, OR !R IN " + searchName$, ASIS, 0
      return3 TYPE_UNDEFINED
      return2 NO_VALID_INDEX
      resolveSymbol = 0
      EXIT FUNCTION
    END IF

    IF secondChar$ = "G" OR secondChar$ = "C" OR secondChar$ = "R" THEN
      IF MID$(searchName$, 3, 1) <> "_" THEN
        throwCompilerError "INTERNAL VARIABLE MUST HAVE _ AT POS 3 IN " + searchName$, ASIS, 0
        return3 TYPE_UNDEFINED
        return2 NO_VALID_INDEX
        resolveSymbol = 0
        EXIT FUNCTION
      END IF
    END IF

    IF secondChar$ = "G" OR secondChar$ = "C" THEN
      isGlobalInternal = 1
    END IF

    IF secondChar$ = "T" THEN
      isTempInternal = 1
    END IF

    lastChar$ = RIGHT$(searchName$, 1)
    IF lastChar$ = "$" OR lastChar$ = "#" OR lastChar$ = "!" OR lastChar$ = "%" OR lastChar$ = "&" OR lastChar$ = "~" THEN
      ESCAPETEXT2 "FATAL in resolveSymbol", "Internal variable " + searchName$ + " cannot use legacy type suffix '" + lastChar$ + "'."
    END IF
  END IF

  IF findSymbolCanonical(searchName$) THEN
    vIdx = returnedData2
    return3 symbols(vIdx).DataType
    return2 vIdx
    resolveSymbol = 1
    EXIT FUNCTION
  END IF

  dType = TYPE_SINGLE
  isExp = DECL_IMPLICIT
  isCallTarget = 0

  ' API and runtime call targets do not inherit the expected type of a user expression
  IF LEFT$(searchName$, 4) = "IAT_" THEN
    IF retIatConstByName(searchName$, 1) <> IAT_INVALID THEN isCallTarget = 1
  ELSE
    IF LEFT$(searchName$, 3) = "RT_" THEN
      IF retRtIdByName(searchName$) <> RT_INVALID THEN isCallTarget = 1
    END IF
  END IF

  IF isInternal = 1 THEN
    isExp = DECL_EXPLICIT

    dType = TYPE_UNDEFINED

    IF isGlobalInternal = 1 THEN
      IF LEN(searchName$) >= 12 THEN
        roleStr$ = MID$(searchName$, 8, 4)

        SELECT CASE roleStr$

          CASE "DSC_", "PTR_", "IDX_", "FLG_", "VAL_", "V32_", "ARR_", "UDT_"
            dType = TYPE_INTEGER64
            IF roleStr$ = "DSC_" THEN dType = TYPE_STRING
            IF roleStr$ = "IDX_" OR roleStr$ = "FLG_" OR roleStr$ = "V32_" THEN dType = TYPE_LONG
            IF roleStr$ = "UDT_" THEN dType = TYPE_UDT
          CASE ELSE
            throwCompilerError "UNKNOWN HARDWARE ROLE IN INTERNAL VARIABLE " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 NO_VALID_INDEX
            resolveSymbol = 0
            EXIT FUNCTION

        END SELECT ' roleStr$

        IF MID$(searchName$, 12, 1) = "_" THEN
          throwCompilerError "NAME SEGMENT CANNOT START WITH UNDERSCORE IN " + searchName$, ASIS, 0
          return3 TYPE_UNDEFINED
          return2 NO_VALID_INDEX
          resolveSymbol = 0
          EXIT FUNCTION
        END IF

        IF LEN(searchName$) >= 13 THEN
          IF MID$(searchName$, 13, 1) = "_" THEN
            throwCompilerError "NAME SEGMENT CANNOT HAVE UNDERSCORE AT SECOND CHARACTER IN " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 NO_VALID_INDEX
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        END IF

      ELSE
        throwCompilerError "GLOBAL INTERNAL MISSING NAME SEGMENT IN " + searchName$, ASIS, 0
        return3 TYPE_UNDEFINED
        return2 NO_VALID_INDEX
        resolveSymbol = 0
        EXIT FUNCTION
      END IF
    ELSE
      dType = TYPE_INTEGER64
    END IF
  ELSE
    IF firstChar$ = "%" OR firstChar$ = "@" THEN
      dType = TYPE_LABEL
      isExp = DECL_EXPLICIT
    ELSE
      charIdx = ASC(firstChar$) - 65
      IF charIdx >= 0 AND charIdx <= 25 THEN
        IF defIntMap(charIdx) = 1 THEN dType = TYPE_INTEGER
      END IF
    END IF
  END IF

  IF isCallTarget = 1 THEN
    dType = TYPE_INTEGER64
    isExp = DECL_EXPLICIT
  END IF

  suffix$ = ""
  lastTwo$ = RIGHT$(searchName$, 2)
  IF firstChar$ <> "%" AND firstChar$ <> "@" AND lastTwo$ = "&&" THEN
    dType = TYPE_INTEGER64
    suffix$ = "&&"
  ELSE
    IF firstChar$ <> "%" AND firstChar$ <> "@" AND lastTwo$ = "~&" THEN
      dType = TYPE_ULONG
      suffix$ = "~&"
    ELSE
      IF firstChar$ <> "%" AND firstChar$ <> "@" THEN suffix$ = RIGHT$(searchName$, 1)
      SELECT CASE suffix$

        CASE "$"
          dType = TYPE_STRING

        CASE "#"
          dType = TYPE_DOUBLE

        CASE "!"
          dType = TYPE_SINGLE

        CASE "&"
          dType = TYPE_LONG

        CASE "%"
          dType = TYPE_INTEGER

        CASE "~"
          dType = TYPE_ULONG

        CASE ELSE
          suffix$ = ""
          IF expectedSymType <> TYPE_ANY AND isExp = DECL_IMPLICIT THEN
            dType = expectedSymType
          END IF

      END SELECT ' suffix$
    END IF
  END IF

  IF suffix$ = "$" THEN
    baseName$ = LEFT$(searchName$, LEN(searchName$) - 1)
    IF findSymbolCanonical(baseName$) THEN
      conflictIdx = returnedData2
      existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

      IF cm.ClassicMode = 1 THEN
        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
          return3 TYPE_STRING
          return2 conflictIdx
          resolveSymbol = 1
          EXIT FUNCTION
        END IF
      ELSE
        IF cm.StringStrict = 0 THEN
          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
            return3 TYPE_STRING
            return2 conflictIdx
            resolveSymbol = 1
            EXIT FUNCTION
          ELSE
            throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 NO_VALID_INDEX
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        ELSE
          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
            throwCompilerError "NAME CLASH: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
          ELSE
            throwCompilerError "NNAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
          END IF
          return3 TYPE_UNDEFINED
          return2 NO_VALID_INDEX
          resolveSymbol = 0
          EXIT FUNCTION
        END IF
      END IF
    END IF
  ELSE
    IF suffix$ = "" AND isCallTarget = 0 AND firstChar$ <> "%" AND firstChar$ <> "@" THEN
      IF findSymbolCanonical(searchName$ + "$") THEN
        conflictIdx = returnedData2
        existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

        IF cm.ClassicMode = 0 THEN
          IF cm.StringStrict = 0 THEN
            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
              return3 TYPE_STRING
              return2 conflictIdx
              resolveSymbol = 1
              EXIT FUNCTION
            ELSE
              throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
              return3 TYPE_UNDEFINED
              return2 NO_VALID_INDEX
              resolveSymbol = 0
              EXIT FUNCTION
            END IF
          ELSE
            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
              throwCompilerError "NAME CLASH: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            ELSE
              throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            END IF
            return3 TYPE_UNDEFINED
            return2 NO_VALID_INDEX
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF
  END IF

  IF symbolCount >= MAX_SYMBOLS THEN
    throwCompilerError "SYMBOL LIMIT", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 NO_VALID_INDEX
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  vIdx = symbolCount
  symbols(vIdx).RecordName = searchName$
  symbols(vIdx).DataType = dType
  symbols(vIdx).ScopeID = currentScopeID
  IF secondChar$ = "G" THEN symbols(vIdx).ScopeID = 0
  IF isCallTarget = 1 THEN symbols(vIdx).ScopeID = 0
  symbols(vIdx).IsShared = 0
  IF isCallTarget = 1 THEN symbols(vIdx).IsShared = 1
  symbols(vIdx).IsArray = ARRAY_TYPE_NONE
  symbols(vIdx).Size = 1
  symbols(vIdx).NumDimensions = 0
  symbols(vIdx).Offset = 0
  symbols(vIdx).SubIndex = 0
  symbols(vIdx).UDTIndex = NO_VALID_INDEX
  symbols(vIdx).IsExplicit = isExp
  symbols(vIdx).alreadyParsed = 0

  symbols(vIdx).IsLocal = LOCAL_GLOBAL

  IF currentScopeID > 0 THEN
    IF isGlobalInternal = 0 AND isCallTarget = 0 AND firstChar$ <> "%" AND firstChar$ <> "@" THEN
      symbols(vIdx).IsLocal = LOCAL_STANDARD
    END IF
  END IF

  symbols(vIdx).LocalOffset = 0
  symbols(vIdx).DescOffset = 0
  symbols(vIdx).StrOffset = 0
  symbols(vIdx).FixedStrLen = 0

  ' Map the new symbol into the hash table for future lookups
  symbolCount = symbolCount + 1
  indexSymbol vIdx

  return3 dType
  return2 vIdx
  resolveSymbol = 1

END FUNCTION ' resolveSymbol

''''''''''''''''''''''''
FUNCTION retByRefTypeCompatible (sourceType AS LONG, targetType AS LONG)

  compatible = 0

  IF sourceType = targetType THEN
    compatible = 1
  ELSE
    SELECT CASE sourceType

      CASE TYPE_BYTE
        IF targetType = TYPE_UBYTE THEN compatible = 1

      CASE TYPE_UBYTE
        IF targetType = TYPE_BYTE THEN compatible = 1

      CASE TYPE_INTEGER
        IF targetType = TYPE_UINTEGER THEN compatible = 1

      CASE TYPE_UINTEGER
        IF targetType = TYPE_INTEGER THEN compatible = 1

      CASE TYPE_LONG
        IF targetType = TYPE_ULONG THEN compatible = 1

      CASE TYPE_ULONG
        IF targetType = TYPE_LONG THEN compatible = 1

      CASE TYPE_INTEGER64
        IF targetType = TYPE_UINT64 THEN compatible = 1

      CASE TYPE_UINT64
        IF targetType = TYPE_INTEGER64 THEN compatible = 1

    END SELECT ' sourceType
  END IF

  retByRefTypeCompatible = compatible

END FUNCTION ' retByRefTypeCompatible

''''''''''''''''''''''''
FUNCTION retClassicImplicitArrayName$ (sourceName$)

  DIM baseName$
  DIM suffix$
  DIM lastChar$

  baseName$ = UCASE$(sourceName$)
  suffix$ = ""

  IF RIGHT$(baseName$, 2) = "~&" THEN
    suffix$ = "~&"
    baseName$ = LEFT$(baseName$, LEN(baseName$) - 2)
  ELSE
    lastChar$ = RIGHT$(baseName$, 1)

    SELECT CASE lastChar$

      CASE "$", "#", "!", "&", "%", "~"
        suffix$ = lastChar$
        baseName$ = LEFT$(baseName$, LEN(baseName$) - 1)

    END SELECT ' lastChar$
  END IF

  retClassicImplicitArrayName$ = baseName$ + "@" + suffix$

END FUNCTION ' retClassicImplicitArrayName$

''''''''''''''''''''''''
FUNCTION retCoordinateBoundaries (passStartIdx, passEndIdx)

  returnExtraPrepare

  DIM tempStart AS LONG
  DIM tempEnd AS LONG
  DIM cPos AS LONG

  tempStart = passStartIdx
  tempEnd = passEndIdx

  ' Strip surrounding parentheses if they exist to isolate the coordinate arguments
  IF lineTokenVals(tempStart) = TOK_OP_LPAREN THEN
    IF lineTokenVals(tempEnd) = TOK_OP_RPAREN THEN
      tempStart = tempStart + 1
      tempEnd = tempEnd - 1
    END IF
  END IF

  cPos = findComma(tempStart, tempEnd)

  return3 tempEnd
  return2 tempStart

  retCoordinateBoundaries = cPos

END FUNCTION ' retCoordinateBoundaries

''''''''''''''''''''''''
FUNCTION retEditorSelection$

  IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
    startY = editor.SelectStartY
    startX = editor.SelectStartX
    endY = editor.CursorY
    endX = editor.CursorX
  ELSE
    startY = editor.CursorY
    startX = editor.CursorX
    endY = editor.SelectStartY
    endX = editor.SelectStartX
  END IF

  IF startY = endY AND startX = endX THEN
    retEditorSelection$ = editorText$(editor.CursorY)
    EXIT FUNCTION
  END IF

  totalLen = 0
  FOR iy = startY TO endY
    curLine$ = editorText$(iy)
    IF startY = endY THEN
      totalLen = totalLen + (endX - startX)
    ELSE
      IF iy = startY THEN
        totalLen = totalLen + LEN(MID$(curLine$, startX + 1)) + 2
      ELSE
        IF iy = endY THEN
          totalLen = totalLen + endX
        ELSE
          totalLen = totalLen + LEN(curLine$) + 2
        END IF
      END IF
    END IF
  NEXT

  IF totalLen <= 0 THEN
    retEditorSelection$ = ""
    EXIT FUNCTION
  END IF

  outStr$ = SPACE$(totalLen)
  writePos = 1

  FOR iy = startY TO endY
    curLine$ = editorText$(iy)
    partStr$ = ""

    IF startY = endY THEN
      partStr$ = MID$(curLine$, startX + 1, endX - startX)
    ELSE
      IF iy = startY THEN
        partStr$ = MID$(curLine$, startX + 1) + CHR$(13) + CHR$(10)
      ELSE
        IF iy = endY THEN
          partStr$ = LEFT$(curLine$, endX)
        ELSE
          partStr$ = curLine$ + CHR$(13) + CHR$(10)
        END IF
      END IF
    END IF

    partLen = LEN(partStr$)
    IF partLen > 0 THEN
      MID$(outStr$, writePos, partLen) = partStr$
      writePos = writePos + partLen
    END IF
  NEXT

  retEditorSelection$ = outStr$

END FUNCTION ' retEditorSelection$

''''''''''''''''''''''''
FUNCTION retElementByteSize (vIdx)

  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM uIdx AS LONG

  dt = symbols(vIdx).DataType
  elemSize = 8

  SELECT CASE dt

    CASE TYPE_BYTE, TYPE_UBYTE: elemSize = 1
    CASE TYPE_INTEGER, TYPE_UINTEGER: elemSize = 2
    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE: elemSize = 4
    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE: elemSize = 8
    CASE TYPE_STRING
      fixedLen = retFixedStringLength(vIdx)
      IF fixedLen > 0 THEN
        elemSize = fixedLen
      ELSE
        elemSize = 8
      END IF
    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex
      IF uIdx >= 0 THEN
        elemSize = udts(uIdx).TotalSize
      ELSE
        elemSize = 8
      END IF

  END SELECT ' dt

  retElementByteSize = elemSize

END FUNCTION ' retElementByteSize

''''''''''''''''''''''''
FUNCTION retExpandedConst$ (rsExpr$)

  ' Expand existing lexiconstants before evaluating CONST values and $IF conditions

  DIM inQuotes AS LONG
  DIM valLen AS LONG
  DIM iv AS LONG
  DIM cAs AS LONG
  DIM c2As AS LONG
  DIM isIdentStart AS LONG
  DIM preventExpansion AS LONG
  DIM prevIx AS LONG
  DIM prevAs AS LONG
  DIM tStart AS LONG
  DIM chunkStart AS LONG
  DIM isMatchFound AS LONG
  DIM matchedIdx AS LONG
  DIM constHashValue AS LONG
  DIM constCheckIdx AS LONG

  cValRaw$ = rsExpr$

  expandedVal$ = ""
  inQuotes = 0
  valLen = LEN(cValRaw$)
  iv = 1

  DO WHILE iv <= valLen
    cAs = ASC(cValRaw$, iv)

    IF cAs = 34 THEN
      inQuotes = 1 - inQuotes
      expandedVal$ = expandedVal$ + CHR$(34)
      iv = iv + 1
    ELSE
      isIdentStart = 0
      IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) THEN isIdentStart = 1

      IF inQuotes = 0 AND isIdentStart = 1 THEN
        preventExpansion = 0
        prevIx = iv - 1
        DO WHILE prevIx > 0
          prevAs = ASC(cValRaw$, prevIx)
          IF prevAs = 32 OR prevAs = 9 THEN
            prevIx = prevIx - 1
          ELSE
            IF prevAs = 46 OR prevAs = 38 OR prevAs = 35 OR prevAs = 36 OR prevAs = 37 OR prevAs = 33 THEN preventExpansion = 1
            EXIT DO
          END IF
        LOOP

        IF iv > 1 THEN
          prevAs = ASC(cValRaw$, iv - 1)
          IF prevAs >= 48 AND prevAs <= 57 THEN preventExpansion = 1
        END IF

        tStart = iv
        DO WHILE iv <= valLen
          c2As = ASC(cValRaw$, iv)
          IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 THEN
            iv = iv + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF iv <= valLen THEN
          c2As = ASC(cValRaw$, iv)
          IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 37 OR c2As = 38 THEN
            iv = iv + 1
          END IF
        END IF

        ident$ = MID$(cValRaw$, tStart, iv - tStart)

        isMatchFound = 0
        matchedIdx = 0
        searchIdent$ = UCASE$(ident$)

        IF preventExpansion = 0 AND textConstCount > 0 THEN
          constHashValue = hashString(searchIdent$)
          constCheckIdx = textConstHash(constHashValue)

          DO WHILE constCheckIdx <> NO_VALID_INDEX
            IF textConsts(constCheckIdx).Name = searchIdent$ THEN
              matchedIdx = constCheckIdx
              isMatchFound = 1
              EXIT DO
            END IF
            constCheckIdx = textConstHashNext(constCheckIdx)
          LOOP
        END IF

        IF isMatchFound = 1 THEN
          expandedVal$ = expandedVal$ + textConsts(matchedIdx).Value
        ELSE
          expandedVal$ = expandedVal$ + ident$
        END IF
      ELSE
        chunkStart = iv
        DO WHILE iv <= valLen
          c2As = ASC(cValRaw$, iv)
          IF c2As = 34 THEN EXIT DO
          IF inQuotes = 0 AND ((c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122)) THEN EXIT DO
          iv = iv + 1
        LOOP
        expandedVal$ = expandedVal$ + MID$(cValRaw$, chunkStart, iv - chunkStart)
      END IF
    END IF
  LOOP

  expandedVal$ = LTRIM$(RTRIM$(expandedVal$))
  expandedVal$ = evalMathConst$(expandedVal$)

  retExpandedConst$ = expandedVal$

END FUNCTION ' retExpandedConst$

''''''''''''''''''''''''
FUNCTION retFixedStringLength (vIdx)

  retFixedStringLength = symbols(vIdx).FixedStrLen

END FUNCTION ' retFixedStringLength

