''''''''''''''''''''''''
SUB tiraOpId0 (opConst AS LONG)

  tiraCheckActive ("tiraOpId0")
  IF tiraLineCheckId THEN EXIT SUB

  SELECT CASE opConst

    CASE TC_BREAK, TC_MEMERROR, TC_RESUME
      ' Valid
    CASE ELSE
      throwCompilerError "UNKNOWN OR UNSUPPORTED TIRA CONSTANT IN OPID0", ASIS, 0
      EXIT SUB

  END SELECT ' opConst

  tiraNode(t.LineCount).OpCode = opConst

  tiraNode(t.LineCount).Arg1Type = TA_EMPTY: tiraNode(t.LineCount).Arg1Val = 0
  tiraNode(t.LineCount).Arg2Type = TA_EMPTY: tiraNode(t.LineCount).Arg2Val = 0
  tiraNode(t.LineCount).Arg3Type = TA_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TA_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraOpId0

