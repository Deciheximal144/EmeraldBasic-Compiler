''''''''''''''''''''''''
SUB createFont9by10TextFile

  DIM imageHandle AS LONG
  DIM originalSource AS LONG
  DIM backgroundColor AS _UNSIGNED LONG
  DIM pixelColor AS _UNSIGNED LONG

  imageHandle = _LOADIMAGE("NEWFONT9X10.bmp", 32)

  IF imageHandle >= -1 THEN
    ESCAPETEXT "Could not load NEWFONT9X10.bmp"
    EXIT SUB
  END IF

  imageWidth = _WIDTH(imageHandle)
  imageHeight = _HEIGHT(imageHandle)

  IF imageWidth <> 159 OR imageHeight <> 175 THEN
    _FREEIMAGE imageHandle
    ESCAPETEXT "NEWFONT9X10.bmp must be 159 pixels wide and 175 pixels tall"
    EXIT SUB
  END IF

  originalSource = _SOURCE
  _SOURCE imageHandle

  backgroundColor = POINT(0, 0)

  outFileNum = FREEFILE
  OPEN "TEXT9X10.TXT" FOR OUTPUT AS #outFileNum

  PRINT #outFileNum, "SUB createFont9x10Manual"
  PRINT #outFileNum, ""
  PRINT #outFileNum, "  CLS"
  PRINT #outFileNum, "  COLOR 15"

  quoteText$ = CHR$(34)

  FOR groupY = 0 TO 15
    FOR groupX = 0 TO 3
      firstCharacter = groupY * 16 + groupX * 4

      PRINT #outFileNum, ""
      PRINT #outFileNum, "  ' Characters " + cTrNum$(firstCharacter) + " through " + cTrNum$(firstCharacter + 3)

      FOR rowNumber = 0 TO 9
        lineText$ = "  loadFontPixelRow9 " + cTrNum$(groupX) + ", " + cTrNum$(groupY) + ", " + cTrNum$(rowNumber)

        FOR glyphSlot = 0 TO 3
          glyphNumber = groupX * 4 + glyphSlot
          rowText$ = ""

          ' A 10-pixel column stride skips each vertical divider.
          ' An 11-pixel row stride skips each horizontal divider.
          FOR ix = 0 TO 8
            pixelColor = POINT(glyphNumber * 10 + ix, groupY * 11 + rowNumber)

            IF pixelColor = backgroundColor THEN
              rowText$ = rowText$ + " "
            ELSE
              rowText$ = rowText$ + "F"
            END IF
          NEXT

          lineText$ = lineText$ + ", " + quoteText$ + rowText$ + quoteText$
        NEXT

        PRINT #outFileNum, lineText$
      NEXT
    NEXT
  NEXT

  PRINT #outFileNum, ""
  PRINT #outFileNum, "  CLS"
  PRINT #outFileNum, ""
  PRINT #outFileNum, "END SUB ' createFont9By10Manual"

  CLOSE #outFileNum
  _SOURCE originalSource
  _FREEIMAGE imageHandle

END SUB ' createFont9by10TextFile

