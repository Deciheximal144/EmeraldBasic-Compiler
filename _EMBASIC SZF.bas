''''''''''''''''''''''''
SUB tiraCopyUdtValueId (destBaseType AS LONG, destBaseVal AS _INTEGER64, srcBaseType AS LONG, srcBaseVal AS _INTEGER64, uIdx AS LONG)

  tiraCheckActive ("tiraCopyUdtValueId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM workUdtIndex(MAX_UDTS) AS LONG
  DIM workFieldIndex(MAX_UDTS) AS LONG
  DIM workBaseOffset(MAX_UDTS) AS LONG
  DIM workDepth AS LONG
  DIM currentUdtIndex AS LONG
  DIM currentFieldIndex AS LONG
  DIM nestedUdtIndex AS LONG
  DIM fieldOffset AS LONG
  DIM fieldSize AS LONG
  DIM fieldType AS LONG
  DIM destFieldAddrIdx AS LONG
  DIM srcFieldAddrIdx AS LONG
  DIM srcDescPtrIdx AS LONG
  DIM skipSrcNullLblIdx AS LONG
  DIM emptyDescIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM strAssignIdx AS LONG

  IF uIdx < 0 OR uIdx >= udtCount THEN
    throwCompilerError "INVALID UDT INDEX IN ARGUMENT COPY", ASIS, 0
    EXIT SUB
  END IF

  workDepth = 0
  workUdtIndex(0) = uIdx
  workFieldIndex(0) = 0
  workBaseOffset(0) = 0

  DO WHILE workDepth >= 0
    currentUdtIndex = workUdtIndex(workDepth)
    currentFieldIndex = workFieldIndex(workDepth)

    IF currentFieldIndex >= udts(currentUdtIndex).FieldCount THEN
      workDepth = workDepth - 1
    ELSE
      workFieldIndex(workDepth) = currentFieldIndex + 1

      fieldOffset = workBaseOffset(workDepth) + udtFields(currentUdtIndex, currentFieldIndex).Offset
      fieldSize = udtFields(currentUdtIndex, currentFieldIndex).Size
      fieldType = udtFields(currentUdtIndex, currentFieldIndex).DataType

      IF fieldType = TYPE_UDT THEN
        nestedUdtIndex = udtFields(currentUdtIndex, currentFieldIndex).UDTIndex

        IF nestedUdtIndex < 0 OR nestedUdtIndex >= udtCount THEN
          throwCompilerError "INVALID NESTED UDT INDEX IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        IF workDepth >= MAX_UDTS - 1 THEN
          throwCompilerError "UDT NESTING LIMIT REACHED IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        workDepth = workDepth + 1
        workUdtIndex(workDepth) = nestedUdtIndex
        workFieldIndex(workDepth) = 0
        workBaseOffset(workDepth) = fieldOffset
      ELSE
        destFieldAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFieldAddrIdx, destBaseType, destBaseVal, TIRA_ARG_LITERAL, fieldOffset

        srcFieldAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFieldAddrIdx, srcBaseType, srcBaseVal, TIRA_ARG_LITERAL, fieldOffset

        IF fieldType = TYPE_STRING AND udtFields(currentUdtIndex, currentFieldIndex).IsDynamicString = 1 THEN
          srcDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraReadMemId srcDescPtrIdx, TIRA_ARG_SYMBOL, srcFieldAddrIdx

          skipSrcNullLblIdx = tiraLabelCreateNewId&("SKIP_UDT_SRC_NULL")
          tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, srcDescPtrIdx, TIRA_ARG_LITERAL, 0, skipSrcNullLblIdx
          ff = resolveSymbol("!G_SYS_DSC_EMPTY")
          IF ff = 0 THEN EXIT SUB
          emptyDescIdx = returnedData2
          tiraAssignId srcDescPtrIdx, TIRA_ARG_SYMBOL, emptyDescIdx
          tiraLabelId skipSrcNullLblIdx

          destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraReadMemId destDescPtrIdx, TIRA_ARG_SYMBOL, destFieldAddrIdx

          tiraEnsureStringAllocId destDescPtrIdx, TIRA_ARG_SYMBOL, destFieldAddrIdx

          ff = resolveSymbol("RT_STR_ASSIGN")
          IF ff = 0 THEN EXIT SUB
          strAssignIdx = returnedData2
          tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, destDescPtrIdx, TIRA_ARG_SYMBOL, srcDescPtrIdx
        ELSE
          tiraMemcpyId TIRA_ARG_SYMBOL, destFieldAddrIdx, TIRA_ARG_SYMBOL, srcFieldAddrIdx, TIRA_ARG_LITERAL, fieldSize
        END IF
      END IF
    END IF
  LOOP

END SUB ' tiraCopyUdtValueId

''''''''''''''''''''''''
FUNCTION tiraDimVarId& (baseName$, wDataType AS LONG)

  tiraCheckActive ("tiraDimVarId&")

  IF t.IsActive <> 1 THEN
    tiraDimVarId& = 0
    EXIT FUNCTION
  END IF

  DIM vIdx AS LONG
  DIM varSize AS LONG
  DIM remainder AS LONG

  SELECT CASE wDataType

    CASE TYPE_STRING: typePrefix$ = "TSTR_"
    CASE TYPE_SINGLE: typePrefix$ = "TSNG_"
    CASE TYPE_DOUBLE: typePrefix$ = "TDBL_"
    CASE TYPE_BYTE: typePrefix$ = "TBYT_"
    CASE TYPE_UBYTE: typePrefix$ = "TUBY_"
    CASE TYPE_INTEGER: typePrefix$ = "TINT_"
    CASE TYPE_UINTEGER: typePrefix$ = "TUIN_"
    CASE TYPE_LONG: typePrefix$ = "TLNG_"
    CASE TYPE_ULONG: typePrefix$ = "TULN_"
    CASE TYPE_INTEGER64: typePrefix$ = "TI64_"
    CASE TYPE_UINT64: typePrefix$ = "TU64_"
    CASE TYPE_UDT: typePrefix$ = "TUDT_"
    CASE ELSE: typePrefix$ = "TUNK_"

  END SELECT ' wDataType

  ' Creates a highly readable, SSA-safe ephemeral variable name strictly bound to its datatype
  ' Segregate Runtime Helper variables into their own namespace to prevent corrupting user code variables
  IF isCompilingRT = 1 THEN
    tempName$ = "!R_" + typePrefix$ + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TempCounter)))
  ELSE
    tempName$ = "!" + typePrefix$ + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TempCounter)))
  END IF
  t.TempCounter = t.TempCounter + 1

  ff = resolveSymbol(tempName$)
  IF ff = 0 THEN
    tira_Cancel
    tiraDimVarId& = 0
    EXIT FUNCTION
  END IF
  IF ff = 1 THEN
    vIdx = returnedData2
    symbols(vIdx).DataType = wDataType

    ' Automated Local Routing for Runtime Helpers
    IF isCompilingRT = 1 THEN
      symbols(vIdx).IsLocal = LOCAL_ABSOLUTE

      varSize = 8 ' Default fallback

      SELECT CASE wDataType

        CASE TYPE_BYTE, TYPE_UBYTE: varSize = 1
        CASE TYPE_INTEGER, TYPE_UINTEGER: varSize = 2
        CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE: varSize = 4
        CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE, TYPE_STRING: varSize = 8
        CASE TYPE_UDT: varSize = udts(symbols(vIdx).UDTIndex).TotalSize

      END SELECT ' wDataType

      ' Pad the size to an 8-byte boundary to guarantee stack alignment
      remainder = varSize AND 7 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
      IF remainder <> 0 THEN varSize = varSize + (8 - remainder)

      rtFrameSize = rtFrameSize + varSize
      ' -8 offset accounts for the pushed RBX register in TC_ABI_PROLOGUE
      symbols(vIdx).LocalOffset = -8 - rtFrameSize
    END IF
  END IF

  tiraDimVarId& = vIdx

END FUNCTION ' tiraDimVarId&

''''''''''''''''''''''''
FUNCTION tiraDoubleLiteralId& (literalValue AS DOUBLE)

  tiraCheckActive ("tiraDoubleLiteralId&")

  DIM vIdx AS LONG

  ff = resolveSymbol("!C_PRS_VAL_FLT_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tiraDoubleLiteralId& = 0
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN
    tiraDoubleLiteralId& = 0
    EXIT FUNCTION
  END IF

  vIdx = returnedData2
  symbols(vIdx).DataType = TYPE_DOUBLE
  floatVarData(vIdx) = literalValue

  tiraDoubleLiteralId& = vIdx

END FUNCTION ' tiraDoubleLiteralId&

''''''''''''''''''''''''
SUB tiraDrawCmdFinishMoveId (endXVal AS LONG, endYVal AS LONG, colorVal AS LONG, blindVal AS LONG, noMoveVal AS LONG, currentXVal AS LONG, currentYVal AS LONG, lineFuncVal AS LONG)

  tiraCheckActive ("tiraDrawCmdFinishMoveId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM lineSkipLblIdx AS LONG
  DIM cursorSkipLblIdx AS LONG

  lineSkipLblIdx = tiraLabelCreateNewId&("DRAW_LINE_SKIP")
  cursorSkipLblIdx = tiraLabelCreateNewId&("DRAW_CURSOR_SKIP")

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, blindVal, TIRA_ARG_LITERAL, 0, lineSkipLblIdx
  tiraCallId7 lineFuncVal, TIRA_ARG_SYMBOL, currentXVal, TIRA_ARG_SYMBOL, currentYVal, TIRA_ARG_SYMBOL, endXVal, TIRA_ARG_SYMBOL, endYVal, TIRA_ARG_SYMBOL, colorVal, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 65535
  tiraLabelId lineSkipLblIdx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, noMoveVal, TIRA_ARG_LITERAL, 0, cursorSkipLblIdx
  tiraAssignId currentXVal, TIRA_ARG_SYMBOL, endXVal
  tiraAssignId currentYVal, TIRA_ARG_SYMBOL, endYVal
  tiraLabelId cursorSkipLblIdx

  tiraAssignId blindVal, TIRA_ARG_LITERAL, 0
  tiraAssignId noMoveVal, TIRA_ARG_LITERAL, 0

END SUB ' tiraDrawCmdFinishMoveId

''''''''''''''''''''''''
SUB tiraDrawCmdMoveVectorId (vectorXVal AS LONG, vectorYVal AS LONG, moveAmountType AS LONG, moveAmountVal AS _INTEGER64, scaleVal AS LONG, sineVal AS LONG, cosineVal AS LONG, colorVal AS LONG, blindVal AS LONG, noMoveVal AS LONG, currentXVal AS LONG, currentYVal AS LONG, quarterScaleVal AS LONG, lineFuncVal AS LONG)

  tiraCheckActive ("tiraDrawCmdMoveVectorId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM amountFloatIdx AS LONG
  DIM scaleFloatIdx AS LONG
  DIM scaledAmountIdx AS LONG
  DIM baseXIdx AS LONG
  DIM baseYIdx AS LONG
  DIM rotatedXIdx AS LONG
  DIM turnXIdx AS LONG
  DIM rotatedYIdx AS LONG
  DIM turnYIdx AS LONG
  DIM deltaXIdx AS LONG
  DIM deltaYIdx AS LONG
  DIM endFloatXIdx AS LONG
  DIM endFloatYIdx AS LONG
  DIM endXIdx AS LONG
  DIM endYIdx AS LONG

  amountFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId amountFloatIdx, moveAmountType, moveAmountVal

  scaleFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId scaleFloatIdx, TIRA_ARG_SYMBOL, scaleVal

  scaledAmountIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, scaledAmountIdx, TIRA_ARG_SYMBOL, amountFloatIdx, TIRA_ARG_SYMBOL, scaleFloatIdx
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, scaledAmountIdx, TIRA_ARG_SYMBOL, scaledAmountIdx, TIRA_ARG_SYMBOL, quarterScaleVal

  baseXIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId baseXIdx, TIRA_ARG_SYMBOL, vectorXVal

  baseYIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId baseYIdx, TIRA_ARG_SYMBOL, vectorYVal

  rotatedXIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rotatedXIdx, TIRA_ARG_SYMBOL, baseXIdx, TIRA_ARG_SYMBOL, cosineVal

  turnXIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, turnXIdx, TIRA_ARG_SYMBOL, baseYIdx, TIRA_ARG_SYMBOL, sineVal
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rotatedXIdx, TIRA_ARG_SYMBOL, rotatedXIdx, TIRA_ARG_SYMBOL, turnXIdx

  rotatedYIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rotatedYIdx, TIRA_ARG_SYMBOL, baseYIdx, TIRA_ARG_SYMBOL, cosineVal

  turnYIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, turnYIdx, TIRA_ARG_SYMBOL, baseXIdx, TIRA_ARG_SYMBOL, sineVal
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, rotatedYIdx, TIRA_ARG_SYMBOL, rotatedYIdx, TIRA_ARG_SYMBOL, turnYIdx

  deltaXIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, deltaXIdx, TIRA_ARG_SYMBOL, rotatedXIdx, TIRA_ARG_SYMBOL, scaledAmountIdx

  deltaYIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, deltaYIdx, TIRA_ARG_SYMBOL, rotatedYIdx, TIRA_ARG_SYMBOL, scaledAmountIdx

  endFloatXIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId endFloatXIdx, TIRA_ARG_SYMBOL, currentXVal
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endFloatXIdx, TIRA_ARG_SYMBOL, endFloatXIdx, TIRA_ARG_SYMBOL, deltaXIdx

  endFloatYIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId endFloatYIdx, TIRA_ARG_SYMBOL, currentYVal
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endFloatYIdx, TIRA_ARG_SYMBOL, endFloatYIdx, TIRA_ARG_SYMBOL, deltaYIdx

  endXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId endXIdx, TIRA_ARG_SYMBOL, endFloatXIdx

  endYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId endYIdx, TIRA_ARG_SYMBOL, endFloatYIdx

  tiraDrawCmdFinishMoveId endXIdx, endYIdx, colorVal, blindVal, noMoveVal, currentXVal, currentYVal, lineFuncVal

END SUB ' tiraDrawCmdMoveVectorId

''''''''''''''''''''''''
SUB tiraDrawCmdReadNumberId (dataPtrVal AS LONG, indexVal AS LONG, drawSizeVal AS LONG, valueVal AS LONG, foundVal AS LONG, invalidVal AS LONG)

  ' Relates to DRAW command. Used to extract the numeric values that follow the command letters
  ' in the string, such as reading the "100" out of "U100" while handling positive and negative signs

  tiraCheckActive ("tiraDrawCmdReadNumberId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM negativeVal AS LONG
  DIM signSeenVal AS LONG
  DIM numberPtrVal AS LONG
  DIM numberByteVal AS LONG
  DIM digitVal AS LONG
  DIM plusLblIdx AS LONG
  DIM minusLblIdx AS LONG
  DIM digitTopLblIdx AS LONG
  DIM digitDoneLblIdx AS LONG
  DIM checkTermLblIdx AS LONG
  DIM malformedLblIdx AS LONG
  DIM applySignLblIdx AS LONG
  DIM completeLblIdx AS LONG

  tiraAssignId valueVal, TIRA_ARG_LITERAL, 0
  tiraAssignId foundVal, TIRA_ARG_LITERAL, 0
  tiraAssignId invalidVal, TIRA_ARG_LITERAL, 0

  negativeVal = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId negativeVal, TIRA_ARG_LITERAL, 0

  signSeenVal = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId signSeenVal, TIRA_ARG_LITERAL, 0

  numberPtrVal = tiraDimVarId&("T", TYPE_INTEGER64)
  numberByteVal = tiraDimVarId&("T", TYPE_UBYTE)
  digitVal = tiraDimVarId&("T", TYPE_LONG)

  plusLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_PLUS")
  minusLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_MINUS")
  digitTopLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_DIGIT")
  digitDoneLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_DIGIT_DONE")
  checkTermLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_TERM")
  malformedLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_BAD")
  applySignLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_SIGN")
  completeLblIdx = tiraLabelCreateNewId&("DRAW_NUMBER_DONE")

  tiraDrawCmdSkipWhitespaceId dataPtrVal, indexVal, drawSizeVal

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, drawSizeVal, completeLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numberPtrVal, TIRA_ARG_SYMBOL, dataPtrVal, TIRA_ARG_SYMBOL, indexVal
  tiraReadMemId numberByteVal, TIRA_ARG_SYMBOL, numberPtrVal

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 43, plusLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 45, minusLblIdx
  tiraJmpId digitTopLblIdx

  tiraLabelId plusLblIdx
  tiraAssignId signSeenVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_LITERAL, 1
  tiraJmpId digitTopLblIdx

  tiraLabelId minusLblIdx
  tiraAssignId signSeenVal, TIRA_ARG_LITERAL, 1
  tiraAssignId negativeVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_LITERAL, 1

  tiraLabelId digitTopLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, drawSizeVal, digitDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, numberPtrVal, TIRA_ARG_SYMBOL, dataPtrVal, TIRA_ARG_SYMBOL, indexVal
  tiraReadMemId numberByteVal, TIRA_ARG_SYMBOL, numberPtrVal

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 48, digitDoneLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 57, digitDoneLblIdx

  tiraAssignId foundVal, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, valueVal, TIRA_ARG_SYMBOL, valueVal, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, digitVal, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, valueVal, TIRA_ARG_SYMBOL, valueVal, TIRA_ARG_SYMBOL, digitVal

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_LITERAL, 1
  tiraJmpId digitTopLblIdx

  tiraLabelId digitDoneLblIdx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, foundVal, TIRA_ARG_LITERAL, 0, checkTermLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, signSeenVal, TIRA_ARG_LITERAL, 0, malformedLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, drawSizeVal, completeLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 46, malformedLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 61, malformedLblIdx
  tiraJmpId completeLblIdx

  tiraLabelId checkTermLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, drawSizeVal, applySignLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 46, malformedLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, numberByteVal, TIRA_ARG_LITERAL, 61, malformedLblIdx
  tiraJmpId applySignLblIdx

  tiraLabelId malformedLblIdx
  tiraAssignId invalidVal, TIRA_ARG_LITERAL, 1
  tiraJmpId completeLblIdx

  tiraLabelId applySignLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, negativeVal, TIRA_ARG_LITERAL, 0, completeLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, valueVal, TIRA_ARG_SYMBOL, valueVal

  tiraLabelId completeLblIdx

END SUB ' tiraDrawCmdReadNumberId

''''''''''''''''''''''''
SUB tiraDrawCmdSetRotationId (angleVal AS LONG, sineVal AS LONG, cosineVal AS LONG, degreesToRadiansVal AS LONG, cosFuncVal AS LONG, sinFuncVal AS LONG)

  ' Relates to DRAW command. Used to calculate the sine and cosine values when the DRAW string uses
  ' the Turn Angle (TA) command, which rotates the subsequent drawing vectors by a specific number of degrees

  tiraCheckActive ("tiraDrawCmdSetRotationId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM angleFloatIdx AS LONG
  DIM radiansVal AS LONG

  angleFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId angleFloatIdx, TIRA_ARG_SYMBOL, angleVal

  radiansVal = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, radiansVal, TIRA_ARG_SYMBOL, angleFloatIdx, TIRA_ARG_SYMBOL, degreesToRadiansVal

  tiraCallId1 cosFuncVal, TIRA_ARG_SYMBOL, radiansVal
  tiraGetRetId cosineVal

  tiraCallId1 sinFuncVal, TIRA_ARG_SYMBOL, radiansVal
  tiraGetRetId sineVal

END SUB ' tiraDrawCmdSetRotationId

''''''''''''''''''''''''
SUB tiraDrawCmdSkipWhitespaceId (dataPtrVal AS LONG, indexVal AS LONG, drawSizeVal AS LONG)

  ' Relates to DRAW command. Used to advance the string parser past any blank spaces inside the
  ' DRAW string so it can find the next instruction or number

  tiraCheckActive ("tiraDrawCmdSkipWhitespaceId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM skipTopLblIdx AS LONG
  DIM skipAdvanceLblIdx AS LONG
  DIM skipDoneLblIdx AS LONG
  DIM skipPtrVal AS LONG
  DIM skipByteVal AS LONG

  skipTopLblIdx = tiraLabelCreateNewId&("DRAW_SPACE")
  skipAdvanceLblIdx = tiraLabelCreateNewId&("DRAW_SPACE_ADVANCE")
  skipDoneLblIdx = tiraLabelCreateNewId&("DRAW_SPACE_DONE")

  skipPtrVal = tiraDimVarId&("T", TYPE_INTEGER64)
  skipByteVal = tiraDimVarId&("T", TYPE_UBYTE)

  tiraLabelId skipTopLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, drawSizeVal, skipDoneLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, skipPtrVal, TIRA_ARG_SYMBOL, dataPtrVal, TIRA_ARG_SYMBOL, indexVal
  tiraReadMemId skipByteVal, TIRA_ARG_SYMBOL, skipPtrVal

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, skipByteVal, TIRA_ARG_LITERAL, 32, skipAdvanceLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, skipByteVal, TIRA_ARG_LITERAL, 9, skipDoneLblIdx

  tiraLabelId skipAdvanceLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_SYMBOL, indexVal, TIRA_ARG_LITERAL, 1
  tiraJmpId skipTopLblIdx

  tiraLabelId skipDoneLblIdx

END SUB ' tiraDrawCmdSkipWhitespaceId

''''''''''''''''''''''''
SUB tiraEmitPassByRefCopyOutId (srcArgIdx AS LONG, targetVarIdx AS LONG)

  DIM targetType AS LONG
  DIM fixedLen AS LONG
  DIM lhsDataPtrIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM rhsDataPtrIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM padLenIdx AS LONG
  DIM skipPadLblIdx AS LONG
  DIM padAddrIdx AS LONG
  DIM srcBaseAddrIdx AS LONG
  DIM tgtBaseAddrIdx AS LONG
  DIM strAssignIdx AS LONG

  targetType = symbols(targetVarIdx).DataType

  IF targetType = TYPE_STRING THEN
    fixedLen = retFixedStringLength(srcArgIdx)
    IF fixedLen > 0 THEN
      lhsDataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, srcArgIdx
      tiraReadMemId lhsDataPtrIdx, TIRA_ARG_SYMBOL, lhsDescPtrIdx

      rhsDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, targetVarIdx)
      rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, targetVarIdx)

      minLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
      tiraClampId minLenIdx, TA_EMPTY, 0, TIRA_ARG_LITERAL, fixedLen

      tiraMemcpyId TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, rhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx

      padLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_SYMBOL, minLenIdx
      skipPadLblIdx = tiraLabelCreateNewId&("SKIP_PAD")
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, 0, skipPadLblIdx

      padAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx
      tiraMemSetId TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, padLenIdx
      tiraLabelId skipPadLblIdx
    ELSE
      ff = resolveSymbol("RT_STR_ASSIGN")
      IF ff = 0 THEN EXIT SUB
      strAssignIdx = returnedData2
      tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, srcArgIdx, TIRA_ARG_SYMBOL, targetVarIdx
    END IF
  ELSE
    IF targetType = TYPE_UDT THEN
      srcBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcBaseAddrIdx, TIRA_ARG_SYMBOL, srcArgIdx

      tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx

      tiraCopyUdtValueId TIRA_ARG_SYMBOL, srcBaseAddrIdx, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, symbols(targetVarIdx).UDTIndex
    ELSE
      tiraAssignId srcArgIdx, TIRA_ARG_SYMBOL, targetVarIdx
    END IF
  END IF

END SUB ' tiraEmitPassByRefCopyOutId

''''''''''''''''''''''''
SUB tiraEnsureStringAllocId (descPtrVal AS LONG, targetAddrType AS LONG, targetAddrVal AS _INTEGER64)

  tiraCheckActive ("tiraEnsureStringAllocId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM skipNullLblIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG

  skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 0, skipNullLblIdx

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN EXIT SUB
  heapAllocIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN EXIT SUB
  processHeapIdx = returnedData2

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, 24
  tiraGetRetId descPtrVal

  ' Ensure the new descriptor allocation is successful before writing to memory
  skipOomLblIdx = tiraLabelCreateNewId&("ENSURE_STR_OOM_SKIP")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 0, skipOomLblIdx

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRspId

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 0 THEN EXIT SUB
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = "OUT OF MEMORY"

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN EXIT SUB
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN EXIT SUB
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN EXIT SUB
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN EXIT SUB
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId skipOomLblIdx

  tiraWriteMemId targetAddrType, targetAddrVal, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 8

  tiraLabelId skipNullLblIdx

END SUB ' tiraEnsureStringAllocId

''''''''''''''''''''''''
SUB tiraFatalErrorId (errorText$)

  tiraCheckActive ("tiraFatalErrorId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM renderLockIdx AS LONG
  DIM isFullscreenIdx AS LONG
  DIM lblFixFsIdx AS LONG
  DIM lblFixDoneIdx AS LONG
  DIM wWidthIdx AS LONG
  DIM wHeightIdx AS LONG
  DIM skipGDFixLblIdx AS LONG
  DIM gDoubleIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM getSystemMetricsIdx AS LONG
  DIM frontCountIdx AS LONG
  DIM backCountIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM backgroundIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM currentLineIdx AS LONG
  DIM printIntIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG

  ' Repair the stack to pristine state to guarantee ABI compliance for the print APIs
  tiraSetRspId

  IF cm.HasGraphics = 1 THEN
    ' Release spinlock immediately in case crash occurred during a backbuffer swap
    ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    renderLockIdx = returnedData2
    tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0

    ' Restore corrupted window dimensions to prevent main thread stretchblt crash
    lblFixFsIdx = tiraLabelCreateNewId&("FATAL_FIX_FS")
    lblFixDoneIdx = tiraLabelCreateNewId&("FATAL_FIX_DONE")

    ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    isFullscreenIdx = returnedData2
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFullscreenIdx, TIRA_ARG_LITERAL, 1, lblFixFsIdx

    ' Windowed mode restore
    wWidthIdx = tiraDimVarId&("T", TYPE_LONG)
    wHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId wWidthIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraAssignId wHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    skipGDFixLblIdx = tiraLabelCreateNewId&("FATAL_GD_SKIP")
    ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    gDoubleIdx = returnedData2
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gDoubleIdx, TIRA_ARG_LITERAL, 0, skipGDFixLblIdx
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, wWidthIdx, TIRA_ARG_SYMBOL, wWidthIdx, TIRA_ARG_LITERAL, 2
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, wHeightIdx, TIRA_ARG_SYMBOL, wHeightIdx, TIRA_ARG_LITERAL, 2
    tiraLabelId skipGDFixLblIdx

    ff = resolveSymbol("!G_WND_VAL_WIDTH")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    windowWidthIdx = returnedData2
    tiraAssignId windowWidthIdx, TIRA_ARG_SYMBOL, wWidthIdx

    ff = resolveSymbol("!G_WND_VAL_HEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    windowHeightIdx = returnedData2
    tiraAssignId windowHeightIdx, TIRA_ARG_SYMBOL, wHeightIdx
    tiraJmpId lblFixDoneIdx

    tiraLabelId lblFixFsIdx
    ' Fullscreen mode restore
    ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    getSystemMetricsIdx = returnedData2
    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 0
    tiraGetRetId windowWidthIdx
    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 1
    tiraGetRetId windowHeightIdx

    tiraLabelId lblFixDoneIdx

    ' Sanitize the GDI text overlay counts to prevent the font from glitching out with garbage memory
    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    frontCountIdx = returnedData2
    tiraAssignId frontCountIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    backCountIdx = returnedData2
    tiraAssignId backCountIdx, TIRA_ARG_LITERAL, 0

    ' Reset cursor and viewport bounds to guarantee visibility
    ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewX1Idx = returnedData2
    tiraAssignId viewX1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewY1Idx = returnedData2
    tiraAssignId viewY1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewX2Idx = returnedData2
    tiraAssignId viewX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewY2Idx = returnedData2
    tiraAssignId viewY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewOffsetXIdx = returnedData2
    tiraAssignId viewOffsetXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    viewOffsetYIdx = returnedData2
    tiraAssignId viewOffsetYIdx, TIRA_ARG_LITERAL, 0

    ' Force a high-contrast palette index for the error message
    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    foregroundIdx = returnedData2
    tiraAssignId foregroundIdx, TIRA_ARG_LITERAL, 15

    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    backgroundIdx = returnedData2
    tiraAssignId backgroundIdx, TIRA_ARG_LITERAL, 0

    ' Zero out the top section of the screen to guarantee the text isn't obscured
    ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    frameBackIdx = returnedData2
    tiraMemSetId TIRA_ARG_SYMBOL, frameBackIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, gfxConfig.SizeX * 40
  END IF

  ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    EXIT SUB
  END IF

  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = errorText$ + " ON LINE "

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("!G_SYS_VAL_CURRENT_LINE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  currentLineIdx = returnedData2
  ff = resolveSymbol("RT_PRINT_INT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printIntIdx = returnedData2
  tiraCallId1 printIntIdx, TIRA_ARG_SYMBOL, currentLineIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

END SUB ' tiraFatalErrorId

''''''''''''''''''''''''
SUB tiraFlushFileWriteBufferId

  tiraCheckActive ("tiraFlushFileWriteBufferId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM writeBufferIdx AS LONG
  DIM writeHandleIdx AS LONG
  DIM writeCountIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM skipFlushLblIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG

  ff = findSymbol("!G_FLS_PTR_WRITE_BUFFER")
  IF ff = 0 THEN EXIT SUB
  writeBufferIdx = returnedData2

  ff = findSymbol("!G_FLS_PTR_WRITE_HANDLE")
  IF ff = 0 THEN EXIT SUB
  writeHandleIdx = returnedData2

  ff = findSymbol("!G_FLS_IDX_WRITE_COUNT")
  IF ff = 0 THEN EXIT SUB
  writeCountIdx = returnedData2

  ff = resolveSymbol("IAT_WRITEFILE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  writeFileIdx = returnedData2

  skipFlushLblIdx = tiraLabelCreateNewId&("FILE_WRITE_FLUSH_SKIP")
  IF t.IsActive <> 1 THEN EXIT SUB

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeHandleIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx

  numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
  IF t.IsActive <> 1 THEN EXIT SUB
  numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF t.IsActive <> 1 THEN EXIT SUB
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, writeHandleIdx, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0

  tiraAssignId writeCountIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId writeHandleIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId skipFlushLblIdx

END SUB ' tiraFlushFileWriteBufferId

''''''''''''''''''''''''
SUB tiraForceIntId (srcType AS LONG, srcVal AS _INTEGER64, srcDataType AS LONG)

  tiraCheckActive ("tiraForceIntId")

  DIM resVarIdx AS LONG

  tiraParsedArgType = srcType
  tiraParsedArgVal = srcVal

  ' If the virtual register holds a float, we must create a new integer temp
  ' register and explicitly cast it to force a TIRA conversion in the scheduler
  IF srcDataType = TYPE_SINGLE OR srcDataType = TYPE_DOUBLE THEN
    resVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, resVarIdx, srcType, srcVal, TIRA_ARG_LITERAL, TYPE_LONG
    tiraParsedArgType = TIRA_ARG_SYMBOL
    tiraParsedArgVal = resVarIdx
  END IF

END SUB ' tiraForceIntId

''''''''''''''''''''''''
FUNCTION tiraFrontendCalcAddressId& (vIdx AS LONG, numIndices AS LONG, udtOffset AS LONG)

  tiraCheckActive ("tiraFrontendCalcAddressId&")
  IF tiraLineCheckId THEN EXIT FUNCTION

  DIM elemSize AS LONG
  DIM useStaticLayout AS LONG
  DIM staticLayoutStart AS LONG
  DIM staticDimensionIdx AS LONG
  DIM staticLowerBound AS LONG
  DIM staticElementCount AS LONG
  DIM staticStride AS _INTEGER64
  DIM descriptorByteSize AS LONG
  DIM baseAddrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM hasOffset AS LONG
  DIM multiplierIdx AS LONG
  DIM dimLBoundIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM idxOffsetIdx AS LONG
  DIM idxOffset64Idx AS LONG
  DIM idxTermIdx AS LONG
  DIM curIdxType AS LONG
  DIM curIdxVal AS _INTEGER64
  DIM finalAddrIdx AS LONG
  DIM newAddrIdx AS LONG
  DIM byteOffsetIdx AS LONG


  IF vIdx < 0 OR vIdx >= symbolCount THEN
    throwCompilerError "INVALID SYMBOL INDEX IN ADDRESS CALCULATION", ASIS, 0
    tiraFrontendCalcAddressId& = 0
    EXIT FUNCTION
  END IF

  IF numIndices < 0 OR numIndices > 255 THEN
    throwCompilerError "INVALID INDEX COUNT IN ADDRESS CALCULATION", ASIS, 0
    tiraFrontendCalcAddressId& = 0
    EXIT FUNCTION
  END IF

  useStaticLayout = 0

  IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
    IF numIndices > 0 AND numIndices = symbols(vIdx).NumDimensions THEN
      staticLayoutStart = staticArrayLayoutStart(vIdx)

      IF staticLayoutStart > 0 THEN
        IF staticLayoutStart + numIndices - 1 <= staticArrayDimensionCount THEN useStaticLayout = 1
      END IF
    END IF
  END IF

  baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
    IF useStaticLayout = 1 THEN
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
      descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_LITERAL, descriptorByteSize
    ELSE
      descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx
      tiraReadMemId baseAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx
    END IF
  ELSE
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
  END IF

  offsetVarIdx = 0
  hasOffset = 0

  IF numIndices > 0 THEN
    IF useStaticLayout = 1 THEN
      ' Static arrays use fixed metadata without descriptor reads or runtime stride construction
      FOR iDim = 1 TO numIndices
        curIdxType = tiraParsedArrayArgType(iDim)
        curIdxVal = tiraParsedArrayArgVal(iDim)

        staticDimensionIdx = staticLayoutStart + iDim - 1
        staticLowerBound = staticArrayDimensions(staticDimensionIdx).LowerBound
        staticElementCount = staticArrayDimensions(staticDimensionIdx).ElementCount
        staticStride = staticArrayDimensions(staticDimensionIdx).Stride

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_LITERAL, staticLowerBound

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticElementCount
        END IF

        IF staticStride = 1 THEN
          idxTermIdx = idxOffset64Idx
        ELSE
          idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticStride
        END IF

        IF hasOffset = 0 THEN
          offsetVarIdx = idxTermIdx
          hasOffset = 1
        ELSE
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx
        END IF
      NEXT iDim
    ELSE
      offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId offsetVarIdx, TIRA_ARG_LITERAL, 0
      hasOffset = 1

      multiplierIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId multiplierIdx, TIRA_ARG_LITERAL, 1

      FOR iDim = 1 TO numIndices
        curIdxType = tiraParsedArrayArgType(iDim)
        curIdxVal = tiraParsedArrayArgVal(iDim)

        dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8)

        dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_SYMBOL, dimLBoundIdx

        dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF

        idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, multiplierIdx

        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx

        ' Update multiplier for next dimension: multiplier = multiplier * dimNumElems64
        IF iDim < numIndices THEN
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF
      NEXT iDim
    END IF

    elemSize = retElementByteSize(vIdx)

  END IF

  finalAddrIdx = baseAddrIdx
  IF hasOffset = 1 THEN

    IF elemSize = 1 OR elemSize = 2 OR elemSize = 4 OR elemSize = 8 THEN
      ' Fast Path: Hardware Array Scaling (TC_LEA_SIB)
      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize
      finalAddrIdx = newAddrIdx
    ELSE
      ' Slow Path: Fallback to TC_MUL and TC_ADD
      byteOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteOffsetIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize

      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, byteOffsetIdx
      finalAddrIdx = newAddrIdx
    END IF
  END IF

  IF udtOffset > 0 THEN
    newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, udtOffset
    finalAddrIdx = newAddrIdx
  END IF

  tiraFrontendCalcAddressId& = finalAddrIdx

END FUNCTION ' tiraFrontendCalcAddressId&

''''''''''''''''''''''''
FUNCTION tiraGetPrecedenceId& (opVal AS LONG)

  tiraCheckActive ("tiraGetPrecedenceId")

  DIM precLevel AS _UNSIGNED LONG

  SELECT CASE opVal

    CASE TOK_OP_POW
      precLevel = 11
    CASE TOK_OP_UNARY_MINUS
      precLevel = 10
    CASE TOK_OP_MUL, TOK_OP_DIV
      precLevel = 9
    CASE TOK_OP_IDIV
      precLevel = 8
    CASE TOK_MOD
      precLevel = 7
    CASE TOK_OP_PLUS, TOK_OP_MINUS
      precLevel = 6
    CASE TOK_OP_EQUAL, TOK_OP_LESS, TOK_OP_GREATER, TOK_OP_LESS_EQUAL, TOK_OP_GREATER_EQUAL, TOK_OP_NOT_EQUAL
      precLevel = 5
    CASE TOK_OP_UNARY_NOT
      precLevel = 4
    CASE TOK_AND, TOK_NAND
      precLevel = 3
    CASE TOK_OR, TOK_NOR
      precLevel = 2
    CASE TOK_XOR, TOK_XNOR
      precLevel = 1
    CASE ELSE
      precLevel = 0

  END SELECT ' opVal

  tiraGetPrecedenceId = precLevel

END FUNCTION ' tiraGetPrecedenceId

