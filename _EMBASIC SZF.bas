''''''''''''''''''''''''
SUB tiraInitClassicImplicitArraysId (targetScopeID AS LONG)

  DIM vIdx AS LONG
  DIM isTarget AS LONG
  DIM hasTarget AS LONG
  DIM descriptorByteSize AS LONG
  DIM elemSize AS LONG
  DIM descAddrIdx AS LONG
  DIM dataAddrIdx AS LONG
  DIM metaValueIdx AS LONG

  tiraCheckActive ("tiraInitClassicImplicitArraysId")
  IF tiraLineCheckId THEN EXIT SUB

  IF cm.ClassicMode = 0 THEN EXIT SUB

  hasTarget = 0
  IF symbolCount > 0 THEN
    FOR vIdx = 0 TO symbolCount - 1
      isTarget = 0

      IF targetScopeID = 0 THEN
        isTarget = 1
        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 0
      ELSE
        IF symbols(vIdx).ScopeID = targetScopeID THEN
          IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 1
        END IF
      END IF

      IF isTarget = 1 THEN
        IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
          IF symbols(vIdx).IsExplicit = DECL_IMPLICIT OR symbols(vIdx).IsExplicit = DECL_QUIET THEN
            IF symbols(vIdx).NumDimensions > 0 THEN
              hasTarget = 1
              EXIT FOR
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  IF hasTarget = 0 THEN EXIT SUB

  descAddrIdx = tiraDimVarId&("CLASSIC_ARRAY_DESC", TYPE_INTEGER64)
  dataAddrIdx = tiraDimVarId&("CLASSIC_ARRAY_DATA", TYPE_INTEGER64)
  metaValueIdx = tiraDimVarId&("CLASSIC_ARRAY_META", TYPE_LONG)

  FOR vIdx = 0 TO symbolCount - 1
    isTarget = 0

    IF targetScopeID = 0 THEN
      isTarget = 1
      IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 0
    ELSE
      IF symbols(vIdx).ScopeID = targetScopeID THEN
        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 1
      END IF
    END IF

    IF isTarget = 1 THEN
      IF symbols(vIdx).IsArray = ARRAY_TYPE_STATIC THEN
        IF symbols(vIdx).IsExplicit = DECL_IMPLICIT OR symbols(vIdx).IsExplicit = DECL_QUIET THEN
          IF symbols(vIdx).NumDimensions > 0 THEN
            descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
            elemSize = retElementByteSize(vIdx)

            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_LITERAL, descriptorByteSize
            tiraWriteMemId TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_LITERAL, 8

            tiraAssignId metaValueIdx, TIRA_ARG_LITERAL, elemSize
            tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 8, TIRA_ARG_SYMBOL, metaValueIdx, TIRA_ARG_LITERAL, 4

            tiraAssignId metaValueIdx, TIRA_ARG_LITERAL, symbols(vIdx).NumDimensions
            tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 12, TIRA_ARG_SYMBOL, metaValueIdx, TIRA_ARG_LITERAL, 4

            ' Every implicit dimension has lower bound 0 and element count 11
            ' OPTION BASE 1 changes the implicit lower bound while leaving the upper bound at 10
            FOR iDim = 1 TO symbols(vIdx).NumDimensions
              tiraAssignId metaValueIdx, TIRA_ARG_LITERAL, optionBaseValue
              tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8), TIRA_ARG_SYMBOL, metaValueIdx, TIRA_ARG_LITERAL, 4

              tiraAssignId metaValueIdx, TIRA_ARG_LITERAL, 11 - optionBaseValue
              tiraWriteMemOffsetId TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4, TIRA_ARG_SYMBOL, metaValueIdx, TIRA_ARG_LITERAL, 4
            NEXT
          END IF
        END IF
      END IF
    END IF
  NEXT

END SUB ' tiraInitClassicImplicitArraysId

''''''''''''''''''''''''
SUB tiraInjectPendingDisplayFlushId

  tiraCheckActive ("tiraInjectPendingDisplayFlushId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM autoDisplayIdx AS LONG
  DIM autoDisplayCheckIdx AS LONG
  DIM skipAutoLblIdx AS LONG

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_FLG_AUTO")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    autoDisplayIdx = returnedData2

    ff = resolveSymbol("RT_AUTODISPLAY_CHECK")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    autoDisplayCheckIdx = returnedData2

    skipAutoLblIdx = tiraLabelCreateNewId&("SKIP_AUTO_FLUSH")
    IF compileError = 1 THEN
      tira_Cancel
      EXIT SUB
    END IF
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, autoDisplayIdx, TIRA_ARG_LITERAL, 0, skipAutoLblIdx
    tiraCallId0 autoDisplayCheckIdx
    tiraLabelId skipAutoLblIdx
  END IF

END SUB ' tiraInjectPendingDisplayFlushId

''''''''''''''''''''''''
SUB tiraJmpCondId (jccConst AS LONG, src1Type AS LONG, src1Val AS _INTEGER64, src2Type AS LONG, src2Val AS _INTEGER64, labelIdx AS LONG)

  tiraCheckActive ("tiraJmpCondId")
  IF tiraLineCheckId THEN EXIT SUB

  SELECT CASE jccConst

    CASE JCC_JE, JCC_JNE, JCC_JL, JCC_JLE, JCC_JG, JCC_JGE, JCC_JB, JCC_JBE, JCC_JA, JCC_JAE, JCC_JO, JCC_JNO
      ' Valid
    CASE ELSE
      throwCompilerError "INVALID JCC CONSTANT IN TIRAJMPCONDID", ASIS, 0
      EXIT SUB

  END SELECT ' jccConst

  IF labelIdx < 0 THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF labelIdx >= symbolCount THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF symbols(labelIdx).DataType <> TYPE_LABEL THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF LEFT$(symbols(labelIdx).RecordName, 1) <> "@" THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_JMP_COND

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_STR_LITERAL
  tiraNode(t.LineCount).Arg1Val = jccConst

  tiraNode(t.LineCount).Arg2Type = src1Type
  tiraNode(t.LineCount).Arg2Val = src1Val

  tiraNode(t.LineCount).Arg3Type = src2Type
  tiraNode(t.LineCount).Arg3Val = src2Val

  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_LABEL
  tiraNode(t.LineCount).Arg4Val = labelIdx

  t.LineCount = t.LineCount + 1

END SUB ' tiraJmpCondId

