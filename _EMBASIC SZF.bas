  tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES
  tiraJmpId scanNextLblIdx

  tiraLabelId keyPressedLblIdx

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, latchValueIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_LATCH_MASK
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, latchValueIdx, TIRA_ARG_LITERAL, 0, scanNextLblIdx

  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_SYMBOL, stateValueIdx, TIRA_ARG_LITERAL, KEY_EVENT_LATCH_MASK
