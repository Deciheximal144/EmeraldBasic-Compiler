''''''''''''''''''''''''
FUNCTION tiraLabelCreateNewId& (baseName$)

  tiraCheckActive ("tiraLabelCreateNewId&")

  IF t.IsActive <> 1 THEN
    tiraLabelCreateNewId& = 0
    EXIT FUNCTION
  END IF

  DIM vIdx AS LONG

  IF isCompilingRT = 1 THEN
    labelName$ = "@R_" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  ELSE
    labelName$ = "@" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  END IF

  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    tiraLabelCreateNewId& = 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(labelName$)
  IF ff = 0 THEN
    tira_Cancel
    tiraLabelCreateNewId& = 0
    EXIT FUNCTION
  END IF

  vIdx = returnedData2
  tiraLabelCreateNewId& = vIdx

END FUNCTION ' tiraLabelCreateNewId&

''''''''''''''''''''''''
SUB tiraLabelId (labelIdx AS LONG)

  tiraCheckActive ("tiraLabelId")
  IF tiraLineCheckId THEN EXIT SUB

  IF labelIdx < 0 THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF labelIdx >= symbolCount THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF symbols(labelIdx).DataType <> TYPE_LABEL THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF LEFT$(symbols(labelIdx).RecordName, 1) <> "@" THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_LABEL

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LABEL
  tiraNode(t.LineCount).Arg1Val = labelIdx

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY: tiraNode(t.LineCount).Arg2Val = 0
  tiraNode(t.LineCount).Arg3Type = TA_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TA_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraLabelId

''''''''''''''''''''''''
FUNCTION tiraLineCheckId&

  tiraLineCheckId = 0

  IF t.IsActive <> 1 THEN
    tiraLineCheckId = 1
    EXIT FUNCTION
  END IF

  IF t.LineCount >= MAX_TIRA_LINES THEN
    throwCompilerError "TIRA CODE LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    tiraLineCheckId = 1
  END IF

END FUNCTION ' tiraLineCheckId

''''''''''''''''''''''''
FUNCTION tiraLoadFileStateId& (fileNumType AS LONG, fileNumVal AS _INTEGER64)

  tiraCheckActive ("tiraLoadFileStateId&")
  IF tiraLineCheckId THEN
    tiraLoadFileStateId& = 0
    EXIT FUNCTION
  END IF

  DIM fileNumIdx AS LONG
  DIM handlesArrayIdx AS LONG
  DIM handlesBaseIdx AS LONG
  DIM handleSlotIdx AS LONG
  DIM fileHandleIdx AS LONG
  DIM badFileLblIdx AS LONG
  DIM openFileLblIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM fileModeIdx AS LONG
  DIM recordLenIdx AS LONG
  DIM badModeLblIdx AS LONG
  DIM validModeLblIdx AS LONG

  ensureFileStateSymbol
  IF compileError = 1 THEN
    tira_Cancel
    tiraLoadFileStateId& = 0
    EXIT FUNCTION
  END IF

  fileNumIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, fileNumIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, TYPE_INTEGER64

  badFileLblIdx = tiraLabelCreateNewId&("FILE_BAD_NUMBER")
  openFileLblIdx = tiraLabelCreateNewId&("FILE_OPEN_VALID")

  ' Check the file number before calculating either table address
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, fileNumIdx, TIRA_ARG_LITERAL, 1, badFileLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, fileNumIdx, TIRA_ARG_LITERAL, FS_NUMBER_COUNT, badFileLblIdx

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    tiraLoadFileStateId& = 0
    EXIT FUNCTION
  END IF
  handlesArrayIdx = returnedData2

  handlesBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlesBaseIdx, TIRA_ARG_SYMBOL, handlesArrayIdx

  handleSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, handleSlotIdx, TIRA_ARG_SYMBOL, handlesBaseIdx, TIRA_ARG_SYMBOL, fileNumIdx, TIRA_ARG_LITERAL, 8

  fileHandleIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId fileHandleIdx, TIRA_ARG_SYMBOL, handleSlotIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_LITERAL, 0, badFileLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fileHandleIdx, TIRA_ARG_LITERAL, -1, badFileLblIdx
  tiraJmpId openFileLblIdx

  tiraLabelId badFileLblIdx
  tiraFatalErrorId "BAD FILE NUMBER"
  tiraLabelId openFileLblIdx

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 0 THEN
    tira_Cancel
    tiraLoadFileStateId& = 0
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileNumIdx, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES

  fileModeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId fileModeIdx, TIRA_ARG_SYMBOL, stateSlotIdx

  badModeLblIdx = tiraLabelCreateNewId&("FILE_BAD_MODE")
  validModeLblIdx = tiraLabelCreateNewId&("FILE_MODE_VALID")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_BINARY, badModeLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, fileModeIdx, TIRA_ARG_LITERAL, FS_MODE_OUTPUT, validModeLblIdx

  tiraLabelId badModeLblIdx
  tiraFatalErrorId "BAD FILE MODE"
  tiraLabelId validModeLblIdx

  recordLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId recordLenIdx, TIRA_ARG_SYMBOL, stateSlotIdx, FS_STATE_RECORD_LENGTH_OFFSET

  IF compileError = 1 THEN
    tira_Cancel
    tiraLoadFileStateId& = 0
    EXIT FUNCTION
  END IF

  return2 fileModeIdx
  return3 recordLenIdx
  tiraLoadFileStateId& = fileHandleIdx

END FUNCTION ' tiraLoadFileStateId&

