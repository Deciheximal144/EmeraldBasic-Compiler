''''''''''''''''''''''''
SUB emitRuntimeDrawTextAbsolute

  DIM textRowHeight AS LONG
  DIM sourceFontHeight AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontArrayIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM lastBgIdx AS LONG
  DIM argPtrIdx AS LONG
  DIM argLenIdx AS LONG
  DIM argXIdx AS LONG
  DIM argYIdx AS LONG
  DIM argFgIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM sourceFontHeightVarIdx AS LONG
  DIM sourceFontReadyLblIdx AS LONG
  DIM fontPtrIdx AS LONG
  DIM fontPtrReadyLblIdx AS LONG
  DIM charIdx AS LONG
  DIM lblCharLoopIdx AS LONG
  DIM lblCharDoneIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM charValIdx AS LONG
  DIM fontOffsetXIdx AS LONG
  DIM fontOffsetYIdx AS LONG
  DIM iyIdx AS LONG
  DIM lblYLoopIdx AS LONG
  DIM lblYDoneIdx AS LONG
  DIM sourceFontYIdx AS LONG
  DIM ixIdx AS LONG
  DIM lblXLoopIdx AS LONG
  DIM lblXDoneIdx AS LONG
  DIM pixYIdx AS LONG
  DIM pixXIdx AS LONG
  DIM pixOffsetIdx AS LONG
  DIM pixAddrIdx AS LONG
  DIM fontPixIdx AS LONG
  DIM charPixelXIdx AS LONG
  DIM tgtXIdx AS LONG
  DIM tgtYIdx AS LONG
  DIM lblSkipPsetIdx AS LONG
  DIM fbOffsetIdx AS LONG
  DIM fbAddrIdx AS LONG
  DIM lblDrawBgIdx AS LONG
  DIM lblDrawDoneIdx AS LONG

  rtOffset(RT_DRAW_TEXT_ABSOLUTE) = stream.emitPos

  textRowHeight = 8
  sourceFontHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16
      sourceFontHeight = 16

  END SELECT ' compileScreenMode

  ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
  IF ff = 0 THEN EXIT SUB
  fontHeightGlobalIdx = returnedData2

  ff = resolveSymbol("!G_SYS_ARR_FONT")
  IF ff = 0 THEN EXIT SUB
  fontArrayIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN EXIT SUB
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
  IF ff = 0 THEN EXIT SUB
  lastBgIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argPtrIdx = tiraDimVarId&("ARG_PTR", TYPE_INTEGER64)
  tiraAbiReadArgId argPtrIdx, 1

  argLenIdx = tiraDimVarId&("ARG_LEN", TYPE_LONG)
  tiraAbiReadArgId argLenIdx, 2

  argXIdx = tiraDimVarId&("ARG_X", TYPE_LONG)
  tiraAbiReadArgId argXIdx, 3

  argYIdx = tiraDimVarId&("ARG_Y", TYPE_LONG)
  tiraAbiReadArgId argYIdx, 4

  argFgIdx = tiraDimVarId&("ARG_FG", TYPE_LONG)
  tiraAbiReadArgId argFgIdx, 5

  fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

  fontHeightReadyLblIdx = tiraLabelCreateNewId&("FONT_HEIGHT_READY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
  tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
  tiraLabelId fontHeightReadyLblIdx

  sourceFontHeightVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId sourceFontHeightVarIdx, TIRA_ARG_LITERAL, sourceFontHeight

  sourceFontReadyLblIdx = tiraLabelCreateNewId&("SOURCE_FONT_READY")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight, sourceFontReadyLblIdx
  tiraAssignId sourceFontHeightVarIdx, TIRA_ARG_LITERAL, 8
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 16, sourceFontReadyLblIdx
  tiraAssignId sourceFontHeightVarIdx, TIRA_ARG_LITERAL, 16
  tiraLabelId sourceFontReadyLblIdx

  fontPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, fontPtrIdx, TIRA_ARG_SYMBOL, fontArrayIdx

  fontPtrReadyLblIdx = tiraLabelCreateNewId&("FONT_PTR_READY")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, sourceFontHeightVarIdx, TIRA_ARG_LITERAL, 16, fontPtrReadyLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fontPtrIdx, TIRA_ARG_SYMBOL, fontPtrIdx, TIRA_ARG_LITERAL, FONT8_DATA_SIZE
  tiraLabelId fontPtrReadyLblIdx

  charIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId charIdx, TIRA_ARG_LITERAL, 0

  lblCharLoopIdx = tiraLabelCreateNewId&("CHAR_LOOP")
  lblCharDoneIdx = tiraLabelCreateNewId&("CHAR_DONE")
  tiraLabelId lblCharLoopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, charIdx, TIRA_ARG_SYMBOL, argLenIdx, lblCharDoneIdx

  charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, argPtrIdx, TIRA_ARG_SYMBOL, charIdx

  charByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charAddrIdx
  charValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId charValIdx, TIRA_ARG_SYMBOL, charByteIdx

  fontOffsetXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, fontOffsetXIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fontOffsetXIdx, TIRA_ARG_SYMBOL, fontOffsetXIdx, TIRA_ARG_LITERAL, 8

  fontOffsetYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, fontOffsetYIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fontOffsetYIdx, TIRA_ARG_SYMBOL, fontOffsetYIdx, TIRA_ARG_SYMBOL, sourceFontHeightVarIdx

  iyIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iyIdx, TIRA_ARG_LITERAL, 0
  lblYLoopIdx = tiraLabelCreateNewId&("Y_LOOP")
  lblYDoneIdx = tiraLabelCreateNewId&("Y_DONE")
  tiraLabelId lblYLoopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, iyIdx, TIRA_ARG_SYMBOL, fontHeightIdx, lblYDoneIdx

  sourceFontYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sourceFontYIdx, TIRA_ARG_SYMBOL, iyIdx, TIRA_ARG_SYMBOL, sourceFontHeightVarIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, sourceFontYIdx, TIRA_ARG_SYMBOL, sourceFontYIdx, TIRA_ARG_SYMBOL, fontHeightIdx

  ixIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId ixIdx, TIRA_ARG_LITERAL, 0
  lblXLoopIdx = tiraLabelCreateNewId&("X_LOOP")
  lblXDoneIdx = tiraLabelCreateNewId&("X_DONE")
  tiraLabelId lblXLoopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, ixIdx, TIRA_ARG_LITERAL, 8, lblXDoneIdx

  pixYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pixYIdx, TIRA_ARG_SYMBOL, fontOffsetYIdx, TIRA_ARG_SYMBOL, sourceFontYIdx
  pixXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pixXIdx, TIRA_ARG_SYMBOL, fontOffsetXIdx, TIRA_ARG_SYMBOL, ixIdx

  pixOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, pixOffsetIdx, TIRA_ARG_SYMBOL, pixYIdx, TIRA_ARG_LITERAL, 128
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pixOffsetIdx, TIRA_ARG_SYMBOL, pixOffsetIdx, TIRA_ARG_SYMBOL, pixXIdx

  pixAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pixAddrIdx, TIRA_ARG_SYMBOL, fontPtrIdx, TIRA_ARG_SYMBOL, pixOffsetIdx

  fontPixIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId fontPixIdx, TIRA_ARG_SYMBOL, pixAddrIdx

  ' Evaluate absolute pixel coordinates
  charPixelXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, charPixelXIdx, TIRA_ARG_SYMBOL, charIdx, TIRA_ARG_LITERAL, 8

  tgtXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tgtXIdx, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, charPixelXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tgtXIdx, TIRA_ARG_SYMBOL, tgtXIdx, TIRA_ARG_SYMBOL, ixIdx

  tgtYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tgtYIdx, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, iyIdx

  lblSkipPsetIdx = tiraLabelCreateNewId&("SKIP_PSET")

  ' Check bounds cleanly. The unsigned jump handles both zero limits and maximum boundaries seamlessly
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, tgtXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, lblSkipPsetIdx
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, tgtYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, lblSkipPsetIdx

  fbOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbOffsetIdx, TIRA_ARG_SYMBOL, tgtYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fbOffsetIdx, TIRA_ARG_SYMBOL, fbOffsetIdx, TIRA_ARG_SYMBOL, tgtXIdx

  fbAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fbAddrIdx, TIRA_ARG_SYMBOL, destFrameIdx, TIRA_ARG_SYMBOL, fbOffsetIdx

  lblDrawBgIdx = tiraLabelCreateNewId&("DRAW_BG")
  lblDrawDoneIdx = tiraLabelCreateNewId&("DRAW_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fontPixIdx, TIRA_ARG_LITERAL, 0, lblDrawBgIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, fbAddrIdx, TIRA_ARG_SYMBOL, argFgIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblDrawDoneIdx

  tiraLabelId lblDrawBgIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, fbAddrIdx, TIRA_ARG_SYMBOL, lastBgIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId lblDrawDoneIdx
  tiraLabelId lblSkipPsetIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ixIdx, TIRA_ARG_SYMBOL, ixIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblXLoopIdx
  tiraLabelId lblXDoneIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iyIdx, TIRA_ARG_SYMBOL, iyIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblYLoopIdx
  tiraLabelId lblYDoneIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charIdx, TIRA_ARG_SYMBOL, charIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblCharLoopIdx

  tiraLabelId lblCharDoneIdx

  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeDrawTextAbsolute

''''''''''''''''''''''''
SUB emitRuntimeGfxCopyPage

  ' Stretches and copies pixel data from a source graphics page into a destination page rectangle

  DIM tempHeapIdx AS LONG
  DIM backFrameIdx AS LONG
  DIM page1FrameIdx AS LONG
  DIM page2FrameIdx AS LONG
  DIM page3FrameIdx AS LONG
  DIM page2WidthIdx AS LONG
  DIM page2HeightIdx AS LONG
  DIM page3WidthIdx AS LONG
  DIM page3HeightIdx AS LONG
  DIM destPageIdx AS LONG
  DIM destX1Idx AS LONG
  DIM destY1Idx AS LONG
  DIM destX2Idx AS LONG
  DIM destY2Idx AS LONG
  DIM argSrcIdx AS LONG
  DIM argDestIdx AS LONG
  DIM heapMarkIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM skipXSwapIdx AS LONG
  DIM ptr1Idx AS LONG
  DIM ptr2Idx AS LONG
  DIM skipYSwapIdx AS LONG
  DIM ptr1YIdx AS LONG
  DIM ptr2YIdx AS LONG
  DIM keepDestRectIdx AS LONG
  DIM normalizeDestIdx AS LONG
  DIM requestedWIdx AS LONG
  DIM requestedHIdx AS LONG
  DIM dstWIdx AS LONG
  DIM dstHIdx AS LONG
  DIM lblSrc0Idx AS LONG
  DIM lblSrc1Idx AS LONG
  DIM lblSrc2Idx AS LONG
  DIM lblSrc3Idx AS LONG
  DIM lblSrcEndIdx AS LONG
  DIM ptrSrcFbIdx AS LONG
  DIM lblDest0Idx AS LONG
  DIM lblDest1Idx AS LONG
  DIM lblDest2Idx AS LONG
  DIM lblDest3Idx AS LONG
  DIM lblDestEndIdx AS LONG
  DIM ptrDestFbIdx AS LONG
  DIM srcWIdx AS LONG
  DIM srcHIdx AS LONG
  DIM srcDimsDoneIdx AS LONG
  DIM checkPage3Idx AS LONG
  DIM sourceCopyDoneIdx AS LONG
  DIM sourceCopySizeIdx AS LONG
  DIM sourceCopyPtrIdx AS LONG
  DIM srcWMinus1Idx AS LONG
  DIM srcHMinus1Idx AS LONG
  DIM yItrIdx AS LONG
  DIM lblLoopYIdx AS LONG
  DIM lblDoneYIdx AS LONG
  DIM absYIdx AS LONG
  DIM skipRowIdx AS LONG
  DIM srcYIdx AS LONG
  DIM srcRowOffsetIdx AS LONG
  DIM dstRowOffsetIdx AS LONG
  DIM xItrIdx AS LONG
  DIM lblLoopXIdx AS LONG
  DIM lblDoneXIdx AS LONG
  DIM absXIdx AS LONG
  DIM skipPixIdx AS LONG
  DIM srcXIdx AS LONG
  DIM srcOffsetIdx AS LONG
  DIM srcAddrIdx AS LONG
  DIM pixelIdx AS LONG
  DIM dstOffsetIdx AS LONG
  DIM dstAddrIdx AS LONG
  DIM skipExplicitRedrawIdx AS LONG

  rtOffset(33) = stream.emitPos

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN EXIT SUB
  tempHeapIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  IF ff = 0 THEN EXIT SUB
  backFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  IF ff = 0 THEN EXIT SUB
  page1FrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  IF ff = 0 THEN EXIT SUB
  page2FrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  IF ff = 0 THEN EXIT SUB
  page3FrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_PAGE2W")
  IF ff = 0 THEN EXIT SUB
  page2WidthIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_PAGE2H")
  IF ff = 0 THEN EXIT SUB
  page2HeightIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_PAGE3W")
  IF ff = 0 THEN EXIT SUB
  page3WidthIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_PAGE3H")
  IF ff = 0 THEN EXIT SUB
  page3HeightIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  IF ff = 0 THEN EXIT SUB
  destPageIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  destX1Idx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId destX1Idx, 1
  destY1Idx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId destY1Idx, 2
  destX2Idx = tiraDimVarId&("ARG3", TYPE_LONG)
  tiraAbiReadArgId destX2Idx, 3
  destY2Idx = tiraDimVarId&("ARG4", TYPE_LONG)
  tiraAbiReadArgId destY2Idx, 4
  argSrcIdx = tiraDimVarId&("ARG5", TYPE_LONG)
  tiraAbiReadArgId argSrcIdx, 5
  argDestIdx = tiraDimVarId&("ARG6", TYPE_LONG)
  tiraAbiReadArgId argDestIdx, 6

  heapMarkIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId heapMarkIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  lblDoneIdx = tiraLabelCreateNewId&("PUTIMG_DONE")

  skipXSwapIdx = tiraLabelCreateNewId&("PUTIMG_SKIP_X")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, destX1Idx, TIRA_ARG_SYMBOL, destX2Idx, skipXSwapIdx
  ptr1Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  ptr2Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, destX1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_SYMBOL, destX2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_LITERAL, 4
  tiraLabelId skipXSwapIdx

  skipYSwapIdx = tiraLabelCreateNewId&("PUTIMG_SKIP_Y")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, destY1Idx, TIRA_ARG_SYMBOL, destY2Idx, skipYSwapIdx
  ptr1YIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ptr2YIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr1YIdx, TIRA_ARG_SYMBOL, destY1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr2YIdx, TIRA_ARG_SYMBOL, destY2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, ptr1YIdx, TIRA_ARG_SYMBOL, ptr2YIdx, TIRA_ARG_LITERAL, 4
  tiraLabelId skipYSwapIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 3, lblDoneIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 3, lblDoneIdx

  ' Page 0 and page 1 use the fixed framebuffer that the window procedure stretches
  ' Normalize a larger full-screen destination so the complete source reaches that framebuffer
  keepDestRectIdx = tiraLabelCreateNewId&("PUTIMG_KEEP_DEST")
  normalizeDestIdx = tiraLabelCreateNewId&("PUTIMG_NORMALIZE_DEST")

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 1, keepDestRectIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, destX1Idx, TIRA_ARG_LITERAL, 0, keepDestRectIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, destY1Idx, TIRA_ARG_LITERAL, 0, keepDestRectIdx

  requestedWIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, requestedWIdx, TIRA_ARG_SYMBOL, destX2Idx, TIRA_ARG_SYMBOL, destX1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requestedWIdx, TIRA_ARG_SYMBOL, requestedWIdx, TIRA_ARG_LITERAL, 1

  requestedHIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, requestedHIdx, TIRA_ARG_SYMBOL, destY2Idx, TIRA_ARG_SYMBOL, destY1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requestedHIdx, TIRA_ARG_SYMBOL, requestedHIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, requestedWIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, normalizeDestIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, requestedHIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, normalizeDestIdx
  tiraJmpId keepDestRectIdx

  tiraLabelId normalizeDestIdx
  tiraAssignId destX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX - 1
  tiraAssignId destY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY - 1

  tiraLabelId keepDestRectIdx

  dstWIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dstWIdx, TIRA_ARG_SYMBOL, destX2Idx, TIRA_ARG_SYMBOL, destX1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dstWIdx, TIRA_ARG_SYMBOL, dstWIdx, TIRA_ARG_LITERAL, 1

  dstHIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dstHIdx, TIRA_ARG_SYMBOL, destY2Idx, TIRA_ARG_SYMBOL, destY1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dstHIdx, TIRA_ARG_SYMBOL, dstHIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dstWIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, dstHIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  lblSrc0Idx = tiraLabelCreateNewId&("SRC_0")
  lblSrc1Idx = tiraLabelCreateNewId&("SRC_1")
  lblSrc2Idx = tiraLabelCreateNewId&("SRC_2")
  lblSrc3Idx = tiraLabelCreateNewId&("SRC_3")
  lblSrcEndIdx = tiraLabelCreateNewId&("SRC_END")

  ptrSrcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 0, lblSrc0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 1, lblSrc1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 2, lblSrc2Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 3, lblSrc3Idx
  tiraJmpId lblDoneIdx

  tiraLabelId lblSrc0Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, backFrameIdx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc1Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, page1FrameIdx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc2Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, page2FrameIdx
  tiraJmpId lblSrcEndIdx

  tiraLabelId lblSrc3Idx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, page3FrameIdx

  tiraLabelId lblSrcEndIdx

  lblDest0Idx = tiraLabelCreateNewId&("DEST_0")
  lblDest1Idx = tiraLabelCreateNewId&("DEST_1")
  lblDest2Idx = tiraLabelCreateNewId&("DEST_2")
  lblDest3Idx = tiraLabelCreateNewId&("DEST_3")
  lblDestEndIdx = tiraLabelCreateNewId&("DEST_END")

  ptrDestFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 0, lblDest0Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 1, lblDest1Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 2, lblDest2Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_LITERAL, 3, lblDest3Idx
  tiraJmpId lblDoneIdx

  tiraLabelId lblDest0Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, backFrameIdx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest1Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, page1FrameIdx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest2Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, page2FrameIdx
  tiraJmpId lblDestEndIdx

  tiraLabelId lblDest3Idx
  tiraAssignId ptrDestFbIdx, TIRA_ARG_SYMBOL, page3FrameIdx

  tiraLabelId lblDestEndIdx

  srcWIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId srcWIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  srcHIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId srcHIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY

  ' Page 2 and Page 3 retain the dimensions supplied to _NEWIMAGE
  srcDimsDoneIdx = tiraLabelCreateNewId&("PUTIMG_SRC_DIMS_DONE")
  checkPage3Idx = tiraLabelCreateNewId&("PUTIMG_CHK_PG3")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 3, checkPage3Idx

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, argSrcIdx, TIRA_ARG_LITERAL, 2, srcDimsDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, page2WidthIdx, TIRA_ARG_LITERAL, 0, srcDimsDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, page2HeightIdx, TIRA_ARG_LITERAL, 0, srcDimsDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, page2WidthIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, srcDimsDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, page2HeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, srcDimsDoneIdx

  tiraAssignId srcWIdx, TIRA_ARG_SYMBOL, page2WidthIdx
  tiraAssignId srcHIdx, TIRA_ARG_SYMBOL, page2HeightIdx
  tiraJmpId srcDimsDoneIdx

  tiraLabelId checkPage3Idx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, page3WidthIdx, TIRA_ARG_LITERAL, 0, srcDimsDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, page3HeightIdx, TIRA_ARG_LITERAL, 0, srcDimsDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, page3WidthIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, srcDimsDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, page3HeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, srcDimsDoneIdx

  tiraAssignId srcWIdx, TIRA_ARG_SYMBOL, page3WidthIdx
  tiraAssignId srcHIdx, TIRA_ARG_SYMBOL, page3HeightIdx

  tiraLabelId srcDimsDoneIdx

  ' When source and destination share a framebuffer, preserve the complete source before drawing
  sourceCopyDoneIdx = tiraLabelCreateNewId&("PUTIMG_SOURCE_COPY_DONE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, ptrSrcFbIdx, TIRA_ARG_SYMBOL, ptrDestFbIdx, sourceCopyDoneIdx

  sourceCopySizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId sourceCopySizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  sourceCopyPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, sourceCopySizeIdx)
  tiraMemcpyId TIRA_ARG_SYMBOL, sourceCopyPtrIdx, TIRA_ARG_SYMBOL, ptrSrcFbIdx, TIRA_ARG_SYMBOL, sourceCopySizeIdx
  tiraAssignId ptrSrcFbIdx, TIRA_ARG_SYMBOL, sourceCopyPtrIdx

  tiraLabelId sourceCopyDoneIdx

  srcWMinus1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, srcWMinus1Idx, TIRA_ARG_SYMBOL, srcWIdx, TIRA_ARG_LITERAL, 1

  srcHMinus1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, srcHMinus1Idx, TIRA_ARG_SYMBOL, srcHIdx, TIRA_ARG_LITERAL, 1

  yItrIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId yItrIdx, TIRA_ARG_LITERAL, 0

  lblLoopYIdx = tiraLabelCreateNewId&("PUTIMG_LOOPY")
  lblDoneYIdx = tiraLabelCreateNewId&("PUTIMG_DONEY")

  tiraLabelId lblLoopYIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, yItrIdx, TIRA_ARG_SYMBOL, dstHIdx, lblDoneYIdx

  absYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, destY1Idx, TIRA_ARG_SYMBOL, yItrIdx

  skipRowIdx = tiraLabelCreateNewId&("PUTIMG_SKIPROW")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, 0, skipRowIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipRowIdx

  srcYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, srcYIdx, TIRA_ARG_SYMBOL, yItrIdx, TIRA_ARG_SYMBOL, srcHIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, srcYIdx, TIRA_ARG_SYMBOL, srcYIdx, TIRA_ARG_SYMBOL, dstHIdx
  tiraClampId srcYIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, srcHMinus1Idx

  srcRowOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, srcRowOffsetIdx, TIRA_ARG_SYMBOL, srcYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  dstRowOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, dstRowOffsetIdx, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  xItrIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId xItrIdx, TIRA_ARG_LITERAL, 0

  lblLoopXIdx = tiraLabelCreateNewId&("PUTIMG_LOOPX")
  lblDoneXIdx = tiraLabelCreateNewId&("PUTIMG_DONEX")

  tiraLabelId lblLoopXIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, xItrIdx, TIRA_ARG_SYMBOL, dstWIdx, lblDoneXIdx

  absXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, destX1Idx, TIRA_ARG_SYMBOL, xItrIdx

  skipPixIdx = tiraLabelCreateNewId&("PUTIMG_SKIPPIX")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_LITERAL, 0, skipPixIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipPixIdx

  srcXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, srcXIdx, TIRA_ARG_SYMBOL, xItrIdx, TIRA_ARG_SYMBOL, srcWIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, srcXIdx, TIRA_ARG_SYMBOL, srcXIdx, TIRA_ARG_SYMBOL, dstWIdx
  tiraClampId srcXIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, srcWMinus1Idx

  srcOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcOffsetIdx, TIRA_ARG_SYMBOL, srcRowOffsetIdx, TIRA_ARG_SYMBOL, srcXIdx

  srcAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcAddrIdx, TIRA_ARG_SYMBOL, ptrSrcFbIdx, TIRA_ARG_SYMBOL, srcOffsetIdx

  pixelIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId pixelIdx, TIRA_ARG_SYMBOL, srcAddrIdx

  dstOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dstOffsetIdx, TIRA_ARG_SYMBOL, dstRowOffsetIdx, TIRA_ARG_SYMBOL, absXIdx

  dstAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dstAddrIdx, TIRA_ARG_SYMBOL, ptrDestFbIdx, TIRA_ARG_SYMBOL, dstOffsetIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, dstAddrIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipPixIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, xItrIdx, TIRA_ARG_SYMBOL, xItrIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopXIdx

  tiraLabelId lblDoneXIdx
  tiraLabelId skipRowIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yItrIdx, TIRA_ARG_SYMBOL, yItrIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopYIdx

  tiraLabelId lblDoneYIdx

  ' Explicit destinations can differ from the currently selected _DEST page
  skipExplicitRedrawIdx = tiraLabelCreateNewId&("PUTIMG_SKIP_REDRAW")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argDestIdx, TIRA_ARG_SYMBOL, destPageIdx, skipExplicitRedrawIdx
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, argDestIdx
  tiraLabelId skipExplicitRedrawIdx

  tiraLabelId lblDoneIdx

  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, heapMarkIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeGfxCopyPage

''''''''''''''''''''''''
SUB emitRuntimeGfxGet

  DIM captureBits AS LONG
  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM sourceFrameIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM argX1Idx AS LONG
  DIM argY1Idx AS LONG
  DIM argX2Idx AS LONG
  DIM argY2Idx AS LONG
  DIM argPtrIdx AS LONG
  DIM argEndIdx AS LONG
  DIM ptr1Idx AS LONG
  DIM ptr2Idx AS LONG
  DIM skipXSwapLblIdx AS LONG
  DIM skipYSwapLblIdx AS LONG
  DIM widthIdx AS LONG
  DIM heightIdx AS LONG
  DIM headerWidthIdx AS LONG
  DIM rowBytesIdx AS LONG
  DIM rowPayloadBytesIdx AS LONG
  DIM payloadBytesIdx AS LONG
  DIM requiredEndIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM heightPtrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM frameBaseIdx AS LONG
  DIM iterYIdx AS LONG
  DIM loopYLblIdx AS LONG
  DIM rowOffsetIdx AS LONG
  DIM rowStartPtrIdx AS LONG
  DIM bitMaskIdx AS LONG
  DIM byteIndexIdx AS LONG
  DIM iterXIdx AS LONG
  DIM loopXLblIdx AS LONG
  DIM endXLblIdx AS LONG
  DIM absXIdx AS LONG
  DIM absYIdx AS LONG
  DIM pixelIdx AS LONG
  DIM skipBoundsLblIdx AS LONG
  DIM offsetIdx AS LONG
  DIM pixelAddrIdx AS LONG
  DIM pixel8Idx AS LONG
  DIM planeBitIdx AS LONG
  DIM planeAddrIdx AS LONG
  DIM planeByteIdx AS LONG
  DIM planeOffsetIdx AS LONG
  DIM skipPlane1LblIdx AS LONG
  DIM skipPlane2LblIdx AS LONG
  DIM skipPlane3LblIdx AS LONG
  DIM skipPlane4LblIdx AS LONG
  DIM bitAdvanceDoneLblIdx AS LONG
  DIM writeAddrIdx AS LONG

  captureBits = 8

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      captureBits = 4

  END SELECT ' compileScreenMode

  rtOffset(RT_GET) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
  IF ff = 0 THEN EXIT SUB
  viewOffsetXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
  IF ff = 0 THEN EXIT SUB
  viewOffsetYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
  IF ff = 0 THEN EXIT SUB
  sourceFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
  IF ff = 0 THEN EXIT SUB
  viewX1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
  IF ff = 0 THEN EXIT SUB
  viewX2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
  IF ff = 0 THEN EXIT SUB
  viewY1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
  IF ff = 0 THEN EXIT SUB
  viewY2Idx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argX1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId argX1Idx, 1

  argY1Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId argY1Idx, 2

  argX2Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId argX2Idx, 3

  argY2Idx = tiraDimVarId&("T", TYPE_LONG)
  tiraAbiReadArgId argY2Idx, 4

  argPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAbiReadArgId argPtrIdx, 5

  argEndIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAbiReadArgId argEndIdx, 6

  ' Adjust incoming bounds cleanly using the established viewing origin
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argX1Idx, TIRA_ARG_SYMBOL, argX1Idx, TIRA_ARG_SYMBOL, viewOffsetXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argY1Idx, TIRA_ARG_SYMBOL, argY1Idx, TIRA_ARG_SYMBOL, viewOffsetYIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argX2Idx, TIRA_ARG_SYMBOL, argX2Idx, TIRA_ARG_SYMBOL, viewOffsetXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argY2Idx, TIRA_ARG_SYMBOL, argY2Idx, TIRA_ARG_SYMBOL, viewOffsetYIdx

  ' Swap X bounds if X1 > X2
  ptr1Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  ptr2Idx = tiraDimVarId&("T", TYPE_INTEGER64)

  skipXSwapLblIdx = tiraLabelCreateNewId&("GET_SKIP_X")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, argX1Idx, TIRA_ARG_SYMBOL, argX2Idx, skipXSwapLblIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, argX1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_SYMBOL, argX2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_LITERAL, 4
  tiraLabelId skipXSwapLblIdx

  ' Swap Y bounds if Y1 > Y2
  skipYSwapLblIdx = tiraLabelCreateNewId&("GET_SKIP_Y")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, argY1Idx, TIRA_ARG_SYMBOL, argY2Idx, skipYSwapLblIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, argY1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_SYMBOL, argY2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, ptr1Idx, TIRA_ARG_SYMBOL, ptr2Idx, TIRA_ARG_LITERAL, 4
  tiraLabelId skipYSwapLblIdx

  ' Calculate captured width and height
  widthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_SYMBOL, argX2Idx, TIRA_ARG_SYMBOL, argX1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_LITERAL, 1

  heightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, heightIdx, TIRA_ARG_SYMBOL, argY2Idx, TIRA_ARG_SYMBOL, argY1Idx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, heightIdx, TIRA_ARG_SYMBOL, heightIdx, TIRA_ARG_LITERAL, 1

  headerWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  rowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
  rowPayloadBytesIdx = tiraDimVarId&("T", TYPE_LONG)

  IF captureBits = 4 THEN
    ' SCREEN 7, 8, 9 and 12 store the pixel width directly
    tiraAssignId headerWidthIdx, TIRA_ARG_SYMBOL, widthIdx

    ' Each bitplane scanline is padded to a complete byte
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_LITERAL, 7
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 8

    ' Four consecutive bitplanes are stored for every scanline
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rowPayloadBytesIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 4
  ELSE
    ' SCREEN 13 stores the width in bits
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, headerWidthIdx, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_LITERAL, 8
    tiraAssignId rowBytesIdx, TIRA_ARG_SYMBOL, widthIdx
    tiraAssignId rowPayloadBytesIdx, TIRA_ARG_SYMBOL, widthIdx
  END IF

  payloadBytesIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, payloadBytesIdx, TIRA_ARG_SYMBOL, rowPayloadBytesIdx, TIRA_ARG_SYMBOL, heightIdx

  requiredEndIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, argPtrIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, payloadBytesIdx

  doneLblIdx = tiraLabelCreateNewId&("GET_DONE")

  ' Reject the complete operation before writing if the array is too small
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, argEndIdx, doneLblIdx

  ' QB graphics arrays begin with two unsigned 16-bit dimensions
  tiraWriteMemId TIRA_ARG_SYMBOL, argPtrIdx, TIRA_ARG_SYMBOL, headerWidthIdx, TIRA_ARG_LITERAL, 2

  heightPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, heightPtrIdx, TIRA_ARG_SYMBOL, argPtrIdx, TIRA_ARG_LITERAL, 2
  tiraWriteMemId TIRA_ARG_SYMBOL, heightPtrIdx, TIRA_ARG_SYMBOL, heightIdx, TIRA_ARG_LITERAL, 2

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, argPtrIdx, TIRA_ARG_LITERAL, 4

  IF captureBits = 4 THEN
    ' Clear the planar payload so unused trailing bits remain zero
    tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, payloadBytesIdx
  END IF

  ' Fetch Framebuffer Base from user working buffer using the SOURCE page
  frameBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId frameBaseIdx, TIRA_ARG_SYMBOL, sourceFrameIdx

  iterYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iterYIdx, TIRA_ARG_LITERAL, 0

  loopYLblIdx = tiraLabelCreateNewId&("GET_LOOP_Y")
  tiraLabelId loopYLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, heightIdx, doneLblIdx

  rowOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rowOffsetIdx, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, rowPayloadBytesIdx

  rowStartPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, rowOffsetIdx

  IF captureBits = 4 THEN
    bitMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId bitMaskIdx, TIRA_ARG_LITERAL, 128

    byteIndexIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId byteIndexIdx, TIRA_ARG_LITERAL, 0
  END IF

  iterXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iterXIdx, TIRA_ARG_LITERAL, 0

  loopXLblIdx = tiraLabelCreateNewId&("GET_LOOP_X")
  tiraLabelId loopXLblIdx

  endXLblIdx = tiraLabelCreateNewId&("GET_END_X")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_SYMBOL, widthIdx, endXLblIdx

  absXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, argX1Idx, TIRA_ARG_SYMBOL, iterXIdx

  absYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, argY1Idx, TIRA_ARG_SYMBOL, iterYIdx

  ' Clip boundaries to prevent reading outside the physical window coordinates
  pixelIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId pixelIdx, TIRA_ARG_LITERAL, 0

  skipBoundsLblIdx = tiraLabelCreateNewId&("GET_SKIP_BND")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX1Idx, skipBoundsLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX2Idx, skipBoundsLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY1Idx, skipBoundsLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY2Idx, skipBoundsLblIdx

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipBoundsLblIdx
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipBoundsLblIdx

  ' Scan pixel byte from memory safely within visual area
  offsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, absXIdx

  pixelAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, pixelAddrIdx, TIRA_ARG_SYMBOL, frameBaseIdx, TIRA_ARG_SYMBOL, offsetIdx

  pixel8Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId pixel8Idx, TIRA_ARG_SYMBOL, pixelAddrIdx
  tiraAssignId pixelIdx, TIRA_ARG_SYMBOL, pixel8Idx

  tiraLabelId skipBoundsLblIdx

  IF captureBits = 4 THEN
    ' Plane zero carries color bit zero
    planeBitIdx = tiraDimVarId&("T", TYPE_LONG)
    planeAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    planeByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    planeOffsetIdx = tiraDimVarId&("T", TYPE_LONG)

    skipPlane1LblIdx = tiraLabelCreateNewId&("GET_SKIP_PLANE1")
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_LITERAL, 0, skipPlane1LblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId skipPlane1LblIdx

    ' Plane one carries color bit one
    skipPlane2LblIdx = tiraLabelCreateNewId&("GET_SKIP_PLANE2")
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 2
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_LITERAL, 0, skipPlane2LblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, rowBytesIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId skipPlane2LblIdx

    ' Plane two carries color bit two
    skipPlane3LblIdx = tiraLabelCreateNewId&("GET_SKIP_PLANE3")
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 4
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_LITERAL, 0, skipPlane3LblIdx

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, planeOffsetIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 2
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, planeOffsetIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId skipPlane3LblIdx

    ' Plane three carries color bit three
    skipPlane4LblIdx = tiraLabelCreateNewId&("GET_SKIP_PLANE4")
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 8
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeBitIdx, TIRA_ARG_LITERAL, 0, skipPlane4LblIdx

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, planeOffsetIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 3
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, planeOffsetIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId skipPlane4LblIdx

    ' Advance from the most significant bit toward the least significant bit
    bitAdvanceDoneLblIdx = tiraLabelCreateNewId&("GET_BIT_ADVANCE_DONE")
    tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_LITERAL, 0, bitAdvanceDoneLblIdx

    tiraAssignId bitMaskIdx, TIRA_ARG_LITERAL, 128
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, byteIndexIdx, TIRA_ARG_SYMBOL, byteIndexIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId bitAdvanceDoneLblIdx
  ELSE
    ' SCREEN 13 stores one palette index for every pixel
    writeAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, writeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, iterXIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, writeAddrIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 1
  END IF

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopXLblIdx

  tiraLabelId endXLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopYLblIdx

  tiraLabelId doneLblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeGfxGet

''''''''''''''''''''''''
SUB emitRuntimeGfxPut

  ' Reads color data from a memory array and draws the corresponding pixels as a rectangular image to the graphics screen

  DIM captureBits AS LONG
  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM arg3VarIdx AS LONG
  DIM arg4VarIdx AS LONG
  DIM arg5VarIdx AS LONG
  DIM argXIdx AS LONG
  DIM argYIdx AS LONG
  DIM ptrIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM donePut1LblIdx AS LONG
  DIM donePut2LblIdx AS LONG
  DIM checkPtrIdx AS LONG
  DIM storedWidthIdx AS LONG
  DIM storedHeightIdx AS LONG
  DIM widthIdx AS LONG
  DIM heightIdx AS LONG
  DIM rowBytesIdx AS LONG
  DIM rowPayloadBytesIdx AS LONG
  DIM pixelMaskIdx AS LONG
  DIM widthRemainderIdx AS LONG
  DIM payloadBytesIdx AS LONG
  DIM requiredEndIdx AS LONG
  DIM frameBaseIdx AS LONG
  DIM iterYIdx AS LONG
  DIM loopYLblIdx AS LONG
  DIM rowOffsetIdx AS LONG
  DIM rowStartPtrIdx AS LONG
  DIM bitMaskIdx AS LONG
  DIM byteIndexIdx AS LONG
  DIM iterXIdx AS LONG
  DIM loopXLblIdx AS LONG
  DIM endXLblIdx AS LONG
  DIM pixelIdx AS LONG
  DIM planeAddrIdx AS LONG
  DIM planeByteIdx AS LONG
  DIM planeTestIdx AS LONG
  DIM planeOffsetIdx AS LONG
  DIM skipPlane1LblIdx AS LONG
  DIM skipPlane2LblIdx AS LONG
  DIM skipPlane3LblIdx AS LONG
  DIM skipPlane4LblIdx AS LONG
  DIM readPtrIdx AS LONG
  DIM pixel8Idx AS LONG
  DIM absXIdx AS LONG
  DIM absYIdx AS LONG
  DIM skipDrawLblIdx AS LONG
  DIM offsetIdx AS LONG
  DIM frameTargetIdx AS LONG
  DIM modePsetLblIdx AS LONG
  DIM modeAndLblIdx AS LONG
  DIM modeOrLblIdx AS LONG
  DIM modePresetLblIdx AS LONG
  DIM modeEndLblIdx AS LONG
  DIM bgPixel8Idx AS LONG
  DIM bgPixelIdx AS LONG
  DIM bitAdvanceDoneLblIdx AS LONG

  captureBits = 8

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      captureBits = 4

  END SELECT ' compileScreenMode

  rtOffset(RT_PUT) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
  IF ff = 0 THEN EXIT SUB
  viewOffsetXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
  IF ff = 0 THEN EXIT SUB
  viewOffsetYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN EXIT SUB
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
  IF ff = 0 THEN EXIT SUB
  viewX1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
  IF ff = 0 THEN EXIT SUB
  viewX2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
  IF ff = 0 THEN EXIT SUB
  viewY1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
  IF ff = 0 THEN EXIT SUB
  viewY2Idx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId arg2VarIdx, 2

  arg3VarIdx = tiraDimVarId&("ARG3", TYPE_INTEGER64)
  tiraAbiReadArgId arg3VarIdx, 3

  arg4VarIdx = tiraDimVarId&("ARG4", TYPE_INTEGER64)
  tiraAbiReadArgId arg4VarIdx, 4

  arg5VarIdx = tiraDimVarId&("ARG5", TYPE_LONG)
  tiraAbiReadArgId arg5VarIdx, 5

  argXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId argXIdx, TIRA_ARG_SYMBOL, arg1VarIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, viewOffsetXIdx

  argYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId argYIdx, TIRA_ARG_SYMBOL, arg2VarIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, viewOffsetYIdx

  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId ptrIdx, TIRA_ARG_SYMBOL, arg3VarIdx

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId endPtrIdx, TIRA_ARG_SYMBOL, arg4VarIdx

  donePut1LblIdx = tiraLabelCreateNewId&("PUT_DONE1")
  donePut2LblIdx = tiraLabelCreateNewId&("PUT_DONE2")

  ' Check if the complete four-byte QB graphics header is available
  checkPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, checkPtrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, checkPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, donePut1LblIdx

  storedWidthIdx = tiraDimVarId&("T", TYPE_UINTEGER)
  tiraReadMemId storedWidthIdx, TIRA_ARG_SYMBOL, ptrIdx

  storedHeightIdx = tiraDimVarId&("T", TYPE_UINTEGER)
  tiraReadMemOffsetId storedHeightIdx, TIRA_ARG_SYMBOL, ptrIdx, 2

  widthIdx = tiraDimVarId&("T", TYPE_LONG)
  heightIdx = tiraDimVarId&("T", TYPE_LONG)
  rowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
  rowPayloadBytesIdx = tiraDimVarId&("T", TYPE_LONG)
  pixelMaskIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraAssignId heightIdx, TIRA_ARG_SYMBOL, storedHeightIdx

  IF captureBits = 4 THEN
    ' SCREEN 7, 8, 9 and 12 store the pixel width directly
    tiraAssignId widthIdx, TIRA_ARG_SYMBOL, storedWidthIdx

    ' Each bitplane scanline is padded to a complete byte
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_LITERAL, 7
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 8

    ' Four consecutive bitplanes are stored for every scanline
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rowPayloadBytesIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 4

    tiraAssignId pixelMaskIdx, TIRA_ARG_LITERAL, 15
  ELSE
    ' SCREEN 13 stores the width in bits and requires a multiple of eight
    widthRemainderIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, widthRemainderIdx, TIRA_ARG_SYMBOL, storedWidthIdx, TIRA_ARG_LITERAL, 7
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, widthRemainderIdx, TIRA_ARG_LITERAL, 0, donePut1LblIdx

    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, widthIdx, TIRA_ARG_SYMBOL, storedWidthIdx, TIRA_ARG_LITERAL, 8
    tiraAssignId rowBytesIdx, TIRA_ARG_SYMBOL, widthIdx
    tiraAssignId rowPayloadBytesIdx, TIRA_ARG_SYMBOL, widthIdx
    tiraAssignId pixelMaskIdx, TIRA_ARG_LITERAL, 255
  END IF

  payloadBytesIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, payloadBytesIdx, TIRA_ARG_SYMBOL, rowPayloadBytesIdx, TIRA_ARG_SYMBOL, heightIdx

  requiredEndIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, payloadBytesIdx

  ' Reject the complete operation before reading if the array is too small
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, requiredEndIdx, TIRA_ARG_SYMBOL, endPtrIdx, donePut1LblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 4

  frameBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId frameBaseIdx, TIRA_ARG_SYMBOL, destFrameIdx

  iterYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iterYIdx, TIRA_ARG_LITERAL, 0

  ' Outer Loop Y
  loopYLblIdx = tiraLabelCreateNewId&("PUT_LOOP_Y")
  tiraLabelId loopYLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, heightIdx, donePut2LblIdx

  rowOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, rowOffsetIdx, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, rowPayloadBytesIdx

  rowStartPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, rowOffsetIdx

  IF captureBits = 4 THEN
    bitMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId bitMaskIdx, TIRA_ARG_LITERAL, 128

    byteIndexIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId byteIndexIdx, TIRA_ARG_LITERAL, 0
  END IF

  iterXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId iterXIdx, TIRA_ARG_LITERAL, 0

  ' Inner Loop X
  loopXLblIdx = tiraLabelCreateNewId&("PUT_LOOP_X")
  tiraLabelId loopXLblIdx

  endXLblIdx = tiraLabelCreateNewId&("PUT_END_X")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_SYMBOL, widthIdx, endXLblIdx

  pixelIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId pixelIdx, TIRA_ARG_LITERAL, 0

  IF captureBits = 4 THEN
    planeAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    planeByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
    planeTestIdx = tiraDimVarId&("T", TYPE_LONG)
    planeOffsetIdx = tiraDimVarId&("T", TYPE_LONG)

    ' Plane zero supplies color bit zero
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx

    skipPlane1LblIdx = tiraLabelCreateNewId&("PUT_SKIP_PLANE1")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_LITERAL, 0, skipPlane1LblIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 1
    tiraLabelId skipPlane1LblIdx

    ' Plane one supplies color bit one
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, rowBytesIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx

    skipPlane2LblIdx = tiraLabelCreateNewId&("PUT_SKIP_PLANE2")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_LITERAL, 0, skipPlane2LblIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 2
    tiraLabelId skipPlane2LblIdx

    ' Plane two supplies color bit two
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, planeOffsetIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 2
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, planeOffsetIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx

    skipPlane3LblIdx = tiraLabelCreateNewId&("PUT_SKIP_PLANE3")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_LITERAL, 0, skipPlane3LblIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 4
    tiraLabelId skipPlane3LblIdx

    ' Plane three supplies color bit three
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, planeOffsetIdx, TIRA_ARG_SYMBOL, rowBytesIdx, TIRA_ARG_LITERAL, 3
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, planeOffsetIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, planeAddrIdx, TIRA_ARG_SYMBOL, byteIndexIdx
    tiraReadMemId planeByteIdx, TIRA_ARG_SYMBOL, planeAddrIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_SYMBOL, planeByteIdx, TIRA_ARG_SYMBOL, bitMaskIdx

    skipPlane4LblIdx = tiraLabelCreateNewId&("PUT_SKIP_PLANE4")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, planeTestIdx, TIRA_ARG_LITERAL, 0, skipPlane4LblIdx
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 8
    tiraLabelId skipPlane4LblIdx
  ELSE
    ' SCREEN 13 stores one palette index for every pixel
    readPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, readPtrIdx, TIRA_ARG_SYMBOL, rowStartPtrIdx, TIRA_ARG_SYMBOL, iterXIdx

    pixel8Idx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId pixel8Idx, TIRA_ARG_SYMBOL, readPtrIdx
    tiraAssignId pixelIdx, TIRA_ARG_SYMBOL, pixel8Idx
  END IF

  absXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, iterXIdx

  absYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, iterYIdx

  skipDrawLblIdx = tiraLabelCreateNewId&("PUT_SKIP_DRW")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX1Idx, skipDrawLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX2Idx, skipDrawLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY1Idx, skipDrawLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY2Idx, skipDrawLblIdx

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipDrawLblIdx
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipDrawLblIdx

  offsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, offsetIdx, TIRA_ARG_SYMBOL, absXIdx

  frameTargetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, frameTargetIdx, TIRA_ARG_SYMBOL, frameBaseIdx, TIRA_ARG_SYMBOL, offsetIdx

  ' Put Mode Support (0=PSET, 1=XOR, 2=AND, 3=OR, 4=PRESET)
  modePsetLblIdx = tiraLabelCreateNewId&("PUT_MODE_PSET")
  modeAndLblIdx = tiraLabelCreateNewId&("PUT_MODE_AND")
  modeOrLblIdx = tiraLabelCreateNewId&("PUT_MODE_OR")
  modePresetLblIdx = tiraLabelCreateNewId&("PUT_MODE_PRESET")
  modeEndLblIdx = tiraLabelCreateNewId&("PUT_MODE_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg5VarIdx, TIRA_ARG_LITERAL, 0, modePsetLblIdx

  bgPixel8Idx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId bgPixel8Idx, TIRA_ARG_SYMBOL, frameTargetIdx

  bgPixelIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId bgPixelIdx, TIRA_ARG_SYMBOL, bgPixel8Idx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg5VarIdx, TIRA_ARG_LITERAL, 2, modeAndLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg5VarIdx, TIRA_ARG_LITERAL, 3, modeOrLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg5VarIdx, TIRA_ARG_LITERAL, 4, modePresetLblIdx

  ' Default to XOR if 1 or an unrecognized mode reaches the runtime
  tiraOpId3 TC_XOR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, bgPixelIdx
  tiraJmpId modeEndLblIdx

  tiraLabelId modeAndLblIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, bgPixelIdx
  tiraJmpId modeEndLblIdx

  tiraLabelId modeOrLblIdx
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, bgPixelIdx
  tiraJmpId modeEndLblIdx

  tiraLabelId modePresetLblIdx
  tiraOpId2 TC_NOT, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx
  tiraJmpId modeEndLblIdx

  tiraLabelId modePsetLblIdx
  tiraLabelId modeEndLblIdx

  ' Keep every result inside the active palette-index range
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_SYMBOL, pixelMaskIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, frameTargetIdx, TIRA_ARG_SYMBOL, pixelIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipDrawLblIdx

  IF captureBits = 4 THEN
    ' Advance through each packed byte from its most significant bit
    bitAdvanceDoneLblIdx = tiraLabelCreateNewId&("PUT_BIT_ADVANCE_DONE")
    tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, bitMaskIdx, TIRA_ARG_LITERAL, 0, bitAdvanceDoneLblIdx

    tiraAssignId bitMaskIdx, TIRA_ARG_LITERAL, 128
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, byteIndexIdx, TIRA_ARG_SYMBOL, byteIndexIdx, TIRA_ARG_LITERAL, 1

    tiraLabelId bitAdvanceDoneLblIdx
  END IF

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_SYMBOL, iterXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopXLblIdx

  tiraLabelId endXLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_SYMBOL, iterYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopYLblIdx

  tiraLabelId donePut1LblIdx
  tiraLabelId donePut2LblIdx

  ' Numeric QBasic SCREEN modes require immediate PUT presentation
  ' Automatic presentation is scheduled independently so consecutive PUT operations can be combined
  tiraTriggerAutoDisplayId

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeGfxPut

''''''''''''''''''''''''
SUB emitRuntimePaint

  ' Floods an enclosed area of the graphics screen with a solid color or pattern until it hits a specified border boundary

  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM destFbIdx AS LONG
  DIM argXIdx AS LONG
  DIM argYIdx AS LONG
  DIM argFillVarIdx AS LONG
  DIM argIsStrIdx AS LONG
  DIM argBorderIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM skipInitCheckIdx AS LONG
  DIM fillMaskIdx AS LONG
  DIM offsetStartIdx AS LONG
  DIM fPtrIdx AS LONG
  DIM fByteIdx AS LONG
  DIM memBlockIdx AS LONG
  DIM visitedBaseIdx AS LONG
  DIM queueBaseIdx AS LONG
  DIM fbSizeIdx AS LONG
  DIM qHeadIdx AS LONG
  DIM qTailIdx AS LONG
  DIM pushXIdx AS LONG
  DIM pushYIdx AS LONG
  DIM qOffsetIdx AS LONG
  DIM qPtrIdx AS LONG
  DIM popXIdx AS LONG
  DIM popYIdx AS LONG
  DIM curXIdx AS LONG
  DIM curYIdx AS LONG
  DIM checkXIdx AS LONG
  DIM checkYIdx AS LONG
  DIM isValidIdx AS LONG
  DIM vOffsetIdx AS LONG
  DIM vPtrIdx AS LONG
  DIM vByteIdx AS LONG
  DIM cByteIdx AS LONG
  DIM cPtrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM lblMoveLeftIdx AS LONG
  DIM lblMoveLeftEndIdx AS LONG
  DIM spanAboveIdx AS LONG
  DIM spanBelowIdx AS LONG
  DIM lblScanIdx AS LONG
  DIM lblScanEndIdx AS LONG
  DIM lblSolidIdx AS LONG
  DIM lblApplyIdx AS LONG
  DIM drawColorIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM patIdx AS LONG
  DIM charPtrIdx AS LONG
  DIM charByteIdx AS LONG
  DIM lblAboveSkipIdx AS LONG
  DIM lblAboveDoneIdx AS LONG
  DIM lblBelowSkipIdx AS LONG
  DIM lblBelowDoneIdx AS LONG

  rtOffset(RT_PAINT) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
  IF ff = 0 THEN EXIT SUB
  viewOffsetXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
  IF ff = 0 THEN EXIT SUB
  viewOffsetYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
  IF ff = 0 THEN EXIT SUB
  viewX1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
  IF ff = 0 THEN EXIT SUB
  viewX2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
  IF ff = 0 THEN EXIT SUB
  viewY1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
  IF ff = 0 THEN EXIT SUB
  viewY2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN EXIT SUB
  destFbIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  argXIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId argXIdx, 1
  argYIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId argYIdx, 2
  argFillVarIdx = tiraDimVarId&("ARG3", TYPE_INTEGER64)
  tiraAbiReadArgId argFillVarIdx, 3
  argIsStrIdx = tiraDimVarId&("ARG4", TYPE_LONG)
  tiraAbiReadArgId argIsStrIdx, 4
  argBorderIdx = tiraDimVarId&("ARG5", TYPE_LONG)
  tiraAbiReadArgId argBorderIdx, 5

  doneLblIdx = tiraLabelCreateNewId&("PAINT_END")

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, viewOffsetXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, viewOffsetYIdx

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, argBorderIdx, TIRA_ARG_SYMBOL, argBorderIdx, TIRA_ARG_LITERAL, 255

  ' Verify starting bounds are safely within drawing view
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, viewX1Idx, doneLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, argXIdx, TIRA_ARG_SYMBOL, viewX2Idx, doneLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, viewY1Idx, doneLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_SYMBOL, viewY2Idx, doneLblIdx

  ' Prevent infinite loops for identically matched solid color fills
  skipInitCheckIdx = tiraLabelCreateNewId&("PAINT_SKIP_INIT")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argIsStrIdx, TIRA_ARG_LITERAL, 1, skipInitCheckIdx

  fillMaskIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, fillMaskIdx, TIRA_ARG_SYMBOL, argFillVarIdx, TIRA_ARG_LITERAL, 255

  offsetStartIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetStartIdx, TIRA_ARG_SYMBOL, argYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetStartIdx, TIRA_ARG_SYMBOL, offsetStartIdx, TIRA_ARG_SYMBOL, argXIdx

  fPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, fPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, offsetStartIdx

  fByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId fByteIdx, TIRA_ARG_SYMBOL, fPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, fByteIdx, TIRA_ARG_SYMBOL, fillMaskIdx, doneLblIdx

  tiraLabelId skipInitCheckIdx

  ' Allocate memory for the recursive stack mapping securely on the temporary heap
  memBlockIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1500000)
  visitedBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId visitedBaseIdx, TIRA_ARG_SYMBOL, memBlockIdx
  queueBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, queueBaseIdx, TIRA_ARG_SYMBOL, memBlockIdx, TIRA_ARG_LITERAL, 1200000

  ' Clear visited array to prepare for clean memory tracking
  fbSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, TIRA_ARG_LITERAL, gfxConfig.SizeY
  tiraMemSetId TIRA_ARG_SYMBOL, visitedBaseIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, fbSizeIdx

  qHeadIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId qHeadIdx, TIRA_ARG_LITERAL, 0
  qTailIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId qTailIdx, TIRA_ARG_LITERAL, 0

  pushXIdx = tiraDimVarId&("T", TYPE_LONG)
  pushYIdx = tiraDimVarId&("T", TYPE_LONG)
  qOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  qPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraAssignId pushXIdx, TIRA_ARG_SYMBOL, argXIdx
  tiraAssignId pushYIdx, TIRA_ARG_SYMBOL, argYIdx

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, qOffsetIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, queueBaseIdx, TIRA_ARG_SYMBOL, qOffsetIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, pushXIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, qPtrIdx, 4, TIRA_ARG_SYMBOL, pushYIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 1

  popXIdx = tiraDimVarId&("T", TYPE_LONG)
  popYIdx = tiraDimVarId&("T", TYPE_LONG)
  curXIdx = tiraDimVarId&("T", TYPE_LONG)
  curYIdx = tiraDimVarId&("T", TYPE_LONG)

  checkXIdx = tiraDimVarId&("T", TYPE_LONG)
  checkYIdx = tiraDimVarId&("T", TYPE_LONG)
  isValidIdx = tiraDimVarId&("T", TYPE_LONG)
  vOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  vPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  vByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  cByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  cPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  loopTopIdx = tiraLabelCreateNewId&("PAINT_LOOP")
  tiraLabelId loopTopIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_SYMBOL, qTailIdx, doneLblIdx

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, qOffsetIdx, TIRA_ARG_SYMBOL, qTailIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, queueBaseIdx, TIRA_ARG_SYMBOL, qOffsetIdx
  tiraReadMemId popXIdx, TIRA_ARG_SYMBOL, qPtrIdx
  tiraReadMemOffsetId popYIdx, TIRA_ARG_SYMBOL, qPtrIdx, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qTailIdx, TIRA_ARG_SYMBOL, qTailIdx, TIRA_ARG_LITERAL, 1

  tiraAssignId curXIdx, TIRA_ARG_SYMBOL, popXIdx
  tiraAssignId curYIdx, TIRA_ARG_SYMBOL, popYIdx

  lblMoveLeftIdx = tiraLabelCreateNewId&("PAINT_LEFT")
  lblMoveLeftEndIdx = tiraLabelCreateNewId&("PAINT_LEFT_END")
  tiraLabelId lblMoveLeftIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId checkXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId checkYIdx, TIRA_ARG_SYMBOL, curYIdx

  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 0
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX1Idx, lblMoveLeftEndIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX2Idx, lblMoveLeftEndIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY1Idx, lblMoveLeftEndIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY2Idx, lblMoveLeftEndIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vPtrIdx, TIRA_ARG_SYMBOL, visitedBaseIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId vByteIdx, TIRA_ARG_SYMBOL, vPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, vByteIdx, TIRA_ARG_LITERAL, 0, lblMoveLeftEndIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, cPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId cByteIdx, TIRA_ARG_SYMBOL, cPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, cByteIdx, TIRA_ARG_SYMBOL, argBorderIdx, lblMoveLeftEndIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblMoveLeftIdx
  tiraLabelId lblMoveLeftEndIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_LITERAL, 1

  spanAboveIdx = tiraDimVarId&("T", TYPE_LONG)
  spanBelowIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId spanAboveIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId spanBelowIdx, TIRA_ARG_LITERAL, 0

  lblScanIdx = tiraLabelCreateNewId&("PAINT_SCAN")
  lblScanEndIdx = tiraLabelCreateNewId&("PAINT_SCAN_END")
  tiraLabelId lblScanIdx
  tiraAssignId checkXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId checkYIdx, TIRA_ARG_SYMBOL, curYIdx

  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 0
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX1Idx, lblScanEndIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX2Idx, lblScanEndIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY1Idx, lblScanEndIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY2Idx, lblScanEndIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vPtrIdx, TIRA_ARG_SYMBOL, visitedBaseIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId vByteIdx, TIRA_ARG_SYMBOL, vPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, vByteIdx, TIRA_ARG_LITERAL, 0, lblScanEndIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, cPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId cByteIdx, TIRA_ARG_SYMBOL, cPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, cByteIdx, TIRA_ARG_SYMBOL, argBorderIdx, lblScanEndIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 1

  tiraWriteMemId TIRA_ARG_SYMBOL, vPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 1

  lblSolidIdx = tiraLabelCreateNewId&("PAINT_SOLID")
  lblApplyIdx = tiraLabelCreateNewId&("PAINT_APPLY")
  drawColorIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, argIsStrIdx, TIRA_ARG_LITERAL, 0, lblSolidIdx

  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFillVarIdx)
  strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFillVarIdx)
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblSolidIdx

  ' SCREEN 13 natively treats tiling string bytes as entire scanline color fills
  patIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, patIdx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, strLenIdx

  charPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charPtrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, patIdx

  charByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId charByteIdx, TIRA_ARG_SYMBOL, charPtrIdx
  tiraAssignId drawColorIdx, TIRA_ARG_SYMBOL, charByteIdx

  tiraJmpId lblApplyIdx

  tiraLabelId lblSolidIdx
  tiraAssignId drawColorIdx, TIRA_ARG_SYMBOL, fillMaskIdx

  tiraLabelId lblApplyIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, cPtrIdx, TIRA_ARG_SYMBOL, drawColorIdx, TIRA_ARG_LITERAL, 1

  lblAboveSkipIdx = tiraLabelCreateNewId&("PAINT_ABOVE_SKIP")
  lblAboveDoneIdx = tiraLabelCreateNewId&("PAINT_ABOVE_DONE")
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId checkXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 0
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX1Idx, lblAboveSkipIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX2Idx, lblAboveSkipIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY1Idx, lblAboveSkipIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY2Idx, lblAboveSkipIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vPtrIdx, TIRA_ARG_SYMBOL, visitedBaseIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId vByteIdx, TIRA_ARG_SYMBOL, vPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, vByteIdx, TIRA_ARG_LITERAL, 0, lblAboveSkipIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, cPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId cByteIdx, TIRA_ARG_SYMBOL, cPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, cByteIdx, TIRA_ARG_SYMBOL, argBorderIdx, lblAboveSkipIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, spanAboveIdx, TIRA_ARG_LITERAL, 0, lblAboveDoneIdx
  tiraAssignId pushXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId pushYIdx, TIRA_ARG_SYMBOL, checkYIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, qOffsetIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, queueBaseIdx, TIRA_ARG_SYMBOL, qOffsetIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, pushXIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, qPtrIdx, 4, TIRA_ARG_SYMBOL, pushYIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId spanAboveIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblAboveDoneIdx

  tiraLabelId lblAboveSkipIdx
  tiraAssignId spanAboveIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId lblAboveDoneIdx

  lblBelowSkipIdx = tiraLabelCreateNewId&("PAINT_BELOW_SKIP")
  lblBelowDoneIdx = tiraLabelCreateNewId&("PAINT_BELOW_DONE")
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId checkXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 0
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX1Idx, lblBelowSkipIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkXIdx, TIRA_ARG_SYMBOL, viewX2Idx, lblBelowSkipIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY1Idx, lblBelowSkipIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_SYMBOL, viewY2Idx, lblBelowSkipIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, vOffsetIdx, TIRA_ARG_SYMBOL, checkXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vPtrIdx, TIRA_ARG_SYMBOL, visitedBaseIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId vByteIdx, TIRA_ARG_SYMBOL, vPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, vByteIdx, TIRA_ARG_LITERAL, 0, lblBelowSkipIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, cPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, vOffsetIdx
  tiraReadMemId cByteIdx, TIRA_ARG_SYMBOL, cPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, cByteIdx, TIRA_ARG_SYMBOL, argBorderIdx, lblBelowSkipIdx
  tiraAssignId isValidIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, spanBelowIdx, TIRA_ARG_LITERAL, 0, lblBelowDoneIdx
  tiraAssignId pushXIdx, TIRA_ARG_SYMBOL, curXIdx
  tiraAssignId pushYIdx, TIRA_ARG_SYMBOL, checkYIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, qOffsetIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, queueBaseIdx, TIRA_ARG_SYMBOL, qOffsetIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, qPtrIdx, TIRA_ARG_SYMBOL, pushXIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, qPtrIdx, 4, TIRA_ARG_SYMBOL, pushYIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_SYMBOL, qHeadIdx, TIRA_ARG_LITERAL, 1
  tiraAssignId spanBelowIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblBelowDoneIdx

  tiraLabelId lblBelowSkipIdx
  tiraAssignId spanBelowIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId lblBelowDoneIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_SYMBOL, curXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblScanIdx
  tiraLabelId lblScanEndIdx

  tiraJmpId loopTopIdx

  tiraLabelId doneLblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePaint

''''''''''''''''''''''''
SUB emitRuntimePlotPixel

  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM plotOffsetIdx AS LONG
  DIM plotFbBaseIdx AS LONG
  DIM destFbIdx AS LONG
  DIM plotTargetIdx AS LONG
  DIM displayPendingIdx AS LONG
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM arg3VarIdx AS LONG
  DIM endLblIdx AS LONG
  DIM absXIdx AS LONG
  DIM absYIdx AS LONG

  '''' RT_PLOT_PIXEL
  rtOffset(RT_PLOT_PIXEL) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
  IF ff = 0 THEN EXIT SUB
  viewOffsetXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
  IF ff = 0 THEN EXIT SUB
  viewOffsetYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
  IF ff = 0 THEN EXIT SUB
  viewX1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
  IF ff = 0 THEN EXIT SUB
  viewX2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
  IF ff = 0 THEN EXIT SUB
  viewY1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
  IF ff = 0 THEN EXIT SUB
  viewY2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_IDX_PLOT_OFFSET")
  IF ff = 0 THEN EXIT SUB
  plotOffsetIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_PLOT_FBBASE")
  IF ff = 0 THEN EXIT SUB
  plotFbBaseIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN EXIT SUB
  destFbIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_PLOT_TARGET")
  IF ff = 0 THEN EXIT SUB
  plotTargetIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
  IF ff = 0 THEN EXIT SUB
  displayPendingIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1VarIdx, 1
  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId arg2VarIdx, 2
  arg3VarIdx = tiraDimVarId&("ARG3", TYPE_LONG)
  tiraAbiReadArgId arg3VarIdx, 3

  endLblIdx = tiraLabelCreateNewId&("PLOT_END")

  ' Shift target coordinates into absolute mapped variables utilizing global offsets
  absXIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_SYMBOL, viewOffsetXIdx
  absYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, arg2VarIdx, TIRA_ARG_SYMBOL, viewOffsetYIdx

  ' Execute strict bounds testing securely trapping plotting within graphical VIEW logic
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX1Idx, endLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_SYMBOL, viewX2Idx, endLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY1Idx, endLblIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_SYMBOL, viewY2Idx, endLblIdx

  ' Unsigned JAE hardware test to physically prevent screen buffer overrun exceptions
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absXIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, endLblIdx
  tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY, endLblIdx

  ' Calculate offset targeting the working screen buffer
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, plotOffsetIdx, TIRA_ARG_SYMBOL, absYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, plotOffsetIdx, TIRA_ARG_SYMBOL, plotOffsetIdx, TIRA_ARG_SYMBOL, absXIdx

  ' Fetch framebuffer base pointer dynamically through the targeted active destination memory
  tiraAssignId plotFbBaseIdx, TIRA_ARG_SYMBOL, destFbIdx

  ' Target address
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, plotTargetIdx, TIRA_ARG_SYMBOL, plotFbBaseIdx, TIRA_ARG_SYMBOL, plotOffsetIdx

  ' Write byte to framebuffer
  tiraWriteMemId TIRA_ARG_SYMBOL, plotTargetIdx, TIRA_ARG_SYMBOL, arg3VarIdx, TIRA_ARG_LITERAL, 1

  tiraAssignId displayPendingIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId endLblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePlotPixel

