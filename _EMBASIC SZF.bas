''''''''''''''''''''''''
SUB emitRuntimePrintFloat

  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM fmtPtrIdx AS LONG
  DIM sprintfIdx AS LONG
  DIM strLenIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_FLOAT) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_DOUBLE)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  ' Allocate 64 bytes on the temporary heap for the sprintf buffer natively
  basePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2
  tiraAssignId basePtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 64
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, basePtrIdx

  ' Read the pointer to the format string payload passed as arg 2
  fmtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId fmtPtrIdx, TIRA_ARG_SYMBOL, arg2VarIdx

  ' Call sprintf natively using TIRA. The backend will perfectly mirror the
  ' float variable into both XMM2 and R8 to satisfy the Windows Varargs ABI.
  ff = resolveSymbol("IAT_SPRINTF")
  sprintfIdx = returnedData2
  tiraCallId3 sprintfIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, fmtPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  ' Capture the return length from sprintf
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId strLenIdx

  IF cm.HasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary variable
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the float string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics output via GfxAppend
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintFloat

''''''''''''''''''''''''
SUB emitRuntimePrintInt

  DIM arg1VarIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM ptrIdx AS LONG
  DIM valVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipNegLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM skipDigitNegLblIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipSpaceLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM strLenIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_INT) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  ' Use !G_MEM_PTR_TEMP_HEAP as the high-end of our temporary string scratchpad.
  ' We do not permanently allocate it because the string is consumed instantly.
  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2
  tiraAssignId ptrIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  valVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId valVarIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipNegLblIdx = tiraLabelCreateNewId&("PI_SKIP_NEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, skipNegLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipNegLblIdx

  ' Add the trailing space required by QB64 PRINT formatting FIRST (since we build backwards)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1

  loopTopIdx = tiraLabelCreateNewId&("PI_LOOP")
  tiraLabelId loopTopIdx

  ' digit = val MOD 10
  digitIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  skipDigitNegLblIdx = tiraLabelCreateNewId&("PI_SKIP_DNEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 0, skipDigitNegLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, digitIdx
  tiraLabelId skipDigitNegLblIdx

  ' char = digit + 48
  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48

  ' ptr = ptr - 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1

  ' Write byte to temporary string buffer
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' val = val / 10
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  ' Continue loop if val != 0
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  ' Add leading sign OR space for positive numbers required by QB64 PRINT formatting
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  skipSpaceLblIdx = tiraLabelCreateNewId&("PI_SKIP_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 45, TIRA_ARG_LITERAL, 1 ' 45 is '-'
  jmpDoneLblIdx = tiraLabelCreateNewId&("PI_DONE")
  tiraJmpId jmpDoneLblIdx
  tiraLabelId skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1 ' 32 is Space
  tiraLabelId jmpDoneLblIdx

  ' Calculate strLen = !G_MEM_PTR_TEMP_HEAP - ptr
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, ptrIdx

  IF cm.HasGraphics = 0 THEN
    ' Console output via WriteFile
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary variable
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the integer string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics output via GfxAppend
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintInt

''''''''''''''''''''''''
SUB emitRuntimePrintStr

  DIM arg1VarIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_STR) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  IF cm.HasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary varia5ble
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Read the memory address and length of the string data from the descriptor
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics mode

    ' Read the memory address and length of the string data from the descriptor
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

    ' Call RT_GFX_APPEND, pass data pointer and length
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintStr

''''''''''''''''''''''''
SUB emitRuntimeStrAssign

  '''' String Assignment Runtime Helper
  ' Inputs: Arg1 = LHS Descriptor Ptr, Arg2 = RHS Descriptor Ptr
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM fastRetLblIdx AS LONG
  DIM epilogueLblIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM rhsDataIdx AS LONG
  DIM lhsFlagsIdx AS LONG
  DIM lhsDataIdx AS LONG
  DIM lhsLenIdx AS LONG
  DIM nonEmptyLblIdx AS LONG
  DIM skipEmptyFreeLblIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM allocateLblIdx AS LONG
  DIM reuseCopyManyLblIdx AS LONG
  DIM reuseCopyDoneLblIdx AS LONG
  DIM reuseByteIdx AS LONG
  DIM reuseNullPtrIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM newPtrIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM oomDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG
  DIM allocCopyManyLblIdx AS LONG
  DIM allocCopyDoneLblIdx AS LONG
  DIM allocByteIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM skipOldFreeLblIdx AS LONG

  rtOffset(RT_STR_ASSIGN) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  fastRetLblIdx = tiraLabelCreateNewId&("STR_FASTRET")
  epilogueLblIdx = tiraLabelCreateNewId&("STR_EPI")

  ' Check if LHS == RHS (e.g. A$ = A$) to prevent freeing the data we are trying to copy
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_SYMBOL, arg2VarIdx, fastRetLblIdx

  ' Get RHS length and data pointer
  rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg2VarIdx)
  rhsDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg2VarIdx)

  ' Check if LHS needs freeing (Flags == 1)
  lhsFlagsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId lhsFlagsIdx, TIRA_ARG_SYMBOL, arg1VarIdx, 16

  ' Check if LHS Data Pointer is null
  lhsDataIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId lhsDataIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  lhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

  nonEmptyLblIdx = tiraLabelCreateNewId&("STR_NONEMPTY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 0, nonEmptyLblIdx

  ' If length is 0, zero LHS Descriptor and exit early
  skipEmptyFreeLblIdx = tiraLabelCreateNewId&("STR_EMPTY_SKIPFREE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, lhsFlagsIdx, TIRA_ARG_LITERAL, 1, skipEmptyFreeLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_LITERAL, 0, skipEmptyFreeLblIdx

  ' Call HeapFree(hHeap, 0, dataPtr)
  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  processHeapIdx = returnedData2

  ff = resolveSymbol("IAT_HEAPFREE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  heapFreeIdx = returnedData2

  tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, lhsDataIdx

  tiraLabelId skipEmptyFreeLblIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraJmpId epilogueLblIdx

  tiraLabelId nonEmptyLblIdx

  ' Reuse an owned LHS allocation whenever its current size is large enough
  allocateLblIdx = tiraLabelCreateNewId&("STR_ALLOCATE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, lhsFlagsIdx, TIRA_ARG_LITERAL, 1, allocateLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_LITERAL, 0, allocateLblIdx
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, allocateLblIdx

  reuseCopyManyLblIdx = tiraLabelCreateNewId&("STR_REUSE_COPY_MANY")
  reuseCopyDoneLblIdx = tiraLabelCreateNewId&("STR_REUSE_COPY_DONE")

  ' Copy Data
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 1, reuseCopyManyLblIdx

  reuseByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId reuseByteIdx, TIRA_ARG_SYMBOL, rhsDataIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, reuseByteIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId reuseCopyDoneLblIdx

  tiraLabelId reuseCopyManyLblIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, rhsDataIdx, TIRA_ARG_SYMBOL, rhsLenIdx

  tiraLabelId reuseCopyDoneLblIdx

  ' Write null terminator at the end of the newly copied string data
  reuseNullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, reuseNullPtrIdx, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, rhsLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, reuseNullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ' Update LHS Desc with the existing memory address
  tiraBuildStrDescId TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId epilogueLblIdx

  tiraLabelId allocateLblIdx

  ' Call HeapAlloc(hHeap, 0, length + 1)
  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  heapAllocIdx = returnedData2

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, allocSizeIdx

  newPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId newPtrIdx

  ' Ensure the new memory allocation is successful to prevent crashes
  skipOomLblIdx = tiraLabelCreateNewId&("STR_ALLOC_OOM_SKIP")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, newPtrIdx, TIRA_ARG_LITERAL, 0, skipOomLblIdx

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRspId

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  oomDescIdx = returnedData2
  strVarData$(oomDescIdx) = "OUT OF MEMORY"

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, oomDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT SUB
    END IF
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId skipOomLblIdx

  allocCopyManyLblIdx = tiraLabelCreateNewId&("STR_ALLOC_COPY_MANY")
  allocCopyDoneLblIdx = tiraLabelCreateNewId&("STR_ALLOC_COPY_DONE")

  ' Copy Data
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 1, allocCopyManyLblIdx

  allocByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId allocByteIdx, TIRA_ARG_SYMBOL, rhsDataIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, newPtrIdx, TIRA_ARG_SYMBOL, allocByteIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId allocCopyDoneLblIdx

  tiraLabelId allocCopyManyLblIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, newPtrIdx, TIRA_ARG_SYMBOL, rhsDataIdx, TIRA_ARG_SYMBOL, rhsLenIdx

  tiraLabelId allocCopyDoneLblIdx

  ' Write null terminator at the end of the newly copied string data
  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, newPtrIdx, TIRA_ARG_SYMBOL, rhsLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ' Release the old LHS allocation only after the RHS data has been copied safely
  skipOldFreeLblIdx = tiraLabelCreateNewId&("STR_OLD_SKIPFREE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, lhsFlagsIdx, TIRA_ARG_LITERAL, 1, skipOldFreeLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_LITERAL, 0, skipOldFreeLblIdx

  ' Call HeapFree(hHeap, 0, dataPtr)
  tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, lhsDataIdx

  tiraLabelId skipOldFreeLblIdx

  ' Update LHS Desc with the newly allocated memory address
  tiraBuildStrDescId TIRA_ARG_SYMBOL, arg1VarIdx, TIRA_ARG_SYMBOL, newPtrIdx, TIRA_ARG_SYMBOL, rhsLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId epilogueLblIdx
  tiraLabelId fastRetLblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeStrAssign

''''''''''''''''''''''''
SUB emitRuntimeStrCmp

  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM lhsDataIdx AS LONG
  DIM lhsLenIdx AS LONG
  DIM rhsDataIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM skipMinLblIdx AS LONG
  DIM idxVarIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM lhsCharAddrIdx AS LONG
  DIM lhsByteIdx AS LONG
  DIM rhsCharAddrIdx AS LONG
  DIM rhsByteIdx AS LONG
  DIM charLessLblIdx AS LONG
  DIM charGrtrLblIdx AS LONG
  DIM lenLessLblIdx AS LONG
  DIM lenGrtrLblIdx AS LONG
  DIM endLblIdx AS LONG

  rtOffset(RT_STR_CMP) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1
  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  ' Extract LHS Data and Length
  lhsDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
  lhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

  ' Extract RHS Data and Length
  rhsDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg2VarIdx)
  rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg2VarIdx)

  ' Find Min Length to ensure safe memory scanning
  minLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, lhsLenIdx

  skipMinLblIdx = tiraLabelCreateNewId&("STRCMP_MIN")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, skipMinLblIdx
  tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
  tiraLabelId skipMinLblIdx

  ' Setup Comparison Loop
  idxVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId idxVarIdx, TIRA_ARG_LITERAL, 0

  loopTopIdx = tiraLabelCreateNewId&("STRCMP_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("STRCMP_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_SYMBOL, minLenIdx, loopDoneIdx

  ' Read LHS Byte
  lhsCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, lhsCharAddrIdx, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, idxVarIdx
  lhsByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId lhsByteIdx, TIRA_ARG_SYMBOL, lhsCharAddrIdx

  ' Read RHS Byte
  rhsCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rhsCharAddrIdx, TIRA_ARG_SYMBOL, rhsDataIdx, TIRA_ARG_SYMBOL, idxVarIdx
  rhsByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId rhsByteIdx, TIRA_ARG_SYMBOL, rhsCharAddrIdx

  ' Compare Bytes
  charLessLblIdx = tiraLabelCreateNewId&("STRCMP_CLESS")
  charGrtrLblIdx = tiraLabelCreateNewId&("STRCMP_CGRTR")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, lhsByteIdx, TIRA_ARG_SYMBOL, rhsByteIdx, charLessLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, lhsByteIdx, TIRA_ARG_SYMBOL, rhsByteIdx, charGrtrLblIdx

  ' Bytes match, increment index and evaluate next character
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  ' If we reached here, the strings match flawlessly up to minLen. Compare overall lengths
  lenLessLblIdx = tiraLabelCreateNewId&("STRCMP_LLESS")
  lenGrtrLblIdx = tiraLabelCreateNewId&("STRCMP_LGRTR")
  endLblIdx = tiraLabelCreateNewId&("STRCMP_END")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, lenLessLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, lenGrtrLblIdx

  ' Lengths are equal. The string matches exactly.
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId endLblIdx

  ' LHS < RHS
  tiraLabelId lenLessLblIdx
  tiraLabelId charLessLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId endLblIdx

  ' LHS > RHS
  tiraLabelId lenGrtrLblIdx
  tiraLabelId charGrtrLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId endLblIdx

  ' Cleanly pass the evaluated return value back to the caller frame
  tiraAbiWriteRetId arg1VarIdx
  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeStrCmp

''''''''''''''''''''''''
SUB ensureFileStateSymbol

  ' Registers the per-file access mode and record length table

  DIM stateIdx AS LONG

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 1 THEN
    stateIdx = returnedData2
    symbols(stateIdx).DataType = TYPE_LONG
    symbols(stateIdx).IsArray = ARRAY_TYPE_NONE
    symbols(stateIdx).Size = FS_NUMBER_COUNT * FS_STATE_LONGS_PER_SLOT
    symbols(stateIdx).NumDimensions = 0
  END IF

END SUB ' ensureFileStateSymbol

''''''''''''''''''''''''
SUB ensureKeyEventSymbols

  ' Registers ON KEY handler addresses and event states

  DIM savedScopeID AS LONG
  DIM handlerIdx AS _UNSIGNED LONG
  DIM stateIdx AS _UNSIGNED LONG
  DIM runtimeIdx AS _UNSIGNED LONG

  savedScopeID = currentScopeID
  currentScopeID = 0

  ff = resolveSymbol("!G_INO_ARR_KEYHANDLER")
  IF ff = 1 THEN
    handlerIdx = returnedData2
    symbols(handlerIdx).DataType = TYPE_UBYTE
    symbols(handlerIdx).IsArray = ARRAY_TYPE_NONE
    symbols(handlerIdx).Size = KEY_EVENT_COUNT * KEY_EVENT_SLOT_BYTES
    symbols(handlerIdx).NumDimensions = 0
  END IF

  ff = resolveSymbol("!G_INO_ARR_KEYSTATE")
  IF ff = 1 THEN
    stateIdx = returnedData2
    symbols(stateIdx).DataType = TYPE_UBYTE
    symbols(stateIdx).IsArray = ARRAY_TYPE_NONE
    symbols(stateIdx).Size = KEY_EVENT_COUNT * KEY_EVENT_SLOT_BYTES
    symbols(stateIdx).NumDimensions = 0
  END IF

  ff = resolveSymbol("!G_INO_FLG_KEYACTIVE")
  ff = resolveSymbol("!G_INO_FLG_KEYANY")

  ff = resolveSymbol("RT_KEY_EVENT")
  IF ff = 1 THEN
    runtimeIdx = returnedData2
    symbols(runtimeIdx).ScopeID = 0
    symbols(runtimeIdx).IsLocal = LOCAL_GLOBAL
  END IF

  currentScopeID = savedScopeID

END SUB ' ensureKeyEventSymbols

''''''''''''''''''''''''
SUB ensureFileWriteBufferSymbols

  ' Registers the three global symbols for the buffered file-write system

  ff = resolveSymbol("!G_FLS_PTR_WRITE_BUFFER")
  ff = resolveSymbol("!G_FLS_PTR_WRITE_HANDLE")
  ff = resolveSymbol("!G_FLS_IDX_WRITE_COUNT")

END SUB ' ensureFileWriteBufferSymbols

''''''''''''''''''''''''
FUNCTION evalMathConst$ (rsExpr$)

  DIM workExpr$

  DIM exprSize AS LONG
  DIM tokenCount AS LONG
  DIM outputCount AS LONG
  DIM operatorCount AS LONG
  DIM valueCount AS LONG
  DIM expectOperand AS LONG
  DIM tokenIdx AS LONG
  DIM currentPrec AS LONG
  DIM currentRightAssoc AS LONG
  DIM shouldPop AS LONG
  DIM isOperator AS LONG
  DIM isPrefix AS LONG
  DIM isNumeric AS LONG
  DIM isIntegerResult AS LONG
  DIM startPos AS LONG
  DIM charCode AS LONG
  DIM nextCode AS LONG
  DIM hasDecimal AS LONG
  DIM hasExponent AS LONG
  DIM leftInt AS _INTEGER64
  DIM rightInt AS _INTEGER64
  DIM resultInt AS _INTEGER64
  DIM leftValue AS DOUBLE
  DIM rightValue AS DOUBLE
  DIM resultValue AS DOUBLE
  DIM opText$
  DIM currentText$
  DIM upperText$

  workExpr$ = LTRIM$(RTRIM$(rsExpr$))

  IF workExpr$ = "" THEN
    evalMathConst$ = ""
    EXIT FUNCTION
  END IF

  IF LEFT$(workExpr$, 1) = CHR$(34) THEN
    evalMathConst$ = workExpr$
    EXIT FUNCTION
  END IF

  exprSize = LEN(workExpr$)

  ' Plain decimal integers do not need token or operator storage
  startPos = 1
  charCode = ASC(workExpr$, 1)
  IF charCode = 43 OR charCode = 45 THEN startPos = 2

  IF exprSize >= startPos AND exprSize - startPos < 10 THEN
    isNumeric = 1
    FOR tokenIdx = startPos TO exprSize
      charCode = ASC(workExpr$, tokenIdx)
      IF charCode < 48 OR charCode > 57 THEN
        isNumeric = 0
        EXIT FOR
      END IF
    NEXT

    IF isNumeric = 1 THEN
      resultInt = VAL(workExpr$)
      evalMathConst$ = LTRIM$(RTRIM$(STR$(resultInt)))
      EXIT FUNCTION
    END IF
  END IF

  tokenCount = 0
  ix = 1

  DO WHILE ix <= exprSize
    charCode = ASC(workExpr$, ix)

    IF charCode = 32 OR charCode = 9 THEN
      ix = ix + 1
    ELSE
      IF tokenCount >= MAX_CONST_EVAL_TOKENS THEN
        throwCompilerError "CONSTANT EXPRESSION TOKEN LIMIT", ASIS, 0
        evalMathConst$ = workExpr$
        EXIT FUNCTION
      END IF

      isNumeric = 0
      IF charCode >= 48 AND charCode <= 57 THEN isNumeric = 1
      IF charCode = 46 AND ix < exprSize THEN
        nextCode = ASC(workExpr$, ix + 1)
        IF nextCode >= 48 AND nextCode <= 57 THEN isNumeric = 1
      END IF

      IF isNumeric = 1 THEN
        startPos = ix
        hasDecimal = 0
        hasExponent = 0

        DO WHILE ix <= exprSize
          charCode = ASC(workExpr$, ix)

          IF charCode >= 48 AND charCode <= 57 THEN
            ix = ix + 1
          ELSE
            IF charCode = 46 AND hasDecimal = 0 AND hasExponent = 0 THEN
              hasDecimal = 1
              ix = ix + 1
            ELSE
              IF (charCode = 69 OR charCode = 101) AND hasExponent = 0 THEN
                hasExponent = 1
                ix = ix + 1

                IF ix <= exprSize THEN
                  charCode = ASC(workExpr$, ix)
                  IF charCode = 43 OR charCode = 45 THEN ix = ix + 1
                END IF
              ELSE
                EXIT DO
              END IF
            END IF
          END IF
        LOOP

        IF ix <= exprSize THEN
          charCode = ASC(workExpr$, ix)
          IF charCode = 35 OR charCode = 33 OR charCode = 38 OR charCode = 37 THEN ix = ix + 1
        END IF

        constEvalWork(tokenCount).TokenText = MID$(workExpr$, startPos, ix - startPos)
        tokenCount = tokenCount + 1
      ELSE
        IF charCode = 38 AND ix < exprSize THEN
          nextCode = ASC(workExpr$, ix + 1)

          IF nextCode = 72 OR nextCode = 104 THEN
            startPos = ix
            ix = ix + 2

            DO WHILE ix <= exprSize
              charCode = ASC(workExpr$, ix)
              IF (charCode >= 48 AND charCode <= 57) OR (charCode >= 65 AND charCode <= 70) OR (charCode >= 97 AND charCode <= 102) THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP

            constEvalWork(tokenCount).TokenText = MID$(workExpr$, startPos, ix - startPos)
            tokenCount = tokenCount + 1
          ELSE
            constEvalWork(tokenCount).TokenText = "&"
            tokenCount = tokenCount + 1
            ix = ix + 1
          END IF
        ELSE
          IF (charCode >= 65 AND charCode <= 90) OR (charCode >= 97 AND charCode <= 122) THEN
            startPos = ix

            DO WHILE ix <= exprSize
              charCode = ASC(workExpr$, ix)
              IF (charCode >= 65 AND charCode <= 90) OR (charCode >= 97 AND charCode <= 122) OR (charCode >= 48 AND charCode <= 57) OR charCode = 95 THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP

            constEvalWork(tokenCount).TokenText = UCASE$(MID$(workExpr$, startPos, ix - startPos))
            tokenCount = tokenCount + 1
          ELSE
            currentText$ = CHR$(charCode)

            IF (charCode = 60 OR charCode = 62) AND ix < exprSize THEN
              nextCode = ASC(workExpr$, ix + 1)

              IF nextCode = 61 OR (charCode = 60 AND nextCode = 62) THEN
                currentText$ = currentText$ + CHR$(nextCode)
                ix = ix + 1
              END IF
            END IF

            constEvalWork(tokenCount).TokenText = currentText$
            tokenCount = tokenCount + 1
            ix = ix + 1
          END IF
        END IF
      END IF
    END IF
  LOOP

  outputCount = 0
  operatorCount = 0
  expectOperand = 1

  FOR tokenIdx = 0 TO tokenCount - 1
    currentText$ = constEvalWork(tokenIdx).TokenText
    upperText$ = UCASE$(currentText$)
    isNumeric = 0

    IF LEN(currentText$) > 0 THEN
      charCode = ASC(currentText$, 1)
      IF charCode >= 48 AND charCode <= 57 THEN isNumeric = 1
      IF charCode = 46 AND LEN(currentText$) > 1 THEN
        nextCode = ASC(currentText$, 2)
        IF nextCode >= 48 AND nextCode <= 57 THEN isNumeric = 1
      END IF
      IF LEFT$(upperText$, 2) = "&H" AND LEN(currentText$) > 2 THEN isNumeric = 1
    END IF

    IF isNumeric = 1 THEN
      IF expectOperand = 0 THEN
        throwCompilerError "MISSING OPERATOR IN CONSTANT EXPRESSION", ASIS, 0
        evalMathConst$ = workExpr$
        EXIT FUNCTION
      END IF

      constEvalWork(outputCount).OutputText = currentText$
      outputCount = outputCount + 1
      expectOperand = 0
    ELSE
      IF currentText$ = "(" THEN
        constEvalWork(operatorCount).OperatorText = currentText$
        constEvalWork(operatorCount).OperatorPrec = 0
        operatorCount = operatorCount + 1
        expectOperand = 1
      ELSE
        IF currentText$ = ")" THEN
          IF expectOperand = 1 THEN
            throwCompilerError "MISSING VALUE IN CONSTANT EXPRESSION", ASIS, 0
            evalMathConst$ = workExpr$
            EXIT FUNCTION
          END IF

          shouldPop = 0

          DO WHILE operatorCount > 0
            IF constEvalWork(operatorCount - 1).OperatorText = "(" THEN
              shouldPop = 1
              EXIT DO
            END IF

            constEvalWork(outputCount).OutputText = constEvalWork(operatorCount - 1).OperatorText
            outputCount = outputCount + 1
            operatorCount = operatorCount - 1
          LOOP

          IF shouldPop = 0 THEN
            ' Mismatched parenthesis safety fallback
            throwCompilerError "UNMATCHED PARENTHESIS IN CONSTANT", ASIS, 0
            evalMathConst$ = workExpr$
            EXIT FUNCTION
          END IF

          operatorCount = operatorCount - 1
          expectOperand = 0
        ELSE
          opText$ = upperText$
          currentPrec = 0
          currentRightAssoc = 0
          isOperator = 1
          isPrefix = 0

          IF expectOperand = 1 THEN
            ' Pass 1A: Unary minus
            IF opText$ = "-" THEN
              opText$ = "U-"
              currentPrec = 10
              currentRightAssoc = 1
              isPrefix = 1
            ELSE
              IF opText$ = "+" THEN
                opText$ = "U+"
                currentPrec = 10
                currentRightAssoc = 1
                isPrefix = 1
              ELSE
                ' Pass 1B: Unary NOT
                IF opText$ = "NOT" THEN
                  currentPrec = 4
                  currentRightAssoc = 1
                  isPrefix = 1
                ELSE
                  isOperator = 0
                END IF
              END IF
            END IF
          ELSE
            SELECT CASE opText$

              CASE "^"
                currentPrec = 11
                currentRightAssoc = 1

                ' Pass 2: Multiplication and Division
              CASE "*", "/"
                currentPrec = 9

              CASE "\"
                currentPrec = 8

              CASE "MOD"
                currentPrec = 7

                ' Pass 3: Addition and Subtraction
              CASE "+", "-"
                currentPrec = 6

              CASE "=", "<", ">", "<=", ">=", "<>"
                currentPrec = 5

              CASE "AND", "NAND"
                currentPrec = 3

              CASE "OR", "NOR"
                currentPrec = 2

              CASE "XOR", "XNOR"
                currentPrec = 1

              CASE ELSE
                isOperator = 0

            END SELECT ' opText$
          END IF

          IF isOperator = 0 THEN
            evalMathConst$ = workExpr$
            EXIT FUNCTION
          END IF

          IF isPrefix = 0 THEN
            DO WHILE operatorCount > 0
              IF constEvalWork(operatorCount - 1).OperatorText = "(" THEN EXIT DO

              shouldPop = 0

              IF currentRightAssoc = 1 THEN
                IF constEvalWork(operatorCount - 1).OperatorPrec > currentPrec THEN shouldPop = 1
              ELSE
                IF constEvalWork(operatorCount - 1).OperatorPrec >= currentPrec THEN shouldPop = 1
              END IF

              IF shouldPop = 0 THEN EXIT DO

              constEvalWork(outputCount).OutputText = constEvalWork(operatorCount - 1).OperatorText
              outputCount = outputCount + 1
              operatorCount = operatorCount - 1
            LOOP
          END IF

          constEvalWork(operatorCount).OperatorText = opText$
          constEvalWork(operatorCount).OperatorPrec = currentPrec
          operatorCount = operatorCount + 1
          expectOperand = 1
        END IF
      END IF
    END IF
  NEXT

  IF expectOperand = 1 THEN
    throwCompilerError "MISSING VALUE IN CONSTANT EXPRESSION", ASIS, 0
    evalMathConst$ = workExpr$
    EXIT FUNCTION
  END IF

  DO WHILE operatorCount > 0
    IF constEvalWork(operatorCount - 1).OperatorText = "(" THEN
      throwCompilerError "UNMATCHED PARENTHESIS IN CONSTANT", ASIS, 0
      evalMathConst$ = workExpr$
      EXIT FUNCTION
    END IF

    constEvalWork(outputCount).OutputText = constEvalWork(operatorCount - 1).OperatorText
    outputCount = outputCount + 1
    operatorCount = operatorCount - 1
  LOOP

  valueCount = 0

  FOR tokenIdx = 0 TO outputCount - 1
    currentText$ = constEvalWork(tokenIdx).OutputText
    upperText$ = UCASE$(currentText$)
    isNumeric = 0

    IF LEN(currentText$) > 0 THEN
      charCode = ASC(currentText$, 1)
      IF charCode >= 48 AND charCode <= 57 THEN isNumeric = 1
      IF charCode = 46 AND LEN(currentText$) > 1 THEN
        nextCode = ASC(currentText$, 2)
        IF nextCode >= 48 AND nextCode <= 57 THEN isNumeric = 1
      END IF
      IF LEFT$(upperText$, 2) = "&H" AND LEN(currentText$) > 2 THEN isNumeric = 1
    END IF

    IF isNumeric = 1 THEN
      constEvalWork(valueCount).Value = VAL(currentText$)
      constEvalWork(valueCount).IsInteger = 1
      IF INSTR(currentText$, ".") > 0 THEN constEvalWork(valueCount).IsInteger = 0
      IF INSTR(UCASE$(currentText$), "E") > 0 THEN constEvalWork(valueCount).IsInteger = 0
      IF RIGHT$(currentText$, 1) = "!" OR RIGHT$(currentText$, 1) = "#" THEN constEvalWork(valueCount).IsInteger = 0
      valueCount = valueCount + 1
    ELSE
      IF upperText$ = "U-" OR upperText$ = "U+" OR upperText$ = "NOT" THEN
        IF valueCount < 1 THEN
          throwCompilerError "MISSING CONSTANT OPERAND", ASIS, 0
          evalMathConst$ = workExpr$
          EXIT FUNCTION
        END IF

        IF upperText$ = "U-" THEN
          constEvalWork(valueCount - 1).Value = -constEvalWork(valueCount - 1).Value
        ELSE
          IF upperText$ = "NOT" THEN
            rightInt = constEvalWork(valueCount - 1).Value
            constEvalWork(valueCount - 1).Value = NOT rightInt
            constEvalWork(valueCount - 1).IsInteger = 1
          END IF
        END IF
      ELSE
        IF valueCount < 2 THEN
          throwCompilerError "MISSING CONSTANT OPERAND", ASIS, 0
          evalMathConst$ = workExpr$
          EXIT FUNCTION
        END IF

        leftValue = constEvalWork(valueCount - 2).Value
        rightValue = constEvalWork(valueCount - 1).Value
        leftInt = leftValue
        rightInt = rightValue
        resultValue = 0
        isIntegerResult = 0

        SELECT CASE upperText$

          CASE "+"
            resultValue = leftValue + rightValue
            IF constEvalWork(valueCount - 2).IsInteger = 1 AND constEvalWork(valueCount - 1).IsInteger = 1 THEN isIntegerResult = 1

          CASE "-"
            resultValue = leftValue - rightValue
            IF constEvalWork(valueCount - 2).IsInteger = 1 AND constEvalWork(valueCount - 1).IsInteger = 1 THEN isIntegerResult = 1

          CASE "*"
            resultValue = leftValue * rightValue
            IF constEvalWork(valueCount - 2).IsInteger = 1 AND constEvalWork(valueCount - 1).IsInteger = 1 THEN isIntegerResult = 1

          CASE "/"
            IF rightValue = 0 THEN
              throwCompilerError "DIVISION BY ZERO IN CONSTANT", ASIS, 0
              evalMathConst$ = workExpr$
              EXIT FUNCTION
            END IF
            resultValue = leftValue / rightValue

          CASE "\"
            IF rightInt = 0 THEN
              throwCompilerError "DIVISION BY ZERO IN CONSTANT", ASIS, 0
              evalMathConst$ = workExpr$
              EXIT FUNCTION
            END IF
            resultValue = leftInt \ rightInt
            isIntegerResult = 1

          CASE "MOD"
            IF rightInt = 0 THEN
              throwCompilerError "DIVISION BY ZERO IN CONSTANT", ASIS, 0
              evalMathConst$ = workExpr$
              EXIT FUNCTION
            END IF
            resultValue = leftInt MOD rightInt
            isIntegerResult = 1

          CASE "^"
            resultValue = leftValue ^ rightValue

          CASE "=", "<", ">", "<=", ">=", "<>"
            resultInt = 0

            SELECT CASE upperText$
              CASE "=": IF leftValue = rightValue THEN resultInt = -1
              CASE "<": IF leftValue < rightValue THEN resultInt = -1
              CASE ">": IF leftValue > rightValue THEN resultInt = -1
              CASE "<=": IF leftValue <= rightValue THEN resultInt = -1
              CASE ">=": IF leftValue >= rightValue THEN resultInt = -1
              CASE "<>": IF leftValue <> rightValue THEN resultInt = -1
            END SELECT ' upperText$

            resultValue = resultInt
            isIntegerResult = 1

          CASE "AND"
            resultValue = leftInt AND rightInt
            isIntegerResult = 1

          CASE "NAND"
            resultValue = NOT (leftInt AND rightInt)
            isIntegerResult = 1

          CASE "OR"
            resultValue = leftInt OR rightInt
            isIntegerResult = 1

          CASE "NOR"
            resultValue = NOT (leftInt OR rightInt)
            isIntegerResult = 1

          CASE "XOR"
            resultValue = leftInt XOR rightInt
            isIntegerResult = 1

          CASE "XNOR"
            resultValue = NOT (leftInt XOR rightInt)
            isIntegerResult = 1

          CASE ELSE
            throwCompilerError "INVALID CONSTANT OPERATOR " + currentText$, ASIS, 0
            evalMathConst$ = workExpr$
            EXIT FUNCTION

        END SELECT ' upperText$

        constEvalWork(valueCount - 2).Value = resultValue
        constEvalWork(valueCount - 2).IsInteger = isIntegerResult
        valueCount = valueCount - 1
      END IF
    END IF
  NEXT

  IF valueCount <> 1 THEN
    throwCompilerError "MALFORMED CONSTANT EXPRESSION", ASIS, 0
    evalMathConst$ = workExpr$
    EXIT FUNCTION
  END IF

  IF constEvalWork(0).IsInteger = 1 THEN
    resultInt = constEvalWork(0).Value
    evalMathConst$ = LTRIM$(RTRIM$(STR$(resultInt)))
  ELSE
    evalMathConst$ = LTRIM$(RTRIM$(STR$(constEvalWork(0).Value)))
  END IF

END FUNCTION ' evalMathConst$

