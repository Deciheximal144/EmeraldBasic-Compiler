''''''''''''''''''''''''
FUNCTION tiraWalkUdtDynamicStringsId (basePtrType AS LONG, basePtrVal AS _INTEGER64, uIdx AS LONG, scheduleFree AS LONG)

  tiraCheckActive ("tiraWalkUdtDynamicStringsId")
  IF tiraLineCheckId THEN
    tiraWalkUdtDynamicStringsId = 0
    EXIT FUNCTION
  END IF

  DIM workUdtIndex(MAX_UDTS) AS LONG
  DIM workFieldIndex(MAX_UDTS) AS LONG
  DIM workBaseOffset(MAX_UDTS) AS LONG
  DIM workDepth AS LONG
  DIM currentUdtIndex AS LONG
  DIM currentFieldIndex AS LONG
  DIM nestedUdtIndex AS LONG
  DIM fieldOffset AS LONG
  DIM fieldType AS LONG
  DIM foundDynamicString AS LONG
  DIM descAddrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM skipFreeDataLblIdx AS LONG
  DIM flagValIdx AS LONG
  DIM flagPtrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM emptyDescPtrIdx AS LONG
  DIM emptyDescGlobalIdx AS LONG
  DIM skipFreeDescLblIdx AS LONG

  IF uIdx < 0 OR uIdx >= udtCount THEN
    throwCompilerError "INVALID UDT INDEX IN DYNAMIC STRING WALK", ASIS, 0
    tiraWalkUdtDynamicStringsId = 0
    EXIT FUNCTION
  END IF

  foundDynamicString = 0
  workDepth = 0
  workUdtIndex(0) = uIdx
  workFieldIndex(0) = 0
  workBaseOffset(0) = 0

  DO WHILE workDepth >= 0
    currentUdtIndex = workUdtIndex(workDepth)
    currentFieldIndex = workFieldIndex(workDepth)

    IF currentFieldIndex >= udts(currentUdtIndex).FieldCount THEN
      workDepth = workDepth - 1
    ELSE
      workFieldIndex(workDepth) = currentFieldIndex + 1

      fieldOffset = workBaseOffset(workDepth) + udtFields(currentUdtIndex, currentFieldIndex).Offset
      fieldType = udtFields(currentUdtIndex, currentFieldIndex).DataType

      IF fieldType = TYPE_UDT THEN
        nestedUdtIndex = udtFields(currentUdtIndex, currentFieldIndex).UDTIndex

        IF nestedUdtIndex < 0 OR nestedUdtIndex >= udtCount THEN
          throwCompilerError "INVALID NESTED UDT INDEX IN DYNAMIC STRING WALK", ASIS, 0
          tiraWalkUdtDynamicStringsId = 0
          EXIT FUNCTION
        END IF

        IF workDepth >= MAX_UDTS - 1 THEN
          throwCompilerError "UDT NESTING LIMIT REACHED IN DYNAMIC STRING WALK", ASIS, 0
          tiraWalkUdtDynamicStringsId = 0
          EXIT FUNCTION
        END IF

        workDepth = workDepth + 1
        workUdtIndex(workDepth) = nestedUdtIndex
        workFieldIndex(workDepth) = 0
        workBaseOffset(workDepth) = fieldOffset
      ELSE
        IF fieldType = TYPE_STRING THEN
          IF udtFields(currentUdtIndex, currentFieldIndex).IsDynamicString = 1 THEN
            foundDynamicString = 1

            IF scheduleFree = 0 THEN
              tiraWalkUdtDynamicStringsId = 1
              EXIT FUNCTION
            END IF

            descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            IF fieldOffset > 0 THEN
              tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descAddrIdx, basePtrType, basePtrVal, TIRA_ARG_LITERAL, fieldOffset
            ELSE
              tiraAssignId descAddrIdx, basePtrType, basePtrVal
            END IF

            descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, descAddrIdx

            skipFreeDataLblIdx = tiraLabelCreateNewId&("SKIP_UDT_DATA")
            tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDataLblIdx

            flagValIdx = tiraDimVarId&("T", TYPE_LONG)
            flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 16
            tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

            tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeDataLblIdx

            dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraReadMemId dataPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx

            tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDataLblIdx

            ff = resolveSymbol("IAT_HEAPFREE")
            IF ff = 0 THEN
              tiraWalkUdtDynamicStringsId = 0
              EXIT FUNCTION
            END IF
            heapFreeIdx = returnedData2

            ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
            IF ff = 0 THEN
              tiraWalkUdtDynamicStringsId = 0
              EXIT FUNCTION
            END IF
            processHeapIdx = returnedData2

            tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, dataPtrIdx

            tiraLabelId skipFreeDataLblIdx

            emptyDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            ff = resolveSymbol("!G_SYS_DSC_EMPTY")
            IF ff = 0 THEN
              tiraWalkUdtDynamicStringsId = 0
              EXIT FUNCTION
            END IF
            emptyDescGlobalIdx = returnedData2
            tiraAssignId emptyDescPtrIdx, TIRA_ARG_SYMBOL, emptyDescGlobalIdx

            skipFreeDescLblIdx = tiraLabelCreateNewId&("SKIP_UDT_DESC")
            tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx
            tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, emptyDescPtrIdx, skipFreeDescLblIdx
            tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, descPtrIdx
            tiraLabelId skipFreeDescLblIdx
          END IF
        END IF
      END IF
    END IF
  LOOP

  tiraWalkUdtDynamicStringsId = foundDynamicString

END FUNCTION ' tiraWalkUdtDynamicStringsId

''''''''''''''''''''''''
SUB tiraWriteMemId (destType AS LONG, destVal AS _INTEGER64, srcType AS LONG, srcVal AS _INTEGER64, sizeModeType AS LONG, sizeModeVal AS _INTEGER64)

  tiraCheckActive ("tiraWriteMemId")
  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_WRITE_MEM

  tiraNode(t.LineCount).Arg1Type = destType
  tiraNode(t.LineCount).Arg1Val = destVal

  tiraNode(t.LineCount).Arg2Type = srcType
  tiraNode(t.LineCount).Arg2Val = srcVal

  tiraNode(t.LineCount).Arg3Type = sizeModeType
  tiraNode(t.LineCount).Arg3Val = sizeModeVal

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraWriteMemId

''''''''''''''''''''''''
SUB tokenizeLine (wLine$)

  DIM lineLen AS _UNSIGNED LONG
  DIM ix AS _UNSIGNED LONG
  DIM cAs AS _UNSIGNED LONG
  DIM remStart AS _UNSIGNED LONG
  DIM cRem AS _UNSIGNED LONG
  DIM isNum AS _UNSIGNED LONG
  DIM cNextAs AS _UNSIGNED LONG
  DIM tStart AS _UNSIGNED LONG
  DIM hasDecimal AS _UNSIGNED LONG
  DIM c2As AS _UNSIGNED LONG
  DIM chunkStart AS _UNSIGNED LONG
  DIM cPrevAs AS _UNSIGNED LONG
  DIM chunkEnd AS _UNSIGNED LONG
  DIM symVal AS _UNSIGNED LONG
  DIM c3As AS _UNSIGNED LONG
  DIM hasEndQuote AS _UNSIGNED LONG
  DIM ff AS _UNSIGNED LONG
  DIM isKey AS _UNSIGNED LONG
  DIM kwVal AS _UNSIGNED LONG
  DIM isPascalAssign AS _UNSIGNED LONG
  DIM cacheHash AS _UNSIGNED LONG
  DIM cacheLineIdx AS _UNSIGNED LONG
  DIM cacheTokenBase AS _UNSIGNED LONG
  DIM cacheTokenIdx AS _UNSIGNED LONG

  lineTokenCount = 0
  lineLen = LEN(wLine$)

  IF tokenCacheEnabled = 1 THEN
    cacheHash = 5381
    FOR ix = 1 TO lineLen
      cacheHash = ((cacheHash * 33) + ASC(wLine$, ix)) AND TOKEN_CACHE_HASH_MASK
    NEXT
    cacheHash = (cacheHash + (cm.PascalMode * 257)) AND TOKEN_CACHE_HASH_MASK

    cacheLineIdx = tokenCacheHash(cacheHash)
    DO WHILE cacheLineIdx > 0
      IF tokenCacheLine(cacheLineIdx).PascalMode = cm.PascalMode THEN
        IF tokenCacheLine(cacheLineIdx).LineText = wLine$ THEN
          lineTokenCount = tokenCacheLine(cacheLineIdx).TokenCount
          cacheTokenBase = tokenCacheLine(cacheLineIdx).TokenStart

          IF lineTokenCount > 0 THEN
            FOR cacheTokenIdx = 0 TO lineTokenCount - 1
              lineTokenVals(cacheTokenIdx) = tokenCacheToken(cacheTokenBase + cacheTokenIdx).TokenVal
              lineTokenStartChar(cacheTokenIdx) = tokenCacheToken(cacheTokenBase + cacheTokenIdx).StartChar
              lineTokenEndChar(cacheTokenIdx) = tokenCacheToken(cacheTokenBase + cacheTokenIdx).EndChar

              IF lineTokenVals(cacheTokenIdx) = 0 THEN
                lineTokens$(cacheTokenIdx) = MID$(wLine$, lineTokenStartChar(cacheTokenIdx), lineTokenEndChar(cacheTokenIdx) - lineTokenStartChar(cacheTokenIdx) + 1)
              ELSE
                lineTokens$(cacheTokenIdx) = tokenStrCache(lineTokenVals(cacheTokenIdx))
              END IF
            NEXT
          END IF

          EXIT SUB
        END IF
      END IF

      cacheLineIdx = tokenCacheLine(cacheLineIdx).HashNext
    LOOP
  END IF
  ix = 1

  DO WHILE ix <= lineLen
    cAs = ASC(wLine$, ix)

    SELECT CASE cAs

      CASE 39 ' Single Quote
        remStart = ix + 1
        DO WHILE remStart <= lineLen
          cRem = ASC(wLine$, remStart)
          IF cRem = 32 OR cRem = 9 THEN
            remStart = remStart + 1
          ELSE
            EXIT DO
          END IF
        LOOP
        remText$ = UCASE$(MID$(wLine$, remStart))
        IF LEFT$(remText$, 7) = "$STATIC" THEN
          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = tokenStrCache(TOK_STATIC_META)
          lineTokenVals(lineTokenCount) = TOK_STATIC_META
          lineTokenStartChar(lineTokenCount) = remStart
          lineTokenEndChar(lineTokenCount) = remStart + 6
          lineTokenCount = lineTokenCount + 1
        ELSE
          IF LEFT$(remText$, 8) = "$DYNAMIC" THEN
            IF lineTokenCount >= MAX_TOKENS THEN
              throwCompilerError "TOKEN LIMIT", ASIS, 0
              EXIT SUB
            END IF
            lineTokens$(lineTokenCount) = tokenStrCache(TOK_DYNAMIC_META)
            lineTokenVals(lineTokenCount) = TOK_DYNAMIC_META
            lineTokenStartChar(lineTokenCount) = remStart
            lineTokenEndChar(lineTokenCount) = remStart + 7
            lineTokenCount = lineTokenCount + 1
          ELSE
            IF LEFT$(remText$, 8) = "#INCLUDE" THEN
              IF lineTokenCount >= MAX_TOKENS THEN
                throwCompilerError "TOKEN LIMIT", ASIS, 0
                EXIT SUB
              END IF
              lineTokens$(lineTokenCount) = tokenStrCache(TOK_INCLUDE)
              lineTokenVals(lineTokenCount) = TOK_INCLUDE
              lineTokenStartChar(lineTokenCount) = remStart
              lineTokenEndChar(lineTokenCount) = remStart + 7
              lineTokenCount = lineTokenCount + 1
            ELSE
              IF LEFT$(remText$, 7) = "GDOUBLE" THEN
                IF lineTokenCount >= MAX_TOKENS THEN
                  throwCompilerError "TOKEN LIMIT", ASIS, 0
                  EXIT SUB
                END IF
                lineTokens$(lineTokenCount) = tokenStrCache(TOK_GDOUBLE)
                lineTokenVals(lineTokenCount) = TOK_GDOUBLE
                lineTokenStartChar(lineTokenCount) = remStart
                lineTokenEndChar(lineTokenCount) = remStart + 6
                lineTokenCount = lineTokenCount + 1
              END IF
            END IF
          END IF
        END IF
        EXIT DO

      CASE 32, 9 ' Space, Tab
        ix = ix + 1

      CASE 48 TO 57, 46 ' 0-9, .
        isNum = 0
        IF cAs = 46 THEN
          IF ix < lineLen THEN
            cNextAs = ASC(wLine$, ix + 1)
            IF cNextAs >= 48 AND cNextAs <= 57 THEN isNum = 1
          END IF
        ELSE
          isNum = 1
        END IF

        IF isNum = 1 THEN
          tStart = ix
          hasDecimal = 0
          DO WHILE ix <= lineLen
            c2As = ASC(wLine$, ix)
            IF c2As >= 48 AND c2As <= 57 THEN
              ix = ix + 1
            ELSE
              IF c2As = 46 AND hasDecimal = 0 THEN
                hasDecimal = 1
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            END IF
          LOOP

          IF ix <= lineLen THEN
            c2As = ASC(wLine$, ix)
            IF c2As = 35 OR c2As = 33 OR c2As = 38 OR c2As = 37 THEN ' # ! & %
              ix = ix + 1
            END IF
          END IF

          numVal$ = MID$(wLine$, tStart, ix - tStart)

          IF ix <= lineLen THEN
            c2As = ASC(wLine$, ix)
            IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR c2As = 95 THEN
              chunkStart = ix - LEN(numVal$)
              DO WHILE chunkStart > 1
                cPrevAs = ASC(wLine$, chunkStart - 1)
                IF cPrevAs = 32 OR cPrevAs = 9 THEN EXIT DO
                chunkStart = chunkStart - 1
              LOOP
              chunkEnd = ix
              DO WHILE chunkEnd <= lineLen
                cNextAs = ASC(wLine$, chunkEnd)
                IF cNextAs = 32 OR cNextAs = 9 THEN EXIT DO
                chunkEnd = chunkEnd + 1
              LOOP
              chunkStr$ = MID$(wLine$, chunkStart, chunkEnd - chunkStart)
              throwCompilerError "UNRECOGNIZED KEYWORD: " + chunkStr$, ASIS, 0
              EXIT SUB
            END IF
          END IF

          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = numVal$
          lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
          lineTokenStartChar(lineTokenCount) = tStart
          lineTokenEndChar(lineTokenCount) = ix - 1
          lineTokenCount = lineTokenCount + 1
        ELSE
          symVal = 256 + cAs
          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = tokenStrCache(symVal)
          lineTokenVals(lineTokenCount) = symVal
          lineTokenStartChar(lineTokenCount) = ix
          lineTokenEndChar(lineTokenCount) = ix
          lineTokenCount = lineTokenCount + 1
          ix = ix + 1
        END IF

      CASE 38 ' &
        IF ix < lineLen THEN
          c2As = ASC(wLine$, ix + 1)
          IF c2As = 72 OR c2As = 104 THEN ' H or h
            tStart = ix
            ix = ix + 2
            DO WHILE ix <= lineLen
              c3As = ASC(wLine$, ix)
              IF (c3As >= 48 AND c3As <= 57) OR (c3As >= 65 AND c3As <= 70) OR (c3As >= 97 AND c3As <= 102) THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP
            numVal$ = MID$(wLine$, tStart, ix - tStart)
            IF lineTokenCount >= MAX_TOKENS THEN
              throwCompilerError "TOKEN LIMIT", ASIS, 0
              EXIT SUB
            END IF
            lineTokens$(lineTokenCount) = numVal$
            lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
            lineTokenStartChar(lineTokenCount) = tStart
            lineTokenEndChar(lineTokenCount) = ix - 1
            lineTokenCount = lineTokenCount + 1
          ELSE
            symVal = 256 + cAs
            IF lineTokenCount >= MAX_TOKENS THEN
              throwCompilerError "TOKEN LIMIT", ASIS, 0
              EXIT SUB
            END IF
            lineTokens$(lineTokenCount) = tokenStrCache(symVal)
            lineTokenVals(lineTokenCount) = symVal
            lineTokenStartChar(lineTokenCount) = ix
            lineTokenEndChar(lineTokenCount) = ix
            lineTokenCount = lineTokenCount + 1
            ix = ix + 1
          END IF
        ELSE
          symVal = 256 + cAs
          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = tokenStrCache(symVal)
          lineTokenVals(lineTokenCount) = symVal
          lineTokenStartChar(lineTokenCount) = ix
          lineTokenEndChar(lineTokenCount) = ix
          lineTokenCount = lineTokenCount + 1
          ix = ix + 1
        END IF

      CASE 45 ' -
        symVal = 256 + cAs
        IF lineTokenCount >= MAX_TOKENS THEN
          throwCompilerError "TOKEN LIMIT", ASIS, 0
          EXIT SUB
        END IF
        lineTokens$(lineTokenCount) = tokenStrCache(symVal)
        lineTokenVals(lineTokenCount) = symVal
        lineTokenStartChar(lineTokenCount) = ix
        lineTokenEndChar(lineTokenCount) = ix
        lineTokenCount = lineTokenCount + 1
        ix = ix + 1

      CASE 34 ' "
        tStart = ix
        ix = ix + 1
        hasEndQuote = 0
        DO WHILE ix <= lineLen
          c2As = ASC(wLine$, ix)
          ix = ix + 1
          IF c2As = 34 THEN
            hasEndQuote = 1
            EXIT DO
          END IF
        LOOP
        IF hasEndQuote = 0 THEN
          throwCompilerError "MISSING END QUOTE", ASIS, 0
          EXIT SUB
        END IF
        IF lineTokenCount >= MAX_TOKENS THEN
          throwCompilerError "TOKEN LIMIT", ASIS, 0
          EXIT SUB
        END IF
        lineTokens$(lineTokenCount) = MID$(wLine$, tStart, ix - tStart)
        lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
        lineTokenStartChar(lineTokenCount) = tStart
        lineTokenEndChar(lineTokenCount) = ix - 1
        lineTokenCount = lineTokenCount + 1

      CASE 35 ' #
        tStart = ix
        ix = ix + 1
        DO WHILE ix <= lineLen
          c2As = ASC(wLine$, ix)
          IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) THEN
            ix = ix + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        identVal$ = MID$(wLine$, tStart, ix - tStart)
        uIdent$ = UCASE$(identVal$)

        ff = findKeywordIndex(uIdent$)
        IF ff = 1 THEN
          isKey = 1
          kwVal = returnedData2
        ELSE
          isKey = 0
          kwVal = 0
        END IF

        IF lineTokenCount >= MAX_TOKENS THEN
          throwCompilerError "TOKEN LIMIT", ASIS, 0
          EXIT SUB
        END IF
        IF isKey = 1 THEN
          lineTokens$(lineTokenCount) = tokenStrCache(kwVal)
          lineTokenVals(lineTokenCount) = kwVal
        ELSE
          lineTokens$(lineTokenCount) = identVal$
          lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
        END IF
        lineTokenStartChar(lineTokenCount) = tStart
        lineTokenEndChar(lineTokenCount) = ix - 1
        lineTokenCount = lineTokenCount + 1

      CASE 36 ' $
        tStart = ix
        ix = ix + 1
        DO WHILE ix <= lineLen
          c2As = ASC(wLine$, ix)
          IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) THEN
            ix = ix + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        identVal$ = MID$(wLine$, tStart, ix - tStart)
        uIdent$ = UCASE$(identVal$)

        ff = findKeywordIndex(uIdent$)
        IF ff = 1 THEN
          isKey = 1
          kwVal = returnedData2
        ELSE
          isKey = 0
          kwVal = 0
        END IF

        IF lineTokenCount >= MAX_TOKENS THEN
          throwCompilerError "TOKEN LIMIT", ASIS, 0
          EXIT SUB
        END IF
        IF isKey = 1 THEN
          lineTokens$(lineTokenCount) = tokenStrCache(kwVal)
          lineTokenVals(lineTokenCount) = kwVal
        ELSE
          lineTokens$(lineTokenCount) = identVal$
          lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
        END IF
        lineTokenStartChar(lineTokenCount) = tStart
        lineTokenEndChar(lineTokenCount) = ix - 1
        lineTokenCount = lineTokenCount + 1

      CASE 65 TO 90, 97 TO 122, 95 ' A-Z, a-z, _
        tStart = ix
        DO WHILE ix <= lineLen
          c2As = ASC(wLine$, ix)
          IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 THEN
            ix = ix + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF ix <= lineLen THEN
          c2As = ASC(wLine$, ix)
          IF c2As = 126 THEN ' ~
            ix = ix + 1
            IF ix <= lineLen THEN
              c3As = ASC(wLine$, ix)
              IF c3As = 38 THEN ' &
                ix = ix + 1
              END IF
            END IF
          ELSE
            IF c2As = 38 THEN ' &
              ix = ix + 1
              IF ix <= lineLen THEN
                c3As = ASC(wLine$, ix)
                IF c3As = 38 THEN ix = ix + 1 ' &&
              END IF
            ELSE
              IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 37 THEN
                ix = ix + 1
              END IF
            END IF
          END IF
        END IF

        identVal$ = MID$(wLine$, tStart, ix - tStart)
        uIdent$ = UCASE$(identVal$)

        IF uIdent$ = "REM" THEN
          remStart = ix
          DO WHILE remStart <= lineLen
            cRem = ASC(wLine$, remStart)
            IF cRem = 32 OR cRem = 9 THEN
              remStart = remStart + 1
            ELSE
              EXIT DO
            END IF
          LOOP
          remText$ = UCASE$(MID$(wLine$, remStart))
          IF LEFT$(remText$, 7) = "$STATIC" THEN
            IF lineTokenCount >= MAX_TOKENS THEN
              throwCompilerError "TOKEN LIMIT", ASIS, 0
              EXIT SUB
            END IF
            lineTokens$(lineTokenCount) = tokenStrCache(TOK_STATIC_META)
            lineTokenVals(lineTokenCount) = TOK_STATIC_META
            lineTokenStartChar(lineTokenCount) = tStart
            lineTokenEndChar(lineTokenCount) = remStart + 6
            lineTokenCount = lineTokenCount + 1
          ELSE
            IF LEFT$(remText$, 8) = "$DYNAMIC" THEN
              IF lineTokenCount >= MAX_TOKENS THEN
                throwCompilerError "TOKEN LIMIT", ASIS, 0
                EXIT SUB
              END IF
              lineTokens$(lineTokenCount) = tokenStrCache(TOK_DYNAMIC_META)
              lineTokenVals(lineTokenCount) = TOK_DYNAMIC_META
              lineTokenStartChar(lineTokenCount) = tStart
              lineTokenEndChar(lineTokenCount) = remStart + 7
              lineTokenCount = lineTokenCount + 1
            ELSE
              IF LEFT$(remText$, 8) = "#INCLUDE" THEN
                IF lineTokenCount >= MAX_TOKENS THEN
                  throwCompilerError "TOKEN LIMIT", ASIS, 0
                  EXIT SUB
                END IF
                lineTokens$(lineTokenCount) = tokenStrCache(TOK_INCLUDE)
                lineTokenVals(lineTokenCount) = TOK_INCLUDE
                lineTokenStartChar(lineTokenCount) = tStart
                lineTokenEndChar(lineTokenCount) = remStart + 7
                lineTokenCount = lineTokenCount + 1
              ELSE
                IF LEFT$(remText$, 7) = "GDOUBLE" THEN
                  IF lineTokenCount >= MAX_TOKENS THEN
                    throwCompilerError "TOKEN LIMIT", ASIS, 0
                    EXIT SUB
                  END IF
                  lineTokens$(lineTokenCount) = tokenStrCache(TOK_GDOUBLE)
                  lineTokenVals(lineTokenCount) = TOK_GDOUBLE
                  lineTokenStartChar(lineTokenCount) = tStart
                  lineTokenEndChar(lineTokenCount) = remStart + 6
                  lineTokenCount = lineTokenCount + 1
                END IF
              END IF
            END IF
          END IF
          EXIT DO
        END IF

        uIdentSearch$ = uIdent$
        IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
        IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
        IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
        IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
        IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
        IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
        IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
        IF uIdentSearch$ = "_STRINGD" THEN uIdentSearch$ = "STRINGD"
        IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
        IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

        ff = findKeywordIndex(uIdentSearch$)
        IF ff = 1 THEN
          isKey = 1
          kwVal = returnedData2
        ELSE
          isKey = 0
          kwVal = 0
        END IF

        IF lineTokenCount >= MAX_TOKENS THEN
          throwCompilerError "TOKEN LIMIT", ASIS, 0
          EXIT SUB
        END IF

        IF isKey = 1 THEN
          lineTokens$(lineTokenCount) = tokenStrCache(kwVal)
          lineTokenVals(lineTokenCount) = kwVal
        ELSE
          lineTokens$(lineTokenCount) = identVal$
          lineTokenVals(lineTokenCount) = retTokenVal(lineTokens$(lineTokenCount))
        END IF
        lineTokenStartChar(lineTokenCount) = tStart
        lineTokenEndChar(lineTokenCount) = ix - 1
        lineTokenCount = lineTokenCount + 1

      CASE ELSE
        isPascalAssign = 0
        IF cAs = 58 AND cm.PascalMode = 1 THEN ' :
          IF ix < lineLen THEN
            cNextAs = ASC(wLine$, ix + 1)
            IF cNextAs = 61 THEN ' =
              isPascalAssign = 1
            END IF
          END IF
        END IF

        IF isPascalAssign = 1 THEN
          symVal = 256 + ASC("=")
          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = tokenStrCache(symVal)
          lineTokenVals(lineTokenCount) = symVal
          lineTokenStartChar(lineTokenCount) = ix
          lineTokenEndChar(lineTokenCount) = ix + 1
          lineTokenCount = lineTokenCount + 1
          ix = ix + 2
        ELSE
          symVal = 256 + cAs
          IF lineTokenCount >= MAX_TOKENS THEN
            throwCompilerError "TOKEN LIMIT", ASIS, 0
            EXIT SUB
          END IF
          lineTokens$(lineTokenCount) = tokenStrCache(symVal)
          lineTokenVals(lineTokenCount) = symVal
          lineTokenStartChar(lineTokenCount) = ix
          lineTokenEndChar(lineTokenCount) = ix
          lineTokenCount = lineTokenCount + 1
          ix = ix + 1
        END IF

    END SELECT ' cAs

  LOOP

  IF tokenCacheEnabled = 1 THEN
    IF compileError = 0 THEN
      IF tokenCacheLineCount < MAX_TOKEN_CACHE_LINES THEN
        IF tokenCacheTokenCount + lineTokenCount <= MAX_TOKEN_CACHE_TOKENS THEN
          cacheLineIdx = tokenCacheLineCount + 1
          tokenCacheLine(cacheLineIdx).LineText = wLine$
          tokenCacheLine(cacheLineIdx).TokenStart = tokenCacheTokenCount
          tokenCacheLine(cacheLineIdx).TokenCount = lineTokenCount
          tokenCacheLine(cacheLineIdx).HashNext = tokenCacheHash(cacheHash)
          tokenCacheLine(cacheLineIdx).PascalMode = cm.PascalMode
          tokenCacheHash(cacheHash) = cacheLineIdx

          IF lineTokenCount > 0 THEN
            FOR cacheTokenIdx = 0 TO lineTokenCount - 1
              tokenCacheToken(tokenCacheTokenCount + cacheTokenIdx).TokenVal = lineTokenVals(cacheTokenIdx)
              tokenCacheToken(tokenCacheTokenCount + cacheTokenIdx).StartChar = lineTokenStartChar(cacheTokenIdx)
              tokenCacheToken(tokenCacheTokenCount + cacheTokenIdx).EndChar = lineTokenEndChar(cacheTokenIdx)
            NEXT
          END IF

          tokenCacheTokenCount = tokenCacheTokenCount + lineTokenCount
          tokenCacheLineCount = cacheLineIdx
        END IF
      END IF
    END IF
  END IF

END SUB ' tokenizeLine

''''''''''''''''''''''''
FUNCTION updateStackAlignment

  ' Check for minimum 4-byte alignment (bits 0 and 1 must be 0)
  IF (stack.currentStackOffset AND 3) <> 0 THEN
    ESCAPETEXT2 "FATAL: STACK MISALIGNMENT: RSP not 4-byte aligned ($" + hexLen$(stack.currentStackOffset, 8) + ")", "Current stack offset: " + LTRIM$(STR$(stack.currentStackOffset)) + " bytes"
  END IF

  IF (stack.currentStackOffset AND 8) = 0 THEN
    stack.stackIs16Aligned = 1
  ELSE
    stack.stackIs16Aligned = 0
  END IF

  updateStackAlignment = stack.stackIs16Aligned

END FUNCTION ' updateStackAlignment

''''''''''''''''''''''''
FUNCTION validateSymbolArrayScalar (vIdx AS LONG, vName$, hasArraySyntax AS LONG, wasNewSymbol AS LONG, isDeclaration AS LONG, cancelTiraOnError AS LONG)

  validationMessage$ = ""

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF isDeclaration <> 0 THEN
        IF wasNewSymbol = 0 THEN
          IF hasArraySyntax > ARRAY_TYPE_NONE THEN
            IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
              validationMessage$ = "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()"
            END IF
          ELSE
            IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
              validationMessage$ = "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$
            END IF
          END IF
        END IF
      ELSE
        IF hasArraySyntax > ARRAY_TYPE_NONE THEN
          IF symbols(vIdx).IsArray = ARRAY_TYPE_NONE THEN
            IF wasNewSymbol <> 0 THEN
              validationMessage$ = "UNDECLARED ARRAY " + vName$ + "()"
            ELSE
              validationMessage$ = "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()"
            END IF
          END IF
        ELSE
          IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
            validationMessage$ = "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$
          END IF
        END IF
      END IF
    END IF
  END IF

  IF validationMessage$ <> "" THEN
    IF cancelTiraOnError <> 0 THEN
      throwCompilerErrorAndCancelTira validationMessage$, ASIS, 0
    ELSE
      throwCompilerError validationMessage$, ASIS, 0
    END IF
    validateSymbolArrayScalar = 0
    EXIT FUNCTION
  END IF

  validateSymbolArrayScalar = 1

END FUNCTION ' validateSymbolArrayScalar

''''''''''''''''''''''''
FUNCTION verifyNoExtraTokens (passEndIdx, passExpectedEndIdx, passCommandName$)

  tempRet = 1

  IF passEndIdx > passExpectedEndIdx THEN
    throwCompilerError "UNEXPECTED TOKEN AFTER " + passCommandName$, ASIS, 0
    tempRet = 0
  END IF

  verifyNoExtraTokens = tempRet

END FUNCTION ' verifyNoExtraTokens

''''''''''''''''''''''''
SUB writeIdataSection (wTextRawSize AS _UNSIGNED LONG)

  '''' Import Directory Table
  FOR iDll = 0 TO impTbl.numDlls - 1
    arrayWrite32LE impDlls(iDll).IltRVA
    arrayWrite32LE 0
    arrayWrite32LE 0
    arrayWrite32LE impDlls(iDll).NameRVA
    arrayWrite32LE impDlls(iDll).IatRVA
  NEXT

  '''' Null descriptor
  arrayPadNumBytes 20, 0

  '''' ILTs
  FOR iDll = 0 TO impTbl.numDlls - 1
    FOR iFunc = 0 TO impDlls(iDll).FuncCount - 1
      arrayWrite32LE impFuncs(iDll, iFunc).FuncRVA
      arrayWrite32LE 0
    NEXT
    arrayWrite32LE 0
    arrayWrite32LE 0
  NEXT

  '''' IATs
  FOR iDll = 0 TO impTbl.numDlls - 1
    FOR iFunc = 0 TO impDlls(iDll).FuncCount - 1
      arrayWrite32LE impFuncs(iDll, iFunc).FuncRVA
      arrayWrite32LE 0
    NEXT
    arrayWrite32LE 0
    arrayWrite32LE 0
  NEXT

  '''' Hint/name table
  FOR iDll = 0 TO impTbl.numDlls - 1
    FOR iFunc = 0 TO impDlls(iDll).FuncCount - 1
      outputFile(outputFileIdx) = 0
      outputFileIdx = outputFileIdx + 1
      outputFile(outputFileIdx) = 0
      outputFileIdx = outputFileIdx + 1

      fName$ = RTRIM$(impFuncs(iDll, iFunc).FuncName)
      FOR ii = 1 TO LEN(fName$)
        outputFile(outputFileIdx) = ASC(MID$(fName$, ii, 1))
        outputFileIdx = outputFileIdx + 1
      NEXT
      outputFile(outputFileIdx) = 0
      outputFileIdx = outputFileIdx + 1

      nameLen = LEN(fName$) + 1
      entrySize = 2 + nameLen
      IF (entrySize AND 1) <> 0 THEN
        outputFile(outputFileIdx) = 0
        outputFileIdx = outputFileIdx + 1
      END IF
    NEXT
  NEXT

  '''' DLL names
  FOR iDll = 0 TO impTbl.numDlls - 1
    dName$ = RTRIM$(impDlls(iDll).DllName)
    FOR ii = 1 TO LEN(dName$)
      outputFile(outputFileIdx) = ASC(MID$(dName$, ii, 1))
      outputFileIdx = outputFileIdx + 1
    NEXT
    outputFile(outputFileIdx) = 0
    outputFileIdx = outputFileIdx + 1

    nameLen = LEN(dName$) + 1
    IF (nameLen AND 1) <> 0 THEN
      outputFile(outputFileIdx) = 0
      outputFileIdx = outputFileIdx + 1
    END IF
  NEXT

  ' Pad .idata section to final size
  arrayPadUpTo PE_FILE_HEADER_OFFSET + wTextRawSize + impTbl.idataRawSize, 0

END SUB ' writeIdataSection

''''''''''''''''''''''''
SUB writePEHeader (wTextRawSize AS _UNSIGNED LONG, textVirtualSize AS _UNSIGNED LONG, bssRVA AS _UNSIGNED LONG)

  DIM localIdataFileOffset AS LONG
  DIM localIdataEndOffset AS LONG
  DIM unroundedSum AS _INTEGER64
  DIM roundedImageSize AS _INTEGER64
  DIM roundedImageSize32 AS LONG

  localIdataFileOffset = PE_FILE_HEADER_OFFSET + wTextRawSize
  localIdataEndOffset = localIdataFileOffset + impTbl.idataRawSize

  '''' Validate the completed executable image size

  unroundedSum = bssRVA
  unroundedSum = unroundedSum + textLayout.TotalBssSize

  roundedImageSize = unroundedSum + PE_SECTION_ALIGNMENT - 1
  roundedImageSize = roundedImageSize \ PE_SECTION_ALIGNMENT
  roundedImageSize = roundedImageSize * PE_SECTION_ALIGNMENT

  IF roundedImageSize < 0 THEN
    throwCompilerErrorNoLineNum "NEGATIVE PE IMAGE SIZE"
    addStatusMsgContinuation "BSS RVA: " + LTRIM$(STR$(bssRVA))
    addStatusMsgContinuation "BSS BYTES: " + LTRIM$(STR$(textLayout.TotalBssSize))
    EXIT SUB
  END IF

  IF roundedImageSize > PE_SIGNED_LAYOUT_MAX THEN
    throwCompilerErrorNoLineNum "PE IMAGE EXCEEDS SAFE SIGNED LAYOUT LIMIT"
    addStatusMsgContinuation "BSS RVA: " + LTRIM$(STR$(bssRVA))
    addStatusMsgContinuation "BSS BYTES: " + LTRIM$(STR$(textLayout.TotalBssSize))
    addStatusMsgContinuation "IMAGE BYTES: " + LTRIM$(STR$(roundedImageSize))
    addStatusMsgContinuation "MAX IMAGE BYTES: " + LTRIM$(STR$(PE_SIGNED_LAYOUT_MAX))
    EXIT SUB
  END IF

  roundedImageSize32 = roundedImageSize

  '''' Dos mz header
  outputFile(outputFileIdx) = ASC("M"): outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = ASC("Z"): outputFileIdx = outputFileIdx + 1

  arrayPadNumBytes 58, 0

  arrayWrite32LE &H00000040 ' e_lfanew: PE header offset

  '''' Pe signature
  outputFile(outputFileIdx) = ASC("P"): outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = ASC("E"): outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1

  '''' Coff file header
  arrayWrite16LE PE_MACHINE_AMD64 ' Machine
  arrayWrite16LE PE_NUM_SECTIONS ' NumberOfSections
  arrayWrite32LE &H00000000 ' TimeDateStamp
  arrayWrite32LE &H00000000 ' PointerToSymbolTable
  arrayWrite32LE &H00000000 ' NumberOfSymbols
  arrayWrite16LE PE_OPT_HEADER_SIZE ' SizeOfOptionalHeader
  arrayWrite16LE IMAGE_FILE_EXECUTABLE_IMAGE ' Characteristics: executable image

  '''' Optional header pe32+
  arrayWrite16LE PE_MAGIC_PE32PLUS ' Magic
  arrayWrite16LE &H000E ' MajorLinkerVersion, MinorLinkerVersion
  arrayWrite32LE wTextRawSize ' SizeOfCode
  arrayWrite32LE impTbl.idataRawSize ' SizeOfInitializedData
  arrayWrite32LE textLayout.TotalBssSize ' SizeOfUninitializedData
  arrayWrite32LE PE_TEXT_RVA ' AddressOfEntryPoint (.text start)
  arrayWrite32LE PE_TEXT_RVA ' BaseOfCode
  arrayWrite32LE PE_IMAGE_BASE ' ImageBase
  arrayWrite32LE &H00000000 ' SectionAlignment high dword (qword pair)
  arrayWrite32LE PE_SECTION_ALIGNMENT ' SectionAlignment
  arrayWrite32LE PE_FILE_ALIGNMENT ' FileAlignment
  arrayWrite16LE &H0006 ' MajorOperatingSystemVersion
  arrayWrite16LE &H0000 ' MinorOperatingSystemVersion
  arrayWrite16LE &H0000 ' MajorImageVersion
  arrayWrite16LE &H0000 ' MinorImageVersion
  arrayWrite16LE &H0006 ' MajorSubsystemVersion
  arrayWrite16LE &H0000 ' MinorSubsystemVersion
  arrayWrite32LE &H00000000 ' Win32VersionValue

  arrayWrite32LE roundedImageSize32 ' SizeOfImage

  arrayWrite32LE PE_FILE_ALIGNMENT ' SizeOfHeaders
  arrayWrite32LE &H00000000 ' CheckSum

  IF cm.HasGraphics = 1 THEN
    arrayWrite16LE &H0002 ' Subsystem: GUI (Windows)
  ELSE
    arrayWrite16LE &H0003 ' Subsystem: console
  END IF

  arrayWrite16LE &H8100 ' DllCharacteristics: NX compat, no SEH
  arrayWrite32LE peStackReserve ' SizeOfStackReserve low dword
  arrayWrite32LE &H00000000 ' SizeOfStackReserve high dword
  arrayWrite32LE &H00001000 ' SizeOfStackCommit low dword
  arrayWrite32LE &H00000000 ' SizeOfStackCommit high dword
  arrayWrite32LE &H00100000 ' SizeOfHeapReserve low dword
  arrayWrite32LE &H00000000 ' SizeOfHeapReserve high dword
  arrayWrite32LE &H00001000 ' SizeOfHeapCommit low dword
  arrayWrite32LE &H00000000 ' SizeOfHeapCommit high dword
  arrayWrite32LE &H00000000 ' LoaderFlags
  arrayWrite32LE &H00000010 ' NumberOfRvaAndSizes
  arrayWrite32LE &H00000000 ' DataDirectory[0] Export table RVA
  arrayWrite32LE &H00000000 ' DataDirectory[0] Export table size
  arrayWrite32LE impTbl.baseRVA ' DataDirectory[1] Import table RVA
  arrayWrite32LE impTbl.idtSize ' DataDirectory[1] Import table size
  arrayPadNumBytes 80, 0 ' DataDirectory[2..8]: unused entries
  arrayWrite32LE impDlls(0).IatRVA ' DataDirectory[12] IAT RVA
  arrayWrite32LE impTbl.totalIatSize ' DataDirectory[12] IAT size
  arrayPadNumBytes 24, 0 ' DataDirectory[13..15]: unused entries

  '''' Section table - .text
  arrayWriteCharString ".text"
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  arrayWrite32LE textVirtualSize ' VirtualSize
  arrayWrite32LE PE_TEXT_RVA ' VirtualAddress
  arrayWrite32LE wTextRawSize ' SizeOfRawData
  arrayWrite32LE PE_FILE_HEADER_OFFSET ' PointerToRawData
  arrayWrite32LE &H00000000 ' PointerToRelocations
  arrayWrite32LE &H00000000 ' PointerToLinenumbers
  arrayWrite16LE &H0000 ' NumberOfRelocations
  arrayWrite16LE &H0000 ' NumberOfLinenumbers
  arrayWrite32LE &HE0000020 ' Characteristics: code, execute, read, write

  '''' Section table - .idata
  arrayWriteCharString ".idata"
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  arrayWrite32LE impTbl.idataRawSize ' VirtualSize
  arrayWrite32LE impTbl.baseRVA ' VirtualAddress
  arrayWrite32LE impTbl.idataRawSize ' SizeOfRawData
  arrayWrite32LE localIdataFileOffset ' PointerToRawData
  arrayWrite32LE &H00000000 ' PointerToRelocations
  arrayWrite32LE &H00000000 ' PointerToLinenumbers
  arrayWrite16LE &H0000 ' NumberOfRelocations
  arrayWrite16LE &H0000 ' NumberOfLinenumbers
  arrayWrite32LE &HC0000040 ' Characteristics: initialized data, read, write

  '''' Section table - .bss
  arrayWriteCharString ".bss"
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = 0: outputFileIdx = outputFileIdx + 1
  arrayWrite32LE textLayout.TotalBssSize ' VirtualSize
  arrayWrite32LE bssRVA ' VirtualAddress
  arrayWrite32LE 0 ' SizeOfRawData
  arrayWrite32LE 0 ' PointerToRawData
  arrayWrite32LE 0 ' PointerToRelocations
  arrayWrite32LE 0 ' PointerToLinenumbers
  arrayWrite16LE 0 ' NumberOfRelocations
  arrayWrite16LE 0 ' NumberOfLinenumbers
  arrayWrite32LE &HC0000080 ' Characteristics: uninitialized data, read, write

  '''' Pad to file offset (.text raw data start)
  arrayPadUpTo PE_FILE_HEADER_OFFSET, 0

END SUB ' writePEHeader

