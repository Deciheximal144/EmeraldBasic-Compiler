  DIM funcIatCreatewindowexaIdx AS LONG
  DIM funcIatDefwindowprocaIdx AS LONG
  DIM funcIatDeletedcIdx AS LONG
  DIM funcIatDeleteobjectIdx AS LONG
  DIM funcIatDispatchmessageaIdx AS LONG
  DIM funcIatDwmsetwindowattributeIdx AS LONG
