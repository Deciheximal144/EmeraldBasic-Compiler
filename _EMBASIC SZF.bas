''''''''''''''''''''''''
SUB tiraCallShuntId (funcVal AS LONG, argCount AS LONG, baseArgIdx AS LONG)

  tiraCheckActive ("tiraCallShuntId")
  IF tiraLineCheckId THEN EXIT SUB

  IF argCount < 0 OR argCount > 16 THEN
    throwCompilerError "INVALID TIRA CALL ARG COUNT", ASIS, 0
    EXIT SUB
  END IF

  IF baseArgIdx < 0 OR baseArgIdx + argCount > MAX_SHUNT + 1 THEN
    throwCompilerError "INVALID TIRA CALL ARG RANGE", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_CALL

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_SYMBOL
  tiraNode(t.LineCount).Arg1Val = funcVal

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg2Val = argCount

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  IF argCount > 0 THEN
    FOR argIdx = 0 TO argCount - 1
      tiraCallArg(t.LineCount, argIdx).ArgType = shuntVal(baseArgIdx + argIdx).ArgType
      tiraCallArg(t.LineCount, argIdx).ArgVal = shuntVal(baseArgIdx + argIdx).ArgVal
    NEXT
  END IF

  t.LineCount = t.LineCount + 1

END SUB ' tiraCallShuntId

