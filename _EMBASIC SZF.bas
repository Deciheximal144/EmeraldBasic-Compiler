''''''''''''''''''''''''
FUNCTION findMatchingParen& (startIdx, endIdx)

  returnExtraPrepare

  DIM pDepth AS LONG
  DIM tVal AS LONG
  DIM ii AS LONG

  pDepth = 0

  FOR ii = startIdx TO endIdx
    tVal = lineTokenVals(ii)
    IF tVal = TOK_OP_LPAREN THEN pDepth = pDepth + 1
    IF tVal = TOK_OP_RPAREN THEN
      pDepth = pDepth - 1
      IF pDepth = 0 THEN
        return2 ii
        findMatchingParen = SUCCESS
        EXIT FUNCTION
      END IF
    END IF
  NEXT

  return2 0
  findMatchingParen = FAILURE

END FUNCTION ' findMatchingParen

