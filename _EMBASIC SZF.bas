  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraRT_PrologueId

''''''''''''''''''''''''
SUB tiraScheduleArrayFreeId (vIdx AS LONG)

  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM uIdx AS LONG
  DIM hasDynamicStrings AS LONG
  DIM curOff AS LONG
  DIM fixedLen AS LONG
  DIM descAddrIdx AS LONG
  DIM arrPtrIdx AS LONG
  DIM skipFreeLblIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM totalElemsIdx AS LONG
  DIM dimItrIdx AS LONG
  DIM lblDimTopIdx AS LONG
  DIM lblDimDoneIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM byteSizeIdx AS LONG
  DIM itrIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM descAddrStringIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM skipFreeDescLblIdx AS LONG
  DIM flagValIdx AS LONG
  DIM flagPtrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM emptyDescPtrIdx AS LONG
  DIM emptyDescGlobalIdx AS LONG
  DIM skipDescFreeLblIdx AS LONG

  tiraCheckActive ("tiraScheduleArrayFreeId")

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  arrPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId arrPtrIdx, TIRA_ARG_SYMBOL, descAddrIdx

  skipFreeLblIdx = tiraLabelCreateNewId&("SKIPFREEARY")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeLblIdx

  dt = symbols(vIdx).DataType
  hasDynamicStrings = 0
  elemSize = retElementByteSize(vIdx)

  SELECT CASE dt

    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex
      IF uIdx >= 0 THEN
        hasDynamicStrings = tiraWalkUdtDynamicStringsId(TA_EMPTY, 0, uIdx, 0)
        IF compileError = 1 THEN EXIT SUB
      END IF

    CASE TYPE_STRING
      fixedLen = retFixedStringLength(vIdx)
      IF fixedLen = 0 THEN
        hasDynamicStrings = 1
      END IF

  END SELECT ' dt

  IF hasDynamicStrings = 1 THEN
    numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

    totalElemsIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId totalElemsIdx, TIRA_ARG_LITERAL, 1

    dimItrIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId dimItrIdx, TIRA_ARG_LITERAL, 0
    lblDimTopIdx = tiraLabelCreateNewId&("DIM_TOP")
    lblDimDoneIdx = tiraLabelCreateNewId&("DIM_DONE")

    tiraLabelId lblDimTopIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, numDimsIdx, lblDimDoneIdx

    offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 8
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

    dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 4

    dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_SYMBOL, dimItrIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId lblDimTopIdx

    tiraLabelId lblDimDoneIdx

    byteSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteSizeIdx, TIRA_ARG_SYMBOL, totalElemsIdx, TIRA_ARG_LITERAL, elemSize

    itrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId itrIdx, TIRA_ARG_SYMBOL, arrPtrIdx

    endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, arrPtrIdx, TIRA_ARG_SYMBOL, byteSizeIdx

    loopTopIdx = tiraLabelCreateNewId&("FREELOOPARY")
    loopDoneIdx = tiraLabelCreateNewId&("FREEDONEARY")

    tiraLabelId loopTopIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, itrIdx, TIRA_ARG_SYMBOL, endPtrIdx, loopDoneIdx

    IF dt = TYPE_UDT THEN
      ff = tiraWalkUdtDynamicStringsId(TIRA_ARG_SYMBOL, itrIdx, uIdx, 1)
      IF compileError = 1 THEN EXIT SUB
    ELSE
      curOff = 0

      descAddrStringIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      IF curOff > 0 THEN
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descAddrStringIdx, TIRA_ARG_SYMBOL, itrIdx, TIRA_ARG_LITERAL, curOff
      ELSE
        tiraAssignId descAddrStringIdx, TIRA_ARG_SYMBOL, itrIdx
      END IF

      descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId descPtrIdx, TIRA_ARG_SYMBOL, descAddrStringIdx

      skipFreeDescLblIdx = tiraLabelCreateNewId&("SKIP_FREE_STR")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx

      flagValIdx = tiraDimVarId&("T", TYPE_LONG)
      flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 16
      tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

      tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeDescLblIdx

      dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId dataPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx

      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDescLblIdx

      ff = resolveSymbol("IAT_HEAPFREE")
      IF ff = 0 THEN EXIT SUB
      heapFreeIdx = returnedData2

      ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
      IF ff = 0 THEN EXIT SUB
      processHeapIdx = returnedData2

      tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, dataPtrIdx

      tiraLabelId skipFreeDescLblIdx

      ' Also free the dynamically allocated descriptor to prevent a 24-byte leak per element
      emptyDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      ff = resolveSymbol("!G_SYS_DSC_EMPTY")
      IF ff = 0 THEN EXIT SUB
      emptyDescGlobalIdx = returnedData2
      tiraAssignId emptyDescPtrIdx, TIRA_ARG_SYMBOL, emptyDescGlobalIdx

      skipDescFreeLblIdx = tiraLabelCreateNewId&("SKIP_STR_FREE")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, skipDescFreeLblIdx
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, emptyDescPtrIdx, skipDescFreeLblIdx
      tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, descPtrIdx
      tiraLabelId skipDescFreeLblIdx
    END IF

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, itrIdx, TIRA_ARG_SYMBOL, itrIdx, TIRA_ARG_LITERAL, elemSize
    tiraJmpId loopTopIdx

    tiraLabelId loopDoneIdx
  END IF

  IF symbols(vIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
    ff = resolveSymbol("IAT_HEAPFREE")
    IF ff = 0 THEN EXIT SUB
    heapFreeIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
    IF ff = 0 THEN EXIT SUB
    processHeapIdx = returnedData2

    tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, arrPtrIdx
  END IF

  tiraLabelId skipFreeLblIdx

END SUB ' tiraScheduleArrayFreeId

''''''''''''''''''''''''
FUNCTION tiraScheduleFuncOrArrayId (passOpTop AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleFuncOrArrayId")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM argCount AS LONG
  DIM argIdx AS LONG
  DIM resVarIdx AS LONG
  DIM targetType AS LONG
  DIM udtOffset AS LONG
  DIM baseArgIdx AS LONG
  DIM opVal AS LONG
  DIM castTargetType AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM argDt AS LONG
  DIM targetVarIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM srcArgIdx AS LONG
  DIM srcArgDt AS LONG
  DIM retVarIdx AS LONG
  DIM resType AS LONG
  DIM skipNullLblIdx AS LONG
  DIM finalAddrIdx AS LONG
  DIM srcIsComplex AS LONG
  DIM descPtrIdx AS LONG
  DIM isFixedArr AS LONG
  DIM fixedLen AS LONG
  DIM emptyDescIdx AS LONG
  DIM callSymbolLink AS LONG
  DIM callFuncIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM dataPtrIdx AS LONG

  DIM addrStageVarIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM stageAddrIdx AS LONG
  DIM descriptorDimCountIdx AS LONG
  DIM descriptorDimLowReadyIdx AS LONG
  DIM descriptorDimHighReadyIdx AS LONG
  DIM descriptorDimMatchReadyIdx AS LONG
  DIM descriptorByteSizeIdx AS LONG
  DIM tgtBaseAddrIdx AS LONG
  DIM castVarIdx AS LONG
  DIM tgtDescAddrIdx AS LONG
  DIM sizeModeType AS LONG
  DIM sizeModeVal AS _INTEGER64
  DIM callSymbolValid AS LONG

  IF passOpTop < 0 OR passOpTop > MAX_SHUNT THEN
    throwCompilerError "INVALID SHUNT OPERATOR INDEX", ASIS, 0
    tiraScheduleFuncOrArrayId = 0
    return2 localValTop
    EXIT FUNCTION
  END IF

  IF localValTop < 0 OR localValTop > MAX_SHUNT + 1 THEN
    throwCompilerError "INVALID SHUNT VALUE RANGE", ASIS, 0
    tiraScheduleFuncOrArrayId = 0
    return2 localValTop
    EXIT FUNCTION
  END IF

  opVal = shuntOp(passOpTop).OpCode
  argCount = shuntOp(passOpTop).ArgCount

  SELECT CASE opVal

    CASE SHUNT_CAST
      IF localValTop < 1 THEN
        throwCompilerError "MISSING CAST ARGUMENT", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      castTargetType = shuntOp(passOpTop).VIdx
      argType = shuntVal(localValTop - 1).ArgType
      argVal = shuntVal(localValTop - 1).ArgVal
      resVarIdx = tiraDimVarId&("T", castTargetType)
      tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, resVarIdx, argType, argVal, TIRA_ARG_LITERAL, castTargetType
      shuntVal(localValTop - 1).VarName = ""
      shuntVal(localValTop - 1).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop - 1).ArgVal = resVarIdx
      shuntVal(localValTop - 1).DataType = castTargetType
      shuntVal(localValTop - 1).VIdx = -1
      shuntVal(localValTop - 1).IsComplex = 1
      shuntVal(localValTop - 1).AddrType = TA_EMPTY
      shuntVal(localValTop - 1).AddrVal = 0
      tiraScheduleFuncOrArrayId = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_FUNC, SHUNT_SUB_CALL
      subIdx = shuntOp(passOpTop).VIdx

      IF subIdx <= 0 OR subIdx >= subCount THEN
        throwCompilerError "INVALID SUB INDEX IN FUNCTION EXPRESSION", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      IF argCount < 0 OR argCount > MAX_ROUTINE_ARGS OR argCount > localValTop THEN
        throwCompilerError "INVALID ARG RANGE FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      IF argCount <> subs(subIdx).ArgCount THEN
        throwCompilerError "INCORRECT ARG COUNT FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      callSymbolLink = routineSymbolIndex(subIdx)
      callSymbolValid = 0

      IF callSymbolLink > 0 AND callSymbolLink <= symbolCount THEN
        callFuncIdx = callSymbolLink - 1
        IF symbols(callFuncIdx).SubIndex = subIdx THEN callSymbolValid = 1
      END IF

      IF callSymbolValid = 0 THEN
        FOR callFuncIdx = 0 TO symbolCount - 1
          IF symbols(callFuncIdx).SubIndex = subIdx THEN
            routineSymbolIndex(subIdx) = callFuncIdx + 1
            callSymbolValid = 1
            EXIT FOR
          END IF
        NEXT
      END IF

      IF callSymbolValid = 0 THEN
        throwCompilerError "ROUTINE SYMBOL NOT FOUND FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      baseArgIdx = localValTop - argCount

      FOR argIdx = 0 TO argCount - 1
        formalVarIdx = subArgVarIdx(subIdx, argIdx)

        IF formalVarIdx <= 0 OR formalVarIdx >= symbolCount THEN
          throwCompilerError "INVALID FORMAL ARG SYMBOL FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
          tiraScheduleFuncOrArrayId = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        targetType = symbols(formalVarIdx).DataType
        argDt = shuntVal(baseArgIdx + argIdx).DataType

        IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
          ' Array checks are handled dynamically inside the DLL or internal loops below
        ELSE
          IF targetType = TYPE_STRING THEN
            IF argDt <> TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
          ELSE
            IF argDt = TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            IF targetType <> TYPE_ANY AND argDt <> targetType THEN
              IF targetType = TYPE_UDT OR argDt = TYPE_UDT THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF subs(subIdx).IsDll = 1 OR byValTracker(subIdx, argIdx).DeclareArg = 1 OR byValTracker(subIdx, argIdx).SubArg = 1 OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrType = TA_EMPTY) THEN
                ' Internal scalar arguments convert when stored in their typed staging variables
                IF subs(subIdx).IsDll = 1 THEN
                  castVarIdx = tiraDimVarId&("T", targetType)
                  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, castVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, TIRA_ARG_LITERAL, targetType
                  shuntVal(baseArgIdx + argIdx).ArgType = TIRA_ARG_SYMBOL
                  shuntVal(baseArgIdx + argIdx).ArgVal = castVarIdx
                END IF
                shuntVal(baseArgIdx + argIdx).VarName = ""
                shuntVal(baseArgIdx + argIdx).DataType = targetType
              END IF
            END IF
          END IF
        END IF
      NEXT

      IF subs(subIdx).IsDll = 1 THEN
        FOR argIdx = 0 TO argCount - 1
          targetVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(targetVarIdx).DataType

          IF symbols(targetVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx < 0 OR srcArgIdx >= symbolCount THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = ARRAY_TYPE_NONE THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(targetVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, 12

            descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
            tiraFatalErrorId "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimLowReadyIdx

            descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
            tiraFatalErrorId "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimHighReadyIdx

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(targetVarIdx).NumDimensions, descriptorDimMatchReadyIdx
              tiraFatalErrorId "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabelId descriptorDimMatchReadyIdx
            END IF
          ELSE
            IF targetType = TYPE_STRING THEN
              dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraReadMemId dataPtrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              shuntVal(baseArgIdx + argIdx).ArgType = TIRA_ARG_SYMBOL
              shuntVal(baseArgIdx + argIdx).ArgVal = dataPtrIdx
            END IF
          END IF
        NEXT

        tiraCallShuntId callFuncIdx, argCount, baseArgIdx

        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx

          IF retVarIdx <= 0 OR retVarIdx >= symbolCount THEN
            throwCompilerError "INVALID RETURN SYMBOL FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF

          resType = symbols(retVarIdx).DataType
          resVarIdx = tiraDimVarId&("T", resType)
          tiraGetRetId resVarIdx
        ELSE
          IF opVal = SHUNT_FUNC THEN
            resType = TYPE_LONG
            resVarIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
          END IF
        END IF
      ELSE
        FOR argIdx = 0 TO argCount - 1
          argDt = shuntVal(baseArgIdx + argIdx).DataType

          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(formalVarIdx).DataType
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF

          targetVarIdx = stageVarIdx

          IF cm.NoRef = 0 THEN
            IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrType <> TA_EMPTY) THEN
              addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
              IF addrStageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
                tiraAssignId addrStageVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              ELSE
                tiraAssignId addrStageVarIdx, shuntVal(baseArgIdx + argIdx).AddrType, shuntVal(baseArgIdx + argIdx).AddrVal
              END IF
            END IF
          END IF

          IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx < 0 OR srcArgIdx >= symbolCount THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = ARRAY_TYPE_NONE THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(formalVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            tgtDescAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtDescAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx

            ' Read the actual runtime dimension count from this argument descriptor
            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, 12

            descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
            tiraFatalErrorId "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimLowReadyIdx

            descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
            tiraFatalErrorId "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimHighReadyIdx

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(targetVarIdx).NumDimensions, descriptorDimMatchReadyIdx
              tiraFatalErrorId "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabelId descriptorDimMatchReadyIdx
            END IF

            ' Copy the complete source descriptor including every runtime dimension limit
            descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

            tiraMemcpyId TIRA_ARG_SYMBOL, tgtDescAddrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
          ELSE
            IF targetType = TYPE_UDT THEN
              tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx
              tiraCopyUdtValueId TIRA_ARG_SYMBOL, tgtBaseAddrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                ff = resolveSymbol("RT_STR_ASSIGN")
                IF ff = 0 THEN
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
                strAssignIdx = returnedData2
                tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, targetVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              ELSE
                tiraAssignId targetVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              END IF
            END IF
          END IF
        NEXT

        tiraCallId0 callFuncIdx

        ' Safely extract the return value from the hardware register BEFORE any pass-by-reference
        ' copy-out logic generates memory movements that could clobber the RAX/XMM0 registers
        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx

          IF retVarIdx <= 0 OR retVarIdx >= symbolCount THEN
            throwCompilerError "INVALID RETURN SYMBOL FOR " + RTRIM$(subs(subIdx).RecordName), ASIS, 0
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF

          resType = symbols(retVarIdx).DataType
          resVarIdx = tiraDimVarId&("T", resType)
          tiraGetRetId resVarIdx
        ELSE
          IF opVal = SHUNT_FUNC THEN
            resType = TYPE_LONG
            resVarIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
          END IF
        END IF

        ' Functions evaluated mid-expression were previously treated as pass-by-value
        ' The callee now writes invocation-local formal values back to the staging symbols before return
        IF cm.NoRef = 0 AND subs(subIdx).IsDll = 0 THEN
          FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
            IF byValTracker(subIdx, argIdx).SubArg = 0 THEN
              formalVarIdx = subArgVarIdx(subIdx, argIdx)
              stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
              IF stageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
                addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                IF addrStageVarIdx = 0 OR compileError = 1 THEN
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF

                stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx

                ' Copy the returned staging descriptor back into the caller's original array descriptor
                descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
                tiraReadMemOffsetId descriptorDimCountIdx, TIRA_ARG_SYMBOL, stageAddrIdx, 12

                descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
                tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
                tiraFatalErrorId "INVALID RETURNED ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabelId descriptorDimLowReadyIdx

                descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
                tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
                tiraFatalErrorId "RETURNED ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabelId descriptorDimHighReadyIdx

                IF symbols(formalVarIdx).NumDimensions > 0 THEN
                  descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
                  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(formalVarIdx).NumDimensions, descriptorDimMatchReadyIdx
                  tiraFatalErrorId "RETURNED ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
                  tiraLabelId descriptorDimMatchReadyIdx
                END IF

                descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
                tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
                tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

                tiraMemcpyId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
              ELSE
                srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
                srcIsComplex = shuntVal(baseArgIdx + argIdx).IsComplex
                IF srcArgIdx >= 0 AND srcArgIdx < symbolCount THEN
                  IF retByRefTypeCompatible(shuntVal(baseArgIdx + argIdx).DataType, symbols(formalVarIdx).DataType) = 1 THEN
                    IF srcIsComplex = 0 THEN
                      IF symbols(srcArgIdx).IsInternal = 0 THEN
                        tiraEmitPassByRefCopyOutId srcArgIdx, stageVarIdx
                      END IF
                    ELSE
                      IF shuntVal(baseArgIdx + argIdx).AddrType <> TA_EMPTY THEN
                        addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                        IF addrStageVarIdx = 0 OR compileError = 1 THEN
                          tiraScheduleFuncOrArrayId = 0
                          return2 localValTop
                          EXIT FUNCTION
                        END IF

                        IF symbols(formalVarIdx).DataType = TYPE_STRING THEN
                          ' Copy the modified dynamic string back into the original target
                          destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                          tiraReadMemId destDescPtrIdx, TIRA_ARG_SYMBOL, addrStageVarIdx

                          tiraEnsureStringAllocId destDescPtrIdx, TIRA_ARG_SYMBOL, addrStageVarIdx

                          ff = resolveSymbol("RT_STR_ASSIGN")
                          IF ff = 0 THEN
                            tiraScheduleFuncOrArrayId = 0
                            return2 localValTop
                            EXIT FUNCTION
                          END IF
                          strAssignIdx = returnedData2
                          tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, destDescPtrIdx, TIRA_ARG_SYMBOL, stageVarIdx
                        ELSE
                          IF symbols(formalVarIdx).DataType = TYPE_UDT THEN
                            tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx
                            tiraCopyUdtValueId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, symbols(formalVarIdx).UDTIndex
                          ELSE
                            argDt = shuntVal(baseArgIdx + argIdx).DataType

                            SELECT CASE argDt

                              CASE TYPE_BYTE, TYPE_UBYTE
                                sizeModeType = TIRA_ARG_LITERAL
                                sizeModeVal = 1

                              CASE TYPE_INTEGER, TYPE_UINTEGER
                                sizeModeType = TIRA_ARG_LITERAL
                                sizeModeVal = 2

                              CASE TYPE_LONG, TYPE_ULONG
                                sizeModeType = TIRA_ARG_LITERAL
                                sizeModeVal = 4

                              CASE TYPE_SINGLE
                                sizeModeType = TIRA_ARG_STR_LITERAL
                                sizeModeVal = 32

                              CASE TYPE_DOUBLE
                                sizeModeType = TIRA_ARG_STR_LITERAL
                                sizeModeVal = 64

                              CASE ELSE
                                sizeModeType = TIRA_ARG_LITERAL
                                sizeModeVal = 8

                            END SELECT ' argDt

                            tiraWriteMemId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, stageVarIdx, sizeModeType, sizeModeVal
                          END IF
                        END IF
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          NEXT
        END IF
      END IF

      localValTop = baseArgIdx

      IF opVal = SHUNT_SUB_CALL THEN
        tiraScheduleFuncOrArrayId = 1
        return2 localValTop
        EXIT FUNCTION
      END IF

      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = ""
      shuntVal(localValTop).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop).ArgVal = resVarIdx
      shuntVal(localValTop).DataType = resType
      shuntVal(localValTop).VIdx = -1
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrType = TA_EMPTY
      shuntVal(localValTop).AddrVal = 0
      localValTop = localValTop + 1

      tiraScheduleFuncOrArrayId = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_ARRAY
      vIdx = shuntOp(passOpTop).VIdx

      IF vIdx < 0 OR vIdx >= symbolCount THEN
        throwCompilerError "INVALID ARRAY SYMBOL INDEX", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      IF argCount < 0 OR argCount > 255 OR argCount > localValTop THEN
        throwCompilerError "INVALID ARRAY ARG RANGE", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      targetType = shuntOp(passOpTop).TargetType
      udtOffset = shuntOp(passOpTop).UdtOffset
      tiraParsedAddrType = TA_EMPTY
      tiraParsedAddrVal = 0

      IF argCount = 0 THEN
        ' Passing entire array to a function evaluates to the memory pointer of its descriptor
        resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
        targetType = TYPE_INTEGER64
      ELSE
        FOR ii = 1 TO argCount
          argIdx = localValTop - argCount + ii - 1
          IF shuntVal(argIdx).VarName <> "" THEN
            tiraParsedArgType = shuntVal(argIdx).ArgType
            tiraParsedArgVal = shuntVal(argIdx).ArgVal
            IF shuntVal(argIdx).NumericLiteralHasDot = 1 THEN
              tiraParsedArgType = TIRA_ARG_LITERAL
              tiraParsedArgVal = INT(shuntVal(argIdx).NumericLiteralValue)
            END IF
          ELSE
            tiraForceIntId shuntVal(argIdx).ArgType, shuntVal(argIdx).ArgVal, shuntVal(argIdx).DataType
          END IF
          tiraParsedArrayArgType(ii) = tiraParsedArgType
          tiraParsedArrayArgVal(ii) = tiraParsedArgVal
        NEXT ii
        localValTop = localValTop - argCount

        IF symbols(vIdx).NumDimensions > 0 AND argCount <> symbols(vIdx).NumDimensions THEN
          throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
          tiraScheduleFuncOrArrayId = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        finalAddrIdx = tiraFrontendCalcAddressId&(vIdx, argCount, udtOffset)
        IF compileError = 1 THEN
          tiraScheduleFuncOrArrayId = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        tiraParsedAddrType = TIRA_ARG_SYMBOL
        tiraParsedAddrVal = finalAddrIdx

        resVarIdx = tiraDimVarId&("T", targetType)

        isFixedArr = 0
        IF targetType = TYPE_STRING AND shuntOp(passOpTop).HasField = 0 AND symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
          IF retFixedStringLength(vIdx) > 0 THEN isFixedArr = 1
        END IF

        IF targetType = TYPE_STRING AND ((shuntOp(passOpTop).HasField = 1 AND shuntOp(passOpTop).IsDynamic = 0) OR isFixedArr = 1) THEN
          ' Synthesize a dynamic descriptor representing the fixed data block from the array layout
          resVarIdx = tiraResolveHoistVarId&("FSTR", "_DSC")
          IF resVarIdx = 0 THEN
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF
          descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, resVarIdx
          IF isFixedArr = 1 THEN
            fixedLen = retFixedStringLength(vIdx)
            tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_LITERAL, 0
          ELSE
            tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, shuntOp(passOpTop).FieldSize, TIRA_ARG_LITERAL, 0
          END IF
        ELSE
          tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, finalAddrIdx

          IF targetType = TYPE_STRING THEN
            skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
            tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipNullLblIdx
            ff = resolveSymbol("!G_SYS_DSC_EMPTY")
            IF ff = 0 THEN
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            emptyDescIdx = returnedData2
            tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, emptyDescIdx
            tiraLabelId skipNullLblIdx
          END IF
        END IF
      END IF

      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = ""
      shuntVal(localValTop).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop).ArgVal = resVarIdx
      shuntVal(localValTop).DataType = targetType
      shuntVal(localValTop).VIdx = vIdx
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrType = tiraParsedAddrType
      shuntVal(localValTop).AddrVal = tiraParsedAddrVal
      localValTop = localValTop + 1

      return2 localValTop
      tiraScheduleFuncOrArrayId = 1
      EXIT FUNCTION

  END SELECT ' opVal

  tiraScheduleFuncOrArrayId = 0
  return2 localValTop

END FUNCTION ' tiraScheduleFuncOrArrayId

''''''''''''''''''''''''
SUB tiraScheduleGCId

  DIM dt AS LONG
  DIM uIdx AS LONG
  DIM hasDynamicStrings AS LONG
  DIM vIdx AS LONG
  DIM safeSymbolLimit AS LONG
  DIM scopeLink AS LONG
  DIM nextScopeLink AS LONG
  DIM scopeStopLink AS LONG
  DIM subIdx AS LONG
  DIM argIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM targetType AS LONG
  DIM isFormalArray AS LONG
  DIM recName$
  DIM isReturnVar AS LONG
  DIM formalAddrIdx AS LONG
  DIM stageAddrIdx AS LONG
  DIM descriptorDimCountIdx AS LONG
  DIM descriptorDimLowReadyLblIdx AS LONG
  DIM descriptorDimHighReadyLblIdx AS LONG
  DIM descriptorDimMatchReadyLblIdx AS LONG
  DIM descriptorByteSizeIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM flagValIdx AS LONG
  DIM flagPtrIdx AS LONG
  DIM skipFreeDataLblIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM basePtrIdx AS LONG

  tiraCheckActive ("tiraScheduleGCId")
  IF tiraLineCheckId THEN EXIT SUB

  subIdx = 0
  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN subIdx = returnedData2
  END IF

  ' Publish this invocation's final formal values before local strings and UDT fields are released
  IF cm.NoRef = 0 AND subIdx <> 0 THEN
    IF subs(subIdx).ArgCount > 0 THEN
      FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
        IF byValTracker(subIdx, argIdx).SubArg = 0 THEN
          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN EXIT SUB

          targetType = symbols(formalVarIdx).DataType

          IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
            formalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, formalVarIdx

            stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, formalVarIdx

            ' Copy the final formal array descriptor back into the call-boundary staging descriptor
            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, TIRA_ARG_SYMBOL, formalAddrIdx, 12

            descriptorDimLowReadyLblIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyLblIdx
            tiraFatalErrorId "INVALID FORMAL ARRAY DESCRIPTOR"
            tiraLabelId descriptorDimLowReadyLblIdx

            descriptorDimHighReadyLblIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyLblIdx
            tiraFatalErrorId "FORMAL ARRAY DESCRIPTOR DIMENSION LIMIT"
            tiraLabelId descriptorDimHighReadyLblIdx

            IF symbols(formalVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyLblIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(formalVarIdx).NumDimensions, descriptorDimMatchReadyLblIdx
              tiraFatalErrorId "FORMAL ARRAY DIMENSION MISMATCH"
              tiraLabelId descriptorDimMatchReadyLblIdx
            END IF

            descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

            tiraMemcpyId TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
          ELSE
            IF targetType = TYPE_UDT THEN
              formalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, formalVarIdx

              stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx

              tiraCopyUdtValueId TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, formalAddrIdx, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                ff = resolveSymbol("RT_STR_ASSIGN")
                IF ff = 0 THEN EXIT SUB
                strAssignIdx = returnedData2

                tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, stageVarIdx, TIRA_ARG_SYMBOL, formalVarIdx
              ELSE
                tiraAssignId stageVarIdx, TIRA_ARG_SYMBOL, formalVarIdx
              END IF
            END IF
          END IF
        END IF
      NEXT
    END IF
  END IF

  ' Cache the symbol count explicitly into a static limit variable, to prevent cross-pass desynchronization when evaluating temp limits
  ' Because the garbage collection pass generates new ephemeral TIRA variables
  ' and increments the global symbol count dynamically, caching this limit
  ' guarantees a rigid evaluation boundary and prevents infinite loops if
  ' this block is ever refactored into a DO WHILE structure

  syncSymbolHashIndex
  safeSymbolLimit = symbolCount

  IF insideSub > 0 AND currentScopeID > 0 AND currentScopeID <= MAX_SUBS THEN
    IF safeSymbolLimit > engineSymbolLimit THEN
      scopeLink = scopeSymbolHead(currentScopeID)
      scopeStopLink = scopeSymbolTail(currentScopeID)

      DO WHILE scopeLink > 0
        vIdx = scopeLink - 1
        nextScopeLink = scopeSymbolNext(vIdx)

        IF vIdx >= engineSymbolLimit AND vIdx < safeSymbolLimit THEN
          isReturnVar = 0
          IF subIdx <> 0 THEN
            IF subs(subIdx).IsFunction = 1 THEN
              IF vIdx = subs(subIdx).ReturnVarIdx THEN isReturnVar = 1
            END IF
          END IF

          IF isReturnVar = 0 THEN
            IF symbols(vIdx).IsGlobalInternal = 0 THEN
              IF symbols(vIdx).ScopeID = currentScopeID AND symbols(vIdx).IsLocal = LOCAL_STANDARD THEN
                IF symbols(vIdx).IsArray > ARRAY_TYPE_NONE THEN
                  isFormalArray = 0
                  IF subIdx <> 0 THEN
                    IF subs(subIdx).ArgCount > 0 THEN
                      FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
                        IF subArgVarIdx(subIdx, argIdx) = vIdx THEN
                          isFormalArray = 1
                          EXIT FOR
                        END IF
                      NEXT
                    END IF
                  END IF

                  IF isFormalArray = 0 THEN tiraScheduleArrayFreeId vIdx
                ELSE
                  dt = symbols(vIdx).DataType

                  IF dt = TYPE_STRING AND symbols(vIdx).IsTempInternal = 0 THEN
                    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                    tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, vIdx

                    flagValIdx = tiraDimVarId&("T", TYPE_LONG)
                    flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 16
                    tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

                    skipFreeDataLblIdx = tiraLabelCreateNewId&("SKIPDATA")
                    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeDataLblIdx

                    dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                    tiraReadMemId dataPtrIdx, TIRA_ARG_SYMBOL, descPtrIdx

                    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, skipFreeDataLblIdx

                    ff = resolveSymbol("IAT_HEAPFREE")
                    IF ff = 0 THEN EXIT SUB
                    heapFreeIdx = returnedData2

                    ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
                    IF ff = 0 THEN EXIT SUB
                    processHeapIdx = returnedData2

                    tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, dataPtrIdx

                    tiraLabelId skipFreeDataLblIdx

                  ELSE
                    IF dt = TYPE_UDT AND symbols(vIdx).IsTempInternal = 0 THEN
                      uIdx = symbols(vIdx).UDTIndex

                      IF uIdx = -1 THEN
                        recName$ = RTRIM$(symbols(vIdx).RecordName)
                        err1$ = "COMPILER FAIL: Missing UDTIndex for variable " + recName$ + " in tiraScheduleGCId"
                        err2$ = "vIdx: " + LTRIM$(STR$(vIdx)) + " | ScopeID: " + LTRIM$(STR$(symbols(vIdx).ScopeID)) + " | Sub: " + currentSubName$
                        ESCAPETEXT2 err1$, err2$
                        EXIT SUB
                      END IF

                      hasDynamicStrings = tiraWalkUdtDynamicStringsId(TA_EMPTY, 0, uIdx, 0)
                      IF compileError = 1 THEN EXIT SUB

                      IF hasDynamicStrings = 1 THEN
                        basePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, vIdx

                        ' Also free the dynamically allocated descriptor for the UDT string field
                        ff = tiraWalkUdtDynamicStringsId(TIRA_ARG_SYMBOL, basePtrIdx, uIdx, 1)
                        IF compileError = 1 THEN EXIT SUB
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF

        IF scopeLink = scopeStopLink THEN EXIT DO
        scopeLink = nextScopeLink
      LOOP
    END IF
  END IF

END SUB ' tiraScheduleGCId

''''''''''''''''''''''''
SUB tiraScheduleHeapResetId

  tiraCheckActive ("tiraScheduleHeapResetId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM spillHeadIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM tempStartIdx AS LONG
  DIM skipSpillLblIdx AS LONG
  DIM loopTopLblIdx AS LONG
  DIM prevPtrIdx AS LONG

  IF engineSymbolIds.IsReady <> 1 THEN
    tira_Cancel
    EXIT SUB
  END IF

  spillHeadIdx = engineSymbolIds.MemPtrSpillHead
  processHeapIdx = engineSymbolIds.MemPtrProcessHeap
  tempHeapIdx = internalTempHeapSymbolIdx
  tempStartIdx = engineSymbolIds.MemPtrTempStart

  ff = resolveSymbol("IAT_HEAPFREE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  heapFreeIdx = returnedData2

  skipSpillLblIdx = tiraLabelCreateNewId&("SKIP_SPILL")
  IF t.IsActive <> 1 THEN EXIT SUB
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 0, skipSpillLblIdx

  loopTopLblIdx = tiraLabelCreateNewId&("SPILL_LOOP")
  IF t.IsActive <> 1 THEN EXIT SUB
  tiraLabelId loopTopLblIdx

  prevPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  IF t.IsActive <> 1 THEN EXIT SUB
  tiraReadMemId prevPtrIdx, TIRA_ARG_SYMBOL, spillHeadIdx

  tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, spillHeadIdx

  tiraAssignId spillHeadIdx, TIRA_ARG_SYMBOL, prevPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 0, loopTopLblIdx

  tiraLabelId skipSpillLblIdx

  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, tempStartIdx

END SUB ' tiraScheduleHeapResetId

''''''''''''''''''''''''
FUNCTION tiraScheduleShuntingOpId (opVal AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleShuntingOpId")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM resType AS LONG
  DIM opCmd AS LONG
  DIM t1 AS LONG
  DIM t2 AS LONG
  DIM isPow2 AS LONG
  DIM isConstRHS AS LONG
  DIM shiftAmt AS LONG
  DIM valCheck AS _INTEGER64
  DIM rhsType AS LONG
  DIM rhsVal AS _INTEGER64
  DIM lhsType AS LONG
  DIM lhsVal AS _INTEGER64
  DIM resVarIdx AS LONG
  DIM divisionCastIdx AS LONG
  DIM condConst AS LONG
  DIM lblTrueIdx AS LONG
  DIM lblEndIdx AS LONG

  tiraCheckActive ("tiraScheduleShuntingOpId")

  ' Any operator produces a computed value, so an operand address cannot remain eligible for copy-out

  IF opVal = TOK_OP_UNARY_MINUS OR opVal = TOK_OP_UNARY_NOT THEN
    IF localValTop < 1 THEN
      throwCompilerError "MISSING OPERAND FOR UNARY", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    rhsType = shuntVal(localValTop - 1).ArgType
    rhsVal = shuntVal(localValTop - 1).ArgVal
    resType = shuntVal(localValTop - 1).DataType

    ' Keep signed LONG literals immediate when the negated result fits LONG
    IF opVal = TOK_OP_UNARY_MINUS AND rhsType = TIRA_ARG_LITERAL AND resType = TYPE_LONG THEN
      IF rhsVal >= -2147483647 AND rhsVal <= 2147483648 THEN
        rhsVal = -rhsVal
        shuntVal(localValTop - 1).VarName = ""
        shuntVal(localValTop - 1).ArgType = TIRA_ARG_LITERAL
        shuntVal(localValTop - 1).ArgVal = rhsVal
        shuntVal(localValTop - 1).DataType = resType
        shuntVal(localValTop - 1).VIdx = -1
        shuntVal(localValTop - 1).IsComplex = 1
        shuntVal(localValTop - 1).AddrType = TA_EMPTY
        shuntVal(localValTop - 1).AddrVal = 0
        return2 localValTop
        tiraScheduleShuntingOpId = 1
        EXIT FUNCTION
      END IF
    END IF

    resVarIdx = tiraDimVarId&("T", resType)

    IF opVal = TOK_OP_UNARY_MINUS THEN
      tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, rhsType, rhsVal
    ELSE
      tiraOpId2 TC_NOT, TIRA_ARG_SYMBOL, resVarIdx, rhsType, rhsVal
    END IF

    shuntVal(localValTop - 1).VarName = ""
    shuntVal(localValTop - 1).ArgType = TIRA_ARG_SYMBOL
    shuntVal(localValTop - 1).ArgVal = resVarIdx
    shuntVal(localValTop - 1).DataType = resType
    shuntVal(localValTop - 1).IsComplex = 1
    shuntVal(localValTop - 1).AddrType = TA_EMPTY
    shuntVal(localValTop - 1).AddrVal = 0

    return2 localValTop
    tiraScheduleShuntingOpId = 1
    EXIT FUNCTION
  END IF

  IF localValTop < 2 THEN
    throwCompilerError "MISSING OPERAND FOR BINARY", ASIS, 0
    tiraScheduleShuntingOpId = 0
    return2 localValTop
    EXIT FUNCTION
  END IF

  rhsType = shuntVal(localValTop - 1).ArgType
  rhsVal = shuntVal(localValTop - 1).ArgVal
  lhsType = shuntVal(localValTop - 2).ArgType
  lhsVal = shuntVal(localValTop - 2).ArgVal

  t1 = shuntVal(localValTop - 2).DataType
  t2 = shuntVal(localValTop - 1).DataType

  IF opVal = TOK_OP_EQUAL OR opVal = TOK_OP_LESS OR opVal = TOK_OP_GREATER OR opVal = TOK_OP_LESS_EQUAL OR opVal = TOK_OP_GREATER_EQUAL OR opVal = TOK_OP_NOT_EQUAL THEN
    IF t1 = TYPE_STRING AND t2 <> TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
    IF t1 <> TYPE_STRING AND t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    resType = TYPE_LONG
    resVarIdx = tiraDimVarId&("T", resType)

    condConst = JCC_JE

    SELECT CASE opVal

      CASE TOK_OP_EQUAL: condConst = JCC_JE
      CASE TOK_OP_LESS: condConst = JCC_JL
      CASE TOK_OP_GREATER: condConst = JCC_JG
      CASE TOK_OP_LESS_EQUAL: condConst = JCC_JLE
      CASE TOK_OP_GREATER_EQUAL: condConst = JCC_JGE
      CASE TOK_OP_NOT_EQUAL: condConst = JCC_JNE

    END SELECT ' opVal

    lblTrueIdx = tiraLabelCreateNewId&("REL_TRUE")
    lblEndIdx = tiraLabelCreateNewId&("REL_END")

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraJmpCondId condConst, lhsType, lhsVal, rhsType, rhsVal, lblTrueIdx
    tiraJmpId lblEndIdx

    tiraLabelId lblTrueIdx
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

    tiraLabelId lblEndIdx

    shuntVal(localValTop - 2).VarName = ""
    shuntVal(localValTop - 2).ArgType = TIRA_ARG_SYMBOL
    shuntVal(localValTop - 2).ArgVal = resVarIdx
    shuntVal(localValTop - 2).DataType = resType
    shuntVal(localValTop - 2).IsComplex = 1
    shuntVal(localValTop - 2).AddrType = TA_EMPTY
    shuntVal(localValTop - 2).AddrVal = 0
    localValTop = localValTop - 1

    return2 localValTop
    tiraScheduleShuntingOpId = 1
    EXIT FUNCTION
  END IF

  IF t1 = TYPE_STRING AND t2 = TYPE_STRING THEN
    IF opVal = TOK_OP_PLUS THEN
      resType = TYPE_STRING
      opCmd = TC_CONCAT
    ELSE
      throwCompilerError "INVALID STRING OP", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
  ELSE
    IF t1 = TYPE_STRING OR t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    SELECT CASE opVal

      CASE TOK_OP_IDIV
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE TOK_MOD
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE TOK_OP_POW
        resType = TYPE_DOUBLE

      CASE TOK_AND, TOK_OR, TOK_XOR, TOK_NOR, TOK_NAND, TOK_XNOR
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE ELSE
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64
        IF t1 = TYPE_SINGLE OR t2 = TYPE_SINGLE THEN resType = TYPE_SINGLE
        IF t1 = TYPE_DOUBLE OR t2 = TYPE_DOUBLE THEN resType = TYPE_DOUBLE
        IF opVal = TOK_OP_DIV THEN
          IF resType = TYPE_LONG THEN resType = TYPE_SINGLE
          IF resType = TYPE_INTEGER64 OR resType = TYPE_UINT64 THEN resType = TYPE_DOUBLE
        END IF

    END SELECT ' opVal

    SELECT CASE opVal

      CASE TOK_OP_PLUS: opCmd = TC_ADD
      CASE TOK_OP_MINUS: opCmd = TC_SUB
      CASE TOK_OP_MUL: opCmd = TC_MUL
      CASE TOK_OP_DIV: opCmd = TC_DIV
      CASE TOK_OP_IDIV: opCmd = TC_IDIV
      CASE TOK_MOD: opCmd = TC_MOD
      CASE TOK_OP_POW: opCmd = TC_POW
      CASE TOK_AND: opCmd = TC_AND
      CASE TOK_OR: opCmd = TC_OR
      CASE TOK_XOR: opCmd = TC_XOR
      CASE TOK_NOR: opCmd = TC_NOR
      CASE TOK_NAND: opCmd = TC_NAND
      CASE TOK_XNOR: opCmd = TC_XNOR

    END SELECT ' opVal

  END IF

  IF opCmd = TC_DIV AND resType = TYPE_DOUBLE THEN
    IF t1 <> TYPE_DOUBLE AND t2 <> TYPE_DOUBLE THEN
      divisionCastIdx = tiraDimVarId&("T", TYPE_DOUBLE)
      tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, divisionCastIdx, lhsType, lhsVal, TIRA_ARG_LITERAL, TYPE_DOUBLE
      lhsType = TIRA_ARG_SYMBOL
      lhsVal = divisionCastIdx
    END IF
  END IF

  ' Speed optimization, convert constant power of two multiplication into a bitwise left shift
  IF opCmd = TC_MUL THEN
    ' Do not attempt to bitwise shift float mathematics!
    IF resType <> TYPE_SINGLE AND resType <> TYPE_DOUBLE THEN
      isPow2 = 0
      isConstRHS = 0
      shiftAmt = 0

      ' Try RHS
      IF rhsType = TIRA_ARG_LITERAL THEN
        valCheck = rhsVal

        SELECT CASE valCheck

          CASE 2: shiftAmt = 1: isPow2 = 1: isConstRHS = 1
          CASE 4: shiftAmt = 2: isPow2 = 1: isConstRHS = 1
          CASE 8: shiftAmt = 3: isPow2 = 1: isConstRHS = 1
          CASE 16: shiftAmt = 4: isPow2 = 1: isConstRHS = 1
          CASE 32: shiftAmt = 5: isPow2 = 1: isConstRHS = 1
          CASE 64: shiftAmt = 6: isPow2 = 1: isConstRHS = 1
          CASE 128: shiftAmt = 7: isPow2 = 1: isConstRHS = 1
          CASE 256: shiftAmt = 8: isPow2 = 1: isConstRHS = 1
          CASE 512: shiftAmt = 9: isPow2 = 1: isConstRHS = 1
          CASE 1024: shiftAmt = 10: isPow2 = 1: isConstRHS = 1
          CASE 2048: shiftAmt = 11: isPow2 = 1: isConstRHS = 1
          CASE 4096: shiftAmt = 12: isPow2 = 1: isConstRHS = 1

        END SELECT ' valCheck

      END IF

      ' Check LHS if the RHS operand was not a constant power of two
      IF isPow2 = 0 THEN
        IF lhsType = TIRA_ARG_LITERAL THEN
          valCheck = lhsVal

          SELECT CASE valCheck

            CASE 2: shiftAmt = 1: isPow2 = 1
            CASE 4: shiftAmt = 2: isPow2 = 1
            CASE 8: shiftAmt = 3: isPow2 = 1
            CASE 16: shiftAmt = 4: isPow2 = 1
            CASE 32: shiftAmt = 5: isPow2 = 1
            CASE 64: shiftAmt = 6: isPow2 = 1
            CASE 128: shiftAmt = 7: isPow2 = 1
            CASE 256: shiftAmt = 8: isPow2 = 1
            CASE 512: shiftAmt = 9: isPow2 = 1
            CASE 1024: shiftAmt = 10: isPow2 = 1
            CASE 2048: shiftAmt = 11: isPow2 = 1
            CASE 4096: shiftAmt = 12: isPow2 = 1

          END SELECT ' valCheck

        END IF
      END IF

      IF isPow2 = 1 THEN
        opCmd = TC_SHL
        IF isConstRHS = 1 THEN
          rhsType = TIRA_ARG_LITERAL
          rhsVal = shiftAmt
        ELSE
          ' Swap so the variable is on the left
          lhsType = rhsType
          lhsVal = rhsVal
          rhsType = TIRA_ARG_LITERAL
          rhsVal = shiftAmt
        END IF
      END IF
    END IF
  END IF

  resVarIdx = tiraDimVarId&("T", resType)
  tiraOpId3 opCmd, TIRA_ARG_SYMBOL, resVarIdx, lhsType, lhsVal, rhsType, rhsVal

  shuntVal(localValTop - 2).VarName = ""
  shuntVal(localValTop - 2).ArgType = TIRA_ARG_SYMBOL
  shuntVal(localValTop - 2).ArgVal = resVarIdx
  shuntVal(localValTop - 2).DataType = resType
  shuntVal(localValTop - 2).IsComplex = 1
  shuntVal(localValTop - 2).AddrType = TA_EMPTY
  shuntVal(localValTop - 2).AddrVal = 0
  localValTop = localValTop - 1

  return2 localValTop
  tiraScheduleShuntingOpId = 1

END FUNCTION ' tiraScheduleShuntingOpId

''''''''''''''''''''''''
SUB tiraScheduleSubPrologueId

  tiraCheckActive "tiraScheduleSubPrologueId"
  IF tiraLineCheckId THEN EXIT SUB

  DIM subIdx AS LONG
  DIM totalFrame AS LONG
  DIM iSym AS LONG
  DIM safeSymbolLimit AS LONG
  DIM scopeLink AS LONG
  DIM nextScopeLink AS LONG
  DIM scopeStopLink AS LONG
  DIM fixedLen AS LONG
  DIM argIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM targetType AS LONG
  DIM retVarIdx AS LONG
  DIM heapSaveIdx AS LONG
  DIM tempStartIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM spillSaveIdx AS LONG
  DIM spillHeadIdx AS LONG
  DIM framePtrIdx AS LONG
  DIM emptyDescIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM dataAddrIdx AS LONG
  DIM formalAddrIdx AS LONG
  DIM stageAddrIdx AS LONG
  DIM descriptorDimCountIdx AS LONG
  DIM descriptorDimLowReadyIdx AS LONG
  DIM descriptorDimHighReadyIdx AS LONG
  DIM descriptorDimMatchReadyIdx AS LONG
  DIM descriptorByteSizeIdx AS LONG
  DIM strAssignIdx AS LONG

  totalFrame = stack.consoleFrameSize
  subIdx = 0
  strAssignIdx = -1

  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        subs(subIdx).ExitPatchList = 0 ' Initialize the Exit Patch List

        heapSaveName$ = "!T_PTR_HEAPSAVE_" + LTRIM$(STR$(subIdx))
        ff = resolveSymbol(heapSaveName$)
        IF ff = 0 THEN EXIT SUB
        heapSaveIdx = returnedData2
        symbols(heapSaveIdx).DataType = TYPE_INTEGER64

        spillSaveName$ = "!T_PTR_SPILLSAVE_" + LTRIM$(STR$(subIdx))
        ff = resolveSymbol(spillSaveName$)
        IF ff = 0 THEN EXIT SUB
        spillSaveIdx = returnedData2
        symbols(spillSaveIdx).DataType = TYPE_INTEGER64

        totalFrame = totalFrame + subs(subIdx).LocalFrameSize
      END IF
    END IF
  END IF

  framePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_ENTER_FRAME

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = totalFrame

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_SYMBOL
  tiraNode(t.LineCount).Arg2Val = framePtrIdx

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

  ' Zero out the local stack frame to prevent garbage data from causing issues
  tiraMemSetId TIRA_ARG_SYMBOL, framePtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, totalFrame

  tiraInitClassicImplicitArraysId currentScopeID
  IF compileError = 1 THEN EXIT SUB

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    ff = resolveSymbol("!G_MEM_PTR_TEMP_START")
    IF ff = 0 THEN EXIT SUB
    tempStartIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
    IF ff = 0 THEN EXIT SUB
    tempHeapIdx = returnedData2

    tiraAssignId heapSaveIdx, TIRA_ARG_SYMBOL, tempStartIdx
    tiraAssignId tempStartIdx, TIRA_ARG_SYMBOL, tempHeapIdx

    ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
    IF ff = 0 THEN EXIT SUB
    spillHeadIdx = returnedData2

    tiraAssignId spillSaveIdx, TIRA_ARG_SYMBOL, spillHeadIdx
    tiraAssignId spillHeadIdx, TIRA_ARG_LITERAL, 0

    ' Zero out the invocation-local return variable at the start of the function
    ' This prevents persistent state leakage between calls
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          IF retVarIdx <> 0 THEN
            IF symbols(retVarIdx).DataType = TYPE_STRING THEN
              ff = resolveSymbol("!G_SYS_DSC_EMPTY")
              IF ff = 0 THEN EXIT SUB
              emptyDescIdx = returnedData2
              tiraAssignId retVarIdx, TIRA_ARG_SYMBOL, emptyDescIdx
            ELSE
              tiraAssignId retVarIdx, TIRA_ARG_LITERAL, 0
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Initialize descriptors and buffers for local fixed-length strings
    IF symbolCount > 0 THEN
      syncSymbolHashIndex
      safeSymbolLimit = symbolCount

      IF currentScopeID >= 0 AND currentScopeID <= MAX_SUBS THEN
        scopeLink = scopeSymbolHead(currentScopeID)
        scopeStopLink = scopeSymbolTail(currentScopeID)

        DO WHILE scopeLink > 0
          iSym = scopeLink - 1
          nextScopeLink = scopeSymbolNext(iSym)

          IF iSym < safeSymbolLimit THEN
            IF symbols(iSym).ScopeID = currentScopeID AND symbols(iSym).IsLocal = LOCAL_STANDARD AND symbols(iSym).IsShared = 0 THEN
              IF symbols(iSym).DataType = TYPE_STRING AND symbols(iSym).IsArray = ARRAY_TYPE_NONE THEN
                fixedLen = retFixedStringLength(iSym)
                IF fixedLen > 0 THEN
                  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, iSym

                  dataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_LITERAL, 24

                  tiraMemSetId TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, fixedLen

                  tiraBuildStrDescId TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, dataAddrIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_LITERAL, 0
                END IF
              END IF
            END IF
          END IF

          IF scopeLink = scopeStopLink THEN EXIT DO
          scopeLink = nextScopeLink
        LOOP
      END IF
    END IF

    ' Copy the call-boundary staging values into this invocation's local parameter slots
    IF subIdx <> 0 THEN
      IF subs(subIdx).ArgCount > 0 THEN
        FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN EXIT SUB

          targetType = symbols(formalVarIdx).DataType

          IF symbols(formalVarIdx).IsArray = ARRAY_TYPE_RUNTIME THEN
            formalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, formalVarIdx

            stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx

            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, TIRA_ARG_SYMBOL, stageAddrIdx, 12

            descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
            tiraFatalErrorId "INVALID STAGED ARRAY DESCRIPTOR"
            tiraLabelId descriptorDimLowReadyIdx

            descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
            tiraFatalErrorId "STAGED ARRAY DESCRIPTOR DIMENSION LIMIT"
            tiraLabelId descriptorDimHighReadyIdx

            IF symbols(formalVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(formalVarIdx).NumDimensions, descriptorDimMatchReadyIdx
              tiraFatalErrorId "STAGED ARRAY DIMENSION MISMATCH"
              tiraLabelId descriptorDimMatchReadyIdx
            END IF

            descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

            tiraMemcpyId TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
          ELSE
            IF targetType = TYPE_UDT THEN
              formalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, formalVarIdx

              stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx

              tiraCopyUdtValueId TIRA_ARG_SYMBOL, formalAddrIdx, TIRA_ARG_SYMBOL, stageAddrIdx, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                IF strAssignIdx < 0 THEN
                  ff = resolveSymbol("RT_STR_ASSIGN")
                  IF ff = 0 THEN EXIT SUB
                  strAssignIdx = returnedData2
                END IF
                tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, formalVarIdx, TIRA_ARG_SYMBOL, stageVarIdx
              ELSE
                tiraAssignId formalVarIdx, TIRA_ARG_SYMBOL, stageVarIdx
              END IF
            END IF
          END IF
        NEXT
      END IF
    END IF
  END IF

END SUB ' tiraScheduleSubPrologueId

''''''''''''''''''''''''
SUB tiraScheduleSubEpilogueId

  tiraCheckActive ("tiraScheduleSubEpilogueId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM subIdx AS LONG
  DIM totalFrame AS LONG
  DIM expectedStackOffset AS LONG
  DIM msg1$
  DIM msg2$
  DIM retVarIdx AS LONG
  DIM targetType AS LONG
  DIM heapSaveIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM tempStartIdx AS LONG
  DIM spillSaveIdx AS LONG
  DIM spillHeadIdx AS LONG
  DIM localDescAddrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM safeDataPtrIdx AS LONG
  DIM flagValIdx AS LONG
  DIM flagPtrIdx AS LONG
  DIM skipFreeLblIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM safeDescPtrIdx AS LONG

  totalFrame = stack.consoleFrameSize
  subIdx = 0

  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        totalFrame = totalFrame + subs(subIdx).LocalFrameSize
      END IF
    END IF
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    expectedStackOffset = totalFrame + PE_STACK_FRAME_OVERHEAD

    IF stack.currentStackOffset <> expectedStackOffset THEN
      msg1$ = "FATAL: Lost routine frame before epilogue Actual=" + LTRIM$(STR$(stack.currentStackOffset)) + " Expected=" + LTRIM$(STR$(expectedStackOffset))
      msg2$ = "Routine=" + currentSubName$ + " Local=" + LTRIM$(STR$(subs(subIdx).LocalFrameSize)) + " Console=" + LTRIM$(STR$(stack.consoleFrameSize))
      ESCAPETEXT2 msg1$, msg2$
    END IF
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    ff = resolveSymbol("!T_PTR_HEAPSAVE_" + LTRIM$(STR$(subIdx)))
    IF ff = 0 THEN EXIT SUB
    heapSaveIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
    IF ff = 0 THEN EXIT SUB
    tempHeapIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_TEMP_START")
    IF ff = 0 THEN EXIT SUB
    tempStartIdx = returnedData2

    tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, tempStartIdx
    tiraAssignId tempStartIdx, TIRA_ARG_SYMBOL, heapSaveIdx

    ff = resolveSymbol("!T_PTR_SPILLSAVE_" + LTRIM$(STR$(subIdx)))
    IF ff = 0 THEN EXIT SUB
    spillSaveIdx = returnedData2

    ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
    IF ff = 0 THEN EXIT SUB
    spillHeadIdx = returnedData2

    tiraAssignId spillHeadIdx, TIRA_ARG_SYMBOL, spillSaveIdx
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    IF subs(subIdx).IsFunction = 1 THEN
      retVarIdx = subs(subIdx).ReturnVarIdx
      IF retVarIdx <> 0 THEN
        targetType = symbols(retVarIdx).DataType

        IF targetType = TYPE_STRING THEN
          localDescAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, localDescAddrIdx, TIRA_ARG_SYMBOL, retVarIdx

          strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, localDescAddrIdx)
          strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, localDescAddrIdx)

          safeDataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
          tiraMemcpyId TIRA_ARG_SYMBOL, safeDataPtrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx

          flagValIdx = tiraDimVarId&("T", TYPE_LONG)
          flagPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, flagPtrIdx, TIRA_ARG_SYMBOL, localDescAddrIdx, TIRA_ARG_LITERAL, 16
          tiraReadMemId flagValIdx, TIRA_ARG_SYMBOL, flagPtrIdx

          skipFreeLblIdx = tiraLabelCreateNewId&("EPI_SKIP_FREE")
          tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, flagValIdx, TIRA_ARG_LITERAL, 1, skipFreeLblIdx
          tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_LITERAL, 0, skipFreeLblIdx

          ff = resolveSymbol("IAT_HEAPFREE")
          IF ff = 0 THEN EXIT SUB
          heapFreeIdx = returnedData2

          ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
          IF ff = 0 THEN EXIT SUB
          processHeapIdx = returnedData2

          tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, strDataIdx
          tiraLabelId skipFreeLblIdx

          safeDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraAssignId safeDescPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
          tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, safeDescPtrIdx, TIRA_ARG_SYMBOL, safeDescPtrIdx, TIRA_ARG_LITERAL, 24
          tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, safeDescPtrIdx

          tiraBuildStrDescId TIRA_ARG_SYMBOL, safeDescPtrIdx, TIRA_ARG_SYMBOL, safeDataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

          tiraAbiWriteRetId safeDescPtrIdx
        ELSE
          tiraAbiWriteRetId retVarIdx
        END IF
      END IF
    END IF
  END IF

  IF tiraLineCheckId THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_LEAVE_FRAME

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = totalFrame

  tiraNode(t.LineCount).Arg2Type = TA_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

  tiraNode(t.LineCount).Arg3Type = TA_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TA_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraScheduleSubEpilogueId

''''''''''''''''''''''''
SUB tiraSeekFilePositionId (handleType AS LONG, handleVal AS _INTEGER64, fileModeType AS LONG, fileModeVal AS _INTEGER64, recordLenType AS LONG, recordLenVal AS _INTEGER64, positionType AS LONG, positionVal AS _INTEGER64)

  tiraCheckActive ("tiraSeekFilePositionId")
  IF tiraLineCheckId THEN EXIT SUB

  DIM position64Idx AS LONG
  DIM positionValidLblIdx AS LONG
  DIM seekOffsetIdx AS LONG
  DIM randomModeLblIdx AS LONG
  DIM seekReadyLblIdx AS LONG
  DIM recordLenValidLblIdx AS LONG
  DIM recordLen64Idx AS LONG
  DIM recordIndex64Idx AS LONG
  DIM seekOffsetNonNegativeLblIdx AS LONG
  DIM seekOffsetCheckIdx AS LONG
  DIM seekOffsetValidLblIdx AS LONG
  DIM seekHigh64Idx AS LONG
  DIM seekHighIdx AS LONG
  DIM seekHighPtrIdx AS LONG
  DIM seekLowIdx AS LONG
  DIM setFilePointerIdx AS LONG

  position64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, position64Idx, positionType, positionVal, TIRA_ARG_LITERAL, TYPE_INTEGER64

  positionValidLblIdx = tiraLabelCreateNewId&("FILE_POSITION_VALID")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, position64Idx, TIRA_ARG_LITERAL, 0, positionValidLblIdx
  tiraFatalErrorId "INVALID FILE POSITION"
  tiraLabelId positionValidLblIdx

  seekOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, seekOffsetIdx, TIRA_ARG_SYMBOL, position64Idx, TIRA_ARG_LITERAL, 1

  randomModeLblIdx = tiraLabelCreateNewId&("FILE_SEEK_RANDOM")
  seekReadyLblIdx = tiraLabelCreateNewId&("FILE_SEEK_READY")

  tiraJmpCondId JCC_JE, fileModeType, fileModeVal, TIRA_ARG_LITERAL, FS_MODE_RANDOM, randomModeLblIdx
  tiraJmpCondId JCC_JE, fileModeType, fileModeVal, TIRA_ARG_LITERAL, FS_MODE_BINARY, seekReadyLblIdx
  tiraFatalErrorId "BAD FILE MODE"

  tiraLabelId randomModeLblIdx

  recordLenValidLblIdx = tiraLabelCreateNewId&("FILE_RECORD_LENGTH_VALID")
  tiraJmpCondId JCC_JG, recordLenType, recordLenVal, TIRA_ARG_LITERAL, 0, recordLenValidLblIdx
  tiraFatalErrorId "INVALID RECORD LENGTH"
  tiraLabelId recordLenValidLblIdx

  recordLen64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, recordLen64Idx, recordLenType, recordLenVal, TIRA_ARG_LITERAL, TYPE_INTEGER64

  recordIndex64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId recordIndex64Idx, TIRA_ARG_SYMBOL, seekOffsetIdx

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, seekOffsetIdx, TIRA_ARG_SYMBOL, recordIndex64Idx, TIRA_ARG_SYMBOL, recordLen64Idx

  seekOffsetNonNegativeLblIdx = tiraLabelCreateNewId&("FILE_OFFSET_NONNEGATIVE")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, seekOffsetIdx, TIRA_ARG_LITERAL, 0, seekOffsetNonNegativeLblIdx
  tiraFatalErrorId "FILE POSITION TOO LARGE"
  tiraLabelId seekOffsetNonNegativeLblIdx

  seekOffsetValidLblIdx = tiraLabelCreateNewId&("FILE_OFFSET_VALID")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, recordIndex64Idx, TIRA_ARG_LITERAL, 0, seekOffsetValidLblIdx

  seekOffsetCheckIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, seekOffsetCheckIdx, TIRA_ARG_SYMBOL, seekOffsetIdx, TIRA_ARG_SYMBOL, recordLen64Idx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, seekOffsetCheckIdx, TIRA_ARG_SYMBOL, recordIndex64Idx, seekOffsetValidLblIdx
  tiraFatalErrorId "FILE POSITION TOO LARGE"

  tiraLabelId seekOffsetValidLblIdx
  tiraLabelId seekReadyLblIdx

  seekHigh64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId seekHigh64Idx, TIRA_ARG_SYMBOL, seekOffsetIdx
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, seekHigh64Idx, TIRA_ARG_SYMBOL, seekHigh64Idx, TIRA_ARG_LITERAL, 32

  seekHighIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, seekHighIdx, TIRA_ARG_SYMBOL, seekHigh64Idx, TIRA_ARG_LITERAL, TYPE_LONG

  seekHighPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, seekHighPtrIdx, TIRA_ARG_SYMBOL, seekHighIdx

  seekLowIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, seekLowIdx, TIRA_ARG_SYMBOL, seekOffsetIdx, TIRA_ARG_LITERAL, TYPE_LONG

  ff = resolveSymbol("IAT_SETFILEPOINTER")
  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  setFilePointerIdx = returnedData2

  tiraCallId4 setFilePointerIdx, handleType, handleVal, TIRA_ARG_SYMBOL, seekLowIdx, TIRA_ARG_SYMBOL, seekHighPtrIdx, TIRA_ARG_LITERAL, 0

END SUB ' tiraSeekFilePositionId

