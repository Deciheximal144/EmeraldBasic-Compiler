  DIM funcIatSleepIdx AS LONG
  DIM funcIatStretchbltIdx AS LONG
  DIM funcIatStretchdibitsIdx AS LONG
  DIM funcIatTextoutaIdx AS LONG
  DIM funcIatTranslatemessageIdx AS LONG
  DIM funcRtAutodisplayCheckIdx AS LONG
  DIM hBmpVarIdx AS LONG
  DIM hBrIdx AS LONG
  DIM hCursorIdx AS LONG
  DIM hdcVarIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM heightValIdx AS LONG
  DIM hFontVarIdx AS LONG
  DIM hInstanceIdx AS LONG
  DIM hwndVarIdx AS LONG
  DIM hwndVarSetupIdx AS LONG
  DIM isStationaryLblIdx AS LONG
  DIM kbdIndexIdx AS LONG
  DIM kbdIndexUpIdx AS LONG
  DIM kbdStateAddrIdx AS LONG
  DIM kbdStateAddrUpIdx AS LONG
  DIM lblClampMaxXIdx AS LONG
  DIM lblClampMaxYIdx AS LONG
  DIM lblClampMinXIdx AS LONG
  DIM lblClampMinYIdx AS LONG
