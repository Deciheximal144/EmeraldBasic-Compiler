' IN THEORY, THESE ARE FULLY CONVERTED TO THE NEW SYSTEM

SUB emitRuntimeAutodisplayCheck

  DIM curTickIdx AS LONG
  DIM displayPendingIdx AS LONG
  DIM displayTimerIdx AS LONG
  DIM pagingIdx AS LONG
  DIM destPageIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM skipDisplayILblIdx AS LONG
  DIM pagingDisplayLblIdx AS LONG
  DIM displayDoneLblIdx AS LONG
  DIM pendingBitsIdx AS LONG
  DIM diffTickIdx AS LONG
  DIM claimDisplayLblIdx AS LONG
  DIM observedBitsIdx AS LONG
  DIM clearedBitsIdx AS LONG
  DIM compareBitsIdx AS LONG

  rtOffset(RT_AUTODISPLAY_CHECK) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  ff = resolveSymbol("!G_GFX_FLG_DISPLAYI_PENDING")
  displayPendingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DISPLAYI_TIMER")
  displayTimerIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  pagingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  destPageIdx = returnedData2

  ff = resolveSymbol("IAT_GETTICKCOUNT")
  getTickCountIdx = returnedData2

  ff = resolveSymbol("RT_SWAP_BUFFERS")
  swapBuffersIdx = returnedData2

  skipDisplayILblIdx = tiraLabelCreateNewId&("SKIP_DISPLAYI")
  pagingDisplayLblIdx = tiraLabelCreateNewId&("PAGING_DISPLAY")
  displayDoneLblIdx = tiraLabelCreateNewId&("DISPLAY_DONE")

  ' Bit zero records whether the destination framebuffer has pixels waiting to be presented
  pendingBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipDisplayILblIdx

  ' Get Tick Count from Windows
  tiraCallId0 getTickCountIdx
  curTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId curTickIdx

  ' Calculate time elapsed since last refresh
  diffTickIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_SYMBOL, curTickIdx, TIRA_ARG_SYMBOL, displayTimerIdx

  ' If less than 16 milliseconds have passed, skip the redraw to enforce 60 FPS maximum
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, diffTickIdx, TIRA_ARG_LITERAL, 16, skipDisplayILblIdx

  ' Clear the dirty bit while preserving the full-circle warmup state
  claimDisplayLblIdx = tiraLabelCreateNewId&("CLAIM_DISPLAY")
  tiraLabelId claimDisplayLblIdx

  observedBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId observedBitsIdx, TIRA_ARG_SYMBOL, displayPendingIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pendingBitsIdx, TIRA_ARG_LITERAL, 0, skipDisplayILblIdx

  clearedBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, clearedBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, TIRA_ARG_LITERAL, -2

  compareBitsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId compareBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx
  tiraCmpxchgId TIRA_ARG_SYMBOL, displayPendingIdx, TIRA_ARG_SYMBOL, compareBitsIdx, TIRA_ARG_SYMBOL, clearedBitsIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, compareBitsIdx, TIRA_ARG_SYMBOL, observedBitsIdx, claimDisplayLblIdx

  ' Explicit SCREEN paging owns presentation until paging is reset
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, pagingDisplayLblIdx

  ' Trigger the buffer swap to push the backbuffer to the monitor
  tiraCallId0 swapBuffersIdx
  tiraJmpId displayDoneLblIdx

  tiraLabelId pagingDisplayLblIdx

  ' Refresh only when the destination is the selected visual page
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, destPageIdx

  tiraLabelId displayDoneLblIdx

  tiraAssignId displayTimerIdx, TIRA_ARG_SYMBOL, curTickIdx

  tiraLabelId skipDisplayILblIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeAutodisplayCheck

''''''''''''''''''''''''
SUB emitRuntimeAxis

  DIM arg1Idx AS LONG
  DIM resVarIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM calcLblIdx AS LONG
  DIM axis1LblIdx AS LONG
  DIM axis2LblIdx AS LONG
  DIM axis3LblIdx AS LONG
  DIM axis4LblIdx AS LONG
  DIM axis5LblIdx AS LONG
  DIM axis6LblIdx AS LONG
  DIM axisValIdx AS LONG
  DIM scaleValIdx AS LONG
  DIM axisSingleIdx AS LONG
  DIM gamepadValidIdx AS LONG
  DIM gamepadLXIdx AS LONG
  DIM gamepadLYIdx AS LONG
  DIM gamepadRXIdx AS LONG
  DIM gamepadRYIdx AS LONG
  DIM gamepadLTIdx AS LONG
  DIM gamepadRTIdx AS LONG

  rtOffset(RT_AXIS) = stream.emitPos

  ff = resolveSymbol("!G_INO_FLG_GAMEPAD_VALID")
  IF ff = 0 THEN EXIT SUB
  gamepadValidIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LX")
  IF ff = 0 THEN EXIT SUB
  gamepadLXIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LY")
  IF ff = 0 THEN EXIT SUB
  gamepadLYIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RX")
  IF ff = 0 THEN EXIT SUB
  gamepadRXIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RY")
  IF ff = 0 THEN EXIT SUB
  gamepadRYIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_LT")
  IF ff = 0 THEN EXIT SUB
  gamepadLTIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_RT")
  IF ff = 0 THEN EXIT SUB
  gamepadRTIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1Idx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1Idx, 1

  ' For now we will return 0 as a placeholder stub
  resVarIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  doneLblIdx = tiraLabelCreateNewId&("AXIS_DONE")
  calcLblIdx = tiraLabelCreateNewId&("AXIS_CALC")
  axis1LblIdx = tiraLabelCreateNewId&("AXIS_1")
  axis2LblIdx = tiraLabelCreateNewId&("AXIS_2")
  axis3LblIdx = tiraLabelCreateNewId&("AXIS_3")
  axis4LblIdx = tiraLabelCreateNewId&("AXIS_4")
  axis5LblIdx = tiraLabelCreateNewId&("AXIS_5")
  axis6LblIdx = tiraLabelCreateNewId&("AXIS_6")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gamepadValidIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 1, axis1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 2, axis2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 3, axis3LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 4, axis4LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 5, axis5LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 6, axis6LblIdx
  tiraJmpId doneLblIdx

  axisValIdx = tiraDimVarId&("T", TYPE_LONG)
  scaleValIdx = tiraDimVarId&("T", TYPE_SINGLE)

  tiraLabelId axis1LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadLXIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis2LblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, gamepadLYIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis3LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadRXIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis4LblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, gamepadRYIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId calcLblIdx

  tiraLabelId axis5LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadLTIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 255
  tiraJmpId calcLblIdx

  tiraLabelId axis6LblIdx
  tiraAssignId axisValIdx, TIRA_ARG_SYMBOL, gamepadRTIdx
  tiraAssignId scaleValIdx, TIRA_ARG_LITERAL, 255

  tiraLabelId calcLblIdx
  axisSingleIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, axisSingleIdx, TIRA_ARG_SYMBOL, axisValIdx, TIRA_ARG_LITERAL, TYPE_SINGLE
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, axisSingleIdx, TIRA_ARG_SYMBOL, scaleValIdx

  tiraLabelId doneLblIdx
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeAxis

''''''''''''''''''''''''
SUB emitRuntimeBload

  DIM argFileDescIdx AS LONG
  DIM argOffsetIdx AS LONG
  DIM argHasOffsetIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM nullTermStrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM createFileIdx AS LONG
  DIM hFileIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM headerPtrIdx AS LONG
  DIM bytesReadIdx AS LONG
  DIM bytesReadPtrIdx AS LONG
  DIM readFileIdx AS LONG
  DIM lblCloseIdx AS LONG
  DIM firstByteIdx AS LONG
  DIM loadOffsetIdx AS LONG
  DIM offsetReadyLblIdx AS LONG
  DIM headerOffsetIdx AS LONG
  DIM loadPtrIdx AS LONG
  DIM directPtrLblIdx AS LONG
  DIM frameBufferIdx AS LONG
  DIM dataLength16Idx AS LONG
  DIM dataLengthIdx AS LONG
  DIM getFileSizeIdx AS LONG
  DIM fileSizeIdx AS LONG
  DIM skipLengthUpdateIdx AS LONG
  DIM closeHandleIdx AS LONG

  rtOffset(38) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  argFileDescIdx = tiraDimVarId&("FILE", TYPE_INTEGER64)
  tiraAbiReadArgId argFileDescIdx, 1

  argOffsetIdx = tiraDimVarId&("OFFSET", TYPE_INTEGER64)
  tiraAbiReadArgId argOffsetIdx, 2

  argHasOffsetIdx = tiraDimVarId&("HASOFFSET", TYPE_LONG)
  tiraAbiReadArgId argHasOffsetIdx, 3

  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFileDescIdx)
  strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFileDescIdx)

  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  nullTermStrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, allocSizeIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx

  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("IAT_CREATEFILEA")
  createFileIdx = returnedData2
  tiraCallId7 createFileIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_LITERAL, -2147483648, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 3, TIRA_ARG_LITERAL, 128, TIRA_ARG_LITERAL, 0
  hFileIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hFileIdx

  lblDoneIdx = tiraLabelCreateNewId&("BLOAD_DONE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, -1, lblDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  headerPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 7)
  bytesReadIdx = tiraDimVarId&("T", TYPE_LONG)
  bytesReadPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_SYMBOL, bytesReadIdx

  ff = resolveSymbol("IAT_READFILE")
  readFileIdx = returnedData2
  tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 7, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

  lblCloseIdx = tiraLabelCreateNewId&("BLOAD_CLOSE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, bytesReadIdx, TIRA_ARG_LITERAL, 7, lblCloseIdx

  firstByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId firstByteIdx, TIRA_ARG_SYMBOL, headerPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, firstByteIdx, TIRA_ARG_LITERAL, 253, lblCloseIdx

  loadOffsetIdx = tiraDimVarId&("LOADOFFSET", TYPE_INTEGER64)
  tiraAssignId loadOffsetIdx, TIRA_ARG_SYMBOL, argOffsetIdx

  offsetReadyLblIdx = tiraLabelCreateNewId&("BLOAD_OFFSET_READY")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, argHasOffsetIdx, TIRA_ARG_LITERAL, 0, offsetReadyLblIdx

  ' Use the stored legacy offset when the source omits the optional argument
  headerOffsetIdx = tiraDimVarId&("HEADEROFFSET", TYPE_UINTEGER)
  tiraReadMemOffsetId headerOffsetIdx, TIRA_ARG_SYMBOL, headerPtrIdx, 3
  tiraAssignId loadOffsetIdx, TIRA_ARG_SYMBOL, headerOffsetIdx

  tiraLabelId offsetReadyLblIdx

  loadPtrIdx = tiraDimVarId&("LOADPTR", TYPE_INTEGER64)
  tiraAssignId loadPtrIdx, TIRA_ARG_SYMBOL, loadOffsetIdx

  IF cm.HasGraphics = 1 THEN
    ' Low addresses are legacy offsets into the active framebuffer while VARPTR produces a real process address
    directPtrLblIdx = tiraLabelCreateNewId&("BLOAD_DIRECT_PTR")
    tiraJmpCondId JCC_JA, TIRA_ARG_SYMBOL, loadOffsetIdx, TIRA_ARG_LITERAL, 65535, directPtrLblIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    frameBufferIdx = returnedData2
    tiraAssignId loadPtrIdx, TIRA_ARG_SYMBOL, frameBufferIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, loadOffsetIdx
    tiraLabelId directPtrLblIdx
  END IF

  ' Use a 16-bit extraction to ensure we strictly capture the standard legacy length bounds
  dataLength16Idx = tiraDimVarId&("T", TYPE_INTEGER)
  tiraReadMemOffsetId dataLength16Idx, TIRA_ARG_SYMBOL, headerPtrIdx, 5

  dataLengthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId dataLengthIdx, TIRA_ARG_SYMBOL, dataLength16Idx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_LITERAL, 65535

  ff = resolveSymbol("IAT_GETFILESIZE")
  getFileSizeIdx = returnedData2
  tiraCallId2 getFileSizeIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0
  fileSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId fileSizeIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fileSizeIdx, TIRA_ARG_SYMBOL, fileSizeIdx, TIRA_ARG_LITERAL, 7

  skipLengthUpdateIdx = tiraLabelCreateNewId&("BLOAD_SKIP_LEN")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_LITERAL, 0, skipLengthUpdateIdx
  tiraAssignId dataLengthIdx, TIRA_ARG_SYMBOL, fileSizeIdx
  tiraLabelId skipLengthUpdateIdx

  tiraCallId5 readFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, loadPtrIdx, TIRA_ARG_SYMBOL, dataLengthIdx, TIRA_ARG_SYMBOL, bytesReadPtrIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId lblCloseIdx

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  closeHandleIdx = returnedData2
  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, hFileIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeBload

''''''''''''''''''''''''
SUB emitRuntimeBsave

  DIM argFileDescIdx AS LONG
  DIM argOffsetIdx AS LONG
  DIM argLengthIdx AS LONG
  DIM strLenIdx AS LONG
  DIM strDataIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM nullTermStrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM createFileIdx AS LONG
  DIM hFileIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM headerPtrIdx AS LONG
  DIM headerLenIdx AS LONG
  DIM skipLenClampIdx AS LONG
  DIM bytesWrittenIdx AS LONG
  DIM bytesWrittenPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM closeHandleIdx AS LONG

  rtOffset(39) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  argFileDescIdx = tiraDimVarId&("FILE", TYPE_INTEGER64)
  tiraAbiReadArgId argFileDescIdx, 1

  argOffsetIdx = tiraDimVarId&("OFFSET", TYPE_INTEGER64)
  tiraAbiReadArgId argOffsetIdx, 2

  argLengthIdx = tiraDimVarId&("LENGTH", TYPE_LONG)
  tiraAbiReadArgId argLengthIdx, 3

  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, argFileDescIdx)
  strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, argFileDescIdx)

  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  nullTermStrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, allocSizeIdx)

  tiraMemcpyId TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx

  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  ff = resolveSymbol("IAT_CREATEFILEA")
  createFileIdx = returnedData2
  tiraCallId7 createFileIdx, TIRA_ARG_SYMBOL, nullTermStrIdx, TIRA_ARG_LITERAL, 1073741824, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 2, TIRA_ARG_LITERAL, 128, TIRA_ARG_LITERAL, 0
  hFileIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hFileIdx

  lblDoneIdx = tiraLabelCreateNewId&("BSAVE_DONE")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, -1, lblDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx

  headerPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 7)
  tiraWriteMemId TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 253, TIRA_ARG_LITERAL, 1
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, headerPtrIdx, 1, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 4

  headerLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId headerLenIdx, TIRA_ARG_SYMBOL, argLengthIdx
  skipLenClampIdx = tiraLabelCreateNewId&("BSAVE_SKIP_CLAMP")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, headerLenIdx, TIRA_ARG_LITERAL, 65535, skipLenClampIdx
  tiraAssignId headerLenIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId skipLenClampIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, headerPtrIdx, 5, TIRA_ARG_SYMBOL, headerLenIdx, TIRA_ARG_LITERAL, 2

  bytesWrittenIdx = tiraDimVarId&("T", TYPE_LONG)
  bytesWrittenPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_SYMBOL, bytesWrittenIdx

  ff = resolveSymbol("IAT_WRITEFILE")
  writeFileIdx = returnedData2
  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, headerPtrIdx, TIRA_ARG_LITERAL, 7, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_LITERAL, 0
  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hFileIdx, TIRA_ARG_SYMBOL, argOffsetIdx, TIRA_ARG_SYMBOL, argLengthIdx, TIRA_ARG_SYMBOL, bytesWrittenPtrIdx, TIRA_ARG_LITERAL, 0

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  closeHandleIdx = returnedData2
  tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, hFileIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeBsave

''''''''''''''''''''''''
SUB emitRuntimeButton

  DIM arg1Idx AS LONG
  DIM resVarIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM checkLblIdx AS LONG
  DIM button1LblIdx AS LONG
  DIM button2LblIdx AS LONG
  DIM button3LblIdx AS LONG
  DIM button4LblIdx AS LONG
  DIM button5LblIdx AS LONG
  DIM button6LblIdx AS LONG
  DIM button7LblIdx AS LONG
  DIM button8LblIdx AS LONG
  DIM button9LblIdx AS LONG
  DIM button10LblIdx AS LONG
  DIM button11LblIdx AS LONG
  DIM button12LblIdx AS LONG
  DIM button13LblIdx AS LONG
  DIM button14LblIdx AS LONG
  DIM maskValIdx AS LONG
  DIM pressedValIdx AS LONG
  DIM gamepadValidIdx AS LONG
  DIM gamepadButtonsIdx AS LONG

  rtOffset(RT_BUTTON) = stream.emitPos

  ff = resolveSymbol("!G_INO_FLG_GAMEPAD_VALID")
  IF ff = 0 THEN EXIT SUB
  gamepadValidIdx = returnedData2

  ff = resolveSymbol("!G_INO_V32_GAMEPAD_BUTTONS")
  IF ff = 0 THEN EXIT SUB
  gamepadButtonsIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  arg1Idx = tiraDimVarId&("ARG1", TYPE_LONG)
  tiraAbiReadArgId arg1Idx, 1

  ' For now we will return 0 as a placeholder stub
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  doneLblIdx = tiraLabelCreateNewId&("BUTTON_DONE")
  checkLblIdx = tiraLabelCreateNewId&("BUTTON_CHECK")
  button1LblIdx = tiraLabelCreateNewId&("BUTTON_1")
  button2LblIdx = tiraLabelCreateNewId&("BUTTON_2")
  button3LblIdx = tiraLabelCreateNewId&("BUTTON_3")
  button4LblIdx = tiraLabelCreateNewId&("BUTTON_4")
  button5LblIdx = tiraLabelCreateNewId&("BUTTON_5")
  button6LblIdx = tiraLabelCreateNewId&("BUTTON_6")
  button7LblIdx = tiraLabelCreateNewId&("BUTTON_7")
  button8LblIdx = tiraLabelCreateNewId&("BUTTON_8")
  button9LblIdx = tiraLabelCreateNewId&("BUTTON_9")
  button10LblIdx = tiraLabelCreateNewId&("BUTTON_10")
  button11LblIdx = tiraLabelCreateNewId&("BUTTON_11")
  button12LblIdx = tiraLabelCreateNewId&("BUTTON_12")
  button13LblIdx = tiraLabelCreateNewId&("BUTTON_13")
  button14LblIdx = tiraLabelCreateNewId&("BUTTON_14")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gamepadValidIdx, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 1, button1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 2, button2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 3, button3LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 4, button4LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 5, button5LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 6, button6LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 7, button7LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 8, button8LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 9, button9LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 10, button10LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 11, button11LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 12, button12LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 13, button13LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, arg1Idx, TIRA_ARG_LITERAL, 14, button14LblIdx
  tiraJmpId doneLblIdx

  maskValIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraLabelId button1LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 16384
  tiraJmpId checkLblIdx

  tiraLabelId button2LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 8192
  tiraJmpId checkLblIdx

  tiraLabelId button3LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 4096
  tiraJmpId checkLblIdx

  tiraLabelId button4LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 32768
  tiraJmpId checkLblIdx

  tiraLabelId button5LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 256
  tiraJmpId checkLblIdx

  tiraLabelId button6LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 512
  tiraJmpId checkLblIdx

  tiraLabelId button7LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 64
  tiraJmpId checkLblIdx

  tiraLabelId button8LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 128
  tiraJmpId checkLblIdx

  tiraLabelId button9LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 32
  tiraJmpId checkLblIdx

  tiraLabelId button10LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 16
  tiraJmpId checkLblIdx

  tiraLabelId button11LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId checkLblIdx

  tiraLabelId button12LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 2
  tiraJmpId checkLblIdx

  tiraLabelId button13LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 4
  tiraJmpId checkLblIdx

  tiraLabelId button14LblIdx
  tiraAssignId maskValIdx, TIRA_ARG_LITERAL, 8

  tiraLabelId checkLblIdx
  pressedValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, pressedValIdx, TIRA_ARG_SYMBOL, gamepadButtonsIdx, TIRA_ARG_SYMBOL, maskValIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pressedValIdx, TIRA_ARG_LITERAL, 0, doneLblIdx
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

  tiraLabelId doneLblIdx
  tiraAbiWriteRetId resVarIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeButton

''''''''''''''''''''''''
SUB emitRuntimeClipboardGet

  DIM descPtrIdx AS LONG
  DIM lblFailIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM isFormatAvailableIdx AS LONG
  DIM availIdx AS LONG
  DIM openClipboardIdx AS LONG
  DIM resOpenIdx AS LONG
  DIM getClipboardDataIdx AS LONG
  DIM hMemIdx AS LONG
  DIM globalLockIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM lenVarIdx AS LONG
  DIM lblLenTopIdx AS LONG
  DIM lblLenDoneIdx AS LONG
  DIM checkAddrIdx AS LONG
  DIM byteValIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM globalUnlockIdx AS LONG
  DIM closeClipboardIdx AS LONG

  rtOffset(RT_GET_CLIPBOARD) = stream.emitPos

  ff = resolveSymbol("IAT_ISCLIPBOARDFORMATAVAILABLE")
  IF ff = 0 THEN EXIT SUB
  isFormatAvailableIdx = returnedData2

  ff = resolveSymbol("IAT_OPENCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  openClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_GETCLIPBOARDDATA")
  IF ff = 0 THEN EXIT SUB
  getClipboardDataIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALLOCK")
  IF ff = 0 THEN EXIT SUB
  globalLockIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  IF ff = 0 THEN EXIT SUB
  tempHeapIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALUNLOCK")
  IF ff = 0 THEN EXIT SUB
  globalUnlockIdx = returnedData2

  ff = resolveSymbol("IAT_CLOSECLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  closeClipboardIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  ' Retrieve pointer to the uninitialized descriptor struct requesting the copied string
  descPtrIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId descPtrIdx, 1

  lblFailIdx = tiraLabelCreateNewId&("CGET_FAIL")
  lblDoneIdx = tiraLabelCreateNewId&("CGET_DONE")

  ' Check if standard string text exists on the clipboard natively via IsClipboardFormatAvailable(CF_TEXT = 1)
  tiraCallId1 isFormatAvailableIdx, TIRA_ARG_LITERAL, 1
  availIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId availIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, availIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Request ownership of the clipboard hardware
  tiraCallId1 openClipboardIdx, TIRA_ARG_LITERAL, 0
  resOpenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resOpenIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, resOpenIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Retrieve Global Handle pointing to the clipboard's CF_TEXT memory
  tiraCallId1 getClipboardDataIdx, TIRA_ARG_LITERAL, 1
  hMemIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hMemIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hMemIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  ' Lock hardware memory temporarily to safely read the bytes
  tiraCallId1 globalLockIdx, TIRA_ARG_SYMBOL, hMemIdx
  srcPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId srcPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_LITERAL, 0, lblFailIdx

  lenVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId lenVarIdx, TIRA_ARG_LITERAL, 0
  lblLenTopIdx = tiraLabelCreateNewId&("CGET_LENTOP")
  lblLenDoneIdx = tiraLabelCreateNewId&("CGET_LENDONE")

  ' Execute a high-speed manual strlen iteration to identify exactly where the clipboard data stops
  tiraLabelId lblLenTopIdx
  checkAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, checkAddrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx
  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, checkAddrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 0, lblLenDoneIdx ' Stop exactly when the hardware null terminator is found
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLenTopIdx
  tiraLabelId lblLenDoneIdx

  ' Safely allocate destination buffer internally using Temp Heap methodology to prevent memory leaks
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, lenVarIdx
  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  ' Transfer clipboard data into localized execution memory
  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx

  tiraCallId1 globalUnlockIdx, TIRA_ARG_SYMBOL, hMemIdx

  tiraCallId0 closeClipboardIdx

  ' Tie the returned address back up to the source descriptor cleanly. Flag is 0 because the string lives on the Temp Heap.
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, lenVarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId lblDoneIdx

  tiraLabelId lblFailIdx

  ' If format missing or extraction fails, cleanly fall back and return an empty string safely to avoid crashing
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraCallId0 closeClipboardIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardGet

''''''''''''''''''''''''
SUB emitRuntimeClipboardSet

  DIM arg1VarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM lblEmptyIdx AS LONG
  DIM lblDoneIdx AS LONG
  DIM openClipboardIdx AS LONG
  DIM resOpenIdx AS LONG
  DIM emptyClipboardIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM globalAllocIdx AS LONG
  DIM hMemIdx AS LONG
  DIM globalLockIdx AS LONG
  DIM destPtrIdx AS LONG
  DIM nullPtrIdx AS LONG
  DIM globalUnlockIdx AS LONG
  DIM setClipboardDataIdx AS LONG
  DIM closeClipboardIdx AS LONG

  rtOffset(RT_SET_CLIPBOARD) = stream.emitPos

  ff = resolveSymbol("IAT_OPENCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  openClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_EMPTYCLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  emptyClipboardIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALALLOC")
  IF ff = 0 THEN EXIT SUB
  globalAllocIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALLOCK")
  IF ff = 0 THEN EXIT SUB
  globalLockIdx = returnedData2

  ff = resolveSymbol("IAT_GLOBALUNLOCK")
  IF ff = 0 THEN EXIT SUB
  globalUnlockIdx = returnedData2

  ff = resolveSymbol("IAT_SETCLIPBOARDDATA")
  IF ff = 0 THEN EXIT SUB
  setClipboardDataIdx = returnedData2

  ff = resolveSymbol("IAT_CLOSECLIPBOARD")
  IF ff = 0 THEN EXIT SUB
  closeClipboardIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  ' Read string descriptor argument directly from caller stack footprint
  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
  strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

  lblEmptyIdx = tiraLabelCreateNewId&("CLIP_EMPTY")
  lblDoneIdx = tiraLabelCreateNewId&("CLIP_DONE")

  ' Request ownership of the Clipboard hardware natively using parameter zero
  tiraCallId1 openClipboardIdx, TIRA_ARG_LITERAL, 0
  resOpenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId resOpenIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, resOpenIdx, TIRA_ARG_LITERAL, 0, lblDoneIdx ' Failed to open, gracefully abort

  ' We must successfully empty the clipboard before attempting to set new content
  tiraCallId0 emptyClipboardIdx

  ' If the length is empty, jump to the end where we close and return safely
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx

  ' Request Global Memory block ensuring we include space for the trailing null byte
  allocSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  ' GlobalAlloc(GMEM_MOVEABLE = 2, allocSize)
  tiraCallId2 globalAllocIdx, TIRA_ARG_LITERAL, 2, TIRA_ARG_SYMBOL, allocSizeIdx
  hMemIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId hMemIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, hMemIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx ' Alloc failed, exit cleanly

  ' Lock memory block to retrieve the physical pointer handle
  tiraCallId1 globalLockIdx, TIRA_ARG_SYMBOL, hMemIdx
  destPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId destPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_LITERAL, 0, lblEmptyIdx ' Lock failed, exit cleanly

  ' Clone string data into the globally allocated structure
  tiraMemcpyId TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  ' Inject null terminator physically at the end to satisfy Windows CF_TEXT ABI
  nullPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_SYMBOL, destPtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, nullPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

  tiraCallId1 globalUnlockIdx, TIRA_ARG_SYMBOL, hMemIdx

  ' Finalize data handoff to Windows via SetClipboardData(CF_TEXT = 1, hMem)
  tiraCallId2 setClipboardDataIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_SYMBOL, hMemIdx

  tiraLabelId lblEmptyIdx

  ' We must always release the clipboard so other programs do not get frozen
  tiraCallId0 closeClipboardIdx

  tiraLabelId lblDoneIdx

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeClipboardSet

''''''''''''''''''''''''
SUB emitRuntimeCrlf

  DIM textRowHeight AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM fallbackLblIdx AS LONG
  DIM manualLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBotIdx AS LONG
  DIM csbiIdx AS LONG
  DIM getConsoleScreenBufferInfoIdx AS LONG
  DIM coordVarIdx AS LONG
  DIM curYIdx AS LONG
  DIM botMinusOneIdx AS LONG
  DIM doScrollLblIdx AS LONG
  DIM destCoord1Idx AS LONG
  DIM setConsoleCursorPositionIdx AS LONG
  DIM scrollRectIdx AS LONG
  DIM topPlusOneIdx AS LONG
  DIM widthVarIdx AS LONG
  DIM destCoord2Idx AS LONG
  DIM charInfoIdx AS LONG
  DIM attrVarIdx AS LONG
  DIM scrollConsoleScreenBufferIdx AS LONG
  DIM destCoord3Idx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM widthFillIdx AS LONG
  DIM fillConsoleOutputCharacterIdx AS LONG
  DIM fillConsoleOutputAttributeIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM crlfDescIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtFBIdx AS LONG
  DIM numWrtFBPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM botYIdx AS LONG
  DIM topYIdx AS LONG
  DIM scrollLoopLblIdx AS LONG
  DIM noScreenScrollLblIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM viewStartOffsetIdx AS LONG
  DIM destFbIdx AS LONG
  DIM fbRowBytesIdx AS LONG
  DIM srcFbIdx AS LONG
  DIM fbShiftRowsIdx AS LONG
  DIM fbShiftCountIdx AS LONG
  DIM botRowPtrIdx AS LONG
  DIM lastBgIdx AS LONG

  rtOffset(RT_CRLF) = stream.emitPos

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  tira_Start
  tiraRT_PrologueId

  IF cm.HasGraphics = 0 THEN
    ' Console mode logic utilizing the rigorous scrolling APIs for VIEW PRINT

    ' Call Windows API to get the standard output handle
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    fallbackLblIdx = tiraLabelCreateNewId&("CRLF_FALL")
    manualLblIdx = tiraLabelCreateNewId&("CRLF_MAN")
    jmpDoneLblIdx = tiraLabelCreateNewId&("CRLF_DONE")

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    viewTopIdx = returnedData2
    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    viewBotIdx = returnedData2

    ' Fast bypass check for full screen bounds (no manual scroll computation required)
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 0, manualLblIdx
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_LITERAL, 25, manualLblIdx
    tiraJmpId fallbackLblIdx

    tiraLabelId manualLblIdx

    ' Extract the hardware console cursor row
    csbiIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
    ff = resolveSymbol("IAT_GETCONSOLESCREENBUFFERINFO")
    getConsoleScreenBufferInfoIdx = returnedData2
    tiraCallId2 getConsoleScreenBufferInfoIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, csbiIdx
    coordVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId coordVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 4
    curYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 16

    botMinusOneIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_LITERAL, 1

    doScrollLblIdx = tiraLabelCreateNewId&("CRLF_DOSCROLL")

    ' Check if we hit the limit of the specific viewport
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, botMinusOneIdx, doScrollLblIdx

    ' No scroll, advance cursor down cleanly
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 1
    destCoord1Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord1Idx, TIRA_ARG_SYMBOL, curYIdx, TIRA_ARG_LITERAL, 16
    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    setConsoleCursorPositionIdx = returnedData2
    tiraCallId2 setConsoleCursorPositionIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, destCoord1Idx
    tiraJmpId jmpDoneLblIdx

    tiraLabelId doScrollLblIdx

    ' Execute localized block scroll
    scrollRectIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 8)
    tiraWriteMemId TIRA_ARG_SYMBOL, scrollRectIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 2
    topPlusOneIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, topPlusOneIdx, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 2, TIRA_ARG_SYMBOL, topPlusOneIdx, TIRA_ARG_LITERAL, 2

    widthVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId widthVarIdx, TIRA_ARG_SYMBOL, csbiIdx
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 65535
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 4, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 2
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, scrollRectIdx, 6, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_LITERAL, 2

    destCoord2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord2Idx, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_LITERAL, 16

    charInfoIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)
    tiraWriteMemId TIRA_ARG_SYMBOL, charInfoIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 2
    attrVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId attrVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 8
    tiraWriteMemOffsetId TIRA_ARG_SYMBOL, charInfoIdx, 2, TIRA_ARG_SYMBOL, attrVarIdx, TIRA_ARG_LITERAL, 2

    ff = resolveSymbol("IAT_SCROLLCONSOLESCREENBUFFERA")
    scrollConsoleScreenBufferIdx = returnedData2
    tiraCallId5 scrollConsoleScreenBufferIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, scrollRectIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, destCoord2Idx, TIRA_ARG_SYMBOL, charInfoIdx

    ' Zero out the bottom row block completely empty
    destCoord3Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, botMinusOneIdx, TIRA_ARG_LITERAL, 16
    numWrtPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 4)

    widthFillIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, widthVarIdx, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("IAT_FILLCONSOLEOUTPUTCHARACTERA")
    fillConsoleOutputCharacterIdx = returnedData2
    tiraCallId5 fillConsoleOutputCharacterIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, numWrtPtrIdx

    ff = resolveSymbol("IAT_FILLCONSOLEOUTPUTATTRIBUTE")
    fillConsoleOutputAttributeIdx = returnedData2
    tiraCallId5 fillConsoleOutputAttributeIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, attrVarIdx, TIRA_ARG_SYMBOL, widthFillIdx, TIRA_ARG_SYMBOL, destCoord3Idx, TIRA_ARG_SYMBOL, numWrtPtrIdx

    tiraCallId2 setConsoleCursorPositionIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, destCoord3Idx
    tiraJmpId jmpDoneLblIdx

    tiraLabelId fallbackLblIdx
    ' Unrestricted hardware newline execution
    descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_INO_DSC_CRLF")
    crlfDescIdx = returnedData2
    tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, crlfDescIdx
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, descPtrIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, descPtrIdx)
    numWrtFBIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtFBPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtFBPtrIdx, TIRA_ARG_SYMBOL, numWrtFBIdx
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtFBPtrIdx, TIRA_ARG_LITERAL, 0

    tiraLabelId jmpDoneLblIdx
  ELSE
    ' Graphics mode newline logic
    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    fontHeightGlobalIdx = returnedData2
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("CRLF_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    textXIdx = returnedData2
    tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    textYIdx = returnedData2
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx

    ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
    viewBotIdx = returnedData2
    botYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId botYIdx, TIRA_ARG_SYMBOL, viewBotIdx

    ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
    viewTopIdx = returnedData2
    topYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId topYIdx, TIRA_ARG_SYMBOL, viewTopIdx

    scrollLoopLblIdx = tiraLabelCreateNewId&("CRLF_GFX_SCROLL")
    noScreenScrollLblIdx = tiraLabelCreateNewId&("CRLF_GFX_NOSCROLL")

    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, noScreenScrollLblIdx

    tiraLabelId scrollLoopLblIdx

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    destFrameIdx = returnedData2
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, destFrameIdx

    viewStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, topYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    destFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx

    fbRowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbRowBytesIdx, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    srcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

    fbShiftRowsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, botYIdx, TIRA_ARG_SYMBOL, topYIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

    fbShiftCountIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbShiftCountIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    tiraMemcpyId TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx

    botRowPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    lastBgIdx = returnedData2
    tiraMemSetId TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, lastBgIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, scrollLoopLblIdx

    tiraTriggerAutoDisplayId
    tiraInjectPendingDisplayFlushId

    tiraLabelId noScreenScrollLblIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeCrlf

''''''''''''''''''''''''
SUB emitRuntimeGDouble

  DIM gDoubleIdx AS LONG
  DIM screenWidthIdx AS LONG
  DIM screenHeightIdx AS LONG
  DIM hwndIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM fullscreenIdx AS LONG
  DIM setWindowLongIdx AS LONG
  DIM adjustWindowRectExIdx AS LONG
  DIM setWindowPosIdx AS LONG
  DIM clientWidthIdx AS LONG
  DIM clientHeightIdx AS LONG
  DIM rectLowIdx AS LONG
  DIM rectHighIdx AS LONG
  DIM rectPtrIdx AS LONG
  DIM rectLeftIdx AS LONG
  DIM rectTopIdx AS LONG
  DIM rectRightIdx AS LONG
  DIM rectBottomIdx AS LONG
  DIM outerWidthIdx AS LONG
  DIM outerHeightIdx AS LONG
  DIM widthCorrectionIdx AS LONG
  DIM heightCorrectionIdx AS LONG

  rtOffset(RT_GDOUBLE) = stream.emitPos

  ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
  IF ff = 0 THEN EXIT SUB
  gDoubleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNW")
  IF ff = 0 THEN EXIT SUB
  screenWidthIdx = returnedData2

  ff = resolveSymbol("!G_GFX_V32_SCRNH")
  IF ff = 0 THEN EXIT SUB
  screenHeightIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 0 THEN EXIT SUB
  hwndIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_WIDTH")
  IF ff = 0 THEN EXIT SUB
  windowWidthIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HEIGHT")
  IF ff = 0 THEN EXIT SUB
  windowHeightIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
  IF ff = 0 THEN EXIT SUB
  fullscreenIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWLONGA")
  IF ff = 0 THEN EXIT SUB
  setWindowLongIdx = returnedData2

  ff = resolveSymbol("IAT_ADJUSTWINDOWRECTEX")
  IF ff = 0 THEN EXIT SUB
  adjustWindowRectExIdx = returnedData2

  ff = resolveSymbol("IAT_SETWINDOWPOS")
  IF ff = 0 THEN EXIT SUB
  setWindowPosIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  tiraAssignId gDoubleIdx, TIRA_ARG_LITERAL, 1

  clientWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  clientHeightIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, screenWidthIdx, TIRA_ARG_LITERAL, 2
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, screenHeightIdx, TIRA_ARG_LITERAL, 2

  ' Two adjacent 64-bit temporaries provide the required 16-byte RECT for calculations
  rectLowIdx = tiraDimVarId&("GDRECTLOW", TYPE_INTEGER64)
  rectHighIdx = tiraDimVarId&("GDRECTHIGH", TYPE_INTEGER64)
  tiraAssignId rectLowIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId rectHighIdx, TIRA_ARG_LITERAL, 0

  rectPtrIdx = tiraDimVarId&("GDRECTPTR", TYPE_INTEGER64)
  ' Runtime locals grow downward, so the second temporary is the RECT base
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_SYMBOL, rectHighIdx

  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 8, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_LITERAL, 4
  tiraWriteMemOffsetId TIRA_ARG_SYMBOL, rectPtrIdx, 12, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_LITERAL, 4

  ' GDOUBLE always establishes a normal windowed 2x presentation
  tiraCallId3 setWindowLongIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -16, TIRA_ARG_LITERAL, 13565952

  ' Adjust the rect geometry to accommodate the target windowed bounds overlay (WS_OVERLAPPEDWINDOW)
  tiraCallId4 adjustWindowRectExIdx, TIRA_ARG_SYMBOL, rectPtrIdx, TIRA_ARG_LITERAL, 13565952, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  rectLeftIdx = tiraDimVarId&("GDRECTLEFT", TYPE_LONG)
  tiraReadMemId rectLeftIdx, TIRA_ARG_SYMBOL, rectPtrIdx

  rectTopIdx = tiraDimVarId&("GDRECTTOP", TYPE_LONG)
  tiraReadMemOffsetId rectTopIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 4

  rectRightIdx = tiraDimVarId&("GDRECTRIGHT", TYPE_LONG)
  tiraReadMemOffsetId rectRightIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 8

  rectBottomIdx = tiraDimVarId&("GDRECTBOTTOM", TYPE_LONG)
  tiraReadMemOffsetId rectBottomIdx, TIRA_ARG_SYMBOL, rectPtrIdx, 12

  outerWidthIdx = tiraDimVarId&("GDOUTERWIDTH", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, rectRightIdx, TIRA_ARG_SYMBOL, rectLeftIdx

  outerHeightIdx = tiraDimVarId&("GDOUTERHEIGHT", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, rectBottomIdx, TIRA_ARG_SYMBOL, rectTopIdx

  ' Request the actual scaling transition dynamically to process rendering changes
  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  ' Correct each outer dimension from the actual client size reported by WM_SIZE
  widthCorrectionIdx = tiraDimVarId&("GDWIDTHCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, widthCorrectionIdx, TIRA_ARG_SYMBOL, clientWidthIdx, TIRA_ARG_SYMBOL, windowWidthIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, widthCorrectionIdx

  heightCorrectionIdx = tiraDimVarId&("GDHEIGHTCORRECTION", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, heightCorrectionIdx, TIRA_ARG_SYMBOL, clientHeightIdx, TIRA_ARG_SYMBOL, windowHeightIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_SYMBOL, heightCorrectionIdx

  tiraCallId7 setWindowPosIdx, TIRA_ARG_SYMBOL, hwndIdx, TIRA_ARG_LITERAL, -2, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, outerWidthIdx, TIRA_ARG_SYMBOL, outerHeightIdx, TIRA_ARG_LITERAL, 98

  tiraAssignId fullscreenIdx, TIRA_ARG_LITERAL, 0

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeGDouble

''''''''''''''''''''''''
SUB emitRuntimeGfxAppend

  DIM textRowHeight AS LONG
  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM viewBottomIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM textYIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM lastBackgroundIdx AS LONG
  DIM textXIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM drawTextAbsoluteIdx AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM botYIdx AS LONG
  DIM topYIdx AS LONG
  DIM textPtrIdx AS LONG
  DIM textLeftIdx AS LONG
  DIM lblTextLoopIdx AS LONG
  DIM lblTextDoneIdx AS LONG
  DIM lblScrollLoopIdx AS LONG
  DIM lblNoScreenScrollIdx AS LONG
  DIM lblLineReadyIdx AS LONG
  DIM lblChunkReadyIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM viewStartOffsetIdx AS LONG
  DIM destFbIdx AS LONG
  DIM fbRowBytesIdx AS LONG
  DIM srcFbIdx AS LONG
  DIM fbShiftRowsIdx AS LONG
  DIM fbShiftCountIdx AS LONG
  DIM botRowPtrIdx AS LONG
  DIM pixelsLeftIdx AS LONG
  DIM charsFitIdx AS LONG
  DIM chunkLenIdx AS LONG
  DIM totalWidthIdx AS LONG

  rtOffset(RT_GFX_APPEND) = stream.emitPos

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_LONG)
  tiraAbiReadArgId arg2VarIdx, 2

  ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
  fontHeightGlobalIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
  viewBottomIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
  viewTopIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
  textYIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
  lastBackgroundIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_TEXT_X")
  textXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_FG")
  foregroundIdx = returnedData2

  ff = resolveSymbol("RT_DRAW_TEXT_ABSOLUTE")
  drawTextAbsoluteIdx = returnedData2

  fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

  fontHeightReadyLblIdx = tiraLabelCreateNewId&("GFX_FONT_READY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
  tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
  tiraLabelId fontHeightReadyLblIdx

  '''' Check if !G_GFX_VAL_CUR_Y >= Bottom Row
  botYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId botYIdx, TIRA_ARG_SYMBOL, viewBottomIdx

  topYIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId topYIdx, TIRA_ARG_SYMBOL, viewTopIdx

  textPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId textPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  textLeftIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId textLeftIdx, TIRA_ARG_SYMBOL, arg2VarIdx

  lblTextLoopIdx = tiraLabelCreateNewId&("GFX_TEXT_LOOP")
  lblTextDoneIdx = tiraLabelCreateNewId&("GFX_TEXT_DONE")
  lblScrollLoopIdx = tiraLabelCreateNewId&("SCROLL_LOOP")
  lblNoScreenScrollIdx = tiraLabelCreateNewId&("NO_SCREEN_SCROLL")
  lblLineReadyIdx = tiraLabelCreateNewId&("GFX_LINE_READY")
  lblChunkReadyIdx = tiraLabelCreateNewId&("GFX_CHUNK_READY")

  tiraLabelId lblTextLoopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_LITERAL, 0, lblTextDoneIdx

  tiraLabelId lblScrollLoopIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, botYIdx, lblNoScreenScrollIdx

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, destFrameIdx

  viewStartOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewStartOffsetIdx, TIRA_ARG_SYMBOL, topYIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  destFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, viewStartOffsetIdx

  fbRowBytesIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbRowBytesIdx, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  srcFbIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

  fbShiftRowsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, botYIdx, TIRA_ARG_SYMBOL, topYIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

  fbShiftCountIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fbShiftCountIdx, TIRA_ARG_SYMBOL, fbShiftRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX

  tiraMemcpyId TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, srcFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx

  botRowPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, destFbIdx, TIRA_ARG_SYMBOL, fbShiftCountIdx
  tiraMemSetId TIRA_ARG_SYMBOL, botRowPtrIdx, TIRA_ARG_SYMBOL, lastBackgroundIdx, TIRA_ARG_SYMBOL, fbRowBytesIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblScrollLoopIdx

  tiraLabelId lblNoScreenScrollIdx

  pixelsLeftIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, pixelsLeftIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX, TIRA_ARG_SYMBOL, textXIdx

  charsFitIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, charsFitIdx, TIRA_ARG_SYMBOL, pixelsLeftIdx, TIRA_ARG_LITERAL, 8

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, charsFitIdx, TIRA_ARG_LITERAL, 0, lblLineReadyIdx
  tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblTextLoopIdx

  tiraLabelId lblLineReadyIdx

  chunkLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId chunkLenIdx, TIRA_ARG_SYMBOL, textLeftIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_SYMBOL, charsFitIdx, lblChunkReadyIdx
  tiraAssignId chunkLenIdx, TIRA_ARG_SYMBOL, charsFitIdx
  tiraLabelId lblChunkReadyIdx

  '''' Render Text to Screen using the Absolute Text Helper
  tiraCallId5 drawTextAbsoluteIdx, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, foregroundIdx

  '''' Update Cursor X by 8 pixels per character
  totalWidthIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, totalWidthIdx, TIRA_ARG_SYMBOL, chunkLenIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, totalWidthIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, textPtrIdx, TIRA_ARG_SYMBOL, chunkLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_SYMBOL, chunkLenIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, textLeftIdx, TIRA_ARG_LITERAL, 0, lblTextDoneIdx

  tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
  tiraJmpId lblTextLoopIdx

  tiraLabelId lblTextDoneIdx

  '''' Redraw Graphic Viewport
  tiraTriggerAutoDisplayId
  tiraInjectPendingDisplayFlushId

  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeGfxAppend

''''''''''''''''''''''''
SUB emitRuntimeLine

  DIM pixelMask AS LONG
  DIM tmpXIdx AS LONG
  DIM tmpYIdx AS LONG
  DIM errVarIdx AS LONG
  DIM e2VarIdx AS LONG
  DIM tmpPtr1Idx AS LONG
  DIM tmpPtr2Idx AS LONG
  DIM x1Idx AS LONG
  DIM y1Idx AS LONG
  DIM x2Idx AS LONG
  DIM y2Idx AS LONG
  DIM colorIdx AS LONG
  DIM boxIdx AS LONG
  DIM styleIdx AS LONG
  DIM dxIdx AS LONG
  DIM dyIdx AS LONG
  DIM sxIdx AS LONG
  DIM syIdx AS LONG
  DIM plotPixelIdx AS LONG
  DIM lblNotBFIdx AS LONG
  DIM lblEndBFIdx AS LONG
  DIM lblSkipSwapXBFIdx AS LONG
  DIM lblSkipSwapYBFIdx AS LONG
  DIM lblLoopYBFIdx AS LONG
  DIM lblLoopXBFIdx AS LONG
  DIM lblEndXBFIdx AS LONG
  DIM lblEndLineIdx AS LONG
  DIM lblNotBIdx AS LONG
  DIM lblSkipSwapXBIdx AS LONG
  DIM lblSkipSwapYBIdx AS LONG
  DIM lblLoopH1Idx AS LONG
  DIM lblEndH1Idx AS LONG
  DIM lblLoopH2Idx AS LONG
  DIM lblEndH2Idx AS LONG
  DIM lblLoopV1Idx AS LONG
  DIM lblEndV1Idx AS LONG
  DIM lblLoopV2Idx AS LONG
  DIM lblEndV2Idx AS LONG
  DIM lblSkipNegDXIdx AS LONG
  DIM lblSkipNegDYIdx AS LONG
  DIM lblLoopLineIdx AS LONG
  DIM lblNotDoneIdx AS LONG
  DIM lblSkipDXIdx AS LONG
  DIM lblSkipDYIdx AS LONG

  pixelMask = 255

  SELECT CASE compileScreenMode

    CASE 1, 10
      pixelMask = 3

    CASE 2, 11
      pixelMask = 1

    CASE 7, 8, 9, 12
      pixelMask = 15

  END SELECT ' compileScreenMode

  '''' RT_LINE
  rtOffset(RT_LINE) = stream.emitPos

  ff = resolveSymbol("!G_GFX_VAL_X1")
  IF ff = 0 THEN EXIT SUB
  x1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y1")
  IF ff = 0 THEN EXIT SUB
  y1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_X2")
  IF ff = 0 THEN EXIT SUB
  x2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y2")
  IF ff = 0 THEN EXIT SUB
  y2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_COLOR")
  IF ff = 0 THEN EXIT SUB
  colorIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_BOXX")
  IF ff = 0 THEN EXIT SUB
  boxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_STYLE")
  IF ff = 0 THEN EXIT SUB
  styleIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DX")
  IF ff = 0 THEN EXIT SUB
  dxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DY")
  IF ff = 0 THEN EXIT SUB
  dyIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SX")
  IF ff = 0 THEN EXIT SUB
  sxIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SY")
  IF ff = 0 THEN EXIT SUB
  syIdx = returnedData2

  ff = resolveSymbol("RT_PLOT_PIXEL")
  IF ff = 0 THEN EXIT SUB
  plotPixelIdx = returnedData2

  tira_Start
  tiraRT_PrologueId

  tmpXIdx = tiraDimVarId&("T", TYPE_LONG)
  tmpYIdx = tiraDimVarId&("T", TYPE_LONG)
  errVarIdx = tiraDimVarId&("T", TYPE_LONG)
  e2VarIdx = tiraDimVarId&("T", TYPE_LONG)
  tmpPtr1Idx = tiraDimVarId&("T", TYPE_INTEGER64)
  tmpPtr2Idx = tiraDimVarId&("T", TYPE_INTEGER64)

  tiraAbiReadArgId x1Idx, 1
  tiraAbiReadArgId y1Idx, 2
  tiraAbiReadArgId x2Idx, 3
  tiraAbiReadArgId y2Idx, 4
  tiraAbiReadArgId colorIdx, 5
  tiraAbiReadArgId boxIdx, 6
  tiraAbiReadArgId styleIdx, 7

  ' Keep the line color inside the palette-index range for the selected screen mode
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, colorIdx, TIRA_ARG_SYMBOL, colorIdx, TIRA_ARG_LITERAL, pixelMask

  lblNotBFIdx = tiraLabelCreateNewId&("NOT_BF")
  lblEndBFIdx = tiraLabelCreateNewId&("END_BF")

  ' IF !G_GFX_FLG_BOXX != 2 GOTO NOT_BF
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, boxIdx, TIRA_ARG_LITERAL, 2, lblNotBFIdx

  ' Swap X if X1 > X2
  lblSkipSwapXBFIdx = tiraLabelCreateNewId&("SKIP_SWAP_X_BF")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblSkipSwapXBFIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, x1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, x2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapXBFIdx

  ' Swap Y if Y1 > Y2
  lblSkipSwapYBFIdx = tiraLabelCreateNewId&("SKIP_SWAP_Y_BF")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblSkipSwapYBFIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, y1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, y2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapYBFIdx

  ' Outer Loop (Y)
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopYBFIdx = tiraLabelCreateNewId&("LOOP_Y_BF")
  tiraLabelId lblLoopYBFIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndBFIdx

  ' Inner Loop (X)
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopXBFIdx = tiraLabelCreateNewId&("LOOP_X_BF")
  lblEndXBFIdx = tiraLabelCreateNewId&("END_X_BF")
  tiraLabelId lblLoopXBFIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndXBFIdx

  tiraCallId3 plotPixelIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, colorIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopXBFIdx
  tiraLabelId lblEndXBFIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopYBFIdx

  tiraLabelId lblEndBFIdx
  lblEndLineIdx = tiraLabelCreateNewId&("END_LINE")
  tiraJmpId lblEndLineIdx

  tiraLabelId lblNotBFIdx

  ' Box (B) Logic
  lblNotBIdx = tiraLabelCreateNewId&("NOT_B")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, boxIdx, TIRA_ARG_LITERAL, 1, lblNotBIdx

  ' Swap X if X1 > X2
  lblSkipSwapXBIdx = tiraLabelCreateNewId&("SKIP_SWAP_X_B")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblSkipSwapXBIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, x1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, x2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapXBIdx

  ' Swap Y if Y1 > Y2
  lblSkipSwapYBIdx = tiraLabelCreateNewId&("SKIP_SWAP_Y_B")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblSkipSwapYBIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, y1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_SYMBOL, y2Idx
  tiraSwapMemId TIRA_ARG_SYMBOL, tmpPtr1Idx, TIRA_ARG_SYMBOL, tmpPtr2Idx, TIRA_ARG_LITERAL, 8
  tiraLabelId lblSkipSwapYBIdx

  ' H1: Y=Y1, X=X1 to X2
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopH1Idx = tiraLabelCreateNewId&("LOOP_H1")
  lblEndH1Idx = tiraLabelCreateNewId&("END_H1")
  tiraLabelId lblLoopH1Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndH1Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, y1Idx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopH1Idx
  tiraLabelId lblEndH1Idx

  ' H2: Y=Y2, X=X1 to X2
  tiraAssignId tmpXIdx, TIRA_ARG_SYMBOL, x1Idx
  lblLoopH2Idx = tiraLabelCreateNewId&("LOOP_H2")
  lblEndH2Idx = tiraLabelCreateNewId&("END_H2")
  tiraLabelId lblLoopH2Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, x2Idx, lblEndH2Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, y2Idx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_SYMBOL, tmpXIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopH2Idx
  tiraLabelId lblEndH2Idx

  ' V1: X=X1, Y=Y1 to Y2
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopV1Idx = tiraLabelCreateNewId&("LOOP_V1")
  lblEndV1Idx = tiraLabelCreateNewId&("END_V1")
  tiraLabelId lblLoopV1Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndV1Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, tmpYIdx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopV1Idx
  tiraLabelId lblEndV1Idx

  ' V2: X=X2, Y=Y1 to Y2
  tiraAssignId tmpYIdx, TIRA_ARG_SYMBOL, y1Idx
  lblLoopV2Idx = tiraLabelCreateNewId&("LOOP_V2")
  lblEndV2Idx = tiraLabelCreateNewId&("END_V2")
  tiraLabelId lblLoopV2Idx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, y2Idx, lblEndV2Idx
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x2Idx, TIRA_ARG_SYMBOL, tmpYIdx, styleIdx, colorIdx, plotPixelIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_SYMBOL, tmpYIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId lblLoopV2Idx
  tiraLabelId lblEndV2Idx

  tiraJmpId lblEndLineIdx
  tiraLabelId lblNotBIdx

  ' Bresenham Line Logic
  ' dx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, x2Idx, TIRA_ARG_SYMBOL, x1Idx
  lblSkipNegDXIdx = tiraLabelCreateNewId&("SKIP_NEG_DX")
  tiraAssignId sxIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_LITERAL, 0, lblSkipNegDXIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, dxIdx
  tiraAssignId sxIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId lblSkipNegDXIdx

  ' dy
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, y2Idx, TIRA_ARG_SYMBOL, y1Idx
  lblSkipNegDYIdx = tiraLabelCreateNewId&("SKIP_NEG_DY")
  tiraAssignId syIdx, TIRA_ARG_LITERAL, 1
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_LITERAL, 0, lblSkipNegDYIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, dyIdx
  tiraAssignId syIdx, TIRA_ARG_LITERAL, -1
  tiraLabelId lblSkipNegDYIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, dyIdx, TIRA_ARG_SYMBOL, dyIdx

  ' err = dx + dy
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dxIdx, TIRA_ARG_SYMBOL, dyIdx

  lblLoopLineIdx = tiraLabelCreateNewId&("LOOP_LINE")
  tiraLabelId lblLoopLineIdx

  ' Plot
  tiraBuildStylePlotId TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, y1Idx, styleIdx, colorIdx, plotPixelIdx

  ' Check break
  lblNotDoneIdx = tiraLabelCreateNewId&("NOT_DONE")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x2Idx, lblNotDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y2Idx, lblEndLineIdx
  tiraLabelId lblNotDoneIdx

  ' e2 = err * 2
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_LITERAL, 2

  ' if e2 >= dy
  lblSkipDXIdx = tiraLabelCreateNewId&("SKIP_DX")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, dyIdx, lblSkipDXIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dyIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, x1Idx, TIRA_ARG_SYMBOL, sxIdx
  tiraLabelId lblSkipDXIdx

  ' if e2 <= dx
  lblSkipDYIdx = tiraLabelCreateNewId&("SKIP_DY")
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, e2VarIdx, TIRA_ARG_SYMBOL, dxIdx, lblSkipDYIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, errVarIdx, TIRA_ARG_SYMBOL, dxIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, y1Idx, TIRA_ARG_SYMBOL, syIdx
  tiraLabelId lblSkipDYIdx

  tiraJmpId lblLoopLineIdx

  tiraLabelId lblEndLineIdx

  tiraTriggerAutoDisplayId

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeLine

''''''''''''''''''''''''
SUB emitRuntimePrintFloat

  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM fmtPtrIdx AS LONG
  DIM sprintfIdx AS LONG
  DIM strLenIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_FLOAT) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_DOUBLE)
  tiraAbiReadArgId arg1VarIdx, 1

  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  ' Allocate 64 bytes on the temporary heap for the sprintf buffer natively
  basePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2
  tiraAssignId basePtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 64
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, basePtrIdx

  ' Read the pointer to the format string payload passed as arg 2
  fmtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId fmtPtrIdx, TIRA_ARG_SYMBOL, arg2VarIdx

  ' Call sprintf natively using TIRA. The backend will perfectly mirror the
  ' float variable into both XMM2 and R8 to satisfy the Windows Varargs ABI.
  ff = resolveSymbol("IAT_SPRINTF")
  sprintfIdx = returnedData2
  tiraCallId3 sprintfIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, fmtPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  ' Capture the return length from sprintf
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId strLenIdx

  IF cm.HasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary variable
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the float string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics output via GfxAppend
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintFloat

''''''''''''''''''''''''
SUB emitRuntimePrintInt

  DIM arg1VarIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM ptrIdx AS LONG
  DIM valVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipNegLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM skipDigitNegLblIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipSpaceLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM strLenIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_INT) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  ' Use !G_MEM_PTR_TEMP_HEAP as the high-end of our temporary string scratchpad.
  ' We do not permanently allocate it because the string is consumed instantly.
  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2
  tiraAssignId ptrIdx, TIRA_ARG_SYMBOL, tempHeapIdx

  valVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId valVarIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipNegLblIdx = tiraLabelCreateNewId&("PI_SKIP_NEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, skipNegLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipNegLblIdx

  ' Add the trailing space required by QB64 PRINT formatting FIRST (since we build backwards)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1

  loopTopIdx = tiraLabelCreateNewId&("PI_LOOP")
  tiraLabelId loopTopIdx

  ' digit = val MOD 10
  digitIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  skipDigitNegLblIdx = tiraLabelCreateNewId&("PI_SKIP_DNEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 0, skipDigitNegLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, digitIdx
  tiraLabelId skipDigitNegLblIdx

  ' char = digit + 48
  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48

  ' ptr = ptr - 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1

  ' Write byte to temporary string buffer
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' val = val / 10
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  ' Continue loop if val != 0
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  ' Add leading sign OR space for positive numbers required by QB64 PRINT formatting
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  skipSpaceLblIdx = tiraLabelCreateNewId&("PI_SKIP_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 45, TIRA_ARG_LITERAL, 1 ' 45 is '-'
  jmpDoneLblIdx = tiraLabelCreateNewId&("PI_DONE")
  tiraJmpId jmpDoneLblIdx
  tiraLabelId skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1 ' 32 is Space
  tiraLabelId jmpDoneLblIdx

  ' Calculate strLen = !G_MEM_PTR_TEMP_HEAP - ptr
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, tempHeapIdx, TIRA_ARG_SYMBOL, ptrIdx

  IF cm.HasGraphics = 0 THEN
    ' Console output via WriteFile
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary variable
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the integer string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics output via GfxAppend
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintInt

''''''''''''''''''''''''
SUB emitRuntimePrintStr

  DIM arg1VarIdx AS LONG
  DIM stdOutConstIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM strDataIdx AS LONG
  DIM strLenIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM gfxAppendIdx AS LONG

  rtOffset(RT_PRINT_STR) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  IF cm.HasGraphics = 0 THEN
    ' Use a strict TYPE_LONG variable to pass -11 to guarantee 32-bit parameter size
    stdOutConstIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId stdOutConstIdx, TIRA_ARG_LITERAL, -11

    ' Call Windows API to get the standard output handle
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_SYMBOL, stdOutConstIdx

    ' Retrieve the returned handle into a temporary varia5ble
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Read the memory address and length of the string data from the descriptor
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

    ' Provide a safe throwaway memory address for the bytes written output
    numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
    numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

    ' Write the string to the console
    ff = resolveSymbol("IAT_WRITEFILE")
    writeFileIdx = returnedData2
    tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0
  ELSE
    ' Graphics mode

    ' Read the memory address and length of the string data from the descriptor
    strDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

    ' Call RT_GFX_APPEND, pass data pointer and length
    ff = resolveSymbol("RT_GFX_APPEND")
    gfxAppendIdx = returnedData2
    tiraCallId2 gfxAppendIdx, TIRA_ARG_SYMBOL, strDataIdx, TIRA_ARG_SYMBOL, strLenIdx
  END IF

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimePrintStr

''''''''''''''''''''''''
SUB emitRuntimeSwapBuffers

  DIM renderLockIdx AS LONG
  DIM sleepFuncIdx AS LONG
  DIM spinLblIdx AS LONG
  DIM acquiredLblIdx AS LONG
  DIM spinValIdx AS LONG
  DIM frameSizeIdx AS LONG
  DIM textSizeIdx AS LONG
  DIM pagingFlagIdx AS LONG
  DIM frameFrontIdx AS LONG
  DIM frameDisplayIdx AS LONG
  DIM bufferFrontIdx AS LONG
  DIM bufferDisplayIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM bufferBackIdx AS LONG
  DIM bufferCountFrontIdx AS LONG
  DIM bufferCountBackIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM framePage1Idx AS LONG
  DIM bufferPage1Idx AS LONG
  DIM bufferCountPage1Idx AS LONG
  DIM framePage2Idx AS LONG
  DIM bufferPage2Idx AS LONG
  DIM bufferCountPage2Idx AS LONG
  DIM framePage3Idx AS LONG
  DIM bufferPage3Idx AS LONG
  DIM bufferCountPage3Idx AS LONG
  DIM pagingLblIdx AS LONG
  DIM visual0LblIdx AS LONG
  DIM visual1LblIdx AS LONG
  DIM visual2LblIdx AS LONG
  DIM visual3LblIdx AS LONG
  DIM presentationReadyLblIdx AS LONG
  DIM destPageIdx AS LONG
  DIM destFrameIdx AS LONG
  DIM destBufferIdx AS LONG
  DIM destCountIdx AS LONG
  DIM dest0LblIdx AS LONG
  DIM dest1LblIdx AS LONG
  DIM dest2LblIdx AS LONG
  DIM dest3LblIdx AS LONG
  DIM destEndLblIdx AS LONG
  DIM srcPageIdx AS LONG
  DIM srcFrameIdx AS LONG
  DIM srcBufferIdx AS LONG
  DIM srcCountIdx AS LONG
  DIM src0LblIdx AS LONG
  DIM src1LblIdx AS LONG
  DIM src2LblIdx AS LONG
  DIM src3LblIdx AS LONG
  DIM srcEndLblIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM invalidateRectIdx AS LONG
  DIM updateWindowIdx AS LONG

  rtOffset(RT_SWAP_BUFFERS) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
  renderLockIdx = returnedData2

  ff = resolveSymbol("IAT_SLEEP")
  sleepFuncIdx = returnedData2

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  pagingFlagIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_FRONT")
  frameFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_DISPLAY")
  frameDisplayIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_FRONT")
  bufferFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_DISPLAY")
  bufferDisplayIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
  frameBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_BACK")
  bufferBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
  bufferCountFrontIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
  bufferCountBackIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
  visualPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE1")
  framePage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE1")
  bufferPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
  bufferCountPage1Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE2")
  framePage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE2")
  bufferPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
  bufferCountPage2Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_FRMB_PAGE3")
  framePage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_BUFR_PAGE3")
  bufferPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
  bufferCountPage3Idx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_DEST_PAGE")
  destPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  destFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_BUFR")
  destBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_DEST_CNT")
  destCountIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_SRC_PAGE")
  srcPageIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_FRMB")
  srcFrameIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_BUFR")
  srcBufferIdx = returnedData2

  ff = resolveSymbol("!G_GFX_PTR_SRC_CNT")
  srcCountIdx = returnedData2

  ff = resolveSymbol("!G_WND_VAL_HWND")
  windowHandleIdx = returnedData2

  ff = resolveSymbol("IAT_INVALIDATERECT")
  invalidateRectIdx = returnedData2

  ff = resolveSymbol("IAT_UPDATEWINDOW")
  updateWindowIdx = returnedData2

  ' Acquire Spinlock safely using hardware XCHG
  spinLblIdx = tiraLabelCreateNewId&("SWAP_SPIN")
  acquiredLblIdx = tiraLabelCreateNewId&("SWAP_ACQ")
  tiraLabelId spinLblIdx
  spinValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId spinValIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_XCHG, TIRA_ARG_SYMBOL, renderLockIdx, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 4
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, spinValIdx, TIRA_ARG_LITERAL, 0, acquiredLblIdx
  tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId spinLblIdx
  tiraLabelId acquiredLblIdx

  ' Swap Pointers
  ' Stable logical pages replace pointer exchange during presentation
  frameSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId frameSizeIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY

  textSizeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId textSizeIdx, TIRA_ARG_LITERAL, GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize

  pagingLblIdx = tiraLabelCreateNewId&("SWAP_PAGING")
  visual0LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_0")
  visual1LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_1")
  visual2LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_2")
  visual3LblIdx = tiraLabelCreateNewId&("SWAP_VISUAL_3")
  presentationReadyLblIdx = tiraLabelCreateNewId&("SWAP_PRESENT_READY")

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, pagingFlagIdx, TIRA_ARG_LITERAL, 0, pagingLblIdx

  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameDisplayIdx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferDisplayIdx

  tiraMemcpyId TIRA_ARG_SYMBOL, frameDisplayIdx, TIRA_ARG_SYMBOL, frameBackIdx, TIRA_ARG_SYMBOL, frameSizeIdx
  tiraMemcpyId TIRA_ARG_SYMBOL, bufferDisplayIdx, TIRA_ARG_SYMBOL, bufferBackIdx, TIRA_ARG_SYMBOL, textSizeIdx

  ' Synchronize snapshot counts
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraAssignId visualPageIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId presentationReadyLblIdx

  tiraLabelId pagingLblIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 0, visual0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 1, visual1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 2, visual2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 3, visual3LblIdx
  tiraJmpId visual0LblIdx

  tiraLabelId visual0LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual1LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual2LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId presentationReadyLblIdx

  tiraLabelId visual3LblIdx
  tiraAssignId frameFrontIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId bufferFrontIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraAssignId bufferCountFrontIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId presentationReadyLblIdx

  ' Reconnect the selected _DEST page after the front and back pointers move
  ' Stable page pointers keep these mappings valid for both presentation paths
  dest0LblIdx = tiraLabelCreateNewId&("SWAP_DEST_0")
  dest1LblIdx = tiraLabelCreateNewId&("SWAP_DEST_1")
  dest2LblIdx = tiraLabelCreateNewId&("SWAP_DEST_2")
  dest3LblIdx = tiraLabelCreateNewId&("SWAP_DEST_3")
  destEndLblIdx = tiraLabelCreateNewId&("SWAP_DEST_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 0, dest0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 1, dest1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 2, dest2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, destPageIdx, TIRA_ARG_LITERAL, 3, dest3LblIdx
  tiraJmpId destEndLblIdx

  tiraLabelId dest0LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId destEndLblIdx

  tiraLabelId dest1LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId destEndLblIdx

  tiraLabelId dest2LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId destEndLblIdx

  tiraLabelId dest3LblIdx
  tiraAssignId destFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId destBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, destCountIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId destEndLblIdx

  ' Reconnect the selected _SOURCE page after the front and back pointers move
  ' Stable page pointers keep POINT and GET attached to the selected source page
  src0LblIdx = tiraLabelCreateNewId&("SWAP_SRC_0")
  src1LblIdx = tiraLabelCreateNewId&("SWAP_SRC_1")
  src2LblIdx = tiraLabelCreateNewId&("SWAP_SRC_2")
  src3LblIdx = tiraLabelCreateNewId&("SWAP_SRC_3")
  srcEndLblIdx = tiraLabelCreateNewId&("SWAP_SRC_END")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 0, src0LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 1, src1LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 2, src2LblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, srcPageIdx, TIRA_ARG_LITERAL, 3, src3LblIdx
  tiraJmpId srcEndLblIdx

  tiraLabelId src0LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, frameBackIdx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferBackIdx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountBackIdx
  tiraJmpId srcEndLblIdx

  tiraLabelId src1LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage1Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage1Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage1Idx
  tiraJmpId srcEndLblIdx

  tiraLabelId src2LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage2Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage2Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage2Idx
  tiraJmpId srcEndLblIdx

  tiraLabelId src3LblIdx
  tiraAssignId srcFrameIdx, TIRA_ARG_SYMBOL, framePage3Idx
  tiraAssignId srcBufferIdx, TIRA_ARG_SYMBOL, bufferPage3Idx
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcCountIdx, TIRA_ARG_SYMBOL, bufferCountPage3Idx

  tiraLabelId srcEndLblIdx

  ' Release Spinlock
  tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0

  ' Instruct Windows to repaint the window using the newly swapped Front buffer
  ' FRONT now identifies either the completed snapshot or the selected visual page
  tiraCallId3 invalidateRectIdx, TIRA_ARG_SYMBOL, windowHandleIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0

  ' Complete the pending paint before Page 1 can modify the Front buffer
  ' The selected visual page remains unchanged throughout the completed paint
  tiraCallId1 updateWindowIdx, TIRA_ARG_SYMBOL, windowHandleIdx

  ' Copy the new Front Buffer memory into the new Back Buffer memory to preserve
  ' persistence so the user thread continues drawing on top of existing graphics
  ' Stable logical buffers already retain this state without a restoration copy

  tiraRT_EpilogueId
  tira_EndAndProcess

END SUB ' emitRuntimeSwapBuffers

''''''''''''''''''''''''
SUB emitRuntimeStrCmp

  DIM arg1VarIdx AS LONG
  DIM arg2VarIdx AS LONG
  DIM lhsDataIdx AS LONG
  DIM lhsLenIdx AS LONG
  DIM rhsDataIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM skipMinLblIdx AS LONG
  DIM idxVarIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM lhsCharAddrIdx AS LONG
  DIM lhsByteIdx AS LONG
  DIM rhsCharAddrIdx AS LONG
  DIM rhsByteIdx AS LONG
  DIM charLessLblIdx AS LONG
  DIM charGrtrLblIdx AS LONG
  DIM lenLessLblIdx AS LONG
  DIM lenGrtrLblIdx AS LONG
  DIM endLblIdx AS LONG

  rtOffset(RT_STR_CMP) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1
  arg2VarIdx = tiraDimVarId&("ARG2", TYPE_INTEGER64)
  tiraAbiReadArgId arg2VarIdx, 2

  ' Extract LHS Data and Length
  lhsDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg1VarIdx)
  lhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg1VarIdx)

  ' Extract RHS Data and Length
  rhsDataIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, arg2VarIdx)
  rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, arg2VarIdx)

  ' Find Min Length to ensure safe memory scanning
  minLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, lhsLenIdx

  skipMinLblIdx = tiraLabelCreateNewId&("STRCMP_MIN")
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, skipMinLblIdx
  tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
  tiraLabelId skipMinLblIdx

  ' Setup Comparison Loop
  idxVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId idxVarIdx, TIRA_ARG_LITERAL, 0

  loopTopIdx = tiraLabelCreateNewId&("STRCMP_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("STRCMP_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_SYMBOL, minLenIdx, loopDoneIdx

  ' Read LHS Byte
  lhsCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, lhsCharAddrIdx, TIRA_ARG_SYMBOL, lhsDataIdx, TIRA_ARG_SYMBOL, idxVarIdx
  lhsByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId lhsByteIdx, TIRA_ARG_SYMBOL, lhsCharAddrIdx

  ' Read RHS Byte
  rhsCharAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rhsCharAddrIdx, TIRA_ARG_SYMBOL, rhsDataIdx, TIRA_ARG_SYMBOL, idxVarIdx
  rhsByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId rhsByteIdx, TIRA_ARG_SYMBOL, rhsCharAddrIdx

  ' Compare Bytes
  charLessLblIdx = tiraLabelCreateNewId&("STRCMP_CLESS")
  charGrtrLblIdx = tiraLabelCreateNewId&("STRCMP_CGRTR")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, lhsByteIdx, TIRA_ARG_SYMBOL, rhsByteIdx, charLessLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, lhsByteIdx, TIRA_ARG_SYMBOL, rhsByteIdx, charGrtrLblIdx

  ' Bytes match, increment index and evaluate next character
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_SYMBOL, idxVarIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  ' If we reached here, the strings match flawlessly up to minLen. Compare overall lengths
  lenLessLblIdx = tiraLabelCreateNewId&("STRCMP_LLESS")
  lenGrtrLblIdx = tiraLabelCreateNewId&("STRCMP_LGRTR")
  endLblIdx = tiraLabelCreateNewId&("STRCMP_END")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, lenLessLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, lhsLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx, lenGrtrLblIdx

  ' Lengths are equal. The string matches exactly.
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId endLblIdx

  ' LHS < RHS
  tiraLabelId lenLessLblIdx
  tiraLabelId charLessLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId endLblIdx

  ' LHS > RHS
  tiraLabelId lenGrtrLblIdx
  tiraLabelId charGrtrLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId endLblIdx

  ' Cleanly pass the evaluated return value back to the caller frame
  tiraAbiWriteRetId arg1VarIdx
  tiraRT_EpilogueId

  tira_EndAndProcess

END SUB ' emitRuntimeStrCmp

''''''''''''''''''''''''
SUB emitRuntimeVehHandler

  DIM arg1VarIdx AS LONG
  DIM curThreadIdx AS LONG
  DIM getCurrentThreadIdx AS LONG
  DIM wrongThreadLblIdx AS LONG
  DIM userThreadIdx AS LONG
  DIM excPtrIdx AS LONG
  DIM excRecPtrIdx AS LONG
  DIM excCodeIdx AS LONG
  DIM matchDivZeroLblIdx AS LONG
  DIM matchAccessLblIdx AS LONG
  DIM matchStackLblIdx AS LONG
  DIM prepareRestoreLblIdx AS LONG
  DIM endLblIdx AS LONG
  DIM targetRipIdx AS LONG
  DIM nativeDivZeroIdx AS LONG
  DIM nativeBoundsIdx AS LONG
  DIM nativeMemAccessIdx AS LONG
  DIM nativeStackIdx AS LONG
  DIM userHandlerIdx AS LONG
  DIM hasHandlerLblIdx AS LONG
  DIM ctxPtrAddrIdx AS LONG
  DIM ctxPtrIdx AS LONG
  DIM rspPtrIdx AS LONG
  DIM safeRspIdx AS LONG
  DIM rbpPtrIdx AS LONG
  DIM ripPtrIdx AS LONG
  DIM crashRipIdx AS LONG
  DIM lastErrorPtrIdx AS LONG

  '''' RT_VEH_HANDLER
  rtOffset(RT_VEH_HANDLER) = stream.emitPos

  tira_Start
  tiraRT_PrologueId

  arg1VarIdx = tiraDimVarId&("ARG1", TYPE_INTEGER64)
  tiraAbiReadArgId arg1VarIdx, 1

  ff = resolveSymbol("IAT_GETCURRENTTHREADID")
  getCurrentThreadIdx = returnedData2
  tiraCallId0 getCurrentThreadIdx
  curThreadIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId curThreadIdx

  wrongThreadLblIdx = tiraLabelCreateNewId&("VEH_WRONG_THREAD")
  ff = resolveSymbol("!G_SYS_VAL_USER_THREAD_ID")
  userThreadIdx = returnedData2
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, curThreadIdx, TIRA_ARG_SYMBOL, userThreadIdx, wrongThreadLblIdx

  excPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId excPtrIdx, TIRA_ARG_SYMBOL, arg1VarIdx

  ' Read ExceptionRecord pointer (offset 0)
  excRecPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId excRecPtrIdx, TIRA_ARG_SYMBOL, excPtrIdx

  ' Read ExceptionCode from the ExceptionRecord structure
  excCodeIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemId excCodeIdx, TIRA_ARG_SYMBOL, excRecPtrIdx

  matchDivZeroLblIdx = tiraLabelCreateNewId&("VEH_MATCH_DZ")
  matchAccessLblIdx = tiraLabelCreateNewId&("VEH_MATCH_AV")
  matchStackLblIdx = tiraLabelCreateNewId&("VEH_MATCH_SO")
  prepareRestoreLblIdx = tiraLabelCreateNewId&("VEH_PREP_RESTORE")
  endLblIdx = tiraLabelCreateNewId&("VEH_END")

  targetRipIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ' Check for integer divide by zero (0xC0000094 -> -1073741676)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741676, matchDivZeroLblIdx

  ' Check for float divide by zero (0xC000008E -> -1073741682)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741682, matchDivZeroLblIdx

  ' Check for Access Violation (0xC0000005 -> -1073741819)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741819, matchAccessLblIdx

  ' Check for Stack Overflow (0xC00000FD -> -1073741571)
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, excCodeIdx, TIRA_ARG_LITERAL, -1073741571, matchStackLblIdx

  ' Not a recognized exception, gracefully pass it back to Windows returning EXCEPTION_CONTINUE_SEARCH (0) in RAX
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0
  tiraJmpId endLblIdx

  tiraLabelId matchDivZeroLblIdx
  ff = resolveSymbol("@NATIVE_DIV_ZERO_HANDLER")
  nativeDivZeroIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeDivZeroIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId matchAccessLblIdx
  ff = resolveSymbol("@NATIVE_MEM_ACCESS_HANDLER")
  nativeMemAccessIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeMemAccessIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId matchStackLblIdx
  ff = resolveSymbol("@NATIVE_STACK_HANDLER")
  nativeStackIdx = returnedData2
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LABEL, nativeStackIdx
  tiraJmpId prepareRestoreLblIdx

  tiraLabelId prepareRestoreLblIdx

  ' Check for user handler override
  ff = resolveSymbol("!G_ERR_PTR_HANDLER")
  userHandlerIdx = returnedData2
  hasHandlerLblIdx = tiraLabelCreateNewId&("VEH_HAS_HDL")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, userHandlerIdx, TIRA_ARG_LITERAL, 0, hasHandlerLblIdx
  tiraAssignId targetRipIdx, TIRA_ARG_SYMBOL, userHandlerIdx
  tiraLabelId hasHandlerLblIdx

  ' Start modifying the CPU CONTEXT struct to safely route execution into our basic program space by reading ContextRecord pointer (offset 8)
  ctxPtrAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ctxPtrAddrIdx, TIRA_ARG_SYMBOL, excPtrIdx, TIRA_ARG_LITERAL, 8

  ctxPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId ctxPtrIdx, TIRA_ARG_SYMBOL, ctxPtrAddrIdx

  ' Navigate to Context.Rsp to reset the dirty execution stack (offset 152)
  rspPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rspPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 152
  ff = resolveSymbol("!G_SYS_PTR_SAFE_RSP")
  safeRspIdx = returnedData2
  tiraWriteMemId TIRA_ARG_SYMBOL, rspPtrIdx, TIRA_ARG_SYMBOL, safeRspIdx, TIRA_ARG_LITERAL, 8

  ' Write it into Context.Rbp to pull the base pointer out of any deep subroutine frames (offset 160)
  rbpPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, rbpPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 160
  tiraWriteMemId TIRA_ARG_SYMBOL, rbpPtrIdx, TIRA_ARG_SYMBOL, safeRspIdx, TIRA_ARG_LITERAL, 8

  ' Redirect the instruction pointer (offset 248)
  ripPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ripPtrIdx, TIRA_ARG_SYMBOL, ctxPtrIdx, TIRA_ARG_LITERAL, 248

  ' Save the crashing instruction address for the RESUME keyword
  crashRipIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId crashRipIdx, TIRA_ARG_SYMBOL, ripPtrIdx
  ff = resolveSymbol("!G_ERR_PTR_LAST")
  lastErrorPtrIdx = returnedData2
  tiraAssignId lastErrorPtrIdx, TIRA_ARG_SYMBOL, crashRipIdx

  ' Write the target address into Context.Rip
  tiraWriteMemId TIRA_ARG_SYMBOL, ripPtrIdx, TIRA_ARG_SYMBOL, targetRipIdx, TIRA_ARG_LITERAL, 8

  ' Return EXCEPTION_CONTINUE_EXECUTION (-1) so Windows allows the thread to seamlessly continue
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, -1
  tiraJmpId endLblIdx

  tiraLabelId wrongThreadLblIdx
  tiraAssignId arg1VarIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId endLblIdx

  tiraAbiWriteRetId arg1VarIdx
  tiraRT_EpilogueId

  '''' Append the native error handler to the compiled output space immediately following the VEH handler

  tiraLabelId nativeDivZeroIdx
  tiraFatalErrorId "UNHANDLED DIVISION BY ZERO"

  ff = resolveSymbol("@NATIVE_BOUNDS_HANDLER")
  nativeBoundsIdx = returnedData2
  tiraLabelId nativeBoundsIdx
  tiraFatalErrorId "ARRAY OUT OF BOUNDS"

  tiraLabelId nativeMemAccessIdx
  tiraFatalErrorId "MEMORY ACCESS VIOLATION"

  tiraLabelId nativeStackIdx
  tiraFatalErrorId "STACK CORRUPTION DETECTED"

  tira_EndAndProcess

END SUB ' emitRuntimeVehHandler

''''''''''''''''''''''''
FUNCTION parse_ASC$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM validAscLblIdx AS LONG
  DIM errStr$
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM endProgramIdx AS LONG
  DIM byteValIdx AS LONG
  DIM comma1 AS LONG
  DIM posVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM jmpDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ASC", 3) = 0 THEN
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx - 1, allowImplicit, "POSITION MUST BE NUMERIC")
    IF ff = 0 THEN
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal
  ELSE
    ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
    IF ff = 0 THEN
      tira_Cancel
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    IF exprIs.DataType <> TYPE_STRING THEN
      throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
      parse_ASC$ = ""
      EXIT FUNCTION
    END IF
    arg1Type = tiraParsedArgType
    arg1Val = tiraParsedArgVal

    arg2Type = TIRA_ARG_LITERAL
    arg2Val = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("ASC", "_VAL")
  IF scratchIdx = 0 THEN
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  validAscLblIdx = tiraLabelCreateNewId&("VALID_ASC")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, validAscLblIdx
  tiraJmpCondId JCC_JL, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1, validAscLblIdx
  tiraJmpCondId JCC_JG, arg2Type, arg2Val, TIRA_ARG_SYMBOL, strLenIdx, validAscLblIdx

  posVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, posVarIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, posVarIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, targetAddrIdx
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  jmpDoneIdx = tiraLabelCreateNewId&("ASC_DONE")
  tiraJmpId jmpDoneIdx

  tiraLabelId validAscLblIdx

  errStr$ = "PROGRAM TERMINATED: ILLEGAL FUNCTION CALL IN ASC() ON LINE " + retLineNumberStr$
  ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = errStr$

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN
    tira_Cancel
    parse_ASC$ = ""
    EXIT FUNCTION
  END IF
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId jmpDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_ASC$ = scratchName$

END FUNCTION ' parse_ASC$

''''''''''''''''''''''''
FUNCTION parse_ASC_Assign (startIdx)

  DIM endIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM comma1 AS LONG
  DIM strStartIdx AS LONG
  DIM strEndIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG
  DIM udtFieldNames$(256)
  DIM vTok$
  DIM vName$
  DIM lastCharCheck$
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tempFieldSize AS LONG
  DIM numParsedIndices AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM finalAddrIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM posVarType AS LONG
  DIM posVarVal AS _INTEGER64
  DIM posVarIdx AS LONG
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM lblErrIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM posOffsetIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM valByteIdx AS LONG

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "MALFORMED ASC ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER ASC", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(tokIdx, endIdx)
  IF ff = 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParenIdx = returnedData2

  IF closeParenIdx + 1 > endIdx OR lineTokenVals(closeParenIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = IN ASC ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, closeParenIdx - 1)

  strStartIdx = startIdx + 2
  IF comma1 > 0 THEN
    strEndIdx = comma1 - 1
  ELSE
    strEndIdx = closeParenIdx - 1
  END IF

  vTok$ = lineTokens$(strStartIdx)
  vName$ = UCASE$(vTok$)
  tokIdx = strStartIdx + 1

  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= strEndIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= strEndIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, strEndIdx)
      IF ff = 1 THEN
        tokIdx = returnedData2 + 1
      ELSE
        EXIT FUNCTION
      END IF
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= strEndIdx THEN
    throwCompilerError "ASC TARGET MUST BE A SINGLE ADDRESSABLE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  IF findSymbol(vName$) = 0 THEN
    lastCharCheck$ = RIGHT$(vName$, 1)
    IF lastCharCheck$ <> "$" AND lastCharCheck$ <> "#" AND lastCharCheck$ <> "!" AND lastCharCheck$ <> "%" AND lastCharCheck$ <> "&" AND lastCharCheck$ <> "~" THEN
      IF findSymbol(vName$ + "$") THEN
        IF symbols(returnedData2).DataType = TYPE_STRING THEN
          vName$ = vName$ + "$"
        END IF
      END IF
    END IF
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2
  targetType = returnedData3

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  ff = validateSymbolArrayScalar(vIdx, vName$, hasIndex, wasNewSymbol, 0, 0)
  IF ff = 0 THEN EXIT FUNCTION

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempFieldSize = udtFields(uIdx, iField).Size
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
          iField = returnedData2
          IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
            udtOffset = udtOffset + udtFields(uIdx, iField).Offset
            targetType = udtFields(uIdx, iField).DataType
            tempUdtIndex = udtFields(uIdx, iField).UDTIndex
            tempFieldSize = udtFields(uIdx, iField).Size
            tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
            fieldFound = 1
          END IF
        END IF
      END IF

      IF fieldFound = 0 THEN
        throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  IF targetType <> TYPE_STRING THEN
    throwCompilerError "ASC TARGET MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayArgsId(parenStartIdx, strEndIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerError "ARRAY NOT DIMMED", ASIS, 0
      tira_Cancel
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  isFixedStr = 0
  destLen = 0
  IF hasField = 1 THEN
    IF tempIsDynamicString = 0 THEN
      isFixedStr = 1
      destLen = tempFieldSize
    END IF
  ELSE
    destLen = retFixeSTRINGDLength(vIdx)
    IF destLen > 0 THEN
      isFixedStr = 1
    END IF
  END IF

  IF isFixedStr = 1 THEN
    dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    strLenIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, destLen
  ELSE
    lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    IF hasField = 0 AND hasIndex = 0 THEN
      tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, vIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, udtOffset)
      IF finalAddrIdx = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraReadMemId lhsDescPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx
    END IF

    dataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
    strLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, lhsDescPtrIdx)
  END IF

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntArgId(comma1 + 1, closeParenIdx - 1, ALIM, "POSITION MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    posVarType = tiraParsedArgType
    posVarVal = tiraParsedArgVal
  ELSE
    posVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId posVarIdx, TIRA_ARG_LITERAL, 1
    posVarType = TIRA_ARG_SYMBOL
    posVarVal = posVarIdx
  END IF

  ff = tiraParseExpressionIntArgId(closeParenIdx + 2, endIdx, ALIM, "VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  lblErrIdx = tiraLabelCreateNewId&("ASC_ERR")
  lblValidIdx = tiraLabelCreateNewId&("ASC_VALID")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, lblErrIdx
  tiraJmpCondId JCC_JL, posVarType, posVarVal, TIRA_ARG_LITERAL, 1, lblErrIdx
  tiraJmpCondId JCC_JG, posVarType, posVarVal, TIRA_ARG_SYMBOL, strLenIdx, lblErrIdx
  tiraJmpCondId JCC_JL, valVarType, valVarVal, TIRA_ARG_LITERAL, 0, lblErrIdx
  tiraJmpCondId JCC_JG, valVarType, valVarVal, TIRA_ARG_LITERAL, 255, lblErrIdx
  tiraJmpId lblValidIdx

  tiraLabelId lblErrIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId lblValidIdx

  posOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, posOffsetIdx, posVarType, posVarVal, TIRA_ARG_LITERAL, 1

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, posOffsetIdx

  valByteIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, valByteIdx, valVarType, valVarVal, TIRA_ARG_LITERAL, 255

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, valByteIdx, TIRA_ARG_LITERAL, 1

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_ASC_Assign = 1

END FUNCTION ' parse_ASC_Assign

''''''''''''''''''''''''
FUNCTION parse_ATN$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM singleResIdx AS LONG
  DIM argFloatIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ATN", 3) = 0 THEN
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("ATN", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Explicitly override the integer prefix rule to safely route as float
  symbols(scratchIdx).DataType = TYPE_SINGLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  ' Coerce the argument to a double for the external IAT function
  IF exprIs.DataType <> TYPE_DOUBLE THEN
    argFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, argFloatIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, TYPE_DOUBLE
    arg1Type = TIRA_ARG_SYMBOL
    arg1Val = argFloatIdx
  END IF

  ff = resolveSymbol("IAT_ATAN")
  IF ff = 0 THEN
    tira_Cancel
    parse_ATN$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  singleResIdx = tiraDimVarId&("T", TYPE_SINGLE)
  tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, singleResIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, TYPE_SINGLE
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, singleResIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_SINGLE
  exprIs.IsTemp = 1
  parse_ATN$ = scratchName$

END FUNCTION ' parse_ATN$

''''''''''''''''''''''''
FUNCTION parse_BEEP (startIdx)

  DIM endIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  ff = verifyNoExtraTokens(endIdx, startIdx, "BEEP")
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  ff = resolveSymbol("IAT_BEEP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, TIRA_ARG_LITERAL, 800, TIRA_ARG_LITERAL, 250

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BEEP = 1

END FUNCTION ' parse_BEEP

''''''''''''''''''''''''
FUNCTION parse_BLOAD (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM fileEndIdx AS LONG
  DIM hasOffset AS LONG
  DIM fileVarType AS LONG
  DIM fileVarVal AS _INTEGER64
  DIM offsetVarType AS LONG
  DIM offsetVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "BLOAD REQUIRES FILENAME", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    fileEndIdx = endIdx
    hasOffset = 0
  ELSE
    fileEndIdx = comma1 - 1
    hasOffset = 1
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, fileEndIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileVarType = tiraParsedArgType
  fileVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "BLOAD FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasOffset = 0 THEN
    offsetVarType = TIRA_ARG_LITERAL
    offsetVarVal = 0
  ELSE
    ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx, ALIM, "OFFSET MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    offsetVarType = tiraParsedArgType
    offsetVarVal = tiraParsedArgVal
  END IF

  ff = resolveSymbol("RT_BLOAD")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId3 callFuncIdx, fileVarType, fileVarVal, offsetVarType, offsetVarVal, TIRA_ARG_LITERAL, hasOffset
  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BLOAD = 1

END FUNCTION ' parse_BLOAD

''''''''''''''''''''''''
FUNCTION parse_BLUE32$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_BLUE32", 3) = 0 THEN
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "_BLUE32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("BLU32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_BLUE32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_BLUE32$ = scratchName$

END FUNCTION ' parse_BLUE32$

''''''''''''''''''''''''
FUNCTION parse_BSAVE (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM fileVarType AS LONG
  DIM fileVarVal AS _INTEGER64
  DIM offsetVarType AS LONG
  DIM offsetVarVal AS _INTEGER64
  DIM lenVarType AS LONG
  DIM lenVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "BSAVE REQUIRES FILENAME, OFFSET, LENGTH", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    throwCompilerError "BSAVE REQUIRES FILENAME, OFFSET, LENGTH", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, comma1 - 1, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileVarType = tiraParsedArgType
  fileVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "BSAVE FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = tiraParseExpressionIntArgId(comma1 + 1, comma2 - 1, ALIM, "OFFSET MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  offsetVarType = tiraParsedArgType
  offsetVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma2 + 1, endIdx, ALIM, "LENGTH MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  lenVarType = tiraParsedArgType
  lenVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_BSAVE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId3 callFuncIdx, fileVarType, fileVarVal, offsetVarType, offsetVarVal, lenVarType, lenVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_BSAVE = 1

END FUNCTION ' parse_BSAVE

''''''''''''''''''''''''
FUNCTION parse_CASE (startIdx)

  DIM endIdx AS LONG
  DIM hiddenVarIdx AS LONG
  DIM selectType AS LONG
  DIM selID AS LONG
  DIM caseID AS LONG
  DIM exprStart AS LONG
  DIM exprEnd AS LONG
  DIM toIdx AS LONG
  DIM hasTo AS LONG
  DIM tVal AS LONG
  DIM opType AS LONG
  DIM relStart AS LONG
  DIM nxtVal AS LONG
  DIM commaIdx AS LONG
  DIM lhsVarType AS LONG
  DIM lhsVarVal AS _INTEGER64
  DIM rhsVarType AS LONG
  DIM rhsVarVal AS _INTEGER64
  DIM endSelLblIdx AS LONG
  DIM nextCaseLblIdx AS LONG
  DIM bodyLblIdx AS LONG
  DIM prevNextLblIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM condConst AS LONG

  IF ctrlCount = 0 THEN
    throwCompilerError "CASE WITHOUT SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_SELECT THEN
    throwCompilerError "CASE NOT INSIDE SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  hiddenVarIdx = ctrls(ctrlCount - 1).SelectVarIdx
  selectType = ctrls(ctrlCount - 1).SelectDataType
  selID = ctrls(ctrlCount - 1).Patch1
  caseID = ctrls(ctrlCount - 1).SelectCaseSeen

  endSelLbl$ = "@SEL_END_" + LTRIM$(RTRIM$(STR$(selID)))
  nextCaseLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID)))
  bodyLbl$ = "@SEL_BODY_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID)))

  IF caseID > 0 THEN
    tira_Start

    ' Jump to end of SELECT block because the PREVIOUS case just finished executing its body
    tiraScheduleHeapResetId

    ff = resolveSymbol(endSelLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endSelLblIdx = returnedData2
    tiraJmpId endSelLblIdx

    ' The previous case's conditions would skip to right here if they all failed
    prevNextLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID - 1)))
    ff = resolveSymbol(prevNextLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    prevNextLblIdx = returnedData2
    tiraLabelId prevNextLblIdx

    tira_EndAndProcess
  END IF

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  endIdx = lineTokenCount - 1

  tira_Start

  exprStart = startIdx + 1

  IF exprStart <= endIdx THEN
    IF lineTokenVals(exprStart) = 256 + ASC(":") THEN
      exprStart = exprStart + 1
    END IF
  END IF

  ' Check for CASE ELSE
  IF exprStart <= endIdx THEN
    IF lineTokenVals(exprStart) = TOK_ELSE THEN
      ' Since it is CASE ELSE, execution falls right through, no conditions
      tiraScheduleHeapResetId
      tira_EndAndProcess

      ctrls(ctrlCount - 1).SelectCaseSeen = caseID + 1

      parse_CASE = 1
      EXIT FUNCTION
    END IF
  END IF

  ' Evaluate a comma-separated list of expressions
  DO WHILE exprStart <= endIdx
    exprEnd = endIdx

    commaIdx = findComma(exprStart, endIdx)
    IF commaIdx > 0 THEN
      exprEnd = commaIdx - 1
    END IF

    hasTo = 0
    toIdx = 0
    ff = findNextTokenAtDepth0(exprStart, exprEnd, TOK_TO)
    IF ff = 1 THEN
      hasTo = 1
      toIdx = returnedData2
    END IF

    IF hasTo = 1 THEN
      '''' Case X to Y

      ff = tiraParseExpressionId(exprStart, toIdx - 1, ALIM)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      lhsVarType = tiraParsedArgType
      lhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = tiraParseExpressionId(toIdx + 1, exprEnd, ALIM)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      rhsVarType = tiraParsedArgType
      rhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      skipLblIdx = tiraLabelCreateNewId&("SKIP_CASE")
      tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, hiddenVarIdx, lhsVarType, lhsVarVal, skipLblIdx

      ff = resolveSymbol(bodyLbl$)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bodyLblIdx = returnedData2
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, hiddenVarIdx, rhsVarType, rhsVarVal, bodyLblIdx
      tiraLabelId skipLblIdx

    ELSE
      '''' Case relational / equals

      opType = 0 ' 0 =, 1 <, 2 >, 3 <=, 4 >=, 5 <>
      relStart = exprStart

      IF relStart <= exprEnd THEN
        IF lineTokenVals(relStart) = 0 THEN
          IF UCASE$(lineTokens$(relStart)) = "IS" THEN
            relStart = relStart + 1
          END IF
        END IF
      END IF

      IF relStart <= exprEnd THEN
        tVal = lineTokenVals(relStart)

        SELECT CASE tVal

          CASE 256 + ASC("=")
            opType = 0
            relStart = relStart + 1

          CASE 256 + ASC("<")
            IF relStart + 1 <= exprEnd THEN
              nxtVal = lineTokenVals(relStart + 1)
              SELECT CASE nxtVal

                CASE 256 + ASC("=")
                  opType = 3
                  relStart = relStart + 2

                CASE 256 + ASC(">")
                  opType = 5
                  relStart = relStart + 2

                CASE ELSE
                  opType = 1
                  relStart = relStart + 1

              END SELECT ' nxtVal

            ELSE
              opType = 1
              relStart = relStart + 1
            END IF

          CASE 256 + ASC(">")
            IF relStart + 1 <= exprEnd THEN
              nxtVal = lineTokenVals(relStart + 1)
              IF nxtVal = 256 + ASC("=") THEN
                opType = 4
                relStart = relStart + 2
              ELSE
                opType = 2
                relStart = relStart + 1
              END IF
            ELSE
              opType = 2
              relStart = relStart + 1
            END IF

        END SELECT ' tVal

      END IF

      ff = tiraParseExpressionId(relStart, exprEnd, ALIM)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      rhsVarType = tiraParsedArgType
      rhsVarVal = tiraParsedArgVal

      IF selectType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
      IF selectType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      condConst = JCC_JE

      SELECT CASE opType

        CASE 0: condConst = JCC_JE
        CASE 1: condConst = JCC_JL
        CASE 2: condConst = JCC_JG
        CASE 3: condConst = JCC_JLE
        CASE 4: condConst = JCC_JGE
        CASE 5: condConst = JCC_JNE

      END SELECT ' opType

      ff = resolveSymbol(bodyLbl$)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bodyLblIdx = returnedData2
      tiraJmpCondId condConst, TIRA_ARG_SYMBOL, hiddenVarIdx, rhsVarType, rhsVarVal, bodyLblIdx

    END IF

    exprStart = exprEnd + 2
  LOOP

  ' If not equal to any of the above comma-separated checks, skip to the next CASE
  tiraScheduleHeapResetId

  ff = resolveSymbol(nextCaseLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  nextCaseLblIdx = returnedData2
  tiraJmpId nextCaseLblIdx

  ' Anchor the body execution block here for matches
  ff = resolveSymbol(bodyLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  bodyLblIdx = returnedData2
  tiraLabelId bodyLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  ctrls(ctrlCount - 1).SelectCaseSeen = caseID + 1

  parse_CASE = 1

END FUNCTION ' parse_CASE

''''''''''''''''''''''''
FUNCTION parse_CHR$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "CHR$", 3) = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "CHR$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("CHR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
  IF compileError = 1 THEN
    tira_Cancel
    parse_CHR$ = ""
    EXIT FUNCTION
  END IF

  ' Write the payload character to the heap natively
  tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1

  ' Build the String Descriptor directly on the Scratchpad memory
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  ' Ensure Flags are set to 0 (No Free Required on Temp Heap)
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_CHR$ = scratchName$

END FUNCTION ' parse_CHR$

''''''''''''''''''''''''
FUNCTION parse_CLEAR (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM commaIdx AS LONG
  DIM exprEnd AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF currentScopeID <> 0 THEN
    throwCompilerError "CLEAR NOT ALLOWED IN SUB OR FUNCTION", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Parse optional legacy CLEAR arguments (e.g. CLEAR , , 2000)
  ' We evaluate them for syntax compliance and side-effects, but discard the values
  ' since x64 executable stack/memory sizes are fixed in the PE header.
  tokIdx = startIdx + 1
  DO WHILE tokIdx <= endIdx
    commaIdx = findComma(tokIdx, endIdx)
    IF commaIdx > 0 THEN
      exprEnd = commaIdx - 1
    ELSE
      exprEnd = endIdx
    END IF

    IF exprEnd >= tokIdx THEN
      ff = tiraParseExpressionIntArgId(tokIdx, exprEnd, ALIM, "CLEAR ARGUMENTS MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF

    IF commaIdx > 0 THEN
      tokIdx = commaIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  ff = resolveSymbol("RT_CLEAR")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CLEAR = 1

END FUNCTION ' parse_CLEAR

''''''''''''''''''''''''
FUNCTION parse_CLOSE (startIdx)

  ' Closes an open file or all open files

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM fileNumStart AS LONG
  DIM fileNumType AS LONG
  DIM fileNumVal AS _INTEGER64
  DIM handlesIdx AS LONG
  DIM fileStateIdx AS LONG
  DIM closeHandleIdx AS LONG
  DIM baseArrIdx AS LONG
  DIM stateBaseIdx AS LONG
  DIM iterVarIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopEndIdx AS LONG
  DIM slotAddrIdx AS LONG
  DIM stateSlotIdx AS LONG
  DIM handleVarIdx AS LONG
  DIM skipCloseIdx AS LONG
  DIM skipClose2Idx AS LONG

  endIdx = lineTokenCount - 1

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  tiraFlushFileWriteBufferId

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  handlesIdx = returnedData2

  baseArrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, handlesIdx

  ff = resolveSymbol("!G_FLS_V32_FILE_STATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  fileStateIdx = returnedData2

  stateBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, fileStateIdx

  ff = resolveSymbol("IAT_CLOSEHANDLE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  closeHandleIdx = returnedData2

  IF endIdx < startIdx + 1 THEN
    ' Close all files iteratively (1 to 255)
    iterVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId iterVarIdx, TIRA_ARG_LITERAL, 1

    loopTopIdx = tiraLabelCreateNewId&("CLOSE_LOOP")
    loopEndIdx = tiraLabelCreateNewId&("CLOSE_END")

    tiraLabelId loopTopIdx
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 255, loopEndIdx

    slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 8

    handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

    skipCloseIdx = tiraLabelCreateNewId&("SKIP_CLOSE")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipCloseIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipCloseIdx ' INVALID_HANDLE_VALUE (-1)

    tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx

    tiraLabelId skipCloseIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

    stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES
    tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, FS_MODE_NONE, TIRA_ARG_LITERAL, 8

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_SYMBOL, iterVarIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId loopTopIdx

    tiraLabelId loopEndIdx
  ELSE
    ' Close specifically identified files mapped by comma boundaries
    itemStart = startIdx + 1
    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      commaIdx = findComma(itemStart, endIdx)
      IF commaIdx > 0 THEN itemEnd = commaIdx - 1

      fileNumStart = itemStart

      ' Strip the # symbol so the expression evaluates properly
      IF lineTokens$(fileNumStart) = "#" THEN
        fileNumStart = fileNumStart + 1
      ELSE
        IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
          lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
        END IF
      END IF

      ff = tiraParseExpressionIntArgId(fileNumStart, itemEnd, ALIM, "FILENUM MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fileNumType = tiraParsedArgType
      fileNumVal = tiraParsedArgVal

      slotAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_SYMBOL, baseArrIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, 8

      handleVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId handleVarIdx, TIRA_ARG_SYMBOL, slotAddrIdx

      skipClose2Idx = tiraLabelCreateNewId&("SKIP_CLOSE")
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, 0, skipClose2Idx
      tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, handleVarIdx, TIRA_ARG_LITERAL, -1, skipClose2Idx

      tiraCallId1 closeHandleIdx, TIRA_ARG_SYMBOL, handleVarIdx

      tiraLabelId skipClose2Idx

      tiraWriteMemId TIRA_ARG_SYMBOL, slotAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

      stateSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_SYMBOL, stateBaseIdx, fileNumType, fileNumVal, TIRA_ARG_LITERAL, FS_STATE_SLOT_BYTES
      tiraWriteMemId TIRA_ARG_SYMBOL, stateSlotIdx, TIRA_ARG_LITERAL, FS_MODE_NONE, TIRA_ARG_LITERAL, 8

      itemStart = itemEnd + 2
    LOOP
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_CLOSE = 1

END FUNCTION ' parse_CLOSE

''''''''''''''''''''''''
FUNCTION parse_COLOR (startIdx)

  DIM endIdx AS LONG
  DIM commaPos AS LONG
  DIM fgType AS LONG
  DIM fgVal AS _INTEGER64
  DIM bgType AS LONG
  DIM bgVal AS _INTEGER64
  DIM skipInitLblIdx AS LONG
  DIM lastFgIdx AS LONG
  DIM colorInitIdx AS LONG
  DIM lastBgIdx AS LONG
  DIM fgVarIdx AS LONG
  DIM fgMaskIdx AS LONG
  DIM fgRgbPtrIdx AS LONG
  DIM fgRgbIdx AS LONG
  DIM bgShiftIdx AS LONG
  DIM bgMaskIdx AS LONG
  DIM finalAttrIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM setTextAttrIdx AS LONG

  endIdx = lineTokenCount - 1

  tira_Start

  commaPos = findComma(startIdx + 1, endIdx)

  IF commaPos = 0 THEN
    ' No comma found, so there is only a foreground argument - COLOR fg
    ' Ensure the statement is not just "COLOR" with no arguments
    IF endIdx >= startIdx + 1 THEN
      hasFg = 1
      ff = tiraParseExpressionIntArgId(startIdx + 1, endIdx, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgType = tiraParsedArgType
      fgVal = tiraParsedArgVal
    END IF
  ELSE
    ' Comma was found. Check for arguments on either side of it
    IF commaPos > startIdx + 1 THEN
      ' Argument exists before the comma - COLOR fg, ...
      hasFg = 1
      ff = tiraParseExpressionIntArgId(startIdx + 1, commaPos - 1, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgType = tiraParsedArgType
      fgVal = tiraParsedArgVal
    END IF

    IF commaPos < endIdx THEN
      ' Argument exists after the comma - COLOR ..., bg
      hasBg = 1
      ff = tiraParseExpressionIntArgId(commaPos + 1, endIdx, ALIM, "COLOR REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      bgType = tiraParsedArgType
      bgVal = tiraParsedArgVal
    END IF
  END IF

  ' Process foreground
  IF hasFg = 1 THEN
    ff = resolveSymbol("!G_GFX_VAL_LAST_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastFgIdx = returnedData2
    tiraAssignId lastFgIdx, fgType, fgVal

    ff = resolveSymbol("!G_GFX_FLG_COLOR_INIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    colorInitIdx = returnedData2
    tiraAssignId colorInitIdx, TIRA_ARG_LITERAL, 1
  ELSE
    ' No foreground was provided, so load the last used one or the default.
    skipInitLblIdx = tiraLabelCreateNewId&("SKIP_INIT")
    fgVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_LAST_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastFgIdx = returnedData2
    tiraAssignId fgVarIdx, TIRA_ARG_SYMBOL, lastFgIdx

    ff = resolveSymbol("!G_GFX_FLG_COLOR_INIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    colorInitIdx = returnedData2
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, colorInitIdx, TIRA_ARG_LITERAL, 0, skipInitLblIdx
    tiraAssignId fgVarIdx, TIRA_ARG_LITERAL, 7 ' Default FG is 7 (Light Gray) in standard console
    tiraLabelId skipInitLblIdx

    fgType = TIRA_ARG_SYMBOL
    fgVal = fgVarIdx
  END IF

  ' Process background
  IF hasBg = 1 THEN
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2
    tiraAssignId lastBgIdx, bgType, bgVal
  ELSE
    ' No background was provided, so load the last used one.
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2
    bgType = TIRA_ARG_SYMBOL
    bgVal = lastBgIdx
  END IF

  IF cm.HasGraphics = 1 THEN
    ' Safely store as pure 8-bit palette index for direct plotting primitives
    fgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, fgMaskIdx, fgType, fgVal, TIRA_ARG_LITERAL, 255

    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgRgbIdx = returnedData2

    fgRgbPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, fgRgbPtrIdx, TIRA_ARG_SYMBOL, fgRgbIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, fgRgbPtrIdx, TIRA_ARG_SYMBOL, fgMaskIdx, TIRA_ARG_LITERAL, 4
  ELSE
    ' Console mode logic - combine attributes into (BG_MASK) OR (FG_MASK)

    ' FG_MASK = FG AND 15
    fgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, fgMaskIdx, fgType, fgVal, TIRA_ARG_LITERAL, 15

    ' BG_SHIFT = BG * 16 (equivalent to SHL 4)
    bgShiftIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, bgShiftIdx, bgType, bgVal, TIRA_ARG_LITERAL, 16

    ' BG_MASK = BG_SHIFT AND 240
    bgMaskIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, bgMaskIdx, TIRA_ARG_SYMBOL, bgShiftIdx, TIRA_ARG_LITERAL, 240

    ' FINAL_ATTR = FG_MASK OR BG_MASK
    finalAttrIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, finalAttrIdx, TIRA_ARG_SYMBOL, fgMaskIdx, TIRA_ARG_SYMBOL, bgMaskIdx

    ' Call GetStdHandle(-11)
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11

    ' Retrieve the handle from RAX into a virtual register
    hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraGetRetId hndVarIdx

    ' Call SetConsoleTextAttribute
    ff = resolveSymbol("IAT_SETCONSOLETEXTATTRIBUTE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setTextAttrIdx = returnedData2
    tiraCallId2 setTextAttrIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, finalAttrIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_COLOR = 1

END FUNCTION ' parse_COLOR

''''''''''''''''''''''''
FUNCTION parse_COMMON (startIdx)

  DIM tempSuccess AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 2 THEN
    throwCompilerError "MALFORMED COMMON SHARED", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_SHARED THEN
    throwCompilerError "EXPECTED SHARED AFTER COMMON", ASIS, 0
    EXIT FUNCTION
  END IF

  tempSuccessOrFail = parse_GLOBAL_Core(startIdx + 2, endIdx)

  parse_COMMON = tempSuccessOrFail

END FUNCTION ' parse_COMMON

''''''''''''''''''''''''
FUNCTION parse_DISPLAY_Core (startIdx, isDisplayI)

  ' Core routine for handling screen buffer flush updates

  DIM endIdx AS LONG
  DIM autoFlagIdx AS LONG
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF isDisplayI = 1 THEN cmdName$ = "_DISPLAYI" ELSE cmdName$ = "_DISPLAY"

  IF cm.HasGraphics = 0 THEN
    throwCompilerError cmdName$ + " REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx, cmdName$)
  IF ff = 0 THEN EXIT FUNCTION

  tira_Start

  ff = resolveSymbol("!G_GFX_FLG_AUTO")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  autoFlagIdx = returnedData2

  tiraAssignId autoFlagIdx, TIRA_ARG_LITERAL, 0

  IF isDisplayI = 0 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
  ELSE
    ff = resolveSymbol("RT_AUTODISPLAY_CHECK")
  END IF

  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId0 callFuncIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DISPLAY_Core = 1

END FUNCTION ' parse_DISPLAY_Core

''''''''''''''''''''''''
FUNCTION parse_DO (startIdx)

  DIM endIdx AS LONG
  DIM hasCond AS LONG
  DIM tVal AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64

  ' Generate a globally unique ID for this loop structure
  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_DO = 0
    EXIT FUNCTION
  END IF

  topLbl$ = "@DO_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@DO_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  ' Anchor the top of the loop in the TIRA symbol table
  tira_Start

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx

  tira_EndAndProcess

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  endIdx = lineTokenCount - 1

  hasCond = 0

  IF endIdx > startIdx THEN
    tVal = lineTokenVals(startIdx + 1)
    IF tVal = TOK_UNTIL OR tVal = TOK_WHILE THEN
      hasCond = 1
    ELSE
      throwCompilerError "EXPECTED UNTIL OR WHILE", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  tira_Start

  IF hasCond = 1 THEN
    ff = tiraParseExpressionNumericArgId(startIdx + 2, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    exprVarType = tiraParsedArgType
    exprVarVal = tiraParsedArgVal

    ff = resolveSymbol(doneLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    doneLblIdx = returnedData2

    IF tVal = TOK_UNTIL THEN
      tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    ELSE
      tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_DO
  ctrls(ctrlCount).Patch1 = loopID ' Save the Loop ID for parse_LOOP and parse_EXIT
  ctrls(ctrlCount).Patch2 = 0 ' Unused for loop structures as TIRA labels manage exit jumps
  ctrlCount = ctrlCount + 1

  parse_DO = 1

END FUNCTION ' parse_DO


''''''''''''''''''''''''
FUNCTION parse_FOR (startIdx)

  DIM endIdx AS LONG
  DIM vIdx AS LONG
  DIM vDataType AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM hasStep AS LONG
  DIM stepIdx AS LONG
  DIM loopID AS LONG
  DIM endExprEnd AS LONG
  DIM endVarIdx AS LONG
  DIM stepVarIdx AS LONG
  DIM startVarType AS LONG
  DIM startVarVal AS _INTEGER64
  DIM endVarType AS LONG
  DIM endVarVal AS _INTEGER64
  DIM stepVarType AS LONG
  DIM stepVarVal AS _INTEGER64
  DIM topLblIdx AS LONG
  DIM condLblIdx AS LONG
  DIM isUdtBase AS LONG
  DIM tokIdx AS LONG
  DIM parenDepth AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 3 THEN
    throwCompilerError "MALFORMED FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  parenDepth = 0

  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      parenDepth = parenDepth + 1
      tokIdx = tokIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx > endIdx THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 OR RIGHT$(vTok$, 1) = "$" THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Legacy dot variable check
  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  DO WHILE tokIdx <= endIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN
      parenDepth = parenDepth - 1
      tokIdx = tokIdx + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  IF parenDepth <> 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS IN FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2
  vDataType = returnedData3

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF vDataType = TYPE_STRING THEN
    throwCompilerError "FOR NEEDS NUMERIC VAR", ASIS, 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("=") THEN
    throwCompilerError "FOR MISSING =", ASIS, 0
    EXIT FUNCTION
  END IF

  hasTo = 0
  toIdx = 0
  hasStep = 0
  stepIdx = 0

  ff = findNextTokenAtDepth0(tokIdx + 1, endIdx, TOK_TO)
  IF ff = 1 THEN
    hasTo = 1
    toIdx = returnedData2
  END IF

  ff = findNextTokenAtDepth0(tokIdx + 1, endIdx, TOK_STEP)
  IF ff = 1 THEN
    hasStep = 1
    stepIdx = returnedData2
  END IF

  IF hasTo = 0 THEN
    throwCompilerError "FOR MISSING TO", ASIS, 0
    EXIT FUNCTION
  END IF

  IF toIdx <= tokIdx THEN
    throwCompilerError "FOR MISSING START EXPR", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    IF stepIdx <= toIdx + 1 THEN
      throwCompilerError "FOR MISSING END EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
    IF stepIdx = endIdx THEN
      throwCompilerError "FOR MISSING STEP EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
  ELSE
    IF toIdx = endIdx THEN
      throwCompilerError "FOR MISSING END EXPR", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  ' Generate a globally unique ID for this loop structure
  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_FOR = 0
    EXIT FUNCTION
  END IF

  tira_Start

  '''' Evaluate Start Value
  ff = tiraParseExpressionNumericArgId(tokIdx + 1, toIdx - 1, cm.ClassicMode, "FOR NEEDS NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  startVarType = tiraParsedArgType
  startVarVal = tiraParsedArgVal

  endExprEnd = endIdx
  IF hasStep = 1 THEN endExprEnd = stepIdx - 1

  endName$ = "!C_SYS_VAL_FOR_END_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(endName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endVarIdx = returnedData2
  symbols(endVarIdx).DataType = vDataType

  IF currentScopeID > 0 THEN
    symbols(endVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  '''' Evaluate End Value
  ff = tiraParseExpressionNumericArgId(toIdx + 1, endExprEnd, cm.ClassicMode, "FOR NEEDS NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  endVarType = tiraParsedArgType
  endVarVal = tiraParsedArgVal

  stepName$ = "!C_SYS_VAL_FOR_STEP_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(stepName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  stepVarIdx = returnedData2
  symbols(stepVarIdx).DataType = vDataType

  IF currentScopeID > 0 THEN
    symbols(stepVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  '''' Evaluate Step Value
  IF hasStep = 1 THEN
    ff = tiraParseExpressionNumericArgId(stepIdx + 1, endIdx, cm.ClassicMode, "FOR NEEDS NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    stepVarType = tiraParsedArgType
    stepVarVal = tiraParsedArgVal
  ELSE
    stepVarType = TIRA_ARG_LITERAL
    stepVarVal = 1
  END IF

  tiraAssignId vIdx, startVarType, startVarVal

  tiraAssignId endVarIdx, endVarType, endVarVal

  tiraAssignId stepVarIdx, stepVarType, stepVarVal

  lblCond$ = "@FOR_COND_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(lblCond$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  condLblIdx = returnedData2
  tiraJmpId condLblIdx

  lblTop$ = "@FOR_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  ff = resolveSymbol(lblTop$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_FOR
  ctrls(ctrlCount).ForVarIdx = vIdx
  ctrls(ctrlCount).Patch1 = loopID ' Save the Loop ID for parse_NEXT and parse_EXIT
  ctrls(ctrlCount).Patch2 = 0 ' Unused
  ctrlCount = ctrlCount + 1

  parse_FOR = 1

END FUNCTION ' parse_FOR

''''''''''''''''''''''''
FUNCTION parse_GLOBAL (startIdx)

  DIM tempSuccess AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "MALFORMED GLOBAL", ASIS, 0
    EXIT FUNCTION
  END IF

  tempSuccess = parse_GLOBAL_Core(startIdx + 1, endIdx)

  parse_GLOBAL = tempSuccess

END FUNCTION ' parse_GLOBAL

''''''''''''''''''''''''
FUNCTION parse_GLOBAL_Core (startTokIdx, endIdx)

  ' Used by the synonym commands GLOBAL and COMMON SHARED

  DIM dtMapped AS LONG
  DIM fixedLen AS LONG
  DIM typeData AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  tokIdx = startTokIdx

  DO WHILE tokIdx <= endIdx
    vTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerError "EXPECTED VARIABLE NAME", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(vTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    symbols(vIdx).IsShared = 1
    symbols(vIdx).IsExplicit = DECL_EXPLICIT

    tokIdx = tokIdx + 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN EXIT FUNCTION

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerError "EXPECTED COMMA", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  parse_GLOBAL_Core = 1

END FUNCTION ' parse_GLOBAL_Core

''''''''''''''''''''''''
FUNCTION parse_GREEN32$ (startIdx, endIdx, allowImplicit)

  ' Extracts the green channel component from a 32-bit color value

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM shiftVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_GREEN32", 3) = 0 THEN
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "_GREEN32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("GRN32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_GREEN32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  shiftVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, shiftVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftVarIdx, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_GREEN32$ = scratchName$

END FUNCTION ' parse_GREEN32$


''''''''''''''''''''''''
FUNCTION parse_HEX$ (startIdx, endIdx, allowImplicit)

  ' Converts a numeric value into a hexadecimal string representation

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM argDataType AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM ptrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipAlphaIdx AS LONG
  DIM jmpWriteIdx AS LONG
  DIM strLenIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM workVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "HEX$", 3) = 0 THEN
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF

  ' Sovereign command opens its own compilation block
  tira_Start

  ' The Shunting Yard safely queues argument evaluation inside our pristine TIRA session
  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "HEX$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  argDataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("HEX", "_DSC")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Copy the evaluated argument into a working variable to prevent mutating user variables
  workVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId workVarIdx, arg1Type, arg1Val

  basePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 16)
  IF compileError = 1 THEN
    tira_Cancel
    parse_HEX$ = ""
    EXIT FUNCTION
  END IF

  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 16

  ' Mask the value to prevent infinite sign-extension loops for negative numbers

  SELECT CASE argDataType

    CASE TYPE_BYTE, TYPE_UBYTE
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 255
    CASE TYPE_INTEGER, TYPE_UINTEGER
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 65535
    CASE TYPE_LONG, TYPE_ULONG
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 4294967295

  END SELECT ' argDataType

  loopTopIdx = tiraLabelCreateNewId&("HEX_LOOP")
  tiraLabelId loopTopIdx

  digitIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 15

  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  skipAlphaIdx = tiraLabelCreateNewId&("HEX_SKIP_ALPHA")

  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 10, skipAlphaIdx

  ' 0-9
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48
  jmpWriteIdx = tiraLabelCreateNewId&("HEX_WRITE")
  tiraJmpId jmpWriteIdx

  tiraLabelId skipAlphaIdx

  ' A-F
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 55

  tiraLabelId jmpWriteIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' Shr performs a logical shift, injecting zeros into the upper bits.
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 4

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, workVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, ptrIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  ' Close the block (NO HEAP RESET, so the string survives for the parent!)
  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_HEX$ = scratchName$

END FUNCTION ' parse_HEX$

''''''''''''''''''''''''
FUNCTION parse_IF (startIdx)

  DIM hasThen AS LONG
  DIM thenIdx AS LONG
  DIM ifID AS LONG
  DIM endIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  DIM trueLblIdx AS LONG
  DIM falseLblIdx AS LONG

  endIdx = lineTokenCount - 1

  hasThen = 0
  thenIdx = 0

  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_THEN)
  IF ff = 1 THEN
    hasThen = 1
    thenIdx = returnedData2
  END IF

  IF hasThen = 0 THEN
    throwCompilerError "MISSING THEN", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Generate a globally unique ID for this IF block
  ifID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_IF = 0
    EXIT FUNCTION
  END IF

  trueLbl$ = "@IF_TRUE_" + _TRIM$(STR$(ifID))
  falseLbl$ = "@IF_FALSE_" + _TRIM$(STR$(ifID))
  endLbl$ = "@IF_END_" + _TRIM$(STR$(ifID))

  tira_Start

  ff = tiraParseExpressionNumericArgId(startIdx + 1, thenIdx - 1, ALIM, "TYPE MISMATCH IN CONDITION")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal

  ff = resolveSymbol(trueLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  trueLblIdx = returnedData2

  ' Anchor the True jump so execution flows into the THEN block
  tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, trueLblIdx
  tiraScheduleHeapResetId

  ff = resolveSymbol(falseLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  falseLblIdx = returnedData2

  tiraJmpId falseLblIdx

  tiraLabelId trueLblIdx
  tiraScheduleHeapResetId

  tira_EndAndProcess

  ' Due to iterative Pass 2 flattening, single-line IF statements should never reach Pass 5.
  ' If there are tokens after THEN, something is structurally malformed in the source code.
  ff = verifyNoExtraTokens(endIdx, thenIdx, "THEN")
  IF ff = 0 THEN EXIT FUNCTION

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_IF
  ctrls(ctrlCount).Patch1 = ifID ' Save the master END IF block ID for final exit jumps
  ctrls(ctrlCount).Patch2 = ifID ' Save current FALSE block ID to link with subsequent ELSEIF chains
  ctrlCount = ctrlCount + 1

  parse_IF = 1

END FUNCTION ' parse_IF

''''''''''''''''''''''''
FUNCTION parse_KEYHIT$ (startIdx, endIdx, allowImplicit)

  ' Returns the ASCII code of the last key pressed

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM headSymbolIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailSymbolIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM emptyLblIdx AS LONG
  DIM bufSymbolIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charValIdx AS LONG
  DIM jmpDoneIdx AS LONG
  DIM normalLblIdx AS LONG
  DIM secondAddrIdx AS LONG
  DIM secondValIdx AS LONG
  DIM keyIdx AS LONG
  DIM keyLoopIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM skipKeyIdx AS LONG
  DIM mappedKeyIdx AS LONG
  DIM nmpSkipIdx AS LONG
  DIM ar1Idx AS LONG
  DIM ar2Idx AS LONG
  DIM ar3Idx AS LONG
  DIM ar4Idx AS LONG
  DIM resVarIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED _KEYHIT", ASIS, 0
    parse_KEYHIT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("KEYHIT", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_KEYHIT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    headSymbolIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, headSymbolIdx
    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    tailSymbolIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailSymbolIdx
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    emptyLblIdx = tiraLabelCreateNewId&("KEYHIT_EMPTY")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, emptyLblIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    bufSymbolIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufSymbolIdx

    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255

    normalLblIdx = tiraLabelCreateNewId&("KEYHIT_NORMAL")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, normalLblIdx

    ' Convert the queued BIOS scan code to the QB64 extended _KEYHIT value
    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    secondValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId secondValIdx, TIRA_ARG_SYMBOL, secondAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 256

    jmpDoneIdx = tiraLabelCreateNewId&("KEYHIT_DONE")
    tiraJmpId jmpDoneIdx

    tiraLabelId normalLblIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, charValIdx
    tiraJmpId jmpDoneIdx

    tiraLabelId emptyLblIdx
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraLabelId jmpDoneIdx
  ELSE
    ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
    IF ff = 0 THEN
      tira_Cancel
      parse_KEYHIT$ = ""
      EXIT FUNCTION
    END IF
    getAsyncKeyStateIdx = returnedData2

    keyIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId keyIdx, TIRA_ARG_LITERAL, 8

    keyLoopIdx = tiraLabelCreateNewId&("KEYHIT_KLOOP")
    tiraLabelId keyLoopIdx

    tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_SYMBOL, keyIdx
    keyStateIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId keyStateIdx

    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 32768
    skipKeyIdx = tiraLabelCreateNewId&("KEYHIT_SKIP")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, skipKeyIdx

    mappedKeyIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId mappedKeyIdx, TIRA_ARG_SYMBOL, keyIdx

    nmpSkipIdx = tiraLabelCreateNewId&("KEYHIT_NMPSKIP")
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 96, nmpSkipIdx
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 105, nmpSkipIdx
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 48
    tiraLabelId nmpSkipIdx

    ar1Idx = tiraLabelCreateNewId&("KEYHIT_AR1")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 37, ar1Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 52
    tiraLabelId ar1Idx

    ar2Idx = tiraLabelCreateNewId&("KEYHIT_AR2")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 38, ar2Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 56
    tiraLabelId ar2Idx

    ar3Idx = tiraLabelCreateNewId&("KEYHIT_AR3")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 39, ar3Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 54
    tiraLabelId ar3Idx

    ar4Idx = tiraLabelCreateNewId&("KEYHIT_AR4")
    tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, mappedKeyIdx, TIRA_ARG_LITERAL, 40, ar4Idx
    tiraAssignId mappedKeyIdx, TIRA_ARG_LITERAL, 50
    tiraLabelId ar4Idx

    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, mappedKeyIdx
    jmpDoneIdx = tiraLabelCreateNewId&("KEYHIT_DONE")
    tiraJmpId jmpDoneIdx

    tiraLabelId skipKeyIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 1
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, keyIdx, TIRA_ARG_LITERAL, 255, keyLoopIdx

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraLabelId jmpDoneIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tiraInjectPendingDisplayFlushId

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_KEYHIT$ = scratchName$

END FUNCTION ' parse_KEYHIT$

''''''''''''''''''''''''
FUNCTION parse_INPUT (startIdx)

  DIM endIdx AS LONG
  DIM isFile AS LONG
  DIM hasIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM vIdx AS LONG
  DIM litIdx AS LONG
  DIM litPtrIdx AS LONG
  DIM tgtAddrIdx AS LONG
  DIM isStrVar AS LONG
  DIM callFuncIdx AS LONG

  tokIdx = startIdx + 1

  endIdx = lineTokenCount - 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  isFile = 0
  IF lineTokens$(tokIdx) = "#" THEN
    isFile = 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      isFile = 1
    END IF
  END IF

  IF isFile = 1 THEN
    parse_INPUT = parse_INPUT_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  hasPrompt = 0
  promptStr$ = ""
  IF LEFT$(lineTokens$(tokIdx), 1) = CHR$(34) THEN
    hasPrompt = 1
    promptStr$ = extractQuotes$(lineTokens$(tokIdx))
    tokIdx = tokIdx + 1
    IF tokIdx > endIdx THEN
      throwCompilerError "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF
    tVal = lineTokenVals(tokIdx)
    IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
      tokIdx = tokIdx + 1
    ELSE
      throwCompilerError "EXPECTED ; OR ,", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 THEN
    throwCompilerError "EXPECTED VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)

  hasIndex = 0
  IF tokIdx < endIdx THEN
    IF lineTokenVals(tokIdx + 1) = 256 + ASC("(") THEN hasIndex = 1
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  isStrVar = 0
  IF returnedData3 = TYPE_STRING THEN
    isStrVar = 1
  END IF

  IF hasPrompt = 1 THEN
    pStr$ = promptStr$
  ELSE
    pStr$ = "? "
  END IF

  ff = resolveSymbol("!C_EVL_DSC_LTRL_" + _TRIM$(STR$(t.TiraVarCounter)))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_INPUT = 0
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN EXIT FUNCTION
  litIdx = returnedData2
  strVarData$(litIdx) = pStr$

  tira_Start

  litPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId litPtrIdx, TIRA_ARG_SYMBOL, litIdx

  tgtAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_SYMBOL, vIdx

  ff = resolveSymbol("RT_INPUT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId5 callFuncIdx, TIRA_ARG_SYMBOL, tgtAddrIdx, TIRA_ARG_LITERAL, isStrVar, TIRA_ARG_SYMBOL, litPtrIdx, TIRA_ARG_LITERAL, symbols(vIdx).DataType, TIRA_ARG_LITERAL, 0

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_INPUT = 1

END FUNCTION ' parse_INPUT

''''''''''''''''''''''''
FUNCTION parse_INPUT_STR$ (startIdx, endIdx, allowImplicit)

  DIM requestedCountType AS LONG
  DIM requestedCountVal AS _INTEGER64
  DIM readCountIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM writePtrIdx AS LONG
  DIM remainingIdx AS LONG
  DIM charValIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM invalidCountLblIdx AS LONG
  DIM validCountLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM waitKeyLblIdx AS LONG
  DIM headSymbolIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailSymbolIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM bufSymbolIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM getChFuncIdx AS LONG
  DIM sleepFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INPUT$", 3) = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "INPUT$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF
  requestedCountType = tiraParsedArgType
  requestedCountVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("INPUTSTR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  readCountIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId readCountIdx, requestedCountType, requestedCountVal

  invalidCountLblIdx = tiraLabelCreateNewId&("INPUTSTR_INVALID")
  validCountLblIdx = tiraLabelCreateNewId&("INPUTSTR_VALID")

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 1, invalidCountLblIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 32767, validCountLblIdx

  tiraLabelId invalidCountLblIdx
  tiraFatalErrorId "ILLEGAL FUNCTION CALL"

  tiraLabelId validCountLblIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, readCountIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_INPUT_STR$ = ""
    EXIT FUNCTION
  END IF

  writePtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId writePtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  remainingIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId remainingIdx, TIRA_ARG_SYMBOL, readCountIdx

  loopTopIdx = tiraLabelCreateNewId&("INPUTSTR_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("INPUTSTR_DONE")

  ' Present pending graphical output before waiting for a key
  tiraInjectPendingDisplayFlushId

  IF cm.HasGraphics = 0 THEN
    charValIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("IAT_GETCH")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    getChFuncIdx = returnedData2
  ELSE
    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)

    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    headSymbolIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, headSymbolIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    tailSymbolIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailSymbolIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    bufSymbolIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, bufSymbolIdx

    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    waitKeyLblIdx = tiraLabelCreateNewId&("INPUTSTR_WAIT")

    ff = resolveSymbol("IAT_SLEEP")
    IF ff = 0 THEN
      tira_Cancel
      parse_INPUT_STR$ = ""
      EXIT FUNCTION
    END IF
    sleepFuncIdx = returnedData2
  END IF

  tiraLabelId loopTopIdx

  IF cm.HasGraphics = 0 THEN
    tiraCallId0 getChFuncIdx
    tiraGetRetId charValIdx
  ELSE
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, waitKeyLblIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4
  END IF

  tiraWriteMemId TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_SYMBOL, writePtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, remainingIdx, TIRA_ARG_LITERAL, 0, loopTopIdx
  tiraJmpId loopDoneIdx

  IF cm.HasGraphics <> 0 THEN
    tiraLabelId waitKeyLblIdx
    tiraCallId1 sleepFuncIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId loopTopIdx
  END IF

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, readCountIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_INPUT_STR$ = scratchName$

END FUNCTION ' parse_INPUT_STR$

''''''''''''''''''''''''
FUNCTION parse_INKEY$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM headPtrIdx AS LONG
  DIM headValIdx AS LONG
  DIM tailPtrIdx AS LONG
  DIM tailValIdx AS LONG
  DIM emptyLblIdx AS LONG
  DIM bufPtrIdx AS LONG
  DIM charAddrIdx AS LONG
  DIM charValIdx AS LONG
  DIM allocPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM keyStateIdx AS LONG
  DIM extendedLblIdx AS LONG
  DIM secondValIdx AS LONG
  DIM secondAddrIdx AS LONG
  DIM kbHitIdx AS LONG
  DIM getChIdx AS LONG
  DIM kbdHeadIdx AS LONG
  DIM kbdTailIdx AS LONG
  DIM kbdBufIdx AS LONG

  IF startIdx <> endIdx THEN
    throwCompilerError "MALFORMED INKEY$", ASIS, 0
    parse_INKEY$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  scratchIdx = tiraResolveHoistVarId&("INKEY", "_DSC")
  IF scratchIdx = 0 THEN
    parse_INKEY$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_LITERAL, 0

  emptyLblIdx = tiraLabelCreateNewId&("INKEY_EMPTY")

  IF cm.HasGraphics = 0 THEN
    ' Poll the console keyboard queue without blocking
    ff = resolveSymbol("IAT_KBHIT")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbHitIdx = returnedData2
    tiraCallId0 kbHitIdx
    keyStateIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId keyStateIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, keyStateIdx, TIRA_ARG_LITERAL, 0, emptyLblIdx

    ' Retrieve the waiting character
    ff = resolveSymbol("IAT_GETCH")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    getChIdx = returnedData2
    tiraCallId0 getChIdx
    charValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId charValIdx

    ' Extended console keys begin with zero or 224
    extendedLblIdx = tiraLabelCreateNewId&("INKEY_EXTENDED")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, extendedLblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 224, extendedLblIdx

    ' Build a normal one-byte INKEY$ result
    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId emptyLblIdx

    ' Build the traditional two-byte extended-key result
    tiraLabelId extendedLblIdx

    tiraCallId0 getChIdx
    secondValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraGetRetId secondValIdx

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 2)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemId TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 1

    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 2
  ELSE
    ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdHeadIdx = returnedData2

    headPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, headPtrIdx, TIRA_ARG_SYMBOL, kbdHeadIdx
    headValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId headValIdx, TIRA_ARG_SYMBOL, headPtrIdx

    ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdTailIdx = returnedData2

    tailPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, kbdTailIdx
    tailValIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemId tailValIdx, TIRA_ARG_SYMBOL, tailPtrIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, headValIdx, TIRA_ARG_SYMBOL, tailValIdx, emptyLblIdx

    ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
    IF ff = 0 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    kbdBufIdx = returnedData2

    bufPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, kbdBufIdx

    charAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    charValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId charValIdx, TIRA_ARG_SYMBOL, charAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255

    ' Extended graphical keys are queued as CHR$(0), followed by a BIOS scan code
    extendedLblIdx = tiraLabelCreateNewId&("INKEY_GFX_EXTENDED")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 0, extendedLblIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 1)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, charValIdx, TIRA_ARG_LITERAL, 1
    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId emptyLblIdx

    tiraLabelId extendedLblIdx

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, bufPtrIdx, TIRA_ARG_SYMBOL, tailValIdx

    secondValIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId secondValIdx, TIRA_ARG_SYMBOL, secondAddrIdx

    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 1
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 255
    tiraWriteMemId TIRA_ARG_SYMBOL, tailPtrIdx, TIRA_ARG_SYMBOL, tailValIdx, TIRA_ARG_LITERAL, 4

    allocPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 2)
    IF compileError = 1 THEN
      tira_Cancel
      parse_INKEY$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, allocPtrIdx
    tiraWriteMemId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 1

    secondAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
    tiraWriteMemId TIRA_ARG_SYMBOL, secondAddrIdx, TIRA_ARG_SYMBOL, secondValIdx, TIRA_ARG_LITERAL, 1

    tiraAssignId strLenIdx, TIRA_ARG_LITERAL, 2
  END IF

  tiraLabelId emptyLblIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tiraInjectPendingDisplayFlushId

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_INKEY$ = scratchName$

END FUNCTION ' parse_INKEY$

''''''''''''''''''''''''
FUNCTION parse_INT$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM floatArgIdx AS LONG
  DIM floatTruncIdx AS LONG
  DIM skipDecLblIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "INT", 3) = 0 THEN
    parse_INT$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_INT$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("INT", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_INT$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraAssignId resVarIdx, arg1Type, arg1Val ' Truncates float to int naturally

  floatArgIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatArgIdx, arg1Type, arg1Val

  floatTruncIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId floatTruncIdx, TIRA_ARG_SYMBOL, resVarIdx

  skipDecLblIdx = tiraLabelCreateNewId&("SKIP_DEC")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, floatArgIdx, TIRA_ARG_SYMBOL, floatTruncIdx, skipDecLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipDecLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_INT$ = scratchName$

END FUNCTION ' parse_INT$

''''''''''''''''''''''''
FUNCTION parse_LEN$ (startIdx, endIdx, allowImplicit)

  DIM isVariableLen AS LONG
  DIM isRuntimeArray AS LONG
  DIM reqSize AS LONG
  DIM innerStart AS LONG
  DIM innerEnd AS LONG
  DIM firstChar AS STRING * 1
  DIM vIdx AS LONG
  DIM isMatch AS LONG
  DIM isArrayWhole AS LONG
  DIM hasArraySyntax AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM isValidSize AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM arg1$
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM firstTok$
  DIM vName$
  DIM lenVarIdx AS LONG
  DIM fixedLen AS LONG
  DIM isFound AS LONG
  DIM descriptorAddrIdx AS LONG
  DIM descriptorDimsIdx AS LONG
  DIM descriptorElemSizeIdx AS LONG
  DIM dimensionIndexIdx AS LONG
  DIM dimensionOffsetIdx AS LONG
  DIM dimensionAddrIdx AS LONG
  DIM dimensionElemsIdx AS LONG
  DIM dimensionLoopIdx AS LONG
  DIM dimensionDoneIdx AS LONG
  DIM runtimeDoneIdx AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LEN", 3) = 0 THEN
    parse_LEN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  innerStart = startIdx + 2
  innerEnd = endIdx - 1
  isVariableLen = 0
  isRuntimeArray = 0
  reqSize = 0

  firstTok$ = lineTokens$(innerStart)
  IF lineTokenVals(innerStart) = 0 THEN
    firstChar = LEFT$(firstTok$, 1)
    IF (firstChar >= "A" AND firstChar <= "Z") OR (firstChar >= "a" AND firstChar <= "z") OR firstChar = "_" THEN
      vName$ = UCASE$(firstTok$)
      isMatch = 0
      isArrayWhole = 0

      IF innerStart = innerEnd THEN
        isMatch = 1
      ELSE
        IF innerStart + 2 = innerEnd THEN
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") AND lineTokenVals(innerEnd) = 256 + ASC(")") THEN
            isMatch = 1
            isArrayWhole = 1
          END IF
        ELSE
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") THEN
            IF findMatchingParen(innerStart + 1, innerEnd) = 1 THEN
              IF returnedData2 = innerEnd THEN
                isMatch = 1
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isMatch = 1 THEN
        hasArraySyntax = 0
        IF innerStart < innerEnd THEN
          IF lineTokenVals(innerStart + 1) = 256 + ASC("(") THEN hasArraySyntax = 1
        END IF

        isFound = 0
        symbolCountBefore = symbolCount
        IF findSymbol(vName$) THEN
          isFound = 1
          vIdx = returnedData2
        ELSE
          IF allowImplicit = 1 THEN
            ff = resolveSymbol(vName$)
            IF ff = 1 THEN
              isFound = 1
              vIdx = returnedData2
            END IF
          END IF
        END IF

        IF isFound = 1 THEN
          wasNewSymbol = 0
          IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

          IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
            IF symbols(vIdx).SubIndex = 0 THEN
              IF hasArraySyntax = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
                IF wasNewSymbol = 1 THEN
                  throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
                ELSE
                  throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
                END IF
                parse_LEN$ = ""
                EXIT FUNCTION
              END IF

              IF hasArraySyntax = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
                throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
                parse_LEN$ = ""
                EXIT FUNCTION
              END IF
            END IF
          END IF

          dt = symbols(vIdx).DataType
          elemSize = retElementByteSize(vIdx)
          isValidSize = 1

          IF dt = TYPE_STRING THEN
            fixedLen = retFixeSTRINGDLength(vIdx)
            IF fixedLen = 0 THEN
              isValidSize = 0
              elemSize = 0
            END IF
          END IF

          IF isArrayWhole = 1 THEN
            IF symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
              throwCompilerErrorAndCancelTira "EXPECTED ARRAY", ASIS, 0
              parse_LEN$ = ""
              EXIT FUNCTION
            END IF
            IF isValidSize = 0 THEN
              throwCompilerErrorAndCancelTira "CANNOT USE LEN ON DYNAMIC STRING ARRAY", ASIS, 0
              parse_LEN$ = ""
              EXIT FUNCTION
            END IF

            SELECT CASE symbols(vIdx).IsArray

              CASE ARRAY_KIND_STATIC
                reqSize = elemSize * symbols(vIdx).Size
                isVariableLen = 1

              CASE ARRAY_KIND_RUNTIME
                isRuntimeArray = 1

              CASE ELSE
                throwCompilerErrorAndCancelTira "INVALID ARRAY KIND", ASIS, 0
                parse_LEN$ = ""
                EXIT FUNCTION

            END SELECT
          ELSE
            IF dt <> TYPE_STRING THEN
              reqSize = elemSize
              isVariableLen = 1
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("LEN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_LEN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  IF isRuntimeArray = 1 THEN
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

    descriptorAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, vIdx

    descriptorDimsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId descriptorDimsIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 12

    runtimeDoneIdx = tiraLabelCreateNewId&("LEN_ARRAY_DONE")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimsIdx, TIRA_ARG_LITERAL, 0, runtimeDoneIdx

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 1

    dimensionIndexIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId dimensionIndexIdx, TIRA_ARG_LITERAL, 0

    dimensionLoopIdx = tiraLabelCreateNewId&("LEN_DIM_LOOP")
    dimensionDoneIdx = tiraLabelCreateNewId&("LEN_DIM_DONE")

    tiraLabelId dimensionLoopIdx
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, descriptorDimsIdx, dimensionDoneIdx

    dimensionOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 8
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_LITERAL, 16

    dimensionAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionAddrIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx

    dimensionElemsIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId dimensionElemsIdx, TIRA_ARG_SYMBOL, dimensionAddrIdx, 4

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, dimensionElemsIdx
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 1
    tiraJmpId dimensionLoopIdx

    tiraLabelId dimensionDoneIdx

    descriptorElemSizeIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraReadMemOffsetId descriptorElemSizeIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 8

    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, descriptorElemSizeIdx

    tiraLabelId runtimeDoneIdx
  ELSE
    IF isVariableLen = 1 THEN
      tiraAssignId resVarIdx, TIRA_ARG_LITERAL, reqSize
    ELSE
      ff = tiraParseExpressionId(innerStart, innerEnd, allowImplicit)
      IF ff = 0 THEN
        tira_Cancel
        parse_LEN$ = ""
        EXIT FUNCTION
      END IF
      arg1Type = tiraParsedArgType
      arg1Val = tiraParsedArgVal
      IF exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "LEN REQUIRES STRING ARGUMENT", ASIS, 0
        parse_LEN$ = ""
        EXIT FUNCTION
      END IF

      lenVarIdx = tiraGetStringLenId&(arg1Type, arg1Val)
      tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, lenVarIdx
    END IF
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LEN$ = scratchName$

END FUNCTION ' parse_LEN$

''''''''''''''''''''''''
FUNCTION parse_LOCATE (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM maxX AS LONG
  DIM maxY AS LONG
  DIM textRowHeight AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM yType AS LONG
  DIM yVal AS _INTEGER64
  DIM xType AS LONG
  DIM xVal AS _INTEGER64
  DIM hasY AS LONG
  DIM hasX AS LONG
  DIM textYIdx AS LONG
  DIM textXIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM getConsoleInfoIdx AS LONG
  DIM setConsoleCursorIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM csbiIdx AS LONG
  DIM coordVarIdx AS LONG
  DIM maxYType AS LONG
  DIM maxYVal AS _INTEGER64
  DIM maxYVarIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM lblErrorIdx AS LONG
  DIM yZeroIdx AS LONG
  DIM xZeroIdx AS LONG
  DIM hndVar2Idx AS LONG
  DIM packedYIdx AS LONG
  DIM cleanXIdx AS LONG
  DIM coordIdx AS LONG

  endIdx = lineTokenCount - 1

  textRowHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16

  END SELECT ' compileScreenMode

  commaIdx = findComma(startIdx + 1, endIdx)

  tira_Start

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fontHeightGlobalIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textYIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textXIdx = returnedData2

    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("LOCATE_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx
  ELSE
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setConsoleCursorIdx = returnedData2
  END IF

  hasY = 0
  hasX = 0

  IF commaIdx = 0 THEN
    IF startIdx + 1 <= endIdx THEN
      ff = tiraParseExpressionIntArgId(startIdx + 1, endIdx, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      yType = tiraParsedArgType
      yVal = tiraParsedArgVal
      hasY = 1
    END IF
  ELSE
    IF commaIdx > startIdx + 1 THEN
      ff = tiraParseExpressionIntArgId(startIdx + 1, commaIdx - 1, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      yType = tiraParsedArgType
      yVal = tiraParsedArgVal
      hasY = 1
    END IF
    IF commaIdx < endIdx THEN
      ff = tiraParseExpressionIntArgId(commaIdx + 1, endIdx, ALIM, "LOCATE REQUIRES NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      xType = tiraParsedArgType
      xVal = tiraParsedArgVal
      hasX = 1
    END IF
  END IF

  ' Support omitted arguments (e.g., LOCATE , 10) by fetching the current coordinate
  IF hasY = 0 OR hasX = 0 THEN
    IF cm.HasGraphics = 1 THEN
      IF hasY = 0 THEN
        yVal = tiraDimVarId&("T", TYPE_LONG)
        yType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, fontHeightIdx
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_LITERAL, 1
      END IF
      IF hasX = 0 THEN
        xVal = tiraDimVarId&("T", TYPE_LONG)
        xType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_LITERAL, 8
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_LITERAL, 1
      END IF
    ELSE
      ff = resolveSymbol("IAT_GETCONSOLESCREENBUFFERINFO")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      getConsoleInfoIdx = returnedData2

      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx

      csbiIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 24)
      IF compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraCallId2 getConsoleInfoIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, csbiIdx
      coordVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraReadMemOffsetId coordVarIdx, TIRA_ARG_SYMBOL, csbiIdx, 4

      IF hasY = 0 THEN
        yVal = tiraDimVarId&("T", TYPE_LONG)
        yType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 16
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_SYMBOL, yVal, TIRA_ARG_LITERAL, 1
      END IF
      IF hasX = 0 THEN
        xVal = tiraDimVarId&("T", TYPE_LONG)
        xType = TIRA_ARG_SYMBOL
        tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, coordVarIdx, TIRA_ARG_LITERAL, 65535
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_SYMBOL, xVal, TIRA_ARG_LITERAL, 1
      END IF
    END IF
  END IF

  maxX = 120
  maxY = 25
  maxYType = TIRA_ARG_LITERAL
  maxYVal = maxY

  IF cm.HasGraphics = 1 THEN
    maxX = gfxConfig.SizeX \ 8

    maxYVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId maxYVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
    tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, maxYVarIdx, TIRA_ARG_SYMBOL, maxYVarIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    maxYType = TIRA_ARG_SYMBOL
    maxYVal = maxYVarIdx
  END IF

  lblValidIdx = tiraLabelCreateNewId&("LOCATE_VALID")
  lblErrorIdx = tiraLabelCreateNewId&("LOCATE_ERR")

  tiraJmpCondId JCC_JL, yType, yVal, TIRA_ARG_LITERAL, 1, lblErrorIdx
  tiraJmpCondId JCC_JG, yType, yVal, maxYType, maxYVal, lblErrorIdx
  tiraJmpCondId JCC_JL, xType, xVal, TIRA_ARG_LITERAL, 1, lblErrorIdx
  tiraJmpCondId JCC_JG, xType, xVal, TIRA_ARG_LITERAL, maxX, lblErrorIdx

  tiraJmpId lblValidIdx

  tiraLabelId lblErrorIdx
  tiraFatalErrorId "LOCATE ATTEMPTED OFF SCREEN"

  tiraLabelId lblValidIdx

  yZeroIdx = tiraDimVarId&("T", TYPE_LONG)
  xZeroIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, yZeroIdx, yType, yVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, xZeroIdx, xType, xVal, TIRA_ARG_LITERAL, 1

  IF cm.HasGraphics = 1 THEN
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, textYIdx, TIRA_ARG_SYMBOL, yZeroIdx, TIRA_ARG_SYMBOL, fontHeightIdx
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, textXIdx, TIRA_ARG_SYMBOL, xZeroIdx, TIRA_ARG_LITERAL, 3
  ELSE
    hndVar2Idx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
    tiraGetRetId hndVar2Idx

    packedYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, yZeroIdx, TIRA_ARG_LITERAL, 16

    cleanXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cleanXIdx, TIRA_ARG_SYMBOL, xZeroIdx, TIRA_ARG_LITERAL, 65535

    coordIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, coordIdx, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, cleanXIdx

    tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVar2Idx, TIRA_ARG_SYMBOL, coordIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LOCATE = 1

END FUNCTION ' parse_LOCATE

''''''''''''''''''''''''
FUNCTION parse_LOOP (startIdx)

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM hasCond AS LONG
  DIM tVal AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "LOOP WITHOUT DO", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_DO THEN
    throwCompilerError "LOOP MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrlCount = ctrlCount - 1
  loopID = ctrls(ctrlCount).Patch1

  topLbl$ = "@DO_TOP_" + _TRIM$(STR$(loopID))
  doneLbl$ = "@DO_DONE_" + _TRIM$(STR$(loopID))

  hasCond = 0

  IF endIdx > startIdx THEN
    tVal = lineTokenVals(startIdx + 1)
    IF tVal = TOK_UNTIL OR tVal = TOK_WHILE THEN
      hasCond = 1
    ELSE
      throwCompilerError "EXPECTED UNTIL OR WHILE", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  resetLbl$ = "@DO_RESET_" + _TRIM$(STR$(loopID))

  tira_Start

  IF hasCond = 1 THEN
    ff = tiraParseExpressionNumericArgId(startIdx + 2, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    exprVarType = tiraParsedArgType
    exprVarVal = tiraParsedArgVal

    ff = resolveSymbol(doneLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    doneLblIdx = returnedData2

    IF tVal = TOK_UNTIL THEN
      tiraJmpCondId JCC_JNE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    ELSE
      tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx
    END IF

    tiraScheduleHeapResetId

    ff = resolveSymbol(topLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx
  ELSE
    tiraScheduleHeapResetId

    ff = resolveSymbol(topLbl$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx
  END IF

  ' Anchor the end of the loop in the TIRA symbol table
  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2
  tiraLabelId doneLblIdx

  tiraScheduleHeapResetId

  tira_EndAndProcess

  parse_LOOP = 1

END FUNCTION ' parse_LOOP

''''''''''''''''''''''''
FUNCTION parse_LTRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM origPtrIdx AS LONG
  DIM origLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpaceLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LTRIM$", 3) = 0 THEN
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LTRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("LTRIM", "_DSC")
  IF scratchIdx = 0 THEN
    parse_LTRIM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  origPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  origLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, origPtrIdx
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, origLenIdx

  loopTopIdx = tiraLabelCreateNewId&("LTRIM_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("LTRIM_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  isSpaceLblIdx = tiraLabelCreateNewId&("LTRIM_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopDoneIdx
  tiraLabelId isSpaceLblIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LTRIM$ = scratchName$

END FUNCTION ' parse_LTRIM$

''''''''''''''''''''''''
FUNCTION parse_KEYDOWN$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_KEYDOWN", 3) = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("KEYDOWN", "_VAL")
  IF scratchIdx = 0 THEN
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ff = resolveSymbol("RT_KEYDOWN")
  IF ff = 0 THEN
    tira_Cancel
    parse_KEYDOWN$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraInjectPendingDisplayFlushId

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_KEYDOWN$ = scratchName$

END FUNCTION ' parse_KEYDOWN$

''''''''''''''''''''''''

''''''''''''''''''''''''
FUNCTION parse_MID$ (startIdx, endIdx, allowImplicit)

  DIM arg1$
  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM arg2$
  DIM arg2Type AS LONG
  DIM arg2Val AS _INTEGER64
  DIM arg3$
  DIM arg3Type AS LONG
  DIM arg3Val AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLen$
  DIM strLenIdx AS LONG
  DIM startIdxVarIdx AS LONG
  DIM remLenIdx AS LONG
  DIM safeLenIdx AS LONG
  DIM dataPtr$
  DIM dataPtrIdx AS LONG
  DIM descPtr$
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "MID$", 5) = 0 THEN
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  IF comma1 = 0 THEN
    throwCompilerError "MALFORMED MID$", ASIS, 0
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, comma1 - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_MID$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "MID$ ARG 1 MUST BE STRING", ASIS, 0
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    ff = tiraParseExpressionIntArgId(comma1 + 1, comma2 - 1, allowImplicit, "MID$ ARG 2 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal

    ff = tiraParseExpressionIntArgId(comma2 + 1, endIdx - 1, allowImplicit, "MID$ ARG 3 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg3Type = tiraParsedArgType
    arg3Val = tiraParsedArgVal
  ELSE
    ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx - 1, allowImplicit, "MID$ ARG 2 MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_MID$ = ""
      EXIT FUNCTION
    END IF
    arg2Type = tiraParsedArgType
    arg2Val = tiraParsedArgVal
    arg3Type = TIRA_ARG_LITERAL
    arg3Val = &H7FFFFFFF ' Max integer length to act as missing arg
  END IF

  scratchIdx = tiraResolveHoistVarId&("MID", "_DSC")
  IF scratchIdx = 0 THEN
    parse_MID$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  startIdxVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, startIdxVarIdx, arg2Type, arg2Val, TIRA_ARG_LITERAL, 1

  tiraClampId startIdxVarIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, strLenIdx

  remLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, remLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, startIdxVarIdx

  safeLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId safeLenIdx, arg3Type, arg3Val
  tiraClampId remLenIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, safeLenIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, startIdxVarIdx
  tiraAssignId strLenIdx, TIRA_ARG_SYMBOL, remLenIdx

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MID$ = ""
    EXIT FUNCTION
  END IF

  tiraMemcpyId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, srcPtrIdx, TIRA_ARG_SYMBOL, strLenIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_MID$ = scratchName$

END FUNCTION ' parse_MID$

''''''''''''''''''''''''
FUNCTION parse_NEXT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM parenDepth AS LONG
  DIM closeCount AS LONG
  DIM ctrlIdx AS LONG
  DIM closeIdx AS LONG
  DIM vIdx AS LONG
  DIM loopID AS LONG
  DIM endVarIdx AS LONG
  DIM stepVarIdx AS LONG
  DIM topLblIdx AS LONG
  DIM condLblIdx AS LONG
  DIM posStepLblIdx AS LONG
  DIM negStepLblIdx AS LONG
  DIM endNextLblIdx AS LONG

  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "NEXT WITHOUT FOR", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  closeCount = 0

  DO

    ctrlIdx = ctrlCount - closeCount - 1

    IF ctrlIdx < 0 THEN
      throwCompilerError "NEXT WITHOUT FOR", ASIS, 0
      EXIT FUNCTION
    END IF

    IF ctrls(ctrlIdx).TYPE <> CTRL_FOR THEN
      throwCompilerError "NEXT MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

    vIdx = ctrls(ctrlIdx).ForVarIdx

    IF endIdx > startIdx THEN
      parenDepth = 0

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
          parenDepth = parenDepth + 1
          tokIdx = tokIdx + 1
        ELSE
          EXIT DO
        END IF
      LOOP

      IF tokIdx > endIdx THEN
        throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF

      vTok$ = lineTokens$(tokIdx)
      baseName$ = UCASE$(vTok$)
      tokIdx = tokIdx + 1

      ' Handle legacy dot variables securely
      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          IF findSymbol(baseName$) THEN
            IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
          END IF
          IF cm.ClassicMode = 1 THEN
            IF tokIdx + 1 <= endIdx THEN
              baseName$ = baseName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
              tokIdx = tokIdx + 2
            ELSE
              EXIT DO
            END IF
          ELSE
            throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
            addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN
          parenDepth = parenDepth - 1
          tokIdx = tokIdx + 1
        ELSE
          EXIT DO
        END IF
      LOOP

      IF parenDepth <> 0 THEN
        throwCompilerError "UNMATCHED PARENTHESIS IN NEXT", ASIS, 0
        EXIT FUNCTION
      END IF

      IF baseName$ <> RTRIM$(symbols(vIdx).RecordName) THEN
        throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    closeCount = closeCount + 1

    IF endIdx = startIdx THEN EXIT DO
    IF tokIdx > endIdx THEN EXIT DO

    IF lineTokenVals(tokIdx) <> 256 + ASC(",") THEN
      throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1

    IF tokIdx > endIdx THEN
      throwCompilerError "NEXT VAR MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF

  LOOP

  tira_Start

  FOR closeIdx = 1 TO closeCount

    ctrlCount = ctrlCount - 1
    vIdx = ctrls(ctrlCount).ForVarIdx
    loopID = ctrls(ctrlCount).Patch1

    endNameTira$ = "!C_SYS_VAL_FOR_END_" + _TRIM$(STR$(loopID))
    ff = resolveSymbol(endNameTira$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endVarIdx = returnedData2

    stepNameTira$ = "!C_SYS_VAL_FOR_STEP_" + _TRIM$(STR$(loopID))
    ff = resolveSymbol(stepNameTira$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    stepVarIdx = returnedData2

    lblTop$ = "@FOR_TOP_" + _TRIM$(STR$(loopID))
    lblCond$ = "@FOR_COND_" + _TRIM$(STR$(loopID))
    lblPosStep$ = "@FOR_POS_" + _TRIM$(STR$(loopID))
    lblNegStep$ = "@FOR_NEG_" + _TRIM$(STR$(loopID))
    lblEndNext$ = "@FOR_DONE_" + _TRIM$(STR$(loopID))

    ' Apply step logic
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, stepVarIdx

    ff = resolveSymbol(lblCond$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    condLblIdx = returnedData2
    tiraLabelId condLblIdx

    ' Test step direction
    ff = resolveSymbol(lblNegStep$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    negStepLblIdx = returnedData2
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, stepVarIdx, TIRA_ARG_LITERAL, 0, negStepLblIdx

    ' Positive Step Check (Jump to end if we exceeded the boundary)
    ff = resolveSymbol(lblPosStep$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    posStepLblIdx = returnedData2
    tiraLabelId posStepLblIdx

    ff = resolveSymbol(lblEndNext$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endNextLblIdx = returnedData2
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, endVarIdx, endNextLblIdx
    tiraScheduleHeapResetId

    ff = resolveSymbol(lblTop$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    topLblIdx = returnedData2
    tiraJmpId topLblIdx

    ' Negative Step Check (Jump to end if we exceeded the boundary)
    tiraLabelId negStepLblIdx
    tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_SYMBOL, endVarIdx, endNextLblIdx
    tiraScheduleHeapResetId
    tiraJmpId topLblIdx

    ' Loop conclusion
    tiraLabelId endNextLblIdx
    tiraScheduleHeapResetId

  NEXT closeIdx

  tira_EndAndProcess

  parse_NEXT = 1

END FUNCTION ' parse_NEXT

''''''''''''''''''''''''
FUNCTION parse_OFFSET$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM addrVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_OFFSET", 3) = 0 THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Support dot variable syntax gracefully to map cleanly with older structural integrations
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN _OFFSET", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN _OFFSET", ASIS, 0
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_OFFSET$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayArgsId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("OFFSET", "_PTR")
  IF scratchIdx = 0 THEN
    parse_OFFSET$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF hasIndex = 0 AND hasField = 0 THEN
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
  ELSE
    addrVarIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, udtOffset)
    IF compileError = 1 THEN
      tira_Cancel
      parse_OFFSET$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, addrVarIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_OFFSET$ = scratchName$

END FUNCTION ' parse_OFFSET$

''''''''''''''''''''''''
FUNCTION parse_ON (startIdx)

  DIM endIdx AS LONG
  DIM closeParen AS LONG
  DIM targetLabelIdx AS LONG
  DIM eventNumberType AS LONG
  DIM eventNumberVal AS _INTEGER64
  DIM invalidKeyLblIdx AS LONG
  DIM validKeyLblIdx AS LONG
  DIM eventIndexIdx AS LONG
  DIM keyHandlerIdx AS LONG
  DIM handlerBaseIdx AS LONG
  DIM handlerSlotIdx AS LONG
  DIM handlerAddressIdx AS LONG
  DIM errorLabelIdx AS LONG
  DIM errorHandlerIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx >= startIdx + 1 THEN
    IF lineTokenVals(startIdx + 1) = TOK_KEY THEN
      IF endIdx < startIdx + 4 THEN
        throwCompilerError "MALFORMED ON KEY STATEMENT", ASIS, 0
        EXIT FUNCTION
      END IF

      IF lineTokenVals(startIdx + 2) <> TOK_OP_LPAREN THEN
        throwCompilerError "ON KEY REQUIRES (n)", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = findMatchingParen(startIdx + 2, endIdx)
      IF ff = 0 THEN
        throwCompilerError "ON KEY MISSING )", ASIS, 0
        EXIT FUNCTION
      END IF
      closeParen = returnedData2

      IF closeParen <= startIdx + 3 THEN
        throwCompilerError "ON KEY REQUIRES EVENT NUMBER", ASIS, 0
        EXIT FUNCTION
      END IF

      IF closeParen >= endIdx THEN
        throwCompilerError "ON KEY REQUIRES GOSUB LABEL", ASIS, 0
        EXIT FUNCTION
      END IF

      IF lineTokenVals(closeParen + 1) <> TOK_GOSUB THEN
        throwCompilerError "ON KEY CURRENTLY REQUIRES GOSUB", ASIS, 0
        EXIT FUNCTION
      END IF

      IF closeParen + 2 > endIdx THEN
        throwCompilerError "ON KEY GOSUB NEEDS LABEL", ASIS, 0
        EXIT FUNCTION
      END IF

      ff = verifyNoExtraTokens(endIdx, closeParen + 2, "ON KEY GOSUB")
      IF ff = 0 THEN EXIT FUNCTION

      targetTok$ = lineTokens$(closeParen + 2)
      targetLabelName$ = "%" + UCASE$(targetTok$)

      expectedSymType = TYPE_LABEL
      ff = resolveSymbol(targetLabelName$)
      IF ff = 0 THEN EXIT FUNCTION
      targetLabelIdx = returnedData2

      ensureKeyEventSymbols
      IF compileError = 1 THEN EXIT FUNCTION

      rtIsUsed(RT_KEY_EVENT) = 1

      tira_Start

      ff = tiraParseExpressionIntArgId(startIdx + 3, closeParen - 1, ALIM, "ON KEY EVENT NUMBER MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      eventNumberType = tiraParsedArgType
      eventNumberVal = tiraParsedArgVal

      invalidKeyLblIdx = tiraLabelCreateNewId&("ON_KEY_NUMBER_INVALID")
      validKeyLblIdx = tiraLabelCreateNewId&("ON_KEY_NUMBER_VALID")

      tiraJmpCondId JCC_JL, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, 1, invalidKeyLblIdx
      tiraJmpCondId JCC_JLE, eventNumberType, eventNumberVal, TIRA_ARG_LITERAL, KEY_EVENT_COUNT, validKeyLblIdx

      tiraLabelId invalidKeyLblIdx
      tiraFatalErrorId "ILLEGAL FUNCTION CALL"

      tiraLabelId validKeyLblIdx

      eventIndexIdx = tiraDimVarId&("T", TYPE_UINT64)
      tiraAssignId eventIndexIdx, eventNumberType, eventNumberVal
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, 1

      ff = resolveSymbol("!G_INO_ARR_KEYHANDLER")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      keyHandlerIdx = returnedData2

      handlerBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlerBaseIdx, TIRA_ARG_SYMBOL, keyHandlerIdx

      handlerSlotIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, handlerSlotIdx, TIRA_ARG_SYMBOL, handlerBaseIdx, TIRA_ARG_SYMBOL, eventIndexIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

      handlerAddressIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, handlerAddressIdx, TIRA_ARG_LABEL, targetLabelIdx
      tiraWriteMemId TIRA_ARG_SYMBOL, handlerSlotIdx, TIRA_ARG_SYMBOL, handlerAddressIdx, TIRA_ARG_LITERAL, KEY_EVENT_SLOT_BYTES

      tiraScheduleHeapResetId
      tira_EndAndProcess

      parse_ON = 1
      EXIT FUNCTION
    END IF
  END IF

  IF endIdx >= startIdx + 3 THEN
    IF lineTokenVals(startIdx + 1) = TOK_ERROR THEN
      IF lineTokenVals(startIdx + 2) = TOK_GOTO THEN
        ff = verifyNoExtraTokens(endIdx, startIdx + 3, "ON ERROR GOTO")
        IF ff = 0 THEN EXIT FUNCTION

        lblTok$ = lineTokens$(startIdx + 3)

        tira_Start

        IF lblTok$ <> "0" THEN
          lblName$ = "%" + UCASE$(lblTok$)
          ff = resolveSymbol(lblName$)
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorLabelIdx = returnedData2

          ff = resolveSymbol("!G_ERR_PTR_HANDLER")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorHandlerIdx = returnedData2

          tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, errorHandlerIdx, TIRA_ARG_LABEL, errorLabelIdx
        ELSE
          ff = resolveSymbol("!G_ERR_PTR_HANDLER")
          IF ff = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF
          errorHandlerIdx = returnedData2

          tiraAssignId errorHandlerIdx, TIRA_ARG_LITERAL, 0
        END IF

        tiraScheduleHeapResetId
        tira_EndAndProcess

        parse_ON = 1
        EXIT FUNCTION
      END IF
    END IF
  END IF

  throwCompilerError "UNSUPPORTED OR MALFORMED ON STATEMENT", ASIS, 0

END FUNCTION ' parse_ON

''''''''''''''''''''''''
FUNCTION parse_OUT (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM portVarType AS LONG
  DIM portVarVal AS _INTEGER64
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "OUT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  commaIdx = findComma(startIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerError "OUT REQUIRES PORT AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 1, commaIdx - 1, ALIM, "PORT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  portVarType = tiraParsedArgType
  portVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(commaIdx + 1, endIdx, ALIM, "VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_OUT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, portVarType, portVarVal, valVarType, valVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_OUT = 1

END FUNCTION ' parse_OUT

''''''''''''''''''''''''
FUNCTION parse_PEEK$ (startIdx, endIdx, allowImplicit)

  ' This function evaluates the peek command to read data from memory
  ' Address 1047 emulates the legacy DOS keyboard flags byte
  ' Address 1132 emulates the low byte of the BIOS timer tick counter

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM checkTimerLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM stateVarIdx AS LONG
  DIM flagsVarIdx AS LONG
  DIM tickVarIdx AS LONG
  DIM elapsedVarIdx AS LONG
  DIM timerLblIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM pixelVarIdx AS LONG
  DIM graphicsDoneLblIdx AS LONG
  DIM getAsyncKeyStateIdx AS LONG
  DIM getKeyStateIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM peekTickIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "PEEK", 3) = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ' Evaluate the memory address argument passed to the peek function
  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "PEEK REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("PEEK", "_VAL")
  IF scratchIdx = 0 THEN
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Initialize the return variable with a default value of zero for any unhandled memory addresses
  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  ' Check the keyboard flags compatibility address first
  checkTimerLblIdx = tiraLabelCreateNewId&("CHECK_PEEK_TIMER")
  doneLblIdx = tiraLabelCreateNewId&("DONE_PEEK")
  tiraJmpCondId JCC_JNE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1047, checkTimerLblIdx

  ' Build the complete BIOS keyboard flags byte used by classic programs
  flagsVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId flagsVarIdx, TIRA_ARG_LITERAL, 0

  ' Bit zero reports the right Shift key
  ff = resolveSymbol("IAT_GETASYNCKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getAsyncKeyStateIdx = returnedData2
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 161
  stateVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 15
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit one reports the left Shift key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 160
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 14
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit two reports either Control key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 17
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 13
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit three reports either Alt key
  tiraCallId1 getAsyncKeyStateIdx, TIRA_ARG_LITERAL, 18
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 32768
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 12
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit four reports the Scroll Lock toggle state
  ff = resolveSymbol("IAT_GETKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getKeyStateIdx = returnedData2
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 145
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 4
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Ask windows for the actual state of the numlock key
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 144
  tiraGetRetId stateVarIdx

  ' Mask out all but the lowest bit to get the clean toggle state
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1

  ' Shift the bit left into the bit five position to emulate the legacy keyboard flag
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 5
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit six reports the Caps Lock toggle state
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 20
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 6
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Bit seven reports the Insert toggle state
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 45
  tiraGetRetId stateVarIdx
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_SYMBOL, stateVarIdx, TIRA_ARG_LITERAL, 7
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx, TIRA_ARG_SYMBOL, stateVarIdx

  ' Assign the emulated flag byte to the return variable
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, flagsVarIdx
  tiraJmpId doneLblIdx

  tiraLabelId checkTimerLblIdx

  timerLblIdx = tiraLabelCreateNewId&("PEEK_TIMER")
  tiraJmpCondId JCC_JE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 1132, timerLblIdx

  IF cm.HasGraphics = 1 THEN
    ' Graphics PEEK addresses are linear offsets into the active destination framebuffer
    offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, offsetVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 65535

    graphicsDoneLblIdx = tiraLabelCreateNewId&("PEEK_GRAPHICS_DONE")

    ' Bytes in the unused tail of the 64K graphics segment read back as zero
    tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY, graphicsDoneLblIdx

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      parse_PEEK$ = ""
      EXIT FUNCTION
    END IF
    gfxDestIdx = returnedData2

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

    targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    pixelVarIdx = tiraDimVarId&("T", TYPE_UBYTE)
    tiraReadMemId pixelVarIdx, TIRA_ARG_SYMBOL, targetAddrIdx
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, pixelVarIdx
    tiraJmpId graphicsDoneLblIdx

    tiraLabelId graphicsDoneLblIdx
  END IF

  ' Leave unhandled addresses at the default value of zero
  tiraJmpId doneLblIdx

  tiraLabelId timerLblIdx

  ' Convert milliseconds since the matching POKE reset into approximately 18.2 BIOS ticks per second
  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  getTickCountIdx = returnedData2
  tiraCallId0 getTickCountIdx
  tickVarIdx = tiraDimVarId&("T", TYPE_ULONG)
  tiraGetRetId tickVarIdx

  ff = resolveSymbol("!G_SYS_VAL_PEEK1132_TICK")
  IF ff = 0 THEN
    tira_Cancel
    parse_PEEK$ = ""
    EXIT FUNCTION
  END IF
  peekTickIdx = returnedData2

  elapsedVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, tickVarIdx, TIRA_ARG_SYMBOL, peekTickIdx
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_LITERAL, 55

  ' PEEK returns a byte, matching the low byte stored at BIOS data address 1132
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx, TIRA_ARG_LITERAL, 255
  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, elapsedVarIdx

  tiraLabelId doneLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_PEEK$ = scratchName$

END FUNCTION ' parse_PEEK$

''''''''''''''''''''''''
FUNCTION parse_POKE (startIdx)

  ' This function evaluates the poke command to write data into memory
  ' Rather than exposing direct memory access which would crash a modern operating system
  ' specific features are emulated, such as address 1047. In legacy dos systems, address 1047 holds
  ' the keyboard flags where the bit representing 32 controls the numlock state
  ' If the user script tries to write to 1047, we extract the requested numlock state
  ' and use the windows api to simulate physical key presses if the state needs to change

  DIM commaIdx AS LONG
  DIM addrVarType AS LONG
  DIM addrVarVal AS _INTEGER64
  DIM valVarType AS LONG
  DIM valVarVal AS _INTEGER64
  DIM skipLblIdx AS LONG
  DIM desiredIdx AS LONG
  DIM currentIdx AS LONG
  DIM getKeyStateIdx AS LONG
  DIM keybdEventIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx = 0 THEN
    throwCompilerError "POKE MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ' Evaluate the address and value arguments provided by the user script
  ff = tiraParseExpressionIntArgId(startIdx + 1, commaIdx - 1, ALIM, "POKE ADDRESS MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  addrVarType = tiraParsedArgType
  addrVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(commaIdx + 1, endIdx, ALIM, "POKE VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  valVarType = tiraParsedArgType
  valVarVal = tiraParsedArgVal

  ' Create a jump label to skip the emulation block if the address is not exactly 1047
  skipLblIdx = tiraLabelCreateNewId&("SKIP_POKE")
  tiraJmpCondId JCC_JNE, addrVarType, addrVarVal, TIRA_ARG_LITERAL, 1047, skipLblIdx

  ' Extract the target state by masking out the thirty two bit and shifting it down to the lowest bit position
  desiredIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, desiredIdx, valVarType, valVarVal, TIRA_ARG_LITERAL, 32
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_LITERAL, 5

  ' Ask windows for the current hardware state of the numlock key using its virtual key code
  ff = resolveSymbol("IAT_GETKEYSTATE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  getKeyStateIdx = returnedData2
  tiraCallId1 getKeyStateIdx, TIRA_ARG_LITERAL, 144
  currentIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraGetRetId currentIdx

  ' Mask the windows return value to isolate just the active toggle state bit
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, currentIdx, TIRA_ARG_SYMBOL, currentIdx, TIRA_ARG_LITERAL, 1

  ' Compare the requested state with the current hardware state and jump past the toggle event if they match
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, desiredIdx, TIRA_ARG_SYMBOL, currentIdx, skipLblIdx

  ' Fire down and up keyboard events to physically toggle the numlock key at the hardware level
  ff = resolveSymbol("IAT_KEYBD_EVENT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  keybdEventIdx = returnedData2
  tiraCallId4 keybdEventIdx, TIRA_ARG_LITERAL, 144, TIRA_ARG_LITERAL, 69, TIRA_ARG_LITERAL, 1, TIRA_ARG_LITERAL, 0
  tiraCallId4 keybdEventIdx, TIRA_ARG_LITERAL, 144, TIRA_ARG_LITERAL, 69, TIRA_ARG_LITERAL, 3, TIRA_ARG_LITERAL, 0

  tiraLabelId skipLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_POKE = 1

END FUNCTION ' parse_POKE

''''''''''''''''''''''''
FUNCTION parse_POKE_Compat (startIdx)

  ' Preserve the ignored POKE behavior except for the literal BIOS timer reset used by legacy timer polling code
  ' Graphics framebuffer offsets are additionally supported for classic screen compatibility

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM addrStartIdx AS LONG
  DIM addrEndIdx AS LONG
  DIM valueStartIdx AS LONG
  DIM valueEndIdx AS LONG
  DIM isTimerReset AS LONG
  DIM addrVarType AS LONG
  DIM addrVarVal AS _INTEGER64
  DIM valueVarType AS LONG
  DIM valueVarVal AS _INTEGER64
  DIM offsetVarIdx AS LONG
  DIM byteVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM donePokeLblIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM getTickCountIdx AS LONG
  DIM tickVarIdx AS LONG
  DIM peekTickIdx AS LONG

  endIdx = lineTokenCount - 1
  commaIdx = findComma(startIdx + 1, endIdx)
  isTimerReset = 0

  IF commaIdx > 0 THEN
    addrStartIdx = startIdx + 1
    addrEndIdx = commaIdx - 1
    valueStartIdx = commaIdx + 1
    valueEndIdx = endIdx

    ' Accept either POKE 1132, 0 or POKE (1132), 0
    IF addrStartIdx < addrEndIdx THEN
      IF lineTokenVals(addrStartIdx) = 256 + ASC("(") AND lineTokenVals(addrEndIdx) = 256 + ASC(")") THEN
        addrStartIdx = addrStartIdx + 1
        addrEndIdx = addrEndIdx - 1
      END IF
    END IF

    IF valueStartIdx < valueEndIdx THEN
      IF lineTokenVals(valueStartIdx) = 256 + ASC("(") AND lineTokenVals(valueEndIdx) = 256 + ASC(")") THEN
        valueStartIdx = valueStartIdx + 1
        valueEndIdx = valueEndIdx - 1
      END IF
    END IF

    IF addrStartIdx = addrEndIdx AND valueStartIdx = valueEndIdx THEN
      IF lineTokens$(addrStartIdx) = "1132" AND lineTokens$(valueStartIdx) = "0" THEN
        isTimerReset = 1
      END IF
    END IF
  END IF

  IF commaIdx = 0 THEN
    throwCompilerError "POKE REQUIRES ADDRESS AND VALUE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF isTimerReset = 0 THEN
    IF cm.HasGraphics = 0 THEN
      parse_POKE_Compat = parse_POKE(startIdx)
      EXIT FUNCTION
    END IF

    tira_Start

    ' Graphics POKE addresses are linear offsets into the active destination framebuffer
    ff = tiraParseExpressionIntArgId(addrStartIdx, addrEndIdx, ALIM, "POKE ADDRESS MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    addrVarType = tiraParsedArgType
    addrVarVal = tiraParsedArgVal

    ff = tiraParseExpressionIntArgId(valueStartIdx, valueEndIdx, ALIM, "POKE VALUE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    valueVarType = tiraParsedArgType
    valueVarVal = tiraParsedArgVal

    offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    ' Convert the classic signed INTEGER representation into its unsigned 16-bit segment offset
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, offsetVarIdx, addrVarType, addrVarVal, TIRA_ARG_LITERAL, 65535

    donePokeLblIdx = tiraLabelCreateNewId&("POKE_DONE")

    ' Reject segment offsets beyond the active framebuffer
    ' Safely discard writes into the unused tail of the 64K graphics segment
    tiraJmpCondId JCC_JAE, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX * gfxConfig.SizeY, donePokeLblIdx

    byteVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, byteVarIdx, valueVarType, valueVarVal, TIRA_ARG_LITERAL, 255

    ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gfxDestIdx = returnedData2

    fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

    targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

    tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, byteVarIdx, TIRA_ARG_LITERAL, 1
    tiraTriggerAutoDisplayId
    tiraJmpId donePokeLblIdx

    tiraLabelId donePokeLblIdx

    tira_EndAndProcess

    parse_POKE_Compat = 1
    EXIT FUNCTION
  END IF

  tira_Start

  ' Record the reset time so later PEEK(1132) calls return elapsed BIOS-style ticks
  ff = resolveSymbol("IAT_GETTICKCOUNT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  getTickCountIdx = returnedData2
  tiraCallId0 getTickCountIdx

  tickVarIdx = tiraDimVarId&("T", TYPE_ULONG)
  tiraGetRetId tickVarIdx

  ff = resolveSymbol("!G_SYS_VAL_PEEK1132_TICK")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  peekTickIdx = returnedData2
  tiraAssignId peekTickIdx, TIRA_ARG_SYMBOL, tickVarIdx

  tira_EndAndProcess

  parse_POKE_Compat = 1

END FUNCTION ' parse_POKE_Compat

''''''''''''''''''''''''
FUNCTION parse_PRESET (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM coordStart AS LONG
  DIM isParen AS LONG
  DIM commaColor AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cStartCoord AS LONG
  DIM cEndCoord AS LONG
  DIM cStartColor AS LONG
  DIM cEndColor AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG
  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM cVarType AS LONG
  DIM cVarVal AS _INTEGER64
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM lastBgIdx AS LONG
  DIM newXIdx AS LONG
  DIM newYIdx AS LONG
  DIM colorVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM cMaskIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM targetAddrIdx AS LONG

  endIdx = lineTokenCount - 1

  hasStep = 0
  coordStart = startIdx + 1

  IF coordStart <= endIdx THEN
    IF lineTokenVals(coordStart) = TOK_STEP THEN
      hasStep = 1
      coordStart = coordStart + 1
    END IF
  END IF

  IF coordStart > endIdx THEN
    throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
    EXIT FUNCTION
  END IF

  isParen = 0
  IF lineTokenVals(coordStart) = 256 + ASC("(") THEN isParen = 1

  ' Seamlessly map varying PRESET syntax (parens vs plain) and strip optional color payload
  IF isParen = 1 THEN
    commaColor = findComma(coordStart, endIdx)
    IF commaColor > 0 THEN
      cStartCoord = coordStart
      cEndCoord = commaColor - 1
      cStartColor = commaColor + 1
      cEndColor = endIdx
    ELSE
      cStartCoord = coordStart
      cEndCoord = endIdx
      cStartColor = 0
      cEndColor = 0
    END IF
  ELSE
    comma1 = findComma(coordStart, endIdx)
    IF comma1 = 0 THEN
      throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
      EXIT FUNCTION
    END IF
    comma2 = findComma(comma1 + 1, endIdx)

    IF comma2 > 0 THEN
      cStartCoord = coordStart
      cEndCoord = comma2 - 1
      cStartColor = comma2 + 1
      cEndColor = endIdx
    ELSE
      cStartCoord = coordStart
      cEndCoord = endIdx
      cStartColor = 0
      cEndColor = 0
    END IF
  END IF

  cComma = retCoordinateBoundaries(cStartCoord, cEndCoord)
  IF cComma = 0 THEN
    throwCompilerError "PRESET NEEDS X, Y", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntArgId(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  IF hasStep = 1 THEN
    newXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newXIdx, TIRA_ARG_SYMBOL, currentXIdx, xVarType, xVarVal
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = newXIdx

    newYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newYIdx, TIRA_ARG_SYMBOL, currentYIdx, yVarType, yVarVal
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = newYIdx
  END IF

  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  IF cStartColor > 0 THEN
    ff = tiraParseExpressionIntArgId(cStartColor, cEndColor, ALIM, "COLOR MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    cVarType = tiraParsedArgType
    cVarVal = tiraParsedArgVal
  ELSE
    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    lastBgIdx = returnedData2

    colorVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId colorVarIdx, TIRA_ARG_SYMBOL, lastBgIdx
    cVarType = TIRA_ARG_SYMBOL
    cVarVal = colorVarIdx
  END IF

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PRESET")

  ' Strict hardware bounds check, unsigned evaluation gracefully covers negative coordinate drops
  tiraJmpCondId JCC_JAE, xVarType, xVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipLblIdx
  tiraJmpCondId JCC_JAE, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipLblIdx

  cMaskIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cMaskIdx, cVarType, cVarVal, TIRA_ARG_LITERAL, 255

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, xVarType, xVarVal

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gfxDestIdx = returnedData2

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, cMaskIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipLblIdx

  tiraTriggerAutoDisplayId

  tira_EndAndProcess

  parse_PRESET = 1

END FUNCTION ' parse_PRESET

''''''''''''''''''''''''
FUNCTION parse_RED32$ (startIdx, endIdx, allowImplicit)

  ' Extracts the red channel component from a 32-bit color value

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM shiftVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RED32", 3) = 0 THEN
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "_RED32 ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RED32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RED32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  shiftVarIdx = tiraDimVarId&("T", TYPE_LONG)

  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, shiftVarIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftVarIdx, TIRA_ARG_LITERAL, 255

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RED32$ = scratchName$

END FUNCTION ' parse_RED32$

''''''''''''''''''''''''
FUNCTION parse_RETURN (startIdx)

  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM endIdx AS LONG
  DIM argVarType AS LONG
  DIM argVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG
  DIM endRoutineIdx AS LONG
  DIM tgtPtrIdx AS LONG
  DIM retAddrIdx AS LONG
  DIM baseAddrIdx AS LONG
  DIM gosubIdx AS LONG
  DIM gosubArrayIdx AS LONG
  endIdx = lineTokenCount - 1

  tira_Start

  IF endIdx >= startIdx + 1 THEN
    IF insideSub = 0 THEN
      throwCompilerErrorAndCancelTira "RETURN OUTSIDE SUB OR FUNCTION", ASIS, 0
      EXIT FUNCTION
    END IF

    IF insideSub <> 2 THEN
      throwCompilerErrorAndCancelTira "SUB CANNOT RETURN A VALUE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    argVarType = tiraParsedArgType
    argVarVal = tiraParsedArgVal

    ff = resolveSymbol(currentSubName$)
    IF ff = 1 THEN
      vIdx = returnedData2
      targetType = returnedData3

      IF targetType = TYPE_STRING THEN
        IF exprIs.DataType <> TYPE_STRING THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        ff = resolveSymbol("RT_STR_ASSIGN")
        IF ff = 0 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF
        callFuncIdx = returnedData2

        tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, vIdx, argVarType, argVarVal
      ELSE
        IF exprIs.DataType = TYPE_STRING THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        tiraAssignId vIdx, argVarType, argVarVal
      END IF
    END IF

    tiraScheduleHeapResetId

    ff = resolveSymbol("@END_ROUTINE_" + currentSubName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    endRoutineIdx = returnedData2
    tiraJmpId endRoutineIdx

  ELSE
    ' GOSUB Return (no arguments)
    tgtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    retAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

    ff = resolveSymbol("!G_SYS_IDX_GOSUB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gosubIdx = returnedData2

    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_LITERAL, 1

    ff = resolveSymbol("!G_SYS_ARR_GOSUB")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    gosubArrayIdx = returnedData2

    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, gosubArrayIdx
    tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, tgtPtrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, gosubIdx, TIRA_ARG_LITERAL, 8
    tiraReadMemId retAddrIdx, TIRA_ARG_SYMBOL, tgtPtrIdx
    tiraScheduleHeapResetId
    tiraJmpDynId TIRA_ARG_SYMBOL, retAddrIdx
  END IF

  tira_EndAndProcess

  parse_RETURN = 1

END FUNCTION ' parse_RETURN

''''''''''''''''''''''''
FUNCTION parse_RGB$ (startIdx, endIdx, allowImplicit)

  ' Returns the closest hardware palette index for a specified red, green, and blue mixture

  DIM argRType AS LONG
  DIM argRVal AS _INTEGER64
  DIM argGType AS LONG
  DIM argGVal AS _INTEGER64
  DIM argBType AS LONG
  DIM argBVal AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM maskRIdx AS LONG
  DIM maskGIdx AS LONG
  DIM maskBIdx AS LONG
  DIM paletteIndexIdx AS LONG
  DIM bestIndexIdx AS LONG
  DIM minDistIdx AS LONG
  DIM paletteSymbolIdx AS LONG
  DIM palDescPtrIdx AS LONG
  DIM palDataAddrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM palBIdx AS LONG
  DIM palGAddrIdx AS LONG
  DIM palGIdx AS LONG
  DIM palRAddrIdx AS LONG
  DIM palRIdx AS LONG
  DIM diffRIdx AS LONG
  DIM diffGIdx AS LONG
  DIM diffBIdx AS LONG
  DIM sqRIdx AS LONG
  DIM sqGIdx AS LONG
  DIM sqBIdx AS LONG
  DIM distIdx AS LONG
  DIM skipUpdateIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB", 7) = 0 THEN
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, comma1 - 1, allowImplicit, "_RGB RED ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argRType = tiraParsedArgType
  argRVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma1 + 1, comma2 - 1, allowImplicit, "_RGB GREEN ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argGType = tiraParsedArgType
  argGVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma2 + 1, endIdx - 1, allowImplicit, "_RGB BLUE ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  argBType = tiraParsedArgType
  argBVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RGB", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Force incoming values to 0-255 limits cleanly before calculation
  maskRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskRIdx, argRType, argRVal, TIRA_ARG_LITERAL, 255

  maskGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskGIdx, argGType, argGVal, TIRA_ARG_LITERAL, 255

  maskBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, maskBIdx, argBType, argBVal, TIRA_ARG_LITERAL, 255

  paletteIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId paletteIndexIdx, TIRA_ARG_LITERAL, 0

  bestIndexIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId bestIndexIdx, TIRA_ARG_LITERAL, 0

  minDistIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId minDistIdx, TIRA_ARG_LITERAL, 9999999

  ' Read directly from the internal compiler global palette block memory
  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB$ = ""
    EXIT FUNCTION
  END IF
  paletteSymbolIdx = returnedData2

  palDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId palDescPtrIdx, TIRA_ARG_SYMBOL, paletteSymbolIdx

  palDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId palDataAddrIdx, TIRA_ARG_SYMBOL, palDescPtrIdx

  loopTopIdx = tiraLabelCreateNewId&("RGB_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("RGB_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 255, loopDoneIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 4

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, palDataAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  palBIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palBIdx, TIRA_ARG_SYMBOL, targetAddrIdx

  palGAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, palGAddrIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 1
  palGIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palGIdx, TIRA_ARG_SYMBOL, palGAddrIdx

  palRAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, palRAddrIdx, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_LITERAL, 2
  palRIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId palRIdx, TIRA_ARG_SYMBOL, palRAddrIdx

  ' Calculate the numerical difference between the target pixel and the current index pixel
  diffRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffRIdx, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_SYMBOL, palRIdx

  diffGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffGIdx, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_SYMBOL, palGIdx

  diffBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, diffBIdx, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_SYMBOL, palBIdx

  ' Square the differences internally to isolate purely positive vector distances
  sqRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqRIdx, TIRA_ARG_SYMBOL, diffRIdx, TIRA_ARG_SYMBOL, diffRIdx

  sqGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqGIdx, TIRA_ARG_SYMBOL, diffGIdx, TIRA_ARG_SYMBOL, diffGIdx

  sqBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, sqBIdx, TIRA_ARG_SYMBOL, diffBIdx, TIRA_ARG_SYMBOL, diffBIdx

  distIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, sqRIdx, TIRA_ARG_SYMBOL, sqGIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, sqBIdx

  ' Skip overriding the best match if this index is farther away than our currently held match
  skipUpdateIdx = tiraLabelCreateNewId&("RGB_SKIP_UPD")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_SYMBOL, minDistIdx, skipUpdateIdx
  tiraAssignId minDistIdx, TIRA_ARG_SYMBOL, distIdx
  tiraAssignId bestIndexIdx, TIRA_ARG_SYMBOL, paletteIndexIdx

  ' Speed optimization: If exact perfect distance hit 0 is reached, terminate scan early
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, distIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx
  tiraLabelId skipUpdateIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_SYMBOL, paletteIndexIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, bestIndexIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB$ = scratchName$

END FUNCTION ' parse_RGB$

''''''''''''''''''''''''
FUNCTION parse_RGB32$ (startIdx, endIdx, allowImplicit)

  DIM argRType AS LONG
  DIM argRVal AS _INTEGER64
  DIM argGType AS LONG
  DIM argGVal AS _INTEGER64
  DIM argBType AS LONG
  DIM argBVal AS _INTEGER64
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM maskRIdx AS LONG
  DIM maskGIdx AS LONG
  DIM maskBIdx AS LONG
  DIM clampRMinDoneIdx AS LONG
  DIM clampRDoneIdx AS LONG
  DIM clampGMinDoneIdx AS LONG
  DIM clampGDoneIdx AS LONG
  DIM clampBMinDoneIdx AS LONG
  DIM clampBDoneIdx AS LONG
  DIM shiftGIdx AS LONG
  DIM shiftRIdx AS LONG
  DIM alphaValIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_RGB32", 7) = 0 THEN
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx - 1)
  IF comma2 = 0 THEN
    throwCompilerError "_RGB32 REQUIRES 3 ARGUMENTS", ASIS, 0
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, comma1 - 1, allowImplicit, "_RGB32 RED ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argRType = tiraParsedArgType
  argRVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma1 + 1, comma2 - 1, allowImplicit, "_RGB32 GREEN ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argGType = tiraParsedArgType
  argGVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma2 + 1, endIdx - 1, allowImplicit, "_RGB32 BLUE ARG MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  argBType = tiraParsedArgType
  argBVal = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("RGB32", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_RGB32$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  clampRMinDoneIdx = tiraLabelCreateNewId&("RGB32_R_MIN_DONE")
  clampRDoneIdx = tiraLabelCreateNewId&("RGB32_R_DONE")
  clampGMinDoneIdx = tiraLabelCreateNewId&("RGB32_G_MIN_DONE")
  clampGDoneIdx = tiraLabelCreateNewId&("RGB32_G_DONE")
  clampBMinDoneIdx = tiraLabelCreateNewId&("RGB32_B_MIN_DONE")
  clampBDoneIdx = tiraLabelCreateNewId&("RGB32_B_DONE")

  maskRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskRIdx, argRType, argRVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 0, clampRMinDoneIdx
  tiraAssignId maskRIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampRMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 255, clampRDoneIdx
  tiraAssignId maskRIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampRDoneIdx

  maskGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskGIdx, argGType, argGVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 0, clampGMinDoneIdx
  tiraAssignId maskGIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampGMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 255, clampGDoneIdx
  tiraAssignId maskGIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampGDoneIdx

  maskBIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId maskBIdx, argBType, argBVal
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_LITERAL, 0, clampBMinDoneIdx
  tiraAssignId maskBIdx, TIRA_ARG_LITERAL, 0
  tiraLabelId clampBMinDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_LITERAL, 255, clampBDoneIdx
  tiraAssignId maskBIdx, TIRA_ARG_LITERAL, 255
  tiraLabelId clampBDoneIdx

  shiftGIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, shiftGIdx, TIRA_ARG_SYMBOL, maskGIdx, TIRA_ARG_LITERAL, 8

  shiftRIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, shiftRIdx, TIRA_ARG_SYMBOL, maskRIdx, TIRA_ARG_LITERAL, 16

  ' Default the missing alpha value safely to &HFF000000 (-16777216)
  alphaValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId alphaValIdx, TIRA_ARG_LITERAL, -16777216

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, maskBIdx, TIRA_ARG_SYMBOL, shiftGIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, shiftRIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, alphaValIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_RGB32$ = scratchName$

END FUNCTION ' parse_RGB32$

''''''''''''''''''''''''
FUNCTION parse_RTRIM$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM endPtrIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM isSpaceLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "RTRIM$", 3) = 0 THEN
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "RTRIM$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("RTRIM", "_DSC")
  IF scratchIdx = 0 THEN
    parse_RTRIM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  endPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1

  loopTopIdx = tiraLabelCreateNewId&("RTRIM_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("RTRIM_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, endPtrIdx

  isSpaceLblIdx = tiraLabelCreateNewId&("RTRIM_IS_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, isSpaceLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 9, loopDoneIdx
  tiraLabelId isSpaceLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_SYMBOL, endPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_RTRIM$ = scratchName$

END FUNCTION ' parse_RTRIM$

''''''''''''''''''''''''
FUNCTION parse_SELECT (startIdx)

  DIM endIdx AS LONG
  DIM hiddenVarIdx AS LONG
  DIM selectDataType AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "MALFORMED SELECT CASE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> TOK_CASE THEN
    throwCompilerError "EXPECTED CASE AFTER SELECT", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Generate a globally unique ID for this SELECT block
  selID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_SELECT = 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal
  selectDataType = exprIs.DataType

  IF selectDataType = TYPE_STRING THEN
    hiddenName$ = "!C_SYS_DSC_SEL_SVAR_" + _TRIM$(STR$(selID))
  ELSE
    hiddenName$ = "!C_SYS_VAL_SEL_NVAR_" + _TRIM$(STR$(selID))
  END IF

  ff = resolveSymbol(hiddenName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  hiddenVarIdx = returnedData2

  symbols(hiddenVarIdx).DataType = selectDataType

  IF currentScopeID > 0 THEN
    symbols(hiddenVarIdx).IsLocal = LOCAL_STANDARD
  END IF

  ' Ensure string descriptors are cloned correctly using the runtime helper to prevent data loss
  IF selectDataType = TYPE_STRING THEN
    ff = resolveSymbol("RT_STR_ASSIGN")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    callFuncIdx = returnedData2

    tiraCallId2 callFuncIdx, TIRA_ARG_SYMBOL, hiddenVarIdx, exprVarType, exprVarVal
  ELSE
    tiraAssignId hiddenVarIdx, exprVarType, exprVarVal
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_SELECT
  ctrls(ctrlCount).SelectVarIdx = hiddenVarIdx
  ctrls(ctrlCount).Patch1 = selID ' The unique SELECT block ID
  ctrls(ctrlCount).Patch2 = 0 ' Unused in TIRA
  ctrls(ctrlCount).SelectCaseSeen = 0 ' 0 means no CASE seen yet
  ctrls(ctrlCount).SelectDataType = selectDataType

  ctrlCount = ctrlCount + 1

  parse_SELECT = 1

END FUNCTION ' parse_SELECT

''''''''''''''''''''''''
FUNCTION parse_SPACE$ (startIdx, endIdx, allowImplicit)

  ' Generates a string consisting of a specific number of blank space characters

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM skipLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG
  DIM jmpDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "SPACE$", 3) = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF

  ' Sovereign command opens its own compilation block
  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "SPACE$ REQUIRES NUMERIC ARGUMENT")
  IF ff = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("SPACE", "_DSC")
  IF scratchIdx = 0 THEN
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  skipLenIdx = tiraLabelCreateNewId&("SPACE_SKIP")

  tiraJmpCondId JCC_JLE, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0, skipLenIdx

  dataPtrIdx = tiraAllocTempMemId&(arg1Type, arg1Val)
  IF compileError = 1 THEN
    tira_Cancel
    parse_SPACE$ = ""
    EXIT FUNCTION
  END IF

  ' Memset with 32 (space character)
  tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 32, arg1Type, arg1Val

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, arg1Type, arg1Val, TIRA_ARG_LITERAL, 0

  jmpDoneIdx = tiraLabelCreateNewId&("SPACE_DONE")
  tiraJmpId jmpDoneIdx

  tiraLabelId skipLenIdx
  ' Safely construct an empty descriptor entirely within the Temp Heap paradigm
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
  tiraLabelId jmpDoneIdx

  ' Close the block (NO HEAP RESET, so the string survives for the parent!)
  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_SPACE$ = scratchName$

END FUNCTION ' parse_SPACE$

''''''''''''''''''''''''
FUNCTION parse_STR$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM basePtrIdx AS LONG
  DIM ptrIdx AS LONG
  DIM valVarIdx AS LONG
  DIM isNegIdx AS LONG
  DIM skipNegLblIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM digitIdx AS LONG
  DIM skipDigitNegLblIdx AS LONG
  DIM charVarIdx AS LONG
  DIM skipSpaceLblIdx AS LONG
  DIM jmpDoneLblIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "STR$", 3) = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("STR", "_DSC")
  IF scratchIdx = 0 THEN
    parse_STR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  basePtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, 32)

  ptrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32 ' start at the end of the buffer

  valVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId valVarIdx, arg1Type, arg1Val

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  skipNegLblIdx = tiraLabelCreateNewId&("STR_SKIP_NEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, skipNegLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1
  tiraLabelId skipNegLblIdx

  loopTopIdx = tiraLabelCreateNewId&("STR_LOOP")
  tiraLabelId loopTopIdx

  ' digit = val MOD 10
  digitIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MOD, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  skipDigitNegLblIdx = tiraLabelCreateNewId&("STR_SKIP_DNEG")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 0, skipDigitNegLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_SYMBOL, digitIdx
  tiraLabelId skipDigitNegLblIdx

  ' char = digit + 48
  charVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_SYMBOL, digitIdx, TIRA_ARG_LITERAL, 48

  ' ptr = ptr - 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, charVarIdx, TIRA_ARG_LITERAL, 1

  ' val = val / 10
  tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 10

  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, valVarIdx, TIRA_ARG_LITERAL, 0, loopTopIdx

  ' Apply sign or space
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 1
  skipSpaceLblIdx = tiraLabelCreateNewId&("STR_SKIP_SPC")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 45, TIRA_ARG_LITERAL, 1 ' -
  jmpDoneLblIdx = tiraLabelCreateNewId&("STR_DONE")
  tiraJmpId jmpDoneLblIdx
  tiraLabelId skipSpaceLblIdx
  tiraWriteMemId TIRA_ARG_SYMBOL, ptrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_LITERAL, 1 ' Space
  tiraLabelId jmpDoneLblIdx

  ' Calculate final length
  strLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_LITERAL, 32
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, basePtrIdx, TIRA_ARG_SYMBOL, ptrIdx

  dataPtrIdx = ptrIdx

  ' Build descriptor
  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx
  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_STR$ = scratchName$

END FUNCTION ' parse_STR$

''''''''''''''''''''''''
FUNCTION parse_SWAP (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM iVar AS LONG
  DIM vStart AS LONG
  DIM vEnd AS LONG
  DIM tokIdx AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM tempFieldSize AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM varAddr(2) AS LONG
  DIM varType(2) AS LONG
  DIM varSize(2) AS LONG
  DIM varUdt(2) AS LONG
  DIM varDynStr(2) AS LONG
  DIM finalAddrIdx AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM iDot AS LONG

  DIM sz AS LONG
  DIM tempHeapPtrIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)
  IF commaIdx = 0 THEN
    throwCompilerError "SWAP REQUIRES TWO VARIABLES SEPARATED BY A COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  FOR iVar = 1 TO 2
    IF iVar = 1 THEN
      vStart = startIdx + 1
      vEnd = commaIdx - 1
    ELSE
      vStart = commaIdx + 1
      vEnd = endIdx
    END IF

    tokIdx = vStart
    IF tokIdx > vEnd THEN
      throwCompilerErrorAndCancelTira "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 OR LEN(vTok$) = 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(vTok$)
    tokIdx = tokIdx + 1

    ' 1. Dot notation (Legacy)
    DO WHILE tokIdx <= vEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        IF findSymbol(vName$) THEN
          IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
        END IF
        IF cm.ClassicMode = 1 THEN
          IF tokIdx + 1 <= vEnd THEN
            vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
            tokIdx = tokIdx + 2
          ELSE
            EXIT DO
          END IF
        ELSE
          throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
          addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ' 2. Array Indices
    hasIndex = 0
    parenStartIdx = 0
    closeParenIdx = 0
    IF tokIdx <= vEnd THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        parenStartIdx = tokIdx
        ff = findMatchingParen(tokIdx, vEnd)
        IF ff = 1 THEN
          closeParenIdx = returnedData2
        ELSE
          throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN SWAP", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = closeParenIdx + 1
      END IF
    END IF

    ' 3. UDT Fields
    udtFieldCount = 0
    hasField = 0
    DO WHILE tokIdx <= vEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
        udtFieldCount = udtFieldCount + 1
        IF udtFieldCount >= 256 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = tokIdx + 2
      ELSE
        EXIT DO
      END IF
    LOOP

    IF tokIdx <= vEnd THEN
      throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN SWAP VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    ' Process UDT
    IF hasField = 1 THEN
      IF targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
      tempUdtIndex = symbols(vIdx).UDTIndex
      udtOffset = 0
      tempIsDynamicString = 0
      tempFieldSize = 0

      FOR iDot = 0 TO udtFieldCount - 1
        uIdx = tempUdtIndex
        fieldFound = 0

        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(uIdx, iField).Offset
          targetType = udtFields(uIdx, iField).DataType
          tempUdtIndex = udtFields(uIdx, iField).UDTIndex
          tempFieldSize = udtFields(uIdx, iField).Size
          tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
            iField = returnedData2
            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
              udtOffset = udtOffset + udtFields(uIdx, iField).Offset
              targetType = udtFields(uIdx, iField).DataType
              tempUdtIndex = udtFields(uIdx, iField).UDTIndex
              tempFieldSize = udtFields(uIdx, iField).Size
              tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
              fieldFound = 1
            END IF
          END IF
        END IF

        IF fieldFound = 0 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
          throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF
      NEXT iDot
    END IF

    ' Indices
    numParsedIndices = 0
    IF hasIndex = 1 THEN
      ff = tiraParseArrayArgsId(parenStartIdx, closeParenIdx, 0)
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      numParsedIndices = returnedData3
    END IF

    IF hasIndex = 1 THEN
      IF symbols(vIdx).IsArray = 0 THEN
        throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    varType(iVar) = targetType
    varUdt(iVar) = -1

    isFixedStr = 0
    destLen = 0
    IF hasField = 1 THEN
      IF targetType = TYPE_UDT THEN
        varUdt(iVar) = tempUdtIndex
        varSize(iVar) = tempFieldSize
      ELSE
        IF targetType = TYPE_STRING THEN
          IF tempIsDynamicString = 0 THEN
            isFixedStr = 1
            destLen = tempFieldSize
          END IF
        END IF
      END IF
    ELSE
      IF targetType = TYPE_UDT THEN
        varUdt(iVar) = symbols(vIdx).UDTIndex
        varSize(iVar) = retElementByteSize(vIdx)
      ELSE
        IF targetType = TYPE_STRING THEN
          destLen = retFixeSTRINGDLength(vIdx)
          IF destLen > 0 THEN
            isFixedStr = 1
          END IF
        END IF
      END IF
    END IF

    varDynStr(iVar) = 0

    IF targetType = TYPE_STRING THEN
      IF isFixedStr = 1 THEN
        varSize(iVar) = destLen
      ELSE
        varDynStr(iVar) = 1
        varSize(iVar) = 24 ' Size of string descriptor
      END IF
    ELSE
      IF targetType <> TYPE_UDT THEN
        varSize(iVar) = retElementByteSize(vIdx)
      END IF
    END IF

    IF hasIndex = 0 AND hasField = 0 THEN
      finalAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, vIdx
      varAddr(iVar) = finalAddrIdx
    ELSE
      finalAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, udtOffset)
      IF compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      varAddr(iVar) = finalAddrIdx
    END IF
  NEXT iVar

  ' Type matching
  IF varType(1) <> varType(2) THEN
    throwCompilerErrorAndCancelTira "SWAP TYPE MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  IF varType(1) = TYPE_UDT THEN
    IF varUdt(1) <> varUdt(2) THEN
      throwCompilerErrorAndCancelTira "SWAP UDT TYPE MISMATCH", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF varType(1) = TYPE_STRING THEN
    IF varDynStr(1) <> varDynStr(2) THEN
      throwCompilerErrorAndCancelTira "CANNOT SWAP DYNAMIC AND FIXED STRINGS", ASIS, 0
      EXIT FUNCTION
    END IF
    IF varDynStr(1) = 0 THEN
      IF varSize(1) <> varSize(2) THEN
        throwCompilerErrorAndCancelTira "FIXED STRINGS MUST BE EXACT SAME LENGTH TO SWAP", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  sz = varSize(1)

  IF sz = 1 OR sz = 2 OR sz = 4 OR sz = 8 THEN
    tiraSwapMemId TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_LITERAL, sz
  ELSE
    tempHeapPtrIdx = tiraAllocTempMemId&(TIRA_ARG_LITERAL, sz)
    IF compileError = 1 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    tiraMemcpyId TIRA_ARG_SYMBOL, tempHeapPtrIdx, TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_LITERAL, sz
    tiraMemcpyId TIRA_ARG_SYMBOL, varAddr(1), TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_LITERAL, sz
    tiraMemcpyId TIRA_ARG_SYMBOL, varAddr(2), TIRA_ARG_SYMBOL, tempHeapPtrIdx, TIRA_ARG_LITERAL, sz
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_SWAP = 1

END FUNCTION ' parse_SWAP

''''''''''''''''''''''''
FUNCTION parse_UBOUND$ (startIdx, endIdx, allowImplicit)

  DIM arrNameTok$
  DIM comma1 AS LONG
  DIM vIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dimVarType AS LONG
  DIM dimVarVal AS _INTEGER64
  DIM resVarIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM dimLBoundIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM descAddrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "UBOUND", 3) = 0 THEN
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  arrNameTok$ = UCASE$(retTokenText$(lineTokens$(startIdx + 2)))
  ff = findSymbol(arrNameTok$)
  IF ff = 0 THEN
    throwCompilerError "UNDECLARED ARRAY IN UBOUND", ASIS, 0
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerError "UBOUND REQUIRES AN ARRAY", ASIS, 0
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx - 1, allowImplicit, "DIMENSION MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_UBOUND$ = ""
      EXIT FUNCTION
    END IF
    dimVarType = tiraParsedArgType
    dimVarVal = tiraParsedArgVal
  ELSE
    dimVarType = TIRA_ARG_LITERAL
    dimVarVal = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("UBOUND", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_UBOUND$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  lblEndIdx = tiraLabelCreateNewId&("UB_END")
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraJmpCondId JCC_JG, dimVarType, dimVarVal, TIRA_ARG_SYMBOL, numDimsIdx, lblEndIdx
  tiraJmpCondId JCC_JL, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1, lblEndIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, offsetVarIdx, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 0

  dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 4

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, dimLBoundIdx, TIRA_ARG_SYMBOL, dimNumElemsIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_UBOUND$ = scratchName$

END FUNCTION ' parse_UBOUND$

''''''''''''''''''''''''
FUNCTION parse_UCASE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM destItrIdx AS LONG
  DIM srcItrIdx AS LONG
  DIM itrLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipLowerLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "UCASE$", 3) = 0 THEN
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "UCASE$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("UCASE", "_DSC")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF dataPtrIdx = 0 THEN
    tira_Cancel
    parse_UCASE$ = ""
    EXIT FUNCTION
  END IF

  destItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destItrIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  srcItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId srcItrIdx, TIRA_ARG_SYMBOL, srcPtrIdx
  itrLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId itrLenIdx, TIRA_ARG_SYMBOL, strLenIdx

  loopTopIdx = tiraLabelCreateNewId&("UCASE_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("UCASE_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, srcItrIdx

  skipLowerLblIdx = tiraLabelCreateNewId&("UCASE_SKIP")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 97, skipLowerLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 122, skipLowerLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32
  tiraLabelId skipLowerLblIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_UCASE$ = scratchName$

END FUNCTION ' parse_UCASE$

''''''''''''''''''''''''
FUNCTION parse_WEND (startIdx)

' Marks the conclusion of a WHILE loop and returns execution to the top evaluation condition

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  endIdx = lineTokenCount - 1

  IF ctrlCount = 0 THEN
    throwCompilerError "WEND WITHOUT WHILE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF ctrls(ctrlCount - 1).TYPE <> CTRL_WHILE THEN
    throwCompilerError "WEND MISMATCH", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrlCount = ctrlCount - 1
  loopID = ctrls(ctrlCount).Patch1

  topLbl$ = "@WHILE_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  tira_Start
  tiraScheduleHeapResetId

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraJmpId topLblIdx

  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2
  tiraLabelId doneLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_WEND = 1

END FUNCTION ' parse_WEND

''''''''''''''''''''''''
FUNCTION parse_WHEEL$ (startIdx, endIdx, allowImplicit)

  ' Returns the relative rotation value of a controller wheel

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM callFuncIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_WHEEL", 3) = 0 THEN
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  scratchIdx = tiraResolveHoistVarId&("WHEEL", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  ff = resolveSymbol("RT_WHEEL")
  IF ff = 0 THEN
    tira_Cancel
    parse_WHEEL$ = ""
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, arg1Type, arg1Val
  tiraGetRetId resVarIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_WHEEL$ = scratchName$

END FUNCTION ' parse_WHEEL$

''''''''''''''''''''''''
FUNCTION parse_WHILE (startIdx)

' Initiates a loop block that continues to execute as long as its condition remains true

  DIM endIdx AS LONG
  DIM loopID AS LONG
  DIM topLblIdx AS LONG
  DIM doneLblIdx AS LONG
  DIM exprVarType AS LONG
  DIM exprVarVal AS _INTEGER64
  endIdx = lineTokenCount - 1

  loopID = t.TiraVarCounter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_WHILE = 0
    EXIT FUNCTION
  END IF

  topLbl$ = "@WHILE_TOP_" + LTRIM$(RTRIM$(STR$(loopID)))
  doneLbl$ = "@WHILE_DONE_" + LTRIM$(RTRIM$(STR$(loopID)))

  tira_Start

  ff = resolveSymbol(topLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  topLblIdx = returnedData2
  tiraLabelId topLblIdx

  tira_EndAndProcess

  hoistIntrinsics
  IF compileError = 1 THEN EXIT FUNCTION

  ' Restore the expected symbol type to a clean slate
  expectedSymType = TYPE_ANY

  ' Intrinsic hoisting shortens the token list, so refresh the expression boundary before parsing
  endIdx = lineTokenCount - 1

  tira_Start

  ff = tiraParseExpressionNumericArgId(startIdx + 1, endIdx, ALIM, "TYPE MISMATCH IN CONDITION")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  exprVarType = tiraParsedArgType
  exprVarVal = tiraParsedArgVal

  ff = resolveSymbol(doneLbl$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  doneLblIdx = returnedData2

  tiraJmpCondId JCC_JE, exprVarType, exprVarVal, TIRA_ARG_LITERAL, 0, doneLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  IF ctrlCount >= MAX_CTRLS THEN
    throwCompilerError "CONTROL STACK OVERFLOW", ASIS, 0
    EXIT FUNCTION
  END IF

  ctrls(ctrlCount).TYPE = CTRL_WHILE
  ctrls(ctrlCount).Patch1 = loopID
  ctrls(ctrlCount).Patch2 = 0
  ctrlCount = ctrlCount + 1

  parse_WHILE = 1

END FUNCTION ' parse_WHILE

''''''''''''''''''''''''
FUNCTION parse_WAIT (startIdx)

  DIM endIdx AS LONG
  DIM commaIdx AS LONG
  DIM refreshRate AS LONG
  DIM portVarType AS LONG
  DIM portVarVal AS _INTEGER64
  DIM maskVarType AS LONG
  DIM maskVarVal AS _INTEGER64
  DIM rateVarIdx AS LONG
  DIM skipWaitLblIdx AS LONG
  DIM autoFlagIdx AS LONG
  DIM swapFuncIdx AS LONG
  DIM limitFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  commaIdx = findComma(startIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerError "WAIT REQUIRES PORT AND MASK", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 1, commaIdx - 1, ALIM, "PORT MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  portVarType = tiraParsedArgType
  portVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(commaIdx + 1, endIdx, ALIM, "MASK MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  maskVarType = tiraParsedArgType
  maskVarVal = tiraParsedArgVal

  IF cm.HasGraphics = 1 THEN
    skipWaitLblIdx = tiraLabelCreateNewId&("WAIT_SKIP")

    tiraJmpCondId JCC_JNE, portVarType, portVarVal, TIRA_ARG_LITERAL, 986, skipWaitLblIdx

    tiraJmpCondId JCC_JNE, maskVarType, maskVarVal, TIRA_ARG_LITERAL, 8, skipWaitLblIdx

    refreshRate = 60
    IF compileScreenMode = 13 THEN refreshRate = 70

    rateVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
    tiraAssignId rateVarIdx, TIRA_ARG_LITERAL, refreshRate

    ff = resolveSymbol("!G_GFX_FLG_AUTO")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    autoFlagIdx = returnedData2
    tiraAssignId autoFlagIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    swapFuncIdx = returnedData2
    tiraCallId0 swapFuncIdx

    ff = resolveSymbol("RT_LIMIT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    limitFuncIdx = returnedData2
    tiraCallId1 limitFuncIdx, TIRA_ARG_SYMBOL, rateVarIdx

    tiraLabelId skipWaitLblIdx
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_WAIT = 1

END FUNCTION ' parse_WAIT

''''''''''''''''''''''''
FUNCTION parse_VAL$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM isNegIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipSpaceTopIdx AS LONG
  DIM skipSpaceDoneIdx AS LONG
  DIM checkSignDoneIdx AS LONG
  DIM negativeSignLblIdx AS LONG
  DIM consumeSignLblIdx AS LONG
  DIM numLoopTopIdx AS LONG
  DIM numLoopDoneIdx AS LONG
  DIM applySignDoneIdx AS LONG

  DIM isAmpLblIdx AS LONG
  DIM isHexLblIdx AS LONG
  DIM isOctLblIdx AS LONG
  DIM base10LblIdx AS LONG
  DIM hexLoopTopIdx AS LONG
  DIM isDigitLblIdx AS LONG
  DIM isUpperLblIdx AS LONG
  DIM isLowerLblIdx AS LONG
  DIM applyHexLblIdx AS LONG
  DIM octLoopTopIdx AS LONG

  DIM isFractionIdx AS LONG
  DIM fractionDivIdx AS LONG
  DIM digitFloatIdx AS LONG
  DIM decimalPointLblIdx AS LONG
  DIM wholeDigitLblIdx AS LONG
  DIM digitAdvanceLblIdx AS LONG

  DIM exponentLblIdx AS LONG
  DIM exponentValIdx AS LONG
  DIM exponentNegIdx AS LONG
  DIM exponentSignDoneIdx AS LONG
  DIM exponentNegativeLblIdx AS LONG
  DIM exponentConsumeSignLblIdx AS LONG
  DIM exponentLoopTopIdx AS LONG
  DIM exponentApplyLblIdx AS LONG
  DIM exponentApplyTopIdx AS LONG
  DIM exponentMultiplyLblIdx AS LONG
  DIM exponentStepDoneIdx AS LONG
  DIM exponentCapDoneIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VAL", 3) = 0 THEN
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "INTRINSIC REQUIRES STRING", ASIS, 0
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("VAL", "_VAL")
  IF scratchIdx = 0 THEN
    parse_VAL$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  symbols(scratchIdx).DataType = TYPE_DOUBLE

  resVarIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  dataPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  isNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 0

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)

  skipSpaceTopIdx = tiraLabelCreateNewId&("VAL_SKIP_SPC")
  skipSpaceDoneIdx = tiraLabelCreateNewId&("VAL_SPC_DONE")

  tiraLabelId skipSpaceTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, skipSpaceDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32, skipSpaceDoneIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId skipSpaceTopIdx

  tiraLabelId skipSpaceDoneIdx

  checkSignDoneIdx = tiraLabelCreateNewId&("VAL_SGN_DONE")
  negativeSignLblIdx = tiraLabelCreateNewId&("VAL_SGN_NEG")
  consumeSignLblIdx = tiraLabelCreateNewId&("VAL_SGN_CONSUME")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, checkSignDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, negativeSignLblIdx ' -
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 43, checkSignDoneIdx ' +
  tiraJmpId consumeSignLblIdx

  tiraLabelId negativeSignLblIdx
  tiraAssignId isNegIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId consumeSignLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId checkSignDoneIdx

  isAmpLblIdx = tiraLabelCreateNewId&("VAL_IS_AMP")
  isHexLblIdx = tiraLabelCreateNewId&("VAL_IS_HEX")
  isOctLblIdx = tiraLabelCreateNewId&("VAL_IS_OCT")
  base10LblIdx = tiraLabelCreateNewId&("VAL_BASE10")
  numLoopDoneIdx = tiraLabelCreateNewId&("VAL_NUM_DONE")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 38, isAmpLblIdx ' 38 is &
  tiraJmpId base10LblIdx

  tiraLabelId isAmpLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx

  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 72, isHexLblIdx ' H
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 104, isHexLblIdx ' h
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 79, isOctLblIdx ' O
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 111, isOctLblIdx ' o

  tiraJmpId numLoopDoneIdx

  tiraLabelId isHexLblIdx
  hexLoopTopIdx = tiraLabelCreateNewId&("VAL_HEX_LOOP")
  isDigitLblIdx = tiraLabelCreateNewId&("VAL_HEX_DIGIT")
  isUpperLblIdx = tiraLabelCreateNewId&("VAL_HEX_UPPER")
  isLowerLblIdx = tiraLabelCreateNewId&("VAL_HEX_LOWER")
  applyHexLblIdx = tiraLabelCreateNewId&("VAL_HEX_APPLY")

  tiraLabelId hexLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, isDigitLblIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 65, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 70, isUpperLblIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 97, numLoopDoneIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 102, isLowerLblIdx

  tiraJmpId numLoopDoneIdx

  tiraLabelId isDigitLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraJmpId applyHexLblIdx

  tiraLabelId isUpperLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 55
  tiraJmpId applyHexLblIdx

  tiraLabelId isLowerLblIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 87

  tiraLabelId applyHexLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 16
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId hexLoopTopIdx

  tiraLabelId isOctLblIdx
  octLoopTopIdx = tiraLabelCreateNewId&("VAL_OCT_LOOP")

  tiraLabelId octLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 55, numLoopDoneIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId octLoopTopIdx

  tiraLabelId base10LblIdx

  isFractionIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId isFractionIdx, TIRA_ARG_LITERAL, 0

  fractionDivIdx = tiraDimVarId&("T", TYPE_DOUBLE)
  tiraAssignId fractionDivIdx, TIRA_ARG_LITERAL, 1

  digitFloatIdx = tiraDimVarId&("T", TYPE_DOUBLE)

  numLoopTopIdx = tiraLabelCreateNewId&("VAL_NUM_LOOP")
  decimalPointLblIdx = tiraLabelCreateNewId&("VAL_DECIMAL")
  wholeDigitLblIdx = tiraLabelCreateNewId&("VAL_WHOLE_DIGIT")
  digitAdvanceLblIdx = tiraLabelCreateNewId&("VAL_DIGIT_ADVANCE")
  exponentLblIdx = tiraLabelCreateNewId&("VAL_EXPONENT")

  tiraLabelId numLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 46, decimalPointLblIdx ' .
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 69, exponentLblIdx ' E
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 101, exponentLblIdx ' e
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 68, exponentLblIdx ' D
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 100, exponentLblIdx ' d

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, numLoopDoneIdx ' 0
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, numLoopDoneIdx ' 9

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFractionIdx, TIRA_ARG_LITERAL, 0, wholeDigitLblIdx

  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, fractionDivIdx, TIRA_ARG_SYMBOL, fractionDivIdx, TIRA_ARG_LITERAL, 10
  tiraAssignId digitFloatIdx, TIRA_ARG_SYMBOL, byteValIdx
  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, digitFloatIdx, TIRA_ARG_SYMBOL, digitFloatIdx, TIRA_ARG_SYMBOL, fractionDivIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, digitFloatIdx
  tiraJmpId digitAdvanceLblIdx

  tiraLabelId wholeDigitLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraLabelId digitAdvanceLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId decimalPointLblIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, isFractionIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraAssignId isFractionIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId numLoopTopIdx

  tiraLabelId exponentLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  exponentValIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId exponentValIdx, TIRA_ARG_LITERAL, 0

  exponentNegIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId exponentNegIdx, TIRA_ARG_LITERAL, 0

  exponentSignDoneIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_DONE")
  exponentNegativeLblIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_NEG")
  exponentConsumeSignLblIdx = tiraLabelCreateNewId&("VAL_EXP_SGN_CONSUME")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 45, exponentNegativeLblIdx ' -
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 43, exponentSignDoneIdx ' +
  tiraJmpId exponentConsumeSignLblIdx

  tiraLabelId exponentNegativeLblIdx
  tiraAssignId exponentNegIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId exponentConsumeSignLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId exponentSignDoneIdx

  exponentLoopTopIdx = tiraLabelCreateNewId&("VAL_EXP_LOOP")
  exponentApplyLblIdx = tiraLabelCreateNewId&("VAL_EXP_APPLY")
  exponentCapDoneIdx = tiraLabelCreateNewId&("VAL_EXP_CAP")

  tiraLabelId exponentLoopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0, exponentApplyLblIdx
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, dataPtrIdx

  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48, exponentApplyLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 57, exponentApplyLblIdx

  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 48
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 10
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, byteValIdx

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 400, exponentCapDoneIdx
  tiraAssignId exponentValIdx, TIRA_ARG_LITERAL, 400
  tiraLabelId exponentCapDoneIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId exponentLoopTopIdx

  tiraLabelId exponentApplyLblIdx

  exponentApplyTopIdx = tiraLabelCreateNewId&("VAL_EXP_APPLY_LOOP")
  exponentMultiplyLblIdx = tiraLabelCreateNewId&("VAL_EXP_MUL")
  exponentStepDoneIdx = tiraLabelCreateNewId&("VAL_EXP_STEP")

  tiraLabelId exponentApplyTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 0, numLoopDoneIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, exponentNegIdx, TIRA_ARG_LITERAL, 0, exponentMultiplyLblIdx

  tiraOpId3 TC_DIV, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10
  tiraJmpId exponentStepDoneIdx

  tiraLabelId exponentMultiplyLblIdx
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 10

  tiraLabelId exponentStepDoneIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_SYMBOL, exponentValIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId exponentApplyTopIdx

  tiraLabelId numLoopDoneIdx

  applySignDoneIdx = tiraLabelCreateNewId&("VAL_SGN_APP")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isNegIdx, TIRA_ARG_LITERAL, 0, applySignDoneIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId applySignDoneIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_DOUBLE
  exprIs.IsTemp = 1
  parse_VAL$ = scratchName$

END FUNCTION ' parse_VAL$

''''''''''''''''''''''''
''''''''''''''''''''''''
FUNCTION parse_VARPTR$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG
  DIM addrVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VARPTR", 3) = 0 THEN
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER VARPTR", ASIS, 0
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  ' Support dot variable syntax gracefully to map cleanly with older structural integrations
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN VARPTR", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN VARPTR", ASIS, 0
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_VARPTR$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayArgsId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("VARPTR", "_PTR")
  IF scratchIdx = 0 THEN
    parse_VARPTR$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF hasIndex = 0 AND hasField = 0 THEN
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
  ELSE
    addrVarIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, udtOffset)
    IF compileError = 1 THEN
      tira_Cancel
      parse_VARPTR$ = ""
      EXIT FUNCTION
    END IF
    tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, addrVarIdx
  END IF

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_INTEGER64
  exprIs.IsTemp = 1
  parse_VARPTR$ = scratchName$

END FUNCTION ' parse_VARPTR$

''''''''''''''''''''''''
FUNCTION parse_VARSEG$ (startIdx, endIdx, allowImplicit)

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM tokIdx AS LONG
  DIM vTokVal AS LONG
  DIM vTok$
  DIM vName$
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM udtFieldNames$(256)
  DIM iDot AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM numParsedIndices AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "VARSEG", 3) = 0 THEN
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  tokIdx = startIdx + 2

  vTok$ = lineTokens$(tokIdx)
  vTokVal = lineTokenVals(tokIdx)

  IF vTokVal <> 0 OR LEN(vTok$) = 0 THEN
    throwCompilerErrorAndCancelTira "EXPECTED VARIABLE AFTER VARSEG", ASIS, 0
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  vName$ = UCASE$(vTok$)
  tokIdx = tokIdx + 1

  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= endIdx - 1 THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= endIdx - 1 THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, endIdx - 1)
      IF ff = 1 THEN
        closeParenIdx = returnedData2
      ELSE
        throwCompilerErrorAndCancelTira "UNMATCHED PARENTHESIS IN VARSEG", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = closeParenIdx + 1
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= endIdx - 1
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= endIdx - 1 THEN
    throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN IN VARSEG", ASIS, 0
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount

  IF allowImplicit = 0 THEN
    ff = findSymbol(vName$)
    IF ff = 0 THEN
      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND hasIndex = 1 THEN
        throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
      ELSE
        throwCompilerErrorAndCancelTira "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
      END IF
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = symbols(vIdx).DataType
  ELSE
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    vIdx = returnedData2
    targetType = returnedData3
  END IF

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        parse_VARSEG$ = ""
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  numParsedIndices = 0
  IF hasIndex = 1 THEN
    ff = tiraParseArrayArgsId(parenStartIdx, closeParenIdx, 0)
    IF ff = 0 THEN
      tira_Cancel
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    closeParenIdx = returnedData2
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      parse_VARSEG$ = ""
      EXIT FUNCTION
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("VARSEG", "_VAL")
  IF scratchIdx = 0 THEN
    parse_VARSEG$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_VARSEG$ = scratchName$

END FUNCTION ' parse_VARSEG$

''''''''''''''''''''''''
FUNCTION parse_VIEW_PRINT (startIdx, endIdx)

  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM maxRows AS LONG
  DIM textRowHeight AS LONG
  DIM fontHeightIdx AS LONG
  DIM fontHeightGlobalIdx AS LONG
  DIM fontHeightReadyLblIdx AS LONG
  DIM viewTopIdx AS LONG
  DIM viewBotIdx AS LONG
  DIM textXIdx AS LONG
  DIM textYIdx AS LONG
  DIM getStdHandleIdx AS LONG
  DIM setConsoleCursorIdx AS LONG
  DIM fullRowsIdx AS LONG
  DIM hndVarIdx AS LONG
  DIM topType AS LONG
  DIM topVal AS _INTEGER64
  DIM botType AS LONG
  DIM botVal AS _INTEGER64
  DIM maxRowsType AS LONG
  DIM maxRowsVal AS _INTEGER64
  DIM maxRowsVarIdx AS LONG
  DIM lblValidIdx AS LONG
  DIM lblErrIdx AS LONG
  DIM topZeroIdx AS LONG
  DIM packedYIdx AS LONG

  textRowHeight = 8
  IF compileScreenMode = 9 THEN textRowHeight = 14
  IF compileScreenMode = 11 OR compileScreenMode = 12 THEN textRowHeight = 16

  tira_Start

  ff = resolveSymbol("!G_INO_VAL_VIEW_TOP")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewTopIdx = returnedData2

  ff = resolveSymbol("!G_INO_VAL_VIEW_BOT")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  viewBotIdx = returnedData2

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_V32_FONTHEIGHT")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fontHeightGlobalIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_X")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textXIdx = returnedData2

    ff = resolveSymbol("!G_INO_VAL_TEXT_Y")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    textYIdx = returnedData2

    fontHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId fontHeightIdx, TIRA_ARG_SYMBOL, fontHeightGlobalIdx

    fontHeightReadyLblIdx = tiraLabelCreateNewId&("VIEWP_FONT_READY")
    tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, fontHeightIdx, TIRA_ARG_LITERAL, 0, fontHeightReadyLblIdx
    tiraAssignId fontHeightIdx, TIRA_ARG_LITERAL, textRowHeight
    tiraLabelId fontHeightReadyLblIdx
  ELSE
    ff = resolveSymbol("IAT_GETSTDHANDLE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    getStdHandleIdx = returnedData2

    ff = resolveSymbol("IAT_SETCONSOLECURSORPOSITION")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    setConsoleCursorIdx = returnedData2
  END IF

  IF startIdx > endIdx THEN
    tiraAssignId viewTopIdx, TIRA_ARG_LITERAL, 0
    IF cm.HasGraphics = 1 THEN
      fullRowsIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId fullRowsIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
      tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewBotIdx, TIRA_ARG_SYMBOL, fullRowsIdx, TIRA_ARG_SYMBOL, fontHeightIdx

      ' Reset text cursor to top left
      tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId textYIdx, TIRA_ARG_LITERAL, 0
    ELSE
      tiraAssignId viewBotIdx, TIRA_ARG_LITERAL, 25

      ' Reset native console cursor to top left
      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx
      tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_LITERAL, 0
    END IF
  ELSE
    hasTo = 0
    toIdx = 0
    ff = findNextTokenAtDepth0(startIdx, endIdx, TOK_TO)
    IF ff = 1 THEN
      hasTo = 1
      toIdx = returnedData2
    END IF

    IF hasTo = 0 THEN
      throwCompilerErrorAndCancelTira "VIEW PRINT MISSING TO", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = tiraParseExpressionIntArgId(startIdx, toIdx - 1, ALIM, "TOP ROW MUST BE NUMERIC")
    IF ff = 0 THEN EXIT FUNCTION
    topType = tiraParsedArgType
    topVal = tiraParsedArgVal

    ff = tiraParseExpressionIntArgId(toIdx + 1, endIdx, ALIM, "BOTTOM ROW MUST BE NUMERIC")
    IF ff = 0 THEN EXIT FUNCTION
    botType = tiraParsedArgType
    botVal = tiraParsedArgVal

    maxRows = 25
    maxRowsType = TIRA_ARG_LITERAL
    maxRowsVal = maxRows

    IF cm.HasGraphics = 1 THEN
      maxRowsVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId maxRowsVarIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY
      tiraOpId3 TC_IDIV, TIRA_ARG_SYMBOL, maxRowsVarIdx, TIRA_ARG_SYMBOL, maxRowsVarIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      maxRowsType = TIRA_ARG_SYMBOL
      maxRowsVal = maxRowsVarIdx
    END IF

    lblValidIdx = tiraLabelCreateNewId&("VIEWP_VALID")
    lblErrIdx = tiraLabelCreateNewId&("VIEWP_ERR")

    tiraJmpCondId JCC_JL, topType, topVal, TIRA_ARG_LITERAL, 1, lblErrIdx
    tiraJmpCondId JCC_JG, botType, botVal, maxRowsType, maxRowsVal, lblErrIdx
    tiraJmpCondId JCC_JG, topType, topVal, botType, botVal, lblErrIdx

    tiraJmpId lblValidIdx

    tiraLabelId lblErrIdx
    tiraFatalErrorId "ILLEGAL FUNCTION CALL IN VIEW PRINT"

    tiraLabelId lblValidIdx

    topZeroIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, topZeroIdx, topType, topVal, TIRA_ARG_LITERAL, 1 ' Make 0-based row targeting safely using a temp variable

    IF cm.HasGraphics = 1 THEN
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewTopIdx, TIRA_ARG_SYMBOL, topZeroIdx, TIRA_ARG_SYMBOL, fontHeightIdx
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, viewBotIdx, botType, botVal, TIRA_ARG_SYMBOL, fontHeightIdx

      ' Move text cursor exactly into the top left of the new viewport
      tiraAssignId textXIdx, TIRA_ARG_LITERAL, 0
      tiraAssignId textYIdx, TIRA_ARG_SYMBOL, viewTopIdx
    ELSE
      tiraAssignId viewTopIdx, TIRA_ARG_SYMBOL, topZeroIdx
      tiraAssignId viewBotIdx, botType, botVal

      packedYIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, packedYIdx, TIRA_ARG_SYMBOL, topZeroIdx, TIRA_ARG_LITERAL, 16

      ' Move console cursor into the top left of the new viewport
      hndVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraCallId1 getStdHandleIdx, TIRA_ARG_LITERAL, -11
      tiraGetRetId hndVarIdx
      tiraCallId2 setConsoleCursorIdx, TIRA_ARG_SYMBOL, hndVarIdx, TIRA_ARG_SYMBOL, packedYIdx
    END IF
  END IF

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_VIEW_PRINT = 1

END FUNCTION ' parse_VIEW_PRINT

