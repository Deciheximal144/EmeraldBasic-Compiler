  sysColor.currentLine = &H11
  sysColor.routineNameClr = &H12
  sysColor.commentClr = &H13
  sysColor.stringClr = &H14
  sysColor.numbers = &H15
  sysColor.keywords = &H16

  editor.windowBarClr = 208
  editor.windowBgClr = &H10
  editor.CloseClr = 3

END SUB ' initColors

''''''''''''''''''''''''
SUB initFileNames

  fileNameBase$ = "DFLTNAME"
  fileNameErr$ = "ErrorReport.txt"
  fileNameCustomExt$ = ".BAS"
  openCustomExtension$ = ""
  editor.OpenCustomEnabled = 0
  editor.FileExtensionMode = FILE_EXT_BAS

END SUB ' initFileNames

''''''''''''''''''''''''
SUB initLayout

  DIM wa AS dataTypeRect
  DIM ff AS LONG
  DIM openActionsLeft AS LONG
  DIM openActionsRight AS LONG
  DIM openButtonsWidth AS LONG

  textWallGap = 5

  editor.FontHeight = FONT_HEIGHT
  editor.TextPadding = 8


  editor.ScrollbarWidth = FONT_WIDTH + 4
  editor.ModalScrollbarWidth = editor.ScrollbarWidth
  editor.HScrollHeight = editor.FontHeight + 3
  editor.CloseWidth = FONT_WIDTH + editor.TextPadding
  editor.FuncNameColumns = 12
  editor.SideWidth = (editor.FuncNameColumns * FONT_WIDTH) + (2 * textWallGap) + editor.ScrollbarWidth
  editor.ButtonWidth = editor.SideWidth
  editor.EditorLeft = editor.SideWidth + 3
  editor.EditorDivider = editor.EditorLeft + (6 * FONT_WIDTH) + (2 * textWallGap)
  editor.EditorTextX = editor.EditorDivider + textWallGap + 1
  editor.EditorScrollX = SCREENSIZEX - editor.ScrollbarWidth - 1
  editor.EditorColumns = (editor.EditorScrollX - editor.EditorDivider - (2 * textWallGap)) \ FONT_WIDTH
  editor.GutterPadding = textWallGap - 1
  editor.EditorFocusExtra = editor.HScrollHeight + 2
  editor.EditorWheelExtra = editor.TextPadding
  editor.HScrollArrowWidth = editor.ScrollbarWidth
  editor.HScrollRightInset = editor.ScrollbarWidth
  editor.HScrollRightGlyph = (editor.ScrollbarWidth - FONT_WIDTH) \ 2
  editor.FuncTextPadding = textWallGap + 1
  editor.FuncMenuPadding = textWallGap + 1
  editor.FuncEditHeadingWidth = editor.SideWidth
  editor.FuncUpTabWidth = FONT_WIDTH + 10
  editor.FuncTabWidth = (editor.SideWidth - editor.FuncUpTabWidth) \ 2
  statusAnchorX = editor.EditorLeft - (4 * FONT_WIDTH)
  editor.StatusColumns = (editor.EditorScrollX - statusAnchorX - (2 * textWallGap)) \ FONT_WIDTH
  editor.StatusWidth = (editor.StatusColumns * FONT_WIDTH) + (2 * textWallGap) + 1
  editor.StatusLeft = editor.EditorScrollX - editor.StatusWidth + 1
  editor.StatusTextPadding = textWallGap + 1
  editor.CursorDataBaseX = editor.TextPadding
  editor.CursorHeadingOffset = 0
  editor.CursorLabelPadding = 1
  cursorDataColumns = LEN("CY:") + editor.CursorLabelPadding + LEN(LTRIM$(STR$(EDITOR_LINE_MAX)))
  editor.CursorDataOffset = editor.StatusLeft - editor.CursorDataBaseX - textWallGap - (cursorDataColumns * FONT_WIDTH)
  editor.MinAllWidth = editor.ScrollbarWidth
  editor.MinAllTextOffset = (editor.MinAllWidth - FONT_WIDTH) \ 2
  editor.WindowDropWidth = (3 * FONT_WIDTH) + (2 * editor.TextPadding)
  editor.WindowMinWidth = editor.CloseWidth
  editor.WindowMenuHitWidth = editor.WindowDropWidth + editor.WindowMinWidth - 1
  editor.ModalWidth = 40 * FONT_WIDTH
  editor.GoToWidth = 20 * FONT_WIDTH
  editor.ListModalColumns = 48
  editor.ListModalWidth = (editor.ListModalColumns * FONT_WIDTH) + (2 * editor.TextPadding) + editor.ModalScrollbarWidth
  editor.ModalInputPadding = editor.TextPadding
  editor.ModalHoverReserve = editor.ModalScrollbarWidth + 4
  editor.OpenModalWidth = editor.EditorScrollX + editor.ScrollbarWidth - editor.EditorLeft - (14 * FONT_WIDTH)
  editor.OpenFolderWidth = (18 * FONT_WIDTH) + (2 * editor.TextPadding) + editor.ModalScrollbarWidth
  editor.OpenButtonWidth = (11 * FONT_WIDTH) + (2 * editor.TextPadding) + 4
  editor.OpenNameReserve = editor.ModalScrollbarWidth + (2 * editor.TextPadding)
  editor.OpenFilterWidth = (4 * FONT_WIDTH) + (2 * editor.TextPadding)
  editor.OpenFilterGap = editor.TextPadding
  editor.OpenFilterPadding = editor.TextPadding

  openFileColumns = ((editor.OpenModalWidth - editor.OpenFolderWidth - editor.OpenNameReserve) \ FONT_WIDTH) - 1
  editor.OpenNameReserve = editor.ModalScrollbarWidth + editor.TextPadding + textWallGap
  editor.OpenModalWidth = editor.OpenFolderWidth + (openFileColumns * FONT_WIDTH) + editor.OpenNameReserve

  openActionsLeft = editor.OpenFolderWidth + editor.TextPadding
  openActionsRight = editor.OpenModalWidth - editor.TextPadding
  openButtonsWidth = (2 * editor.OpenButtonWidth) + (2 * editor.TextPadding)
  editor.OpenCancelOffset = openActionsLeft + ((openActionsRight - openActionsLeft - openButtonsWidth) \ 2)
  editor.OpenConfirmOffset = editor.OpenCancelOffset + editor.OpenButtonWidth + (2 * editor.TextPadding)

  editor.MenuItemWidth = (4 * FONT_WIDTH) + 2
  editor.MenuStep = (4 * FONT_WIDTH) + editor.TextPadding
  editor.MenuFileClickX = 0
  editor.MenuFileClickWidth = editor.MenuItemWidth + 4
  editor.MenuOtherClickWidth = editor.MenuItemWidth
  editor.FileNameBoxX = 4 + (7 * FONT_WIDTH) + (2 * editor.TextPadding) - 1
  editor.FileNameTextPadding = editor.TextPadding
  editor.ConfirmExitWidth = (LEN("PRESS ESC TO CONFIRM, SPACE TO CANCEL") * FONT_WIDTH) + (2 * editor.TextPadding)

  editor.EditorTextWidth = editor.EditorColumns * FONT_WIDTH
  editor.WidthScanIdx = 0
  editor.WidthCachedMaxLen = 0
  editor.WidthTempMaxLen = 0

  editor.StartY = 17

  editor.CursorY = 1
  editor.ScrollY = 1
  editor.LastLine = 1
  editor.SelectStartY = 1
  editor.TabSize = 2

  editorText$(0) = "LINE 0: YOU SHOULD NEVER SEE THIS"
  compileText$(0) = "LINE 0: YOU SHOULD NEVER SEE THIS"

  statusMsg(0).Text = "LINE 0: YOU SHOULD NEVER SEE THIS"
  statusMsg(0).CodeLine = 0
  statusMsgCount = 1
  editor.StatusScrollY = 1
  editor.StatusSelectedIndex = 0

  layout.FramebufSize = FRAMEBUF_MAX_WIDTH * FRAMEBUF_MAX_HEIGHT
  layout.GfxBufEntrySize = 256

  tempSize = layout.GfxBufEntrySize
  shiftCount = 0
  DO WHILE tempSize > 1
    tempSize = tempSize \ 2
    shiftCount = shiftCount + 1
  LOOP
  layout.GfxBufEntryShift = shiftCount

  IF (2 ^ layout.GfxBufEntryShift) <> layout.GfxBufEntrySize THEN
    ESCAPETEXT "COMPILER FAIL: GfxBufEntryShift calculation failed"
  END IF

  ' Record the true native resolution of the monitor
  nativeScreenWidth = _DESKTOPWIDTH
  nativeScreenHeight = _DESKTOPHEIGHT

  ' Determine the taskbar height by subtracting the Windows work area height from the native screen height
  ff = SystemParametersInfoA&(SPI_GETWORKAREA, 0, _OFFSET(wa), 0)
  IF ff <> 0 AND wa.BOTTOM > wa.TOP THEN
    taskbarHeight = nativeScreenHeight - (wa.BOTTOM - wa.TOP)
  ELSE
    taskbarHeight = 0
  END IF

END SUB ' initLayout

''''''''''''''''''''''''
SUB initPalettesBmp

  ' 0-15 Standard VGA-style palette
  bmpPal256(0, palRED) = 0: bmpPal256(0, palGREEN) = 0: bmpPal256(0, palBLUE) = 0 ' Black
  bmpPal256(1, palRED) = 0: bmpPal256(1, palGREEN) = 0: bmpPal256(1, palBLUE) = 170 ' Blue
  bmpPal256(2, palRED) = 0: bmpPal256(2, palGREEN) = 170: bmpPal256(2, palBLUE) = 0 ' Green
  bmpPal256(3, palRED) = 0: bmpPal256(3, palGREEN) = 170: bmpPal256(3, palBLUE) = 170 ' Cyan
  bmpPal256(4, palRED) = 170: bmpPal256(4, palGREEN) = 0: bmpPal256(4, palBLUE) = 0 ' Red
  bmpPal256(5, palRED) = 170: bmpPal256(5, palGREEN) = 0: bmpPal256(5, palBLUE) = 170 ' Magenta
  bmpPal256(6, palRED) = 170: bmpPal256(6, palGREEN) = 85: bmpPal256(6, palBLUE) = 0 ' Brown
  bmpPal256(7, palRED) = 170: bmpPal256(7, palGREEN) = 170: bmpPal256(7, palBLUE) = 170 ' Light Gray
  bmpPal256(8, palRED) = 85: bmpPal256(8, palGREEN) = 85: bmpPal256(8, palBLUE) = 85 ' Dark Gray
  bmpPal256(9, palRED) = 85: bmpPal256(9, palGREEN) = 85: bmpPal256(9, palBLUE) = 255 ' Light Blue
  bmpPal256(10, palRED) = 85: bmpPal256(10, palGREEN) = 255: bmpPal256(10, palBLUE) = 85 ' Light Green
  bmpPal256(11, palRED) = 85: bmpPal256(11, palGREEN) = 255: bmpPal256(11, palBLUE) = 255 ' Light Cyan
  bmpPal256(12, palRED) = 255: bmpPal256(12, palGREEN) = 85: bmpPal256(12, palBLUE) = 85 ' Light Red
  bmpPal256(13, palRED) = 255: bmpPal256(13, palGREEN) = 85: bmpPal256(13, palBLUE) = 255 ' Light Magenta
  bmpPal256(14, palRED) = 255: bmpPal256(14, palGREEN) = 255: bmpPal256(14, palBLUE) = 85 ' Yellow
  bmpPal256(15, palRED) = 255: bmpPal256(15, palGREEN) = 255: bmpPal256(15, palBLUE) = 255 ' Bright White

  ' 16-191 Red spectrum: dim red to bright red
  FOR ii = 16 TO 191
    redVal = ((ii - 16) * 255) \ 175
    bmpPal256(ii, palRED) = redVal
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 192-255 Blue spectrum: dark blue to bright blue
  FOR ii = 192 TO 255
    blueVal = ((ii - 192) * 255) \ 63
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = blueVal
  NEXT

END SUB ' initPalettesBmp

''''''''''''''''''''''''
SUB initPalettesOutput

  ' 0-15 Standard VGA-style palette for output.exe
  outputPal(0, palRED) = 0: outputPal(0, palGREEN) = 0: outputPal(0, palBLUE) = 0 ' Black
  outputPal(1, palRED) = 0: outputPal(1, palGREEN) = 0: outputPal(1, palBLUE) = 170 ' Blue
  outputPal(2, palRED) = 0: outputPal(2, palGREEN) = 170: outputPal(2, palBLUE) = 0 ' Green
  outputPal(3, palRED) = 0: outputPal(3, palGREEN) = 170: outputPal(3, palBLUE) = 170 ' Cyan
  outputPal(4, palRED) = 170: outputPal(4, palGREEN) = 0: outputPal(4, palBLUE) = 0 ' Red
  outputPal(5, palRED) = 170: outputPal(5, palGREEN) = 0: outputPal(5, palBLUE) = 170 ' Magenta
  outputPal(6, palRED) = 170: outputPal(6, palGREEN) = 85: outputPal(6, palBLUE) = 0 ' Brown
  outputPal(7, palRED) = 170: outputPal(7, palGREEN) = 170: outputPal(7, palBLUE) = 170 ' Light Gray
  outputPal(8, palRED) = 85: outputPal(8, palGREEN) = 85: outputPal(8, palBLUE) = 85 ' Dark Gray
  outputPal(9, palRED) = 85: outputPal(9, palGREEN) = 85: outputPal(9, palBLUE) = 255 ' Light Blue
  outputPal(10, palRED) = 85: outputPal(10, palGREEN) = 255: outputPal(10, palBLUE) = 85 ' Light Green
  outputPal(11, palRED) = 85: outputPal(11, palGREEN) = 255: outputPal(11, palBLUE) = 255 ' Light Cyan
  outputPal(12, palRED) = 255: outputPal(12, palGREEN) = 85: outputPal(12, palBLUE) = 85 ' Light Red
  outputPal(13, palRED) = 255: outputPal(13, palGREEN) = 85: outputPal(13, palBLUE) = 255 ' Light Magenta
  outputPal(14, palRED) = 255: outputPal(14, palGREEN) = 255: outputPal(14, palBLUE) = 85 ' Yellow
  outputPal(15, palRED) = 255: outputPal(15, palGREEN) = 255: outputPal(15, palBLUE) = 255 ' Bright White

  ' 16-31 QBasic SCREEN 13 grayscale ramp
  grayLevelData$ = "00050811141720242832364045505663"

  FOR grayIndex = 0 TO 15
    grayLevel = VAL(MID$(grayLevelData$, grayIndex * 2 + 1, 2))
    grayValue = (grayLevel * 255 + 31) \ 63

    outputPal(grayIndex + 16, palRED) = grayValue
    outputPal(grayIndex + 16, palGREEN) = grayValue
    outputPal(grayIndex + 16, palBLUE) = grayValue
  NEXT grayIndex

  ' 32-247 QBasic SCREEN 13 color cycles
  paletteLevelData$ = "001631476331394755634549545863000714212814172124282022242628000408121608101214161112131516"
  paletteLevelMap$ = "444443210000000001234444"
  paletteIndex = 32

  FOR ringIndex = 0 TO 8
    FOR hueIndex = 0 TO 23
      redPosition = hueIndex + 16
      IF redPosition > 23 THEN redPosition = redPosition - 24

      greenPosition = hueIndex + 8
      IF greenPosition > 23 THEN greenPosition = greenPosition - 24

      bluePosition = hueIndex

      redLevelIndex = VAL(MID$(paletteLevelMap$, redPosition + 1, 1))
      greenLevelIndex = VAL(MID$(paletteLevelMap$, greenPosition + 1, 1))
      blueLevelIndex = VAL(MID$(paletteLevelMap$, bluePosition + 1, 1))

      redLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + redLevelIndex * 2 + 1, 2))
      greenLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + greenLevelIndex * 2 + 1, 2))
      blueLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + blueLevelIndex * 2 + 1, 2))

      outputPal(paletteIndex, palRED) = (redLevel * 255 + 31) \ 63
      outputPal(paletteIndex, palGREEN) = (greenLevel * 255 + 31) \ 63
      outputPal(paletteIndex, palBLUE) = (blueLevel * 255 + 31) \ 63

      paletteIndex = paletteIndex + 1
    NEXT hueIndex
  NEXT ringIndex

  ' 248-255 Reserved black entries
  FOR paletteIndex = 248 TO 255
    outputPal(paletteIndex, palRED) = 0
    outputPal(paletteIndex, palGREEN) = 0
    outputPal(paletteIndex, palBLUE) = 0
  NEXT paletteIndex

END SUB ' initPalettesOutput

''''''''''''''''''''''''
SUB initPalettesIDE

  DIM defaultClr AS _UNSIGNED LONG

  ' 0-15 Standard VGA-style palette
  bmpPal256(0, palRED) = 0: bmpPal256(0, palGREEN) = 0: bmpPal256(0, palBLUE) = 0 ' Black
  bmpPal256(1, palRED) = 0: bmpPal256(1, palGREEN) = 0: bmpPal256(1, palBLUE) = 187 ' Blue
  bmpPal256(2, palRED) = 0: bmpPal256(2, palGREEN) = 187: bmpPal256(2, palBLUE) = 187 ' Cyan
  bmpPal256(3, palRED) = 187: bmpPal256(3, palGREEN) = 0: bmpPal256(3, palBLUE) = 0 ' Red
  bmpPal256(4, palRED) = 0: bmpPal256(4, palGREEN) = 0: bmpPal256(4, palBLUE) = 0 ' Black
  bmpPal256(5, palRED) = 187: bmpPal256(5, palGREEN) = 0: bmpPal256(5, palBLUE) = 187 ' Magenta
  bmpPal256(6, palRED) = 187: bmpPal256(6, palGREEN) = 102: bmpPal256(6, palBLUE) = 0 ' Brown
  bmpPal256(7, palRED) = 187: bmpPal256(7, palGREEN) = 187: bmpPal256(7, palBLUE) = 187 ' Light gray
  bmpPal256(8, palRED) = 102: bmpPal256(8, palGREEN) = 102: bmpPal256(8, palBLUE) = 102 ' Dark gray
  bmpPal256(9, palRED) = 102: bmpPal256(9, palGREEN) = 102: bmpPal256(9, palBLUE) = 255 ' Light blue
  bmpPal256(10, palRED) = 102: bmpPal256(10, palGREEN) = 255: bmpPal256(10, palBLUE) = 102 ' Light green
  bmpPal256(11, palRED) = 102: bmpPal256(11, palGREEN) = 255: bmpPal256(11, palBLUE) = 255 ' Light cyan
  bmpPal256(12, palRED) = 0: bmpPal256(12, palGREEN) = 187: bmpPal256(12, palBLUE) = 0 ' Green
  bmpPal256(13, palRED) = 255: bmpPal256(13, palGREEN) = 102: bmpPal256(13, palBLUE) = 255 ' Light magenta
  bmpPal256(14, palRED) = 255: bmpPal256(14, palGREEN) = 255: bmpPal256(14, palBLUE) = 102 ' Yellow
  bmpPal256(15, palRED) = 255: bmpPal256(15, palGREEN) = 255: bmpPal256(15, palBLUE) = 255 ' Bright white

  ' Original custom ramp descriptions retained for reference
  ' 17-31 Green spectrum: dark green to light green

  ' Preserve only the low entries from the following original ramp
  ' 32-191 Red spectrum: dark red to bright red

  ' $10-$3F Default QB64 SCREEN 13 palette
  defaultPaletteImage = _NEWIMAGE(1, 1, 13)

  FOR ii = &H10 TO &H3F
    defaultClr = _PALETTECOLOR(ii, defaultPaletteImage)
    bmpPal256(ii, palRED) = _RED32(defaultClr)
    bmpPal256(ii, palGREEN) = _GREEN32(defaultClr)
    bmpPal256(ii, palBLUE) = _BLUE32(defaultClr)
  NEXT

  _FREEIMAGE defaultPaletteImage

  ' Move the original $10-$1E grays to $F0-$FE
  FOR ii = &H10 TO &H1E
    newIndex = ii + &HE0
    bmpPal256(newIndex, palRED) = bmpPal256(ii, palRED)
    bmpPal256(newIndex, palGREEN) = bmpPal256(ii, palGREEN)
    bmpPal256(newIndex, palBLUE) = bmpPal256(ii, palBLUE)
  NEXT

  ' $10-$1F All black
  FOR ii = &H10 TO &H1F
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' Set the startup RGB values for the background and routine names
  bmpPal256(&H10, palRED) = 4
  bmpPal256(&H10, palGREEN) = 4
  bmpPal256(&H10, palBLUE) = 24

  ' Set the startup RGB values for the current line background
  bmpPal256(&H11, palRED) = 0
  bmpPal256(&H11, palGREEN) = 49
  bmpPal256(&H11, palBLUE) = 78

' Set the startup RGB values for routine names

  bmpPal256(&H12, palRED) = 85
  bmpPal256(&H12, palGREEN) = 206
  bmpPal256(&H12, palBLUE) = 85

  ' Initialize comments from the existing light-gray entry
  bmpPal256(&H13, palRED) = bmpPal256(7, palRED)
  bmpPal256(&H13, palGREEN) = bmpPal256(7, palGREEN)
  bmpPal256(&H13, palBLUE) = bmpPal256(7, palBLUE)

  ' Set the startup RGB values for comments
  bmpPal256(&H13, palRED) = 170
  bmpPal256(&H13, palGREEN) = 185
  bmpPal256(&H13, palBLUE) = 195

  ' Set the startup RGB values for strings
  bmpPal256(&H14, palRED) = 235
  bmpPal256(&H14, palGREEN) = 226
  bmpPal256(&H14, palBLUE) = 157

  ' Set the startup RGB values for numbers
  bmpPal256(&H15, palRED) = 239
  bmpPal256(&H15, palGREEN) = 180
  bmpPal256(&H15, palBLUE) = 180

  ' Set the startup RGB values for keywords
  bmpPal256(&H16, palRED) = 108
  bmpPal256(&H16, palGREEN) = 128
  bmpPal256(&H16, palBLUE) = 157

  ' $40-$7F Red spectrum: dark red to bright red
  FOR ii = &H40 TO &H7F
    redVal = ((ii - &H40) * 255) \ 63
    bmpPal256(ii, palRED) = redVal
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' $80-$BF Green spectrum: dark green to bright green
  FOR ii = &H80 TO &HBF
    greenVal = ((ii - &H80) * 255) \ 63
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = greenVal
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' $C0-$EF Blue spectrum: dark blue to bright blue
  FOR ii = &HC0 TO &HEF
    blueVal = ((ii - &HC0) * 255) \ 47
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = blueVal
  NEXT

  ' $FF Custom color
  bmpPal256(&HFF, palRED) = 255
  bmpPal256(&HFF, palGREEN) = 221
  bmpPal256(&HFF, palBLUE) = 238

END SUB ' initPalettesIDE

''''''''''''''''''''''''
FUNCTION keyCheck (rsKeyString$) ' KeyCheck fast (Follow up with waitKeyRelease to use as slow option)

  wStr$ = UCASE$(rsKeyString$) ' The character that's being checked for. Should be sent uppercase, but just in case
  ' since _KEYDOWN does not return a value, this function polls for key presses and return the value pressed
  ' This function will also help keep track of the special codes that keyDown uses. Only the
  ' codes that have specifically been entered, plus a-z, A-Z (calculated by formula) will work
  ' Returns the value of the key pressed. if keyCheck(whatever$) works just fine, because it
  ' checks to see if the return is greater than zero

  rVal = 0 ' In case we want to copy into a global "last key pressed" tracker

  IF wStr$ = "*" THEN ' * KEY
    IF _KEYDOWN(42) THEN
      keyCheck = 42
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "ESC" THEN ' Escape key
    IF _KEYDOWN(27) THEN
      keyCheck = 27
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "SPACE" THEN ' Space key
    IF _KEYDOWN(32) THEN
      keyCheck = 32
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "TAB" THEN ' Tab key
    IF _KEYDOWN(9) THEN
      keyCheck = 9
      EXIT FUNCTION
    END IF
  END IF

  ' Detect a-z, A-Z, these match ASCII exactly
  IF LEN(wStr$) = 1 THEN ' Handles characters A-Z, uppercase A is 65
    wVal = ASC(wStr$)
    IF ((wVal >= 65) AND (wVal <= 90)) OR ((wVal >= 97) AND (wVal <= 122)) THEN
      IF _KEYDOWN(wVal) OR _KEYDOWN(wVal + 32) THEN ' The +32 is for lowercase
        keyCheck = wVal
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF LEN(wStr$) = 2 AND MID$(wStr$, 1, 1) = "F" THEN ' Handles characters A-Z, uppercase A is 65

    SELECT CASE MID$(wStr$, 2, 1)

      CASE "1": rVal = 15104
      CASE "2": rVal = 15360
      CASE "3": rVal = 15616
      CASE "4": rVal = 15872
      CASE "5": rVal = 16128
      CASE "6": rVal = 16384
      CASE "7": rVal = 16640
      CASE "8": rVal = 16896
      CASE "9": rVal = 17152
      CASE "A": rVal = 17408
      CASE "B": rVal = 34048
      CASE "C": rVal = 34304
      CASE ELSE: EXIT FUNCTION

    END SELECT ' MID$(wStr$, 2, 1)

    IF _KEYDOWN(rVal) THEN
      keyCheck = rVal
      EXIT FUNCTION
    ELSE
      keyCheck = 0
      EXIT FUNCTION
    END IF

  END IF ' a-z, A-Z

  IF wStr$ = "0" THEN ' KEY 0, KEY INS
    IF _KEYDOWN(48) OR _KEYDOWN(20992) THEN rVal = 48
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Arrow keys and number pad for controls (not used yet)
  IF wStr$ = "2" OR wStr$ = "DOWN" THEN
    IF _KEYDOWN(50) OR _KEYDOWN(20480) THEN rVal = 50 ' KEY 2, KEY DOWN
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "3" THEN
    IF _KEYDOWN(51) OR _KEYDOWN(20736) THEN rVal = 51 ' KEY 3
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "4" OR wStr$ = "LEFT" THEN
    IF _KEYDOWN(52) OR _KEYDOWN(19200) THEN rVal = 52 ' KEY 4, KEY LEFT
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "6" OR wStr$ = "RIGHT" THEN
    IF _KEYDOWN(54) OR _KEYDOWN(19712) THEN rVal = 54 ' KEY 6, KEY RIGHT
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "8" OR wStr$ = "UP" THEN
    IF _KEYDOWN(56) OR _KEYDOWN(18432) THEN rVal = 56 ' KEY 8, KEY UP
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key - or key _
  IF wStr$ = "-" THEN
    IF _KEYDOWN(45) OR _KEYDOWN(95) THEN rVal = 45
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key = or key +
  IF wStr$ = "=" THEN
    IF _KEYDOWN(61) OR _KEYDOWN(43) THEN rVal = 61
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key \ (right above enter on the keyboard)
  IF wStr$ = "\" THEN
    IF _KEYDOWN(124) OR _KEYDOWN(92) THEN rVal = 124
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "<" THEN
    IF _KEYDOWN(60) OR _KEYDOWN(44) THEN rVal = 60
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = ">" THEN
    IF _KEYDOWN(62) OR _KEYDOWN(46) THEN rVal = 62
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "'" THEN
    IF _KEYDOWN(34) OR _KEYDOWN(39) THEN rVal = 34
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "/" THEN
    IF _KEYDOWN(63) OR _KEYDOWN(47) THEN rVal = 63
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "ENT" THEN ' ENTER key
    IF _KEYDOWN(13) THEN rVal = 13
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "PGUP" THEN
    IF _KEYDOWN(18688) THEN rVal = 18688
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "PGDN" THEN
    IF _KEYDOWN(20736) THEN rVal = 20736
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "HOME" THEN
    IF _KEYDOWN(18176) THEN rVal = 18176
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "END" THEN
    IF _KEYDOWN(20224) THEN rVal = 20224
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "[" THEN ' Key [ or {
    IF _KEYDOWN(123) OR _KEYDOWN(91) THEN rVal = 123
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "]" THEN ' Key ] or }
    IF _KEYDOWN(125) OR _KEYDOWN(93) THEN rVal = 125
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  keyCheck = rVal ' Always returns uppercase equivalent

END FUNCTION ' keyCheck

''''''''''''''''''''''''
SUB limitSpeed

  ' Only throttle program execution speed to 60 FPS if there is no compilation active
  IF compileState = COMP_IDLE THEN
    _LIMIT 60
  END IF

END SUB ' limitSpeed

''''''''''''''''''''''''
SUB loadFontPixelRow (wFontSet, wGroupX, wGroupY, wRow, wData0$, wData1$, wData2$, wData3$)

  DIM offsetX
  DIM offsetY
  DIM fontHeight
  DIM ix
  DIM cAs
  DIM pixColor
  DIM rowData$

  fontHeight = 8

  IF wFontSet = 1 THEN
    fontHeight = 16
  END IF

  offsetX = wGroupX * 32
  offsetY = (wGroupY * fontHeight) + wRow
  rowData$ = wData0$ + wData1$ + wData2$ + wData3$

  FOR ix = 0 TO 31
    cAs = ASC(rowData$, ix + 1)

    IF cAs = 32 THEN
      pixColor = 0
    ELSE
      IF cAs >= 48 AND cAs <= 57 THEN
        pixColor = cAs - 48
      ELSE
        IF cAs >= 65 AND cAs <= 70 THEN
          pixColor = cAs - 55
        ELSE
          pixColor = 0
        END IF
      END IF
    END IF

    IF wFontSet = 1 THEN
      fontData16(offsetX + ix, offsetY) = pixColor
    ELSE
      fontData(offsetX + ix, offsetY) = pixColor
    END IF
  NEXT

END SUB ' loadFontPixelRow

''''''''''''''''''''''''
SUB loadFontPixelRow9 (wGroupX, wGroupY, wRow, wData0$, wData1$, wData2$, wData3$)

  DIM offsetX
  DIM offsetY
  DIM fontHeight
  DIM ix
  DIM cAs
  DIM pixColor
  DIM rowData$

  ' Match the glyph height used by PrintChr.
  ' The font builder passes ordinary row numbers starting at 0
  fontHeight = FONT_HEIGHT

  offsetX = wGroupX * 36
  offsetY = wGroupY * fontHeight + wRow
  rowData$ = wData0$ + wData1$ + wData2$ + wData3$

  FOR ix = 0 TO 35
    cAs = ASC(rowData$, ix + 1)

    IF cAs = 32 THEN
      pixColor = 0
    ELSE
      IF cAs >= 48 AND cAs <= 57 THEN
        pixColor = cAs - 48
      ELSE
        IF cAs >= 65 AND cAs <= 70 THEN
          pixColor = cAs - 55
        ELSE
          pixColor = 0
        END IF
      END IF
    END IF

    fontData9(offsetX + ix, offsetY) = pixColor
  NEXT

END SUB ' loadFontPixelRow9

''''''''''''''''''''''''
FUNCTION mouseClickedInBox (wStartX, wStartY, wSizeX, wSizeY, wClickType)

  ' 0 = normal click: press and release inside the box
  ' 1 = release only: release inside the box

  tempRet = 0

  IF mouse.Released1 THEN
    IF mouseWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
      IF wClickType = 0 THEN
        IF mouseDownWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
          tempRet = 1
        END IF
      END IF

      IF wClickType = 1 THEN tempRet = 1
    END IF
  END IF

  mouseClickedInBox = tempRet

END FUNCTION ' mouseClickedInBox

''''''''''''''''''''''''
FUNCTION mouseDownWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX >= wStartX AND mouse.DownPosX <= (wStartX + wSizeX - 1) AND mouse.DownPosY >= wStartY AND mouse.DownPosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDownWithinBoxBounds = toRet

END FUNCTION ' mouseDownWithinBoxBounds

''''''''''''''''''''''''
FUNCTION mouseDown2WithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX2 >= wStartX AND mouse.DownPosX2 <= (wStartX + wSizeX - 1) AND mouse.DownPosY2 >= wStartY AND mouse.DownPosY2 <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDown2WithinBoxBounds = toRet

END FUNCTION ' mouseDown2WithinBoxBounds

''''''''''''''''''''''''
SUB mouseReadInput

  mouse.Released1 = 0
  mouse.Released2 = 0
  mouse.Clicked1 = 0
  mouse.Clicked2 = 0
  mouse.Wheel = 0

  DO WHILE _MOUSEINPUT

    rawMouseX = _MOUSEX
    rawMouseY = _MOUSEY

    ' Downscale the physical screen mouse inputs directly into the 640x360 logic layout
    mouse.PosX = (rawMouseX * SCREENSIZEX) \ physicalScreenX
    mouse.PosY = (rawMouseY * SCREENSIZEY) \ physicalScreenY

    IF mouse.PosX < 0 THEN mouse.PosX = 0
    IF mouse.PosY < 0 THEN mouse.PosY = 0
    IF mouse.PosX > SCREENSIZEX - 1 THEN mouse.PosX = SCREENSIZEX - 1
    IF mouse.PosY > SCREENSIZEY - 1 THEN mouse.PosY = SCREENSIZEY - 1

    mouse.Wheel = mouse.Wheel + _MOUSEWHEEL

    pollMouse1Button = _MOUSEBUTTON(1)
    IF pollMouse1Button <> mouse.Button1Down THEN
      IF pollMouse1Button THEN
        mouse.Clicked1 = 1
        mouse.DownPosX = mouse.PosX
        mouse.DownPosY = mouse.PosY
      ELSE
        mouse.Released1 = 1
      END IF
      mouse.Button1Down = pollMouse1Button
    END IF

    pollMouse2Button = _MOUSEBUTTON(2)
    IF pollMouse2Button <> mouse.Button2Down THEN
      IF pollMouse2Button THEN
        mouse.Clicked2 = 1
        mouse.DownPosX2 = mouse.PosX
        mouse.DownPosY2 = mouse.PosY
      ELSE
        mouse.Released2 = 1
      END IF
      mouse.Button2Down = pollMouse2Button
      EXIT SUB
    END IF

  LOOP

END SUB ' mouseReadInput

''''''''''''''''''''''''
FUNCTION mouseWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  ' We use a slightly more forgiving check to handle edge-of-screen jitter
  ' wSizeX and wSizeY are the dimensions, so the right edge is wStartX + wSizeX - 1

  toRet = 0

  ' Use <= to ensure the final pixel is included
  ' We also add a small safety margin if the click is at the absolute screen edge
  IF mouse.PosX >= wStartX AND mouse.PosX <= (wStartX + wSizeX - 1) AND mouse.PosY >= wStartY AND mouse.PosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseWithinBoxBounds = toRet

END FUNCTION ' mouseWithinBoxBounds

''''''''''''''''''''''''
SUB modalColor

  DIM repeatTimeGoal AS DOUBLE
  DIM repeatLastTime AS DOUBLE

  _KEYCLEAR

  editor.TopMenuFocus = 0
  editor.DragActive = 0
  editor.ScrollDragActive = 0
  editor.ScrollDragActiveX = 0

  selectedItem = 1
  selectedClr = editor.windowBgClr
  activeField = 1
  selectAll = 1
  invalidField = 0
  repeatButton = 0
  repeatTimeGoal = 0
  repeatLastTime = TIMER
  statusText$ = ""
  redText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palRED))))
  greenText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palGREEN))))
  blueText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palBLUE))))
  fieldCursor = LEN(redText$)
  borderClr = 8
  bestColorScore = 195076

  ' Match the displayed RGB values used by setPalettes256
  FOR ii = 1 TO 255
    redValue = bmpPal256(ii, palRED)
    greenValue = bmpPal256(ii, palGREEN)
    blueValue = bmpPal256(ii, palBLUE)
    colorScore = (redValue * redValue) + (greenValue * greenValue) + (blueValue * blueValue)

    ' Choose an existing near-black entry while excluding fully black entries
    IF ii < &H10 OR ii > &H1F THEN
      IF colorScore > 0 AND colorScore < bestColorScore THEN
        bestColorScore = colorScore
        borderClr = ii
      END IF
    END IF
  NEXT

  cellSize = 14
  gridSize = 16 * cellSize
  rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
  boxW = editor.OpenModalWidth
  boxH = 416
  boxX = editor.EditorLeft
  boxY = editor.StartY
  gridX = boxX + boxW - editor.TextPadding - gridSize
  gridY = boxY + 62
  panelX = boxX + editor.TextPadding
  panelW = gridX - (3 * FONT_WIDTH) - (2 * editor.TextPadding) - panelX
  listY = boxY + 50
  itemH = rowH + 10
  itemGap = 6
  swatchW = (4 * FONT_WIDTH) + 4
  swatchH = rowH + 2
  swatchX = panelX + panelW - editor.TextPadding - swatchW
  rgbBoxY = listY + (7 * (itemH + itemGap)) + 12
  rgbBoxH = 136
  fieldsX = panelX + editor.TextPadding
  fieldsY = rgbBoxY + rowH + FONT_HEIGHT + 22
  fieldW = (panelW - (4 * editor.TextPadding)) \ 3
  fieldH = rowH + 10
  fieldGap = editor.TextPadding
  arrowW = FONT_WIDTH + editor.TextPadding
  textBoxW = (3 * FONT_WIDTH) + (2 * editor.TextPadding)
  entryW = textBoxW + (2 * arrowW)
  applyBtnX = fieldsX
  applyBtnY = fieldsY + fieldH + 12
  applyBtnW = panelW - (2 * editor.TextPadding)
  applyBtnH = rowH + 8
  infoX = gridX
  infoW = gridSize
  previewY = gridY + gridSize + 14
  previewH = rowH + 10

  closeBtnW = editor.CloseWidth
  closeBtnH = 15
  closeBtnX = boxX + boxW - closeBtnW
  closeBtnY = boxY

  DO
    _LIMIT 60
    mouseReadInput

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH, 0) THEN EXIT DO

    focusChanged = 0
    chooseItem = selectedItem
    FOR ii = 1 TO 7
      itemY = listY + ((ii - 1) * (itemH + itemGap))
      IF mouseClickedInBox(panelX, itemY, panelW, itemH, 0) THEN chooseItem = ii
    NEXT

    IF chooseItem <> selectedItem THEN
      selectedItem = chooseItem
      SELECT CASE selectedItem
        CASE 1: selectedClr = editor.windowBgClr
        CASE 2: selectedClr = sysColor.currentLine
        CASE 3: selectedClr = sysColor.routineNameClr
        CASE 4: selectedClr = sysColor.commentClr
        CASE 5: selectedClr = sysColor.stringClr
        CASE 6: selectedClr = sysColor.numbers
        CASE 7: selectedClr = sysColor.keywords
      END SELECT
      redText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palRED))))
      greenText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palGREEN))))
      blueText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palBLUE))))
      activeField = 1
      focusChanged = 1
      invalidField = 0
      statusText$ = ""
    END IF

    IF mouse.Clicked1 THEN
      repeatButton = 0
      FOR ii = 1 TO 3
        fieldX = fieldsX + ((ii - 1) * (fieldW + fieldGap))
        entryX = fieldX + ((fieldW - entryW) \ 2)
        IF mouseDownWithinBoxBounds(entryX, fieldsY, entryW, fieldH) AND mouseWithinBoxBounds(entryX, fieldsY, entryW, fieldH) THEN
          activeField = ii
          focusChanged = 1
        END IF
      NEXT
    END IF

    applyRequested = mouseClickedInBox(applyBtnX, applyBtnY, applyBtnW, applyBtnH, 0)
    kVal = _KEYHIT

    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF
    IF kVal = 13 THEN applyRequested = 1

    IF kVal = 9 THEN
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        IF activeField = 1 THEN
          activeField = 3
        ELSE
          activeField = activeField - 1
        END IF
      ELSE
        IF activeField = 3 THEN
          activeField = 1
        ELSE
          activeField = activeField + 1
        END IF
      END IF
      focusChanged = 1
    END IF

    IF focusChanged = 1 THEN
      repeatButton = 0
      selectAll = 1
      SELECT CASE activeField
        CASE 1: fieldCursor = LEN(redText$)
        CASE 2: fieldCursor = LEN(greenText$)
        CASE 3: fieldCursor = LEN(blueText$)
      END SELECT
    END IF

    FOR ii = 1 TO 3
      fieldX = fieldsX + ((ii - 1) * (fieldW + fieldGap))
      entryX = fieldX + ((fieldW - entryW) \ 2)
      fieldActive = 0
      IF activeField = ii THEN fieldActive = 1

      SELECT CASE ii
        CASE 1
          ff = editRGBEntry(entryX, fieldsY, entryW, fieldH, redText$, fieldActive, kVal, fieldCursor, selectAll, repeatButton, repeatTimeGoal, repeatLastTime)
        CASE 2
          ff = editRGBEntry(entryX, fieldsY, entryW, fieldH, greenText$, fieldActive, kVal, fieldCursor, selectAll, repeatButton, repeatTimeGoal, repeatLastTime)
        CASE 3
          ff = editRGBEntry(entryX, fieldsY, entryW, fieldH, blueText$, fieldActive, kVal, fieldCursor, selectAll, repeatButton, repeatTimeGoal, repeatLastTime)
      END SELECT

      IF ff THEN
        invalidField = 0
        statusText$ = ""
      END IF
    NEXT

    IF applyRequested THEN
      IF redText$ = "" THEN redText$ = "0"
      IF greenText$ = "" THEN greenText$ = "0"
      IF blueText$ = "" THEN blueText$ = "0"
      validRGB = 1
      invalidField = 0
      FOR ii = 1 TO 3
        SELECT CASE ii
          CASE 1: componentText$ = redText$
          CASE 2: componentText$ = greenText$
          CASE 3: componentText$ = blueText$
        END SELECT

        componentValid = 1
        IF LEN(componentText$) = 0 OR LEN(componentText$) > 3 THEN componentValid = 0
        FOR i2 = 1 TO LEN(componentText$)
          componentChar = ASC(componentText$, i2)
          IF componentChar < 48 OR componentChar > 57 THEN componentValid = 0
        NEXT
        IF VAL(componentText$) > 255 THEN componentValid = 0

        IF componentValid = 0 THEN
          validRGB = 0
          IF invalidField = 0 THEN invalidField = ii
        END IF
      NEXT

      IF selectedClr < &H10 OR selectedClr > &H1F THEN
        validRGB = 0
        statusText$ = "EDITOR SLOT MUST BE $10-$1F"
      ELSE
        IF validRGB = 0 THEN statusText$ = "ENTER 0-255 FOR EACH VALUE"
      END IF

      IF validRGB = 1 THEN
        bmpPal256(selectedClr, palRED) = VAL(redText$)
        bmpPal256(selectedClr, palGREEN) = VAL(greenText$)
        bmpPal256(selectedClr, palBLUE) = VAL(blueText$)

        FOR ii = &H10 TO &H1F
          _PALETTECOLOR ii, _RGB32(bmpPal256(ii, palRED), bmpPal256(ii, palGREEN), bmpPal256(ii, palBLUE)), logicalScreen
          _PALETTECOLOR ii, _RGB32(bmpPal256(ii, palRED), bmpPal256(ii, palGREEN), bmpPal256(ii, palBLUE)), 0
        NEXT

        redText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palRED))))
        greenText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palGREEN))))
        blueText$ = LTRIM$(RTRIM$(STR$(bmpPal256(selectedClr, palBLUE))))
        statusText$ = "RGB APPLIED"
      ELSE
        IF invalidField > 0 THEN activeField = invalidField
      END IF

      selectAll = 1
      SELECT CASE activeField
        CASE 1: fieldCursor = LEN(redText$)
        CASE 2: fieldCursor = LEN(greenText$)
        CASE 3: fieldCursor = LEN(blueText$)
      END SELECT
    END IF

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen
    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    _DEST logicalScreen

    previewClr = selectedClr
    gridHovered = mouseWithinBoxBounds(gridX, gridY, gridSize, gridSize)
    IF gridHovered THEN
      hoverColumn = (mouse.PosX - gridX) \ cellSize
      hoverRow = (mouse.PosY - gridY) \ cellSize
      previewClr = (hoverRow * 16) + hoverColumn
    END IF

    drawBorderBox boxX, boxY, boxW, boxH, 15, borderClr
    LINE (boxX + 1, boxY + 1)-(boxX + boxW - 2, boxY + 15), editor.windowBarClr, BF
    titleText$ = "EDITOR COLORS"
    PrintStr boxX + (boxW - (LEN(titleText$) * FONT_WIDTH)) \ 2, boxY + 4, titleText$, 14, borderClr, 1
    LINE (boxX, boxY + 16)-(boxX + boxW - 1, boxY + 16), 15

    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, borderClr, 1
    PrintStr panelX, boxY + 27, "EDITOR COLORS", 15, borderClr, 1
    PrintStr gridX, boxY + 27, "REFERENCE GRID", 15, borderClr, 1

    FOR ii = 1 TO 7
      itemY = listY + ((ii - 1) * (itemH + itemGap))
      SELECT CASE ii
        CASE 1
          itemText$ = "BACKGROUND"
          itemClr = editor.windowBgClr
        CASE 2
          itemText$ = "CURRENT LINE"
          itemClr = sysColor.currentLine
        CASE 3
          itemText$ = "SUB / FUNCTIONS"
          itemClr = sysColor.routineNameClr
        CASE 4
          itemText$ = "COMMENT COLOR"
          itemClr = sysColor.commentClr
        CASE 5
          itemText$ = "STRING COLOR"
          itemClr = sysColor.stringClr
        CASE 6
          itemText$ = "NUMBERS"
          itemClr = sysColor.numbers
        CASE 7
          itemText$ = "KEYWORDS"
          itemClr = sysColor.keywords
      END SELECT

      itemBg = borderClr
      itemBorder = 8
      IF selectedItem = ii THEN
        itemBg = 1
        itemBorder = 9
      END IF
      IF mouseWithinBoxBounds(panelX, itemY, panelW, itemH) THEN itemBorder = 15

      drawBorderBox panelX, itemY, panelW, itemH, itemBorder, itemBg
      itemTextY = itemY + ((itemH - FONT_HEIGHT) \ 2)
      PrintStr panelX + editor.TextPadding, itemTextY, itemText$, 15, itemBg, 1
      drawBorderBox swatchX, itemY + ((itemH - swatchH) \ 2), swatchW, swatchH, 15, itemClr
    NEXT

    drawBorderBox panelX, rgbBoxY, panelW, rgbBoxH, 8, borderClr
    SELECT CASE selectedItem
      CASE 1: rgbTitle$ = "RGB FOR BACKGROUND"
      CASE 2: rgbTitle$ = "RGB FOR CURRENT LINE"
      CASE 3: rgbTitle$ = "RGB FOR SUB / FUNCTIONS"
      CASE 4: rgbTitle$ = "RGB FOR COMMENT COLOR"
      CASE 5: rgbTitle$ = "RGB FOR STRING COLOR"
      CASE 6: rgbTitle$ = "RGB FOR NUMBERS"
      CASE 7: rgbTitle$ = "RGB FOR KEYWORDS"
    END SELECT
    PrintStr fieldsX, rgbBoxY + 8, rgbTitle$, 15, borderClr, 1

    FOR ii = 1 TO 3
      fieldX = fieldsX + ((ii - 1) * (fieldW + fieldGap))
      entryX = fieldX + ((fieldW - entryW) \ 2)
      textBoxX = entryX + arrowW
      rightArrowX = textBoxX + textBoxW
      SELECT CASE ii
        CASE 1
          fieldLabel$ = "RED"
          fieldText$ = redText$
        CASE 2
          fieldLabel$ = "GREEN"
          fieldText$ = greenText$
        CASE 3
          fieldLabel$ = "BLUE"
          fieldText$ = blueText$
      END SELECT

      PrintStr entryX + ((entryW - (LEN(fieldLabel$) * FONT_WIDTH)) \ 2), fieldsY - FONT_HEIGHT - 6, fieldLabel$, 7, borderClr, 1
      fieldBorder = 8
      IF activeField = ii THEN fieldBorder = 9
      IF invalidField = ii THEN fieldBorder = 3
      leftBg = borderClr
      rightBg = borderClr
      IF mouseWithinBoxBounds(entryX, fieldsY, arrowW, fieldH) THEN leftBg = 1
      IF mouseWithinBoxBounds(rightArrowX, fieldsY, arrowW, fieldH) THEN rightBg = 1
      IF activeField = ii AND mouse.Button1Down THEN
        IF repeatButton = 1 AND mouseWithinBoxBounds(entryX, fieldsY, arrowW, fieldH) THEN leftBg = 9
        IF repeatButton = 2 AND mouseWithinBoxBounds(rightArrowX, fieldsY, arrowW, fieldH) THEN rightBg = 9
      END IF
      leftTextClr = 15
      rightTextClr = 15
      IF VAL(fieldText$) = 0 THEN leftTextClr = 8
      IF VAL(fieldText$) >= 255 THEN rightTextClr = 8

      drawBorderBox entryX, fieldsY, arrowW, fieldH, 8, leftBg
      drawBorderBox textBoxX, fieldsY, textBoxW, fieldH, fieldBorder, borderClr
      drawBorderBox rightArrowX, fieldsY, arrowW, fieldH, 8, rightBg
      arrowTextY = fieldsY + ((fieldH - FONT_HEIGHT) \ 2)
      PrintChr entryX + ((arrowW - FONT_WIDTH) \ 2), arrowTextY, CHR$(17), leftTextClr, leftBg, 1
      PrintChr rightArrowX + ((arrowW - FONT_WIDTH) \ 2), arrowTextY, CHR$(16), rightTextClr, rightBg, 1

      textX = textBoxX + editor.TextPadding
      textY = fieldsY + ((fieldH - FONT_HEIGHT) \ 2)
      IF activeField = ii THEN
        IF selectAll = 1 AND LEN(fieldText$) > 0 THEN
          LINE (textX, textY - 1)-(textX + (LEN(fieldText$) * FONT_WIDTH) - 1, textY + FONT_HEIGHT), 1, BF
        END IF
      END IF
      PrintStr textX, textY, fieldText$, 15, borderClr, 1
      IF activeField = ii THEN
        IF (INT(TIMER * 2) AND 1) = 1 THEN
          caretX = textX + (fieldCursor * FONT_WIDTH)
          LINE (caretX, textY - 1)-(caretX, textY + FONT_HEIGHT), 15
        END IF
      END IF
    NEXT

    applyBg = 1
    IF mouseWithinBoxBounds(applyBtnX, applyBtnY, applyBtnW, applyBtnH) THEN applyBg = 9
    drawBorderBox applyBtnX, applyBtnY, applyBtnW, applyBtnH, 15, applyBg
    applyText$ = "APPLY RGB"
    PrintStr applyBtnX + ((applyBtnW - (LEN(applyText$) * FONT_WIDTH)) \ 2), applyBtnY + ((applyBtnH - FONT_HEIGHT) \ 2), applyText$, 15, applyBg, 1

    feedbackText$ = "TYPE OR HOLD ARROWS - ENTER TO APPLY"
    feedbackClr = 7
    IF statusText$ <> "" THEN
      feedbackText$ = statusText$
      feedbackClr = 12
      IF invalidField > 0 OR selectedClr < &H10 OR selectedClr > &H1F THEN feedbackClr = 3
    END IF
    PrintStr fieldsX, applyBtnY + applyBtnH + 8, feedbackText$, feedbackClr, borderClr, 1

    drawBorderBox gridX - 2, gridY - 2, gridSize + 4, gridSize + 4, borderClr, borderClr

    FOR ix = 0 TO 15
      columnText$ = HEX$(ix)
      PrintStr gridX + (ix * cellSize) + ((cellSize - FONT_WIDTH) \ 2), gridY - FONT_HEIGHT - 3, columnText$, 7, borderClr, 1
    NEXT

    FOR iy = 0 TO 15
      rowText$ = RIGHT$("0" + HEX$(iy * 16), 2)
      PrintStr gridX - (3 * FONT_WIDTH), gridY + (iy * cellSize) + ((cellSize - FONT_HEIGHT) \ 2), rowText$, 7, borderClr, 1

      FOR ix = 0 TO 15
        colorIdx = (iy * 16) + ix
        cellX = gridX + (ix * cellSize)
        cellY = gridY + (iy * cellSize)
        cellClr = colorIdx
        IF colorIdx = 0 THEN cellClr = borderClr

        drawBorderBox cellX, cellY, cellSize, cellSize, borderClr, cellClr

        ' Identify transparent color 0 without drawing a transparent background
        IF colorIdx = 0 THEN
          PrintChr cellX + ((cellSize - FONT_WIDTH + 1) \ 2), cellY + ((cellSize - FONT_HEIGHT + 1) \ 2), "T", 7, borderClr, 1
        END IF

        IF colorIdx = selectedClr THEN
          LINE (cellX, cellY)-(cellX + cellSize - 1, cellY + cellSize - 1), 15, B
        END IF

        IF gridHovered AND colorIdx = previewClr THEN
          LINE (cellX, cellY)-(cellX + cellSize - 1, cellY + cellSize - 1), 14, B
        END IF
      NEXT
    NEXT

    previewFill = previewClr
    IF previewClr = 0 THEN previewFill = borderClr
    drawBorderBox infoX, previewY, infoW, previewH, 8, previewFill
    IF previewClr = 0 THEN
      previewText$ = "TRANSPARENT"
      PrintStr infoX + ((infoW - (LEN(previewText$) * FONT_WIDTH)) \ 2), previewY + ((previewH - FONT_HEIGHT) \ 2), previewText$, 15, borderClr, 1
    END IF

    redValue = bmpPal256(previewClr, palRED)
    greenValue = bmpPal256(previewClr, palGREEN)
    blueValue = bmpPal256(previewClr, palBLUE)
    previewText$ = "$" + RIGHT$("0" + HEX$(previewClr), 2) + "  R" + LTRIM$(RTRIM$(STR$(redValue))) + " G" + LTRIM$(RTRIM$(STR$(greenValue))) + " B" + LTRIM$(RTRIM$(STR$(blueValue)))
    PrintStr infoX, previewY + previewH + 12, previewText$, 15, borderClr, 1
    PrintStr infoX, previewY + previewH + 30, "HOVER TO INSPECT", 7, borderClr, 1

    dispScreenFlushUpdate
  LOOP

  _KEYCLEAR
  mouse.Wheel = 0
  mouse.Clicked1 = 0
  mouse.Clicked2 = 0
  mouse.Released1 = 0
  mouse.Released2 = 0
  editor.TopMenuFocus = 0
  editor.Focus = 1
  _DEST logicalScreen

END SUB ' modalColor

''''''''''''''''''''''''
SUB modalFileMenuNew

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.ModalWidth
    boxH = 82
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - ((LEN("NEW FILE") * FONT_WIDTH) \ 2), boxY + 3, "NEW FILE", 14, 0, 1
    LINE (boxX, boxY + 15)-(boxX + boxW - 1, boxY + 15), 15

    closeBtnW = editor.CloseWidth
    closeBtnH = 15
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH, 0) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - ((LEN("ALL UNSAVED PROGRESS WILL BE LOST") * FONT_WIDTH) \ 2), boxY + 26, "ALL UNSAVED PROGRESS WILL BE LOST", 15, 0, 1

    btnYesW = 8 * FONT_WIDTH
    btnYesH = 20
    btnYesX = boxX + (boxW \ 2) - btnYesW - 16
    btnYesY = boxY + 48

    btnNoW = 8 * FONT_WIDTH
    btnNoH = 20
    btnNoX = boxX + (boxW \ 2) + 16
    btnNoY = boxY + 48

    drawBorderBox btnYesX, btnYesY, btnYesW, btnYesH, 15, 0
    PrintStr btnYesX + (btnYesW - (LEN("YES") * FONT_WIDTH)) \ 2, btnYesY + 6, "YES", 15, 0, 1

    drawBorderBox btnNoX, btnNoY, btnNoW, btnNoH, 15, 0
    PrintStr btnNoX + (btnNoW - (LEN("NO") * FONT_WIDTH)) \ 2, btnNoY + 6, "NO", 15, 0, 1

    dispScreenFlushUpdate

    doNewFile = 0

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        doNewFile = 1
      END IF
    END IF

    IF mouseClickedInBox(btnYesX, btnYesY, btnYesW, btnYesH, 0) THEN
      doNewFile = 1
    END IF

    IF mouseClickedInBox(btnNoX, btnNoY, btnNoW, btnNoH, 0) THEN
      EXIT DO
    END IF

    IF doNewFile = 1 THEN
      drawBorderBox btnYesX, btnYesY, btnYesW, btnYesH, 15, 12
      PrintStr btnYesX + (btnYesW - (LEN("YES") * FONT_WIDTH)) \ 2, btnYesY + 6, "YES", 15, 0, 1
      dispScreenFlushUpdate

      FOR ii = 1 TO EDITOR_LINE_MAX
        editorText$(ii) = ""
      NEXT
      editor.LastLine = 1
      editor.CursorX = 0
      editor.CursorY = 1
      editor.ScrollX = 0
      editor.ScrollY = 1
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.IsSelecting = 0
      undoState.Ready = 0
      lastActionWasTyping = 0
      fileNameBase$ = "DFLTNAME"
      fileNameCustomExt$ = ".BAS"
      editor.FileExtensionMode = FILE_EXT_BAS
      refineCode 0, 0
      addStatusMsg "NEW FILE CREATED"
      EXIT DO
    END IF

  LOOP

END SUB ' modalFileMenuNew

''''''''''''''''''''''''
SUB modalFileMenuOpen

  DIM fileList$(1000)
  DIM fileCount AS LONG
  DIM allFileList$(1000)
  DIM allFileCount AS LONG
  DIM folderList$(1000)
  DIM folderCount AS LONG
  DIM folderArrowH AS LONG
  DIM formatSeconds AS DOUBLE

  folderArrowH = FONT_HEIGHT + 3

  _DEST logicalScreen

  directoryEditActive = 0
  directoryEdit$ = ""
  directoryCursor = 0
  directoryScroll = 0
  directorySelectAll = 0
  directoryInvalid = 0
  directoryEscHandled = 0

  startDir$ = _CWD$
  openedFile = 0
  refreshListing = 1
  folderScroll = 0
  folderDragActive = 0
  folderDragOffset = 0
  selectedKind = 0
  selectedFolderIndex = 0
  selectedFileIndex = 0
  lastClickKind = 0
  lastFolderIndex = 0
  lastFileIndex = 0
  lastClickTime = 0
  showTxtFiles = 0
  showBlbFiles = 0
  showBasFiles = 1
  rebuildFileList = 0
  customEditActive = 0
  customEdit$ = ""
  openCustomExtension$ = LEFT$(openCustomExtension$, 5)

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    IF refreshListing THEN
      fileCount = 0
      allFileCount = 0
      folderCount = 0

      oldClip$ = _CLIPBOARD$
      _CLIPBOARD$ = ""
      SHELL _HIDE "cmd /c (dir /b /a-d 2>nul & echo [[[QBERRDONE]]]) | clip"

      tTime = TIMER
      DO
        limitSpeed
        cb$ = _CLIPBOARD$
        IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
        IF TIMER - tTime > 1.5 THEN EXIT DO
      LOOP

      markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
      IF markerPos > 0 THEN
        cb$ = LEFT$(cb$, markerPos - 1)
      END IF

      ix = 1
      cbLen = LEN(cb$)
      DO WHILE ix <= cbLen
        nextNl = INSTR(ix, cb$, CHR$(10))
        IF nextNl = 0 THEN
          fName$ = MID$(cb$, ix)
          ix = cbLen + 1
        ELSE
          fName$ = MID$(cb$, ix, nextNl - ix)
          ix = nextNl + 1
        END IF

        fName$ = LTRIM$(RTRIM$(fName$))
        IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

        IF fName$ <> "" THEN
          fileExt$ = UCASE$(RIGHT$(fName$, 4))
          includeFile = 0
          IF fileExt$ = ".BAS" THEN includeFile = 1
          IF fileExt$ = ".BLB" THEN includeFile = 1
          IF fileExt$ = ".TXT" THEN includeFile = 1
          IF INSTR(fName$, ".") = 0 THEN includeFile = 1
          IF openCustomExtension$ <> "" THEN
            IF RIGHT$(UCASE$(fName$), LEN(openCustomExtension$)) = openCustomExtension$ THEN includeFile = 1
          END IF

          IF includeFile = 1 THEN
            IF allFileCount < 1000 THEN
              allFileList$(allFileCount) = fName$
              allFileCount = allFileCount + 1
            END IF
          END IF
        END IF
      LOOP

      _CLIPBOARD$ = ""
      SHELL _HIDE "cmd /c (dir /b /ad 2>nul & echo [[[QBERRDONE]]]) | clip"

      tTime = TIMER
      DO
        limitSpeed
        cb$ = _CLIPBOARD$
        IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
        IF TIMER - tTime > 1.5 THEN EXIT DO
      LOOP

      _CLIPBOARD$ = oldClip$

      markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
      IF markerPos > 0 THEN
        cb$ = LEFT$(cb$, markerPos - 1)
      END IF

      ix = 1
      cbLen = LEN(cb$)
      DO WHILE ix <= cbLen
        nextNl = INSTR(ix, cb$, CHR$(10))
        IF nextNl = 0 THEN
          fName$ = MID$(cb$, ix)
          ix = cbLen + 1
        ELSE
          fName$ = MID$(cb$, ix, nextNl - ix)
          ix = nextNl + 1
        END IF

        fName$ = LTRIM$(RTRIM$(fName$))
        IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

        IF fName$ <> "" THEN
          IF fName$ <> "." AND fName$ <> ".." THEN
            IF folderCount < 1000 THEN
              folderList$(folderCount) = fName$
              folderCount = folderCount + 1
            END IF
          END IF
        END IF
      LOOP

      editor.ModalScroll.ScrollY = 0
      editor.ModalScroll.DragActive = 0
      editor.ModalScroll.DragOffset = 0
      folderScroll = 0
      folderDragActive = 0
      folderDragOffset = 0
      selectedKind = 0
      selectedFolderIndex = 0
      selectedFileIndex = 0
      lastClickKind = 0
      lastFolderIndex = 0
      lastFileIndex = 0
      lastClickTime = 0
      refreshListing = 0
      rebuildFileList = 1
    END IF

    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.OpenModalWidth
    footerH = 28
    folderW = editor.OpenFolderWidth
    boxX = editor.EditorLeft
    boxY = editor.StartY
    rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    expandedStatusY = boxY + 6 + ((EDITOR_TEXT_ROWS - 3) * rowH) + STATUS_TOP_GAP + (3 * (rowH - STATUS_ROW_HEIGHT))
    boxH = expandedStatusY - boxY + 3 - footerH
    filePaneX = boxX + folderW
    filePaneW = boxW - folderW

    drawBorderBox boxX, boxY, boxW, boxH + footerH, 15, editor.windowBarClr
    LINE (boxX, boxY + boxH - footerH - 1)-(filePaneX, boxY + boxH - footerH - 1), 15
    LINE (filePaneX, boxY + boxH - 1)-(boxX + boxW - 1, boxY + boxH - 1), 15
    LINE (filePaneX, boxY + 17)-(filePaneX, boxY + boxH - 2), 15

    PrintStr boxX + (boxW \ 2) - ((LEN("OPEN FILE") * FONT_WIDTH)) \ 2, boxY + 4, "OPEN FILE", 14, 0, 1
    LINE (boxX, boxY + 16)-(boxX + boxW - 1, boxY + 16), 15

    pathTextY = boxY + 20
    pathDividerY = boxY + 32
    listTopY = pathDividerY + 2
    listH = boxY + boxH - 1 - listTopY
    folderListH = listH - footerH

    pathDisplay$ = _CWD$
    atDriveRoot = 0
    IF LEN(pathDisplay$) = 3 AND MID$(pathDisplay$, 2, 2) = ":\" THEN atDriveRoot = 1
    maxPathChars = (filePaneW - (2 * editor.TextPadding)) \ FONT_WIDTH
    IF LEN(pathDisplay$) > maxPathChars THEN
      pathDisplay$ = "..." + RIGHT$(pathDisplay$, maxPathChars - 3)
    END IF

    PrintStr boxX + (folderW - (7 * FONT_WIDTH)) \ 2, pathTextY, "FOLDERS", 14, 0, 1
    LINE (boxX, pathDividerY)-(boxX + boxW - 1, pathDividerY), 15

    enterFolder = 0
    openFile = 0
    folderToEnter = 0
    fileToOpen = 0

    cancelW = editor.OpenButtonWidth
    cancelH = 18
    confirmW = editor.OpenButtonWidth
    confirmH = 18
    cancelX = boxX + editor.OpenCancelOffset
    confirmX = boxX + editor.OpenConfirmOffset
    confirmY = boxY + boxH + 5
    cancelY = confirmY

    filterW = editor.OpenFilterWidth
    filterH = 18
    filterGap = editor.OpenFilterGap
    filterBasX = boxX + editor.TextPadding
    filterBlbX = filterBasX + filterW + filterGap
    filterTxtX = filterBlbX + filterW + filterGap
    filterY = cancelY - footerH

    customLabelX = filterBasX
    customY = cancelY
    customInputX = customLabelX + (LEN("CUSTOM:") * FONT_WIDTH) + filterGap
    customInputH = filterH
    customCheckX = customInputX + 4
    customCheckY = customY + 3
    customCheckW = FONT_WIDTH + 2
    customCheckH = FONT_HEIGHT + 2
    customTextX = customCheckX + customCheckW + editor.OpenFilterPadding
    customInputW = customTextX - customInputX + (6 * FONT_WIDTH) + editor.OpenFilterPadding - 3
    customColumns = (customInputX + customInputW - customTextX - (editor.OpenFilterPadding - 3)) \ FONT_WIDTH
    customEscHandled = 0
    applyCustomEdit = 0
    customToggleClicked = 0
    customToggleEnabled = 0
    directoryEscHandled = 0
    directoryClicked = mouseClickedInBox(filePaneX, boxY + 16, filePaneW, 17, 0)

    IF directoryClicked = 1 AND customEditActive = 1 THEN applyCustomEdit = 1

    IF mouseClickedInBox(filterBasX, filterY, filterW, filterH, 0) THEN
      showBasFiles = 1 - showBasFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(filterBlbX, filterY, filterW, filterH, 0) THEN
      showBlbFiles = 1 - showBlbFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(filterTxtX, filterY, filterW, filterH, 0) THEN
      showTxtFiles = 1 - showTxtFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(customInputX, customY, customInputW, customInputH, 0) THEN
      IF mouseWithinBoxBounds(customCheckX, customCheckY, customCheckW, customCheckH) THEN
        customToggleClicked = 1
        customToggleEnabled = 1 - editor.OpenCustomEnabled
        IF customEditActive = 1 THEN applyCustomEdit = 1
        _KEYCLEAR
      ELSE
        IF customEditActive = 0 THEN
          customEdit$ = MID$(openCustomExtension$, 2)
          customEditActive = 1
          _KEYCLEAR
        END IF
      END IF
    END IF

    IF customEditActive = 1 AND mouse.Released1 THEN
      IF mouseWithinBoxBounds(customInputX, customY, customInputW, customInputH) = 0 THEN
        applyCustomEdit = 1
      END IF
    END IF

    IF customEditActive = 1 AND directoryClicked = 0 THEN
      kVal = _KEYHIT
      SELECT CASE kVal
        CASE 27
          customEditActive = 0
          customEscHandled = 1
          applyCustomEdit = 0
          waitKeyRelease "ESC"
          _KEYCLEAR

        CASE 13
          applyCustomEdit = 1

        CASE 8
          IF LEN(customEdit$) > 0 THEN customEdit$ = LEFT$(customEdit$, LEN(customEdit$) - 1)

        CASE ELSE
          validCustomChar = 0
          IF kVal >= 48 AND kVal <= 57 THEN validCustomChar = 1
          IF kVal >= 65 AND kVal <= 90 THEN validCustomChar = 1
          IF kVal >= 97 AND kVal <= 122 THEN validCustomChar = 1
          IF kVal = 43 OR kVal = 45 OR kVal = 46 OR kVal = 95 THEN validCustomChar = 1
          IF kVal = 46 AND LEN(customEdit$) = 0 THEN validCustomChar = 0
          IF validCustomChar = 1 AND LEN(customEdit$) < 4 THEN
            customEdit$ = customEdit$ + UCASE$(CHR$(kVal))
          END IF
      END SELECT
    END IF

    IF applyCustomEdit = 1 THEN
      customValue$ = UCASE$(LTRIM$(RTRIM$(customEdit$)))
      DO WHILE LEFT$(customValue$, 1) = "."
        customValue$ = MID$(customValue$, 2)
      LOOP
      DO WHILE RIGHT$(customValue$, 1) = "."
        customValue$ = LEFT$(customValue$, LEN(customValue$) - 1)
      LOOP

      IF customValue$ <> "" THEN customValue$ = "." + customValue$
      IF customValue$ <> openCustomExtension$ THEN refreshListing = 1
      openCustomExtension$ = customValue$
      editor.OpenCustomEnabled = 1
      customEditActive = 0
      rebuildFileList = 1
      _KEYCLEAR
    END IF

    IF customToggleClicked = 1 THEN
      editor.OpenCustomEnabled = customToggleEnabled
      customEditActive = 0
      rebuildFileList = 1
    END IF

    IF directoryClicked = 1 THEN
      IF directoryEditActive = 0 THEN
        directoryEdit$ = _CWD$
        directoryCursor = LEN(directoryEdit$)
        directoryScroll = 0
        directorySelectAll = 1
        directoryInvalid = 0
      ELSE
        directoryClickCursor = ((mouse.PosX - (filePaneX + editor.TextPadding)) \ FONT_WIDTH) + directoryScroll
        IF directorySelectAll = 0 AND directoryClickCursor > directoryCursor THEN directoryClickCursor = directoryClickCursor - 1
        IF directoryClickCursor < 0 THEN directoryClickCursor = 0
        IF directoryClickCursor > LEN(directoryEdit$) THEN directoryClickCursor = LEN(directoryEdit$)
        directoryCursor = directoryClickCursor
        directorySelectAll = 0
      END IF
      directoryEditActive = 1
      _KEYCLEAR
    ELSE
      IF directoryEditActive = 1 AND mouse.Released1 THEN
        IF mouseWithinBoxBounds(filePaneX, boxY + 16, filePaneW, 17) = 0 THEN directoryEditActive = 0
      END IF
    END IF

    IF directoryEditActive = 1 THEN
      ff = editDirectoryPath(filePaneX + editor.TextPadding, pathTextY, maxPathChars, directoryEdit$, directoryCursor, directoryScroll, directorySelectAll, directoryInvalid)
      SELECT CASE ff
        CASE 1
          directoryEditActive = 0
          refreshListing = 1

        CASE 2
          directoryEditActive = 0
          directoryEscHandled = 1
      END SELECT
    END IF

    directoryBorderClr = 15
    IF directoryEditActive = 1 THEN directoryBorderClr = 12
    IF directoryEditActive = 1 AND directoryInvalid = 1 THEN directoryBorderClr = 3
    LINE (filePaneX, boxY + 16)-(boxX + boxW - 1, pathDividerY), directoryBorderClr, B

    IF directoryEditActive = 0 THEN
      PrintStr filePaneX + editor.TextPadding, pathTextY, pathDisplay$, 15, 0, 1
    END IF

    IF rebuildFileList = 1 THEN
      fileCount = 0
      FOR fileScanIdx = 0 TO allFileCount - 1
        fileExt$ = UCASE$(RIGHT$(allFileList$(fileScanIdx), 4))
        includeFile = 0
        IF fileExt$ = ".BAS" AND showBasFiles = 1 THEN includeFile = 1
        IF fileExt$ = ".BLB" AND showBlbFiles = 1 THEN includeFile = 1
        IF fileExt$ = ".TXT" AND showTxtFiles = 1 THEN includeFile = 1
        IF editor.OpenCustomEnabled = 1 THEN
          IF openCustomExtension$ = "" THEN
            IF INSTR(allFileList$(fileScanIdx), ".") = 0 THEN includeFile = 1
          ELSE
            IF RIGHT$(UCASE$(allFileList$(fileScanIdx)), LEN(openCustomExtension$)) = openCustomExtension$ THEN includeFile = 1
          END IF
        END IF

        IF includeFile = 1 THEN
          fileList$(fileCount) = allFileList$(fileScanIdx)
          fileCount = fileCount + 1
        END IF
      NEXT

      editor.ModalScroll.ScrollY = 0
      editor.ModalScroll.DragActive = 0
      editor.ModalScroll.DragOffset = 0
      IF selectedKind = 2 THEN selectedKind = 0
      selectedFileIndex = 0
      lastClickKind = 0
      lastFolderIndex = 0
      lastFileIndex = 0
      lastClickTime = 0
      rebuildFileList = 0
    END IF

    filterBorderClr = 7
    filterTextClr = 7
    IF showBasFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterBasX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterBasX + editor.OpenFilterPadding, filterY + 5, ".BAS", filterTextClr, 0, 1

    filterBorderClr = 7
    filterTextClr = 7
    IF showBlbFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterBlbX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterBlbX + editor.OpenFilterPadding, filterY + 5, ".BLB", filterTextClr, 0, 1

    filterBorderClr = 7
    filterTextClr = 7
    IF showTxtFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterTxtX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterTxtX + editor.OpenFilterPadding, filterY + 5, ".TXT", filterTextClr, 0, 1

    PrintStr customLabelX, customY + 5, "CUSTOM:", 15, 0, 1
    customBorderClr = 7
    customTextClr = 7
    IF editor.OpenCustomEnabled = 1 THEN
      customBorderClr = 14
      customTextClr = 15
    END IF
    IF customEditActive = 1 THEN
      customBorderClr = 15
      customTextClr = 15
    END IF

    IF customEditActive = 1 THEN
      drawBorderBox customInputX, customY, customInputW, customInputH, 12, editor.windowBarClr
    ELSE
      drawBorderBox customInputX, customY, customInputW, customInputH, 15, editor.windowBarClr
    END IF
    drawBorderBox customCheckX, customCheckY, customCheckW, customCheckH, customBorderClr, 0
    IF editor.OpenCustomEnabled = 1 THEN PrintStr customCheckX + 1, customCheckY + 1, "X", 15, 0, 1

    customDisplay$ = openCustomExtension$
    IF customDisplay$ = "" THEN customDisplay$ = "___"
    IF customEditActive = 1 THEN
      customDisplay$ = RIGHT$("." + customEdit$, customColumns - 1)
      PrintStr customTextX, customY + 5, customDisplay$, customTextClr, 0, 1
      IF LEN(customEdit$) >= 4 THEN
        PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "*", 3, 0, 1
      ELSE
        IF (INT(TIMER * 2) AND 1) = 1 THEN
          PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "*", 15, 0, 1
        ELSE
          PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "_", 15, 0, 1
        END IF
      END IF
    ELSE
      customDisplay$ = LEFT$(customDisplay$, customColumns)
      PrintStr customTextX, customY + 5, customDisplay$, customTextClr, 0, 1
    END IF

    drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, editor.windowBarClr
    confirmTextClr = 7
    IF selectedKind <> 0 THEN confirmTextClr = 15
    PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", confirmTextClr, 0, 1

    drawBorderBox cancelX, cancelY, cancelW, cancelH, 15, editor.windowBarClr
    PrintStr cancelX + (cancelW - (LEN("CANCEL") * FONT_WIDTH)) \ 2, cancelY + 5, "CANCEL", 15, 0, 1

    IF mouseClickedInBox(cancelX, cancelY, cancelW, cancelH, 0) THEN
      EXIT DO
    END IF

    IF mouseClickedInBox(confirmX, confirmY, confirmW, confirmH, 0) THEN
      IF selectedKind = 1 THEN
        enterFolder = 1
        folderToEnter = selectedFolderIndex
      END IF

      IF selectedKind = 2 THEN
        openFile = 1
        fileToOpen = selectedFileIndex
      END IF
    END IF

    itemH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    maxNameChars = (filePaneW - editor.OpenNameReserve) \ FONT_WIDTH
    maxFolderNameChars = (folderW - editor.OpenNameReserve) \ FONT_WIDTH
    maxLines = listH \ itemH
    folderMaxLines = folderListH \ itemH
    folderVisible = folderMaxLines - 1

    IF customEditActive = 0 AND customEscHandled = 0 AND directoryEditActive = 0 AND directoryEscHandled = 0 AND refreshListing = 0 THEN
      kVal = _KEYHIT
      navStep = 0
      IF kVal = 18432 THEN navStep = -1
      IF kVal = 20480 THEN navStep = 1

      IF navStep <> 0 THEN
        IF selectedKind = 0 THEN
          IF fileCount > 0 THEN
            selectedKind = 2
            selectedFileIndex = editor.ModalScroll.ScrollY
          ELSE
            IF atDriveRoot = 0 OR folderCount > 0 THEN
              selectedKind = 1
              selectedFolderIndex = 0
              IF atDriveRoot = 1 THEN selectedFolderIndex = folderScroll + 1
            END IF
          END IF
        ELSE
          IF selectedKind = 1 THEN selectedFolderIndex = selectedFolderIndex + navStep
          IF selectedKind = 2 THEN selectedFileIndex = selectedFileIndex + navStep
        END IF

        IF selectedKind = 1 THEN
          minFolderIndex = 0
          IF atDriveRoot = 1 THEN minFolderIndex = 1
          IF selectedFolderIndex < minFolderIndex THEN selectedFolderIndex = minFolderIndex
          IF selectedFolderIndex > folderCount THEN selectedFolderIndex = folderCount

          IF selectedFolderIndex > 0 THEN
            folderIdx = selectedFolderIndex - 1
            IF folderIdx < folderScroll THEN folderScroll = folderIdx
            IF folderIdx >= folderScroll + folderVisible THEN folderScroll = folderIdx - folderVisible + 1
          END IF

          folderMaxScroll = folderCount - folderVisible
          IF folderMaxScroll < 0 THEN folderMaxScroll = 0
          IF folderScroll < 0 THEN folderScroll = 0
          IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
        END IF

        IF selectedKind = 2 AND fileCount > 0 THEN
          IF selectedFileIndex < 0 THEN selectedFileIndex = 0
          IF selectedFileIndex >= fileCount THEN selectedFileIndex = fileCount - 1
          IF selectedFileIndex < editor.ModalScroll.ScrollY THEN editor.ModalScroll.ScrollY = selectedFileIndex
          IF selectedFileIndex >= editor.ModalScroll.ScrollY + maxLines THEN editor.ModalScroll.ScrollY = selectedFileIndex - maxLines + 1

          maxScroll = fileCount - maxLines
          IF maxScroll < 0 THEN maxScroll = 0
          IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
          IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        END IF

        lastClickKind = 0
      END IF

      jumpKey = kVal
      IF jumpKey >= 97 AND jumpKey <= 122 THEN jumpKey = jumpKey - 32
      IF ((jumpKey >= 65 AND jumpKey <= 90) OR jumpKey = 95) AND (_KEYDOWN(100305) OR _KEYDOWN(100306)) = 0 THEN
        jumpLetter$ = CHR$(jumpKey)
        IF selectedKind = 1 THEN
          FOR ii = 0 TO folderCount - 1
            IF UCASE$(LEFT$(folderList$(ii), 1)) = jumpLetter$ THEN
              selectedFolderIndex = ii + 1
              folderScroll = ii
              folderMaxScroll = folderCount - folderVisible
              IF folderMaxScroll < 0 THEN folderMaxScroll = 0
              IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
              lastClickKind = 0
              EXIT FOR
            END IF
          NEXT
        ELSE
          FOR ii = 0 TO fileCount - 1
            IF UCASE$(LEFT$(fileList$(ii), 1)) = jumpLetter$ THEN
              selectedKind = 2
              selectedFileIndex = ii
              editor.ModalScroll.ScrollY = ii
              maxScroll = fileCount - maxLines
              IF maxScroll < 0 THEN maxScroll = 0
              IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
              lastClickKind = 0
              EXIT FOR
            END IF
          NEXT
        END IF
      END IF
    END IF

    ' Scrollbar
    scrollBarX = boxX + boxW - editor.ModalScrollbarWidth
    scrollBarY = pathDividerY
    scrollBarW = editor.ModalScrollbarWidth
    scrollBarH = listH + listTopY - scrollBarY

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    folderScrollBarX = filePaneX - editor.ModalScrollbarWidth
    folderScrollBarY = pathDividerY
    folderScrollBarW = editor.ModalScrollbarWidth
    folderScrollBarH = folderListH + listTopY - folderScrollBarY

    folderMaxScroll = folderCount - folderVisible
    IF folderMaxScroll < 0 THEN folderMaxScroll = 0
    IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll

    drawBorderBox folderScrollBarX, folderScrollBarY, folderScrollBarW, folderScrollBarH, 15, 0
    drawBorderBox folderScrollBarX, folderScrollBarY, folderScrollBarW, folderArrowH, 15, 0
    drawBorderBox folderScrollBarX, folderScrollBarY + folderScrollBarH - folderArrowH, folderScrollBarW, folderArrowH, 15, 0
    PrintChr folderScrollBarX + (folderScrollBarW - FONT_WIDTH) \ 2 + 1, folderScrollBarY + 2, CHR$(24), 15, 0, 1
    PrintChr folderScrollBarX + (folderScrollBarW - FONT_WIDTH) \ 2 + 1, folderScrollBarY + folderScrollBarH - FONT_HEIGHT - 1, CHR$(25), 15, 0, 1

    folderTrackH = folderScrollBarH - (2 * folderArrowH)
    IF folderCount > folderVisible THEN
      folderThumbH = (folderVisible * folderTrackH) \ folderCount
      IF folderThumbH < SCROLL_THUMB_MIN THEN folderThumbH = SCROLL_THUMB_MIN
      folderThumbY = folderScrollBarY + folderArrowH + ((folderScroll * (folderTrackH - folderThumbH)) \ folderMaxScroll)
    ELSE
      folderThumbH = folderTrackH
      folderThumbY = folderScrollBarY + folderArrowH
    END IF
    drawBorderBox folderScrollBarX + 1, folderThumbY, folderScrollBarW - 2, folderThumbH, 12, 15

    IF mouse.Clicked1 THEN
      IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY, folderScrollBarW, folderArrowH) THEN
        folderScroll = folderScroll - 1
      END IF

      IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY + folderScrollBarH - folderArrowH, folderScrollBarW, folderArrowH) THEN
        folderScroll = folderScroll + 1
      END IF

      IF folderCount > folderVisible THEN
        IF mouseWithinBoxBounds(folderScrollBarX, folderThumbY, folderScrollBarW, folderThumbH) THEN
          folderDragActive = 1
          folderDragOffset = mouse.PosY - folderThumbY
        ELSE
          IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY + folderArrowH, folderScrollBarW, folderTrackH) THEN
            IF mouse.PosY < folderThumbY THEN
              folderScroll = folderScroll - folderVisible
            ELSE
              folderScroll = folderScroll + folderVisible
            END IF
          END IF
        END IF
      END IF
    END IF

    IF mouse.Button1Down AND folderDragActive = 1 THEN
      IF folderCount > folderVisible THEN
        newFolderThumbY = mouse.PosY - folderDragOffset
        folderTrackTravel = folderTrackH - folderThumbH
        IF folderTrackTravel > 0 THEN
          folderScroll = ((newFolderThumbY - (folderScrollBarY + folderArrowH)) * folderMaxScroll) \ folderTrackTravel
        END IF
      END IF
    END IF

    IF mouse.Released1 THEN
      folderDragActive = 0
    END IF

    IF folderScroll < 0 THEN folderScroll = 0
    IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX + 1, listTopY, folderW - 1, folderListH) THEN
        folderScroll = folderScroll + mouse.Wheel
        IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
        IF folderScroll < 0 THEN folderScroll = 0
      END IF

      IF mouseWithinBoxBounds(filePaneX, listTopY, filePaneW, listH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO folderMaxLines - 1
      itemY = listTopY + (ii * itemH)

      IF ii = 0 THEN
        folderChoiceIndex = 0
        folderName$ = ".."
      ELSE
        folderIdx = folderScroll + ii - 1
        IF folderIdx >= folderCount THEN
          EXIT FOR
        END IF
        folderChoiceIndex = folderIdx + 1
        folderName$ = folderList$(folderIdx)
      END IF

      sOutName$ = folderName$
      IF LEN(sOutName$) > maxFolderNameChars THEN sOutName$ = LEFT$(sOutName$, maxFolderNameChars)

      ' Hover
      IF (ii > 0 OR atDriveRoot = 0) AND mouseWithinBoxBounds(boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH) THEN
        drawClearBox boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH, 9

        IF mouseClickedInBox(boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH, 0) THEN
          doubleClick = 0
          IF lastClickKind = 1 THEN
            IF lastFolderIndex = folderChoiceIndex THEN
              clickElapsed = TIMER - lastClickTime
              IF clickElapsed < 0 THEN clickElapsed = clickElapsed + 86400
              IF clickElapsed <= .55 THEN doubleClick = 1
            END IF
          END IF

          selectedKind = 1
          selectedFolderIndex = folderChoiceIndex
          lastClickKind = 1
          lastFolderIndex = folderChoiceIndex
          lastClickTime = TIMER

          IF doubleClick = 1 THEN
            enterFolder = 1
            folderToEnter = folderChoiceIndex
          END IF
        END IF
      END IF

      rowTextClr = 11
      IF ii = 0 AND atDriveRoot = 1 THEN rowTextClr = 7
      IF selectedKind = 1 THEN
        IF selectedFolderIndex = folderChoiceIndex AND (ii > 0 OR atDriveRoot = 0) THEN
          LINE (boxX + 2, itemY)-(boxX + folderW - editor.ModalHoverReserve + 1, itemY + itemH - 1), 1, BF
          rowTextClr = 15
        END IF
      END IF
      PrintStr boxX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, rowTextClr, 0, 1
    NEXT

    IF refreshListing = 0 THEN
      IF fileCount = 0 THEN
        PrintStr filePaneX + editor.TextPadding, listTopY + TEXT_GAP_TOP, "NO MATCHING FILES", 7, 0, 1
      END IF

      FOR ii = 0 TO maxLines - 1
        fIdx = ii + editor.ModalScroll.ScrollY
        IF fIdx < fileCount THEN
          itemY = listTopY + (ii * itemH)
          sOutName$ = fileList$(fIdx)
          IF LEN(sOutName$) > maxNameChars THEN sOutName$ = LEFT$(sOutName$, maxNameChars)

          ' Hover
          IF mouseWithinBoxBounds(filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH) THEN
            drawClearBox filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH, 9

            IF mouseClickedInBox(filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH, 0) THEN
              doubleClick = 0
              IF lastClickKind = 2 THEN
                IF lastFileIndex = fIdx THEN
                  clickElapsed = TIMER - lastClickTime
                  IF clickElapsed < 0 THEN clickElapsed = clickElapsed + 86400
                  IF clickElapsed <= .55 THEN doubleClick = 1
                END IF
              END IF

              selectedKind = 2
              selectedFileIndex = fIdx
              lastClickKind = 2
              lastFileIndex = fIdx
              lastClickTime = TIMER

              IF doubleClick = 1 THEN
                openFile = 1
                fileToOpen = fIdx
              END IF
            END IF
          END IF

          rowTextClr = 11
          IF selectedKind = 2 THEN
            IF selectedFileIndex = fIdx THEN
              LINE (filePaneX + 2, itemY)-(filePaneX + filePaneW - editor.ModalHoverReserve + 1, itemY + itemH - 1), 1, BF
              rowTextClr = 15
            END IF
          END IF
          PrintStr filePaneX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, rowTextClr, 0, 1
        END IF
      NEXT

      IF enterFolder = 1 OR openFile = 1 THEN
        drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, 12
        PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", 15, 0, 1
      END IF

      dispScreenFlushUpdate

      IF enterFolder = 1 THEN
        waitTimer UI_FLASH_TIME

        oldDir$ = _CWD$
        IF folderToEnter = 0 THEN
          CHDIR ".."
        ELSE
          folderIdx = folderToEnter - 1
          IF folderIdx >= 0 AND folderIdx < folderCount THEN
            folderName$ = folderList$(folderIdx)
            IF _DIREXISTS(folderName$) THEN CHDIR folderName$
          END IF
        END IF

        IF _CWD$ <> oldDir$ THEN refreshListing = 1
      END IF

      IF openFile = 1 THEN
        IF fileToOpen >= 0 AND fileToOpen < fileCount THEN
          waitTimer UI_FLASH_TIME

          cleanName$ = fileList$(fileToOpen)
          dotPos = 0
          FOR dotScanPos = LEN(cleanName$) TO 1 STEP -1
            IF MID$(cleanName$, dotScanPos, 1) = "." THEN
              dotPos = dotScanPos
              EXIT FOR
            END IF
          NEXT

          IF dotPos > 0 THEN
            extStr$ = UCASE$(MID$(cleanName$, dotPos))
            cleanName$ = LEFT$(cleanName$, dotPos - 1)
            fileNameCustomExt$ = extStr$
            IF extStr$ = ".TXT" THEN
              editor.FileExtensionMode = FILE_EXT_TXT
            ELSE
              IF extStr$ = ".BLB" THEN
                editor.FileExtensionMode = FILE_EXT_BLB
              ELSE
                editor.FileExtensionMode = FILE_EXT_BAS
              END IF
            END IF
          ELSE
            fileNameCustomExt$ = "" ' Filename has no extension
            editor.FileExtensionMode = FILE_EXT_BAS
          END IF

          fileNameBase$ = cleanName$
          fileCodeLoad
          refineCode 0, 0

          editor.CursorY = 1
          editor.CursorX = 0
          editor.ScrollY = 1
          editor.ScrollX = 0
          editor.SelectStartX = 0
          editor.SelectStartY = 1
          editor.IsSelecting = 0
          editor.Focus = 1

          curExt$ = fileNameCustomExt$

          statusResult$ = "LOADED " + fileNameBase$ + curExt$
          addStatusMsg statusResult$

          IF fileLoadTiming.Ready = 1 THEN
            formatSeconds = TIMER - fileLoadTiming.RefineStart
            IF formatSeconds < 0 THEN formatSeconds = formatSeconds + 86400
            fileLoadTiming.Ready = 0
            addStatusMsgContinuation fileTimingReport$("LOAD", fileLoadTiming.ReadSeconds, fileLoadTiming.UndoSeconds, fileLoadTiming.TextSeconds, formatSeconds)
            compileStatusMsg$ = statusResult$
          END IF

          openedFile = 1
          EXIT DO
        END IF
      END IF

      IF customEditActive = 0 AND customEscHandled = 0 AND directoryEditActive = 0 AND directoryEscHandled = 0 THEN
        kVal = keyCheck("ESC")
        IF kVal = 27 THEN
          waitKeyRelease "ESC"
          EXIT DO
        END IF
      END IF
    END IF

  LOOP

  IF openedFile = 0 THEN CHDIR startDir$

  _DEST logicalScreen

END SUB ' modalFileMenuOpen

''''''''''''''''''''''''
SUB modalFileMenuSave

  saveAsName$ = fileNameBase$
  IF fileNameCustomExt$ <> "" THEN
    IF fileNameCustomExt$ <> ".BAS" AND fileNameCustomExt$ <> ".TXT" AND fileNameCustomExt$ <> ".BLB" THEN
      saveAsName$ = fileNameBase$ + fileNameCustomExt$
    END IF
  END IF

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.ModalWidth
    boxH = 66
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - ((LEN("SAVE AS") * FONT_WIDTH) \ 2), boxY + 3, "SAVE AS", 14, 0, 1
    LINE (boxX, boxY + 15)-(boxX + boxW - 1, boxY + 15), 15

    closeBtnW = editor.CloseWidth
    closeBtnH = 15
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH, 0) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 26
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    displayText$ = saveAsName$ + "_"
    inputColumns = (inputBoxW - (2 * editor.ModalInputPadding)) \ FONT_WIDTH
    displayText$ = RIGHT$(displayText$, inputColumns)
    PrintStr inputBoxX + editor.ModalInputPadding, inputBoxY + 4, displayText$, 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF saveAsName$ <> "" THEN
          cleanName$ = saveAsName$
          dotPos = 0
          FOR iDot = LEN(cleanName$) TO 1 STEP -1
            IF MID$(cleanName$, iDot, 1) = "." THEN dotPos = iDot: EXIT FOR
          NEXT

          IF dotPos > 0 THEN
            extStr$ = UCASE$(MID$(cleanName$, dotPos))
            cleanName$ = LEFT$(cleanName$, dotPos - 1)
            fileNameCustomExt$ = extStr$
            IF extStr$ = ".TXT" THEN
              editor.FileExtensionMode = FILE_EXT_TXT
            ELSE
              IF extStr$ = ".BLB" THEN
                editor.FileExtensionMode = FILE_EXT_BLB
              ELSE
                editor.FileExtensionMode = FILE_EXT_BAS
              END IF
            END IF
          END IF

          fileNameBase$ = cleanName$

          curExt$ = fileNameCustomExt$

          fileCodeSave
          addStatusMsg "SAVED AS " + fileNameBase$ + curExt$
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(saveAsName$)
        IF qLen > 0 THEN
          saveAsName$ = LEFT$(saveAsName$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(saveAsName$) < 34 THEN
            saveAsName$ = saveAsName$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalFileMenuSave

''''''''''''''''''''''''
SUB modalGoToLine

  _KEYCLEAR

  goToStr$ = ""

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.GoToWidth
    boxH = 66
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - ((LEN("GO TO LINE") * FONT_WIDTH) \ 2), boxY + 3, "GO TO LINE", 14, 0, 1
    LINE (boxX, boxY + 15)-(boxX + boxW - 1, boxY + 15), 15

    closeBtnW = editor.CloseWidth
    closeBtnH = 15
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH, 0) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 26
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    displayText$ = goToStr$ + "_"
    inputColumns = (inputBoxW - (2 * editor.ModalInputPadding)) \ FONT_WIDTH
    displayText$ = RIGHT$(displayText$, inputColumns)
    PrintStr inputBoxX + editor.ModalInputPadding, inputBoxY + 4, displayText$, 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF goToStr$ <> "" THEN
          targetLine = VAL(goToStr$)
          IF targetLine > 0 THEN
            IF targetLine > editor.LastLine THEN targetLine = editor.LastLine
            editor.CursorY = targetLine
            editor.CursorX = 0
            editor.ScrollY = targetLine - ((EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)) \ 2)
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = targetLine
            editor.IsSelecting = 0
            editor.Focus = 1
          END IF
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(goToStr$)
        IF qLen > 0 THEN
          goToStr$ = LEFT$(goToStr$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 48 AND kVal <= 57 THEN ' Numbers only
          IF LEN(goToStr$) < 6 THEN
            goToStr$ = goToStr$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalGoToLine

''''''''''''''''''''''''
SUB modalImportFile

  DIM fileList$(1000)
  DIM fileCount AS LONG
  DIM allFileList$(1000)
  DIM allFileCount AS LONG
  DIM folderList$(1000)
  DIM folderCount AS LONG
  DIM folderArrowH AS LONG
  DIM importStartLine AS LONG
  DIM formatSeconds AS DOUBLE

  folderArrowH = FONT_HEIGHT + 3

  _DEST logicalScreen

  directoryEditActive = 0
  directoryEdit$ = ""
  directoryCursor = 0
  directoryScroll = 0
  directorySelectAll = 0
  directoryInvalid = 0
  directoryEscHandled = 0

  startDir$ = _CWD$
  refreshListing = 1
  folderScroll = 0
  folderDragActive = 0
  folderDragOffset = 0
  selectedKind = 0
  selectedFolderIndex = 0
  selectedFileIndex = 0
  lastClickKind = 0
  lastFolderIndex = 0
  lastFileIndex = 0
  lastClickTime = 0
  showTxtFiles = 0
  showBlbFiles = 1
  showBasFiles = 0
  editor.OpenCustomEnabled = 0
  rebuildFileList = 0
  customEditActive = 0
  customEdit$ = ""
  openCustomExtension$ = LEFT$(openCustomExtension$, 5)

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    IF refreshListing THEN
      fileCount = 0
      allFileCount = 0
      folderCount = 0

      oldClip$ = _CLIPBOARD$
      _CLIPBOARD$ = ""
      SHELL _HIDE "cmd /c (dir /b /a-d 2>nul & echo [[[QBERRDONE]]]) | clip"

      tTime = TIMER
      DO
        limitSpeed
        cb$ = _CLIPBOARD$
        IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
        IF TIMER - tTime > 1.5 THEN EXIT DO
      LOOP

      markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
      IF markerPos > 0 THEN
        cb$ = LEFT$(cb$, markerPos - 1)
      END IF

      ix = 1
      cbLen = LEN(cb$)
      DO WHILE ix <= cbLen
        nextNl = INSTR(ix, cb$, CHR$(10))
        IF nextNl = 0 THEN
          fName$ = MID$(cb$, ix)
          ix = cbLen + 1
        ELSE
          fName$ = MID$(cb$, ix, nextNl - ix)
          ix = nextNl + 1
        END IF

        fName$ = LTRIM$(RTRIM$(fName$))
        IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

        IF fName$ <> "" THEN
          fileExt$ = UCASE$(RIGHT$(fName$, 4))
          includeFile = 0
          IF fileExt$ = ".BAS" THEN includeFile = 1
          IF fileExt$ = ".BLB" THEN includeFile = 1
          IF fileExt$ = ".TXT" THEN includeFile = 1
          IF INSTR(fName$, ".") = 0 THEN includeFile = 1
          IF openCustomExtension$ <> "" THEN
            IF RIGHT$(UCASE$(fName$), LEN(openCustomExtension$)) = openCustomExtension$ THEN includeFile = 1
          END IF

          IF includeFile = 1 THEN
            IF allFileCount < 1000 THEN
              allFileList$(allFileCount) = fName$
              allFileCount = allFileCount + 1
            END IF
          END IF
        END IF
      LOOP

      _CLIPBOARD$ = ""
      SHELL _HIDE "cmd /c (dir /b /ad 2>nul & echo [[[QBERRDONE]]]) | clip"

      tTime = TIMER
      DO
        limitSpeed
        cb$ = _CLIPBOARD$
        IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
        IF TIMER - tTime > 1.5 THEN EXIT DO
      LOOP

      _CLIPBOARD$ = oldClip$

      markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
      IF markerPos > 0 THEN
        cb$ = LEFT$(cb$, markerPos - 1)
      END IF

      ix = 1
      cbLen = LEN(cb$)
      DO WHILE ix <= cbLen
        nextNl = INSTR(ix, cb$, CHR$(10))
        IF nextNl = 0 THEN
          fName$ = MID$(cb$, ix)
          ix = cbLen + 1
        ELSE
          fName$ = MID$(cb$, ix, nextNl - ix)
          ix = nextNl + 1
        END IF

        fName$ = LTRIM$(RTRIM$(fName$))
        IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

        IF fName$ <> "" THEN
          IF fName$ <> "." AND fName$ <> ".." THEN
            IF folderCount < 1000 THEN
              folderList$(folderCount) = fName$
              folderCount = folderCount + 1
            END IF
          END IF
        END IF
      LOOP

      editor.ModalScroll.ScrollY = 0
      editor.ModalScroll.DragActive = 0
      editor.ModalScroll.DragOffset = 0
      folderScroll = 0
      folderDragActive = 0
      folderDragOffset = 0
      selectedKind = 0
      selectedFolderIndex = 0
      selectedFileIndex = 0
      lastClickKind = 0
      lastFolderIndex = 0
      lastFileIndex = 0
      lastClickTime = 0
      refreshListing = 0
      rebuildFileList = 1
    END IF

    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.OpenModalWidth
    footerH = 28
    folderW = editor.OpenFolderWidth
    boxX = editor.EditorLeft
    boxY = editor.StartY
    rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    expandedStatusY = boxY + 6 + ((EDITOR_TEXT_ROWS - 3) * rowH) + STATUS_TOP_GAP + (3 * (rowH - STATUS_ROW_HEIGHT))
    boxH = expandedStatusY - boxY + 3 - footerH
    filePaneX = boxX + folderW
    filePaneW = boxW - folderW

    drawBorderBox boxX, boxY, boxW, boxH + footerH, 15, editor.windowBarClr
    LINE (boxX, boxY + boxH - footerH - 1)-(filePaneX, boxY + boxH - footerH - 1), 15
    LINE (filePaneX, boxY + boxH - 1)-(boxX + boxW - 1, boxY + boxH - 1), 15
    LINE (filePaneX, boxY + 17)-(filePaneX, boxY + boxH - 2), 15

    PrintStr boxX + (boxW \ 2) - ((LEN("IMPORT FILE") * FONT_WIDTH)) \ 2, boxY + 4, "IMPORT FILE", 14, 0, 1
    LINE (boxX, boxY + 16)-(boxX + boxW - 1, boxY + 16), 15

    pathTextY = boxY + 20
    pathDividerY = boxY + 32
    listTopY = pathDividerY + 2
    listH = boxY + boxH - 1 - listTopY
    folderListH = listH - footerH

    pathDisplay$ = _CWD$
    atDriveRoot = 0
    IF LEN(pathDisplay$) = 3 AND MID$(pathDisplay$, 2, 2) = ":\" THEN atDriveRoot = 1
    maxPathChars = (filePaneW - (2 * editor.TextPadding)) \ FONT_WIDTH
    IF LEN(pathDisplay$) > maxPathChars THEN
      pathDisplay$ = "..." + RIGHT$(pathDisplay$, maxPathChars - 3)
    END IF

    PrintStr boxX + (folderW - (7 * FONT_WIDTH)) \ 2, pathTextY, "FOLDERS", 14, 0, 1
    LINE (boxX, pathDividerY)-(boxX + boxW - 1, pathDividerY), 15

    enterFolder = 0
    importFileNow = 0
    folderToEnter = 0
    fileToImport = 0

    cancelW = editor.OpenButtonWidth
    cancelH = 18
    confirmW = editor.OpenButtonWidth
    confirmH = 18
    cancelX = boxX + editor.OpenCancelOffset
    confirmX = boxX + editor.OpenConfirmOffset
    confirmY = boxY + boxH + 5
    cancelY = confirmY

    filterW = editor.OpenFilterWidth
    filterH = 18
    filterGap = editor.OpenFilterGap
    filterBasX = boxX + editor.TextPadding
    filterBlbX = filterBasX + filterW + filterGap
    filterTxtX = filterBlbX + filterW + filterGap
    filterY = cancelY - footerH

    customLabelX = filterBasX
    customY = cancelY
    customInputX = customLabelX + (LEN("CUSTOM:") * FONT_WIDTH) + filterGap
    customInputH = filterH
    customCheckX = customInputX + 4
    customCheckY = customY + 3
    customCheckW = FONT_WIDTH + 2
    customCheckH = FONT_HEIGHT + 2
    customTextX = customCheckX + customCheckW + editor.OpenFilterPadding
    customInputW = customTextX - customInputX + (6 * FONT_WIDTH) + editor.OpenFilterPadding - 3
    customColumns = (customInputX + customInputW - customTextX - (editor.OpenFilterPadding - 3)) \ FONT_WIDTH
    customEscHandled = 0
    applyCustomEdit = 0
    customToggleClicked = 0
    customToggleEnabled = 0
    directoryEscHandled = 0
    directoryClicked = mouseClickedInBox(filePaneX, boxY + 16, filePaneW, 17, 0)

    IF directoryClicked = 1 AND customEditActive = 1 THEN applyCustomEdit = 1

    IF mouseClickedInBox(filterBasX, filterY, filterW, filterH, 0) THEN
      showBasFiles = 1 - showBasFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(filterBlbX, filterY, filterW, filterH, 0) THEN
      showBlbFiles = 1 - showBlbFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(filterTxtX, filterY, filterW, filterH, 0) THEN
      showTxtFiles = 1 - showTxtFiles
      rebuildFileList = 1
    END IF

    IF mouseClickedInBox(customInputX, customY, customInputW, customInputH, 0) THEN
      IF mouseWithinBoxBounds(customCheckX, customCheckY, customCheckW, customCheckH) THEN
        customToggleClicked = 1
        customToggleEnabled = 1 - editor.OpenCustomEnabled
        IF customEditActive = 1 THEN applyCustomEdit = 1
        _KEYCLEAR
      ELSE
        IF customEditActive = 0 THEN
          customEdit$ = MID$(openCustomExtension$, 2)
          customEditActive = 1
          _KEYCLEAR
        END IF
      END IF
    END IF

    IF customEditActive = 1 AND mouse.Released1 THEN
      IF mouseWithinBoxBounds(customInputX, customY, customInputW, customInputH) = 0 THEN
        applyCustomEdit = 1
      END IF
    END IF

    IF customEditActive = 1 AND directoryClicked = 0 THEN
      kVal = _KEYHIT
      SELECT CASE kVal
        CASE 27
          customEditActive = 0
          customEscHandled = 1
          applyCustomEdit = 0
          waitKeyRelease "ESC"
          _KEYCLEAR

        CASE 13
          applyCustomEdit = 1

        CASE 8
          IF LEN(customEdit$) > 0 THEN customEdit$ = LEFT$(customEdit$, LEN(customEdit$) - 1)

        CASE ELSE
          validCustomChar = 0
          IF kVal >= 48 AND kVal <= 57 THEN validCustomChar = 1
          IF kVal >= 65 AND kVal <= 90 THEN validCustomChar = 1
          IF kVal >= 97 AND kVal <= 122 THEN validCustomChar = 1
          IF kVal = 43 OR kVal = 45 OR kVal = 46 OR kVal = 95 THEN validCustomChar = 1
          IF kVal = 46 AND LEN(customEdit$) = 0 THEN validCustomChar = 0
          IF validCustomChar = 1 AND LEN(customEdit$) < 4 THEN
            customEdit$ = customEdit$ + UCASE$(CHR$(kVal))
          END IF
      END SELECT
    END IF

    IF applyCustomEdit = 1 THEN
      customValue$ = UCASE$(LTRIM$(RTRIM$(customEdit$)))
      DO WHILE LEFT$(customValue$, 1) = "."
        customValue$ = MID$(customValue$, 2)
      LOOP
      DO WHILE RIGHT$(customValue$, 1) = "."
        customValue$ = LEFT$(customValue$, LEN(customValue$) - 1)
      LOOP

      IF customValue$ <> "" THEN customValue$ = "." + customValue$
      IF customValue$ <> openCustomExtension$ THEN refreshListing = 1
      openCustomExtension$ = customValue$
      editor.OpenCustomEnabled = 1
      customEditActive = 0
      rebuildFileList = 1
      _KEYCLEAR
    END IF

    IF customToggleClicked = 1 THEN
      editor.OpenCustomEnabled = customToggleEnabled
      customEditActive = 0
      rebuildFileList = 1
    END IF

    IF directoryClicked = 1 THEN
      IF directoryEditActive = 0 THEN
        directoryEdit$ = _CWD$
        directoryCursor = LEN(directoryEdit$)
        directoryScroll = 0
        directorySelectAll = 1
        directoryInvalid = 0
      ELSE
        directoryClickCursor = ((mouse.PosX - (filePaneX + editor.TextPadding)) \ FONT_WIDTH) + directoryScroll
        IF directorySelectAll = 0 AND directoryClickCursor > directoryCursor THEN directoryClickCursor = directoryClickCursor - 1
        IF directoryClickCursor < 0 THEN directoryClickCursor = 0
        IF directoryClickCursor > LEN(directoryEdit$) THEN directoryClickCursor = LEN(directoryEdit$)
        directoryCursor = directoryClickCursor
        directorySelectAll = 0
      END IF
      directoryEditActive = 1
      _KEYCLEAR
    ELSE
      IF directoryEditActive = 1 AND mouse.Released1 THEN
        IF mouseWithinBoxBounds(filePaneX, boxY + 16, filePaneW, 17) = 0 THEN directoryEditActive = 0
      END IF
    END IF

    IF directoryEditActive = 1 THEN
      ff = editDirectoryPath(filePaneX + editor.TextPadding, pathTextY, maxPathChars, directoryEdit$, directoryCursor, directoryScroll, directorySelectAll, directoryInvalid)
      SELECT CASE ff
        CASE 1
          directoryEditActive = 0
          refreshListing = 1

        CASE 2
          directoryEditActive = 0
          directoryEscHandled = 1
      END SELECT
    END IF

    directoryBorderClr = 15
    IF directoryEditActive = 1 THEN directoryBorderClr = 12
    IF directoryEditActive = 1 AND directoryInvalid = 1 THEN directoryBorderClr = 3
    LINE (filePaneX, boxY + 16)-(boxX + boxW - 1, pathDividerY), directoryBorderClr, B

    IF directoryEditActive = 0 THEN
      PrintStr filePaneX + editor.TextPadding, pathTextY, pathDisplay$, 15, 0, 1
    END IF

    IF rebuildFileList = 1 THEN
      fileCount = 0
      FOR fileScanIdx = 0 TO allFileCount - 1
        fileExt$ = UCASE$(RIGHT$(allFileList$(fileScanIdx), 4))
        includeFile = 0
        IF fileExt$ = ".BAS" AND showBasFiles = 1 THEN includeFile = 1
        IF fileExt$ = ".BLB" AND showBlbFiles = 1 THEN includeFile = 1
        IF fileExt$ = ".TXT" AND showTxtFiles = 1 THEN includeFile = 1
        IF editor.OpenCustomEnabled = 1 THEN
          IF openCustomExtension$ = "" THEN
            IF INSTR(allFileList$(fileScanIdx), ".") = 0 THEN includeFile = 1
          ELSE
            IF RIGHT$(UCASE$(allFileList$(fileScanIdx)), LEN(openCustomExtension$)) = openCustomExtension$ THEN includeFile = 1
          END IF
        END IF

        IF includeFile = 1 THEN
          fileList$(fileCount) = allFileList$(fileScanIdx)
          fileCount = fileCount + 1
        END IF
      NEXT

      editor.ModalScroll.ScrollY = 0
      editor.ModalScroll.DragActive = 0
      editor.ModalScroll.DragOffset = 0
      IF selectedKind = 2 THEN selectedKind = 0
      selectedFileIndex = 0
      lastClickKind = 0
      lastFolderIndex = 0
      lastFileIndex = 0
      lastClickTime = 0
      rebuildFileList = 0
    END IF

    filterBorderClr = 7
    filterTextClr = 7
    IF showBasFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterBasX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterBasX + editor.OpenFilterPadding, filterY + 5, ".BAS", filterTextClr, 0, 1

    filterBorderClr = 7
    filterTextClr = 7
    IF showBlbFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterBlbX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterBlbX + editor.OpenFilterPadding, filterY + 5, ".BLB", filterTextClr, 0, 1

    filterBorderClr = 7
    filterTextClr = 7
    IF showTxtFiles = 1 THEN
      filterBorderClr = 14
      filterTextClr = 15
    END IF
    drawBorderBox filterTxtX, filterY, filterW, filterH, filterBorderClr, editor.windowBarClr
    PrintStr filterTxtX + editor.OpenFilterPadding, filterY + 5, ".TXT", filterTextClr, 0, 1

    PrintStr customLabelX, customY + 5, "CUSTOM:", 15, 0, 1
    customBorderClr = 7
    customTextClr = 7
    IF editor.OpenCustomEnabled = 1 THEN
      customBorderClr = 14
      customTextClr = 15
    END IF
    IF customEditActive = 1 THEN
      customBorderClr = 15
      customTextClr = 15
    END IF

    IF customEditActive = 1 THEN
      drawBorderBox customInputX, customY, customInputW, customInputH, 12, editor.windowBarClr
    ELSE
      drawBorderBox customInputX, customY, customInputW, customInputH, 15, editor.windowBarClr
    END IF
    drawBorderBox customCheckX, customCheckY, customCheckW, customCheckH, customBorderClr, 0
    IF editor.OpenCustomEnabled = 1 THEN PrintStr customCheckX + 1, customCheckY + 1, "X", 15, 0, 1

    customDisplay$ = openCustomExtension$
    IF customDisplay$ = "" THEN customDisplay$ = "___"
    IF customEditActive = 1 THEN
      customDisplay$ = RIGHT$("." + customEdit$, customColumns - 1)
      PrintStr customTextX, customY + 5, customDisplay$, customTextClr, 0, 1
      IF LEN(customEdit$) >= 4 THEN
        PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "*", 3, 0, 1
      ELSE
        IF (INT(TIMER * 2) AND 1) = 1 THEN
          PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "*", 15, 0, 1
        ELSE
          PrintChr customTextX + (LEN(customDisplay$) * FONT_WIDTH), customY + 5, "_", 15, 0, 1
        END IF
      END IF
    ELSE
      customDisplay$ = LEFT$(customDisplay$, customColumns)
      PrintStr customTextX, customY + 5, customDisplay$, customTextClr, 0, 1
    END IF

    drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, editor.windowBarClr
    confirmTextClr = 7
    IF selectedKind <> 0 THEN confirmTextClr = 15
    PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", confirmTextClr, 0, 1

    drawBorderBox cancelX, cancelY, cancelW, cancelH, 15, editor.windowBarClr
    PrintStr cancelX + (cancelW - (LEN("CANCEL") * FONT_WIDTH)) \ 2, cancelY + 5, "CANCEL", 15, 0, 1

    IF mouseClickedInBox(cancelX, cancelY, cancelW, cancelH, 0) THEN
      EXIT DO
    END IF

    IF mouseClickedInBox(confirmX, confirmY, confirmW, confirmH, 0) THEN
      IF selectedKind = 1 THEN
        enterFolder = 1
        folderToEnter = selectedFolderIndex
      END IF

      IF selectedKind = 2 THEN
        importFileNow = 1
        fileToImport = selectedFileIndex
      END IF
    END IF

    itemH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    maxNameChars = (filePaneW - editor.OpenNameReserve) \ FONT_WIDTH
    maxFolderNameChars = (folderW - editor.OpenNameReserve) \ FONT_WIDTH
    maxLines = listH \ itemH
    folderMaxLines = folderListH \ itemH
    folderVisible = folderMaxLines - 1

    IF customEditActive = 0 AND customEscHandled = 0 AND directoryEditActive = 0 AND directoryEscHandled = 0 AND refreshListing = 0 THEN
      kVal = _KEYHIT
      navStep = 0
      IF kVal = 18432 THEN navStep = -1
      IF kVal = 20480 THEN navStep = 1

      IF navStep <> 0 THEN
        IF selectedKind = 0 THEN
          IF fileCount > 0 THEN
            selectedKind = 2
            selectedFileIndex = editor.ModalScroll.ScrollY
          ELSE
            IF atDriveRoot = 0 OR folderCount > 0 THEN
              selectedKind = 1
              selectedFolderIndex = 0
              IF atDriveRoot = 1 THEN selectedFolderIndex = folderScroll + 1
            END IF
          END IF
        ELSE
          IF selectedKind = 1 THEN selectedFolderIndex = selectedFolderIndex + navStep
          IF selectedKind = 2 THEN selectedFileIndex = selectedFileIndex + navStep
        END IF

        IF selectedKind = 1 THEN
          minFolderIndex = 0
          IF atDriveRoot = 1 THEN minFolderIndex = 1
          IF selectedFolderIndex < minFolderIndex THEN selectedFolderIndex = minFolderIndex
          IF selectedFolderIndex > folderCount THEN selectedFolderIndex = folderCount

          IF selectedFolderIndex > 0 THEN
            folderIdx = selectedFolderIndex - 1
            IF folderIdx < folderScroll THEN folderScroll = folderIdx
            IF folderIdx >= folderScroll + folderVisible THEN folderScroll = folderIdx - folderVisible + 1
          END IF

          folderMaxScroll = folderCount - folderVisible
          IF folderMaxScroll < 0 THEN folderMaxScroll = 0
          IF folderScroll < 0 THEN folderScroll = 0
          IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
        END IF

        IF selectedKind = 2 AND fileCount > 0 THEN
          IF selectedFileIndex < 0 THEN selectedFileIndex = 0
          IF selectedFileIndex >= fileCount THEN selectedFileIndex = fileCount - 1
          IF selectedFileIndex < editor.ModalScroll.ScrollY THEN editor.ModalScroll.ScrollY = selectedFileIndex
          IF selectedFileIndex >= editor.ModalScroll.ScrollY + maxLines THEN editor.ModalScroll.ScrollY = selectedFileIndex - maxLines + 1

          maxScroll = fileCount - maxLines
          IF maxScroll < 0 THEN maxScroll = 0
          IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
          IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        END IF

        lastClickKind = 0
      END IF

      jumpKey = kVal
      IF jumpKey >= 97 AND jumpKey <= 122 THEN jumpKey = jumpKey - 32
      IF ((jumpKey >= 65 AND jumpKey <= 90) OR jumpKey = 95) AND (_KEYDOWN(100305) OR _KEYDOWN(100306)) = 0 THEN
        jumpLetter$ = CHR$(jumpKey)
        IF selectedKind = 1 THEN
          FOR ii = 0 TO folderCount - 1
            IF UCASE$(LEFT$(folderList$(ii), 1)) = jumpLetter$ THEN
              selectedFolderIndex = ii + 1
              folderScroll = ii
              folderMaxScroll = folderCount - folderVisible
              IF folderMaxScroll < 0 THEN folderMaxScroll = 0
              IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
              lastClickKind = 0
              EXIT FOR
            END IF
          NEXT
        ELSE
          FOR ii = 0 TO fileCount - 1
            IF UCASE$(LEFT$(fileList$(ii), 1)) = jumpLetter$ THEN
              selectedKind = 2
              selectedFileIndex = ii
              editor.ModalScroll.ScrollY = ii
              maxScroll = fileCount - maxLines
              IF maxScroll < 0 THEN maxScroll = 0
              IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
              lastClickKind = 0
              EXIT FOR
            END IF
          NEXT
        END IF
      END IF
    END IF

    ' Scrollbar
    scrollBarX = boxX + boxW - editor.ModalScrollbarWidth
    scrollBarY = pathDividerY
    scrollBarW = editor.ModalScrollbarWidth
    scrollBarH = listH + listTopY - scrollBarY

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    folderScrollBarX = filePaneX - editor.ModalScrollbarWidth
    folderScrollBarY = pathDividerY
    folderScrollBarW = editor.ModalScrollbarWidth
    folderScrollBarH = folderListH + listTopY - folderScrollBarY

    folderMaxScroll = folderCount - folderVisible
    IF folderMaxScroll < 0 THEN folderMaxScroll = 0
    IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll

    drawBorderBox folderScrollBarX, folderScrollBarY, folderScrollBarW, folderScrollBarH, 15, 0
    drawBorderBox folderScrollBarX, folderScrollBarY, folderScrollBarW, folderArrowH, 15, 0
    drawBorderBox folderScrollBarX, folderScrollBarY + folderScrollBarH - folderArrowH, folderScrollBarW, folderArrowH, 15, 0
    PrintChr folderScrollBarX + (folderScrollBarW - FONT_WIDTH) \ 2 + 1, folderScrollBarY + 2, CHR$(24), 15, 0, 1
    PrintChr folderScrollBarX + (folderScrollBarW - FONT_WIDTH) \ 2 + 1, folderScrollBarY + folderScrollBarH - FONT_HEIGHT - 1, CHR$(25), 15, 0, 1

    folderTrackH = folderScrollBarH - (2 * folderArrowH)
    IF folderCount > folderVisible THEN
      folderThumbH = (folderVisible * folderTrackH) \ folderCount
      IF folderThumbH < SCROLL_THUMB_MIN THEN folderThumbH = SCROLL_THUMB_MIN
      folderThumbY = folderScrollBarY + folderArrowH + ((folderScroll * (folderTrackH - folderThumbH)) \ folderMaxScroll)
    ELSE
      folderThumbH = folderTrackH
      folderThumbY = folderScrollBarY + folderArrowH
    END IF
    drawBorderBox folderScrollBarX + 1, folderThumbY, folderScrollBarW - 2, folderThumbH, 12, 15

    IF mouse.Clicked1 THEN
      IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY, folderScrollBarW, folderArrowH) THEN
        folderScroll = folderScroll - 1
      END IF

      IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY + folderScrollBarH - folderArrowH, folderScrollBarW, folderArrowH) THEN
        folderScroll = folderScroll + 1
      END IF

      IF folderCount > folderVisible THEN
        IF mouseWithinBoxBounds(folderScrollBarX, folderThumbY, folderScrollBarW, folderThumbH) THEN
          folderDragActive = 1
          folderDragOffset = mouse.PosY - folderThumbY
        ELSE
          IF mouseWithinBoxBounds(folderScrollBarX, folderScrollBarY + folderArrowH, folderScrollBarW, folderTrackH) THEN
            IF mouse.PosY < folderThumbY THEN
              folderScroll = folderScroll - folderVisible
            ELSE
              folderScroll = folderScroll + folderVisible
            END IF
          END IF
        END IF
      END IF
    END IF

    IF mouse.Button1Down AND folderDragActive = 1 THEN
      IF folderCount > folderVisible THEN
        newFolderThumbY = mouse.PosY - folderDragOffset
        folderTrackTravel = folderTrackH - folderThumbH
        IF folderTrackTravel > 0 THEN
          folderScroll = ((newFolderThumbY - (folderScrollBarY + folderArrowH)) * folderMaxScroll) \ folderTrackTravel
        END IF
      END IF
    END IF

    IF mouse.Released1 THEN
      folderDragActive = 0
    END IF

    IF folderScroll < 0 THEN folderScroll = 0
    IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX + 1, listTopY, folderW - 1, folderListH) THEN
        folderScroll = folderScroll + mouse.Wheel
        IF folderScroll > folderMaxScroll THEN folderScroll = folderMaxScroll
        IF folderScroll < 0 THEN folderScroll = 0
      END IF

      IF mouseWithinBoxBounds(filePaneX, listTopY, filePaneW, listH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO folderMaxLines - 1
      itemY = listTopY + (ii * itemH)

      IF ii = 0 THEN
        folderChoiceIndex = 0
        folderName$ = ".."
      ELSE
        folderIdx = folderScroll + ii - 1
        IF folderIdx >= folderCount THEN
          EXIT FOR
        END IF
        folderChoiceIndex = folderIdx + 1
        folderName$ = folderList$(folderIdx)
      END IF

      sOutName$ = folderName$
      IF LEN(sOutName$) > maxFolderNameChars THEN sOutName$ = LEFT$(sOutName$, maxFolderNameChars)

      ' Hover
      IF (ii > 0 OR atDriveRoot = 0) AND mouseWithinBoxBounds(boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH) THEN
        drawClearBox boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH, 9

        IF mouseClickedInBox(boxX + 2, itemY, folderW - editor.ModalHoverReserve, itemH, 0) THEN
          doubleClick = 0
          IF lastClickKind = 1 THEN
            IF lastFolderIndex = folderChoiceIndex THEN
              clickElapsed = TIMER - lastClickTime
              IF clickElapsed < 0 THEN clickElapsed = clickElapsed + 86400
              IF clickElapsed <= .55 THEN doubleClick = 1
            END IF
          END IF

          selectedKind = 1
          selectedFolderIndex = folderChoiceIndex
          lastClickKind = 1
          lastFolderIndex = folderChoiceIndex
          lastClickTime = TIMER

          IF doubleClick = 1 THEN
            enterFolder = 1
            folderToEnter = folderChoiceIndex
          END IF
        END IF
      END IF

      rowTextClr = 11
      IF ii = 0 AND atDriveRoot = 1 THEN rowTextClr = 7
      IF selectedKind = 1 THEN
        IF selectedFolderIndex = folderChoiceIndex AND (ii > 0 OR atDriveRoot = 0) THEN
          LINE (boxX + 2, itemY)-(boxX + folderW - editor.ModalHoverReserve + 1, itemY + itemH - 1), 1, BF
          rowTextClr = 15
        END IF
      END IF
      PrintStr boxX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, rowTextClr, 0, 1
    NEXT

    IF refreshListing = 0 THEN
      IF fileCount = 0 THEN
        PrintStr filePaneX + editor.TextPadding, listTopY + TEXT_GAP_TOP, "NO MATCHING FILES", 7, 0, 1
      END IF

      FOR ii = 0 TO maxLines - 1
        fIdx = ii + editor.ModalScroll.ScrollY
        IF fIdx < fileCount THEN
          itemY = listTopY + (ii * itemH)
          sOutName$ = fileList$(fIdx)
          IF LEN(sOutName$) > maxNameChars THEN sOutName$ = LEFT$(sOutName$, maxNameChars)

          ' Hover
          IF mouseWithinBoxBounds(filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH) THEN
            drawClearBox filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH, 9

            IF mouseClickedInBox(filePaneX + 2, itemY, filePaneW - editor.ModalHoverReserve, itemH, 0) THEN
              doubleClick = 0
              IF lastClickKind = 2 THEN
                IF lastFileIndex = fIdx THEN
                  clickElapsed = TIMER - lastClickTime
                  IF clickElapsed < 0 THEN clickElapsed = clickElapsed + 86400
                  IF clickElapsed <= .55 THEN doubleClick = 1
                END IF
              END IF

              selectedKind = 2
              selectedFileIndex = fIdx
              lastClickKind = 2
              lastFileIndex = fIdx
              lastClickTime = TIMER

              IF doubleClick = 1 THEN
                importFileNow = 1
                fileToImport = fIdx
              END IF
            END IF
          END IF

          rowTextClr = 11
          IF selectedKind = 2 THEN
            IF selectedFileIndex = fIdx THEN
              LINE (filePaneX + 2, itemY)-(filePaneX + filePaneW - editor.ModalHoverReserve + 1, itemY + itemH - 1), 1, BF
              rowTextClr = 15
            END IF
          END IF
          PrintStr filePaneX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, rowTextClr, 0, 1
        END IF
      NEXT

      IF enterFolder = 1 OR importFileNow = 1 THEN
        drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, 12
        PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", 15, 0, 1
      END IF

      dispScreenFlushUpdate

      IF enterFolder = 1 THEN
        waitTimer UI_FLASH_TIME

        oldDir$ = _CWD$
        IF folderToEnter = 0 THEN
          CHDIR ".."
        ELSE
          folderIdx = folderToEnter - 1
          IF folderIdx >= 0 AND folderIdx < folderCount THEN
            folderName$ = folderList$(folderIdx)
            IF _DIREXISTS(folderName$) THEN CHDIR folderName$
          END IF
        END IF

        IF _CWD$ <> oldDir$ THEN refreshListing = 1
      END IF

      IF importFileNow = 1 THEN
        IF fileToImport >= 0 AND fileToImport < fileCount THEN
          waitTimer UI_FLASH_TIME

          importStartLine = editor.LastLine + 1
          lastActionWasTyping = 0

          fileCodeImport fileList$(fileToImport)
          CHDIR startDir$

          IF editor.LastLine >= importStartLine THEN
            refineCode importStartLine, 2

            editor.SelectStartX = editor.CursorX
            editor.SelectStartY = editor.CursorY
            editor.IsSelecting = 0
            editor.Focus = 1

            statusResult$ = "IMPORTED " + fileList$(fileToImport)
            addStatusMsg statusResult$

            IF fileImportTiming.Ready = 1 THEN
              formatSeconds = TIMER - fileImportTiming.RefineStart
              IF formatSeconds < 0 THEN formatSeconds = formatSeconds + 86400
              fileImportTiming.Ready = 0
              addStatusMsgContinuation fileTimingReport$("IMPORT", fileImportTiming.ReadSeconds, fileImportTiming.UndoSeconds, fileImportTiming.TextSeconds, formatSeconds)
              compileStatusMsg$ = statusResult$
            END IF

          END IF

          EXIT DO
        END IF
      END IF

      IF customEditActive = 0 AND customEscHandled = 0 AND directoryEditActive = 0 AND directoryEscHandled = 0 THEN
        kVal = keyCheck("ESC")
        IF kVal = 27 THEN
          waitKeyRelease "ESC"
          EXIT DO
        END IF
      END IF
    END IF

  LOOP

  CHDIR startDir$

  _DEST logicalScreen

END SUB ' modalImportFile

''''''''''''''''''''''''
SUB modalSearch

  ' Give the modal a clean slate to prevent double-triggering inputs
  _KEYCLEAR

  searchText$ = ""

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.ModalWidth
    boxH = 66
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - ((LEN("SEARCH FIND") * FONT_WIDTH) \ 2), boxY + 3, "SEARCH FIND", 14, 0, 1
    LINE (boxX, boxY + 15)-(boxX + boxW - 1, boxY + 15), 15

    closeBtnW = editor.CloseWidth
    closeBtnH = 15
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH, 0) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 26
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    displayText$ = searchText$ + "_"
    inputColumns = (inputBoxW - (2 * editor.ModalInputPadding)) \ FONT_WIDTH
    displayText$ = RIGHT$(displayText$, inputColumns)
    PrintStr inputBoxX + editor.ModalInputPadding, inputBoxY + 4, displayText$, 15, 0, 1

    lastSearchW = (LEN("LAST SEARCH") * FONT_WIDTH) + (2 * editor.TextPadding)
    lastSearchH = 18
    lastSearchX = boxX + ((boxW - lastSearchW) \ 2)
    lastSearchY = boxY + 46

    lastSearchBg = sysColor.gray
    lastSearchTextClr = 7
    IF editorSearchQuery$ <> "" THEN
      lastSearchBg = editor.windowBarClr
      lastSearchTextClr = 15
    END IF

    drawBorderBox lastSearchX, lastSearchY, lastSearchW, lastSearchH, 15, lastSearchBg

    IF editorSearchQuery$ <> "" THEN
      IF mouseWithinBoxBounds(lastSearchX, lastSearchY, lastSearchW, lastSearchH) THEN
        drawClearBox lastSearchX + 1, lastSearchY + 1, lastSearchW - 2, lastSearchH - 2, 9
      END IF

      IF mouseClickedInBox(lastSearchX, lastSearchY, lastSearchW, lastSearchH, 0) THEN
        searchText$ = editorSearchQuery$
      END IF
    END IF

    PrintStr lastSearchX + editor.TextPadding, lastSearchY + 4, "LAST SEARCH", lastSearchTextClr, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF searchText$ <> "" THEN
          editorSearchQuery$ = searchText$
          findEditorNext
          EXIT DO
        END IF
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(searchText$)
        IF qLen > 0 THEN
          searchText$ = LEFT$(searchText$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(searchText$) < 34 THEN
            searchText$ = searchText$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalSearch

''''''''''''''''''''''''
SUB modalViewSubs

  selectedEntry = 0
  nameScrollX = 0
  nameDragActive = 0
  nameDragOffset = 0
  infoScrollX = 0
  infoDragActive = 0
  infoDragOffset = 0

  _KEYCLEAR

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  refineCode 0, 0

  maxNameLen = LEN("NAME")
  maxInfoLen = LEN("INFO")
  modalListReady = 0
  fileRowClr = sysColor.gray

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    IF modalListReady = 0 THEN
      ii = 0
      DO WHILE ii < uiFuncListCount
        IF LEN(uiFuncList(ii).RecordName) > maxNameLen THEN maxNameLen = LEN(uiFuncList(ii).RecordName)
        sOutInfo$ = modalViewSubsInfo$(ii)
        IF LEN(sOutInfo$) > maxInfoLen THEN maxInfoLen = LEN(sOutInfo$)
        ii = ii + 1
      LOOP
      modalListReady = 1
    END IF

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    boxW = editor.OpenModalWidth
    footerH = 28
    boxX = editor.EditorLeft
    boxY = editor.StartY
    rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    expandedStatusY = boxY + 6 + ((EDITOR_TEXT_ROWS - 3) * rowH) + STATUS_TOP_GAP + (3 * (rowH - STATUS_ROW_HEIGHT))
    boxH = expandedStatusY - boxY + 3 - footerH

    cancelW = editor.OpenButtonWidth
    cancelH = 18
    confirmW = editor.OpenButtonWidth
    confirmH = 18
    buttonGap = 2 * editor.TextPadding
    cancelX = boxX + ((boxW - cancelW - confirmW - buttonGap) \ 2)
    confirmX = cancelX + cancelW + buttonGap
    confirmY = boxY + boxH + 5
    cancelY = confirmY

    drawBorderBox boxX, boxY, boxW, boxH + footerH, 15, editor.windowBarClr
    LINE (boxX, boxY + boxH - 1)-(boxX + boxW - 1, boxY + boxH - 1), 15

    PrintStr boxX + (boxW \ 2) - ((LEN("SUBS / FUNCTIONS") * FONT_WIDTH) \ 2), boxY + 4, "SUBS / FUNCTIONS", 14, 0, 1
    LINE (boxX, boxY + 16)-(boxX + boxW - 1, boxY + 16), 15

    itemH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
    headingY = boxY + 18
    listTopY = headingY + itemH + 2
    hScrollY = boxY + boxH - 1 - editor.HScrollHeight
    listH = hScrollY - listTopY
    maxLines = listH \ itemH

    scrollBarX = boxX + boxW - editor.ModalScrollbarWidth
    scrollBarY = boxY + 16
    scrollBarW = editor.ModalScrollbarWidth
    scrollBarH = listH + listTopY - scrollBarY

    rowLeftX = boxX + 1
    rowRightX = scrollBarX - 1
    rowWidth = rowRightX - rowLeftX + 1

    cancelLabelX = cancelX + ((cancelW - (LEN("CANCEL") * FONT_WIDTH)) \ 2)
    splitTargetX = cancelLabelX + ((LEN("CANCEL") - 1) * FONT_WIDTH) + (FONT_WIDTH \ 2)
    subNameColumns = (splitTargetX - boxX - (2 * editor.TextPadding)) \ FONT_WIDTH
    namePaneW = (subNameColumns * FONT_WIDTH) + (2 * editor.TextPadding)
    infoPaneX = boxX + namePaneW
    infoTextX = infoPaneX + editor.TextPadding
    infoColumns = (scrollBarX - infoTextX - editor.TextPadding) \ FONT_WIDTH

    PrintStr boxX + editor.TextPadding, headingY + TEXT_GAP_TOP, "NAME", 14, 0, 1
    PrintStr infoTextX, headingY + TEXT_GAP_TOP, "INFO", 14, 0, 1
    LINE (boxX, listTopY - 2)-(scrollBarX - 1, listTopY - 2), 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, uiFuncListCount, maxLines, 0

    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX + 1, listTopY, boxW - 2, listH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = 0
        IF uiFuncListCount > maxLines THEN maxScroll = uiFuncListCount - maxLines
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    FOR i2 = 1 TO 2

      SELECT CASE i2

        CASE 1
          hScrollX = boxX
          hScrollW = namePaneW
          paneColumns = subNameColumns
          paneMaxLen = maxNameLen
          paneScrollX = nameScrollX
          paneDragActive = nameDragActive
          paneDragOffset = nameDragOffset

        CASE 2
          hScrollX = infoPaneX
          hScrollW = boxW - namePaneW
          paneColumns = infoColumns
          paneMaxLen = maxInfoLen
          paneScrollX = infoScrollX
          paneDragActive = infoDragActive
          paneDragOffset = infoDragOffset

      END SELECT

      arrowW = editor.HScrollArrowWidth
      trackX = hScrollX + arrowW
      trackW = hScrollW - (2 * arrowW)
      maxPaneScroll = paneMaxLen - paneColumns
      IF maxPaneScroll < 0 THEN maxPaneScroll = 0
      IF paneScrollX < 0 THEN paneScrollX = 0
      IF paneScrollX > maxPaneScroll THEN paneScrollX = maxPaneScroll

      thumbSizeX = trackW
      IF maxPaneScroll > 0 THEN
        thumbSizeX = (paneColumns * trackW) \ paneMaxLen
        IF thumbSizeX < SCROLL_THUMB_MIN THEN thumbSizeX = SCROLL_THUMB_MIN
        IF thumbSizeX > trackW THEN thumbSizeX = trackW
      END IF
      trackSizeX = trackW - thumbSizeX
      thumbX = trackX
      IF maxPaneScroll > 0 THEN thumbX = trackX + ((paneScrollX * trackSizeX) \ maxPaneScroll)

      IF mouse.Clicked1 AND maxPaneScroll > 0 THEN
        IF mouseWithinBoxBounds(thumbX, hScrollY, thumbSizeX, editor.HScrollHeight) THEN
          paneDragActive = 1
          paneDragOffset = mouse.PosX - thumbX
        ELSE
          IF mouseWithinBoxBounds(hScrollX, hScrollY, arrowW, editor.HScrollHeight) THEN
            paneScrollX = paneScrollX - 1
          ELSE
            IF mouseWithinBoxBounds(hScrollX + hScrollW - arrowW, hScrollY, arrowW, editor.HScrollHeight) THEN
              paneScrollX = paneScrollX + 1
            ELSE
              IF mouseWithinBoxBounds(trackX, hScrollY, trackW, editor.HScrollHeight) THEN
                IF mouse.PosX < thumbX THEN
                  paneScrollX = paneScrollX - paneColumns
                ELSE
                  paneScrollX = paneScrollX + paneColumns
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF

      IF mouse.Button1Down AND paneDragActive = 1 AND trackSizeX > 0 THEN
        newThumbX = mouse.PosX - paneDragOffset
        paneScrollX = ((newThumbX - trackX) * maxPaneScroll) \ trackSizeX
      END IF
      IF mouse.Released1 THEN paneDragActive = 0

      IF paneScrollX < 0 THEN paneScrollX = 0
      IF paneScrollX > maxPaneScroll THEN paneScrollX = maxPaneScroll
      thumbX = trackX
      IF maxPaneScroll > 0 THEN thumbX = trackX + ((paneScrollX * trackSizeX) \ maxPaneScroll)

      drawBorderBox hScrollX, hScrollY, hScrollW, editor.HScrollHeight, 15, 0
      drawBorderBox hScrollX, hScrollY, arrowW, editor.HScrollHeight, 15, 0
      drawBorderBox hScrollX + hScrollW - arrowW, hScrollY, arrowW, editor.HScrollHeight, 15, 0
      PrintChr hScrollX + 2, hScrollY + 2, CHR$(17), 15, 0, 1
      PrintChr hScrollX + hScrollW - arrowW + editor.HScrollRightGlyph, hScrollY + 2, CHR$(16), 15, 0, 1
      drawBorderBox thumbX, hScrollY + 1, thumbSizeX, editor.HScrollHeight - 2, 12, 15

      SELECT CASE i2

        CASE 1
          nameScrollX = paneScrollX
          nameDragActive = paneDragActive
          nameDragOffset = paneDragOffset

        CASE 2
          infoScrollX = paneScrollX
          infoDragActive = paneDragActive
          infoDragOffset = paneDragOffset

      END SELECT

    NEXT

    LINE (infoPaneX, boxY + 17)-(infoPaneX, hScrollY - 1), 15

    IF uiFuncListCount = 0 THEN
      PrintStr boxX + editor.TextPadding, listTopY + TEXT_GAP_TOP, "NO SUBS / FUNCTIONS", 7, 0, 1
    END IF

    FOR ii = 0 TO maxLines - 1
      entryIdx = ii + editor.ModalScroll.ScrollY
      IF entryIdx < uiFuncListCount THEN
        itemY = listTopY + (ii * itemH)
        sOutName$ = MID$(uiFuncList(entryIdx).RecordName, nameScrollX + 1, subNameColumns)
        sOutInfo$ = modalViewSubsInfo$(entryIdx)
        sOutInfo$ = MID$(sOutInfo$, infoScrollX + 1, infoColumns)

        rowTextClr = 11
        IF uiFuncList(entryIdx).RoutineIndex = 0 THEN
          LINE (rowLeftX, itemY)-(rowRightX, itemY + itemH - 1), fileRowClr, BF
          rowTextClr = 15
        END IF

        IF mouseWithinBoxBounds(rowLeftX, itemY, rowWidth, itemH) THEN
          drawClearBox rowLeftX, itemY, rowWidth, itemH, 9

          IF mouseClickedInBox(rowLeftX, itemY, rowWidth, itemH, 0) THEN
            selectedEntry = entryIdx + 1
          END IF
        END IF

        IF selectedEntry = entryIdx + 1 THEN
          IF uiFuncList(entryIdx).RoutineIndex = 0 THEN
            drawClearBox rowLeftX, itemY, rowWidth, itemH, 15
          ELSE
            LINE (rowLeftX, itemY)-(rowRightX, itemY + itemH - 1), 1, BF
          END IF
          rowTextClr = 15
        END IF

        LINE (infoPaneX, itemY)-(infoPaneX, itemY + itemH - 1), 15
        PrintStr boxX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, rowTextClr, 0, 1
        PrintStr infoTextX, itemY + TEXT_GAP_TOP, sOutInfo$, rowTextClr, 0, 1
      END IF
    NEXT

    drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, editor.windowBarClr
    confirmTextClr = 7
    IF selectedEntry > 0 AND selectedEntry <= uiFuncListCount THEN confirmTextClr = 15
    PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", confirmTextClr, 0, 1

    drawBorderBox cancelX, cancelY, cancelW, cancelH, 15, editor.windowBarClr
    PrintStr cancelX + (cancelW - (LEN("CANCEL") * FONT_WIDTH)) \ 2, cancelY + 5, "CANCEL", 15, 0, 1

    dispScreenFlushUpdate

    IF mouseClickedInBox(cancelX, cancelY, cancelW, cancelH, 0) THEN
      EXIT DO
    END IF

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

    doConfirm = 0
    IF mouseClickedInBox(confirmX, confirmY, confirmW, confirmH, 0) THEN doConfirm = 1

    kVal = _KEYHIT
    IF kVal = 13 THEN doConfirm = 1

    navStep = 0
    IF kVal = 18432 THEN navStep = -1
    IF kVal = 20480 THEN navStep = 1

    IF navStep <> 0 AND uiFuncListCount > 0 THEN
      IF selectedEntry = 0 THEN
        selectedEntry = editor.ModalScroll.ScrollY + 1
      ELSE
        selectedEntry = selectedEntry + navStep
      END IF

      IF selectedEntry < 1 THEN selectedEntry = 1
      IF selectedEntry > uiFuncListCount THEN selectedEntry = uiFuncListCount

      entryIdx = selectedEntry - 1
      IF entryIdx < editor.ModalScroll.ScrollY THEN editor.ModalScroll.ScrollY = entryIdx
      IF entryIdx >= editor.ModalScroll.ScrollY + maxLines THEN editor.ModalScroll.ScrollY = entryIdx - maxLines + 1

      maxScroll = 0
      IF uiFuncListCount > maxLines THEN maxScroll = uiFuncListCount - maxLines
      IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
    END IF

    jumpKey = kVal
    IF jumpKey >= 97 AND jumpKey <= 122 THEN jumpKey = jumpKey - 32
    IF ((jumpKey >= 65 AND jumpKey <= 90) OR jumpKey = 95) AND (_KEYDOWN(100305) OR _KEYDOWN(100306)) = 0 THEN
      jumpLetter$ = CHR$(jumpKey)
      ii = 0
      DO WHILE ii < uiFuncListCount
        IF uiFuncList(ii).RoutineIndex > 0 THEN
          IF UCASE$(LEFT$(uiFuncList(ii).RecordName, 1)) = jumpLetter$ THEN
            selectedEntry = ii + 1
            editor.ModalScroll.ScrollY = ii
            maxScroll = 0
            IF uiFuncListCount > maxLines THEN maxScroll = uiFuncListCount - maxLines
            IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
            nameScrollX = 0
            EXIT DO
          END IF
        END IF
        ii = ii + 1
      LOOP
    END IF

    IF doConfirm = 1 AND selectedEntry > 0 AND selectedEntry <= uiFuncListCount THEN
      entryIdx = selectedEntry - 1

      drawBorderBox confirmX, confirmY, confirmW, confirmH, 15, 12
      PrintStr confirmX + (confirmW - (LEN("CONFIRM") * FONT_WIDTH)) \ 2, confirmY + 5, "CONFIRM", 15, 0, 1

      listIdx = entryIdx
      IF listIdx < editor.FuncScroll.ScrollY OR listIdx >= editor.FuncScroll.ScrollY + 14 THEN
        editor.FuncScroll.ScrollY = listIdx - 6
        IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
        maxFuncScroll = 0
        IF uiFuncListCount > 14 THEN maxFuncScroll = uiFuncListCount - 14
        IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
        drawFuncListPMI
      END IF

      LEFT_BOX_X_NEW = 0
      funcListBoxX = LEFT_BOX_X_NEW
      funcListBoxY = editor.StartY
      nameColumns = editor.FuncNameColumns
      IF editor.MenuMode = 0 AND funcArrowRight = 1 THEN nameColumns = 24
      funcListBoxW = editor.SideWidth + ((nameColumns - editor.FuncNameColumns) * FONT_WIDTH)
      rowY = funcListBoxY + 3 + ((listIdx - editor.FuncScroll.ScrollY + 1) * (editor.FontHeight + 2))
      LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - editor.ScrollbarWidth - 1, rowY + editor.FontHeight + 1), 1, BF
      sidebarTextX = funcListBoxX + editor.FuncTextPadding
      sidebarNameColumns = nameColumns
      IF editor.MenuMode = 0 AND funcArrowRight = 1 AND uiFuncList(entryIdx).RoutineIndex > 0 THEN
        sidebarTextX = sidebarTextX + FONT_WIDTH
        sidebarNameColumns = sidebarNameColumns - 1
      END IF
      PrintStr sidebarTextX, rowY + 1, LEFT$(uiFuncList(entryIdx).RecordName, sidebarNameColumns), 15, 0, 1

      selectedRow = entryIdx - editor.ModalScroll.ScrollY
      IF selectedRow >= 0 AND selectedRow < maxLines THEN
        itemY = listTopY + (selectedRow * itemH)
        sOutName$ = MID$(uiFuncList(entryIdx).RecordName, nameScrollX + 1, subNameColumns)
        sOutInfo$ = modalViewSubsInfo$(entryIdx)
        sOutInfo$ = MID$(sOutInfo$, infoScrollX + 1, infoColumns)
        selectedRowBg = 1
        IF uiFuncList(entryIdx).RoutineIndex = 0 THEN selectedRowBg = fileRowClr
        LINE (rowLeftX, itemY)-(rowRightX, itemY + itemH - 1), selectedRowBg, BF
        PrintStr boxX + editor.TextPadding, itemY + TEXT_GAP_TOP, sOutName$, 15, 0, 1
        PrintStr infoTextX, itemY + TEXT_GAP_TOP, sOutInfo$, 15, 0, 1
        IF uiFuncList(entryIdx).RoutineIndex = 0 THEN
          drawClearBox rowLeftX, itemY, rowWidth, itemH, 15
        END IF
        LINE (infoPaneX, itemY)-(infoPaneX, itemY + itemH - 1), 15
      END IF

      dispScreenFlushUpdate

      waitTimer UI_FLASH_TIME

      editor.CursorY = uiFuncList(entryIdx).LineNumber
      editor.CursorX = 0
      editor.ScrollY = editor.CursorY
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      editor.ScrollX = 0
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.IsSelecting = 0
      editor.Focus = 1

      EXIT DO
    END IF

  LOOP

END SUB ' modalViewSubs

''''''''''''''''''''''''
FUNCTION modalViewSubsInfo$ (rsListIdx)

  listIdx = rsListIdx

  IF listIdx = 0 THEN
    modalViewSubsInfo$ = "MAIN FILE"
    EXIT FUNCTION
  END IF

  IF uiFuncList(listIdx).RoutineIndex = 0 THEN
    modalViewSubsInfo$ = "IMPORTED FILE"
    EXIT FUNCTION
  END IF

  declaration$ = editorText$(uiFuncList(listIdx).LineNumber)
  infoText$ = "SUB"
  paramsStart = 0
  parenDepth = 0
  inQuote = 0

  FOR ix = 1 TO LEN(declaration$)
    IF ASC(declaration$, ix) = 9 THEN MID$(declaration$, ix, 1) = " "
  NEXT

  ix = 1
  DO WHILE ix <= LEN(declaration$)
    charCode = ASC(declaration$, ix)

    IF charCode = 34 THEN
      IF inQuote = 1 THEN
        doubledQuote = 0
        IF ix < LEN(declaration$) THEN
          IF ASC(declaration$, ix + 1) = 34 THEN doubledQuote = 1
        END IF
        IF doubledQuote = 1 THEN
          ix = ix + 1
        ELSE
          inQuote = 0
        END IF
      ELSE
        inQuote = 1
      END IF
    ELSE
      IF inQuote = 0 THEN
        SELECT CASE charCode

          CASE 39, 58
            EXIT DO

          CASE 82, 114
            IF UCASE$(MID$(declaration$, ix, 3)) = "REM" THEN
              wordStart = 0
              wordEnd = 0
              IF ix = 1 THEN
                wordStart = 1
              ELSE
                IF ASC(declaration$, ix - 1) = 32 THEN wordStart = 1
              END IF
              IF ix + 3 > LEN(declaration$) THEN
                wordEnd = 1
              ELSE
                IF ASC(declaration$, ix + 3) = 32 THEN wordEnd = 1
              END IF
              IF wordStart = 1 AND wordEnd = 1 THEN EXIT DO
            END IF

          CASE 40
            IF parenDepth = 0 THEN paramsStart = ix
            parenDepth = parenDepth + 1

          CASE 41
            IF parenDepth > 0 THEN
              parenDepth = parenDepth - 1
              IF parenDepth = 0 THEN
                arguments$ = LTRIM$(RTRIM$(MID$(declaration$, paramsStart + 1, ix - paramsStart - 1)))
                IF arguments$ <> "" THEN infoText$ = arguments$
                EXIT DO
              END IF
            END IF

        END SELECT
      END IF
    END IF

    ix = ix + 1
  LOOP

  modalViewSubsInfo$ = infoText$

END FUNCTION ' modalViewSubsInfo$

''''''''''''''''''''''''
SUB overlayScaledTransparent (rsSourceImage, rsTargetImage, rsTransparentClr)

  DIM sourceImage AS LONG
  DIM targetImage AS LONG
  DIM transparentClr AS LONG
  DIM sourceWidth AS LONG
  DIM sourceHeight AS LONG
  DIM targetWidth AS LONG
  DIM targetHeight AS LONG
  DIM minX AS LONG
  DIM minY AS LONG
  DIM maxX AS LONG
  DIM maxY AS LONG
  DIM targetX1 AS LONG
  DIM targetY1 AS LONG
  DIM targetX2 AS LONG
  DIM targetY2 AS LONG
  DIM sampleX AS LONG
  DIM sampleY AS LONG
  DIM pixelClr AS LONG
  DIM foundPixel AS LONG

  sourceImage = rsSourceImage
  targetImage = rsTargetImage
  transparentClr = rsTransparentClr

  sourceWidth = _WIDTH(sourceImage)
  sourceHeight = _HEIGHT(sourceImage)
  targetWidth = _WIDTH(targetImage)
  targetHeight = _HEIGHT(targetImage)

  foundPixel = 0

  _SOURCE sourceImage

  FOR iy = 0 TO sourceHeight - 1
    FOR ix = 0 TO sourceWidth - 1

      pixelClr = POINT(ix, iy)

      IF pixelClr <> transparentClr THEN

        IF foundPixel = 0 THEN

          minX = ix
          minY = iy
          maxX = ix
          maxY = iy
          foundPixel = 1

        ELSE

          IF ix < minX THEN minX = ix
          IF iy < minY THEN minY = iy
          IF ix > maxX THEN maxX = ix
          IF iy > maxY THEN maxY = iy

        END IF

      END IF

    NEXT
  NEXT

  IF foundPixel = 0 THEN
    _SOURCE 0
    EXIT SUB
  END IF

  targetX1 = (minX * targetWidth) \ sourceWidth
  targetY1 = (minY * targetHeight) \ sourceHeight

  targetX2 = (((maxX + 1) * targetWidth) \ sourceWidth) - 1
  targetY2 = (((maxY + 1) * targetHeight) \ sourceHeight) - 1

  IF targetX1 < 0 THEN targetX1 = 0
  IF targetY1 < 0 THEN targetY1 = 0
  IF targetX2 >= targetWidth THEN targetX2 = targetWidth - 1
  IF targetY2 >= targetHeight THEN targetY2 = targetHeight - 1

  _DEST targetImage
  _SOURCE sourceImage

  FOR iy = targetY1 TO targetY2

    sampleY = (iy * sourceHeight) \ targetHeight

    IF sampleY < minY THEN sampleY = minY
    IF sampleY > maxY THEN sampleY = maxY

    FOR ix = targetX1 TO targetX2

      sampleX = (ix * sourceWidth) \ targetWidth

      IF sampleX < minX THEN sampleX = minX
      IF sampleX > maxX THEN sampleX = maxX

      pixelClr = POINT(sampleX, sampleY)

      IF pixelClr <> transparentClr THEN
        PSET (ix, iy), pixelClr
      END IF

    NEXT
  NEXT

  _SOURCE 0

END SUB ' overlayScaledTransparent

''''''''''''''''''''''''
SUB pasteClipboardText

  cbText$ = _CLIPBOARD$
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  tabWidth = editor.TabSize
  IF tabWidth < 1 THEN tabWidth = 4
  cleanCapacity = cbLen
  IF INSTR(cbText$, CHR$(9)) > 0 THEN cleanCapacity = cbLen * tabWidth

  pasteColumn = editor.CursorX
  IF editor.IsSelecting = 1 THEN
    IF editor.SelectStartY = editor.CursorY THEN
      IF editor.SelectStartX < pasteColumn THEN pasteColumn = editor.SelectStartX
    ELSE
      pasteColumn = 0
    END IF
  END IF
  IF INSTR(cbText$, CHR$(13)) > 0 OR INSTR(cbText$, CHR$(10)) > 0 THEN pasteColumn = 0

  ' Pre-allocate a buffer to rapidly filter non-printable characters in a single O(N) pass
  cleanText$ = SPACE$(cleanCapacity)
  cleanIdx = 1

  skipNewlineByte = 0
  FOR ii = 1 TO cbLen
    cbAsc = ASC(cbText$, ii)
    IF skipNewlineByte = 1 THEN
      skipNewlineByte = 0
      cbAsc = 0
    ELSE
      IF cbAsc = 13 OR cbAsc = 10 THEN
        IF ii < cbLen THEN
          nextCbAsc = ASC(cbText$, ii + 1)
          IF (cbAsc = 13 AND nextCbAsc = 10) OR (cbAsc = 10 AND nextCbAsc = 13) THEN skipNewlineByte = 1
        END IF
        cbAsc = 10
      END IF
    END IF
    IF cbAsc = 9 THEN
      tabSpaces = (((pasteColumn \ tabWidth) + 1) * tabWidth) - pasteColumn
      MID$(cleanText$, cleanIdx, tabSpaces) = SPACE$(tabSpaces)
      cleanIdx = cleanIdx + tabSpaces
      pasteColumn = pasteColumn + tabSpaces
    ELSE
      ' Allow only newlines (10) and standard printable characters (32 to 126)
      IF cbAsc = 10 OR (cbAsc >= 32 AND cbAsc <= 126) THEN
        ASC(cleanText$, cleanIdx) = cbAsc
        cleanIdx = cleanIdx + 1
        IF cbAsc = 10 THEN
          pasteColumn = 0
        ELSE
          pasteColumn = pasteColumn + 1
        END IF
      END IF
    END IF
  NEXT

  cbText$ = LEFT$(cleanText$, cleanIdx - 1)
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  mergePasteTail = 0
  IF editor.IsSelecting = 1 AND editor.CursorY > editor.SelectStartY AND editor.CursorX > 0 THEN mergePasteTail = 1

  ' Count newlines to determine the exact array shift distance
  nlCount = 0
  ix = 1
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cbText$, CHR$(10))
    IF nextNl > 0 THEN
      nlCount = nlCount + 1
      ix = nextNl + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  pasteLineCount = 0
  IF nlCount > 0 THEN
    pasteLineCount = nlCount
    IF RIGHT$(cbText$, 1) <> CHR$(10) AND mergePasteTail = 0 THEN pasteLineCount = pasteLineCount + 1

    remainingLines = editor.LastLine
    IF editor.IsSelecting = 1 AND editor.SelectStartY <> editor.CursorY THEN
      selectionFirstY = editor.SelectStartY
      selectionLastY = editor.CursorY
      IF selectionFirstY > selectionLastY THEN SWAP selectionFirstY, selectionLastY
      linesToReplace = selectionLastY - selectionFirstY
      IF editor.CursorY < editor.SelectStartY THEN linesToReplace = linesToReplace + 1
      remainingLines = remainingLines - linesToReplace
      IF remainingLines < 1 THEN remainingLines = 1
    END IF

    IF remainingLines + pasteLineCount > EDITOR_LINE_MAX THEN
      addStatusMsg "PASTE EXCEEDS EDITOR LINE LIMIT"
      EXIT SUB
    END IF
  END IF

  IF editor.IsSelecting = 1 THEN
    deleteSelection
    editor.IsSelecting = 0
  END IF

  IF nlCount = 0 THEN
    currentLine$ = editorText$(editor.CursorY)
    IF LEN(currentLine$) < editor.CursorX THEN currentLine$ = currentLine$ + SPACE$(editor.CursorX - LEN(currentLine$))
    leftPart$ = LEFT$(currentLine$, editor.CursorX)
    rightPart$ = MID$(currentLine$, editor.CursorX + 1)
    editorText$(editor.CursorY) = leftPart$ + cbText$ + rightPart$
    IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY
    editor.CursorX = editor.CursorX + cbLen
  ELSE
    pasteTail$ = ""
    IF mergePasteTail = 1 AND RIGHT$(cbText$, 1) <> CHR$(10) THEN pasteTail$ = editorText$(editor.CursorY)

    ' Shift array down exactly once in bulk
    FOR iy = editor.LastLine TO editor.CursorY STEP -1
      editorText$(iy + pasteLineCount) = editorText$(iy)
    NEXT

    editor.LastLine = editor.LastLine + pasteLineCount

    ix = 1
    curPasteY = editor.CursorY
    linesPasted = 0

    ' Process the filtered clipboard and inject directly into the opened array spaces
    DO WHILE ix <= cbLen
      nextNl = INSTR(ix, cbText$, CHR$(10))
      IF nextNl = 0 THEN
        ' Final chunk of text (no trailing newline)
        chunk$ = MID$(cbText$, ix)
        editorText$(curPasteY) = chunk$ + pasteTail$
        editor.CursorX = LEN(chunk$)
        EXIT DO
      ELSE
        ' Extract line up to the newline
        chunk$ = MID$(cbText$, ix, nextNl - ix)
        editorText$(curPasteY) = chunk$

        linesPasted = linesPasted + 1
        curPasteY = curPasteY + 1
        ix = nextNl + 1
      END IF
    LOOP

    ' Handle edge case where clipboard ends exactly on a newline
    IF RIGHT$(cbText$, 1) = CHR$(10) THEN
      editor.CursorX = 0
      IF curPasteY > editor.LastLine AND curPasteY <= EDITOR_LINE_MAX THEN editorText$(curPasteY) = ""
    END IF

    editor.CursorY = curPasteY
  END IF

  IF editor.CursorY > EDITOR_LINE_MAX THEN
    editor.CursorY = EDITOR_LINE_MAX
    editor.CursorX = LEN(editorText$(EDITOR_LINE_MAX))
  END IF

  editor.SelectStartX = editor.CursorX
  editor.SelectStartY = editor.CursorY

  ' Update view scrolling
  visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
  IF editor.CursorY >= editor.ScrollY + visibleRows THEN editor.ScrollY = editor.CursorY - visibleRows + 1
  IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
  IF editor.CursorX >= editor.ScrollX + editor.EditorColumns THEN editor.ScrollX = editor.CursorX - editor.EditorColumns + 1

END SUB ' pasteClipboardText

''''''''''''''''''''''''
SUB PrintTextLineWithBanners (text$, wClr, whereY)

  paddingPixels = editor.TextPadding

  textStartX = 9

  SELECT CASE whereY

    CASE TOP: textStartY = 4
    CASE MIDDLE: textStartY = 20
    CASE BOTTOM: textStartY = 30

  END SELECT ' whereY

  displayText$ = text$
  maxChars = (SCREENSIZEX - (2 * paddingPixels)) \ FONT_WIDTH
  displayText$ = LEFT$(displayText$, maxChars)

  textPixelWidth = LEN(displayText$) * FONT_WIDTH
  boxPixelWidth = paddingPixels + textPixelWidth + paddingPixels
  boxPixelHeight = paddingPixels + editor.FontHeight + paddingPixels

  boxStartX = (textStartX * FONT_WIDTH) - paddingPixels
  boxStartY = (textStartY * editor.FontHeight) - paddingPixels

  IF (boxStartX + boxPixelWidth) >= SCREENSIZEX THEN
    boxStartX = SCREENSIZEX - boxPixelWidth
  END IF

  IF boxStartX < 0 THEN boxStartX = 0

  drawBorderBox boxStartX, boxStartY, boxPixelWidth, boxPixelHeight, 1, 0
  drawClearBox boxStartX + 1, boxStartY + 1, boxPixelWidth - 2, boxPixelHeight - 2, 15

  PrintStr boxStartX + paddingPixels, boxStartY + paddingPixels, displayText$, wClr, 0, 0

END SUB ' PrintTextLineWithBanners

''''''''''''''''''''''''
FUNCTION processDropdownMenu (wPosX, wPosY, wItemCount, passItems$())

  returnExtraPrepare

  DIM itemH AS LONG
  itemH = 14

  maxWidth = 0
  FOR ii = 0 TO wItemCount - 1
    wLen = LEN(passItems$(ii)) * FONT_WIDTH
    IF LEFT$(passItems$(ii), 1) = "~" THEN wLen = wLen - FONT_WIDTH
    IF wLen > maxWidth THEN maxWidth = wLen
  NEXT
  boxW = maxWidth + (2 * editor.TextPadding)
  boxH = (wItemCount * itemH) + 4

  drawBorderBox wPosX, wPosY, boxW, boxH, 15, editor.windowBarClr

  itemSelected = 0
  clickedItem = 0

  FOR ii = 0 TO wItemCount - 1
    itemY = wPosY + 2 + (ii * itemH)
    dStr$ = passItems$(ii)
    isDisabled = 0
    IF LEFT$(dStr$, 1) = "~" THEN
      isDisabled = 1
      dStr$ = MID$(dStr$, 2)
    END IF

    IF isDisabled = 0 THEN
      IF mouseWithinBoxBounds(wPosX + 2, itemY, boxW - 4, itemH) THEN
        drawClearBox wPosX + 2, itemY, boxW - 4, itemH, 9
        IF mouseClickedInBox(wPosX + 2, itemY, boxW - 4, itemH,0) THEN
          clickedItem = ii
          itemSelected = 1
        END IF
      END IF
      PrintStr wPosX + editor.TextPadding, itemY + 2, dStr$, 15, 0, 1
    ELSE
      PrintStr wPosX + editor.TextPadding, itemY + 2, dStr$, sysColor.gray, 0, 1
    END IF
  NEXT

  IF mouseClickedInBox(wPosX, wPosY, boxW, boxH,0) THEN
    editor.MenuClicked = 1
  END IF

  IF itemSelected = 1 THEN
    return2 clickedItem
    processDropdownMenu = 1
    EXIT FUNCTION
  END IF

  return2 0
  processDropdownMenu = 0

END FUNCTION ' processDropdownMenu

''''''''''''''''''''''''
SUB processInput

  oldViewRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  toggleButtonX = editor.StatusLeft
  toggleButtonW = editor.EditorLeft - toggleButtonX
  toggleButtonY = editor.StartY + 3 + (oldViewRows * (editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT))

  IF mouseClickedInBox(toggleButtonX, toggleButtonY, toggleButtonW, editor.HScrollHeight,0) THEN
    cursorWasVisible = 0
    IF editor.CursorY >= editor.ScrollY AND editor.CursorY < editor.ScrollY + oldViewRows THEN cursorWasVisible = 1

    oldStatusLines = 3 + (editor.StatusBarState * 3)
    oldStatusBottom = 1
    IF statusMsgCount > oldStatusLines THEN oldStatusBottom = statusMsgCount - oldStatusLines
    wasStatusAtBottom = 0
    IF editor.StatusScrollY >= oldStatusBottom THEN wasStatusAtBottom = 1

    editor.StatusBarState = 1 - editor.StatusBarState
    editor.ScrollDragActive = 0
    editor.StatusScrollDragActive = 0
    mouse.Clicked1 = 0
    mouse.Released1 = 0

    visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
    lastLine = editor.lastLine
    IF editor.CursorY > lastLine THEN lastLine = editor.CursorY
    maxEditorScroll = lastLine - visibleRows + 1
    IF maxEditorScroll < 1 THEN maxEditorScroll = 1
    IF editor.ScrollY < 1 THEN editor.ScrollY = 1
    IF editor.ScrollY > maxEditorScroll THEN editor.ScrollY = maxEditorScroll
    IF cursorWasVisible = 1 THEN
      IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
      IF editor.CursorY >= editor.ScrollY + visibleRows THEN editor.ScrollY = editor.CursorY - visibleRows + 1
    END IF

    visibleStatusLines = 3 + (editor.StatusBarState * 3)
    maxStatusScroll = 1
    IF statusMsgCount > visibleStatusLines THEN maxStatusScroll = statusMsgCount - visibleStatusLines
    IF wasStatusAtBottom = 1 THEN
      editor.StatusScrollY = maxStatusScroll
    ELSE
      IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
      IF editor.StatusScrollY > maxStatusScroll THEN editor.StatusScrollY = maxStatusScroll
    END IF
  END IF

  IF keyCheck("ESC") THEN
    IF editor.MenuMode = 1 OR editor.MenuMode = 2 THEN
      editor.MenuMode = 0
      waitKeyRelease "ESC"
    ELSE
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        waitKeyRelease "ESC"
        confirmExit
      END IF
    END IF
  END IF

  IF keyCheck("F5") THEN
    IF compileState = COMP_IDLE THEN
      hasCode = 0
      IF editor.lastLine > 1 THEN
        hasCode = 1
      ELSE
        IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
      END IF

      IF hasCode = 1 THEN
        compileState = COMP_REFINE
        waitKeyRelease "F5"
      END IF
    END IF
  END IF

  IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) AND keyCheck("S") THEN
    waitKeyRelease "S"
    _KEYCLEAR

    hasCode = 0
    IF editor.lastLine > 1 THEN
      hasCode = 1
    ELSE
      IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
    END IF

    IF hasCode = 1 THEN
      editor.Focus = 1
      curExt$ = fileNameCustomExt$

      addStatusMsg "SAVING " + fileNameBase$ + curExt$ + "..."
      redrawAll
      dispScreenFlushUpdate

      fileCodeSave

      addStatusMsg "SAVED " + fileNameBase$ + curExt$
    END IF
  END IF

  IF keyCheck("F3") THEN
    waitKeyRelease "F3"
    modalSearch
    EXIT SUB
  END IF

  kVal = _KEYHIT
  IF kVal <= 0 THEN EXIT SUB

  IF kVal = 15616 OR kVal = 6 OR ((kVal = 102 OR kVal = 70) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
    modalSearch
    EXIT SUB
  END IF

  IF editor.Focus = 2 THEN
    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut) - Treat as copy for status bar
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF
  END IF

  IF editor.Focus = 1 THEN

    visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
    lastLine = editor.lastLine
    IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

    oldCursorY = editor.CursorY
    ensureCursorVisible = 0

    IF editor.IsSelecting = 1 THEN
      IF editor.SelectStartX = editor.CursorX AND editor.SelectStartY = editor.CursorY THEN editor.IsSelecting = 0
    END IF

    ' Ctrl+Z (Undo)
    IF kVal = 26 OR ((kVal = 122 OR kVal = 90) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      undo_StateRestore
      kVal = 0
      lastActionWasTyping = 0
      EXIT SUB
    END IF

    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut)
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        ensureCursorVisible = 1
        undo_StateSave
        lastActionWasTyping = 0
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
        deleteSelection
        editor.IsSelecting = 0
      END IF
      kVal = 0
    END IF

    ' Ctrl+A (Select All)
    IF kVal = 1 OR ((kVal = 97 OR kVal = 65) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      ensureCursorVisible = 1
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.CursorY = editor.lastLine
      editor.CursorX = LEN(editorText$(editor.lastLine))
      editor.IsSelecting = 1
      kVal = 0
    END IF

    isPasteKey = 0
    IF kVal = 22 OR ((kVal = 118 OR kVal = 86) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN isPasteKey = 1
    IF kVal = 20992 AND (_KEYDOWN(100303) OR _KEYDOWN(100304)) THEN isPasteKey = 1

    altRoutineSelect = 0
    IF kVal = 18688 OR kVal = 20736 THEN
      IF _KEYDOWN(100307) OR _KEYDOWN(100308) THEN altRoutineSelect = 1
    END IF

    isMoveKey = 0
    IF kVal = 19200 OR kVal = 19712 OR kVal = 18432 OR kVal = 20480 OR kVal = 18176 OR kVal = 20224 OR kVal = 18688 OR kVal = 20736 THEN isMoveKey = 1

    IF isMoveKey = 1 THEN
      ensureCursorVisible = 1
      lastActionWasTyping = 0
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) OR altRoutineSelect = 1 THEN
        IF editor.IsSelecting = 0 THEN
          editor.SelectStartX = editor.CursorX
          editor.SelectStartY = editor.CursorY
          editor.IsSelecting = 1
        END IF
      ELSE
        editor.IsSelecting = 0
      END IF
    END IF

    IF ((kVal >= 32 AND kVal <= 126) OR kVal = 8 OR kVal = 212231 OR kVal = 21248 OR kVal = 13 OR kVal = 118) AND isPasteKey = 0 THEN
      IF isMoveKey = 0 AND kVal <> 0 THEN
        IF editor.IsSelecting = 1 THEN
          ensureCursorVisible = 1
          undo_StateSave
          IF (kVal >= 32 AND kVal <= 126) THEN
            lastActionWasTyping = 1
          ELSE
            lastActionWasTyping = 0
          END IF

          IF kVal = 8 OR kVal = 212231 OR kVal = 21248 THEN
            deleteSelection
            editor.IsSelecting = 0
            kVal = 0 ' Consume key to prevent normal backspace/delete
          ELSE
            IF (kVal >= 32 AND kVal <= 126) OR kVal = 13 THEN
              deleteSelection
              editor.IsSelecting = 0
            ELSE
              editor.IsSelecting = 0
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isPasteKey = 1 THEN ' Ctrl+V (Paste)
      ensureCursorVisible = 1
      undo_StateSave
      lastActionWasTyping = 0
      pasteClipboardText
      kVal = 0
    END IF

    ' Consume any remaining key presses if CTRL is held to prevent unmapped shortcut characters from dropping into the editor
    IF (_KEYDOWN(100305) OR _KEYDOWN(100306)) THEN
      IF kVal >= 32 AND kVal <= 126 THEN
        kVal = 0
      END IF
    END IF

    IF kVal >= 32 AND kVal <= 126 THEN ' Printable character
      ensureCursorVisible = 1
      IF lastActionWasTyping = 0 THEN undo_StateSave
      lastActionWasTyping = 1
      currentLine$ = editorText$(editor.CursorY)
      IF LEN(currentLine$) < editor.CursorX THEN currentLine$ = currentLine$ + SPACE$(editor.CursorX - LEN(currentLine$))
      leftPart$ = LEFT$(currentLine$, editor.CursorX)
      rightPart$ = MID$(currentLine$, editor.CursorX + 1)
      editorText$(editor.CursorY) = leftPart$ + CHR$(kVal) + rightPart$
      IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY
      editor.CursorX = editor.CursorX + 1
    END IF

    IF kVal = 8 THEN ' Backspace
      ensureCursorVisible = 1
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY
      IF editor.CursorX > 0 THEN ' Delete character to the left
        currentLine$ = editorText$(editor.CursorY)
        IF editor.CursorX > LEN(currentLine$) THEN
          editor.CursorX = LEN(currentLine$)
        ELSE
          leftPart$ = LEFT$(currentLine$, editor.CursorX - 1)
          rightPart$ = MID$(currentLine$, editor.CursorX + 1)
          editorText$(editor.CursorY) = leftPart$ + rightPart$
          editor.CursorX = editor.CursorX - 1
        END IF
      ELSE
        IF editor.CursorY > 1 THEN ' Merge with previous line
          prevLineLen = LEN(editorText$(editor.CursorY - 1))
          editor.CursorX = prevLineLen
          editorText$(editor.CursorY - 1) = editorText$(editor.CursorY - 1) + editorText$(editor.CursorY)
          FOR ii = editor.CursorY TO editor.lastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.lastLine) = ""
          editor.CursorY = editor.CursorY - 1
          editor.lastLine = editor.lastLine - 1
          IF editor.lastLine < 1 THEN editor.lastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 212231 OR kVal = 21248 THEN ' Delete key
      ensureCursorVisible = 1
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY
      currentLine$ = editorText$(editor.CursorY)
      IF LEN(currentLine$) < editor.CursorX THEN currentLine$ = currentLine$ + SPACE$(editor.CursorX - LEN(currentLine$))
      IF editor.CursorX < LEN(currentLine$) THEN
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 2)
        editorText$(editor.CursorY) = leftPart$ + rightPart$
      ELSE
        IF editor.CursorY < lastLine THEN ' Merge next line into current
          editorText$(editor.CursorY) = currentLine$ + editorText$(editor.CursorY + 1)
          FOR ii = editor.CursorY + 1 TO editor.lastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.lastLine) = ""
          editor.lastLine = editor.lastLine - 1
          IF editor.lastLine < 1 THEN editor.lastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 13 THEN ' Enter key, split line at cursor
      ensureCursorVisible = 1
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorY < EDITOR_LINE_MAX THEN
        IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY
        currentLine$ = editorText$(editor.CursorY)
        IF LEN(currentLine$) < editor.CursorX THEN currentLine$ = currentLine$ + SPACE$(editor.CursorX - LEN(currentLine$))
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 1)
        editorText$(editor.CursorY) = leftPart$
        FOR ii = editor.lastLine TO editor.CursorY + 1 STEP -1
          IF ii < EDITOR_LINE_MAX THEN
            editorText$(ii + 1) = editorText$(ii)
          END IF
        NEXT
        editorText$(editor.CursorY + 1) = rightPart$
        editor.CursorY = editor.CursorY + 1
        editor.CursorX = 0
        editor.lastLine = editor.lastLine + 1
        IF editor.lastLine > EDITOR_LINE_MAX THEN editor.lastLine = EDITOR_LINE_MAX
        refineCode editor.CursorY - 1, 0
      END IF
    END IF

    IF kVal = 19200 THEN ' Left arrow
      IF editor.CursorX > 0 THEN
        editor.CursorX = editor.CursorX - 1
      ELSE
        IF editor.CursorY > 1 THEN ' Wrap to end of previous line
          editor.CursorY = editor.CursorY - 1
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 19712 THEN ' Right arrow
      IF editor.CursorX < LEN(editorText$(editor.CursorY)) THEN
        editor.CursorX = editor.CursorX + 1
      ELSE
        IF editor.CursorY < lastLine THEN ' Wrap to start of next line
          editor.CursorY = editor.CursorY + 1
          editor.CursorX = 0
        END IF
      END IF
    END IF

    IF kVal = 18432 THEN ' Up arrow
      IF editor.CursorY > 1 THEN
        editor.CursorY = editor.CursorY - 1
      END IF
    END IF

    IF kVal = 20480 THEN ' Down arrow
      IF editor.CursorY < lastLine THEN
        editor.CursorY = editor.CursorY + 1
      END IF
    END IF

    IF kVal = 18176 THEN ' Home key, go to start of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = 1
        editor.CursorX = 0
        editor.ScrollY = 1
        editor.ScrollX = 0
      ELSE
        editor.CursorX = 0
      END IF
    END IF

    IF kVal = 20224 THEN ' End key, go to end of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = lastLine
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = lastLine - visibleRows + 1
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF kVal = 18688 THEN ' Page up
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) OR altRoutineSelect = 1 THEN
        targetY = 1
        IF uiSubCount > 0 THEN
          FOR ii = uiSubCount - 1 TO 0 STEP -1
            startLine = uiSubLine(ii)
            IF startLine + 1 < editor.CursorY THEN
              targetY = startLine + 1
              IF targetY > lastLine THEN targetY = lastLine
              EXIT FOR
            END IF
          NEXT
        END IF
        editor.CursorY = targetY
        editor.CursorX = 0
        editor.ScrollY = editor.CursorY - (visibleRows \ 2)
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY - visibleRows
        IF editor.CursorY < 1 THEN editor.CursorY = 1
      END IF
    END IF

    IF kVal = 20736 THEN ' Page down
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) OR altRoutineSelect = 1 THEN
        targetY = lastLine
        FOR ii = editor.CursorY + 1 TO lastLine
          uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(ii))))
          IF LEFT$(uTemp$, 7) = "END SUB" THEN
            targetY = ii
            EXIT FOR
          END IF
          IF LEFT$(uTemp$, 12) = "END FUNCTION" THEN
            targetY = ii
            EXIT FOR
          END IF
        NEXT
        editor.CursorY = targetY
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = editor.CursorY - (visibleRows \ 2)
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY + visibleRows
        IF editor.CursorY > lastLine THEN editor.CursorY = lastLine
      END IF
    END IF

    ' Modifier keys and commands that do not edit or move the cursor preserve the scrolled view
    IF ensureCursorVisible = 0 THEN EXIT SUB

    IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
    IF editor.CursorY >= editor.ScrollY + visibleRows THEN editor.ScrollY = editor.CursorY - visibleRows + 1

    IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
    IF editor.CursorX >= editor.ScrollX + editor.EditorColumns THEN editor.ScrollX = editor.CursorX - editor.EditorColumns + 1

    IF oldCursorY <> editor.CursorY THEN refineCode oldCursorY, 0

  END IF

END SUB ' processInput

''''''''''''''''''''''''
SUB processVScrollbar (wScrollID AS LONG, wPosX AS LONG, wPosY AS LONG, wSizeX AS LONG, wSizeY AS LONG, wTotalItems AS LONG, wMaxVis AS LONG, wIs1Based AS LONG)

  DIM passCurScroll AS LONG
  DIM passDragActive AS LONG
  DIM passDragOffset AS LONG
  DIM arrowH AS LONG

  arrowH = FONT_HEIGHT + 3

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      passCurScroll = editor.ScrollY
      passDragActive = editor.ScrollDragActive
      passDragOffset = editor.ScrollDragOffsetY
    CASE SCROLL_STATUS
      passCurScroll = editor.StatusScrollY
      passDragActive = editor.StatusScrollDragActive
      passDragOffset = editor.StatusScrollDragOffsetY
    CASE SCROLL_FUNC
      passCurScroll = editor.FuncScroll.ScrollY
      passDragActive = editor.FuncScroll.DragActive
      passDragOffset = editor.FuncScroll.DragOffset
    CASE SCROLL_MODAL
      passCurScroll = editor.ModalScroll.ScrollY
      passDragActive = editor.ModalScroll.DragActive
      passDragOffset = editor.ModalScroll.DragOffset

  END SELECT ' wScrollID

  drawBorderBox wPosX, wPosY, wSizeX, wSizeY, 15, 0

  drawBorderBox wPosX, wPosY, wSizeX, arrowH, 15, 0
  drawBorderBox wPosX, wPosY + wSizeY - arrowH, wSizeX, arrowH, 15, 0

  charX = wPosX + (wSizeX - FONT_WIDTH) \ 2 + 1
  PrintChr charX, wPosY + 2, CHR$(24), 15, 0, 1
  PrintChr charX, wPosY + wSizeY - FONT_HEIGHT - 1, CHR$(25), 15, 0, 1

  minScroll = 0
  IF wIs1Based = 1 THEN minScroll = 1

  scrollRange = wTotalItems - wMaxVis
  IF scrollRange < 0 THEN scrollRange = 0

  maxScroll = scrollRange + minScroll
  IF passCurScroll < minScroll THEN passCurScroll = minScroll
  IF passCurScroll > maxScroll THEN passCurScroll = maxScroll

  thumbMaxH = wSizeY - (2 * arrowH)
  IF wTotalItems > wMaxVis THEN
    thumbSize = (wMaxVis * thumbMaxH) \ wTotalItems
    IF thumbSize < SCROLL_THUMB_MIN THEN thumbSize = SCROLL_THUMB_MIN
    IF scrollRange > 0 THEN
      thumbY = wPosY + arrowH + (((passCurScroll - minScroll) * (thumbMaxH - thumbSize)) \ scrollRange)
    ELSE
      thumbY = wPosY + arrowH
    END IF
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 12, 15
  ELSE
    thumbSize = thumbMaxH
    thumbY = wPosY + arrowH
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 12, 15
  END IF

  ' Mouse Logic
  IF mouse.Clicked1 THEN
    IF wTotalItems > wMaxVis THEN
      IF mouseWithinBoxBounds(wPosX, thumbY, wSizeX, thumbSize) THEN
        passDragActive = 1
        passDragOffset = mouse.PosY - thumbY
      ELSE
        IF mouseWithinBoxBounds(wPosX, wPosY + arrowH, wSizeX, thumbMaxH) THEN
          IF mouse.PosY < thumbY THEN
            passCurScroll = passCurScroll - wMaxVis
            IF passCurScroll < minScroll THEN passCurScroll = minScroll
          ELSE
            passCurScroll = passCurScroll + wMaxVis
            IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
          END IF
        END IF
      END IF
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY, wSizeX, arrowH) THEN
      passCurScroll = passCurScroll - 1
      IF passCurScroll < minScroll THEN passCurScroll = minScroll
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY + wSizeY - arrowH, wSizeX, arrowH) THEN
      passCurScroll = passCurScroll + 1
      IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
    END IF
  END IF

  IF mouse.Button1Down AND passDragActive = 1 THEN
    IF wTotalItems > wMaxVis THEN
      newThumbY = mouse.PosY - passDragOffset
      trackSize = thumbMaxH - thumbSize
      IF trackSize > 0 THEN
        newScroll = minScroll + (((newThumbY - (wPosY + arrowH)) * scrollRange) \ trackSize)
        IF newScroll < minScroll THEN newScroll = minScroll
        IF newScroll > maxScroll THEN newScroll = maxScroll
        passCurScroll = newScroll
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    passDragActive = 0
  END IF

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      editor.ScrollY = passCurScroll
      editor.ScrollDragActive = passDragActive
      editor.ScrollDragOffsetY = passDragOffset
    CASE SCROLL_STATUS
      editor.StatusScrollY = passCurScroll
      editor.StatusScrollDragActive = passDragActive
      editor.StatusScrollDragOffsetY = passDragOffset
    CASE SCROLL_FUNC
      editor.FuncScroll.ScrollY = passCurScroll
      editor.FuncScroll.DragActive = passDragActive
      editor.FuncScroll.DragOffset = passDragOffset
    CASE SCROLL_MODAL
      editor.ModalScroll.ScrollY = passCurScroll
      editor.ModalScroll.DragActive = passDragActive
      editor.ModalScroll.DragOffset = passDragOffset

  END SELECT ' wScrollID

END SUB ' processVScrollbar

''''''''''''''''''''''''
SUB pushStatusMsg (wStr$, wLineNum AS LONG, wGroupID AS _UNSIGNED LONG)

  IF statusMsgCount < MAX_STATUS_MSGS THEN
    statusMsg(statusMsgCount).Text = wStr$
    statusMsg(statusMsgCount).CodeLine = wLineNum
    statusMsg(statusMsgCount).GroupID = wGroupID
    statusMsgCount = statusMsgCount + 1
  ELSE
    FOR ii = 1 TO 998
      statusMsg(ii).Text = statusMsg(ii + 1).Text
      statusMsg(ii).CodeLine = statusMsg(ii + 1).CodeLine
      statusMsg(ii).GroupID = statusMsg(ii + 1).GroupID
    NEXT
    statusMsg(999).Text = wStr$
    statusMsg(999).CodeLine = wLineNum
    statusMsg(999).GroupID = wGroupID
  END IF

  statusBoxH = (3 + (editor.StatusBarState * 3)) * STATUS_ROW_HEIGHT + 5
  maxLines = (statusBoxH - 5) \ STATUS_ROW_HEIGHT
  IF (statusMsgCount - 1) > maxLines THEN
    editor.StatusScrollY = statusMsgCount - maxLines
  ELSE
    editor.StatusScrollY = 1
  END IF

END SUB ' pushStatusMsg

''''''''''''''''''''''''
SUB redrawAll

  _DEST logicalScreen

  CLS
  COLOR 15
  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), editor.windowBgClr, BF

  editor.MenuClicked = 0

  funcMouseBlocked = 0
  IF editor.MenuMode = 0 AND funcArrowRight = 1 THEN
    funcListBoxW = editor.SideWidth + ((24 - editor.FuncNameColumns) * FONT_WIDTH)
    funcListBoxH = (15 * (editor.FontHeight + 2)) + 4

    IF mouseWithinBoxBounds(0, editor.StartY, funcListBoxW, funcListBoxH) THEN funcMouseBlocked = 1

    IF mouse.Clicked1 OR mouse.Button1Down OR mouse.Released1 THEN
      IF mouseDownWithinBoxBounds(0, editor.StartY, funcListBoxW, funcListBoxH) THEN funcMouseBlocked = 1
    END IF

    IF mouse.Clicked2 OR mouse.Button2Down OR mouse.Released2 THEN
      IF mouseDown2WithinBoxBounds(0, editor.StartY, funcListBoxW, funcListBoxH) THEN funcMouseBlocked = 1
    END IF
  END IF

  IF funcMouseBlocked = 1 THEN
    savedWheel = mouse.Wheel
    savedClicked1 = mouse.Clicked1
    savedClicked2 = mouse.Clicked2
    savedReleased1 = mouse.Released1
    savedReleased2 = mouse.Released2
    savedDown1 = mouse.Button1Down
    savedDown2 = mouse.Button2Down

    IF mouse.Clicked1 OR mouse.Released1 THEN
      editor.DragActive = 0
      editor.ScrollDragActiveX = 0
    END IF

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0
  END IF

  drawEditorPMI

  IF funcMouseBlocked = 1 THEN
    mouse.Wheel = savedWheel
    mouse.Clicked1 = savedClicked1
    mouse.Clicked2 = savedClicked2
    mouse.Released1 = savedReleased1
    mouse.Released2 = savedReleased2
    mouse.Button1Down = savedDown1
    mouse.Button2Down = savedDown2
  END IF
  drawStatusPMI

  ' Draw side UI elements before top menu to ensure dropdowns appear on top
  drawButtonsPMI
  drawFuncListPMI

  drawTopMenuAndScrollPMI
  drawCornerPMI

  _DEST logicalScreen

  minAllW = editor.MinAllWidth
  minAllH = FONT_HEIGHT + 3
  minAllX = 0
  minAllY = SCREENSIZEY - minAllH - 1

  drawBorderBox minAllX, minAllY, minAllW, minAllH, 15, editor.windowBarClr

  IF mouseWithinBoxBounds(minAllX, minAllY, minAllW, minAllH) THEN
    drawClearBox minAllX + 1, minAllY + 1, minAllW - 2, minAllH - 2, 9
  END IF

  PrintStr minAllX + editor.MinAllTextOffset, minAllY + 2, "v", 15, 0, 1

  IF mouseClickedInBox(minAllX, minAllY, minAllW, minAllH,0) THEN
    editor.MenuClicked = 1
    SHELL _HIDE "explorer.exe shell:::{3080F90D-D7AD-11D9-BD98-0000947B0257}"
  END IF

  IF mouse.Released1 THEN
    IF editor.MenuClicked = 0 THEN
      editor.TopMenuFocus = 0
    END IF
  END IF

  showCursorData editor.CursorDataBaseX, SCREENSIZEY - 49

END SUB ' redrawAll

''''''''''''''''''''''''
SUB return2 (wVal)

  ' Return the global secondary return variable

  returnF2data = wVal

END SUB ' return2

''''''''''''''''''''''''
SUB return3 (wVal)

  ' Return the global tertiary return value

  returnF3data = wVal

END SUB ' return3

''''''''''''''''''''''''
FUNCTION returnedData2

  returnedData2 = returnF2data

END FUNCTION ' returnedData2

''''''''''''''''''''''''
FUNCTION returnedData3

  returnedData3 = returnF3data

END FUNCTION ' returnedData3

''''''''''''''''''''''''
SUB returnExtraPrepare

  ' Call at the top of any function that sends back return 2 or 3 data

  returnF2data = 0
  returnF3data = 0

END SUB ' returnExtraPrepare

''''''''''''''''''''''''
SUB ZLOCATE (wX, wY)

  LOCATE wY + 1, wX + 1

END SUB ' ZLOCATE

''''''''''''''''''''''''
SUB ESCAPETEXT (wStr$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr$ = "" THEN wStr$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  PrintTextLineWithBanners wStr$, 15, BOTTOM

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - FONT_HEIGHT, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT

''''''''''''''''''''''''
SUB ESCAPETEXT2 (wStr1$, wStr2$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr1$ = "" THEN wStr1$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  fileOutputErrorReport wStr1$, wStr2$

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  boxW = SCREENSIZEX - 16
  boxH = 34
  boxX = 8
  boxY = SCREENSIZEY - 128

  drawBorderBox boxX, boxY, boxW, boxH, 1, 0
  drawClearBox boxX + 1, boxY + 1, boxW - 2, boxH - 2, 15

  displayText1$ = wStr1$
  displayText2$ = wStr2$
  maxChars = (boxW - (2 * editor.TextPadding)) \ FONT_WIDTH
  displayText1$ = LEFT$(displayText1$, maxChars)
  displayText2$ = LEFT$(displayText2$, maxChars)

  PrintStr boxX + editor.TextPadding, boxY + 8, displayText1$, 15, 0, 0

  IF wStr2$ <> "" THEN
    PrintStr boxX + editor.TextPadding, boxY + 18, displayText2$, 15, 0, 0
  END IF

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - FONT_HEIGHT, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT2

''''''''''''''''''''''''
FUNCTION extractQuotes$ (wStr$)

  tempReturn$ = ""
  firstQuote = INSTR(wStr$, CHR$(34))

  IF firstQuote > 0 THEN
    secondQuote = INSTR(firstQuote + 1, wStr$, CHR$(34))
    IF secondQuote > 0 THEN
      tempReturn$ = MID$(wStr$, firstQuote + 1, secondQuote - firstQuote - 1)
    END IF
  END IF

  extractQuotes$ = tempReturn$

END FUNCTION ' extractQuotes$

''''''''''''''''''''''''
SUB fileCodeImport (importFile$)

  DIM importStageStart AS DOUBLE
  DIM importStageEnd AS DOUBLE

  fileImportTiming.Ready = 0
  fileImportTiming.ReadSeconds = 0
  fileImportTiming.UndoSeconds = 0
  fileImportTiming.TextSeconds = 0

  importStageStart = TIMER

  IF _FILEEXISTS(importFile$) = 0 THEN EXIT SUB

  ffTmp = FREEFILE
  OPEN importFile$ FOR BINARY AS #ffTmp
  fileLen = LOF(ffTmp)
  IF fileLen = 0 THEN
    CLOSE #ffTmp
    EXIT SUB
  END IF

  fullText$ = SPACE$(fileLen)
  GET #ffTmp, , fullText$
  CLOSE #ffTmp

  importStageEnd = TIMER
  fileImportTiming.ReadSeconds = importStageEnd - importStageStart
  IF fileImportTiming.ReadSeconds < 0 THEN fileImportTiming.ReadSeconds = fileImportTiming.ReadSeconds + 86400
  importStageStart = importStageEnd

  curY = editor.LastLine + 1
  IF curY > EDITOR_LINE_MAX - 5 THEN EXIT SUB

  separator$ = STRING$(24, 39)
  lineFeed$ = CHR$(10)

  undoState.CursorX = editor.CursorX
  undoState.CursorY = editor.CursorY
  undoState.ScrollX = editor.ScrollX
  undoState.ScrollY = editor.ScrollY
  undoState.LastLine = editor.LastLine
  undoState.ImportOnly = 1
  undoState.Ready = 1

  importStageEnd = TIMER
  fileImportTiming.UndoSeconds = importStageEnd - importStageStart
  IF fileImportTiming.UndoSeconds < 0 THEN fileImportTiming.UndoSeconds = fileImportTiming.UndoSeconds + 86400
  importStageStart = importStageEnd

  ' Enforce visual separation
  editorText$(curY) = ""
  curY = curY + 1

  editorText$(curY) = separator$
  curY = curY + 1

  editorText$(curY) = "'IMPORTED " + CHR$(34) + importFile$ + CHR$(34)
  curY = curY + 1

  editorText$(curY) = separator$
  curY = curY + 1

  editorText$(curY) = ""
  curY = curY + 1

  startPos = 1

  ' Slice the incoming file block natively to eliminate slow byte-by-byte loop processing
  DO WHILE startPos <= fileLen AND curY <= EDITOR_LINE_MAX
    nextNl = INSTR(startPos, fullText$, lineFeed$)
    chunkEnd = fileLen + 1
    IF nextNl > 0 THEN chunkEnd = nextNl

    chunkLen = chunkEnd - startPos
    IF chunkLen > 0 THEN
      IF ASC(fullText$, chunkEnd - 1) = 13 THEN chunkLen = chunkLen - 1
    END IF

    editorText$(curY) = MID$(fullText$, startPos, chunkLen)
    curY = curY + 1
    startPos = chunkEnd + 1
  LOOP

  ' Sync the global tracking bounds safely to the new expanded size
  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

  importStageEnd = TIMER
  fileImportTiming.TextSeconds = importStageEnd - importStageStart
  IF fileImportTiming.TextSeconds < 0 THEN fileImportTiming.TextSeconds = fileImportTiming.TextSeconds + 86400
  fileImportTiming.RefineStart = importStageEnd
  fileImportTiming.Ready = 1

END SUB ' fileCodeImport

''''''''''''''''''''''''
SUB fileCodeLoad

  DIM fileLen AS LONG
  DIM startPos AS LONG
  DIM nextNl AS LONG
  DIM chunkEnd AS LONG
  DIM chunkLen AS LONG
  DIM loadStageStart AS DOUBLE
  DIM loadStageEnd AS DOUBLE

  fileLoadTiming.Ready = 0
  fileLoadTiming.ReadSeconds = 0
  fileLoadTiming.UndoSeconds = 0
  fileLoadTiming.TextSeconds = 0

  loadStageStart = TIMER

  curExt$ = fileNameCustomExt$

  fln$ = fileNameBase$ + curExt$

  IF _FILEEXISTS(fln$) = 0 THEN EXIT SUB

  OPEN fln$ FOR BINARY AS #1

  fileLen = LOF(1)

  IF fileLen = 0 THEN
    CLOSE #1
    KILL fln$
    EXIT SUB
  END IF

  ' Pre-allocate buffer and read entire file at once to eliminate per-byte I/O latency
  fullText$ = SPACE$(fileLen)
  GET #1, , fullText$
  CLOSE #1

  loadStageEnd = TIMER
  fileLoadTiming.ReadSeconds = loadStageEnd - loadStageStart
  IF fileLoadTiming.ReadSeconds < 0 THEN fileLoadTiming.ReadSeconds = fileLoadTiming.ReadSeconds + 86400
  loadStageStart = loadStageEnd

  oldLastLine = editor.LastLine

  ' Preserve a pending import undo record before replacing its original text
  IF undoState.Ready = 1 AND undoState.ImportOnly = 1 THEN
    FOR ii = 1 TO undoState.LastLine
      SWAP undoText$(ii), editorText$(ii)
    NEXT
    FOR ii = undoState.LastLine + 1 TO undoState.TextLineCount
      undoText$(ii) = ""
    NEXT
    undoState.TextLineCount = undoState.LastLine
    undoState.ImportOnly = 0
  END IF

  loadStageEnd = TIMER
  fileLoadTiming.UndoSeconds = loadStageEnd - loadStageStart
  IF fileLoadTiming.UndoSeconds < 0 THEN fileLoadTiming.UndoSeconds = fileLoadTiming.UndoSeconds + 86400
  loadStageStart = loadStageEnd

  curY = 1
  startPos = 1
  lineFeed$ = CHR$(10)

  ' Slice the text into individual lines using the native INSTR delimiter scanner for extreme speed
  DO WHILE startPos <= fileLen AND curY <= EDITOR_LINE_MAX
    nextNl = INSTR(startPos, fullText$, lineFeed$)
    chunkEnd = fileLen + 1
    IF nextNl > 0 THEN chunkEnd = nextNl

    chunkLen = chunkEnd - startPos
    IF chunkLen > 0 THEN
      IF ASC(fullText$, chunkEnd - 1) = 13 THEN chunkLen = chunkLen - 1
    END IF

    editorText$(curY) = MID$(fullText$, startPos, chunkLen)
    curY = curY + 1
    startPos = chunkEnd + 1
  LOOP

  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

  ' Pre-clear arrays
  FOR iy = editor.LastLine + 1 TO oldLastLine
    editorText$(iy) = ""
  NEXT

  IF editor.CursorY > editor.LastLine THEN
    editor.CursorY = editor.LastLine
    editor.CursorX = 0
  END IF

  IF editor.ScrollY > editor.LastLine THEN
    visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
    editor.ScrollY = editor.LastLine - visibleRows + 1
    IF editor.ScrollY < 1 THEN editor.ScrollY = 1
  END IF

  loadStageEnd = TIMER
  fileLoadTiming.TextSeconds = loadStageEnd - loadStageStart
  IF fileLoadTiming.TextSeconds < 0 THEN fileLoadTiming.TextSeconds = fileLoadTiming.TextSeconds + 86400
  fileLoadTiming.RefineStart = loadStageEnd
  fileLoadTiming.Ready = 1

END SUB ' fileCodeLoad

''''''''''''''''''''''''
SUB fileCodeSave

  curExt$ = fileNameCustomExt$

  fln$ = fileNameBase$ + curExt$

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp
  IF LOF(ffTmp) > 0 THEN
    CLOSE #ffTmp
    KILL fln$
    OPEN fln$ FOR BINARY AS #ffTmp
  END IF

  lastLine = editor.LastLine
  totalLen = 0

  ' Calculate the exact buffer size required for the entire file
  FOR iy = 1 TO lastLine
    totalLen = totalLen + LEN(editorText$(iy))
  NEXT

  ' Add space for the newline characters between each line
  IF lastLine > 1 THEN
    totalLen = totalLen + (lastLine - 1)
  END IF

  IF totalLen > 0 THEN
    ' Pre-allocate the memory block to prevent slow string concatenation
    fullText$ = SPACE$(totalLen)
    curPos = 1

    FOR iy = 1 TO lastLine
      lineStr$ = editorText$(iy)
      lineLen = LEN(lineStr$)

      IF lineLen > 0 THEN
        ' Use direct memory injection for maximum speed
        MID$(fullText$, curPos, lineLen) = lineStr$
        curPos = curPos + lineLen
      END IF

      ' Append the newline separator seamlessly
      IF iy < lastLine THEN
        ASC(fullText$, curPos) = 10
        curPos = curPos + 1
      END IF
    NEXT

    ' Blast the entire buffer directly to the disk in one native operation
    PUT #ffTmp, , fullText$
  END IF

  CLOSE #ffTmp

END SUB ' fileCodeSave

''''''''''''''''''''''''
SUB fileSaveBinary

  DIM tryCount AS LONG
  DIM iLong AS _UNSIGNED LONG
  DIM pauseSeconds AS DOUBLE
  DIM suffixStr$
  DIM testBase$

  returnExtraPrepare

  IF outputFileIdx > 0 THEN
    compileSaveTracker "ALLOCATING FILE DATA", 0, outputFileIdx, 0
    outStr$ = SPACE$(outputFileIdx)

    FOR iLong = 0 TO outputFileIdx - 1
      IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
        compileSaveTracker "COPYING FILE DATA", iLong + 1, outputFileIdx, 0
      END IF

      ASC(outStr$, iLong + 1) = outputFile(iLong)
    NEXT
  END IF

  compileSaveTracker "SELECTING FILE NAME", 0, 0, 0

  tryCount = 0
  pauseSeconds = 0
  testBase$ = fileNameBase$

  DO
    compileSaveTracker "SELECTING FILE NAME", 0, 0, 0

    fln$ = testBase$ + ".exe"

    IF _FILEEXISTS(fln$) THEN
      ' Pass the deletion command to the operating system to avoid fatal lock crashes
      SHELL _HIDE "cmd /c del /F /Q " + CHR$(34) + fln$ + CHR$(34)

      ' If the file survives the OS deletion attempt, it is actively locked by a running process
      ' A permissions failure can also prevent deletion
      IF _FILEEXISTS(fln$) THEN
        tryCount = tryCount + 1

        IF tryCount < 10 THEN
          suffixStr$ = "_0" + LTRIM$(RTRIM$(STR$(tryCount)))
        ELSE
          suffixStr$ = "_" + LTRIM$(RTRIM$(STR$(tryCount)))
        END IF

        testBase$ = fileNameBase$ + suffixStr$
      ELSE
        EXIT DO
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  compileSaveTracker "OPENING EXECUTABLE", 0, 0, 0

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp

  IF outputFileIdx > 0 THEN
    compileSaveTracker "WRITING EXECUTABLE", outputFileIdx, outputFileIdx, 0
    PUT #ffTmp, , outStr$
  END IF

  compileSaveTracker "FINISHING EXECUTABLE", outputFileIdx, outputFileIdx, 0
  CLOSE #ffTmp

  ' Update the global base name so the IDE runner launches the newly generated executable
  ' Return the selected number to the runner while preserving the BASIC source filename
  return3 pauseSeconds
  return2 tryCount

END SUB ' fileSaveBinary

''''''''''''''''''''''''
SUB fileOutputErrorReport (wStr1$, wStr2$)

  rwVar$ = " " ' Necessary, or QB64 won't work correctly

  fln$ = fileNameErr$

  OPEN fln$ FOR BINARY AS #1
  IF LOF(1) > 0 THEN
    CLOSE #1
    KILL fln$
    OPEN fln$ FOR BINARY AS #1
  END IF

  FOR ix = 1 TO LEN(wStr1$)
    rwVar$ = MID$(wStr1$, ix, 1)
    PUT #1, , rwVar$
  NEXT

  rwVar$ = CHR$(13)
  PUT #1, , rwVar$
  rwVar$ = CHR$(10)
  PUT #1, , rwVar$

  IF wStr2$ <> "" THEN
    FOR ix = 1 TO LEN(wStr2$)
      rwVar$ = MID$(wStr2$, ix, 1)
      PUT #1, , rwVar$
    NEXT
    rwVar$ = CHR$(13)
    PUT #1, , rwVar$
    rwVar$ = CHR$(10)
    PUT #1, , rwVar$
  END IF

  CLOSE #1

END SUB ' fileOutputErrorReport

''''''''''''''''''''''''
FUNCTION fileTimingReport$ (timingLabel$, readSeconds AS DOUBLE, undoSeconds AS DOUBLE, textSeconds AS DOUBLE, refineSeconds AS DOUBLE)

  DIM phaseSeconds AS DOUBLE

  result$ = timingLabel$ + ": "

  FOR phaseNum = 1 TO 4
    SELECT CASE phaseNum

      CASE 1
        phaseLabel$ = "READ"
        phaseSeconds = readSeconds

      CASE 2
        phaseLabel$ = "UNDO"
        phaseSeconds = undoSeconds

      CASE 3
        phaseLabel$ = "TEXT"
        phaseSeconds = textSeconds

      CASE 4
        phaseLabel$ = "FORMAT"
        phaseSeconds = refineSeconds

    END SELECT

    phaseHundredths = INT(phaseSeconds * 100 + 0.5)
    wholeSeconds = phaseHundredths \ 100
    fractionHundredths = phaseHundredths - (wholeSeconds * 100)

    phaseText$ = LTRIM$(STR$(wholeSeconds)) + "." + RIGHT$("0" + LTRIM$(STR$(fractionHundredths)), 2)
    result$ = result$ + phaseLabel$ + " " + phaseText$ + "s"
    IF phaseNum < 4 THEN result$ = result$ + " "
  NEXT

  fileTimingReport$ = result$

END FUNCTION ' fileTimingReport$

''''''''''''''''''''''''
FUNCTION findComma (startIdx, endIdx)

  DIM commaPos AS LONG

  commaPos = 0
  ff = findNextTokenAtDepth0(startIdx, endIdx, 256 + ASC(","))
  IF ff = 1 THEN
    commaPos = returnedData2
  END IF

  findComma = commaPos

END FUNCTION ' findComma

''''''''''''''''''''''''
SUB findEditorNext

  ' When a match is found, it performs the following tasks:
  ' Updates the cursor position (editor.CursorX and editor.CursorY).
  ' Sets the selection boundaries to highlight the found text.
  ' Adjusts the horizontal and vertical scroll offsets so the found text is visible on the screen.
  ' Assigns focus to the editor window.

  IF editorSearchQuery$ = "" THEN EXIT SUB

  foundMatch = 0
  uQuery$ = UCASE$(editorSearchQuery$)

  FOR iy = editor.CursorY TO editor.LastLine
    uLine$ = UCASE$(editorText$(iy))
    matchPos = INSTR(uLine$, uQuery$)

    IF matchPos > 0 AND iy = editor.CursorY THEN
      matchPos = INSTR(editor.CursorX + 2, uLine$, uQuery$)
    END IF

    IF matchPos > 0 THEN
      editor.CursorY = iy
      editor.CursorX = matchPos - 1
      editor.SelectStartY = iy
      editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
      editor.IsSelecting = 1
      editor.Focus = 1

      editor.ScrollY = editor.CursorY - ((EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)) \ 2)
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      editor.ScrollX = editor.CursorX - 20
      IF editor.ScrollX < 0 THEN editor.ScrollX = 0

      foundMatch = 1
      EXIT FOR
    END IF
  NEXT

  IF foundMatch = 0 THEN
    FOR iy = 1 TO editor.CursorY
      uLine$ = UCASE$(editorText$(iy))
      matchPos = INSTR(uLine$, uQuery$)

      IF matchPos > 0 THEN
        editor.CursorY = iy
        editor.CursorX = matchPos - 1
        editor.SelectStartY = iy
        editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
        editor.IsSelecting = 1
        editor.Focus = 1

        editor.ScrollY = editor.CursorY - ((EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)) \ 2)
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
        editor.ScrollX = editor.CursorX - 20
        IF editor.ScrollX < 0 THEN editor.ScrollX = 0

        addStatusMsg "SEARCH RESTARTED AT TOP"

        foundMatch = 1
        EXIT FOR
      END IF
    NEXT
  END IF

  IF foundMatch = 0 THEN
    addStatusMsg "SEARCH: NO MATCHES FOUND"
  END IF

END SUB ' findEditorNext

''''''''''''''''''''''''
SUB undo_StateRestore

  IF undoState.Ready = 0 THEN EXIT SUB

  IF undoState.ImportOnly = 0 THEN
    FOR ii = 1 TO undoState.LastLine
      editorText$(ii) = undoText$(ii)
    NEXT
  END IF
  FOR ii = undoState.LastLine + 1 TO editor.LastLine
    editorText$(ii) = ""
  NEXT

  editor.CursorX = undoState.CursorX
  editor.CursorY = undoState.CursorY
  editor.ScrollX = undoState.ScrollX
  editor.ScrollY = undoState.ScrollY
  editor.LastLine = undoState.LastLine

  undoState.Ready = 0
  undoState.ImportOnly = 0
  lastActionWasTyping = 0

  addStatusMsg "UNDO USED"

  refineCode 0, 3

END SUB ' undo_StateRestore

''''''''''''''''''''''''
SUB undo_StateSave

  FOR ii = 1 TO editor.LastLine
    undoText$(ii) = editorText$(ii)
  NEXT
  FOR ii = editor.LastLine + 1 TO undoState.TextLineCount
    undoText$(ii) = ""
  NEXT

  undoState.TextLineCount = editor.LastLine
  undoState.CursorX = editor.CursorX
  undoState.CursorY = editor.CursorY
  undoState.ScrollX = editor.ScrollX
  undoState.ScrollY = editor.ScrollY
  undoState.LastLine = editor.LastLine
  undoState.ImportOnly = 0

  undoState.Ready = 1

END SUB ' undo_StateSave

''''''''''''''''''''''''
SUB throwCompilerError (errMsg$, wType, wData)

  ' wData is a placeholder

  IF wType = ASIS THEN
    ' Centralized error helper to reduce boilerplate formatting as the compiler grows
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$
  ELSE ' WITHFAILED:
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$ + " FAILED"
  END IF

  compileError = 1

END SUB ' throwCompilerError

'''''''''''''''''''''''
SUB throwCompilerErrorAndCancelTira (errMsg$, wType, wData)

  ' Combines two frequently used calls into one

  tira_Cancel

  throwCompilerError errMsg$, wType, wData

END SUB ' throwCompilerErrorAndCancelTira

'''''''''''''''''''''''
SUB throwCompilerErrorNoLineNum (errMsg$)

  addStatusMsg "ERROR: " + errMsg$
  compileError = 1

END SUB ' throwCompilerErrorNoLineNum

''''''''''''''''''''''''
SUB waitTimer (wSeconds)

  tGoal = TIMER + wSeconds
  DO WHILE TIMER < tGoal
  LOOP

END SUB ' waitTimer

