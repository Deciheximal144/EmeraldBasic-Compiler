  outputPal(2, palRED) = 0: outputPal(2, palGREEN) = 170: outputPal(2, palBLUE) = 0 ' Green
  outputPal(3, palRED) = 0: outputPal(3, palGREEN) = 170: outputPal(3, palBLUE) = 170 ' Cyan
  outputPal(4, palRED) = 170: outputPal(4, palGREEN) = 0: outputPal(4, palBLUE) = 0 ' Red
  outputPal(5, palRED) = 170: outputPal(5, palGREEN) = 0: outputPal(5, palBLUE) = 170 ' Magenta
  outputPal(6, palRED) = 170: outputPal(6, palGREEN) = 85: outputPal(6, palBLUE) = 0 ' Brown
  outputPal(7, palRED) = 170: outputPal(7, palGREEN) = 170: outputPal(7, palBLUE) = 170 ' Light Gray
  outputPal(8, palRED) = 85: outputPal(8, palGREEN) = 85: outputPal(8, palBLUE) = 85 ' Dark Gray
  outputPal(9, palRED) = 85: outputPal(9, palGREEN) = 85: outputPal(9, palBLUE) = 255 ' Light Blue
  outputPal(10, palRED) = 85: outputPal(10, palGREEN) = 255: outputPal(10, palBLUE) = 85 ' Light Green
  outputPal(11, palRED) = 85: outputPal(11, palGREEN) = 255: outputPal(11, palBLUE) = 255 ' Light Cyan
  outputPal(12, palRED) = 255: outputPal(12, palGREEN) = 85: outputPal(12, palBLUE) = 85 ' Light Red
  outputPal(13, palRED) = 255: outputPal(13, palGREEN) = 85: outputPal(13, palBLUE) = 255 ' Light Magenta
  outputPal(14, palRED) = 255: outputPal(14, palGREEN) = 255: outputPal(14, palBLUE) = 85 ' Yellow
  outputPal(15, palRED) = 255: outputPal(15, palGREEN) = 255: outputPal(15, palBLUE) = 255 ' Bright White

  FOR ii = 16 TO 255
    outputPal(ii, palRED) = 0
    outputPal(ii, palGREEN) = 0
    outputPal(ii, palBLUE) = 0
  NEXT

END SUB ' initPalettesOutput

''''''''''''''''''''''''
SUB initPalettesVGA

  ' 0-15 Standard VGA-style palette
  bmpPal256(0, palRED) = 0: bmpPal256(0, palGREEN) = 0: bmpPal256(0, palBLUE) = 0 ' Black
  bmpPal256(1, palRED) = 0: bmpPal256(1, palGREEN) = 0: bmpPal256(1, palBLUE) = 170 ' Blue
  bmpPal256(2, palRED) = 0: bmpPal256(2, palGREEN) = 170: bmpPal256(2, palBLUE) = 0 ' Green
  bmpPal256(3, palRED) = 0: bmpPal256(3, palGREEN) = 170: bmpPal256(3, palBLUE) = 170 ' Cyan
  bmpPal256(4, palRED) = 170: bmpPal256(4, palGREEN) = 0: bmpPal256(4, palBLUE) = 0 ' Red
  bmpPal256(5, palRED) = 170: bmpPal256(5, palGREEN) = 0: bmpPal256(5, palBLUE) = 170 ' Magenta
  bmpPal256(6, palRED) = 170: bmpPal256(6, palGREEN) = 85: bmpPal256(6, palBLUE) = 0 ' Brown
  bmpPal256(7, palRED) = 170: bmpPal256(7, palGREEN) = 170: bmpPal256(7, palBLUE) = 170 ' Light gray
  bmpPal256(8, palRED) = 85: bmpPal256(8, palGREEN) = 85: bmpPal256(8, palBLUE) = 85 ' Dark gray
  bmpPal256(9, palRED) = 85: bmpPal256(9, palGREEN) = 85: bmpPal256(9, palBLUE) = 255 ' Light blue
  bmpPal256(10, palRED) = 85: bmpPal256(10, palGREEN) = 255: bmpPal256(10, palBLUE) = 85 ' Light green
  bmpPal256(11, palRED) = 85: bmpPal256(11, palGREEN) = 255: bmpPal256(11, palBLUE) = 255 ' Light cyan
  bmpPal256(12, palRED) = 255: bmpPal256(12, palGREEN) = 85: bmpPal256(12, palBLUE) = 85 ' Light red
  bmpPal256(13, palRED) = 255: bmpPal256(13, palGREEN) = 85: bmpPal256(13, palBLUE) = 255 ' Light magenta
  bmpPal256(14, palRED) = 255: bmpPal256(14, palGREEN) = 255: bmpPal256(14, palBLUE) = 85 ' Yellow
  bmpPal256(15, palRED) = 255: bmpPal256(15, palGREEN) = 255: bmpPal256(15, palBLUE) = 255 ' Bright white

  ' 17-31 Green spectrum: dark green to light green
  FOR ii = 17 TO 31
    greenVal = 48 + (((ii - 17) * 207) \ 14)
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = greenVal
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 32-191 Red spectrum: dark red to bright red
  FOR ii = 32 TO 191
    redVal = ((ii - 32) * 255) \ 159
    bmpPal256(ii, palRED) = redVal
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 192-255 Blue spectrum: dark blue to bright blue
  FOR ii = 192 TO 255
    blueVal = ((ii - 192) * 255) \ 63
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = blueVal
  NEXT

END SUB ' initPalettesVGA

''''''''''''''''''''''''
''''''''''''''''''''''''
SUB loadIncludesAndBaseCode

  compileLastLine = 0
  FOR iy = 1 TO editor.LastLine
    compileLastLine = compileLastLine + 1
    compileText$(compileLastLine) = editorText$(iy)
    editorLineLinkMap(compileLastLine) = iy
  NEXT

  FOR iy = 1 TO editor.LastLine
    tempScan$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
    origDir$ = LTRIM$(RTRIM$(editorText$(iy)))

    IF LEFT$(tempScan$, 1) = "'" THEN
      tempScan$ = LTRIM$(MID$(tempScan$, 2))
      origDir$ = LTRIM$(MID$(origDir$, 2))
    ELSE
      IF LEFT$(tempScan$, 4) = "REM " OR tempScan$ = "REM" THEN
        tempScan$ = LTRIM$(MID$(tempScan$, 5))
        origDir$ = LTRIM$(MID$(origDir$, 5))
      END IF
    END IF

    IF LEFT$(tempScan$, 8) = "#INCLUDE" THEN
      qStart = INSTR(origDir$, CHR$(34))
      IF qStart > 0 THEN
        qEnd = INSTR(qStart + 1, origDir$, CHR$(34))
        IF qEnd > 0 THEN
          fName$ = MID$(origDir$, qStart + 1, qEnd - qStart - 1)
          IF _FILEEXISTS(fName$) THEN
            ffTmp = FREEFILE
            OPEN fName$ FOR BINARY AS #ffTmp
            fileLen = LOF(ffTmp)
            IF fileLen > 0 THEN
              fullText$ = SPACE$(fileLen)
              GET #ffTmp, , fullText$
              startPos = 1
              DO WHILE startPos <= fileLen
                nextNl = INSTR(startPos, fullText$, CHR$(10))
                IF nextNl > 0 THEN
                  chunkLen = nextNl - startPos
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                    ELSE
                      IF chunkLen > 0 THEN
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  startPos = nextNl + 1
                ELSE
                  chunkLen = fileLen - startPos + 1
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                    ELSE
                      IF chunkLen > 0 THEN
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  EXIT DO
                END IF
              LOOP
            END IF
            CLOSE #ffTmp
          ELSE
            currentLineNumber = iy
            throwCompilerError "INCLUDE FILE NOT FOUND: " + fName$, ASIS, 0
            EXIT SUB
          END IF
        ELSE
          currentLineNumber = iy
          throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
          EXIT SUB
        END IF
      ELSE
        currentLineNumber = iy
        throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
        EXIT SUB
      END IF
    END IF
  NEXT

END SUB ' loadIncludesAndBaseCode

''''''''''''''''''''''''
FUNCTION mouseClickedInBox (wStartX, wStartY, wSizeX, wSizeY)

  tempRet = 0

  IF mouse.Released1 THEN
    IF mouseWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
      IF mouseDownWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
        tempRet = 1
      END IF
    END IF
  END IF

  mouseClickedInBox = tempRet

END FUNCTION ' mouseClickedInBox

''''''''''''''''''''''''
FUNCTION mouseDownWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX >= wStartX AND mouse.DownPosX <= (wStartX + wSizeX - 1) AND mouse.DownPosY >= wStartY AND mouse.DownPosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDownWithinBoxBounds = toRet

END FUNCTION ' mouseDownWithinBoxBounds
''''''''''''''''''''''''
FUNCTION mouseDown2WithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX2 >= wStartX AND mouse.DownPosX2 <= (wStartX + wSizeX - 1) AND mouse.DownPosY2 >= wStartY AND mouse.DownPosY2 <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDown2WithinBoxBounds = toRet

END FUNCTION ' mouseDown2WithinBoxBounds

''''''''''''''''''''''''
SUB mouseReadInput

  mouse.Released1 = 0
  mouse.Released2 = 0
  mouse.Clicked1 = 0
  mouse.Clicked2 = 0
  mouse.Wheel = 0

  DO WHILE _MOUSEINPUT

    rawMouseX = _MOUSEX
    rawMouseY = _MOUSEY

    ' Downscale the physical screen mouse inputs directly into the 640x360 logic layout
    mouse.PosX = (rawMouseX * SCREENSIZEX) \ physicalScreenX
    mouse.PosY = (rawMouseY * SCREENSIZEY) \ physicalScreenY

    IF mouse.PosX < 0 THEN mouse.PosX = 0
    IF mouse.PosY < 0 THEN mouse.PosY = 0
    IF mouse.PosX > SCREENSIZEX - 1 THEN mouse.PosX = SCREENSIZEX - 1
    IF mouse.PosY > SCREENSIZEY - 1 THEN mouse.PosY = SCREENSIZEY - 1

    mouse.Wheel = mouse.Wheel + _MOUSEWHEEL

    pollMouse1Button = _MOUSEBUTTON(1)
    IF pollMouse1Button <> mouse.Button1Down THEN
      IF pollMouse1Button THEN
        mouse.Clicked1 = 1
        mouse.DownPosX = mouse.PosX
        mouse.DownPosY = mouse.PosY
      ELSE
        mouse.Released1 = 1
      END IF
      mouse.Button1Down = pollMouse1Button
    END IF

    pollMouse2Button = _MOUSEBUTTON(2)
    IF pollMouse2Button <> mouse.Button2Down THEN
      IF pollMouse2Button THEN
        mouse.Clicked2 = 1
        mouse.DownPosX2 = mouse.PosX
        mouse.DownPosY2 = mouse.PosY
      ELSE
        mouse.Released2 = 1
      END IF
      mouse.Button2Down = pollMouse2Button
      EXIT SUB
    END IF

  LOOP

END SUB ' mouseReadInput

''''''''''''''''''''''''
FUNCTION mouseWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  ' We use a slightly more forgiving check to handle edge-of-screen jitter
  ' wSizeX and wSizeY are the dimensions, so the right edge is wStartX + wSizeX - 1

  toRet = 0

  ' Use <= to ensure the final pixel is included
  ' We also add a small safety margin if the click is at the absolute screen edge
  IF mouse.PosX >= wStartX AND mouse.PosX <= (wStartX + wSizeX - 1) AND mouse.PosY >= wStartY AND mouse.PosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseWithinBoxBounds = toRet

END FUNCTION ' mouseWithinBoxBounds

''''''''''''''''''''''''
SUB modalFileMenuNew

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 80
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 32, boxY + 3, "NEW FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - 132, boxY + 24, "ALL UNSAVED PROGRESS WILL BE LOST", 15, 0, 1

    btnYesW = 64
    btnYesH = 20
    btnYesX = boxX + (boxW \ 2) - btnYesW - 16
    btnYesY = boxY + 46

    btnNoW = 64
    btnNoH = 20
    btnNoX = boxX + (boxW \ 2) + 16
    btnNoY = boxY + 46

    drawBorderBox btnYesX, btnYesY, btnYesW, btnYesH, 15, 0
    PrintStr btnYesX + 20, btnYesY + 6, "YES", 15, 0, 1

    drawBorderBox btnNoX, btnNoY, btnNoW, btnNoH, 15, 0
    PrintStr btnNoX + 24, btnNoY + 6, "NO", 15, 0, 1

    dispScreenFlushUpdate

    doNewFile = 0

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        doNewFile = 1
      END IF
    END IF

    IF mouseClickedInBox(btnYesX, btnYesY, btnYesW, btnYesH) THEN
      doNewFile = 1
    END IF

    IF mouseClickedInBox(btnNoX, btnNoY, btnNoW, btnNoH) THEN
      EXIT DO
    END IF

    IF doNewFile = 1 THEN
      FOR ii = 1 TO EDITOR_LINE_MAX
        editorText$(ii) = ""
      NEXT
      editor.LastLine = 1
      editor.CursorX = 0
      editor.CursorY = 1
      editor.ScrollX = 0
      editor.ScrollY = 1
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.IsSelecting = 0
      undoState.Ready = 0
      lastActionWasTyping = 0
      fileNameBase$ = "DFLTNAME"
      editor.FileExtensionMode = FILE_EXT_BAS
      refineCode 0, 0
      addStatusMsg "NEW FILE CREATED"
      EXIT DO
    END IF

  LOOP

END SUB ' modalFileMenuNew

''''''''''''''''''''''''
SUB modalFileMenuOpen

  DIM fileList$(1000)
  DIM fileCount AS LONG

  _DEST logicalScreen

  fileCount = 0

  oldClip$ = _CLIPBOARD$
  _CLIPBOARD$ = ""
  SHELL _HIDE "cmd /c (dir /b /a-d *.bas *.blb *.txt 2>nul & echo [[[QBERRDONE]]]) | clip"

  tTime = TIMER
  DO
    limitSpeed
    cb$ = _CLIPBOARD$
    IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
    IF TIMER - tTime > 1.5 THEN EXIT DO
  LOOP

  _CLIPBOARD$ = oldClip$

  markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
  IF markerPos > 0 THEN
    cb$ = LEFT$(cb$, markerPos - 1)
  END IF

  ix = 1
  cbLen = LEN(cb$)
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cb$, CHR$(10))
    IF nextNl = 0 THEN
      fName$ = MID$(cb$, ix)
      ix = cbLen + 1
    ELSE
      fName$ = MID$(cb$, ix, nextNl - ix)
      ix = nextNl + 1
    END IF

    fName$ = LTRIM$(RTRIM$(fName$))
    IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

    IF fName$ <> "" THEN
      IF fileCount < 1000 THEN
        fileList$(fileCount) = fName$
        fileCount = fileCount + 1
      END IF
    END IF
  LOOP

  IF fileCount = 0 THEN
    addStatusMsg "NO SOURCE FILES FOUND"
    EXIT SUB
  END IF

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (9 * 4), boxY + 3, "OPEN FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    ' Scrollbar
    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO maxLines - 1
      fIdx = ii + editor.ModalScroll.ScrollY
      IF fIdx < fileCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = fileList$(fIdx)
        IF LEN(sOutName$) > 20 THEN sOutName$ = LEFT$(sOutName$, 20)

        ' Hover
        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            cleanName$ = fileList$(fIdx)
            dotPos = 0
            FOR iDot = LEN(cleanName$) TO 1 STEP -1
              IF MID$(cleanName$, iDot, 1) = "." THEN dotPos = iDot: EXIT FOR
            NEXT

            IF dotPos > 0 THEN
              extStr$ = UCASE$(MID$(cleanName$, dotPos))
              cleanName$ = LEFT$(cleanName$, dotPos - 1)
              IF extStr$ = ".TXT" THEN
                editor.FileExtensionMode = FILE_EXT_TXT
              ELSE
                IF extStr$ = ".BLB" THEN
                  editor.FileExtensionMode = FILE_EXT_BLB
                ELSE
                  editor.FileExtensionMode = FILE_EXT_BAS
                END IF
              END IF
            ELSE
              editor.FileExtensionMode = FILE_EXT_BAS
            END IF

            fileNameBase$ = cleanName$
            fileCodeLoad
            refineCode 0, 0

            editor.CursorY = 1
            editor.CursorX = 0
            editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = 1
            editor.IsSelecting = 0
            editor.Focus = 1

            curExt$ = ".BAS"
            IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
            IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

            addStatusMsg "LOADED " + fileNameBase$ + curExt$

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

  _DEST logicalScreen

END SUB ' modalFileMenuOpen

''''''''''''''''''''''''
SUB modalFileMenuSave

  saveAsName$ = fileNameBase$

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 28, boxY + 3, "SAVE AS", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, saveAsName$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF saveAsName$ <> "" THEN
          cleanName$ = saveAsName$
          dotPos = 0
          FOR iDot = LEN(cleanName$) TO 1 STEP -1
            IF MID$(cleanName$, iDot, 1) = "." THEN dotPos = iDot: EXIT FOR
          NEXT

          IF dotPos > 0 THEN
            extStr$ = UCASE$(MID$(cleanName$, dotPos))
            cleanName$ = LEFT$(cleanName$, dotPos - 1)
            IF extStr$ = ".TXT" THEN
              editor.FileExtensionMode = FILE_EXT_TXT
            ELSE
              IF extStr$ = ".BLB" THEN
                editor.FileExtensionMode = FILE_EXT_BLB
              ELSE
                editor.FileExtensionMode = FILE_EXT_BAS
              END IF
            END IF
          END IF

          fileNameBase$ = cleanName$

          curExt$ = ".BAS"
          IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
          IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

          fileCodeSave
          addStatusMsg "SAVED AS " + fileNameBase$ + curExt$
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(saveAsName$)
        IF qLen > 0 THEN
          saveAsName$ = LEFT$(saveAsName$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(saveAsName$) < 34 THEN
            saveAsName$ = saveAsName$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalFileMenuSave

''''''''''''''''''''''''
SUB modalGoToLine

  _KEYCLEAR

  goToStr$ = ""

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 160
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + 40, boxY + 3, "GO TO LINE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, goToStr$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF goToStr$ <> "" THEN
          targetLine = VAL(goToStr$)
          IF targetLine > 0 THEN
            IF targetLine > editor.LastLine THEN targetLine = editor.LastLine
            editor.CursorY = targetLine
            editor.CursorX = 0
            editor.ScrollY = targetLine - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = targetLine
            editor.IsSelecting = 0
            editor.Focus = 1
          END IF
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(goToStr$)
        IF qLen > 0 THEN
          goToStr$ = LEFT$(goToStr$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 48 AND kVal <= 57 THEN ' Numbers only
          IF LEN(goToStr$) < 6 THEN
            goToStr$ = goToStr$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalGoToLine

''''''''''''''''''''''''
SUB modalImportFileMenu

  DIM fileList$(1000)
  DIM fileCount AS LONG

  _DEST logicalScreen

  fileCount = 0

  oldClip$ = _CLIPBOARD$
  _CLIPBOARD$ = ""
  SHELL _HIDE "cmd /c (dir /b /a-d *.bas *.blb 2>nul & echo [[[QBERRDONE]]]) | clip"

  tTime = TIMER
  DO
    limitSpeed
    cb$ = _CLIPBOARD$
    IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
    IF TIMER - tTime > 1.5 THEN EXIT DO
  LOOP

  _CLIPBOARD$ = oldClip$

  markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
  IF markerPos > 0 THEN
    cb$ = LEFT$(cb$, markerPos - 1)
  END IF

  ix = 1
  cbLen = LEN(cb$)
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cb$, CHR$(10))
    IF nextNl = 0 THEN
      fName$ = MID$(cb$, ix)
      ix = cbLen + 1
    ELSE
      fName$ = MID$(cb$, ix, nextNl - ix)
      ix = nextNl + 1
    END IF

    fName$ = LTRIM$(RTRIM$(fName$))
    IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

    IF fName$ <> "" THEN
      IF fileCount < 1000 THEN
        fileList$(fileCount) = fName$
        fileCount = fileCount + 1
      END IF
    END IF
  LOOP

  IF fileCount = 0 THEN
    addStatusMsg "NO BAS OR BLB FILES FOUND"
    EXIT SUB
  END IF

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (11 * 4), boxY + 3, "IMPORT FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    ' Scrollbar
    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO maxLines - 1
      fIdx = ii + editor.ModalScroll.ScrollY
      IF fIdx < fileCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = fileList$(fIdx)
        IF LEN(sOutName$) > 20 THEN sOutName$ = LEFT$(sOutName$, 20)

        ' Hover
        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            undo_StateSave
            lastActionWasTyping = 0

            fileCodeImport fileList$(fIdx)
            refineCode 0, 0

            ' Jump view to the bottom where the imported code was injected
            editor.CursorY = editor.LastLine
            editor.CursorX = 0
            editor.ScrollY = editor.CursorY - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = editor.LastLine
            editor.IsSelecting = 0
            editor.Focus = 1

            addStatusMsg "IMPORTED " + fileList$(fIdx)

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

END SUB ' modalImportFileMenu

''''''''''''''''''''''''
SUB modalSearch

  ' Give the modal a clean slate to prevent double-triggering inputs
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 44, boxY + 3, "SEARCH FIND", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, editorSearchQuery$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF editorSearchQuery$ <> "" THEN
          findEditorNext
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(editorSearchQuery$)
        IF qLen > 0 THEN
          editorSearchQuery$ = LEFT$(editorSearchQuery$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(editorSearchQuery$) < 34 THEN
            editorSearchQuery$ = editorSearchQuery$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalSearch

''''''''''''''''''''''''
SUB modalViewSubs

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure the sub list is completely fresh
  refineCode 0, 0

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (15 * 4), boxY + 3, "SUBS / FUNCTIONS", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    ' Scrollbar
    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, uiSubCount, maxLines, 0

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = uiSubCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO maxLines - 1
      subIdx = ii + editor.ModalScroll.ScrollY
      IF subIdx < uiSubCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = uiSubName$(subIdx)

        ' Hover
        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            ' Update main UI funcScrollY to ensure right-hand list brings the sub into view
            IF subIdx < editor.FuncScroll.ScrollY OR subIdx >= editor.FuncScroll.ScrollY + 12 THEN
              editor.FuncScroll.ScrollY = subIdx - 5
              IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
              maxFuncScroll = uiSubCount - 12
              IF maxFuncScroll < 0 THEN maxFuncScroll = 0
              IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
              ' Redraw the right list so it reflects the new scroll position
              drawFuncListPMI
            END IF

            ' Flash the right-hand box list simultaneously
            funcListBoxX = RIGHT_BOX_X
            funcListBoxY = editor.StartY + 15
            funcListBoxW = 122
            rowY = funcListBoxY + 3 + ((subIdx - editor.FuncScroll.ScrollY + 1) * 10)
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 11, rowY + 9), 1, BF
            PrintStr funcListBoxX + RIGHT_BOX_SPACING, rowY + 1, LEFT$(uiSubName$(subIdx), 13), 15, 0, 1

            ' Flash the modal list
            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            ' Jump to sub and close window
            editor.CursorY = uiSubLine(subIdx)
            editor.CursorX = 0
            editor.ScrollY = editor.CursorY - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = 1
            editor.IsSelecting = 0
            editor.Focus = 1

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

END SUB ' modalViewSubs

''''''''''''''''''''''''
SUB overlayScaledTransparent (rsSourceImage, rsTargetImage, rsTransparentClr)

  DIM sourceImage AS LONG
  DIM targetImage AS LONG
  DIM transparentClr AS LONG
  DIM sourceWidth AS LONG
  DIM sourceHeight AS LONG
  DIM targetWidth AS LONG
  DIM targetHeight AS LONG
  DIM minX AS LONG
  DIM minY AS LONG
  DIM maxX AS LONG
  DIM maxY AS LONG
  DIM targetX1 AS LONG
  DIM targetY1 AS LONG
  DIM targetX2 AS LONG
  DIM targetY2 AS LONG
  DIM sampleX AS LONG
  DIM sampleY AS LONG
  DIM pixelClr AS LONG
  DIM foundPixel AS LONG

  sourceImage = rsSourceImage
  targetImage = rsTargetImage
  transparentClr = rsTransparentClr

  sourceWidth = _WIDTH(sourceImage)
  sourceHeight = _HEIGHT(sourceImage)
  targetWidth = _WIDTH(targetImage)
  targetHeight = _HEIGHT(targetImage)

  foundPixel = 0

  _SOURCE sourceImage

  FOR iy = 0 TO sourceHeight - 1
    FOR ix = 0 TO sourceWidth - 1

      pixelClr = POINT(ix, iy)

      IF pixelClr <> transparentClr THEN

        IF foundPixel = 0 THEN

          minX = ix
          minY = iy
          maxX = ix
          maxY = iy
          foundPixel = 1

        ELSE

          IF ix < minX THEN minX = ix
          IF iy < minY THEN minY = iy
          IF ix > maxX THEN maxX = ix
          IF iy > maxY THEN maxY = iy

        END IF

      END IF

    NEXT
  NEXT

  IF foundPixel = 0 THEN
    _SOURCE 0
    EXIT SUB
  END IF

  targetX1 = (minX * targetWidth) \ sourceWidth
  targetY1 = (minY * targetHeight) \ sourceHeight

  targetX2 = (((maxX + 1) * targetWidth) \ sourceWidth) - 1
  targetY2 = (((maxY + 1) * targetHeight) \ sourceHeight) - 1

  IF targetX1 < 0 THEN targetX1 = 0
  IF targetY1 < 0 THEN targetY1 = 0
  IF targetX2 >= targetWidth THEN targetX2 = targetWidth - 1
  IF targetY2 >= targetHeight THEN targetY2 = targetHeight - 1

  _DEST targetImage
  _SOURCE sourceImage

  FOR iy = targetY1 TO targetY2

    sampleY = (iy * sourceHeight) \ targetHeight

    IF sampleY < minY THEN sampleY = minY
    IF sampleY > maxY THEN sampleY = maxY

    FOR ix = targetX1 TO targetX2

      sampleX = (ix * sourceWidth) \ targetWidth

      IF sampleX < minX THEN sampleX = minX
      IF sampleX > maxX THEN sampleX = maxX

      pixelClr = POINT(sampleX, sampleY)

      IF pixelClr <> transparentClr THEN
        PSET (ix, iy), pixelClr
      END IF

    NEXT
  NEXT

  _SOURCE 0

END SUB ' overlayScaledTransparent

''''''''''''''''''''''''
SUB pasteClipboardText

  IF editor.IsSelecting = 1 THEN
    deleteSelection
    editor.IsSelecting = 0
  END IF

  cbText$ = _CLIPBOARD$
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  ' Pre-allocate a buffer to rapidly filter non-printable characters in a single O(N) pass
  cleanText$ = SPACE$(cbLen)
  cleanIdx = 1

  FOR ii = 1 TO cbLen
    cbAsc = ASC(cbText$, ii)
    ' Allow only newlines (10) and standard printable characters (32 to 126)
    IF cbAsc = 10 OR (cbAsc >= 32 AND cbAsc <= 126) THEN
      ASC(cleanText$, cleanIdx) = cbAsc
      cleanIdx = cleanIdx + 1
    END IF
  NEXT

  cbText$ = LEFT$(cleanText$, cleanIdx - 1)
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  ' Count newlines to determine the exact array shift distance
  nlCount = 0
  ix = 1
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cbText$, CHR$(10))
    IF nextNl > 0 THEN
      nlCount = nlCount + 1
      ix = nextNl + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Shift array down exactly once in bulk
  IF nlCount > 0 THEN
    FOR iy = editor.LastLine TO editor.CursorY + 1 STEP -1
      IF iy + nlCount <= EDITOR_LINE_MAX THEN
        editorText$(iy + nlCount) = editorText$(iy)
      END IF
    NEXT

    editor.LastLine = editor.LastLine + nlCount
    IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  END IF

  currentLine$ = editorText$(editor.CursorY)
  leftPart$ = LEFT$(currentLine$, editor.CursorX)
  rightPart$ = MID$(currentLine$, editor.CursorX + 1)

  ix = 1
  curPasteY = editor.CursorY
  linesPasted = 0

  ' Process the filtered clipboard and inject directly into the opened array spaces
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cbText$, CHR$(10))
    IF nextNl = 0 THEN
      ' Final chunk of text (no trailing newline)
      chunk$ = MID$(cbText$, ix)
      IF curPasteY <= EDITOR_LINE_MAX THEN
        IF linesPasted = 0 THEN
          editorText$(curPasteY) = leftPart$ + chunk$ + rightPart$
          editor.CursorX = LEN(leftPart$ + chunk$)
        ELSE
          editorText$(curPasteY) = chunk$ + rightPart$
          editor.CursorX = LEN(chunk$)
        END IF
      END IF
      EXIT DO
    ELSE
      ' Extract line up to the newline
      chunk$ = MID$(cbText$, ix, nextNl - ix)
      IF curPasteY <= EDITOR_LINE_MAX THEN
        IF linesPasted = 0 THEN
          editorText$(curPasteY) = leftPart$ + chunk$
        ELSE
          editorText$(curPasteY) = chunk$
        END IF
      END IF

      linesPasted = linesPasted + 1
      curPasteY = curPasteY + 1
      ix = nextNl + 1
    END IF
  LOOP

  ' Handle edge case where clipboard ends exactly on a newline
  IF RIGHT$(cbText$, 1) = CHR$(10) THEN
    IF curPasteY <= EDITOR_LINE_MAX THEN
      editorText$(curPasteY) = rightPart$
      editor.CursorX = 0
    END IF
  END IF

  editor.CursorY = curPasteY
  IF editor.CursorY > EDITOR_LINE_MAX THEN
    editor.CursorY = EDITOR_LINE_MAX
    editor.CursorX = LEN(editorText$(EDITOR_LINE_MAX))
  END IF

  ' Update view scrolling
  IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
  IF editor.CursorY >= editor.ScrollY + 29 THEN editor.ScrollY = editor.CursorY - 28
  IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
  IF editor.CursorX >= editor.ScrollX + 56 THEN editor.ScrollX = editor.CursorX - 55

END SUB ' pasteClipboardText

''''''''''''''''''''''''
SUB PrintTextLineWithBanners (text$, wClr, whereY)

  paddingPixels = 8

  textStartX = 9

  SELECT CASE whereY

    CASE TOP: textStartY = 4
    CASE MIDDLE: textStartY = 20
    CASE BOTTOM: textStartY = 30

  END SELECT ' whereY

  textPixelWidth = LEN(text$) * 8
  boxPixelWidth = paddingPixels + textPixelWidth + paddingPixels
  boxPixelHeight = paddingPixels + 8 + paddingPixels

  boxStartX = (textStartX * 8) - paddingPixels
  boxStartY = (textStartY * 8) - paddingPixels

  IF (boxStartX + boxPixelWidth) >= SCREENSIZEX THEN
    boxStartX = SCREENSIZEX - boxPixelWidth
  END IF

  textStartX = (boxStartX + paddingPixels) \ 8

  IF (textStartX * 8) + textPixelWidth >= SCREENSIZEX THEN textStartX = 1

  boxStartX = (textStartX * 8) - paddingPixels

  drawBorderBox boxStartX, boxStartY, boxPixelWidth, boxPixelHeight, 1, 0
  drawClearBox boxStartX + 1, boxStartY + 1, boxPixelWidth - 2, boxPixelHeight - 2, 15

  PrintStr boxStartX + paddingPixels, boxStartY + paddingPixels, text$, wClr, 0, 0

END SUB ' PrintTextLineWithBanners

''''''''''''''''''''''''
FUNCTION processDropdownMenu (wPosX, wPosY, wItemCount, passItems$())

  returnExtraPrepare

  DIM itemH AS LONG
  itemH = 14

  maxWidth = 0
  FOR ii = 0 TO wItemCount - 1
    wLen = LEN(passItems$(ii)) * 8
    IF LEFT$(passItems$(ii), 1) = "~" THEN wLen = wLen - 8
    IF wLen > maxWidth THEN maxWidth = wLen
  NEXT
  boxW = maxWidth + 16
  boxH = (wItemCount * itemH) + 4

  drawBorderBox wPosX, wPosY, boxW, boxH, 15, editor.windowBarClr

  itemSelected = 0
  clickedItem = 0

  FOR ii = 0 TO wItemCount - 1
    itemY = wPosY + 2 + (ii * itemH)
    dStr$ = passItems$(ii)
    isDisabled = 0
    IF LEFT$(dStr$, 1) = "~" THEN
      isDisabled = 1
      dStr$ = MID$(dStr$, 2)
    END IF

    IF isDisabled = 0 THEN
      IF mouseWithinBoxBounds(wPosX + 2, itemY, boxW - 4, itemH) THEN
        drawClearBox wPosX + 2, itemY, boxW - 4, itemH, 9
        IF mouseClickedInBox(wPosX + 2, itemY, boxW - 4, itemH) THEN
          clickedItem = ii
          itemSelected = 1
        END IF
      END IF
      PrintStr wPosX + 8, itemY + 3, dStr$, 15, 0, 1
    ELSE
      PrintStr wPosX + 8, itemY + 3, dStr$, sysColor.gray, 0, 1
    END IF
  NEXT

  IF mouseClickedInBox(wPosX, wPosY, boxW, boxH) THEN
    editor.MenuClicked = 1
  END IF

  IF itemSelected = 1 THEN
    return2 clickedItem
    processDropdownMenu = 1
    EXIT FUNCTION
  END IF

  return2 0
  processDropdownMenu = 0

END FUNCTION ' processDropdownMenu

''''''''''''''''''''''''
SUB processInput

  IF keyCheck("ESC") THEN
    IF editor.MenuMode = 1 OR editor.MenuMode = 2 THEN
      editor.MenuMode = 0
      waitKeyRelease "ESC"
    ELSE
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        waitKeyRelease "ESC"
        confirmExit
      END IF
    END IF
  END IF

  IF keyCheck("F5") THEN
    IF compileState = COMP_IDLE THEN
      hasCode = 0
      IF editor.LastLine > 1 THEN
        hasCode = 1
      ELSE
        IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
      END IF

      IF hasCode = 1 THEN
        compileState = COMP_REFINE
        addStatusMsg "REFINING..."
        redrawAll
        dispScreenFlushUpdate

        statusMsgCount = 1
        editor.StatusScrollY = 1
        editor.StatusSelectedIndex = 0
        FOR ii = 1 TO 999
          statusMsg(ii).Text = ""
          statusMsg(ii).CodeLine = 0
        NEXT

        wFln$ = fileNameBase$ + ".exe"
        IF _FILEEXISTS(wFln$) THEN
          delCmd$ = "cmd /c del /F /Q " + CHR$(34) + wFln$ + CHR$(34)
          SHELL _HIDE delCmd$

          IF _FILEEXISTS(wFln$) THEN
            addStatusMsg "OUTPUT FILE IN USE, PAUSING"
            redrawAll
            dispScreenFlushUpdate
            waitTimer 1.5
          END IF
        END IF

        waitKeyRelease "F5"
      END IF
    END IF
  END IF

  IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) AND keyCheck("F") THEN
    waitKeyRelease "F"
    modalSearch
  END IF

  IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) AND keyCheck("S") THEN
    waitKeyRelease "S"
    _KEYCLEAR

    hasCode = 0
    IF editor.LastLine > 1 THEN
      hasCode = 1
    ELSE
      IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
    END IF

    IF hasCode = 1 THEN
      editor.Focus = 1
      curExt$ = ".BAS"
      IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
      IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

      addStatusMsg "SAVING " + fileNameBase$ + curExt$ + "..."
      redrawAll
      dispScreenFlushUpdate

      fileCodeSave

      addStatusMsg "SAVED " + fileNameBase$ + curExt$
    END IF
  END IF

  IF keyCheck("F3") THEN
    waitKeyRelease "F3"
    IF editorSearchQuery$ <> "" THEN
      findEditorNext
    ELSE
      modalSearch
    END IF
  END IF

  kVal = _KEYHIT
  IF kVal = 0 THEN EXIT SUB

  IF editor.Focus = 2 THEN
    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut) - Treat as copy for status bar
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF
  END IF

  IF editor.Focus = 1 THEN

    lastLine = editor.LastLine
    IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

    oldCursorY = editor.CursorY

    ' Ctrl+Z (Undo)
    IF kVal = 26 OR ((kVal = 122 OR kVal = 90) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      undo_StateRestore
      kVal = 0
      lastActionWasTyping = 0
    END IF

    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut)
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        undo_StateSave
        lastActionWasTyping = 0
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
        deleteSelection
        editor.IsSelecting = 0
      END IF
      kVal = 0
    END IF

    ' Ctrl+A (Select All)
    IF kVal = 1 OR ((kVal = 97 OR kVal = 65) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.CursorY = editor.LastLine
      editor.CursorX = LEN(editorText$(editor.LastLine))
      editor.IsSelecting = 1
      kVal = 0
    END IF

    isMoveKey = 0
    IF kVal = 19200 OR kVal = 19712 OR kVal = 18432 OR kVal = 20480 OR kVal = 18176 OR kVal = 20224 OR kVal = 18688 OR kVal = 20736 THEN isMoveKey = 1

    IF isMoveKey = 1 THEN
      lastActionWasTyping = 0
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        IF editor.IsSelecting = 0 THEN
          editor.SelectStartX = editor.CursorX
          editor.SelectStartY = editor.CursorY
          editor.IsSelecting = 1
        END IF
      ELSE
        editor.IsSelecting = 0
      END IF
    END IF

    IF (kVal >= 32 AND kVal <= 126) OR kVal = 8 OR kVal = 212231 OR kVal = 21248 OR kVal = 13 OR kVal = 118 THEN
      IF isMoveKey = 0 AND kVal <> 0 THEN
        IF editor.IsSelecting = 1 THEN
          undo_StateSave
          IF (kVal >= 32 AND kVal <= 126) THEN
            lastActionWasTyping = 1
          ELSE
            lastActionWasTyping = 0
          END IF

          IF kVal = 8 OR kVal = 212231 OR kVal = 21248 THEN
            deleteSelection
            editor.IsSelecting = 0
            kVal = 0 ' Consume key to prevent normal backspace/delete
          ELSE
            IF (kVal >= 32 AND kVal <= 126) OR kVal = 13 THEN
              deleteSelection
              editor.IsSelecting = 0
            ELSE
              editor.IsSelecting = 0
            END IF
          END IF
        END IF
      END IF
    END IF

    IF kVal = 118 AND (_KEYDOWN(100306) OR _KEYDOWN(100305)) THEN ' Ctrl+V (Paste)
      IF editor.IsSelecting = 0 THEN undo_StateSave
      lastActionWasTyping = 0
      pasteClipboardText
      kVal = 0
    END IF

    ' Consume any remaining key presses if CTRL is held to prevent unmapped shortcut characters from dropping into the editor
    IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) THEN
      IF kVal >= 32 AND kVal <= 126 THEN
        kVal = 0
      END IF
    END IF

    IF kVal >= 32 AND kVal <= 126 THEN ' Printable character
      IF lastActionWasTyping = 0 THEN undo_StateSave
      lastActionWasTyping = 1
      currentLine$ = editorText$(editor.CursorY)
      leftPart$ = LEFT$(currentLine$, editor.CursorX)
      rightPart$ = MID$(currentLine$, editor.CursorX + 1)
      editorText$(editor.CursorY) = leftPart$ + CHR$(kVal) + rightPart$
      editor.CursorX = editor.CursorX + 1
    END IF

    IF kVal = 8 THEN ' Backspace
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorX > 0 THEN ' Delete character to the left
        currentLine$ = editorText$(editor.CursorY)
        leftPart$ = LEFT$(currentLine$, editor.CursorX - 1)
        rightPart$ = MID$(currentLine$, editor.CursorX + 1)
        editorText$(editor.CursorY) = leftPart$ + rightPart$
        editor.CursorX = editor.CursorX - 1
      ELSE
        IF editor.CursorY > 1 THEN ' Merge with previous line
          prevLineLen = LEN(editorText$(editor.CursorY - 1))
          editor.CursorX = prevLineLen
          editorText$(editor.CursorY - 1) = editorText$(editor.CursorY - 1) + editorText$(editor.CursorY)
          FOR ii = editor.CursorY TO editor.LastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.LastLine) = ""
          editor.CursorY = editor.CursorY - 1
          editor.LastLine = editor.LastLine - 1
          IF editor.LastLine < 1 THEN editor.LastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 212231 OR kVal = 21248 THEN ' Delete key
      undo_StateSave
      lastActionWasTyping = 0
      currentLine$ = editorText$(editor.CursorY)
      IF editor.CursorX < LEN(currentLine$) THEN ' Delete character to the right
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 2)
        editorText$(editor.CursorY) = leftPart$ + rightPart$
      ELSE
        IF editor.CursorY < lastLine THEN ' Merge next line into current
          editorText$(editor.CursorY) = currentLine$ + editorText$(editor.CursorY + 1)
          FOR ii = editor.CursorY + 1 TO editor.LastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.LastLine) = ""
          editor.LastLine = editor.LastLine - 1
          IF editor.LastLine < 1 THEN editor.LastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 13 THEN ' Enter key, split line at cursor
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorY < EDITOR_LINE_MAX THEN
        currentLine$ = editorText$(editor.CursorY)
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 1)
        editorText$(editor.CursorY) = leftPart$
        FOR ii = editor.LastLine TO editor.CursorY + 1 STEP -1
          IF ii < EDITOR_LINE_MAX THEN
            editorText$(ii + 1) = editorText$(ii)
          END IF
        NEXT
        editorText$(editor.CursorY + 1) = rightPart$
        editor.CursorY = editor.CursorY + 1
        editor.CursorX = 0
        editor.LastLine = editor.LastLine + 1
        IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
        refineCode editor.CursorY - 1, 0
      END IF
    END IF

    IF kVal = 19200 THEN ' Left arrow
      IF editor.CursorX > 0 THEN
        editor.CursorX = editor.CursorX - 1
      ELSE
        IF editor.CursorY > 1 THEN ' Wrap to end of previous line
          editor.CursorY = editor.CursorY - 1
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 19712 THEN ' Right arrow
      IF editor.CursorX < LEN(editorText$(editor.CursorY)) THEN
        editor.CursorX = editor.CursorX + 1
      ELSE
        IF editor.CursorY < lastLine THEN ' Wrap to start of next line
          editor.CursorY = editor.CursorY + 1
          editor.CursorX = 0
        END IF
      END IF
    END IF

    IF kVal = 18432 THEN ' Up arrow
      IF editor.CursorY > 1 THEN
        editor.CursorY = editor.CursorY - 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 20480 THEN ' Down arrow
      IF editor.CursorY < lastLine THEN
        editor.CursorY = editor.CursorY + 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 18176 THEN ' Home key, go to start of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = 1
        editor.CursorX = 0
        editor.ScrollY = 1
        editor.ScrollX = 0
      ELSE
        editor.CursorX = 0
      END IF
    END IF

    IF kVal = 20224 THEN ' End key, go to end of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = lastLine
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = lastLine - 28
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF kVal = 18688 THEN ' Page up
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        targetY = 1
        IF uiSubCount > 0 THEN
          FOR ii = uiSubCount - 1 TO 0 STEP -1
            startLine = uiSubLine(ii)
            IF startLine + 1 < editor.CursorY THEN
              targetY = startLine + 1
              IF targetY > lastLine THEN targetY = lastLine
              EXIT FOR
            END IF
          NEXT
        END IF
        editor.CursorY = targetY
        editor.CursorX = 0
        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY - 29
        IF editor.CursorY < 1 THEN editor.CursorY = 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF kVal = 20736 THEN ' Page down
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        targetY = lastLine
        FOR ii = editor.CursorY + 1 TO lastLine
          uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(ii))))
          IF LEFT$(uTemp$, 8) = "END SUB" THEN
            targetY = ii
            EXIT FOR
          END IF
          IF LEFT$(uTemp$, 12) = "END FUNCTION" THEN
            targetY = ii
            EXIT FOR
          END IF
        NEXT
        editor.CursorY = targetY
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY + 29
        IF editor.CursorY > lastLine THEN editor.CursorY = lastLine
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
    IF editor.CursorY >= editor.ScrollY + 29 THEN editor.ScrollY = editor.CursorY - 28

    IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
    IF editor.CursorX >= editor.ScrollX + 56 THEN editor.ScrollX = editor.CursorX - 55

    IF oldCursorY <> editor.CursorY THEN refineCode oldCursorY, 0

  END IF

END SUB ' processInput
''''''''''''''''''''''''
''''''''''''''''''''''''
SUB processVScrollbar (wScrollID AS LONG, wPosX AS LONG, wPosY AS LONG, wSizeX AS LONG, wSizeY AS LONG, wTotalItems AS LONG, wMaxVis AS LONG, wIs1Based AS LONG)

  DIM passCurScroll AS LONG
  DIM passDragActive AS LONG
  DIM passDragOffset AS LONG

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      passCurScroll = editor.ScrollY
      passDragActive = editor.ScrollDragActive
      passDragOffset = editor.ScrollDragOffsetY
    CASE SCROLL_STATUS
      passCurScroll = editor.StatusScrollY
      passDragActive = editor.StatusScrollDragActive
      passDragOffset = editor.StatusScrollDragOffsetY
    CASE SCROLL_FUNC
      passCurScroll = editor.FuncScroll.ScrollY
      passDragActive = editor.FuncScroll.DragActive
      passDragOffset = editor.FuncScroll.DragOffset
    CASE SCROLL_MODAL
      passCurScroll = editor.ModalScroll.ScrollY
      passDragActive = editor.ModalScroll.DragActive
      passDragOffset = editor.ModalScroll.DragOffset

  END SELECT ' wScrollID

  drawBorderBox wPosX, wPosY, wSizeX, wSizeY, 15, 0

  drawBorderBox wPosX, wPosY, wSizeX, 11, 15, 0
  drawBorderBox wPosX, wPosY + wSizeY - 11, wSizeX, 11, 15, 0

  charX = wPosX + (wSizeX \ 2) - 4
  PrintChr charX, wPosY + 2, CHR$(24), 15, 0, 1
  PrintChr charX, wPosY + wSizeY - 9, CHR$(25), 15, 0, 1

  minScroll = 0
  IF wIs1Based = 1 THEN minScroll = 1

  scrollRange = wTotalItems - wMaxVis
  IF scrollRange < 0 THEN scrollRange = 0

  maxScroll = scrollRange + minScroll

  thumbMaxH = wSizeY - 22
  IF wTotalItems > wMaxVis THEN
    thumbSize = (wMaxVis * thumbMaxH) \ wTotalItems
    IF thumbSize < 10 THEN thumbSize = 10
    IF scrollRange > 0 THEN
      thumbY = wPosY + 11 + (((passCurScroll - minScroll) * (thumbMaxH - thumbSize)) \ scrollRange)
    ELSE
      thumbY = wPosY + 11
    END IF
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 2, 15
  ELSE
    thumbSize = thumbMaxH
    thumbY = wPosY + 11
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 2, 15
  END IF

  ' Mouse Logic
  IF mouse.Clicked1 THEN
    IF wTotalItems > wMaxVis THEN
      IF mouseWithinBoxBounds(wPosX, thumbY, wSizeX, thumbSize) THEN
        passDragActive = 1
        passDragOffset = mouse.PosY - thumbY
      ELSE
        IF mouseWithinBoxBounds(wPosX, wPosY + 11, wSizeX, thumbMaxH) THEN
          IF mouse.PosY < thumbY THEN
            passCurScroll = passCurScroll - wMaxVis
            IF passCurScroll < minScroll THEN passCurScroll = minScroll
          ELSE
            passCurScroll = passCurScroll + wMaxVis
            IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
          END IF
        END IF
      END IF
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY, wSizeX, 11) THEN
      passCurScroll = passCurScroll - 1
      IF passCurScroll < minScroll THEN passCurScroll = minScroll
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY + wSizeY - 11, wSizeX, 11) THEN
      passCurScroll = passCurScroll + 1
      IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
    END IF
  END IF

  IF mouse.Button1Down AND passDragActive = 1 THEN
    IF wTotalItems > wMaxVis THEN
      newThumbY = mouse.PosY - passDragOffset
      trackSize = thumbMaxH - thumbSize
      IF trackSize > 0 THEN
        newScroll = minScroll + (((newThumbY - (wPosY + 11)) * scrollRange) \ trackSize)
        IF newScroll < minScroll THEN newScroll = minScroll
        IF newScroll > maxScroll THEN newScroll = maxScroll
        passCurScroll = newScroll
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    passDragActive = 0
  END IF

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      editor.ScrollY = passCurScroll
      editor.ScrollDragActive = passDragActive
      editor.ScrollDragOffsetY = passDragOffset
    CASE SCROLL_STATUS
      editor.StatusScrollY = passCurScroll
      editor.StatusScrollDragActive = passDragActive
      editor.StatusScrollDragOffsetY = passDragOffset
    CASE SCROLL_FUNC
      editor.FuncScroll.ScrollY = passCurScroll
      editor.FuncScroll.DragActive = passDragActive
      editor.FuncScroll.DragOffset = passDragOffset
    CASE SCROLL_MODAL
      editor.ModalScroll.ScrollY = passCurScroll
      editor.ModalScroll.DragActive = passDragActive
      editor.ModalScroll.DragOffset = passDragOffset

  END SELECT ' wScrollID

END SUB ' processVScrollbar

''''''''''''''''''''''''
SUB pushStatusMsg (wStr$, wLineNum AS LONG, wGroupID AS _UNSIGNED LONG)

  IF statusMsgCount < MAX_STATUS_MSGS THEN
    statusMsg(statusMsgCount).Text = wStr$
    statusMsg(statusMsgCount).CodeLine = wLineNum
    statusMsg(statusMsgCount).GroupID = wGroupID
    statusMsgCount = statusMsgCount + 1
  ELSE
    FOR ii = 1 TO 998
      statusMsg(ii).Text = statusMsg(ii + 1).Text
      statusMsg(ii).CodeLine = statusMsg(ii + 1).CodeLine
      statusMsg(ii).GroupID = statusMsg(ii + 1).GroupID
    NEXT
    statusMsg(999).Text = wStr$
    statusMsg(999).CodeLine = wLineNum
    statusMsg(999).GroupID = wGroupID
  END IF

  statusBoxH = 38
  maxLines = (statusBoxH - 5) \ 11
  IF (statusMsgCount - 1) > maxLines THEN
    editor.StatusScrollY = statusMsgCount - maxLines
  ELSE
    editor.StatusScrollY = 1
  END IF

END SUB ' pushStatusMsg

''''''''''''''''''''''''
SUB redrawAll

  CLS
  COLOR 15

  editor.MenuClicked = 0

  drawEditorPMI
  drawStatusPMI
  drawButtonsPMI
  drawTopMenuAndScrollPMI
  drawFuncListPMI
  drawCornerPMI

  ' Add the Show Desktop / Minimize All button to the bottom right corner
  minAllW = 12
  minAllH = 12
  minAllX = SCREENSIZEX - 12
  minAllY = SCREENSIZEY - 12

  drawBorderBox minAllX, minAllY, minAllW, minAllH, 15, editor.windowBarClr

  ' Hover effect
  IF mouseWithinBoxBounds(minAllX, minAllY, minAllW, minAllH) THEN
    drawClearBox minAllX + 1, minAllY + 1, minAllW - 2, minAllH - 2, 9
  END IF

  ' Use the letter v to mimic a down arrow
  PrintStr minAllX + 3, minAllY + 2, "v", 15, 0, 1

  ' Handle click
  IF mouseClickedInBox(minAllX, minAllY, minAllW, minAllH) THEN
    editor.MenuClicked = 1
    SHELL _HIDE "explorer.exe shell:::{3080F90D-D7AD-11D9-BD98-0000947B0257}"
  END IF

  IF mouse.Released1 THEN
    IF editor.MenuClicked = 0 THEN
      editor.TopMenuFocus = 0
    END IF
  END IF

  ' Print text cursor and mouse position information at the lower right
  showCursorData SCREENSIZEX - 72, SCREENSIZEY - 48

END SUB ' redrawAll

''''''''''''''''''''''''
SUB refineCode (targetLine AS LONG, isCompileClick AS LONG)

  DIM refName$(MAX_SYMBOLS)
  DIM refScope(MAX_SYMBOLS) AS LONG
  DIM activeScope AS LONG

  ' String Tracking State for Enforcing/Stripping '$' Suffix in Standard Mode
  DIM strDeclName$(MAX_STRING_DECLS)
  DIM strDeclScope(MAX_STRING_DECLS) AS LONG
  DIM strDeclType(MAX_STRING_DECLS) AS LONG ' 0 = Suspended, 1 = Requires $ (Dynamic/Fixed with $), 2 = Requires NO $ (Fixed without $)

  DIM isStrFound AS LONG
  DIM foundStrIdx AS LONG
  DIM isVarFound AS LONG
  DIM foundVarIdx AS LONG
  DIM hasPendingStr AS LONG

  DIM isDirStart AS LONG
  DIM newRawString AS STRING
  DIM newLen AS LONG
  DIM tempPart$
  DIM tempPartLen AS LONG

  DIM builtLine$
  DIM trimmedLine$
  DIM uTrimmed$
  DIM leadingSpaces AS LONG
  DIM sIdx AS LONG

  newRawString = SPACE$(16384)

  strDeclCount = 0
  refCount = 0

  IF targetLine = 0 THEN
    startLine = 1
    endLine = editor.LastLine
    uiSubCount = 0
    activeScope = 0
    scopeCounter = 0
    scanGlobalDirectives 0
  ELSE
    startLine = targetLine
    endLine = targetLine

    ' Fast-scan upward to establish the correct scope context for the dirty line
    activeScope = 0
    scopeCounter = 0
    FOR iy = 1 TO startLine - 1
      uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
      IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
      IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
        activeScope = 0
      END IF
    NEXT
  END IF

  IF compileEmeraldMode = 1 THEN
    sysColor.focusBorder = 10
  ELSE
    sysColor.focusBorder = 9
  END IF


  FOR iy = startLine TO endLine
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    curLine$ = editorText$(iy)
    tempLine$ = LTRIM$(RTRIM$(curLine$))

    uTemp$ = UCASE$(tempLine$)
    IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
      IF targetLine = 0 THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      ELSE
        ' Make sure activeScope registers if the user specifically edited the SUB definition line itself
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
    END IF

    IF LEN(tempLine$) > 0 THEN
      newLen = 0
      ix = 1
      lineLen = LEN(curLine$)
      hasNonSpace = 0
      lastKwVal = 0

      ' State Machine per line for detecting AS DSTRING and AS STRING *
      asMode = 0
      lastVarBase$ = ""
      lastVarSuffix$ = ""
      pendingStrIdx = 0
      hasPendingStr = 0
      parenDepth = 0

      isValidLine = 0
      IF INSTR(curLine$, "=") > 0 THEN isValidLine = 1
      firstIdent$ = ""

      FOR i_scan = 1 TO lineLen
        cAs = ASC(curLine$, i_scan)
        isDirScan = 0

        IF cAs = 35 OR cAs = 36 THEN ' # or $
          IF i_scan < lineLen THEN
            nAs = ASC(curLine$, i_scan + 1)
            IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirScan = 1
          END IF
        END IF

        IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirScan = 1 THEN
          tStart = i_scan
          FOR j_scan = i_scan TO lineLen
            c2As = ASC(curLine$, j_scan)
            IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (j_scan = i_scan AND (c2As = 35 OR c2As = 36)) THEN
              ' Continue scanning
            ELSE
              EXIT FOR
            END IF
          NEXT
          firstIdent$ = MID$(curLine$, tStart, j_scan - tStart)
          EXIT FOR
        END IF
      NEXT

      IF firstIdent$ <> "" THEN
        uFirst$ = UCASE$(firstIdent$)

        uIdentSearch$ = uFirst$
        IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
        IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
        IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
        IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
        IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
        IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
        IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
        IF uIdentSearch$ = "_DSTRING" THEN uIdentSearch$ = "DSTRING"
        IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
        IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

        ff = findKeywordIndex(uIdentSearch$)
        IF ff = 1 THEN isValidLine = 1
      END IF

      DO WHILE ix <= lineLen
        cAs = ASC(curLine$, ix)

        IF cAs = 32 OR cAs = 9 THEN
          IF hasNonSpace = 0 THEN
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = cAs
            ix = ix + 1
          ELSE
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = 32
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              IF c2As = 32 OR c2As = 9 THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP
          END IF
        ELSE
          hasNonSpace = 1

          IF cAs = 39 THEN ' '
            tempPart$ = MID$(curLine$, ix)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              MID$(newRawString, newLen + 1, tempPartLen) = tempPart$
              newLen = newLen + tempPartLen
            END IF
            EXIT DO
          END IF

          IF cAs = 34 THEN ' "
            tStart = ix
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              ix = ix + 1
              IF c2As = 34 THEN EXIT DO
            LOOP
            tempPart$ = MID$(curLine$, tStart, ix - tStart)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              MID$(newRawString, newLen + 1, tempPartLen) = tempPart$
              newLen = newLen + tempPartLen
            END IF
            lastKwVal = 0
          ELSE
            isDirStart = 0
            IF cAs = 35 OR cAs = 36 THEN ' # or $
              IF ix < lineLen THEN
                nAs = ASC(curLine$, ix + 1)
                IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirStart = 1
              END IF
            END IF

            IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirStart = 1 THEN
              tStart = ix
              DO WHILE ix <= lineLen
                c2As = ASC(curLine$, ix)
                IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (ix = tStart AND (c2As = 35 OR c2As = 36)) THEN
                  ix = ix + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              ident$ = MID$(curLine$, tStart, ix - tStart)
              suffixCh$ = ""

              IF ix <= lineLen THEN
                c2As = ASC(curLine$, ix)
                IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 38 OR c2As = 37 THEN
                  suffixCh$ = CHR$(c2As)
                  ident$ = ident$ + suffixCh$
                  ix = ix + 1
                END IF
              END IF

              ' Lookahead specifically for AS DSTRING to aggressively append the suffix
              IF compileEmeraldMode = 0 AND suffixCh$ = "" AND parenDepth = 0 THEN
                lookIx = ix
                lookPDepth = 0
                DO WHILE lookIx <= lineLen
                  lAs = ASC(curLine$, lookIx)
                  IF lAs = 40 THEN lookPDepth = lookPDepth + 1
                  IF lAs = 41 THEN lookPDepth = lookPDepth - 1
                  IF lookPDepth = 0 AND lAs <> 41 AND lAs <> 40 AND lAs <> 32 AND lAs <> 9 THEN EXIT DO
                  lookIx = lookIx + 1
                LOOP
                IF UCASE$(MID$(curLine$, lookIx, 2)) = "AS" THEN
                  lookIx = lookIx + 2
                  IF lookIx <= lineLen THEN
                    lAs = ASC(curLine$, lookIx)
                    IF lAs = 32 OR lAs = 9 THEN
                      DO WHILE lookIx <= lineLen
                        lAs = ASC(curLine$, lookIx)
                        IF lAs = 32 OR lAs = 9 THEN lookIx = lookIx + 1 ELSE EXIT DO
                      LOOP
                      IF UCASE$(MID$(curLine$, lookIx, 7)) = "DSTRING" THEN
                        IF lookIx + 7 <= lineLen THEN
                          lAsNext = ASC(curLine$, lookIx + 7)
                        ELSE
                          lAsNext = 0
                        END IF
                        IF NOT ((lAsNext >= 65 AND lAsNext <= 90) OR (lAsNext >= 97 AND lAsNext <= 122) OR (lAsNext >= 48 AND lAsNext <= 57) OR lAsNext = 95) THEN
                          ident$ = ident$ + "$"
                          suffixCh$ = "$"
                        END IF
                      END IF
                    END IF
                  END IF
                END IF
              END IF

              uIdent$ = UCASE$(ident$)

              uIdentSearch$ = uIdent$
              IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
              IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
              IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
              IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
              IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
              IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
              IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
              IF uIdentSearch$ = "_DSTRING" THEN uIdentSearch$ = "DSTRING"
              IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
              IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

              ff = findKeywordIndex(uIdentSearch$)
              IF ff = 1 THEN
                isKey = 1
                kwVal = returnedData2
              ELSE
                isKey = 0
                kwVal = 0
              END IF

              IF isKey = 1 THEN
                tempPartLen = LEN(uIdent$)
                IF tempPartLen > 0 THEN
                  IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                  MID$(newRawString, newLen + 1, tempPartLen) = uIdent$
                  newLen = newLen + tempPartLen
                END IF
                lastKwVal = kwVal

                ' AS STRING / AS DSTRING detection state machine
                SELECT CASE kwVal

                  CASE TOK_AS
                    asMode = 1
                    IF lastVarBase$ <> "" THEN
                      isStrFound = 0
                      foundStrIdx = 0
                      FOR iStr = 0 TO strDeclCount - 1
                        IF strDeclName$(iStr) = lastVarBase$ AND strDeclScope(iStr) = activeScope THEN
                          foundStrIdx = iStr
                          isStrFound = 1
                          EXIT FOR
                        END IF
                      NEXT
                      IF isStrFound = 0 AND strDeclCount < MAX_STRING_DECLS THEN
                        foundStrIdx = strDeclCount
                        strDeclName$(foundStrIdx) = lastVarBase$
                        strDeclScope(foundStrIdx) = activeScope
                        strDeclCount = strDeclCount + 1
                        isStrFound = 1
                      END IF
                      IF isStrFound = 1 THEN
                        strDeclType(foundStrIdx) = 0 ' Suspend initially
                        pendingStrIdx = foundStrIdx
                        hasPendingStr = 1
                      END IF
                    END IF

                  CASE TOK_DSTRING
                    IF asMode = 1 THEN
                      asMode = 0
                      IF hasPendingStr = 1 THEN
                        strDeclType(pendingStrIdx) = 1 ' DSTRING forces $
                        hasPendingStr = 0
                      END IF
                    ELSE
                      asMode = 0
                      hasPendingStr = 0
                    END IF

                  CASE TOK_STRING
                    IF asMode = 1 THEN
                      IF compileStringStrict = 1 THEN
                        asMode = 3 ' Waiting for *
                      ELSE
                        asMode = 5 ' Optional *
                      END IF
                    ELSE
                      asMode = 0
                      hasPendingStr = 0
                    END IF

                  CASE ELSE
                    asMode = 0
                    hasPendingStr = 0

                END SELECT ' kwVal

              ELSE
                ' Is Variable / Label / Sub Call
                IF lastKwVal = TOK_DEF THEN
                  IF UCASE$(LEFT$(ident$, 2)) = "FN" THEN
                    IF LEN(ident$) = 2 THEN
                      ident$ = "FN"
                    ELSE
                      ident$ = "Fn" + MID$(ident$, 3)
                    END IF
                  END IF
                END IF
                lastKwVal = 0

                SELECT CASE asMode

                  CASE 4
                    ' Valid identifier used as length (e.g. constant)
                    asMode = 0
                    IF hasPendingStr = 1 THEN
                      IF lastVarSuffix$ = "$" THEN
                        strDeclType(pendingStrIdx) = 1
                      ELSE
                        strDeclType(pendingStrIdx) = 2
                      END IF
                      hasPendingStr = 0
                    END IF

                  CASE 5
                    ' We saw AS STRING, but no *, and now we hit a variable. It's a dynamic string
                    asMode = 0
                    IF hasPendingStr = 1 THEN
                      IF lastVarSuffix$ = "$" THEN
                        strDeclType(pendingStrIdx) = 1
                      ELSE
                        strDeclType(pendingStrIdx) = 2
                      END IF
                      hasPendingStr = 0
                    END IF

                  CASE ELSE
                    asMode = 0
                    hasPendingStr = 0

                END SELECT ' asMode

                baseName$ = UCASE$(ident$)
                IF suffixCh$ <> "" THEN baseName$ = LEFT$(baseName$, LEN(baseName$) - 1)

                ' Only track variables for string typing if they aren't enclosed in parentheses (e.g. array dimensions)
                IF parenDepth = 0 THEN
                  lastVarBase$ = baseName$
                  lastVarSuffix$ = suffixCh$
                END IF

                ' If Emerald mode is active, we track the variable on its FIRST sighting.
                ' Whatever the user typed the first time dictates the variable's suffix permanently.
                IF compileEmeraldMode = 1 THEN
                  isStrFound = 0
                  foundStrIdx = 0
                  FOR iStr = 0 TO strDeclCount - 1
                    IF strDeclName$(iStr) = baseName$ AND (strDeclScope(iStr) = activeScope OR strDeclScope(iStr) = 0) THEN
                      foundStrIdx = iStr
                      isStrFound = 1
                      EXIT FOR
                    END IF
                  NEXT

                  IF isStrFound = 0 AND strDeclCount < MAX_STRING_DECLS THEN
                    ' First sighting! Register it safely if within tracking bounds.
                    foundStrIdx = strDeclCount
                    strDeclName$(foundStrIdx) = baseName$
                    strDeclScope(foundStrIdx) = activeScope
                    IF suffixCh$ = "$" THEN
                      strDeclType(foundStrIdx) = 1 ' Requires $
                    ELSE
                      strDeclType(foundStrIdx) = 2 ' Requires NO $
                    END IF
                    strDeclCount = strDeclCount + 1
                    isStrFound = 1
                  END IF

                  ' Only apply string enforcement rules if the variable was explicitly located or registered
                  IF isStrFound = 1 THEN
                    strType = strDeclType(foundStrIdx)

                    SELECT CASE strType
                      CASE 1 ' Requires $
                        IF suffixCh$ <> "$" THEN
                          ident$ = ident$ + "$"
                          suffixCh$ = "$"
                        END IF
                      CASE 2 ' Requires NO $
                        IF suffixCh$ = "$" THEN
                          ident$ = LEFT$(ident$, LEN(ident$) - 1)
                          suffixCh$ = ""
                        END IF
                    END SELECT
                  END IF
                END IF

                isVarFound = 0
                foundVarIdx = 0
                uIdent$ = UCASE$(ident$)

                FOR ii = 0 TO refCount - 1
                  IF UCASE$(refName$(ii)) = uIdent$ THEN
                    IF refScope(ii) = activeScope THEN
                      foundVarIdx = ii
                      isVarFound = 1
                      EXIT FOR
                    END IF
                  END IF
                NEXT

                IF isVarFound = 0 AND activeScope > 0 THEN
                  FOR ii = 0 TO refCount - 1
                    IF UCASE$(refName$(ii)) = uIdent$ THEN
                      IF refScope(ii) = 0 THEN
                        foundVarIdx = ii
                        isVarFound = 1
                        EXIT FOR
                      END IF
                    END IF
                  NEXT
                END IF

                IF isValidLine = 1 THEN
                  IF isVarFound = 0 THEN
                    IF refCount < MAX_SYMBOLS THEN
                      foundVarIdx = refCount
                      refName$(foundVarIdx) = ident$
                      refScope(foundVarIdx) = activeScope
                      refCount = refCount + 1
                      isVarFound = 1
                    END IF
                    tempPartLen = LEN(ident$)
                    IF tempPartLen > 0 THEN
                      IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                      MID$(newRawString, newLen + 1, tempPartLen) = ident$
                      newLen = newLen + tempPartLen
                    END IF
                  ELSE
                    tempPart$ = refName$(foundVarIdx)
                    tempPartLen = LEN(tempPart$)
                    IF tempPartLen > 0 THEN
                      IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                      MID$(newRawString, newLen + 1, tempPartLen) = tempPart$
                      newLen = newLen + tempPartLen
                    END IF
                  END IF
                ELSE
                  IF isVarFound = 0 THEN
                    tempPartLen = LEN(ident$)
                    IF tempPartLen > 0 THEN
                      IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                      MID$(newRawString, newLen + 1, tempPartLen) = ident$
                      newLen = newLen + tempPartLen
                    END IF
                  ELSE
                    tempPart$ = refName$(foundVarIdx)
                    tempPartLen = LEN(tempPart$)
                    IF tempPartLen > 0 THEN
                      IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                      MID$(newRawString, newLen + 1, tempPartLen) = tempPart$
                      newLen = newLen + tempPartLen
                    END IF
                  END IF
                END IF
              END IF
            ELSE
              ' Symbol
              IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              newLen = newLen + 1
              ASC(newRawString, newLen) = cAs

              ix = ix + 1
              lastKwVal = 0

              IF cAs = 40 THEN parenDepth = parenDepth + 1
              IF cAs = 41 THEN parenDepth = parenDepth - 1

              IF cAs = 42 AND (asMode = 3 OR asMode = 5) THEN ' *
                asMode = 4 ' Waiting for length
              ELSE
                IF cAs <> 32 AND cAs <> 9 THEN
                  IF asMode = 4 THEN
                    ' If we see a valid number, we successfully found our length
                    IF cAs >= 48 AND cAs <= 57 THEN
                      asMode = 0
                      IF hasPendingStr = 1 THEN
                        IF lastVarSuffix$ = "$" THEN
                          strDeclType(pendingStrIdx) = 1
                        ELSE
                          strDeclType(pendingStrIdx) = 2
                        END IF
                        hasPendingStr = 0
                      END IF
                    ELSE
                      ' Garbage found! Abort commit and leave the variable Suspended
                      asMode = 0
                      hasPendingStr = 0
                    END IF
                  ELSE
                    IF asMode = 5 THEN
                      ' Hit a non-space symbol right after AS STRING. Treat as dynamic.
                      asMode = 0
                      IF hasPendingStr = 1 THEN
                        IF lastVarSuffix$ = "$" THEN
                          strDeclType(pendingStrIdx) = 1
                        ELSE
                          strDeclType(pendingStrIdx) = 2
                        END IF
                        hasPendingStr = 0
                      END IF
                    ELSE
                      asMode = 0
                      hasPendingStr = 0
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      LOOP

      builtLine$ = RTRIM$(LEFT$(newRawString, newLen))
      trimmedLine$ = LTRIM$(builtLine$)
      uTrimmed$ = UCASE$(trimmedLine$)

      IF trimmedLine$ <> "" THEN
        IF LEFT$(uTrimmed$, 4) = "SUB " OR LEFT$(uTrimmed$, 9) = "FUNCTION " THEN
          editorText$(iy) = trimmedLine$
        ELSE
          IF LEFT$(uTrimmed$, 7) = "END SUB" OR LEFT$(uTrimmed$, 12) = "END FUNCTION" THEN
            editorText$(iy) = trimmedLine$
          ELSE
            IF activeScope > 0 THEN
              IF LEFT$(trimmedLine$, 1) = "'" THEN
                editorText$(iy) = builtLine$
              ELSE
                leadingSpaces = 0
                FOR sIdx = 1 TO LEN(builtLine$)
                  IF MID$(builtLine$, sIdx, 1) = " " THEN
                    leadingSpaces = leadingSpaces + 1
                  ELSE
                    EXIT FOR
                  END IF
                NEXT

                IF leadingSpaces < editor.TabSize THEN
                  IF editor.TabSize > 0 THEN
                    editorText$(iy) = SPACE$(editor.TabSize) + trimmedLine$
                  ELSE
                    editorText$(iy) = trimmedLine$
                  END IF
                ELSE
                  editorText$(iy) = builtLine$
                END IF
              END IF
            ELSE
              editorText$(iy) = builtLine$
            END IF
          END IF
        END IF
      ELSE
        editorText$(iy) = ""
      END IF

      ' Only update global UI Sub list safely during a full sweep load to avoid visual glitches
      IF targetLine = 0 THEN
        testSub$ = LTRIM$(editorText$(iy))
        IF LEFT$(testSub$, 4) = "SUB " OR LEFT$(testSub$, 9) = "FUNCTION " THEN
          IF uiSubCount < MAX_UI_SUBS THEN
            IF LEFT$(testSub$, 4) = "SUB " THEN
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 5)))
            ELSE
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 10)))
            END IF

            cleanName$ = ""
            FOR nameIdx = 1 TO LEN(sName$)
              nameChar = ASC(sName$, nameIdx)
              IF (nameChar >= 65 AND nameChar <= 90) OR (nameChar >= 97 AND nameChar <= 122) OR (nameChar >= 48 AND nameChar <= 57) OR nameChar = 95 OR nameChar = 36 OR nameChar = 35 OR nameChar = 33 OR nameChar = 37 OR nameChar = 38 THEN
                cleanName$ = cleanName$ + CHR$(nameChar)
              ELSE
                EXIT FOR
              END IF
            NEXT
            sName$ = cleanName$

            uiSubName$(uiSubCount) = sName$
            uiSubLine(uiSubCount) = iy
            uiSubCount = uiSubCount + 1
          END IF
        END IF
      END IF

    ELSE
      editorText$(iy) = ""
    END IF

    IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
      activeScope = 0
    END IF
  NEXT

END SUB ' refineCode

''''''''''''''''''''''''
SUB showCursorData (baseX, baseY)

  PrintStr baseX, baseY, "MSX:" + cTrNum$(mouse.PosX), 15, 0, 1
  PrintStr baseX, baseY + 12, "MSY:" + cTrNum$(mouse.PosY), 15, 0, 1
  PrintStr baseX, baseY + 24, "CX:" + cTrNum$(editor.CursorX), 15, 0, 1
  PrintStr baseX, baseY + 36, "CY:" + cTrNum$(editor.CursorY), 15, 0, 1
  displayFlashText

END SUB ' showCursorData

''''''''''''''''''''''''
SUB return2 (wVal)

  ' Return the global secondary return variable

  returnF2data = wVal

END SUB ' return2

''''''''''''''''''''''''
SUB return3 (wVal)

  ' Return the global tertiary return value

  returnF3data = wVal

END SUB ' return3

''''''''''''''''''''''''
FUNCTION returnedData2

  returnedData2 = returnF2data

END FUNCTION ' returnedData2

''''''''''''''''''''''''
FUNCTION returnedData3

  returnedData3 = returnF3data

END FUNCTION ' returnedData3

''''''''''''''''''''''''
SUB returnExtraPrepare

  ' Call at the top of any function that sends back return 2 or 3 data

  returnF2data = 0
  returnF3data = 0

END SUB ' returnExtraPrepare

''''''''''''''''''''''''
SUB ZLOCATE (wX, wY)

  LOCATE wY + 1, wX + 1

END SUB ' ZLOCATE

''''''''''''''''''''''''
SUB ESCAPETEXT (wStr$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr$ = "" THEN wStr$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  PrintTextLineWithBanners wStr$, 15, BOTTOM

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - 8, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT

''''''''''''''''''''''''
SUB ESCAPETEXT2 (wStr1$, wStr2$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr1$ = "" THEN wStr1$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  fileOutputErrorReport wStr1$, wStr2$

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  boxW = SCREENSIZEX - 16
  boxH = 34
  boxX = 8
  boxY = SCREENSIZEY - 128

  drawBorderBox boxX, boxY, boxW, boxH, 1, 0
  drawClearBox boxX + 1, boxY + 1, boxW - 2, boxH - 2, 15

  PrintStr boxX + 8, boxY + 8, wStr1$, 15, 0, 0

  IF wStr2$ <> "" THEN
    PrintStr boxX + 8, boxY + 18, wStr2$, 15, 0, 0
  END IF

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - 8, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT2

''''''''''''''''''''''''

''''''''''''''''''''''''
FUNCTION extractQuotes$ (wStr$)

  tempReturn$ = ""
  firstQuote = INSTR(wStr$, CHR$(34))

  IF firstQuote > 0 THEN
    secondQuote = INSTR(firstQuote + 1, wStr$, CHR$(34))
    IF secondQuote > 0 THEN
      tempReturn$ = MID$(wStr$, firstQuote + 1, secondQuote - firstQuote - 1)
    END IF
  END IF

  extractQuotes$ = tempReturn$

END FUNCTION ' extractQuotes$

''''''''''''''''''''''''
SUB fileCodeImport (importFile$)

  IF _FILEEXISTS(importFile$) = 0 THEN EXIT SUB

  ffTmp = FREEFILE
  OPEN importFile$ FOR BINARY AS #ffTmp
  fileLen = LOF(ffTmp)
  IF fileLen = 0 THEN
    CLOSE #ffTmp
    EXIT SUB
  END IF

  fullText$ = SPACE$(fileLen)
  GET #ffTmp, , fullText$
  CLOSE #ffTmp

  curY = editor.LastLine + 1
  IF curY > EDITOR_LINE_MAX THEN EXIT SUB

  ' Enforce visual separation
  IF curY > 1 THEN
    IF LTRIM$(RTRIM$(editorText$(curY - 1))) <> "" THEN
      editorText$(curY) = ""
      curY = curY + 1
    END IF
  END IF

  IF curY <= EDITOR_LINE_MAX THEN
    editorText$(curY) = "'''' IMPORTED: FILE: " + importFile$
    curY = curY + 1
  END IF

  IF curY <= EDITOR_LINE_MAX THEN
    editorText$(curY) = ""
    curY = curY + 1
  END IF

  startPos = 1

  ' Slice the incoming file block natively to eliminate slow byte-by-byte loop processing
  DO WHILE startPos <= fileLen
    nextNl = INSTR(startPos, fullText$, CHR$(10))
    IF nextNl > 0 THEN
      chunkLen = nextNl - startPos
      IF chunkLen > 0 THEN
        IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      IF curY > EDITOR_LINE_MAX THEN EXIT DO
      startPos = nextNl + 1
    ELSE
      chunkLen = fileLen - startPos + 1
      IF chunkLen > 0 THEN
        IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      EXIT DO
    END IF
  LOOP

  ' Sync the global tracking bounds safely to the new expanded size
  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

END SUB ' fileCodeImport

''''''''''''''''''''''''
SUB fileCodeLoad

  curExt$ = ".BAS"
  IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
  IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

  fln$ = fileNameBase$ + curExt$

  IF _FILEEXISTS(fln$) = 0 THEN EXIT SUB

  OPEN fln$ FOR BINARY AS #1

  fileLen = LOF(1)

  IF fileLen = 0 THEN
    CLOSE #1
    KILL fln$
    EXIT SUB
  END IF

  ' Pre-allocate buffer and read entire file at once to eliminate per-byte I/O latency
  fullText$ = SPACE$(fileLen)
  GET #1, , fullText$
  CLOSE #1

  ' Pre-clear arrays
  FOR iy = 1 TO EDITOR_LINE_MAX
    editorText$(iy) = ""
  NEXT

  curY = 1
  startPos = 1

  ' Slice the text into individual lines using the native INSTR delimiter scanner for extreme speed
  DO WHILE startPos <= fileLen
    nextNl = INSTR(startPos, fullText$, CHR$(10))
    IF nextNl > 0 THEN
      chunkLen = nextNl - startPos
      IF chunkLen > 0 THEN
        IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      IF curY > EDITOR_LINE_MAX THEN EXIT DO
      startPos = nextNl + 1
    ELSE
      chunkLen = fileLen - startPos + 1
      IF chunkLen > 0 THEN
        IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      EXIT DO
    END IF
  LOOP

  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

  IF editor.CursorY > editor.LastLine THEN
    editor.CursorY = editor.LastLine
    editor.CursorX = 0
  END IF

  IF editor.ScrollY > editor.LastLine THEN
    editor.ScrollY = editor.LastLine - 27
    IF editor.ScrollY < 1 THEN editor.ScrollY = 1
  END IF

END SUB ' fileCodeLoad

''''''''''''''''''''''''
SUB fileCodeSave

  curExt$ = ".BAS"
  IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
  IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

  fln$ = fileNameBase$ + curExt$

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp
  IF LOF(ffTmp) > 0 THEN
    CLOSE #ffTmp
    KILL fln$
    OPEN fln$ FOR BINARY AS #ffTmp
  END IF

  lastLine = editor.LastLine
  totalLen = 0

  ' Calculate the exact buffer size required for the entire file
  FOR iy = 1 TO lastLine
    totalLen = totalLen + LEN(editorText$(iy))
  NEXT

  ' Add space for the newline characters between each line
  IF lastLine > 1 THEN
    totalLen = totalLen + (lastLine - 1)
  END IF

  IF totalLen > 0 THEN
    ' Pre-allocate the memory block to prevent slow string concatenation
    fullText$ = SPACE$(totalLen)
    curPos = 1

    FOR iy = 1 TO lastLine
      lineStr$ = editorText$(iy)
      lineLen = LEN(lineStr$)

      IF lineLen > 0 THEN
        ' Use direct memory injection for maximum speed
        MID$(fullText$, curPos, lineLen) = lineStr$
        curPos = curPos + lineLen
      END IF

      ' Append the newline separator seamlessly
      IF iy < lastLine THEN
        ASC(fullText$, curPos) = 10
        curPos = curPos + 1
      END IF
    NEXT

    ' Blast the entire buffer directly to the disk in one native operation
    PUT #ffTmp, , fullText$
  END IF

  CLOSE #ffTmp

END SUB ' fileCodeSave

''''''''''''''''''''''''
SUB fileSaveBinary

  DIM tryCount AS LONG
  DIM suffixStr$
  DIM testBase$

  tryCount = 0
  testBase$ = fileNameBase$

  DO
    fln$ = testBase$ + ".exe"

    IF _FILEEXISTS(fln$) THEN
      ' Pass the deletion command to the operating system to avoid fatal lock crashes
      SHELL _HIDE "cmd /c del /q " + CHR$(34) + fln$ + CHR$(34)

      ' If the file survives the OS deletion attempt, it is actively locked by a running process
      IF _FILEEXISTS(fln$) THEN
        tryCount = tryCount + 1

        IF tryCount < 10 THEN
          suffixStr$ = "_0" + LTRIM$(RTRIM$(STR$(tryCount)))
        ELSE
          suffixStr$ = "_" + LTRIM$(RTRIM$(STR$(tryCount)))
        END IF

        testBase$ = fileNameBase$ + suffixStr$
      ELSE
        EXIT DO
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Update the global base name so the IDE runner launches the newly generated executable
  fileNameBase$ = testBase$

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp

  IF outputFileIdx > 0 THEN
    outStr$ = SPACE$(outputFileIdx)
    FOR ii = 0 TO outputFileIdx - 1
      ASC(outStr$, ii + 1) = outputFile(ii)
    NEXT
    PUT #ffTmp, , outStr$
  END IF

  CLOSE #ffTmp

END SUB ' fileSaveBinary

''''''''''''''''''''''''
SUB fileOutputErrorReport (wStr1$, wStr2$)

  rwVar$ = " " ' Necessary, or QB64 won't work correctly

  fln$ = fileNameErr$

  OPEN fln$ FOR BINARY AS #1
  IF LOF(1) > 0 THEN
    CLOSE #1
    KILL fln$
    OPEN fln$ FOR BINARY AS #1
  END IF

  FOR ix = 1 TO LEN(wStr1$)
    rwVar$ = MID$(wStr1$, ix, 1)
    PUT #1, , rwVar$
  NEXT

  rwVar$ = CHR$(13)
  PUT #1, , rwVar$
  rwVar$ = CHR$(10)
  PUT #1, , rwVar$

  IF wStr2$ <> "" THEN
    FOR ix = 1 TO LEN(wStr2$)
      rwVar$ = MID$(wStr2$, ix, 1)
      PUT #1, , rwVar$
    NEXT
    rwVar$ = CHR$(13)
    PUT #1, , rwVar$
    rwVar$ = CHR$(10)
    PUT #1, , rwVar$
  END IF

  CLOSE #1

END SUB ' fileOutputErrorReport

''''''''''''''''''''''''
FUNCTION findComma (startIdx, endIdx)

  DIM commaPos AS LONG

  commaPos = 0
  ff = findNextTokenAtDepth0(startIdx, endIdx, 256 + ASC(","))
  IF ff = 1 THEN
    commaPos = returnedData2
  END IF

  findComma = commaPos

END FUNCTION ' findComma

''''''''''''''''''''''''
SUB findEditorNext

  ' When a match is found, it performs the following tasks:
  ' Updates the cursor position (editor.CursorX and editor.CursorY).
  ' Sets the selection boundaries to highlight the found text.
  ' Adjusts the horizontal and vertical scroll offsets so the found text is visible on the screen.
  ' Assigns focus to the editor window.

  IF editorSearchQuery$ = "" THEN EXIT SUB

  foundMatch = 0
  uQuery$ = UCASE$(editorSearchQuery$)

  FOR iy = editor.CursorY TO editor.LastLine
    uLine$ = UCASE$(editorText$(iy))
    matchPos = INSTR(uLine$, uQuery$)

    IF matchPos > 0 AND iy = editor.CursorY THEN
      matchPos = INSTR(editor.CursorX + 2, uLine$, uQuery$)
    END IF

    IF matchPos > 0 THEN
      editor.CursorY = iy
      editor.CursorX = matchPos - 1
      editor.SelectStartY = iy
      editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
      editor.IsSelecting = 1
      editor.Focus = 1

      editor.ScrollY = editor.CursorY - 14
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      editor.ScrollX = editor.CursorX - 20
      IF editor.ScrollX < 0 THEN editor.ScrollX = 0

      foundMatch = 1
      EXIT FOR
    END IF
  NEXT

  IF foundMatch = 0 THEN
    FOR iy = 1 TO editor.CursorY
      uLine$ = UCASE$(editorText$(iy))
      matchPos = INSTR(uLine$, uQuery$)

      IF matchPos > 0 THEN
        editor.CursorY = iy
        editor.CursorX = matchPos - 1
        editor.SelectStartY = iy
        editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
        editor.IsSelecting = 1
        editor.Focus = 1

        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
        editor.ScrollX = editor.CursorX - 20
        IF editor.ScrollX < 0 THEN editor.ScrollX = 0

        addStatusMsg "SEARCH RESTARTED AT TOP"

        foundMatch = 1
        EXIT FOR
      END IF
    NEXT
  END IF

  IF foundMatch = 0 THEN
    addStatusMsg "SEARCH: NO MATCHES FOUND"
  END IF

END SUB ' findEditorNext
''''''''''''''''''''''''
''''''''''''''''''''''''
SUB addStatusMsgContinuation (wMsg$)

  IF statusGroupCount = 0 THEN
    addStatusMsg wMsg$
  ELSE
    addStatusMsgToGroup wMsg$, statusGroupCount
  END IF

END SUB ' addStatusMsgContinuation

''''''''''''''''''''''''
SUB addStatusMsgToGroup (wMsg$, wGroupID AS _UNSIGNED LONG)

  DIM lineNum AS LONG
  DIM colonPos AS LONG

  lineNum = 0

  IF LEFT$(wMsg$, 11) = "ERROR line " THEN
    colonPos = INSTR(wMsg$, ":")
    IF colonPos > 12 THEN
      lineNum = VAL(MID$(wMsg$, 12, colonPos - 12))
    END IF
  ELSE
    IF LEFT$(wMsg$, 13) = "WARNING line " THEN
      colonPos = INSTR(wMsg$, ":")
      IF colonPos > 14 THEN
        lineNum = VAL(MID$(wMsg$, 14, colonPos - 14))
      END IF
    END IF
  END IF

  compileStatusMsg$ = wMsg$

  editorTextX = EDITOR_BOX_X + LEFT_SPACING
  editorTextW = 56 * 8
  statusBoxW = editorTextX + editorTextW + 3

  maxLen = (statusBoxW - 16) \ 8

  tempMsg$ = wMsg$
  DO WHILE LEN(tempMsg$) > 0
    IF LEN(tempMsg$) <= maxLen THEN
      pushStatusMsg tempMsg$, lineNum, wGroupID
      tempMsg$ = ""
    ELSE
      splitPos = maxLen
      FOR ii = maxLen TO 1 STEP -1
        IF MID$(tempMsg$, ii, 1) = " " THEN
          splitPos = ii
          EXIT FOR
        END IF
      NEXT
      IF splitPos = maxLen THEN
        pushStatusMsg LEFT$(tempMsg$, maxLen), lineNum, wGroupID
        tempMsg$ = MID$(tempMsg$, maxLen + 1)
      ELSE
        pushStatusMsg LEFT$(tempMsg$, splitPos - 1), lineNum, wGroupID
        tempMsg$ = MID$(tempMsg$, splitPos + 1)
      END IF
    END IF
  LOOP

END SUB ' addStatusMsgToGroup

''''''''''''''''''''''''
''''''''''''''''''''''''
SUB undo_StateRestore

  IF undoState.Ready = 0 THEN EXIT SUB

  FOR ii = 1 TO undoState.LastLine
    editorText$(ii) = undoText$(ii)
  NEXT
  FOR ii = undoState.LastLine + 1 TO editor.LastLine
    editorText$(ii) = ""
  NEXT

  editor.CursorX = undoState.CursorX
  editor.CursorY = undoState.CursorY
  editor.ScrollX = undoState.ScrollX
  editor.ScrollY = undoState.ScrollY
  editor.LastLine = undoState.LastLine

  undoState.Ready = 0
  lastActionWasTyping = 0

  addStatusMsg "UNDO USED"

  refineCode 0, 0

END SUB ' undo_StateRestore

''''''''''''''''''''''''
SUB undo_StateSave

  FOR ii = 1 TO editor.LastLine
    undoText$(ii) = editorText$(ii)
  NEXT
  FOR ii = editor.LastLine + 1 TO undoState.LastLine
    undoText$(ii) = ""
  NEXT

  undoState.CursorX = editor.CursorX
  undoState.CursorY = editor.CursorY
  undoState.ScrollX = editor.ScrollX
  undoState.ScrollY = editor.ScrollY
  undoState.LastLine = editor.LastLine

  undoState.Ready = 1

END SUB ' undo_StateSave

''''''''''''''''''''''''
''''''''''''''''''''''''
SUB throwCompilerError (errMsg$, wType, wData)

  ' wData is a placeholder

  IF wType = ASIS THEN
    ' Centralized error helper to reduce boilerplate formatting as the compiler grows
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$
  ELSE ' WITHFAILED:
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$ + " FAILED"
  END IF

  compileError = 1

END SUB ' throwCompilerError

'''''''''''''''''''''''
SUB throwCompilerErrorAndCancelTira (errMsg$, wType, wData)

  ' Combines two frequently used calls into one

  tira_Cancel

  throwCompilerError errMsg$, wType, wData

END SUB ' throwCompilerErrorAndCancelTira

'''''''''''''''''''''''
SUB throwCompilerErrorNoLineNum (errMsg$)

  addStatusMsg "ERROR: " + errMsg$
  compileError = 1

END SUB ' throwCompilerErrorNoLineNum

