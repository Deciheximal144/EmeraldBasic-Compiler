' Z_EMLINF.BLB This is the external library file for EmeraldBasic
' The line with comment, dollar sign, and INCLUDE 'Z_EMLINF.BLB' at the end of the EmeraldBasic file link this code in QB64PE
' In EmeraldBasic, the '#INCLUDE command at the top does the work

SUB addStatusMsg (wMsg$)

  statusGroupCount = statusGroupCount + 1
  addStatusMsgToGroup wMsg$, statusGroupCount

END SUB ' addStatusMsg

''''''''''''''''''''''''
SUB addStatusMsgContinuation (wMsg$)

  IF statusGroupCount = 0 THEN
    addStatusMsg wMsg$
  ELSE
    addStatusMsgToGroup wMsg$, statusGroupCount
  END IF

END SUB ' addStatusMsgContinuation

''''''''''''''''''''''''
SUB addStatusMsgToGroup (wMsg$, wGroupID AS _UNSIGNED LONG)

  DIM lineNum AS LONG
  DIM colonPos AS LONG

  lineNum = 0

  IF LEFT$(wMsg$, 11) = "ERROR line " THEN
    colonPos = INSTR(wMsg$, ":")
    IF colonPos > 12 THEN
      lineNum = VAL(MID$(wMsg$, 12, colonPos - 12))
    END IF
  ELSE
    IF LEFT$(wMsg$, 13) = "WARNING line " THEN
      colonPos = INSTR(wMsg$, ":")
      IF colonPos > 14 THEN
        lineNum = VAL(MID$(wMsg$, 14, colonPos - 14))
      END IF
    END IF
  END IF

  IF lineNum > 0 AND pass5.Mode <> PASS5_MODE_NONE THEN
    IF pass5.LINE >= 1 AND pass5.LINE <= compileLastLine THEN
      IF editorLineLinkMap(pass5.LINE) = currentLineNumber THEN
        IF includeSourceLineMap(pass5.LINE) = lineNum THEN
          lineNum = currentLineNumber
        END IF
      END IF
    END IF
  END IF

  compileStatusMsg$ = wMsg$

  statusBoxW = editor.StatusWidth

  maxLen = editor.StatusColumns

  tempMsg$ = wMsg$
  DO WHILE LEN(tempMsg$) > 0
    IF LEN(tempMsg$) <= maxLen THEN
      pushStatusMsg tempMsg$, lineNum, wGroupID
      tempMsg$ = ""
    ELSE
      splitPos = maxLen
      FOR ii = maxLen TO 1 STEP -1
        IF MID$(tempMsg$, ii, 1) = " " THEN
          splitPos = ii
          EXIT FOR
        END IF
      NEXT
      IF splitPos = maxLen THEN
        pushStatusMsg LEFT$(tempMsg$, maxLen), lineNum, wGroupID
        tempMsg$ = MID$(tempMsg$, maxLen + 1)
      ELSE
        pushStatusMsg LEFT$(tempMsg$, splitPos - 1), lineNum, wGroupID
        tempMsg$ = MID$(tempMsg$, splitPos + 1)
      END IF
    END IF
  LOOP

END SUB ' addStatusMsgToGroup

''''''''''''''''''''''''
SUB checkEmergencyClose

  closeBtnW = editor.CloseWidth - 1
  closeBtnX = SCREENSIZEX - closeBtnW
  closeBtnY = 0
  closeBtnH = 15

  mouseReadInput
  IF mouse.Clicked1 THEN
    IF mouseDownWithinBoxBounds(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      mouse.Clicked1 = 0
      throwCompilerError "ABORTED BY USER", ASIS, 0
      editor.TopMenuFocus = 4
      editor.Focus = 0
      editor.MenuClicked = 1
    END IF
  END IF

END SUB ' checkEmergencyClose

''''''''''''''''''''''''
SUB confirmExit

  boxW = editor.ConfirmExitWidth
  boxX = (SCREENSIZEX - boxW) \ 2

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    drawCornerPMI
    _DEST logicalScreen

    IF mouse.Released1 THEN
      IF editor.MenuClicked = 0 THEN
        editor.TopMenuFocus = 0
      END IF
    END IF

    drawBorderBox boxX, (SCREENSIZEY \ 2) - 20, boxW, 40, 15, 0
    PrintStr boxX + editor.TextPadding, (SCREENSIZEY \ 2) - 4, "PRESS ESC TO CONFIRM, SPACE TO CANCEL", 14, 0, 0
    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      ESCAPETEXT "PROGRAM ENDED"
    END IF

    kVal2 = keyCheck("SPACE")
    IF kVal2 = 32 THEN
      DO WHILE _KEYDOWN(32)
        limitSpeed
      LOOP
      EXIT DO
    END IF
  LOOP

END SUB ' confirmExit

''''''''''''''''''''''''
