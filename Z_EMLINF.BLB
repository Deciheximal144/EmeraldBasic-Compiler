  loadFontPixelRow 1, 3, 14, 8, "        ", "FF F FF ", " FF     ", " FF  FF "
  loadFontPixelRow 1, 3, 14, 9, "        ", "FF F FF ", " FF     ", " FF  FF "
  loadFontPixelRow 1, 3, 14, 10, "        ", " FFFFF  ", "  FFFFF ", "        "
  loadFontPixelRow 1, 3, 14, 11, "        ", "   F    ", "        ", "        "
  loadFontPixelRow 1, 3, 14, 12, "        ", "   F    ", "        ", "        "
  loadFontPixelRow 1, 3, 14, 13, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 14, 14, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 14, 15, "        ", "        ", "        ", "        "

  ' Characters 240 through 243
  loadFontPixelRow 1, 0, 15, 0, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 1, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 2, " FFFFFF ", "   FF   ", "  FF    ", "    FF  "
  loadFontPixelRow 1, 0, 15, 3, "        ", "   FF   ", "   FF   ", "   FF   "
  loadFontPixelRow 1, 0, 15, 4, "        ", "   FF   ", "    FF  ", "  FF    "
  loadFontPixelRow 1, 0, 15, 5, " FFFFFF ", " FFFFFF ", "     FF ", " FF     "
  loadFontPixelRow 1, 0, 15, 6, "        ", "   FF   ", "    FF  ", "  FF    "
  loadFontPixelRow 1, 0, 15, 7, "        ", "   FF   ", "   FF   ", "   FF   "
  loadFontPixelRow 1, 0, 15, 8, " FFFFFF ", "   FF   ", "  FF    ", "    FF  "
  loadFontPixelRow 1, 0, 15, 9, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 10, "        ", " FFFFFF ", " FFFFFF ", " FFFFFF "
  loadFontPixelRow 1, 0, 15, 11, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 12, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 13, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 14, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 0, 15, 15, "        ", "        ", "        ", "        "

  ' Characters 244 through 247
  loadFontPixelRow 1, 1, 15, 0, "    FFF ", "   FF   ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 1, "   FF FF", "   FF   ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 2, "   FF FF", "   FF   ", "   FF   ", " FFF  F "
  loadFontPixelRow 1, 1, 15, 3, "   FF FF", "   FF   ", "   FF   ", "FF F FF "
  loadFontPixelRow 1, 1, 15, 4, "   FF   ", "   FF   ", "        ", "F  FFF  "
  loadFontPixelRow 1, 1, 15, 5, "   FF   ", "   FF   ", " FFFFFF ", "        "
  loadFontPixelRow 1, 1, 15, 6, "   FF   ", "   FF   ", "        ", " FFF  F "
  loadFontPixelRow 1, 1, 15, 7, "   FF   ", "FF FF   ", "   FF   ", "FF F FF "
  loadFontPixelRow 1, 1, 15, 8, "   FF   ", "FF FF   ", "   FF   ", "F  FFF  "
  loadFontPixelRow 1, 1, 15, 9, "   FF   ", "FF FF   ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 10, "   FF   ", " FFF    ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 11, "   FF   ", "        ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 12, "   FF   ", "        ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 13, "   FF   ", "        ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 14, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 1, 15, 15, "        ", "        ", "        ", "        "

  ' Characters 248 through 251
  loadFontPixelRow 1, 2, 15, 0, " FF  FF ", "        ", "        ", "      FF"
  loadFontPixelRow 1, 2, 15, 1, " FF  FF ", "        ", "        ", "     FF "
  loadFontPixelRow 1, 2, 15, 2, "  FFFF  ", "        ", "        ", "     FF "
  loadFontPixelRow 1, 2, 15, 3, "        ", " FFF    ", "        ", "     FF "
  loadFontPixelRow 1, 2, 15, 4, "        ", "F   F   ", "        ", "     FF "
  loadFontPixelRow 1, 2, 15, 5, "        ", "F   F   ", "   FF   ", "     FF "
  loadFontPixelRow 1, 2, 15, 6, "        ", "F   F   ", "        ", "FF  FF  "
  loadFontPixelRow 1, 2, 15, 7, "        ", "F   F   ", "        ", "FF  FF  "
  loadFontPixelRow 1, 2, 15, 8, "        ", "F   F   ", "        ", " FF FF  "
  loadFontPixelRow 1, 2, 15, 9, "        ", "F   F   ", "        ", "  FFF   "
  loadFontPixelRow 1, 2, 15, 10, "        ", "F   F   ", "        ", "   FF   "
  loadFontPixelRow 1, 2, 15, 11, "        ", "F   F   ", "        ", "        "
  loadFontPixelRow 1, 2, 15, 12, "        ", "F   F   ", "        ", "        "
  loadFontPixelRow 1, 2, 15, 13, "        ", "FFFFF   ", "        ", "        "
  loadFontPixelRow 1, 2, 15, 14, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 2, 15, 15, "        ", "        ", "        ", "        "

  ' Characters 252 through 255
  loadFontPixelRow 1, 3, 15, 0, "        ", " FF FF  ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 1, " FFFF   ", "    FF  ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 2, " FF FF  ", "   FF   ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 3, " FF FF  ", "  FF    ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 4, " FF FF  ", " FFFF   ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 5, "        ", "        ", " FFFFFF ", "        "
  loadFontPixelRow 1, 3, 15, 6, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 7, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 8, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 9, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 10, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 11, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 12, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 13, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 14, "        ", "        ", "        ", "        "
  loadFontPixelRow 1, 3, 15, 15, "        ", "        ", "        ", "        "

  CLS

END SUB ' createFont16Manual

''''''''''''''''''''''''
FUNCTION cTrNum$ (wNum)

  cTrNum$ = LTRIM$(RTRIM$(STR$(wNum)))

END FUNCTION ' cTrNum$

''''''''''''''''''''''''
SUB deleteSelection

  IF editor.SelectStartX = editor.CursorX AND editor.SelectStartY = editor.CursorY THEN EXIT SUB

  IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
    startY = editor.SelectStartY
    startX = editor.SelectStartX
    endY = editor.CursorY
    endX = editor.CursorX
  ELSE
    startY = editor.CursorY
    startX = editor.CursorX
    endY = editor.SelectStartY
    endX = editor.SelectStartX
  END IF

  leftPart$ = LEFT$(editorText$(startY), startX)
  rightPart$ = MID$(editorText$(endY), endX + 1)

  editorText$(startY) = leftPart$ + rightPart$

  linesToRemove = endY - startY
  IF linesToRemove > 0 THEN
    FOR ii = startY + 1 TO editor.LastLine - linesToRemove
      editorText$(ii) = editorText$(ii + linesToRemove)
    NEXT
    FOR ii = editor.LastLine - linesToRemove + 1 TO editor.LastLine
      editorText$(ii) = ""
    NEXT
    editor.LastLine = editor.LastLine - linesToRemove
    IF editor.LastLine < 1 THEN editor.LastLine = 1
  END IF

  editor.CursorX = startX
  editor.CursorY = startY
  editor.SelectStartX = startX
  editor.SelectStartY = startY

  IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
  IF editor.CursorY >= editor.ScrollY + 28 THEN editor.ScrollY = editor.CursorY - 27
  IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
  IF editor.CursorX >= editor.ScrollX + 56 THEN editor.ScrollX = editor.CursorX - 55

END SUB ' deleteSelection

''''''''''''''''''''''''
SUB displayFlashText

  IF flashTextTimer > 0 THEN
    COLOR sysColor.flashTextClr
    flashTextTimer = flashTextTimer - 1
    PrintTextLineWithBanners flashText$, sysColor.flashTextClr, BOTTOM
  END IF

END SUB ' displayFlashText

''''''''''''''''''''''''
SUB drawBorderBox (wPosX, wPosY, wSizeX, wSizeY, fgClr, bgClr)

  IF wSizeX <= 1 THEN EXIT SUB
  IF wSizeY <= 1 THEN EXIT SUB

  endX = wPosX + wSizeX - 1
  endY = wPosY + wSizeY - 1

  IF endX > SCREENSIZEX - 1 THEN endX = SCREENSIZEX - 1
  IF endY > SCREENSIZEY - 1 THEN endY = SCREENSIZEY - 1

  LINE (wPosX, wPosY)-(endX, endY), fgClr, B
  LINE (wPosX + 1, wPosY + 1)-(endX - 1, endY - 1), bgClr, BF

END SUB ' drawBorderBox

''''''''''''''''''''''''
SUB drawButtonsPMI

  editorBoxTop = editor.StartY

  funcListBoxH = (13 * 10) + 4
  tabH = 16
  tabY = editorBoxTop + funcListBoxH - 1

  hasCode = 0
  IF editor.LastLine > 1 THEN
    hasCode = 1
  ELSE
    IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
  END IF

  curExt$ = ".BAS"
  IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
  IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

  LEFT_BOX_X_NEW = 1

  btnSaveTxtW = 122
  btnSaveTxtH = 20
  btnSaveTxtX = LEFT_BOX_X_NEW
  btnSaveTxtY = tabY + tabH + 8

  IF hasCode = 0 THEN
    btnSaveTxtBg = sysColor.gray
  ELSE
    btnSaveTxtBg = editor.windowBarClr
  END IF

  drawBorderBox btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH, 15, btnSaveTxtBg
  PrintStr btnSaveTxtX + 28, btnSaveTxtY + 6, "SAVE FAST", 15, 0, 1

  btnLoadTxtW = 122
  btnLoadTxtH = 20
  btnLoadTxtX = btnSaveTxtX
  btnLoadTxtY = btnSaveTxtY + btnSaveTxtH + 8

  drawBorderBox btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH, 15, editor.windowBarClr
  PrintStr btnLoadTxtX + 28, btnLoadTxtY + 6, "LOAD FAST", 15, 0, 1

  btnCompileW = 122
  btnCompileH = 20
  btnCompileX = btnSaveTxtX
  btnCompileY = btnLoadTxtY + btnLoadTxtH + 8

  IF compileState <> COMP_IDLE OR hasCode = 0 THEN
    btnCompileBg = sysColor.gray
  ELSE
    btnCompileBg = editor.windowBarClr
  END IF

  drawBorderBox btnCompileX, btnCompileY, btnCompileW, btnCompileH, 15, btnCompileBg
  PrintStr btnCompileX + 33, btnCompileY + 6, "COMPILE", 15, 0, 1

  btnSearchW = 122
  btnSearchH = 20
  btnSearchX = btnSaveTxtX
  btnSearchY = btnCompileY + btnCompileH + 8

  IF hasCode = 0 THEN
    btnSearchBg = sysColor.gray
  ELSE
    btnSearchBg = editor.windowBarClr
  END IF

  drawBorderBox btnSearchX, btnSearchY, btnSearchW, btnSearchH, 15, btnSearchBg
  PrintStr btnSearchX + 37, btnSearchY + 6, "SEARCH", 15, 0, 1

  ' Protect from Z-Order click-through if top menu dropdown is active
  IF editor.TopMenuFocus = 0 THEN
    IF mouseClickedInBox(btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH) THEN
      IF hasCode = 1 THEN
        editor.Focus = 1
        addStatusMsg "SAVING " + fileNameBase$ + curExt$ + "..."

        drawBorderBox btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH, 15, sysColor.gray
        PrintStr btnSaveTxtX + 28, btnSaveTxtY + 6, "SAVE FAST", 15, 0, 1

        drawStatusPMI
        drawTopMenuAndScrollPMI
        drawFuncListPMI
        drawCornerPMI
        showCursorData 50, SCREENSIZEY - 48
        _DEST 0
        _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), logicalScreen, 0
        _DISPLAY
        _DEST logicalScreen

        fileCodeSave

        addStatusMsg "SAVED " + fileNameBase$ + curExt$
      END IF
    END IF

    IF mouseClickedInBox(btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH) THEN
      editor.Focus = 1
      tempName$ = fileNameBase$ + curExt$

      IF _FILEEXISTS(tempName$) THEN
        addStatusMsg "LOADING " + fileNameBase$ + curExt$ + "..."

        drawBorderBox btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH, 15, sysColor.gray
        PrintStr btnLoadTxtX + 28, btnLoadTxtY + 6, "LOAD FAST", 15, 0, 1

        drawStatusPMI
        drawTopMenuAndScrollPMI
        drawFuncListPMI
        drawCornerPMI
        showCursorData 50, SCREENSIZEY - 48
        _DEST 0
        _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), logicalScreen, 0
        _DISPLAY
        _DEST logicalScreen

        fileCodeLoad
        refineCode 0, 0

        editor.CursorX = 0
        editor.CursorY = 1
        editor.ScrollY = 1
        editor.ScrollX = 0
        editor.SelectStartX = 0
        editor.SelectStartY = 1
        editor.IsSelecting = 0
        editor.Focus = 1

        addStatusMsg "LOADED " + fileNameBase$ + curExt$
      ELSE
        throwCompilerError tempName$ + " DOES NOT EXIST", ASIS, 0
      END IF
    END IF

    IF mouseClickedInBox(btnCompileX, btnCompileY, btnCompileW, btnCompileH) THEN
      IF compileState = COMP_IDLE AND hasCode = 1 THEN
        editor.Focus = 1

        compileState = COMP_REFINE
        addStatusMsg "REFINING..."
        redrawAll
        dispScreenFlushUpdate

        statusMsgCount = 1
        editor.StatusScrollY = 1
        editor.StatusSelectedIndex = 0
        FOR ii = 1 TO 999
          statusMsg(ii).Text = ""
          statusMsg(ii).CodeLine = 0
        NEXT

        wFln$ = fileNameBase$ + ".exe"
        IF _FILEEXISTS(wFln$) THEN
          delCmd$ = "cmd /c del /F /Q " + CHR$(34) + wFln$ + CHR$(34)
          SHELL _HIDE delCmd$

          IF _FILEEXISTS(wFln$) THEN
            addStatusMsg "OUTPUT FILE IN USE, PAUSING"
            redrawAll
            dispScreenFlushUpdate
            waitTimer 1.5
          END IF
        END IF
      END IF
    END IF

    IF mouseClickedInBox(btnSearchX, btnSearchY, btnSearchW, btnSearchH) THEN
      IF hasCode = 1 THEN
        editor.Focus = 1
        modalSearch
      END IF
    END IF
  END IF

END SUB ' drawButtonsPMI

''''''''''''''''''''''''
SUB drawClearBox (wPosX, wPosY, wSizeX, wSizeY, fgClr)

  IF wSizeX <= 1 THEN EXIT SUB
  IF wSizeY <= 1 THEN EXIT SUB

  endX = wPosX + wSizeX - 1
  endY = wPosY + wSizeY - 1

  IF endX > SCREENSIZEX - 1 THEN endX = SCREENSIZEX - 1
  IF endY > SCREENSIZEY - 1 THEN endY = SCREENSIZEY - 1

  LINE (wPosX, wPosY)-(endX, endY), fgClr, B

END SUB ' drawClearBox

''''''''''''''''''''''''
SUB drawEditorPMI

  EDITOR_BOX_X_NEW = 172
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = EDITOR_BOX_X_NEW + LEFT_SPACING
  editorTextW = 56 * 8

  rowH = 8 + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = 29
  textH = textRows * rowH
  editorBoxH = textH + 3

  editorScrollBarX = editorTextX + editorTextW + 3
  editorScrollBarY = editorBoxTop
  editorScrollBarW = 10

  hScrollY = editorBoxY + textH
  hScrollX = 124
  hScrollW = editorScrollBarX - hScrollX

  IF editor.Focus = 1 THEN
    focusX = 123
    focusY = editorBoxTop - 1
    focusW = (editorScrollBarX + editorScrollBarW + 1) - focusX
    focusH = (editorBoxH + 8) + 2
    drawClearBox focusX, focusY, focusW, focusH, sysColor.focusBorder
  END IF

  newBoxX = 124
  newBoxW = (editorScrollBarX + editorScrollBarW) - newBoxX
  drawBorderBox newBoxX, editorBoxTop, newBoxW, editorBoxH + 9, 15, 0

  LINE (EDITOR_BOX_X_NEW, editorBoxTop)-(EDITOR_BOX_X_NEW, editorBoxTop + editorBoxH + 8), 15

  drawBorderBox hScrollX, hScrollY, hScrollW, 9, 15, 0

  drawBorderBox hScrollX, hScrollY, 10, 9, 15, 0
  drawBorderBox hScrollX + hScrollW - 9, hScrollY, 10, 9, 15, 0

  PrintChr hScrollX + 2, hScrollY + 1, CHR$(17), 15, 0, 1
  PrintChr hScrollX + hScrollW - 8, hScrollY + 1, CHR$(16), 15, 0, 1

  STATIC scanIdx AS LONG
  STATIC cachedMaxLen AS LONG
  STATIC tempMaxLen AS LONG

  maxLen = 0
  scanEnd = editor.ScrollY + textRows
  IF scanEnd > editor.LastLine THEN scanEnd = editor.LastLine

  FOR iy = editor.ScrollY TO scanEnd
    i2 = LEN(editorText$(iy))
    IF i2 > maxLen THEN maxLen = i2
  NEXT

  FOR stepIdx = 1 TO 1000
    scanIdx = scanIdx + 1
    IF scanIdx > editor.LastLine THEN
      cachedMaxLen = tempMaxLen
      tempMaxLen = 0
      scanIdx = 1
    END IF
    i2 = LEN(editorText$(scanIdx))
    IF i2 > tempMaxLen THEN tempMaxLen = i2
  NEXT

  IF cachedMaxLen > maxLen THEN maxLen = cachedMaxLen
  IF tempMaxLen > maxLen THEN maxLen = tempMaxLen

  maxScrollX = maxLen - 56 + 2
  IF maxScrollX < 0 THEN maxScrollX = 0
  IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX

  thumbWEd = hScrollW - 19
  IF maxScrollX = 0 THEN
    thumbSizeX = thumbWEd
    thumbXEd = hScrollX + 10
  ELSE
    thumbSizeX = (56 * thumbWEd) \ (maxLen + 2)
    IF thumbSizeX < 10 THEN thumbSizeX = 10
    thumbXEd = hScrollX + 10 + ((editor.ScrollX * (thumbWEd - thumbSizeX)) \ maxScrollX)
  END IF
  drawBorderBox thumbXEd, hScrollY + 1, thumbSizeX, 7, 2, 15

  FOR iy = 0 TO textRows - 1
    actualY = iy + editor.ScrollY
    lineNum = actualY
    numStr$ = LTRIM$(RTRIM$(STR$(lineNum)))
    numPosX = (EDITOR_BOX_X_NEW - 4) - (LEN(numStr$) * 8)

    IF actualY = editor.CursorY THEN
      lineColor = 15
    ELSE
      lineColor = 11
    END IF

    PrintStr numPosX, editorBoxY + (iy * rowH) + TEXT_GAP_TOP, numStr$, lineColor, 0, 1

    IF editor.IsSelecting = 1 THEN
      IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
        startY = editor.SelectStartY
        startX = editor.SelectStartX
        endY = editor.CursorY
        endX = editor.CursorX
      ELSE
        startY = editor.CursorY
        startX = editor.CursorX
        endY = editor.SelectStartY
        endX = editor.SelectStartX
      END IF

      IF actualY >= startY AND actualY <= endY THEN
        lineLen = LEN(editorText$(actualY))
        hlStartX = 0
        hlEndX = lineLen

        IF actualY = startY THEN hlStartX = startX
        IF actualY = endY THEN hlEndX = endX
        IF actualY < endY THEN hlEndX = lineLen + 1

        hlStartX = hlStartX - editor.ScrollX
        hlEndX = hlEndX - editor.ScrollX

        IF hlStartX < 0 THEN hlStartX = 0
        IF hlEndX > 56 THEN hlEndX = 56

        IF hlStartX < hlEndX THEN
          LINE (editorTextX + (hlStartX * 8), editorBoxY + (iy * rowH))-(editorTextX + (hlEndX * 8) - 1, editorBoxY + (iy * rowH) + rowH - 1), 1, BF
        END IF
      END IF
    END IF

    IF actualY <= EDITOR_LINE_MAX THEN
      IF editorText$(actualY) <> "" THEN
        printText$ = MID$(editorText$(actualY), editor.ScrollX + 1, 56)
        PrintStr editorTextX, editorBoxY + (iy * rowH) + TEXT_GAP_TOP, printText$, 15, 0, 1
      END IF
    END IF
  NEXT

  IF editor.Focus = 1 THEN
    IF editor.CursorY >= editor.ScrollY AND editor.CursorY < editor.ScrollY + textRows THEN
      IF editor.CursorX >= editor.ScrollX AND editor.CursorX < editor.ScrollX + 56 THEN
        cursorPixelX = editorTextX + ((editor.CursorX - editor.ScrollX) * 8)
        cursorPixelY = editorBoxY + ((editor.CursorY - editor.ScrollY) * rowH) + TEXT_GAP_TOP

        cursorBlink = INT(TIMER * 2) AND 1
        IF cursorBlink = 1 THEN
          PrintChr cursorPixelX, cursorPixelY, "*", 14, 0, 1
        ELSE
          PrintChr cursorPixelX, cursorPixelY, "_", 14, 0, 1
        END IF
      END IF
    END IF
  END IF

  lastLine = editor.LastLine
  IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

  IF mouse.Wheel <> 0 THEN
    IF mouseWithinBoxBounds(editorTextX, editorBoxTop, editorTextW + editorScrollBarW + 4, editorBoxH + 9) THEN
      editor.Focus = 1
      editor.ScrollY = editor.ScrollY + mouse.Wheel
      maxScroll = lastLine - 28
      IF maxScroll < 1 THEN maxScroll = 1
      IF editor.ScrollY > maxScroll THEN editor.ScrollY = maxScroll
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
    END IF
  END IF

  IF mouse.Clicked1 THEN
    lastActionWasTyping = 0
    editor.DragActive = 0
    editor.ScrollDragActiveX = 0

    IF mouseWithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) THEN
      editor.DragActive = 1
      editor.Focus = 1
      clickRelX = mouse.PosX - editorTextX
      clickRelY = mouse.PosY - editorBoxY
      newCX = (clickRelX \ 8) + editor.ScrollX
      newCY = (clickRelY \ rowH) + editor.ScrollY

      IF newCY <> editor.CursorY THEN
        refineCode editor.CursorY, 0
      END IF

      IF newCY > lastLine THEN newCY = lastLine

      lineLength = LEN(editorText$(newCY))
      IF newCX > lineLength THEN newCX = lineLength

      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        IF editor.IsSelecting = 0 THEN
          editor.SelectStartX = editor.CursorX
          editor.SelectStartY = editor.CursorY
          editor.IsSelecting = 1
        END IF
        editor.CursorX = newCX
        editor.CursorY = newCY
      ELSE
        IF editor.TextClickActive = 1 AND (TIMER - editor.TextLastClickTime) < 0.3 THEN
          editor.TextClickActive = 0
          editor.DragActive = 0

          lineStr$ = editorText$(newCY)
          lineLen = LEN(lineStr$)

          IF lineLen > 0 THEN
            clickPos = newCX + 1
            IF clickPos > lineLen THEN clickPos = lineLen

            ch$ = MID$(lineStr$, clickPos, 1)
            cType = 3
            IF ch$ = " " OR ch$ = CHR$(9) THEN
              cType = 1
            ELSE
              IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                cType = 2
              END IF
            END IF

            leftBound = clickPos - 1
            DO WHILE leftBound > 0
              ch$ = MID$(lineStr$, leftBound, 1)
              lType = 3
              IF ch$ = " " OR ch$ = CHR$(9) THEN
                lType = 1
              ELSE
                IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                  lType = 2
                END IF
              END IF
              IF lType <> cType THEN EXIT DO
              leftBound = leftBound - 1
            LOOP

            rightBound = clickPos + 1
            DO WHILE rightBound <= lineLen
              ch$ = MID$(lineStr$, rightBound, 1)
              rType = 3
              IF ch$ = " " OR ch$ = CHR$(9) THEN
                rType = 1
              ELSE
                IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                  rType = 2
                END IF
              END IF
              IF rType <> cType THEN EXIT DO
              rightBound = rightBound + 1
            LOOP

            editor.SelectStartX = leftBound
            editor.SelectStartY = newCY
            editor.CursorX = rightBound - 1
            editor.CursorY = newCY
            editor.IsSelecting = 1
          ELSE
            editor.SelectStartX = newCX
            editor.SelectStartY = newCY
            editor.IsSelecting = 0
            editor.CursorX = newCX
            editor.CursorY = newCY
          END IF
        ELSE
          editor.TextLastClickTime = TIMER
          editor.TextClickActive = 1
          editor.SelectStartX = newCX
          editor.SelectStartY = newCY
          editor.IsSelecting = 0
          editor.CursorX = newCX
          editor.CursorY = newCY
        END IF
      END IF
    END IF

    IF mouseWithinBoxBounds(124, editorBoxY, editorTextX - 124, textH) THEN
      editor.DragActive = 1
      editor.Focus = 1
      clickRelY = mouse.PosY - editorBoxY
      newCY = (clickRelY \ rowH) + editor.ScrollY

      IF newCY <> editor.CursorY THEN
        refineCode editor.CursorY, 0
      END IF

      IF newCY > lastLine THEN newCY = lastLine
      IF newCY < 1 THEN newCY = 1

      editor.CursorX = 0
      editor.CursorY = newCY
      editor.SelectStartX = 0
      editor.SelectStartY = newCY
      editor.IsSelecting = 0
    END IF

    IF mouseWithinBoxBounds(hScrollX, hScrollY, hScrollW, 9) THEN
      editor.Focus = 1
      IF mouseWithinBoxBounds(thumbXEd, hScrollY, thumbSizeX, 9) THEN
        editor.ScrollDragActiveX = 1
        editor.ScrollDragOffsetX = mouse.PosX - thumbXEd
      ELSE
        IF mouseWithinBoxBounds(hScrollX, hScrollY, 10, 9) THEN
          editor.ScrollX = editor.ScrollX - 1
          IF editor.ScrollX < 0 THEN editor.ScrollX = 0
        ELSE
          IF mouseWithinBoxBounds(hScrollX + hScrollW - 9, hScrollY, 10, 9) THEN
            editor.ScrollX = editor.ScrollX + 1
            IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
          ELSE
            IF mouse.PosX < thumbXEd THEN
              editor.ScrollX = editor.ScrollX - 10
              IF editor.ScrollX < 0 THEN editor.ScrollX = 0
            ELSE
              editor.ScrollX = editor.ScrollX + 10
              IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

  IF mouse.Button1Down AND mouse.Clicked1 = 0 THEN
    IF editor.Focus = 1 AND editor.DragActive = 1 THEN
      clickRelX = mouse.PosX - editorTextX
      clickRelY = mouse.PosY - editorBoxY
      newCX = (clickRelX \ 8) + editor.ScrollX
      newCY = (clickRelY \ rowH) + editor.ScrollY

      maxScroll = lastLine - 28
      IF maxScroll < 1 THEN maxScroll = 1

      IF mouse.PosY < editorBoxY THEN
        newCY = editor.ScrollY - 1
        IF newCY < 1 THEN newCY = 1
        editor.ScrollY = newCY
      END IF
      IF mouse.PosY >= editorBoxY + textH THEN
        newCY = editor.ScrollY + textRows
        editor.ScrollY = editor.ScrollY + 1
        IF editor.ScrollY > maxScroll THEN editor.ScrollY = maxScroll
      END IF

      IF mouse.PosX < editorTextX THEN
        newCX = editor.ScrollX - 1
        IF newCX < 0 THEN newCX = 0
        editor.ScrollX = newCX
      END IF
      IF mouse.PosX >= editorTextX + editorTextW THEN
        newCX = editor.ScrollX + 56
        editor.ScrollX = editor.ScrollX + 1
        IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
      END IF

      IF newCY < 1 THEN newCY = 1
      IF newCY > lastLine THEN newCY = lastLine

      lineLength = LEN(editorText$(newCY))
      IF newCX > lineLength THEN newCX = lineLength
      IF newCX < 0 THEN newCX = 0

      IF newCX <> editor.CursorX OR newCY <> editor.CursorY THEN
        editor.IsSelecting = 1
        editor.CursorX = newCX
        editor.CursorY = newCY
      END IF
    END IF
  END IF

  IF mouse.Button1Down AND editor.ScrollDragActiveX = 1 THEN
    IF maxScrollX > 0 THEN
      newThumbX = mouse.PosX - editor.ScrollDragOffsetX
      trackSizeX = thumbWEd - thumbSizeX
      IF trackSizeX > 0 THEN
        newScrollX = ((newThumbX - (hScrollX + 10)) * maxScrollX) \ trackSizeX
        IF newScrollX < 0 THEN newScrollX = 0
        IF newScrollX > maxScrollX THEN newScrollX = maxScrollX
        editor.ScrollX = newScrollX
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    editor.DragActive = 0
    editor.ScrollDragActiveX = 0
  END IF

  IF mouse.Released2 THEN
    IF mouseWithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) AND mouseDown2WithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) THEN
      editor.MenuMode = 1
    END IF
  END IF

END SUB ' drawEditorPMI

''''''''''''''''''''''''
SUB drawCornerPMI

  ' Renders the top right window control buttons and manages window state toggling such as fullscreen or exiting

  closeBtnW = 15
  closeBtnX = SCREENSIZEX - closeBtnW
  closeBtnY = 0
  closeBtnH = 13

  dropW = 35
  dropH = 15
  dropX = SCREENSIZEX - dropW
  dropY = 12

  minW = 16
  minH = 15
  minX = dropX - minW + 1
  minY = 12

  stateBtnX = minX
  stateBtnW = closeBtnX - minX + 1
  stateBtnY = 0
  stateBtnH = 13

  IF editor.TopMenuFocus = 4 THEN
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, sysColor.gray
    PrintStr closeBtnX + 4, closeBtnY + 3, "?", 15, 0, 1
  ELSE
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1
  END IF

  IF editor.WindowState = WIN_STATE_RES THEN stateText$ = "MED"
  IF editor.WindowState = WIN_STATE_MED THEN stateText$ = "MAX"
  IF editor.WindowState = WIN_STATE_MAX THEN stateText$ = "RES"

  drawBorderBox stateBtnX, stateBtnY, stateBtnW, stateBtnH, 15, editor.windowBarClr
  IF mouseWithinBoxBounds(stateBtnX, stateBtnY, stateBtnW, stateBtnH) THEN
    drawClearBox stateBtnX + 1, stateBtnY + 1, stateBtnW - 2, stateBtnH - 2, 9
  END IF
  PrintStr stateBtnX + 6, stateBtnY + 3, stateText$, 15, 0, 1

  IF editor.TopMenuFocus = 4 THEN
    drawBorderBox dropX, dropY, dropW, dropH, 15, editor.windowBarClr
    IF mouseWithinBoxBounds(dropX, dropY + 1, dropW, dropH - 1) THEN
      drawClearBox dropX + 1, dropY + 1, dropW - 2, dropH - 2, editor.CloseClr
    END IF
    PrintStr dropX + 6, dropY + 4, "END", 15, 0, 1

    drawBorderBox minX, minY, minW, minH, 15, editor.windowBarClr
    IF mouseWithinBoxBounds(minX, minY + 1, minW, minH - 1) THEN
      drawClearBox minX + 1, minY + 1, minW - 2, minH - 2, 9
    END IF

    LINE (minX + 4, minY + minH - 5)-(minX + minW - 5, minY + minH - 5), 15

    LINE (minX - 1, dropY)-(minX - 1, dropY + dropH), 0
    LINE (minX - 1, dropY + dropH)-(dropX + dropW - 1, dropY + dropH), 0

    IF keyCheck("SPACE") THEN
      editor.MenuClicked = 1
      editor.WindowState = editor.WindowState + 1
      IF editor.WindowState > 2 THEN editor.WindowState = 0
      applyWindowState
      editor.TopMenuFocus = 0
      waitKeyRelease "SPACE"
    END IF

    IF keyCheck("*") THEN
      editor.MenuClicked = 1
      drawClearBox dropX + 1, dropY + 1, dropW - 2, dropH - 2, editor.CloseClr
      dispScreenFlushUpdate
      waitTimer 0.1
      SYSTEM
    END IF
  END IF

  IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
    IF editor.TopMenuFocus = 4 THEN
      editor.TopMenuFocus = 0
    ELSE
      editor.TopMenuFocus = 4
      editor.Focus = 0
    END IF
    editor.MenuClicked = 1
  END IF

  IF mouseClickedInBox(stateBtnX, stateBtnY, stateBtnW, stateBtnH) THEN
    editor.MenuClicked = 1
    editor.WindowState = editor.WindowState + 1
    IF editor.WindowState > 2 THEN editor.WindowState = 0
    applyWindowState
    editor.TopMenuFocus = 0
  END IF

  IF editor.TopMenuFocus = 4 THEN
    IF mouseClickedInBox(dropX, dropY + 1, dropW, dropH - 1) THEN
      editor.MenuClicked = 1
      mouse.Released1 = 0
      SYSTEM
    END IF

    IF mouseClickedInBox(minX, minY + 1, minW, minH - 1) THEN
      editor.MenuClicked = 1
      _SCREENICON
      editor.TopMenuFocus = 0
    END IF

    IF mouseClickedInBox(SCREENSIZEX - 35, 0, 35, 27) THEN editor.MenuClicked = 1
  END IF

END SUB ' drawCornerPMI

''''''''''''''''''''''''
SUB drawFuncListPMI

  DIM copyGroupID AS _UNSIGNED LONG

  editorBoxTop = editor.StartY

  tabH = 16
  tab1W = 62
  tab2W = 61

  LEFT_BOX_X_NEW = 1

  funcListBoxX = LEFT_BOX_X_NEW
  funcListBoxY = editorBoxTop
  funcListBoxW = 122
  funcListBoxH = (13 * 10) + 4

  tab1X = LEFT_BOX_X_NEW
  tab2X = LEFT_BOX_X_NEW + 61
  tabY = funcListBoxY + funcListBoxH - 1

  scrollBarX = funcListBoxX + funcListBoxW - 10
  scrollBarY = funcListBoxY
  scrollBarW = 10
  scrollBarH = funcListBoxH

  IF editor.MenuMode = 0 THEN
    tab1Bg = 19
    tab2Bg = sysColor.gray
  ELSE
    tab1Bg = sysColor.gray
    tab2Bg = 19
  END IF

  drawBorderBox funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH, 15, 0

  drawBorderBox tab1X, tabY, tab1W, tabH, 15, tab1Bg
  PrintStr tab1X + 16, tabY + 4, "FUNC", 15, 0, 1

  drawBorderBox tab2X, tabY, tab2W, tabH, 15, tab2Bg
  PrintStr tab2X + 17, tabY + 4, "EDIT", 15, 0, 1

  maxLines = 12

  IF editor.MenuMode = 0 THEN
    processVScrollbar SCROLL_FUNC, scrollBarX, scrollBarY, scrollBarW, scrollBarH, uiSubCount, maxLines, 0

    PrintStr funcListBoxX + 25, funcListBoxY + 4, "GO TO TOP", 15, 0, 1
    FOR ii = 0 TO 11
      subIdx = ii + editor.FuncScroll.ScrollY
      IF subIdx < uiSubCount THEN
        sOutName$ = LEFT$(uiSubName$(subIdx), 13)

        isCurrent = 0
        startLine = uiSubLine(subIdx)
        endLine = editor.LastLine
        IF subIdx + 1 < uiSubCount THEN
          endLine = uiSubLine(subIdx + 1) - 1
        END IF

        IF editor.CursorY >= startLine AND editor.CursorY <= endLine THEN
          isCurrent = 1
        END IF

        IF isCurrent = 1 THEN
          listColor = 15
        ELSE
          listColor = 11
        END IF

        PrintStr funcListBoxX + RIGHT_BOX_SPACING, funcListBoxY + ((ii + 1) * 10) + 4, sOutName$, listColor, 0, 1
      END IF
    NEXT
  ELSE
    IF editor.MenuMode = 1 THEN
      hasSelection = 0
      IF editor.IsSelecting = 1 THEN
        IF editor.CursorY <> editor.SelectStartY OR editor.CursorX <> editor.SelectStartX THEN
          hasSelection = 1
        END IF
      END IF

      IF hasSelection = 1 THEN
        PrintStr funcListBoxX + 15, funcListBoxY + 4, "CUT", 15, 0, 1
        PrintStr funcListBoxX + 15, funcListBoxY + 14, "COPY", 15, 0, 1
      ELSE
        PrintStr funcListBoxX + 15, funcListBoxY + 4, "NO TEXT", sysColor.gray, 0, 1
        PrintStr funcListBoxX + 15, funcListBoxY + 14, "SELECTED", sysColor.gray, 0, 1
      END IF

      PrintStr funcListBoxX + 15, funcListBoxY + 24, "PASTE", 15, 0, 1
      PrintStr funcListBoxX + 15, funcListBoxY + 34, "CANCEL", 15, 0, 1
    ELSE
      IF editor.MenuMode = 2 THEN
        PrintStr funcListBoxX + 15, funcListBoxY + 4, "COPY", 15, 0, 1
        PrintStr funcListBoxX + 15, funcListBoxY + 14, "CANCEL", 15, 0, 1
      END IF
    END IF
  END IF

  IF mouse.Wheel <> 0 THEN
    IF editor.TopMenuFocus = 0 THEN
      IF mouseWithinBoxBounds(funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH) THEN
        editor.FuncScroll.ScrollY = editor.FuncScroll.ScrollY + mouse.Wheel
        maxFuncScroll = uiSubCount - maxLines
        IF maxFuncScroll < 0 THEN maxFuncScroll = 0
        IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
        IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    IF editor.TopMenuFocus = 0 THEN
      wasMenuMode1 = 0
      wasMenuMode2 = 0

      IF mouseClickedInBox(tab1X, tabY, tab1W, tabH) THEN
        editor.MenuMode = 0
      END IF

      IF mouseClickedInBox(tab2X, tabY, tab2W, tabH) THEN
        editor.MenuMode = 1
      END IF

      IF editor.MenuMode = 1 THEN
        wasMenuMode1 = 1

        hasSelection = 0
        IF editor.IsSelecting = 1 THEN
          IF editor.CursorY <> editor.SelectStartY OR editor.CursorX <> editor.SelectStartX THEN
            hasSelection = 1
          END IF
        END IF

        IF hasSelection = 1 THEN
          IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3, funcListBoxW, 10) THEN
            rowY = funcListBoxY + 3
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
            PrintStr funcListBoxX + 15, rowY + 1, "CUT", 15, 0, 1
            dispScreenFlushUpdate
            waitTimer UI_FLASH_TIME

            undo_StateSave
            lastActionWasTyping = 0

            copyText$ = retEditorSelection$
            IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
            deleteSelection
            editor.IsSelecting = 0
            editor.MenuMode = 0
          END IF

          IF mouseClickedInBox(funcListBoxX, funcListBoxY + 13, funcListBoxW, 10) THEN
            rowY = funcListBoxY + 13
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
            PrintStr funcListBoxX + 15, rowY + 1, "COPY", 15, 0, 1
            dispScreenFlushUpdate
            waitTimer UI_FLASH_TIME

            copyText$ = retEditorSelection$
            IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
            editor.MenuMode = 0
          END IF
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 23, funcListBoxW, 10) THEN
          rowY = funcListBoxY + 23
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
          PrintStr funcListBoxX + 15, rowY + 1, "PASTE", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          undo_StateSave
          lastActionWasTyping = 0

          pasteClipboardText
          editor.MenuMode = 0
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 33, funcListBoxW, 10) THEN
          rowY = funcListBoxY + 33
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
          PrintStr funcListBoxX + 15, rowY + 1, "CANCEL", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          editor.MenuMode = 0
        END IF
      END IF

      IF editor.MenuMode = 2 THEN
        wasMenuMode2 = 1

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3, funcListBoxW, 10) THEN
          rowY = funcListBoxY + 3
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
          PrintStr funcListBoxX + 15, rowY + 1, "COPY", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          hlStart = editor.StatusSelectedIndex
          hlEnd = editor.StatusSelectedIndex
          IF hlStart > 0 THEN
            copyGroupID = statusMsg(hlStart).GroupID
            IF copyGroupID > 0 THEN
              DO WHILE hlStart > 1
                IF statusMsg(hlStart - 1).GroupID = copyGroupID THEN
                  hlStart = hlStart - 1
                ELSE
                  EXIT DO
                END IF
              LOOP
              DO WHILE hlEnd < statusMsgCount - 1
                IF statusMsg(hlEnd + 1).GroupID = copyGroupID THEN
                  hlEnd = hlEnd + 1
                ELSE
                  EXIT DO
                END IF
              LOOP
            END IF
          END IF

          copyText$ = ""
          FOR ii = hlStart TO hlEnd
            copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
            IF ii < hlEnd THEN copyText$ = copyText$ + " "
          NEXT
          IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$

          editor.MenuMode = 0
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 13, funcListBoxW, 10) THEN
          rowY = funcListBoxY + 13
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + 9), 1, BF
          PrintStr funcListBoxX + 15, rowY + 1, "CANCEL", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          editor.MenuMode = 0
        END IF

        IF mouseWithinBoxBounds(funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH) = 0 AND mouseWithinBoxBounds(tab1X, tabY, funcListBoxW, tabH) = 0 THEN
          editor.MenuMode = 0
        END IF
      END IF

      IF wasMenuMode1 = 0 AND wasMenuMode2 = 0 THEN
        IF editor.MenuMode = 0 THEN
          IF mouseClickedInBox(funcListBoxX, funcListBoxY, funcListBoxW - 10, funcListBoxH) THEN
            clickRelY = mouse.PosY - (funcListBoxY + 3)
            IF clickRelY < 0 THEN clickRelY = 0
            clickedRow = clickRelY \ 10
            IF clickedRow = 0 THEN
              rowY = funcListBoxY + 3
              LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 11, rowY + 9), 1, BF
              PrintStr funcListBoxX + 25, rowY + 1, "GO TO TOP", 15, 0, 1
              dispScreenFlushUpdate
              waitTimer UI_FLASH_TIME

              editor.CursorY = 1
              editor.CursorX = 0
              editor.ScrollY = 1
              editor.ScrollX = 0
              editor.SelectStartX = 0
              editor.SelectStartY = 1
              editor.IsSelecting = 0
            ELSE
              subIdx = (clickedRow - 1) + editor.FuncScroll.ScrollY
              IF subIdx < uiSubCount THEN
                rowY = funcListBoxY + 3 + (clickedRow * 10)
                LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 11, rowY + 9), 1, BF
                PrintStr funcListBoxX + RIGHT_BOX_SPACING, rowY + 1, LEFT$(uiSubName$(subIdx), 13), 15, 0, 1
                dispScreenFlushUpdate
                waitTimer UI_FLASH_TIME

                editor.CursorY = uiSubLine(subIdx)
                editor.CursorX = 0
                editor.ScrollY = editor.CursorY - 14
                IF editor.ScrollY < 1 THEN editor.ScrollY = 1
                editor.ScrollX = 0
                editor.SelectStartX = 0
                editor.SelectStartY = 1
                editor.IsSelecting = 0
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

END SUB ' drawFuncListPMI

''''''''''''''''''''''''
SUB drawStatusPMI

  EDITOR_BOX_X_NEW = 172
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = EDITOR_BOX_X_NEW + LEFT_SPACING
  editorTextW = 56 * 8

  rowH = 8 + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = 29
  textH = textRows * rowH
  editorBoxH = textH + 3

  statusBoxX = 124
  statusBoxY = editorBoxY + editorBoxH + 9
  statusBoxW = 505
  statusBoxH = 38

  scrollBarX = statusBoxX + statusBoxW - 1
  scrollBarY = statusBoxY
  scrollBarW = 10
  scrollBarH = statusBoxH

  IF editor.Focus = 2 THEN
    sFocusX = statusBoxX - 1
    sFocusY = statusBoxY - 1
    sFocusW = (scrollBarX + scrollBarW + 1) - sFocusX
    sFocusH = statusBoxH + 2
    drawClearBox sFocusX, sFocusY, sFocusW, sFocusH, sysColor.focusBorder
  END IF

  drawBorderBox statusBoxX, statusBoxY, statusBoxW, statusBoxH, 15, 0

  maxLines = (statusBoxH - 5) \ 11

  processVScrollbar SCROLL_STATUS, scrollBarX, scrollBarY, scrollBarW, scrollBarH, (statusMsgCount - 1), maxLines, 1

  hlStart = editor.StatusSelectedIndex
  hlEnd = editor.StatusSelectedIndex
  IF hlStart > 0 THEN
    sLine = statusMsg(hlStart).CodeLine
    IF sLine > 0 THEN
      DO WHILE hlStart > 1
        IF statusMsg(hlStart - 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
          hlStart = hlStart - 1
        ELSE
          EXIT DO
        END IF
      LOOP
      DO WHILE hlEnd < statusMsgCount - 1
        IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
          hlEnd = hlEnd + 1
        ELSE
          EXIT DO
        END IF
      LOOP
    END IF
  END IF

  lineY = statusBoxY + 4
  linesDrawn = 0
  FOR ii = editor.StatusScrollY TO statusMsgCount - 1
    IF linesDrawn >= maxLines THEN EXIT FOR

    isHighlighted = 0
    IF (editor.Focus = 2 OR editor.MenuMode = 2) AND editor.StatusSelectedIndex > 0 THEN
      IF ii >= hlStart AND ii <= hlEnd THEN isHighlighted = 1
    END IF

    IF isHighlighted = 1 THEN
      LINE (statusBoxX + 1, lineY - 1)-(scrollBarX - 1, lineY + 9), 1, BF
      PrintStr statusBoxX + LEFT_SPACING, lineY, statusMsg(ii).Text, 15, 0, 1
    ELSE
      PrintStr statusBoxX + LEFT_SPACING, lineY, statusMsg(ii).Text, 14, 0, 1
    END IF

    lineY = lineY + 11
    linesDrawn = linesDrawn + 1
  NEXT

  IF mouse.Wheel <> 0 THEN
    IF mouseWithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW, statusBoxH) THEN
      editor.Focus = 2
      editor.StatusScrollY = editor.StatusScrollY + mouse.Wheel
      IF (statusMsgCount - 1) > maxLines THEN
        IF editor.StatusScrollY > statusMsgCount - maxLines THEN editor.StatusScrollY = statusMsgCount - maxLines
      ELSE
        editor.StatusScrollY = 1
      END IF
      IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
    END IF
  END IF

  IF mouse.Clicked1 THEN
    IF mouseWithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW, statusBoxH) THEN
      editor.Focus = 2
    END IF
  END IF

  IF mouse.Released1 THEN
    IF mouseClickedInBox(statusBoxX, statusBoxY, statusBoxW, statusBoxH) THEN
      clickRelY = mouse.PosY - (statusBoxY + 3)
      IF clickRelY < 0 THEN clickRelY = 0
      clickedRow = clickRelY \ 11
      IF clickedRow >= 0 AND clickedRow < maxLines THEN
        msgIdx = editor.StatusScrollY + clickedRow
        IF msgIdx > 0 AND msgIdx < statusMsgCount THEN
          editor.StatusSelectedIndex = msgIdx

          errLine = statusMsg(msgIdx).CodeLine
          IF errLine > 0 THEN
            editor.CursorY = errLine
            editor.CursorX = 0
            editor.ScrollY = errLine - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = errLine
            editor.IsSelecting = 0
            editor.Focus = 1
          END IF
        ELSE
          editor.StatusSelectedIndex = 0
        END IF
      ELSE
        editor.StatusSelectedIndex = 0
      END IF
    END IF
  END IF

  IF mouse.Released2 THEN
    IF mouseWithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW, statusBoxH) THEN
      IF mouseDown2WithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW, statusBoxH) THEN
        clickRelY = mouse.PosY - (statusBoxY + 3)
        IF clickRelY < 0 THEN clickRelY = 0
        clickedRow = clickRelY \ 11
        IF clickedRow >= 0 AND clickedRow < maxLines THEN
          msgIdx = editor.StatusScrollY + clickedRow
          IF msgIdx > 0 AND msgIdx < statusMsgCount THEN
            editor.StatusSelectedIndex = msgIdx
            editor.Focus = 2
            editor.MenuMode = 2
          END IF
        END IF
      END IF
    END IF
  END IF

END SUB ' drawStatusPMI

''''''''''''''''''''''''
SUB drawTopMenuAndScrollPMI

  EDITOR_BOX_X_NEW = 172
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = EDITOR_BOX_X_NEW + LEFT_SPACING
  editorTextW = 56 * 8

  rowH = 8 + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = 29
  textH = textRows * rowH
  editorBoxH = textH + 3

  editorScrollBarX = editorTextX + editorTextW + 3
  editorScrollBarY = editorBoxTop
  editorScrollBarW = 10
  editorScrollBarH = textH + 4

  hScrollY = editorBoxY + textH

  LINE (0, 0)-(SCREENSIZEX - 1, 12), editor.windowBarClr, BF

  activeName$ = ""
  IF uiSubCount > 0 THEN
    FOR ii = 0 TO uiSubCount - 1
      startLine = uiSubLine(ii)
      endLine = editor.LastLine
      IF ii + 1 < uiSubCount THEN
        endLine = uiSubLine(ii + 1) - 1
      END IF

      IF editor.CursorY >= startLine AND editor.CursorY <= endLine THEN
        activeName$ = uiSubName$(ii)
        EXIT FOR
      END IF
    NEXT
  END IF

  IF activeName$ <> "" THEN
    namePixelWidth = LEN(activeName$) * 8
    nameCenterX = (SCREENSIZEX \ 2) - (namePixelWidth \ 2)
    PrintStr nameCenterX, 3, activeName$, 15, 0, 1
  END IF

  DIM fileMenu$(3)
  fileMenu$(0) = "OPEN"
  fileMenu$(1) = "SAVE AS"
  fileMenu$(2) = "NEW"
  fileMenu$(3) = "IMPORT"

  IF editor.TopMenuFocus = MENU_FILE THEN
    drawClearBox 4, 1, 34, 11, 9
    PrintStr 6, 3, "FILE", 15, 0, 1

    ff = processDropdownMenu(4, 12, 4, fileMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
    END IF

    curExt$ = ".BAS"
    IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
    IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

    fnBoxX = 75
    fnBoxY = 12
    fnBoxW = 17 + (LEN(fileNameBase$ + curExt$) * 8)
    fnBoxH = 17

    LINE (fnBoxX, fnBoxY + 1)-(fnBoxX + fnBoxW - 2, fnBoxY + fnBoxH - 2), editor.windowBarClr, BF
    LINE (fnBoxX, fnBoxY)-(fnBoxX + fnBoxW - 1, fnBoxY), 15
    LINE (fnBoxX + fnBoxW - 1, fnBoxY)-(fnBoxX + fnBoxW - 1, fnBoxY + fnBoxH - 1), 15
    LINE (fnBoxX, fnBoxY + fnBoxH - 1)-(fnBoxX + fnBoxW - 1, fnBoxY + fnBoxH - 1), 15

    PrintStr 84, 17, fileNameBase$ + curExt$, 11, 0, 1

    IF ff = 1 THEN
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0
        modalFileMenuOpen
      END IF
      IF clickedIdx = 1 THEN
        editor.TopMenuFocus = 0
        modalFileMenuSave
      END IF
      IF clickedIdx = 2 THEN
        editor.TopMenuFocus = 0
        modalFileMenuNew
      END IF
      IF clickedIdx = 3 THEN
        editor.TopMenuFocus = 0
        modalImportFileMenu
      END IF
    END IF
  ELSE
    PrintStr 6, 3, "FILE", 15, 0, 1
  END IF

  DIM editMenu$(0)
  IF undoState.Ready = 1 THEN
    editMenu$(0) = "UNDO"
  ELSE
    editMenu$(0) = "~UNDO"
  END IF

  IF editor.TopMenuFocus = MENU_EDIT THEN
    drawClearBox 44, 1, 34, 11, 9
    PrintStr 46, 3, "EDIT", 15, 0, 1

    ff = processDropdownMenu(44, 12, 1, editMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0
        undo_StateRestore
      END IF
    END IF
  ELSE
    PrintStr 46, 3, "EDIT", 15, 0, 1
  END IF

  DIM viewMenu$(1)
  IF uiSubCount > 0 THEN
    viewMenu$(0) = "VIEW SUBS"
  ELSE
    viewMenu$(0) = "~VIEW SUBS"
  END IF
  viewMenu$(1) = "GO TO LINE"

  IF editor.TopMenuFocus = MENU_VIEW THEN
    drawClearBox 84, 1, 34, 11, 9
    PrintStr 86, 3, "VIEW", 15, 0, 1

    ff = processDropdownMenu(84, 12, 2, viewMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0
        modalViewSubs
      END IF
      IF clickedIdx = 1 THEN
        editor.TopMenuFocus = 0
        modalGoToLine
      END IF
    END IF
  ELSE
    PrintStr 86, 3, "VIEW", 15, 0, 1
  END IF

  hasCode = 0
  IF editor.LastLine > 1 THEN
    hasCode = 1
  ELSE
    IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
  END IF

  DIM toolMenu$(0)
  IF hasCode = 1 AND compileState = COMP_IDLE THEN
    toolMenu$(0) = "COMPILE"
  ELSE
    toolMenu$(0) = "~COMPILE"
  END IF

  IF editor.TopMenuFocus = MENU_TOOL THEN
    drawClearBox 124, 1, 34, 11, 9
    PrintStr 126, 3, "TOOL", 15, 0, 1

    ff = processDropdownMenu(124, 12, 1, toolMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0

        IF compileState = COMP_IDLE AND hasCode = 1 THEN
          compileState = COMP_REFINE
          addStatusMsg "REFINING..."
          redrawAll
          dispScreenFlushUpdate

          statusMsgCount = 1
          editor.StatusScrollY = 1
          editor.StatusSelectedIndex = 0
          FOR ii = 1 TO 999
            statusMsg(ii).Text = ""
            statusMsg(ii).CodeLine = 0
          NEXT

          wFln$ = fileNameBase$ + ".exe"
          IF _FILEEXISTS(wFln$) THEN
            delCmd$ = "cmd /c del /F /Q " + CHR$(34) + wFln$ + CHR$(34)
            SHELL _HIDE delCmd$

            IF _FILEEXISTS(wFln$) THEN
              addStatusMsg "OUTPUT FILE IN USE, PAUSING"
              redrawAll
              dispScreenFlushUpdate
              waitTimer 1.5
            END IF
          END IF
        END IF
      END IF
    END IF
  ELSE
    PrintStr 126, 3, "TOOL", 15, 0, 1
  END IF

  lastLine = editor.LastLine
  IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

  processVScrollbar SCROLL_MAIN, editorScrollBarX, editorScrollBarY, editorScrollBarW, editorScrollBarH, lastLine, textRows, 1

  drawBorderBox editorScrollBarX, hScrollY, editorScrollBarW, 9, 15, 0

  IF mouse.Clicked1 THEN
    IF mouseWithinBoxBounds(editorScrollBarX, editorScrollBarY, editorScrollBarW, editorScrollBarH) THEN
      editor.Focus = 1
    END IF

    IF mouseWithinBoxBounds(editorScrollBarX, hScrollY, editorScrollBarW, 9) THEN
      editor.Focus = 1
      IF editor.CornerClickActive = 1 AND (TIMER - editor.CornerLastClickTime) < 0.25 THEN
        lastLine = editor.LastLine
        IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

        maxScroll = lastLine - 28
        IF maxScroll < 1 THEN maxScroll = 1

        editor.ScrollY = maxScroll
        editor.CursorY = lastLine
        editor.CursorX = 0
        editor.CornerClickActive = 0
      ELSE
        editor.CornerLastClickTime = TIMER
        editor.CornerClickActive = 1
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    IF mouseClickedInBox(4, 0, 32, 13) THEN
      IF editor.TopMenuFocus = MENU_FILE THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_FILE
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF

    IF mouseClickedInBox(44, 0, 32, 13) THEN
      IF editor.TopMenuFocus = MENU_EDIT THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_EDIT
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF

    IF mouseClickedInBox(84, 0, 32, 13) THEN
      IF editor.TopMenuFocus = MENU_VIEW THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_VIEW
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF

    IF mouseClickedInBox(124, 0, 32, 13) THEN
      IF editor.TopMenuFocus = MENU_TOOL THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_TOOL
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF
  END IF

END SUB ' drawTopMenuAndScrollPMI

''''''''''''''''''''''''
FUNCTION hexLen$ (wVal, wLen)

  outStr$ = HEX$(wVal)
  FOR ii = 0 TO 2
    IF LEN(outStr$) < wLen THEN
      outStr$ = "0" + outStr$
    END IF
  NEXT

  hexLen$ = outStr$

END FUNCTION ' hexLen$

''''''''''''''''''''''''
SUB initColors

  sysColor.flashTextClr = 14
  sysColor.gray = 8
  sysColor.focusBorder = 10

  editor.windowBarClr = 208
  editor.CloseClr = 32

END SUB ' initColors

''''''''''''''''''''''''
SUB initFileNames

  fileNameBase$ = "DFLTNAME"
  fileNameErr$ = "ErrorReport.txt"
  editor.FileExtensionMode = FILE_EXT_BAS

END SUB ' initFileNames

''''''''''''''''''''''''
FUNCTION keyCheck (rsKeyString$) ' KeyCheck fast (Follow up with waitKeyRelease to use as slow option)

  wStr$ = UCASE$(rsKeyString$) ' The character that's being checked for. Should be sent uppercase, but just in case
  ' since _KEYDOWN does not return a value, this function polls for key presses and return the value pressed
  ' This function will also help keep track of the special codes that keyDown uses. Only the
  ' codes that have specifically been entered, plus a-z, A-Z (calculated by formula) will work
  ' Returns the value of the key pressed. if keyCheck(whatever$) works just fine, because it
  ' checks to see if the return is greater than zero

  rVal = 0 ' In case we want to copy into a global "last key pressed" tracker

  IF wStr$ = "*" THEN ' * KEY
    IF _KEYDOWN(42) THEN
      keyCheck = 42
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "ESC" THEN ' Escape key
    IF _KEYDOWN(27) THEN
      keyCheck = 27
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "SPACE" THEN ' Space key
    IF _KEYDOWN(32) THEN
      keyCheck = 32
      EXIT FUNCTION
    END IF
  END IF

  IF wStr$ = "TAB" THEN ' Tab key
    IF _KEYDOWN(9) THEN
      keyCheck = 9
      EXIT FUNCTION
    END IF
  END IF

  ' Detect a-z, A-Z, these match ASCII exactly
  IF LEN(wStr$) = 1 THEN ' Handles characters A-Z, uppercase A is 65
    wVal = ASC(wStr$)
    IF ((wVal >= 65) AND (wVal <= 90)) OR ((wVal >= 97) AND (wVal <= 122)) THEN
      IF _KEYDOWN(wVal) OR _KEYDOWN(wVal + 32) THEN ' The +32 is for lowercase
        keyCheck = wVal
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF LEN(wStr$) = 2 AND MID$(wStr$, 1, 1) = "F" THEN ' Handles characters A-Z, uppercase A is 65

    SELECT CASE MID$(wStr$, 2, 1)

      CASE "1": rVal = 15104
      CASE "2": rVal = 15360
      CASE "3": rVal = 15616
      CASE "4": rVal = 15872
      CASE "5": rVal = 16128
      CASE "6": rVal = 16384
      CASE "7": rVal = 16640
      CASE "8": rVal = 16896
      CASE "9": rVal = 17152
      CASE "A": rVal = 17408
      CASE "B": rVal = 34048
      CASE "C": rVal = 34304
      CASE ELSE: EXIT FUNCTION

    END SELECT ' MID$(wStr$, 2, 1)

    IF _KEYDOWN(rVal) THEN
      keyCheck = rVal
      EXIT FUNCTION
    ELSE
      keyCheck = 0
      EXIT FUNCTION
    END IF

  END IF ' a-z, A-Z

  IF wStr$ = "0" THEN ' KEY 0, KEY INS
    IF _KEYDOWN(48) OR _KEYDOWN(20992) THEN rVal = 48
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Arrow keys and number pad for controls (not used yet)
  IF wStr$ = "2" OR wStr$ = "DOWN" THEN
    IF _KEYDOWN(50) OR _KEYDOWN(20480) THEN rVal = 50 ' KEY 2, KEY DOWN
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "3" THEN
    IF _KEYDOWN(51) OR _KEYDOWN(20736) THEN rVal = 51 ' KEY 3
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "4" OR wStr$ = "LEFT" THEN
    IF _KEYDOWN(52) OR _KEYDOWN(19200) THEN rVal = 52 ' KEY 4, KEY LEFT
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "6" OR wStr$ = "RIGHT" THEN
    IF _KEYDOWN(54) OR _KEYDOWN(19712) THEN rVal = 54 ' KEY 6, KEY RIGHT
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "8" OR wStr$ = "UP" THEN
    IF _KEYDOWN(56) OR _KEYDOWN(18432) THEN rVal = 56 ' KEY 8, KEY UP
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key - or key _
  IF wStr$ = "-" THEN
    IF _KEYDOWN(45) OR _KEYDOWN(95) THEN rVal = 45
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key = or key +
  IF wStr$ = "=" THEN
    IF _KEYDOWN(61) OR _KEYDOWN(43) THEN rVal = 61
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  ' Key \ (right above enter on the keyboard)
  IF wStr$ = "\" THEN
    IF _KEYDOWN(124) OR _KEYDOWN(92) THEN rVal = 124
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "<" THEN
    IF _KEYDOWN(60) OR _KEYDOWN(44) THEN rVal = 60
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = ">" THEN
    IF _KEYDOWN(62) OR _KEYDOWN(46) THEN rVal = 62
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "'" THEN
    IF _KEYDOWN(34) OR _KEYDOWN(39) THEN rVal = 34
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "/" THEN
    IF _KEYDOWN(63) OR _KEYDOWN(47) THEN rVal = 63
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "ENT" THEN ' ENTER key
    IF _KEYDOWN(13) THEN rVal = 13
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "PGUP" THEN
    IF _KEYDOWN(18688) THEN rVal = 18688
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "PGDN" THEN
    IF _KEYDOWN(20736) THEN rVal = 20736
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "HOME" THEN
    IF _KEYDOWN(18176) THEN rVal = 18176
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "END" THEN
    IF _KEYDOWN(20224) THEN rVal = 20224
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "[" THEN ' Key [ or {
    IF _KEYDOWN(123) OR _KEYDOWN(91) THEN rVal = 123
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  IF wStr$ = "]" THEN ' Key ] or }
    IF _KEYDOWN(125) OR _KEYDOWN(93) THEN rVal = 125
    keyCheck = rVal
    EXIT FUNCTION
  END IF

  keyCheck = rVal ' Always returns uppercase equivalent

END FUNCTION ' keyCheck

''''''''''''''''''''''''
SUB limitSpeed

  ' Only throttle program execution speed to 60 FPS if there is no compilation active
  IF compileState = COMP_IDLE THEN
    _LIMIT 60
  END IF

END SUB ' limitSpeed

''''''''''''''''''''''''
SUB loadFontPixelRow (wFontSet, wGroupX, wGroupY, wRow, wData0$, wData1$, wData2$, wData3$)

  DIM offsetX
  DIM offsetY
  DIM fontHeight
  DIM ix
  DIM cAs
  DIM pixColor
  DIM rowData$

  fontHeight = 8

  IF wFontSet = 1 THEN
    fontHeight = 16
  END IF

  offsetX = wGroupX * 32
  offsetY = (wGroupY * fontHeight) + wRow
  rowData$ = wData0$ + wData1$ + wData2$ + wData3$

  FOR ix = 0 TO 31
    cAs = ASC(rowData$, ix + 1)

    IF cAs = 32 THEN
      pixColor = 0
    ELSE
      IF cAs >= 48 AND cAs <= 57 THEN
        pixColor = cAs - 48
      ELSE
        IF cAs >= 65 AND cAs <= 70 THEN
          pixColor = cAs - 55
        ELSE
          pixColor = 0
        END IF
      END IF
    END IF

    IF wFontSet = 1 THEN
      fontData16(offsetX + ix, offsetY) = pixColor
    ELSE
      fontData(offsetX + ix, offsetY) = pixColor
    END IF
  NEXT

END SUB ' loadFontPixelRow

''''''''''''''''''''''''
SUB initLayout

  DIM wa AS dataTypeRect
  DIM ff AS LONG

  editor.StartY = 15

  editor.CursorY = 1
  editor.ScrollY = 1
  editor.LastLine = 1
  editor.SelectStartY = 1
  editor.TabSize = 2

  editorText$(0) = "LINE 0: YOU SHOULD NEVER SEE THIS"
  compileText$(0) = "LINE 0: YOU SHOULD NEVER SEE THIS"

  statusMsg(0).Text = "LINE 0: YOU SHOULD NEVER SEE THIS"
  statusMsg(0).CodeLine = 0
  statusMsgCount = 1
  editor.StatusScrollY = 1
  editor.StatusSelectedIndex = 0

  layout.FramebufSize = FRAMEBUF_MAX_WIDTH * FRAMEBUF_MAX_HEIGHT
  layout.GfxBufEntrySize = 256

  tempSize = layout.GfxBufEntrySize
  shiftCount = 0
  DO WHILE tempSize > 1
    tempSize = tempSize \ 2
    shiftCount = shiftCount + 1
  LOOP
  layout.GfxBufEntryShift = shiftCount

  IF (2 ^ layout.GfxBufEntryShift) <> layout.GfxBufEntrySize THEN
    ESCAPETEXT "COMPILER FAIL: GfxBufEntryShift calculation failed"
  END IF

  ' Record the true native resolution of the monitor
  nativeScreenWidth = _DESKTOPWIDTH
  nativeScreenHeight = _DESKTOPHEIGHT

  ' Determine the taskbar height by subtracting the Windows work area height from the native screen height
  ff = SystemParametersInfoA&(SPI_GETWORKAREA, 0, _OFFSET(wa), 0)
  IF ff <> 0 AND wa.Bottom > wa.Top THEN
    taskbarHeight = nativeScreenHeight - (wa.Bottom - wa.Top)
  ELSE
    taskbarHeight = 0
  END IF

END SUB ' initLayout

''''''''''''''''''''''''
SUB initPalettesBmp

  ' 0-15 Standard VGA-style palette
  bmpPal256(0, palRED) = 0: bmpPal256(0, palGREEN) = 0: bmpPal256(0, palBLUE) = 0 ' Black
  bmpPal256(1, palRED) = 0: bmpPal256(1, palGREEN) = 0: bmpPal256(1, palBLUE) = 170 ' Blue
  bmpPal256(2, palRED) = 0: bmpPal256(2, palGREEN) = 170: bmpPal256(2, palBLUE) = 0 ' Green
  bmpPal256(3, palRED) = 0: bmpPal256(3, palGREEN) = 170: bmpPal256(3, palBLUE) = 170 ' Cyan
  bmpPal256(4, palRED) = 170: bmpPal256(4, palGREEN) = 0: bmpPal256(4, palBLUE) = 0 ' Red
  bmpPal256(5, palRED) = 170: bmpPal256(5, palGREEN) = 0: bmpPal256(5, palBLUE) = 170 ' Magenta
  bmpPal256(6, palRED) = 170: bmpPal256(6, palGREEN) = 85: bmpPal256(6, palBLUE) = 0 ' Brown
  bmpPal256(7, palRED) = 170: bmpPal256(7, palGREEN) = 170: bmpPal256(7, palBLUE) = 170 ' Light Gray
  bmpPal256(8, palRED) = 85: bmpPal256(8, palGREEN) = 85: bmpPal256(8, palBLUE) = 85 ' Dark Gray
  bmpPal256(9, palRED) = 85: bmpPal256(9, palGREEN) = 85: bmpPal256(9, palBLUE) = 255 ' Light Blue
  bmpPal256(10, palRED) = 85: bmpPal256(10, palGREEN) = 255: bmpPal256(10, palBLUE) = 85 ' Light Green
  bmpPal256(11, palRED) = 85: bmpPal256(11, palGREEN) = 255: bmpPal256(11, palBLUE) = 255 ' Light Cyan
  bmpPal256(12, palRED) = 255: bmpPal256(12, palGREEN) = 85: bmpPal256(12, palBLUE) = 85 ' Light Red
  bmpPal256(13, palRED) = 255: bmpPal256(13, palGREEN) = 85: bmpPal256(13, palBLUE) = 255 ' Light Magenta
  bmpPal256(14, palRED) = 255: bmpPal256(14, palGREEN) = 255: bmpPal256(14, palBLUE) = 85 ' Yellow
  bmpPal256(15, palRED) = 255: bmpPal256(15, palGREEN) = 255: bmpPal256(15, palBLUE) = 255 ' Bright White

  ' 16-191 Red spectrum: dim red to bright red
  FOR ii = 16 TO 191
    redVal = ((ii - 16) * 255) \ 175
    bmpPal256(ii, palRED) = redVal
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 192-255 Blue spectrum: dark blue to bright blue
  FOR ii = 192 TO 255
    blueVal = ((ii - 192) * 255) \ 63
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = blueVal
  NEXT

END SUB ' initPalettesBmp

''''''''''''''''''''''''
SUB initPalettesOutput

  ' 0-15 Standard VGA-style palette for output.exe
  outputPal(0, palRED) = 0: outputPal(0, palGREEN) = 0: outputPal(0, palBLUE) = 0 ' Black
  outputPal(1, palRED) = 0: outputPal(1, palGREEN) = 0: outputPal(1, palBLUE) = 170 ' Blue
  outputPal(2, palRED) = 0: outputPal(2, palGREEN) = 170: outputPal(2, palBLUE) = 0 ' Green
  outputPal(3, palRED) = 0: outputPal(3, palGREEN) = 170: outputPal(3, palBLUE) = 170 ' Cyan
  outputPal(4, palRED) = 170: outputPal(4, palGREEN) = 0: outputPal(4, palBLUE) = 0 ' Red
  outputPal(5, palRED) = 170: outputPal(5, palGREEN) = 0: outputPal(5, palBLUE) = 170 ' Magenta
  outputPal(6, palRED) = 170: outputPal(6, palGREEN) = 85: outputPal(6, palBLUE) = 0 ' Brown
  outputPal(7, palRED) = 170: outputPal(7, palGREEN) = 170: outputPal(7, palBLUE) = 170 ' Light Gray
  outputPal(8, palRED) = 85: outputPal(8, palGREEN) = 85: outputPal(8, palBLUE) = 85 ' Dark Gray
  outputPal(9, palRED) = 85: outputPal(9, palGREEN) = 85: outputPal(9, palBLUE) = 255 ' Light Blue
  outputPal(10, palRED) = 85: outputPal(10, palGREEN) = 255: outputPal(10, palBLUE) = 85 ' Light Green
  outputPal(11, palRED) = 85: outputPal(11, palGREEN) = 255: outputPal(11, palBLUE) = 255 ' Light Cyan
  outputPal(12, palRED) = 255: outputPal(12, palGREEN) = 85: outputPal(12, palBLUE) = 85 ' Light Red
  outputPal(13, palRED) = 255: outputPal(13, palGREEN) = 85: outputPal(13, palBLUE) = 255 ' Light Magenta
  outputPal(14, palRED) = 255: outputPal(14, palGREEN) = 255: outputPal(14, palBLUE) = 85 ' Yellow
  outputPal(15, palRED) = 255: outputPal(15, palGREEN) = 255: outputPal(15, palBLUE) = 255 ' Bright White

  ' 16-31 QBasic SCREEN 13 grayscale ramp
  grayLevelData$ = "00050811141720242832364045505663"

  FOR grayIndex = 0 TO 15
    grayLevel = VAL(MID$(grayLevelData$, grayIndex * 2 + 1, 2))
    grayValue = (grayLevel * 255 + 31) \ 63

    outputPal(grayIndex + 16, palRED) = grayValue
    outputPal(grayIndex + 16, palGREEN) = grayValue
    outputPal(grayIndex + 16, palBLUE) = grayValue
  NEXT grayIndex

  ' 32-247 QBasic SCREEN 13 color cycles
  paletteLevelData$ = "001631476331394755634549545863000714212814172124282022242628000408121608101214161112131516"
  paletteLevelMap$ = "444443210000000001234444"
  paletteIndex = 32

  FOR ringIndex = 0 TO 8
    FOR hueIndex = 0 TO 23
      redPosition = hueIndex + 16
      IF redPosition > 23 THEN redPosition = redPosition - 24

      greenPosition = hueIndex + 8
      IF greenPosition > 23 THEN greenPosition = greenPosition - 24

      bluePosition = hueIndex

      redLevelIndex = VAL(MID$(paletteLevelMap$, redPosition + 1, 1))
      greenLevelIndex = VAL(MID$(paletteLevelMap$, greenPosition + 1, 1))
      blueLevelIndex = VAL(MID$(paletteLevelMap$, bluePosition + 1, 1))

      redLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + redLevelIndex * 2 + 1, 2))
      greenLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + greenLevelIndex * 2 + 1, 2))
      blueLevel = VAL(MID$(paletteLevelData$, ringIndex * 10 + blueLevelIndex * 2 + 1, 2))

      outputPal(paletteIndex, palRED) = (redLevel * 255 + 31) \ 63
      outputPal(paletteIndex, palGREEN) = (greenLevel * 255 + 31) \ 63
      outputPal(paletteIndex, palBLUE) = (blueLevel * 255 + 31) \ 63

      paletteIndex = paletteIndex + 1
    NEXT hueIndex
  NEXT ringIndex

  ' 248-255 Reserved black entries
  FOR paletteIndex = 248 TO 255
    outputPal(paletteIndex, palRED) = 0
    outputPal(paletteIndex, palGREEN) = 0
    outputPal(paletteIndex, palBLUE) = 0
  NEXT paletteIndex

END SUB ' initPalettesOutput

''''''''''''''''''''''''
SUB initPalettesVGA

  ' 0-15 Standard VGA-style palette
  bmpPal256(0, palRED) = 0: bmpPal256(0, palGREEN) = 0: bmpPal256(0, palBLUE) = 0 ' Black
  bmpPal256(1, palRED) = 0: bmpPal256(1, palGREEN) = 0: bmpPal256(1, palBLUE) = 170 ' Blue
  bmpPal256(2, palRED) = 0: bmpPal256(2, palGREEN) = 170: bmpPal256(2, palBLUE) = 0 ' Green
  bmpPal256(3, palRED) = 0: bmpPal256(3, palGREEN) = 170: bmpPal256(3, palBLUE) = 170 ' Cyan
  bmpPal256(4, palRED) = 170: bmpPal256(4, palGREEN) = 0: bmpPal256(4, palBLUE) = 0 ' Red
  bmpPal256(5, palRED) = 170: bmpPal256(5, palGREEN) = 0: bmpPal256(5, palBLUE) = 170 ' Magenta
  bmpPal256(6, palRED) = 170: bmpPal256(6, palGREEN) = 85: bmpPal256(6, palBLUE) = 0 ' Brown
  bmpPal256(7, palRED) = 170: bmpPal256(7, palGREEN) = 170: bmpPal256(7, palBLUE) = 170 ' Light gray
  bmpPal256(8, palRED) = 85: bmpPal256(8, palGREEN) = 85: bmpPal256(8, palBLUE) = 85 ' Dark gray
  bmpPal256(9, palRED) = 85: bmpPal256(9, palGREEN) = 85: bmpPal256(9, palBLUE) = 255 ' Light blue
  bmpPal256(10, palRED) = 85: bmpPal256(10, palGREEN) = 255: bmpPal256(10, palBLUE) = 85 ' Light green
  bmpPal256(11, palRED) = 85: bmpPal256(11, palGREEN) = 255: bmpPal256(11, palBLUE) = 255 ' Light cyan
  bmpPal256(12, palRED) = 255: bmpPal256(12, palGREEN) = 85: bmpPal256(12, palBLUE) = 85 ' Light red
  bmpPal256(13, palRED) = 255: bmpPal256(13, palGREEN) = 85: bmpPal256(13, palBLUE) = 255 ' Light magenta
  bmpPal256(14, palRED) = 255: bmpPal256(14, palGREEN) = 255: bmpPal256(14, palBLUE) = 85 ' Yellow
  bmpPal256(15, palRED) = 255: bmpPal256(15, palGREEN) = 255: bmpPal256(15, palBLUE) = 255 ' Bright white

  ' 17-31 Green spectrum: dark green to light green
  FOR ii = 17 TO 31
    greenVal = 48 + (((ii - 17) * 207) \ 14)
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = greenVal
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 32-191 Red spectrum: dark red to bright red
  FOR ii = 32 TO 191
    redVal = ((ii - 32) * 255) \ 159
    bmpPal256(ii, palRED) = redVal
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = 0
  NEXT

  ' 192-255 Blue spectrum: dark blue to bright blue
  FOR ii = 192 TO 255
    blueVal = ((ii - 192) * 255) \ 63
    bmpPal256(ii, palRED) = 0
    bmpPal256(ii, palGREEN) = 0
    bmpPal256(ii, palBLUE) = blueVal
  NEXT

END SUB ' initPalettesVGA

''''''''''''''''''''''''
FUNCTION mouseClickedInBox (wStartX, wStartY, wSizeX, wSizeY)

  tempRet = 0

  IF mouse.Released1 THEN
    IF mouseWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
      IF mouseDownWithinBoxBounds(wStartX, wStartY, wSizeX, wSizeY) THEN
        tempRet = 1
      END IF
    END IF
  END IF

  mouseClickedInBox = tempRet

END FUNCTION ' mouseClickedInBox

''''''''''''''''''''''''
FUNCTION mouseDownWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX >= wStartX AND mouse.DownPosX <= (wStartX + wSizeX - 1) AND mouse.DownPosY >= wStartY AND mouse.DownPosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDownWithinBoxBounds = toRet

END FUNCTION ' mouseDownWithinBoxBounds
''''''''''''''''''''''''
FUNCTION mouseDown2WithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  toRet = 0

  IF mouse.DownPosX2 >= wStartX AND mouse.DownPosX2 <= (wStartX + wSizeX - 1) AND mouse.DownPosY2 >= wStartY AND mouse.DownPosY2 <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseDown2WithinBoxBounds = toRet

END FUNCTION ' mouseDown2WithinBoxBounds

''''''''''''''''''''''''
SUB mouseReadInput

  mouse.Released1 = 0
  mouse.Released2 = 0
  mouse.Clicked1 = 0
  mouse.Clicked2 = 0
  mouse.Wheel = 0

  DO WHILE _MOUSEINPUT

    rawMouseX = _MOUSEX
    rawMouseY = _MOUSEY

    ' Downscale the physical screen mouse inputs directly into the 640x360 logic layout
    mouse.PosX = (rawMouseX * SCREENSIZEX) \ physicalScreenX
    mouse.PosY = (rawMouseY * SCREENSIZEY) \ physicalScreenY

    IF mouse.PosX < 0 THEN mouse.PosX = 0
    IF mouse.PosY < 0 THEN mouse.PosY = 0
    IF mouse.PosX > SCREENSIZEX - 1 THEN mouse.PosX = SCREENSIZEX - 1
    IF mouse.PosY > SCREENSIZEY - 1 THEN mouse.PosY = SCREENSIZEY - 1

    mouse.Wheel = mouse.Wheel + _MOUSEWHEEL

    pollMouse1Button = _MOUSEBUTTON(1)
    IF pollMouse1Button <> mouse.Button1Down THEN
      IF pollMouse1Button THEN
        mouse.Clicked1 = 1
        mouse.DownPosX = mouse.PosX
        mouse.DownPosY = mouse.PosY
      ELSE
        mouse.Released1 = 1
      END IF
      mouse.Button1Down = pollMouse1Button
    END IF

    pollMouse2Button = _MOUSEBUTTON(2)
    IF pollMouse2Button <> mouse.Button2Down THEN
      IF pollMouse2Button THEN
        mouse.Clicked2 = 1
        mouse.DownPosX2 = mouse.PosX
        mouse.DownPosY2 = mouse.PosY
      ELSE
        mouse.Released2 = 1
      END IF
      mouse.Button2Down = pollMouse2Button
      EXIT SUB
    END IF

  LOOP

END SUB ' mouseReadInput

''''''''''''''''''''''''
FUNCTION mouseWithinBoxBounds (wStartX, wStartY, wSizeX, wSizeY)

  ' We use a slightly more forgiving check to handle edge-of-screen jitter
  ' wSizeX and wSizeY are the dimensions, so the right edge is wStartX + wSizeX - 1

  toRet = 0

  ' Use <= to ensure the final pixel is included
  ' We also add a small safety margin if the click is at the absolute screen edge
  IF mouse.PosX >= wStartX AND mouse.PosX <= (wStartX + wSizeX - 1) AND mouse.PosY >= wStartY AND mouse.PosY <= (wStartY + wSizeY - 1) THEN
    toRet = 1
  END IF

  mouseWithinBoxBounds = toRet

END FUNCTION ' mouseWithinBoxBounds

''''''''''''''''''''''''
SUB modalFileMenuNew

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 80
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 32, boxY + 3, "NEW FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - 132, boxY + 24, "ALL UNSAVED PROGRESS WILL BE LOST", 15, 0, 1

    btnYesW = 64
    btnYesH = 20
    btnYesX = boxX + (boxW \ 2) - btnYesW - 16
    btnYesY = boxY + 46

    btnNoW = 64
    btnNoH = 20
    btnNoX = boxX + (boxW \ 2) + 16
    btnNoY = boxY + 46

    drawBorderBox btnYesX, btnYesY, btnYesW, btnYesH, 15, 0
    PrintStr btnYesX + 20, btnYesY + 6, "YES", 15, 0, 1

    drawBorderBox btnNoX, btnNoY, btnNoW, btnNoH, 15, 0
    PrintStr btnNoX + 24, btnNoY + 6, "NO", 15, 0, 1

    dispScreenFlushUpdate

    doNewFile = 0

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        doNewFile = 1
      END IF
    END IF

    IF mouseClickedInBox(btnYesX, btnYesY, btnYesW, btnYesH) THEN
      doNewFile = 1
    END IF

    IF mouseClickedInBox(btnNoX, btnNoY, btnNoW, btnNoH) THEN
      EXIT DO
    END IF

    IF doNewFile = 1 THEN
      FOR ii = 1 TO EDITOR_LINE_MAX
        editorText$(ii) = ""
      NEXT
      editor.LastLine = 1
      editor.CursorX = 0
      editor.CursorY = 1
      editor.ScrollX = 0
      editor.ScrollY = 1
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.IsSelecting = 0
      undoState.Ready = 0
      lastActionWasTyping = 0
      fileNameBase$ = "DFLTNAME"
      editor.FileExtensionMode = FILE_EXT_BAS
      refineCode 0, 0
      addStatusMsg "NEW FILE CREATED"
      EXIT DO
    END IF

  LOOP

END SUB ' modalFileMenuNew

''''''''''''''''''''''''
SUB modalFileMenuOpen

  DIM fileList$(1000)
  DIM fileCount AS LONG

  _DEST logicalScreen

  fileCount = 0

  oldClip$ = _CLIPBOARD$
  _CLIPBOARD$ = ""
  SHELL _HIDE "cmd /c (dir /b /a-d *.bas *.blb *.txt 2>nul & echo [[[QBERRDONE]]]) | clip"

  tTime = TIMER
  DO
    limitSpeed
    cb$ = _CLIPBOARD$
    IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
    IF TIMER - tTime > 1.5 THEN EXIT DO
  LOOP

  _CLIPBOARD$ = oldClip$

  markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
  IF markerPos > 0 THEN
    cb$ = LEFT$(cb$, markerPos - 1)
  END IF

  ix = 1
  cbLen = LEN(cb$)
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cb$, CHR$(10))
    IF nextNl = 0 THEN
      fName$ = MID$(cb$, ix)
      ix = cbLen + 1
    ELSE
      fName$ = MID$(cb$, ix, nextNl - ix)
      ix = nextNl + 1
    END IF

    fName$ = LTRIM$(RTRIM$(fName$))
    IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

    IF fName$ <> "" THEN
      IF fileCount < 1000 THEN
        fileList$(fileCount) = fName$
        fileCount = fileCount + 1
      END IF
    END IF
  LOOP

  IF fileCount = 0 THEN
    addStatusMsg "NO SOURCE FILES FOUND"
    EXIT SUB
  END IF

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (9 * 4), boxY + 3, "OPEN FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    ' Scrollbar
    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO maxLines - 1
      fIdx = ii + editor.ModalScroll.ScrollY
      IF fIdx < fileCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = fileList$(fIdx)
        IF LEN(sOutName$) > 20 THEN sOutName$ = LEFT$(sOutName$, 20)

        ' Hover
        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            cleanName$ = fileList$(fIdx)
            dotPos = 0
            FOR iDot = LEN(cleanName$) TO 1 STEP -1
              IF MID$(cleanName$, iDot, 1) = "." THEN dotPos = iDot: EXIT FOR
            NEXT

            IF dotPos > 0 THEN
              extStr$ = UCASE$(MID$(cleanName$, dotPos))
              cleanName$ = LEFT$(cleanName$, dotPos - 1)
              IF extStr$ = ".TXT" THEN
                editor.FileExtensionMode = FILE_EXT_TXT
              ELSE
                IF extStr$ = ".BLB" THEN
                  editor.FileExtensionMode = FILE_EXT_BLB
                ELSE
                  editor.FileExtensionMode = FILE_EXT_BAS
                END IF
              END IF
            ELSE
              editor.FileExtensionMode = FILE_EXT_BAS
            END IF

            fileNameBase$ = cleanName$
            fileCodeLoad
            refineCode 0, 0

            editor.CursorY = 1
            editor.CursorX = 0
            editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = 1
            editor.IsSelecting = 0
            editor.Focus = 1

            curExt$ = ".BAS"
            IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
            IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

            addStatusMsg "LOADED " + fileNameBase$ + curExt$

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

  _DEST logicalScreen

END SUB ' modalFileMenuOpen

''''''''''''''''''''''''
SUB modalFileMenuSave

  saveAsName$ = fileNameBase$

  _KEYCLEAR

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 28, boxY + 3, "SAVE AS", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, saveAsName$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF saveAsName$ <> "" THEN
          cleanName$ = saveAsName$
          dotPos = 0
          FOR iDot = LEN(cleanName$) TO 1 STEP -1
            IF MID$(cleanName$, iDot, 1) = "." THEN dotPos = iDot: EXIT FOR
          NEXT

          IF dotPos > 0 THEN
            extStr$ = UCASE$(MID$(cleanName$, dotPos))
            cleanName$ = LEFT$(cleanName$, dotPos - 1)
            IF extStr$ = ".TXT" THEN
              editor.FileExtensionMode = FILE_EXT_TXT
            ELSE
              IF extStr$ = ".BLB" THEN
                editor.FileExtensionMode = FILE_EXT_BLB
              ELSE
                editor.FileExtensionMode = FILE_EXT_BAS
              END IF
            END IF
          END IF

          fileNameBase$ = cleanName$

          curExt$ = ".BAS"
          IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
          IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

          fileCodeSave
          addStatusMsg "SAVED AS " + fileNameBase$ + curExt$
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(saveAsName$)
        IF qLen > 0 THEN
          saveAsName$ = LEFT$(saveAsName$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(saveAsName$) < 34 THEN
            saveAsName$ = saveAsName$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalFileMenuSave

''''''''''''''''''''''''
SUB modalGoToLine

  _KEYCLEAR

  goToStr$ = ""

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 160
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + 40, boxY + 3, "GO TO LINE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, goToStr$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF goToStr$ <> "" THEN
          targetLine = VAL(goToStr$)
          IF targetLine > 0 THEN
            IF targetLine > editor.LastLine THEN targetLine = editor.LastLine
            editor.CursorY = targetLine
            editor.CursorX = 0
            editor.ScrollY = targetLine - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = targetLine
            editor.IsSelecting = 0
            editor.Focus = 1
          END IF
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(goToStr$)
        IF qLen > 0 THEN
          goToStr$ = LEFT$(goToStr$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 48 AND kVal <= 57 THEN ' Numbers only
          IF LEN(goToStr$) < 6 THEN
            goToStr$ = goToStr$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalGoToLine

''''''''''''''''''''''''
SUB modalImportFileMenu

  DIM fileList$(1000)
  DIM fileCount AS LONG

  _DEST logicalScreen

  fileCount = 0

  oldClip$ = _CLIPBOARD$
  _CLIPBOARD$ = ""
  SHELL _HIDE "cmd /c (dir /b /a-d *.bas *.blb 2>nul & echo [[[QBERRDONE]]]) | clip"

  tTime = TIMER
  DO
    limitSpeed
    cb$ = _CLIPBOARD$
    IF INSTR(cb$, "[[[QBERRDONE]]]") > 0 THEN EXIT DO
    IF TIMER - tTime > 1.5 THEN EXIT DO
  LOOP

  _CLIPBOARD$ = oldClip$

  markerPos = INSTR(cb$, "[[[QBERRDONE]]]")
  IF markerPos > 0 THEN
    cb$ = LEFT$(cb$, markerPos - 1)
  END IF

  ix = 1
  cbLen = LEN(cb$)
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cb$, CHR$(10))
    IF nextNl = 0 THEN
      fName$ = MID$(cb$, ix)
      ix = cbLen + 1
    ELSE
      fName$ = MID$(cb$, ix, nextNl - ix)
      ix = nextNl + 1
    END IF

    fName$ = LTRIM$(RTRIM$(fName$))
    IF RIGHT$(fName$, 1) = CHR$(13) THEN fName$ = LEFT$(fName$, LEN(fName$) - 1)

    IF fName$ <> "" THEN
      IF fileCount < 1000 THEN
        fileList$(fileCount) = fName$
        fileCount = fileCount + 1
      END IF
    END IF
  LOOP

  IF fileCount = 0 THEN
    addStatusMsg "NO BAS OR BLB FILES FOUND"
    EXIT SUB
  END IF

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  ' Ensure clean key state
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (11 * 4), boxY + 3, "IMPORT FILE", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    ' Scrollbar
    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, fileCount, maxLines, 0

    ' Mouse wheel
    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = fileCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    ' Draw items
    FOR ii = 0 TO maxLines - 1
      fIdx = ii + editor.ModalScroll.ScrollY
      IF fIdx < fileCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = fileList$(fIdx)
        IF LEN(sOutName$) > 20 THEN sOutName$ = LEFT$(sOutName$, 20)

        ' Hover
        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            undo_StateSave
            lastActionWasTyping = 0

            fileCodeImport fileList$(fIdx)
            refineCode 0, 0

            ' Jump view to the bottom where the imported code was injected
            editor.CursorY = editor.LastLine
            editor.CursorX = 0
            editor.ScrollY = editor.CursorY - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = editor.LastLine
            editor.IsSelecting = 0
            editor.Focus = 1

            addStatusMsg "IMPORTED " + fileList$(fIdx)

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

END SUB ' modalImportFileMenu

''''''''''''''''''''''''
SUB modalSearch

  ' Give the modal a clean slate to prevent double-triggering inputs
  _KEYCLEAR

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    _DEST logicalScreen

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 320
    boxH = 64
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr
    PrintStr boxX + (boxW \ 2) - 44, boxY + 3, "SEARCH FIND", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    ' Input box
    inputBoxX = boxX + 16
    inputBoxY = boxY + 24
    inputBoxW = boxW - 32
    inputBoxH = 16
    drawBorderBox inputBoxX, inputBoxY, inputBoxW, inputBoxH, 15, 0

    ' Draw text
    PrintStr inputBoxX + 4, inputBoxY + 4, editorSearchQuery$ + "_", 15, 0, 1

    dispScreenFlushUpdate

    kVal = _KEYHIT
    IF kVal <> 0 THEN
      IF kVal = 27 THEN ' ESC
        waitKeyRelease "ESC"
        EXIT DO
      END IF

      IF kVal = 13 THEN ' ENTER
        IF editorSearchQuery$ <> "" THEN
          findEditorNext
        END IF
        EXIT DO
      END IF

      IF kVal = 8 THEN ' Backspace
        qLen = LEN(editorSearchQuery$)
        IF qLen > 0 THEN
          editorSearchQuery$ = LEFT$(editorSearchQuery$, qLen - 1)
        END IF
      ELSE
        IF kVal >= 32 AND kVal <= 126 THEN
          IF LEN(editorSearchQuery$) < 34 THEN
            editorSearchQuery$ = editorSearchQuery$ + CHR$(kVal)
          END IF
        END IF
      END IF
    END IF

  LOOP

END SUB ' modalSearch

''''''''''''''''''''''''
SUB modalViewSubs

  editor.ModalScroll.ScrollY = 0
  editor.ModalScroll.DragActive = 0
  editor.ModalScroll.DragOffset = 0

  refineCode 0, 0

  _DEST logicalScreen

  DO
    limitSpeed
    mouseReadInput

    tempWheel = mouse.Wheel
    tempClicked1 = mouse.Clicked1
    tempClicked2 = mouse.Clicked2
    tempReleased1 = mouse.Released1
    tempReleased2 = mouse.Released2
    tempDown1 = mouse.Button1Down
    tempDown2 = mouse.Button2Down

    mouse.Wheel = 0
    mouse.Clicked1 = 0
    mouse.Clicked2 = 0
    mouse.Released1 = 0
    mouse.Released2 = 0
    mouse.Button1Down = 0
    mouse.Button2Down = 0

    redrawAll

    mouse.Wheel = tempWheel
    mouse.Clicked1 = tempClicked1
    mouse.Clicked2 = tempClicked2
    mouse.Released1 = tempReleased1
    mouse.Released2 = tempReleased2
    mouse.Button1Down = tempDown1
    mouse.Button2Down = tempDown2

    boxW = 200
    boxH = 240
    boxX = (SCREENSIZEX - boxW) \ 2
    boxY = (SCREENSIZEY - boxH) \ 2

    drawBorderBox boxX, boxY, boxW, boxH, 15, editor.windowBarClr

    closeBtnW = 15
    closeBtnH = 13
    closeBtnX = boxX + boxW - closeBtnW
    closeBtnY = boxY
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1

    IF mouseClickedInBox(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      EXIT DO
    END IF

    PrintStr boxX + (boxW \ 2) - (15 * 4), boxY + 3, "SUBS / FUNCTIONS", 14, 0, 1
    LINE (boxX, boxY + 13)-(boxX + boxW - 1, boxY + 13), 15

    itemH = 10
    maxLines = (boxH - 15) \ itemH

    scrollBarX = boxX + boxW - 12
    scrollBarY = boxY + 14
    scrollBarW = 12
    scrollBarH = boxH - 15

    processVScrollbar SCROLL_MODAL, scrollBarX, scrollBarY, scrollBarW, scrollBarH, uiSubCount, maxLines, 0

    IF mouse.Wheel <> 0 THEN
      IF mouseWithinBoxBounds(boxX, boxY, boxW, boxH) THEN
        editor.ModalScroll.ScrollY = editor.ModalScroll.ScrollY + mouse.Wheel
        maxScroll = uiSubCount - maxLines
        IF maxScroll < 0 THEN maxScroll = 0
        IF editor.ModalScroll.ScrollY > maxScroll THEN editor.ModalScroll.ScrollY = maxScroll
        IF editor.ModalScroll.ScrollY < 0 THEN editor.ModalScroll.ScrollY = 0
      END IF
    END IF

    FOR ii = 0 TO maxLines - 1
      subIdx = ii + editor.ModalScroll.ScrollY
      IF subIdx < uiSubCount THEN
        itemY = boxY + 14 + (ii * itemH)
        sOutName$ = uiSubName$(subIdx)

        IF mouseWithinBoxBounds(boxX + 2, itemY, boxW - 16, itemH) THEN
          drawClearBox boxX + 2, itemY, boxW - 16, itemH, 9

          IF mouseClickedInBox(boxX + 2, itemY, boxW - 16, itemH) THEN
            IF subIdx < editor.FuncScroll.ScrollY OR subIdx >= editor.FuncScroll.ScrollY + 12 THEN
              editor.FuncScroll.ScrollY = subIdx - 5
              IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
              maxFuncScroll = uiSubCount - 12
              IF maxFuncScroll < 0 THEN maxFuncScroll = 0
              IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
              drawFuncListPMI
            END IF

            LEFT_BOX_X_NEW = 1
            funcListBoxX = LEFT_BOX_X_NEW
            funcListBoxY = editor.StartY
            funcListBoxW = 122
            rowY = funcListBoxY + 3 + ((subIdx - editor.FuncScroll.ScrollY + 1) * 10)
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 11, rowY + 9), 1, BF
            PrintStr funcListBoxX + RIGHT_BOX_SPACING, rowY + 1, LEFT$(uiSubName$(subIdx), 13), 15, 0, 1

            LINE (boxX + 2, itemY)-(boxX + boxW - 15, itemY + itemH - 1), 1, BF
            PrintStr boxX + 8, itemY + 1, sOutName$, 15, 0, 1

            dispScreenFlushUpdate

            waitTimer UI_FLASH_TIME

            editor.CursorY = uiSubLine(subIdx)
            editor.CursorX = 0
            editor.ScrollY = editor.CursorY - 14
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = 1
            editor.IsSelecting = 0
            editor.Focus = 1

            EXIT DO
          END IF
        END IF

        PrintStr boxX + 8, itemY + 1, sOutName$, 11, 0, 1
      END IF
    NEXT

    dispScreenFlushUpdate

    kVal = keyCheck("ESC")
    IF kVal = 27 THEN
      waitKeyRelease "ESC"
      EXIT DO
    END IF

  LOOP

END SUB ' modalViewSubs

''''''''''''''''''''''''
SUB overlayScaledTransparent (rsSourceImage, rsTargetImage, rsTransparentClr)

  DIM sourceImage AS LONG
  DIM targetImage AS LONG
  DIM transparentClr AS LONG
  DIM sourceWidth AS LONG
  DIM sourceHeight AS LONG
  DIM targetWidth AS LONG
  DIM targetHeight AS LONG
  DIM minX AS LONG
  DIM minY AS LONG
  DIM maxX AS LONG
  DIM maxY AS LONG
  DIM targetX1 AS LONG
  DIM targetY1 AS LONG
  DIM targetX2 AS LONG
  DIM targetY2 AS LONG
  DIM sampleX AS LONG
  DIM sampleY AS LONG
  DIM pixelClr AS LONG
  DIM foundPixel AS LONG

  sourceImage = rsSourceImage
  targetImage = rsTargetImage
  transparentClr = rsTransparentClr

  sourceWidth = _WIDTH(sourceImage)
  sourceHeight = _HEIGHT(sourceImage)
  targetWidth = _WIDTH(targetImage)
  targetHeight = _HEIGHT(targetImage)

  foundPixel = 0

  _SOURCE sourceImage

  FOR iy = 0 TO sourceHeight - 1
    FOR ix = 0 TO sourceWidth - 1

      pixelClr = POINT(ix, iy)

      IF pixelClr <> transparentClr THEN

        IF foundPixel = 0 THEN

          minX = ix
          minY = iy
          maxX = ix
          maxY = iy
          foundPixel = 1

        ELSE

          IF ix < minX THEN minX = ix
          IF iy < minY THEN minY = iy
          IF ix > maxX THEN maxX = ix
          IF iy > maxY THEN maxY = iy

        END IF

      END IF

    NEXT
  NEXT

  IF foundPixel = 0 THEN
    _SOURCE 0
    EXIT SUB
  END IF

  targetX1 = (minX * targetWidth) \ sourceWidth
  targetY1 = (minY * targetHeight) \ sourceHeight

  targetX2 = (((maxX + 1) * targetWidth) \ sourceWidth) - 1
  targetY2 = (((maxY + 1) * targetHeight) \ sourceHeight) - 1

  IF targetX1 < 0 THEN targetX1 = 0
  IF targetY1 < 0 THEN targetY1 = 0
  IF targetX2 >= targetWidth THEN targetX2 = targetWidth - 1
  IF targetY2 >= targetHeight THEN targetY2 = targetHeight - 1

  _DEST targetImage
  _SOURCE sourceImage

  FOR iy = targetY1 TO targetY2

    sampleY = (iy * sourceHeight) \ targetHeight

    IF sampleY < minY THEN sampleY = minY
    IF sampleY > maxY THEN sampleY = maxY

    FOR ix = targetX1 TO targetX2

      sampleX = (ix * sourceWidth) \ targetWidth

      IF sampleX < minX THEN sampleX = minX
      IF sampleX > maxX THEN sampleX = maxX

      pixelClr = POINT(sampleX, sampleY)

      IF pixelClr <> transparentClr THEN
        PSET (ix, iy), pixelClr
      END IF

    NEXT
  NEXT

  _SOURCE 0

END SUB ' overlayScaledTransparent

''''''''''''''''''''''''
SUB pasteClipboardText

  IF editor.IsSelecting = 1 THEN
    deleteSelection
    editor.IsSelecting = 0
  END IF

  cbText$ = _CLIPBOARD$
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  ' Pre-allocate a buffer to rapidly filter non-printable characters in a single O(N) pass
  cleanText$ = SPACE$(cbLen)
  cleanIdx = 1

  FOR ii = 1 TO cbLen
    cbAsc = ASC(cbText$, ii)
    ' Allow only newlines (10) and standard printable characters (32 to 126)
    IF cbAsc = 10 OR (cbAsc >= 32 AND cbAsc <= 126) THEN
      ASC(cleanText$, cleanIdx) = cbAsc
      cleanIdx = cleanIdx + 1
    END IF
  NEXT

  cbText$ = LEFT$(cleanText$, cleanIdx - 1)
  cbLen = LEN(cbText$)
  IF cbLen = 0 THEN EXIT SUB

  ' Count newlines to determine the exact array shift distance
  nlCount = 0
  ix = 1
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cbText$, CHR$(10))
    IF nextNl > 0 THEN
      nlCount = nlCount + 1
      ix = nextNl + 1
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Shift array down exactly once in bulk
  IF nlCount > 0 THEN
    FOR iy = editor.LastLine TO editor.CursorY + 1 STEP -1
      IF iy + nlCount <= EDITOR_LINE_MAX THEN
        editorText$(iy + nlCount) = editorText$(iy)
      END IF
    NEXT

    editor.LastLine = editor.LastLine + nlCount
    IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  END IF

  currentLine$ = editorText$(editor.CursorY)
  leftPart$ = LEFT$(currentLine$, editor.CursorX)
  rightPart$ = MID$(currentLine$, editor.CursorX + 1)

  ix = 1
  curPasteY = editor.CursorY
  linesPasted = 0

  ' Process the filtered clipboard and inject directly into the opened array spaces
  DO WHILE ix <= cbLen
    nextNl = INSTR(ix, cbText$, CHR$(10))
    IF nextNl = 0 THEN
      ' Final chunk of text (no trailing newline)
      chunk$ = MID$(cbText$, ix)
      IF curPasteY <= EDITOR_LINE_MAX THEN
        IF linesPasted = 0 THEN
          editorText$(curPasteY) = leftPart$ + chunk$ + rightPart$
          editor.CursorX = LEN(leftPart$ + chunk$)
        ELSE
          editorText$(curPasteY) = chunk$ + rightPart$
          editor.CursorX = LEN(chunk$)
        END IF
      END IF
      EXIT DO
    ELSE
      ' Extract line up to the newline
      chunk$ = MID$(cbText$, ix, nextNl - ix)
      IF curPasteY <= EDITOR_LINE_MAX THEN
        IF linesPasted = 0 THEN
          editorText$(curPasteY) = leftPart$ + chunk$
        ELSE
          editorText$(curPasteY) = chunk$
        END IF
      END IF

      linesPasted = linesPasted + 1
      curPasteY = curPasteY + 1
      ix = nextNl + 1
    END IF
  LOOP

  ' Handle edge case where clipboard ends exactly on a newline
  IF RIGHT$(cbText$, 1) = CHR$(10) THEN
    IF curPasteY <= EDITOR_LINE_MAX THEN
      editorText$(curPasteY) = rightPart$
      editor.CursorX = 0
    END IF
  END IF

  editor.CursorY = curPasteY
  IF editor.CursorY > EDITOR_LINE_MAX THEN
    editor.CursorY = EDITOR_LINE_MAX
    editor.CursorX = LEN(editorText$(EDITOR_LINE_MAX))
  END IF

  ' Update view scrolling
  IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
  IF editor.CursorY >= editor.ScrollY + 29 THEN editor.ScrollY = editor.CursorY - 28
  IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
  IF editor.CursorX >= editor.ScrollX + 56 THEN editor.ScrollX = editor.CursorX - 55

END SUB ' pasteClipboardText

''''''''''''''''''''''''
SUB PrintTextLineWithBanners (text$, wClr, whereY)

  paddingPixels = 8

  textStartX = 9

  SELECT CASE whereY

    CASE TOP: textStartY = 4
    CASE MIDDLE: textStartY = 20
    CASE BOTTOM: textStartY = 30

  END SELECT ' whereY

  textPixelWidth = LEN(text$) * 8
  boxPixelWidth = paddingPixels + textPixelWidth + paddingPixels
  boxPixelHeight = paddingPixels + 8 + paddingPixels

  boxStartX = (textStartX * 8) - paddingPixels
  boxStartY = (textStartY * 8) - paddingPixels

  IF (boxStartX + boxPixelWidth) >= SCREENSIZEX THEN
    boxStartX = SCREENSIZEX - boxPixelWidth
  END IF

  textStartX = (boxStartX + paddingPixels) \ 8

  IF (textStartX * 8) + textPixelWidth >= SCREENSIZEX THEN textStartX = 1

  boxStartX = (textStartX * 8) - paddingPixels

  drawBorderBox boxStartX, boxStartY, boxPixelWidth, boxPixelHeight, 1, 0
  drawClearBox boxStartX + 1, boxStartY + 1, boxPixelWidth - 2, boxPixelHeight - 2, 15

  PrintStr boxStartX + paddingPixels, boxStartY + paddingPixels, text$, wClr, 0, 0

END SUB ' PrintTextLineWithBanners

''''''''''''''''''''''''
FUNCTION processDropdownMenu (wPosX, wPosY, wItemCount, passItems$())

  returnExtraPrepare

  DIM itemH AS LONG
  itemH = 14

  maxWidth = 0
  FOR ii = 0 TO wItemCount - 1
    wLen = LEN(passItems$(ii)) * 8
    IF LEFT$(passItems$(ii), 1) = "~" THEN wLen = wLen - 8
    IF wLen > maxWidth THEN maxWidth = wLen
  NEXT
  boxW = maxWidth + 16
  boxH = (wItemCount * itemH) + 4

  drawBorderBox wPosX, wPosY, boxW, boxH, 15, editor.windowBarClr

  itemSelected = 0
  clickedItem = 0

  FOR ii = 0 TO wItemCount - 1
    itemY = wPosY + 2 + (ii * itemH)
    dStr$ = passItems$(ii)
    isDisabled = 0
    IF LEFT$(dStr$, 1) = "~" THEN
      isDisabled = 1
      dStr$ = MID$(dStr$, 2)
    END IF

    IF isDisabled = 0 THEN
      IF mouseWithinBoxBounds(wPosX + 2, itemY, boxW - 4, itemH) THEN
        drawClearBox wPosX + 2, itemY, boxW - 4, itemH, 9
        IF mouseClickedInBox(wPosX + 2, itemY, boxW - 4, itemH) THEN
          clickedItem = ii
          itemSelected = 1
        END IF
      END IF
      PrintStr wPosX + 8, itemY + 3, dStr$, 15, 0, 1
    ELSE
      PrintStr wPosX + 8, itemY + 3, dStr$, sysColor.gray, 0, 1
    END IF
  NEXT

  IF mouseClickedInBox(wPosX, wPosY, boxW, boxH) THEN
    editor.MenuClicked = 1
  END IF

  IF itemSelected = 1 THEN
    return2 clickedItem
    processDropdownMenu = 1
    EXIT FUNCTION
  END IF

  return2 0
  processDropdownMenu = 0

END FUNCTION ' processDropdownMenu

''''''''''''''''''''''''
SUB processInput

  IF keyCheck("ESC") THEN
    IF editor.MenuMode = 1 OR editor.MenuMode = 2 THEN
      editor.MenuMode = 0
      waitKeyRelease "ESC"
    ELSE
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        waitKeyRelease "ESC"
        confirmExit
      END IF
    END IF
  END IF

  IF keyCheck("F5") THEN
    IF compileState = COMP_IDLE THEN
      hasCode = 0
      IF editor.LastLine > 1 THEN
        hasCode = 1
      ELSE
        IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
      END IF

      IF hasCode = 1 THEN
        compileState = COMP_REFINE
        addStatusMsg "REFINING..."
        redrawAll
        dispScreenFlushUpdate

        statusMsgCount = 1
        editor.StatusScrollY = 1
        editor.StatusSelectedIndex = 0
        FOR ii = 1 TO 999
          statusMsg(ii).Text = ""
          statusMsg(ii).CodeLine = 0
        NEXT

        wFln$ = fileNameBase$ + ".exe"
        IF _FILEEXISTS(wFln$) THEN
          delCmd$ = "cmd /c del /F /Q " + CHR$(34) + wFln$ + CHR$(34)
          SHELL _HIDE delCmd$

          IF _FILEEXISTS(wFln$) THEN
            addStatusMsg "OUTPUT FILE IN USE, PAUSING"
            redrawAll
            dispScreenFlushUpdate
            waitTimer 1.5
          END IF
        END IF

        waitKeyRelease "F5"
      END IF
    END IF
  END IF

  IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) AND keyCheck("F") THEN
    waitKeyRelease "F"
    modalSearch
  END IF

  IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) AND keyCheck("S") THEN
    waitKeyRelease "S"
    _KEYCLEAR

    hasCode = 0
    IF editor.LastLine > 1 THEN
      hasCode = 1
    ELSE
      IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
    END IF

    IF hasCode = 1 THEN
      editor.Focus = 1
      curExt$ = ".BAS"
      IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
      IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

      addStatusMsg "SAVING " + fileNameBase$ + curExt$ + "..."
      redrawAll
      dispScreenFlushUpdate

      fileCodeSave

      addStatusMsg "SAVED " + fileNameBase$ + curExt$
    END IF
  END IF

  IF keyCheck("F3") THEN
    waitKeyRelease "F3"
    IF editorSearchQuery$ <> "" THEN
      findEditorNext
    ELSE
      modalSearch
    END IF
  END IF

  kVal = _KEYHIT
  IF kVal = 0 THEN EXIT SUB

  IF editor.Focus = 2 THEN
    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut) - Treat as copy for status bar
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.StatusSelectedIndex > 0 THEN
        hlStart = editor.StatusSelectedIndex
        hlEnd = editor.StatusSelectedIndex
        sLine = statusMsg(hlStart).CodeLine
        IF sLine > 0 THEN
          DO WHILE hlStart > 1
            IF statusMsg(hlStart - 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
              hlStart = hlStart - 1
            ELSE
              EXIT DO
            END IF
          LOOP
          DO WHILE hlEnd < statusMsgCount - 1
            IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
              IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
              hlEnd = hlEnd + 1
            ELSE
              EXIT DO
            END IF
          LOOP
        END IF

        copyText$ = ""
        FOR ii = hlStart TO hlEnd
          copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
          IF ii < hlEnd THEN copyText$ = copyText$ + " "
        NEXT
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF
  END IF

  IF editor.Focus = 1 THEN

    lastLine = editor.LastLine
    IF editor.CursorY > lastLine THEN lastLine = editor.CursorY

    oldCursorY = editor.CursorY

    ' Ctrl+Z (Undo)
    IF kVal = 26 OR ((kVal = 122 OR kVal = 90) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      undo_StateRestore
      kVal = 0
      lastActionWasTyping = 0
    END IF

    ' Ctrl+C (Copy)
    IF kVal = 3 OR ((kVal = 99 OR kVal = 67) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
      END IF
      kVal = 0
    END IF

    ' Ctrl+X (Cut)
    IF kVal = 24 OR ((kVal = 120 OR kVal = 88) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      IF editor.IsSelecting = 1 THEN
        undo_StateSave
        lastActionWasTyping = 0
        copyText$ = retEditorSelection$
        IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
        deleteSelection
        editor.IsSelecting = 0
      END IF
      kVal = 0
    END IF

    ' Ctrl+A (Select All)
    IF kVal = 1 OR ((kVal = 97 OR kVal = 65) AND (_KEYDOWN(100306) OR _KEYDOWN(100305))) THEN
      editor.SelectStartX = 0
      editor.SelectStartY = 1
      editor.CursorY = editor.LastLine
      editor.CursorX = LEN(editorText$(editor.LastLine))
      editor.IsSelecting = 1
      kVal = 0
    END IF

    isMoveKey = 0
    IF kVal = 19200 OR kVal = 19712 OR kVal = 18432 OR kVal = 20480 OR kVal = 18176 OR kVal = 20224 OR kVal = 18688 OR kVal = 20736 THEN isMoveKey = 1

    IF isMoveKey = 1 THEN
      lastActionWasTyping = 0
      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        IF editor.IsSelecting = 0 THEN
          editor.SelectStartX = editor.CursorX
          editor.SelectStartY = editor.CursorY
          editor.IsSelecting = 1
        END IF
      ELSE
        editor.IsSelecting = 0
      END IF
    END IF

    IF (kVal >= 32 AND kVal <= 126) OR kVal = 8 OR kVal = 212231 OR kVal = 21248 OR kVal = 13 OR kVal = 118 THEN
      IF isMoveKey = 0 AND kVal <> 0 THEN
        IF editor.IsSelecting = 1 THEN
          undo_StateSave
          IF (kVal >= 32 AND kVal <= 126) THEN
            lastActionWasTyping = 1
          ELSE
            lastActionWasTyping = 0
          END IF

          IF kVal = 8 OR kVal = 212231 OR kVal = 21248 THEN
            deleteSelection
            editor.IsSelecting = 0
            kVal = 0 ' Consume key to prevent normal backspace/delete
          ELSE
            IF (kVal >= 32 AND kVal <= 126) OR kVal = 13 THEN
              deleteSelection
              editor.IsSelecting = 0
            ELSE
              editor.IsSelecting = 0
            END IF
          END IF
        END IF
      END IF
    END IF

    IF kVal = 118 AND (_KEYDOWN(100306) OR _KEYDOWN(100305)) THEN ' Ctrl+V (Paste)
      IF editor.IsSelecting = 0 THEN undo_StateSave
      lastActionWasTyping = 0
      pasteClipboardText
      kVal = 0
    END IF

    ' Consume any remaining key presses if CTRL is held to prevent unmapped shortcut characters from dropping into the editor
    IF (_KEYDOWN(100306) OR _KEYDOWN(100305)) THEN
      IF kVal >= 32 AND kVal <= 126 THEN
        kVal = 0
      END IF
    END IF

    IF kVal >= 32 AND kVal <= 126 THEN ' Printable character
      IF lastActionWasTyping = 0 THEN undo_StateSave
      lastActionWasTyping = 1
      currentLine$ = editorText$(editor.CursorY)
      leftPart$ = LEFT$(currentLine$, editor.CursorX)
      rightPart$ = MID$(currentLine$, editor.CursorX + 1)
      editorText$(editor.CursorY) = leftPart$ + CHR$(kVal) + rightPart$
      editor.CursorX = editor.CursorX + 1
    END IF

    IF kVal = 8 THEN ' Backspace
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorX > 0 THEN ' Delete character to the left
        currentLine$ = editorText$(editor.CursorY)
        leftPart$ = LEFT$(currentLine$, editor.CursorX - 1)
        rightPart$ = MID$(currentLine$, editor.CursorX + 1)
        editorText$(editor.CursorY) = leftPart$ + rightPart$
        editor.CursorX = editor.CursorX - 1
      ELSE
        IF editor.CursorY > 1 THEN ' Merge with previous line
          prevLineLen = LEN(editorText$(editor.CursorY - 1))
          editor.CursorX = prevLineLen
          editorText$(editor.CursorY - 1) = editorText$(editor.CursorY - 1) + editorText$(editor.CursorY)
          FOR ii = editor.CursorY TO editor.LastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.LastLine) = ""
          editor.CursorY = editor.CursorY - 1
          editor.LastLine = editor.LastLine - 1
          IF editor.LastLine < 1 THEN editor.LastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 212231 OR kVal = 21248 THEN ' Delete key
      undo_StateSave
      lastActionWasTyping = 0
      currentLine$ = editorText$(editor.CursorY)
      IF editor.CursorX < LEN(currentLine$) THEN ' Delete character to the right
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 2)
        editorText$(editor.CursorY) = leftPart$ + rightPart$
      ELSE
        IF editor.CursorY < lastLine THEN ' Merge next line into current
          editorText$(editor.CursorY) = currentLine$ + editorText$(editor.CursorY + 1)
          FOR ii = editor.CursorY + 1 TO editor.LastLine - 1
            editorText$(ii) = editorText$(ii + 1)
          NEXT
          editorText$(editor.LastLine) = ""
          editor.LastLine = editor.LastLine - 1
          IF editor.LastLine < 1 THEN editor.LastLine = 1
        END IF
      END IF
    END IF

    IF kVal = 13 THEN ' Enter key, split line at cursor
      undo_StateSave
      lastActionWasTyping = 0
      IF editor.CursorY < EDITOR_LINE_MAX THEN
        currentLine$ = editorText$(editor.CursorY)
        leftPart$ = LEFT$(currentLine$, editor.CursorX)
        rightPart$ = MID$(currentLine$, editor.CursorX + 1)
        editorText$(editor.CursorY) = leftPart$
        FOR ii = editor.LastLine TO editor.CursorY + 1 STEP -1
          IF ii < EDITOR_LINE_MAX THEN
            editorText$(ii + 1) = editorText$(ii)
          END IF
        NEXT
        editorText$(editor.CursorY + 1) = rightPart$
        editor.CursorY = editor.CursorY + 1
        editor.CursorX = 0
        editor.LastLine = editor.LastLine + 1
        IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
        refineCode editor.CursorY - 1, 0
      END IF
    END IF

    IF kVal = 19200 THEN ' Left arrow
      IF editor.CursorX > 0 THEN
        editor.CursorX = editor.CursorX - 1
      ELSE
        IF editor.CursorY > 1 THEN ' Wrap to end of previous line
          editor.CursorY = editor.CursorY - 1
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 19712 THEN ' Right arrow
      IF editor.CursorX < LEN(editorText$(editor.CursorY)) THEN
        editor.CursorX = editor.CursorX + 1
      ELSE
        IF editor.CursorY < lastLine THEN ' Wrap to start of next line
          editor.CursorY = editor.CursorY + 1
          editor.CursorX = 0
        END IF
      END IF
    END IF

    IF kVal = 18432 THEN ' Up arrow
      IF editor.CursorY > 1 THEN
        editor.CursorY = editor.CursorY - 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 20480 THEN ' Down arrow
      IF editor.CursorY < lastLine THEN
        editor.CursorY = editor.CursorY + 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN
          editor.CursorX = LEN(editorText$(editor.CursorY))
        END IF
      END IF
    END IF

    IF kVal = 18176 THEN ' Home key, go to start of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = 1
        editor.CursorX = 0
        editor.ScrollY = 1
        editor.ScrollX = 0
      ELSE
        editor.CursorX = 0
      END IF
    END IF

    IF kVal = 20224 THEN ' End key, go to end of line
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        editor.CursorY = lastLine
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = lastLine - 28
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF kVal = 18688 THEN ' Page up
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        targetY = 1
        IF uiSubCount > 0 THEN
          FOR ii = uiSubCount - 1 TO 0 STEP -1
            startLine = uiSubLine(ii)
            IF startLine + 1 < editor.CursorY THEN
              targetY = startLine + 1
              IF targetY > lastLine THEN targetY = lastLine
              EXIT FOR
            END IF
          NEXT
        END IF
        editor.CursorY = targetY
        editor.CursorX = 0
        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY - 29
        IF editor.CursorY < 1 THEN editor.CursorY = 1
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF kVal = 20736 THEN ' Page down
      IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN
        targetY = lastLine
        FOR ii = editor.CursorY + 1 TO lastLine
          uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(ii))))
          IF LEFT$(uTemp$, 8) = "END SUB" THEN
            targetY = ii
            EXIT FOR
          END IF
          IF LEFT$(uTemp$, 12) = "END FUNCTION" THEN
            targetY = ii
            EXIT FOR
          END IF
        NEXT
        editor.CursorY = targetY
        editor.CursorX = LEN(editorText$(editor.CursorY))
        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      ELSE
        editor.CursorY = editor.CursorY + 29
        IF editor.CursorY > lastLine THEN editor.CursorY = lastLine
        IF editor.CursorX > LEN(editorText$(editor.CursorY)) THEN editor.CursorX = LEN(editorText$(editor.CursorY))
      END IF
    END IF

    IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
    IF editor.CursorY >= editor.ScrollY + 29 THEN editor.ScrollY = editor.CursorY - 28

    IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
    IF editor.CursorX >= editor.ScrollX + 56 THEN editor.ScrollX = editor.CursorX - 55

    IF oldCursorY <> editor.CursorY THEN refineCode oldCursorY, 0

  END IF

END SUB ' processInput
''''''''''''''''''''''''

SUB processVScrollbar (wScrollID AS LONG, wPosX AS LONG, wPosY AS LONG, wSizeX AS LONG, wSizeY AS LONG, wTotalItems AS LONG, wMaxVis AS LONG, wIs1Based AS LONG)

  DIM passCurScroll AS LONG
  DIM passDragActive AS LONG
  DIM passDragOffset AS LONG

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      passCurScroll = editor.ScrollY
      passDragActive = editor.ScrollDragActive
      passDragOffset = editor.ScrollDragOffsetY
    CASE SCROLL_STATUS
      passCurScroll = editor.StatusScrollY
      passDragActive = editor.StatusScrollDragActive
      passDragOffset = editor.StatusScrollDragOffsetY
    CASE SCROLL_FUNC
      passCurScroll = editor.FuncScroll.ScrollY
      passDragActive = editor.FuncScroll.DragActive
      passDragOffset = editor.FuncScroll.DragOffset
    CASE SCROLL_MODAL
      passCurScroll = editor.ModalScroll.ScrollY
      passDragActive = editor.ModalScroll.DragActive
      passDragOffset = editor.ModalScroll.DragOffset

  END SELECT ' wScrollID

  drawBorderBox wPosX, wPosY, wSizeX, wSizeY, 15, 0

  drawBorderBox wPosX, wPosY, wSizeX, 11, 15, 0
  drawBorderBox wPosX, wPosY + wSizeY - 11, wSizeX, 11, 15, 0

  charX = wPosX + (wSizeX \ 2) - 4
  PrintChr charX, wPosY + 2, CHR$(24), 15, 0, 1
  PrintChr charX, wPosY + wSizeY - 9, CHR$(25), 15, 0, 1

  minScroll = 0
  IF wIs1Based = 1 THEN minScroll = 1

  scrollRange = wTotalItems - wMaxVis
  IF scrollRange < 0 THEN scrollRange = 0

  maxScroll = scrollRange + minScroll

  thumbMaxH = wSizeY - 22
  IF wTotalItems > wMaxVis THEN
    thumbSize = (wMaxVis * thumbMaxH) \ wTotalItems
    IF thumbSize < 10 THEN thumbSize = 10
    IF scrollRange > 0 THEN
      thumbY = wPosY + 11 + (((passCurScroll - minScroll) * (thumbMaxH - thumbSize)) \ scrollRange)
    ELSE
      thumbY = wPosY + 11
    END IF
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 2, 15
  ELSE
    thumbSize = thumbMaxH
    thumbY = wPosY + 11
    drawBorderBox wPosX + 1, thumbY, wSizeX - 2, thumbSize, 2, 15
  END IF

  ' Mouse Logic
  IF mouse.Clicked1 THEN
    IF wTotalItems > wMaxVis THEN
      IF mouseWithinBoxBounds(wPosX, thumbY, wSizeX, thumbSize) THEN
        passDragActive = 1
        passDragOffset = mouse.PosY - thumbY
      ELSE
        IF mouseWithinBoxBounds(wPosX, wPosY + 11, wSizeX, thumbMaxH) THEN
          IF mouse.PosY < thumbY THEN
            passCurScroll = passCurScroll - wMaxVis
            IF passCurScroll < minScroll THEN passCurScroll = minScroll
          ELSE
            passCurScroll = passCurScroll + wMaxVis
            IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
          END IF
        END IF
      END IF
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY, wSizeX, 11) THEN
      passCurScroll = passCurScroll - 1
      IF passCurScroll < minScroll THEN passCurScroll = minScroll
    END IF

    IF mouseWithinBoxBounds(wPosX, wPosY + wSizeY - 11, wSizeX, 11) THEN
      passCurScroll = passCurScroll + 1
      IF passCurScroll > maxScroll THEN passCurScroll = maxScroll
    END IF
  END IF

  IF mouse.Button1Down AND passDragActive = 1 THEN
    IF wTotalItems > wMaxVis THEN
      newThumbY = mouse.PosY - passDragOffset
      trackSize = thumbMaxH - thumbSize
      IF trackSize > 0 THEN
        newScroll = minScroll + (((newThumbY - (wPosY + 11)) * scrollRange) \ trackSize)
        IF newScroll < minScroll THEN newScroll = minScroll
        IF newScroll > maxScroll THEN newScroll = maxScroll
        passCurScroll = newScroll
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    passDragActive = 0
  END IF

  SELECT CASE wScrollID

    CASE SCROLL_MAIN
      editor.ScrollY = passCurScroll
      editor.ScrollDragActive = passDragActive
      editor.ScrollDragOffsetY = passDragOffset
    CASE SCROLL_STATUS
      editor.StatusScrollY = passCurScroll
      editor.StatusScrollDragActive = passDragActive
      editor.StatusScrollDragOffsetY = passDragOffset
    CASE SCROLL_FUNC
      editor.FuncScroll.ScrollY = passCurScroll
      editor.FuncScroll.DragActive = passDragActive
      editor.FuncScroll.DragOffset = passDragOffset
    CASE SCROLL_MODAL
      editor.ModalScroll.ScrollY = passCurScroll
      editor.ModalScroll.DragActive = passDragActive
      editor.ModalScroll.DragOffset = passDragOffset

  END SELECT ' wScrollID

END SUB ' processVScrollbar

''''''''''''''''''''''''
SUB pushStatusMsg (wStr$, wLineNum AS LONG, wGroupID AS _UNSIGNED LONG)

  IF statusMsgCount < MAX_STATUS_MSGS THEN
    statusMsg(statusMsgCount).Text = wStr$
    statusMsg(statusMsgCount).CodeLine = wLineNum
    statusMsg(statusMsgCount).GroupID = wGroupID
    statusMsgCount = statusMsgCount + 1
  ELSE
    FOR ii = 1 TO 998
      statusMsg(ii).Text = statusMsg(ii + 1).Text
      statusMsg(ii).CodeLine = statusMsg(ii + 1).CodeLine
      statusMsg(ii).GroupID = statusMsg(ii + 1).GroupID
    NEXT
    statusMsg(999).Text = wStr$
    statusMsg(999).CodeLine = wLineNum
    statusMsg(999).GroupID = wGroupID
  END IF

  statusBoxH = 38
  maxLines = (statusBoxH - 5) \ 11
  IF (statusMsgCount - 1) > maxLines THEN
    editor.StatusScrollY = statusMsgCount - maxLines
  ELSE
    editor.StatusScrollY = 1
  END IF

END SUB ' pushStatusMsg

''''''''''''''''''''''''
SUB redrawAll

  CLS
  COLOR 15

  editor.MenuClicked = 0

  drawEditorPMI
  drawStatusPMI

  ' Draw side UI elements before top menu to ensure dropdowns appear on top
  drawButtonsPMI
  drawFuncListPMI

  drawTopMenuAndScrollPMI
  drawCornerPMI

  minAllW = 12
  minAllH = 12
  minAllX = 0
  minAllY = SCREENSIZEY - 12

  drawBorderBox minAllX, minAllY, minAllW, minAllH, 15, editor.windowBarClr

  IF mouseWithinBoxBounds(minAllX, minAllY, minAllW, minAllH) THEN
    drawClearBox minAllX + 1, minAllY + 1, minAllW - 2, minAllH - 2, 9
  END IF

  PrintStr minAllX + 3, minAllY + 2, "v", 15, 0, 1

  IF mouseClickedInBox(minAllX, minAllY, minAllW, minAllH) THEN
    editor.MenuClicked = 1
    SHELL _HIDE "explorer.exe shell:::{3080F90D-D7AD-11D9-BD98-0000947B0257}"
  END IF

  IF mouse.Released1 THEN
    IF editor.MenuClicked = 0 THEN
      editor.TopMenuFocus = 0
    END IF
  END IF

  showCursorData 50, SCREENSIZEY - 48

END SUB ' redrawAll

''''''''''''''''''''''''
SUB return2 (wVal)

  ' Return the global secondary return variable

  returnF2data = wVal

END SUB ' return2

''''''''''''''''''''''''
SUB return3 (wVal)

  ' Return the global tertiary return value

  returnF3data = wVal

END SUB ' return3

''''''''''''''''''''''''
FUNCTION returnedData2

  returnedData2 = returnF2data

END FUNCTION ' returnedData2

''''''''''''''''''''''''
FUNCTION returnedData3

  returnedData3 = returnF3data

END FUNCTION ' returnedData3

''''''''''''''''''''''''
SUB returnExtraPrepare

  ' Call at the top of any function that sends back return 2 or 3 data

  returnF2data = 0
  returnF3data = 0

END SUB ' returnExtraPrepare

''''''''''''''''''''''''
SUB ZLOCATE (wX, wY)

  LOCATE wY + 1, wX + 1

END SUB ' ZLOCATE

''''''''''''''''''''''''
SUB ESCAPETEXT (wStr$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr$ = "" THEN wStr$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  PrintTextLineWithBanners wStr$, 15, BOTTOM

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - 8, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT

''''''''''''''''''''''''
SUB ESCAPETEXT2 (wStr1$, wStr2$)

  DIM physicalSnapshot AS LONG
  DIM escapeOverlay AS LONG

  ' Do not call redrawAll here, can cause a hang in some cases
  IF wStr1$ = "" THEN wStr1$ = "No text sent"

  ' Capture every physical pixel already present on screen 0
  _DEST 0
  physicalSnapshot = _COPYIMAGE(0)

  fileOutputErrorReport wStr1$, wStr2$

  ' Create a logical-size overlay whose color 255 pixels remain untouched
  escapeOverlay = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)

  _DEST escapeOverlay
  _FONT 8
  setPalettes256

  LINE (0, 0)-(SCREENSIZEX - 1, SCREENSIZEY - 1), 255, BF

  boxW = SCREENSIZEX - 16
  boxH = 34
  boxX = 8
  boxY = SCREENSIZEY - 128

  drawBorderBox boxX, boxY, boxW, boxH, 1, 0
  drawClearBox boxX + 1, boxY + 1, boxW - 2, boxH - 2, 15

  PrintStr boxX + 8, boxY + 8, wStr1$, 15, 0, 0

  IF wStr2$ <> "" THEN
    PrintStr boxX + 8, boxY + 18, wStr2$, 15, 0, 0
  END IF

  pauseText$ = "Press any key to continue..."
  PrintStr 0, SCREENSIZEY - 8, pauseText$, 15, 0, 1

  ' Scale only actual escape overlay pixels onto the preserved physical snapshot
  overlayScaledTransparent escapeOverlay, physicalSnapshot, 255

  ' Present the completed physical snapshot without rebuilding it from logicalScreen
  _DEST 0
  _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), physicalSnapshot, 0

  _DISPLAY

  IF escapeOverlay < -1 THEN _FREEIMAGE escapeOverlay
  IF physicalSnapshot < -1 THEN _FREEIMAGE physicalSnapshot

  waitKeyRelease "ESC"
  _KEYCLEAR

  DO
    limitSpeed
  LOOP UNTIL _KEYHIT <> 0

  SYSTEM

END SUB ' ESCAPETEXT2

''''''''''''''''''''''''
FUNCTION extractQuotes$ (wStr$)

  tempReturn$ = ""
  firstQuote = INSTR(wStr$, CHR$(34))

  IF firstQuote > 0 THEN
    secondQuote = INSTR(firstQuote + 1, wStr$, CHR$(34))
    IF secondQuote > 0 THEN
      tempReturn$ = MID$(wStr$, firstQuote + 1, secondQuote - firstQuote - 1)
    END IF
  END IF

  extractQuotes$ = tempReturn$

END FUNCTION ' extractQuotes$

''''''''''''''''''''''''
SUB fileCodeImport (importFile$)

  IF _FILEEXISTS(importFile$) = 0 THEN EXIT SUB

  ffTmp = FREEFILE
  OPEN importFile$ FOR BINARY AS #ffTmp
  fileLen = LOF(ffTmp)
  IF fileLen = 0 THEN
    CLOSE #ffTmp
    EXIT SUB
  END IF

  fullText$ = SPACE$(fileLen)
  GET #ffTmp, , fullText$
  CLOSE #ffTmp

  curY = editor.LastLine + 1
  IF curY > EDITOR_LINE_MAX THEN EXIT SUB

  ' Enforce visual separation
  IF curY > 1 THEN
    IF LTRIM$(RTRIM$(editorText$(curY - 1))) <> "" THEN
      editorText$(curY) = ""
      curY = curY + 1
    END IF
  END IF

  IF curY <= EDITOR_LINE_MAX THEN
    editorText$(curY) = "'''' IMPORTED: FILE: " + importFile$
    curY = curY + 1
  END IF

  IF curY <= EDITOR_LINE_MAX THEN
    editorText$(curY) = ""
    curY = curY + 1
  END IF

  startPos = 1

  ' Slice the incoming file block natively to eliminate slow byte-by-byte loop processing
  DO WHILE startPos <= fileLen
    nextNl = INSTR(startPos, fullText$, CHR$(10))
    IF nextNl > 0 THEN
      chunkLen = nextNl - startPos
      IF chunkLen > 0 THEN
        IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      IF curY > EDITOR_LINE_MAX THEN EXIT DO
      startPos = nextNl + 1
    ELSE
      chunkLen = fileLen - startPos + 1
      IF chunkLen > 0 THEN
        IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      EXIT DO
    END IF
  LOOP

  ' Sync the global tracking bounds safely to the new expanded size
  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

END SUB ' fileCodeImport

''''''''''''''''''''''''
SUB fileCodeLoad

  curExt$ = ".BAS"
  IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
  IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

  fln$ = fileNameBase$ + curExt$

  IF _FILEEXISTS(fln$) = 0 THEN EXIT SUB

  OPEN fln$ FOR BINARY AS #1

  fileLen = LOF(1)

  IF fileLen = 0 THEN
    CLOSE #1
    KILL fln$
    EXIT SUB
  END IF

  ' Pre-allocate buffer and read entire file at once to eliminate per-byte I/O latency
  fullText$ = SPACE$(fileLen)
  GET #1, , fullText$
  CLOSE #1

  ' Pre-clear arrays
  FOR iy = 1 TO editor.LastLine
    editorText$(iy) = ""
  NEXT

  curY = 1
  startPos = 1
  lineFeed$ = CHR$(10)

  ' Slice the text into individual lines using the native INSTR delimiter scanner for extreme speed
  DO WHILE startPos <= fileLen
    nextNl = INSTR(startPos, fullText$, lineFeed$)
    IF nextNl > 0 THEN
      chunkLen = nextNl - startPos
      IF chunkLen > 0 THEN
        IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      IF curY > EDITOR_LINE_MAX THEN EXIT DO
      startPos = nextNl + 1
    ELSE
      chunkLen = fileLen - startPos + 1
      IF chunkLen > 0 THEN
        IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
        IF chunkLen > 0 AND curY <= EDITOR_LINE_MAX THEN
          editorText$(curY) = MID$(fullText$, startPos, chunkLen)
        END IF
      END IF
      curY = curY + 1
      EXIT DO
    END IF
  LOOP

  editor.LastLine = curY - 1
  IF editor.LastLine > EDITOR_LINE_MAX THEN editor.LastLine = EDITOR_LINE_MAX
  IF editor.LastLine < 1 THEN editor.LastLine = 1

  IF editor.CursorY > editor.LastLine THEN
    editor.CursorY = editor.LastLine
    editor.CursorX = 0
  END IF

  IF editor.ScrollY > editor.LastLine THEN
    editor.ScrollY = editor.LastLine - 27
    IF editor.ScrollY < 1 THEN editor.ScrollY = 1
  END IF

END SUB ' fileCodeLoad

''''''''''''''''''''''''
SUB fileCodeSave

  curExt$ = ".BAS"
  IF editor.FileExtensionMode = FILE_EXT_TXT THEN curExt$ = ".TXT"
  IF editor.FileExtensionMode = FILE_EXT_BLB THEN curExt$ = ".BLB"

  fln$ = fileNameBase$ + curExt$

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp
  IF LOF(ffTmp) > 0 THEN
    CLOSE #ffTmp
    KILL fln$
    OPEN fln$ FOR BINARY AS #ffTmp
  END IF

  lastLine = editor.LastLine
  totalLen = 0

  ' Calculate the exact buffer size required for the entire file
  FOR iy = 1 TO lastLine
    totalLen = totalLen + LEN(editorText$(iy))
  NEXT

  ' Add space for the newline characters between each line
  IF lastLine > 1 THEN
    totalLen = totalLen + (lastLine - 1)
  END IF

  IF totalLen > 0 THEN
    ' Pre-allocate the memory block to prevent slow string concatenation
    fullText$ = SPACE$(totalLen)
    curPos = 1

    FOR iy = 1 TO lastLine
      lineStr$ = editorText$(iy)
      lineLen = LEN(lineStr$)

      IF lineLen > 0 THEN
        ' Use direct memory injection for maximum speed
        MID$(fullText$, curPos, lineLen) = lineStr$
        curPos = curPos + lineLen
      END IF

      ' Append the newline separator seamlessly
      IF iy < lastLine THEN
        ASC(fullText$, curPos) = 10
        curPos = curPos + 1
      END IF
    NEXT

    ' Blast the entire buffer directly to the disk in one native operation
    PUT #ffTmp, , fullText$
  END IF

  CLOSE #ffTmp

END SUB ' fileCodeSave

''''''''''''''''''''''''
SUB fileSaveBinary

  DIM tryCount AS LONG
  DIM iLong AS _UNSIGNED LONG
  DIM suffixStr$
  DIM testBase$

  compileSaveTracker "SELECTING FILE NAME", 0, 0, 0

  tryCount = 0
  testBase$ = fileNameBase$

  DO
    compileSaveTracker "SELECTING FILE NAME", 0, 0, 0

    fln$ = testBase$ + ".exe"

    IF _FILEEXISTS(fln$) THEN
      ' Pass the deletion command to the operating system to avoid fatal lock crashes
      SHELL _HIDE "cmd /c del /q " + CHR$(34) + fln$ + CHR$(34)

      ' If the file survives the OS deletion attempt, it is actively locked by a running process
      IF _FILEEXISTS(fln$) THEN
        tryCount = tryCount + 1

        IF tryCount < 10 THEN
          suffixStr$ = "_0" + LTRIM$(RTRIM$(STR$(tryCount)))
        ELSE
          suffixStr$ = "_" + LTRIM$(RTRIM$(STR$(tryCount)))
        END IF

        testBase$ = fileNameBase$ + suffixStr$
      ELSE
        EXIT DO
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Update the global base name so the IDE runner launches the newly generated executable
  fileNameBase$ = testBase$

  compileSaveTracker "OPENING EXECUTABLE", 0, 0, 0

  ffTmp = FREEFILE

  OPEN fln$ FOR BINARY AS #ffTmp

  IF outputFileIdx > 0 THEN
    compileSaveTracker "ALLOCATING FILE DATA", 0, outputFileIdx, 0
    outStr$ = SPACE$(outputFileIdx)

    FOR iLong = 0 TO outputFileIdx - 1
      IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
        compileSaveTracker "COPYING FILE DATA", iLong + 1, outputFileIdx, 0
      END IF

      ASC(outStr$, iLong + 1) = outputFile(iLong)
    NEXT

    compileSaveTracker "WRITING EXECUTABLE", outputFileIdx, outputFileIdx, 0
    PUT #ffTmp, , outStr$
  END IF

  compileSaveTracker "FINISHING EXECUTABLE", outputFileIdx, outputFileIdx, 0
  CLOSE #ffTmp

END SUB ' fileSaveBinary

''''''''''''''''''''''''
SUB fileOutputErrorReport (wStr1$, wStr2$)

  rwVar$ = " " ' Necessary, or QB64 won't work correctly

  fln$ = fileNameErr$

  OPEN fln$ FOR BINARY AS #1
  IF LOF(1) > 0 THEN
    CLOSE #1
    KILL fln$
    OPEN fln$ FOR BINARY AS #1
  END IF

  FOR ix = 1 TO LEN(wStr1$)
    rwVar$ = MID$(wStr1$, ix, 1)
    PUT #1, , rwVar$
  NEXT

  rwVar$ = CHR$(13)
  PUT #1, , rwVar$
  rwVar$ = CHR$(10)
  PUT #1, , rwVar$

  IF wStr2$ <> "" THEN
    FOR ix = 1 TO LEN(wStr2$)
      rwVar$ = MID$(wStr2$, ix, 1)
      PUT #1, , rwVar$
    NEXT
    rwVar$ = CHR$(13)
    PUT #1, , rwVar$
    rwVar$ = CHR$(10)
    PUT #1, , rwVar$
  END IF

  CLOSE #1

END SUB ' fileOutputErrorReport

''''''''''''''''''''''''
FUNCTION findComma (startIdx, endIdx)

  DIM commaPos AS LONG

  commaPos = 0
  ff = findNextTokenAtDepth0(startIdx, endIdx, 256 + ASC(","))
  IF ff = 1 THEN
    commaPos = returnedData2
  END IF

  findComma = commaPos

END FUNCTION ' findComma

''''''''''''''''''''''''
SUB findEditorNext

  ' When a match is found, it performs the following tasks:
  ' Updates the cursor position (editor.CursorX and editor.CursorY).
  ' Sets the selection boundaries to highlight the found text.
  ' Adjusts the horizontal and vertical scroll offsets so the found text is visible on the screen.
  ' Assigns focus to the editor window.

  IF editorSearchQuery$ = "" THEN EXIT SUB

  foundMatch = 0
  uQuery$ = UCASE$(editorSearchQuery$)

  FOR iy = editor.CursorY TO editor.LastLine
    uLine$ = UCASE$(editorText$(iy))
    matchPos = INSTR(uLine$, uQuery$)

    IF matchPos > 0 AND iy = editor.CursorY THEN
      matchPos = INSTR(editor.CursorX + 2, uLine$, uQuery$)
    END IF

    IF matchPos > 0 THEN
      editor.CursorY = iy
      editor.CursorX = matchPos - 1
      editor.SelectStartY = iy
      editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
      editor.IsSelecting = 1
      editor.Focus = 1

      editor.ScrollY = editor.CursorY - 14
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
      editor.ScrollX = editor.CursorX - 20
      IF editor.ScrollX < 0 THEN editor.ScrollX = 0

      foundMatch = 1
      EXIT FOR
    END IF
  NEXT

  IF foundMatch = 0 THEN
    FOR iy = 1 TO editor.CursorY
      uLine$ = UCASE$(editorText$(iy))
      matchPos = INSTR(uLine$, uQuery$)

      IF matchPos > 0 THEN
        editor.CursorY = iy
        editor.CursorX = matchPos - 1
        editor.SelectStartY = iy
        editor.SelectStartX = matchPos - 1 + LEN(uQuery$)
        editor.IsSelecting = 1
        editor.Focus = 1

        editor.ScrollY = editor.CursorY - 14
        IF editor.ScrollY < 1 THEN editor.ScrollY = 1
        editor.ScrollX = editor.CursorX - 20
        IF editor.ScrollX < 0 THEN editor.ScrollX = 0

        addStatusMsg "SEARCH RESTARTED AT TOP"

        foundMatch = 1
        EXIT FOR
      END IF
    NEXT
  END IF

  IF foundMatch = 0 THEN
    addStatusMsg "SEARCH: NO MATCHES FOUND"
  END IF

END SUB ' findEditorNext

''''''''''''''''''''''''
SUB undo_StateRestore

  IF undoState.Ready = 0 THEN EXIT SUB

  FOR ii = 1 TO undoState.LastLine
    editorText$(ii) = undoText$(ii)
  NEXT
  FOR ii = undoState.LastLine + 1 TO editor.LastLine
    editorText$(ii) = ""
  NEXT

  editor.CursorX = undoState.CursorX
  editor.CursorY = undoState.CursorY
  editor.ScrollX = undoState.ScrollX
  editor.ScrollY = undoState.ScrollY
  editor.LastLine = undoState.LastLine

  undoState.Ready = 0
  lastActionWasTyping = 0

  addStatusMsg "UNDO USED"

  refineCode 0, 0

END SUB ' undo_StateRestore

''''''''''''''''''''''''
SUB undo_StateSave

  FOR ii = 1 TO editor.LastLine
    undoText$(ii) = editorText$(ii)
  NEXT
  FOR ii = editor.LastLine + 1 TO undoState.LastLine
    undoText$(ii) = ""
  NEXT

  undoState.CursorX = editor.CursorX
  undoState.CursorY = editor.CursorY
  undoState.ScrollX = editor.ScrollX
  undoState.ScrollY = editor.ScrollY
  undoState.LastLine = editor.LastLine

  undoState.Ready = 1

END SUB ' undo_StateSave

''''''''''''''''''''''''
SUB throwCompilerError (errMsg$, wType, wData)

  ' wData is a placeholder

  IF wType = ASIS THEN
    ' Centralized error helper to reduce boilerplate formatting as the compiler grows
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$
  ELSE ' WITHFAILED:
    addStatusMsg "ERROR line " + retLineNumberStr$ + ": " + errMsg$ + " FAILED"
  END IF

  compileError = 1

END SUB ' throwCompilerError

'''''''''''''''''''''''
SUB throwCompilerErrorAndCancelTira (errMsg$, wType, wData)

  ' Combines two frequently used calls into one

  tira_Cancel

  throwCompilerError errMsg$, wType, wData

END SUB ' throwCompilerErrorAndCancelTira

'''''''''''''''''''''''
SUB throwCompilerErrorNoLineNum (errMsg$)

  addStatusMsg "ERROR: " + errMsg$
  compileError = 1

END SUB ' throwCompilerErrorNoLineNum

