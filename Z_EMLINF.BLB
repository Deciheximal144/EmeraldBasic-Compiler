''''''''''''''''''''''''
FUNCTION cTrNum$ (wNum)

  cTrNum$ = LTRIM$(RTRIM$(STR$(wNum)))

END FUNCTION ' cTrNum$

''''''''''''''''''''''''
SUB deleteSelection

  IF editor.IsSelecting = 0 THEN EXIT SUB
  IF editor.SelectStartX = editor.CursorX AND editor.SelectStartY = editor.CursorY THEN EXIT SUB

  IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
    startY = editor.SelectStartY
    startX = editor.SelectStartX
    endY = editor.CursorY
    endX = editor.CursorX
  ELSE
    startY = editor.CursorY
    startX = editor.CursorX
    endY = editor.SelectStartY
    endX = editor.SelectStartX
  END IF

  shiftStartY = startY

  IF startY = endY THEN
    leftPart$ = LEFT$(editorText$(startY), startX)
    rightPart$ = MID$(editorText$(endY), endX + 1)

    editorText$(startY) = leftPart$ + rightPart$
    linesToRemove = 0
  ELSE
    IF editor.CursorY > startY THEN
      rightPart$ = MID$(editorText$(endY), endX + 1)
      editorText$(startY) = rightPart$
      linesToRemove = endY - startY
      shiftStartY = startY + 1
    ELSE
      linesToRemove = endY - startY + 1
    END IF
    startX = 0
  END IF

  IF linesToRemove > 0 THEN
    FOR ii = shiftStartY TO editor.LastLine - linesToRemove
      editorText$(ii) = editorText$(ii + linesToRemove)
    NEXT
    FOR ii = editor.LastLine - linesToRemove + 1 TO editor.LastLine
      editorText$(ii) = ""
    NEXT
    remainingLines = editor.LastLine - linesToRemove
    IF remainingLines < 1 THEN remainingLines = 1
    editor.LastLine = remainingLines
  END IF

  editor.CursorX = startX
  editor.CursorY = startY
  editor.SelectStartX = startX
  editor.SelectStartY = startY
  editor.IsSelecting = 0

  visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  IF editor.CursorY < editor.ScrollY THEN editor.ScrollY = editor.CursorY
  IF editor.CursorY >= editor.ScrollY + visibleRows THEN editor.ScrollY = editor.CursorY - visibleRows + 1
  IF editor.CursorX < editor.ScrollX THEN editor.ScrollX = editor.CursorX
  IF editor.CursorX >= editor.ScrollX + editor.EditorColumns THEN editor.ScrollX = editor.CursorX - editor.EditorColumns + 1

END SUB ' deleteSelection

''''''''''''''''''''''''
SUB displayFlashText

  IF flashTextTimer > 0 THEN
    COLOR sysColor.flashTextClr
    flashTextTimer = flashTextTimer - 1
    PrintTextLineWithBanners flashText$, sysColor.flashTextClr, BOTTOM
  END IF

END SUB ' displayFlashText

''''''''''''''''''''''''
SUB drawBorderBox (wPosX, wPosY, wSizeX, wSizeY, fgClr, bgClr)

  IF wSizeX <= 1 THEN EXIT SUB
  IF wSizeY <= 1 THEN EXIT SUB

  endX = wPosX + wSizeX - 1
  endY = wPosY + wSizeY - 1

  IF endX > SCREENSIZEX - 1 THEN endX = SCREENSIZEX - 1
  IF endY > SCREENSIZEY - 1 THEN endY = SCREENSIZEY - 1

  fillClr = bgClr
  IF fillClr = 0 THEN fillClr = editor.windowBgClr

  LINE (wPosX, wPosY)-(endX, endY), fgClr, B
  LINE (wPosX + 1, wPosY + 1)-(endX - 1, endY - 1), fillClr, BF

END SUB ' drawBorderBox

''''''''''''''''''''''''
SUB drawButtonsPMI

  DIM formatSeconds AS DOUBLE

  editorBoxTop = editor.StartY

  funcListBoxH = (15 * (editor.FontHeight + 2)) + 4
  tabH = 16
  tabY = editorBoxTop + funcListBoxH

  hasCode = 0
  IF editor.LastLine > 1 THEN
    hasCode = 1
  ELSE
    IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
  END IF

  curExt$ = fileNameCustomExt$

  LEFT_BOX_X_NEW = 0

  btnSaveTxtW = editor.ButtonWidth
  btnSaveTxtH = 20
  btnSaveTxtX = LEFT_BOX_X_NEW
  btnSaveTxtY = tabY + (2 * tabH) + 8

  IF hasCode = 0 THEN
    btnSaveTxtBg = sysColor.gray
  ELSE
    btnSaveTxtBg = editor.windowBarClr
  END IF

  drawBorderBox btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH, 15, btnSaveTxtBg
  PrintStr btnSaveTxtX + (btnSaveTxtW - (LEN("SAVE FAST") * FONT_WIDTH)) \ 2, btnSaveTxtY + 6, "SAVE FAST", 15, 0, 1

  btnLoadTxtW = editor.ButtonWidth
  btnLoadTxtH = 20
  btnLoadTxtX = btnSaveTxtX
  btnLoadTxtY = btnSaveTxtY + btnSaveTxtH + 8

  drawBorderBox btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH, 15, editor.windowBarClr
  PrintStr btnLoadTxtX + (btnLoadTxtW - (LEN("LOAD FAST") * FONT_WIDTH)) \ 2, btnLoadTxtY + 6, "LOAD FAST", 15, 0, 1

  btnCompileW = editor.ButtonWidth
  btnCompileH = 20
  btnCompileX = btnSaveTxtX
  btnCompileY = btnLoadTxtY + btnLoadTxtH + 8

  IF compileState <> COMP_IDLE OR hasCode = 0 THEN
    btnCompileBg = sysColor.gray
  ELSE
    btnCompileBg = editor.windowBarClr
  END IF

  drawBorderBox btnCompileX, btnCompileY, btnCompileW, btnCompileH, 15, btnCompileBg
  PrintStr btnCompileX + (btnCompileW - (LEN("COMPILE") * FONT_WIDTH)) \ 2, btnCompileY + 6, "COMPILE", 15, 0, 1

  ' Protect from Z-Order click-through if top menu dropdown is active
  IF editor.TopMenuFocus = 0 THEN
    IF mouseClickedInBox(btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH, 0) THEN
      IF hasCode = 1 THEN
        editor.Focus = 1
        addStatusMsg "SAVING " + fileNameBase$ + curExt$ + "..."

        drawBorderBox btnSaveTxtX, btnSaveTxtY, btnSaveTxtW, btnSaveTxtH, 15, sysColor.gray
        PrintStr btnSaveTxtX + (btnSaveTxtW - (LEN("SAVE FAST") * FONT_WIDTH)) \ 2, btnSaveTxtY + 6, "SAVE FAST", 15, 0, 1

        drawStatusPMI
        drawTopMenuAndScrollPMI
        drawFuncListPMI
        drawCornerPMI
        showCursorData editor.CursorDataBaseX, SCREENSIZEY - 49
        _DEST 0
        _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), logicalScreen, 0
        _DISPLAY
        _DEST logicalScreen

        fileCodeSave

        addStatusMsg "SAVED " + fileNameBase$ + curExt$
      END IF
    END IF

    IF mouseClickedInBox(btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH, 0) THEN
      editor.Focus = 1
      tempName$ = fileNameBase$ + curExt$

      IF _FILEEXISTS(tempName$) THEN
        addStatusMsg "LOADING " + fileNameBase$ + curExt$ + "..."

        drawBorderBox btnLoadTxtX, btnLoadTxtY, btnLoadTxtW, btnLoadTxtH, 15, sysColor.gray
        PrintStr btnLoadTxtX + (btnLoadTxtW - (LEN("LOAD FAST") * FONT_WIDTH)) \ 2, btnLoadTxtY + 6, "LOAD FAST", 15, 0, 1

        drawStatusPMI
        drawTopMenuAndScrollPMI
        drawFuncListPMI
        drawCornerPMI
        showCursorData editor.CursorDataBaseX, SCREENSIZEY - 49
        _DEST 0
        _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), logicalScreen, 0
        _DISPLAY
        _DEST logicalScreen

        fileCodeLoad
        refineCode 0, 0

        editor.CursorX = 0
        editor.CursorY = 1
        editor.ScrollY = 1
        editor.ScrollX = 0
        editor.SelectStartX = 0
        editor.SelectStartY = 1
        editor.IsSelecting = 0
        editor.Focus = 1

        statusResult$ = "LOADED " + fileNameBase$ + curExt$
        addStatusMsg statusResult$

        IF fileLoadTiming.Ready = 1 THEN
          formatSeconds = TIMER - fileLoadTiming.RefineStart
          IF formatSeconds < 0 THEN formatSeconds = formatSeconds + 86400
          fileLoadTiming.Ready = 0
          addStatusMsgContinuation fileTimingReport$("LOAD", fileLoadTiming.ReadSeconds, fileLoadTiming.UndoSeconds, fileLoadTiming.TextSeconds, formatSeconds)
          compileStatusMsg$ = statusResult$
        END IF
      ELSE
        throwCompilerError tempName$ + " DOES NOT EXIST", ASIS, 0
      END IF
    END IF

    IF mouseClickedInBox(btnCompileX, btnCompileY, btnCompileW, btnCompileH, 0) THEN
      IF compileState = COMP_IDLE AND hasCode = 1 THEN
        editor.Focus = 1

        compileState = COMP_REFINE
        editor.StatusSelectedIndex = 0

        wFln$ = fileNameBase$ + ".exe"
        IF _FILEEXISTS(wFln$) THEN
          delCmd$ = "cmd /c del /F /Q " + CHR$(34) + wFln$ + CHR$(34)
          SHELL _HIDE delCmd$

          IF _FILEEXISTS(wFln$) THEN
            addStatusMsg "STARTING COMPILE OF " + fileNameBase$ + curExt$
            redrawAll
            dispScreenFlushUpdate

            addStatusMsg "OUTPUT FILE IN USE, PAUSING"
            redrawAll
            dispScreenFlushUpdate
            waitTimer 1.5
          END IF
        END IF
      END IF
    END IF
  END IF

END SUB ' drawButtonsPMI

''''''''''''''''''''''''
SUB drawClearBox (wPosX, wPosY, wSizeX, wSizeY, fgClr)

  IF wSizeX <= 1 THEN EXIT SUB
  IF wSizeY <= 1 THEN EXIT SUB

  endX = wPosX + wSizeX - 1
  endY = wPosY + wSizeY - 1

  IF endX > SCREENSIZEX - 1 THEN endX = SCREENSIZEX - 1
  IF endY > SCREENSIZEY - 1 THEN endY = SCREENSIZEY - 1

  LINE (wPosX, wPosY)-(endX, endY), fgClr, B

END SUB ' drawClearBox

''''''''''''''''''''''''
SUB drawCornerPMI

  STATIC statePressHandled AS LONG

  ' Renders the top right window control buttons and manages window state toggling such as fullscreen or exiting

  closeBtnW = editor.CloseWidth - 1
  closeBtnX = SCREENSIZEX - closeBtnW
  closeBtnY = 0
  closeBtnH = 15

  dropW = editor.WindowDropWidth
  dropH = 15
  dropX = SCREENSIZEX - dropW
  dropY = closeBtnY + closeBtnH - 1

  minW = editor.WindowMinWidth
  minH = 15
  minX = dropX - minW + 1
  minY = dropY

  stateBtnX = minX
  stateBtnW = closeBtnX - minX + 1
  stateBtnY = 0
  stateBtnH = 15

  IF mouse.Clicked1 THEN statePressHandled = 0

  IF mouse.Clicked1 THEN
    IF mouseDownWithinBoxBounds(closeBtnX, closeBtnY, closeBtnW, closeBtnH) THEN
      IF editor.TopMenuFocus = 4 THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = 4
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
      mouse.Clicked1 = 0
    END IF
  END IF

  IF editor.TopMenuFocus = 4 THEN
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, sysColor.gray
    PrintStr closeBtnX + 4, closeBtnY + 3, "?", 15, 0, 1
  ELSE
    drawBorderBox closeBtnX, closeBtnY, closeBtnW, closeBtnH, 15, editor.CloseClr
    PrintStr closeBtnX + 4, closeBtnY + 3, "X", 15, 0, 1
  END IF

  IF editor.TopMenuFocus = 4 OR editor.WindowState = WIN_STATE_RES THEN
    IF editor.WindowState = WIN_STATE_RES THEN stateText$ = "MED"
    IF editor.WindowState = WIN_STATE_MED THEN stateText$ = "MAX"
    IF editor.WindowState = WIN_STATE_MAX THEN stateText$ = "RES"

    drawBorderBox stateBtnX, stateBtnY, stateBtnW, stateBtnH, 15, editor.windowBarClr
    IF mouseWithinBoxBounds(stateBtnX, stateBtnY, stateBtnW, stateBtnH) THEN
      drawClearBox stateBtnX + 1, stateBtnY + 1, stateBtnW - 2, stateBtnH - 2, 9
    END IF
    PrintStr stateBtnX + (stateBtnW - (LEN(stateText$) * FONT_WIDTH)) \ 2 + 1, stateBtnY + 3, stateText$, 15, 0, 1
  END IF

  IF editor.TopMenuFocus = 4 THEN
    drawBorderBox dropX, dropY, dropW, dropH, 15, editor.windowBarClr
    IF mouseWithinBoxBounds(dropX, dropY + 1, dropW, dropH - 1) THEN
      drawClearBox dropX + 1, dropY + 1, dropW - 2, dropH - 2, editor.CloseClr
    END IF
    PrintStr dropX + (dropW - (LEN("END") * FONT_WIDTH) + 1) \ 2 + 1, dropY + 3, "END", 15, 0, 1

    drawBorderBox minX, minY, minW, minH, 15, editor.windowBarClr
    IF mouseWithinBoxBounds(minX, minY + 1, minW, minH - 1) THEN
      drawClearBox minX + 1, minY + 1, minW - 2, minH - 2, 9
    END IF

    LINE (minX + 4, minY + minH - 5)-(minX + minW - 5, minY + minH - 5), 15

    LINE (minX - 1, dropY)-(minX - 1, dropY + dropH), 0
    LINE (minX - 1, dropY + dropH)-(dropX + dropW - 1, dropY + dropH), 0

    IF keyCheck("SPACE") THEN
      editor.MenuClicked = 1
      editor.WindowState = editor.WindowState + 1
      IF editor.WindowState > 2 THEN editor.WindowState = 0
      applyWindowState
      editor.TopMenuFocus = 0
      waitKeyRelease "SPACE"
    END IF

    IF keyCheck("*") THEN
      editor.MenuClicked = 1
      drawClearBox dropX + 1, dropY + 1, dropW - 2, dropH - 2, editor.CloseClr
      dispScreenFlushUpdate
      waitTimer 0.1
      SYSTEM
    END IF
  END IF

  stateActivated = 0

  IF statePressHandled = 0 THEN
    IF editor.TopMenuFocus = 4 THEN
      ' The shared border with X belongs to X.
      IF mouse.Clicked1 THEN
        IF mouseDownWithinBoxBounds(stateBtnX, stateBtnY, stateBtnW - 1, stateBtnH) THEN
          stateActivated = 1
          statePressHandled = 1
          mouse.Clicked1 = 0
        END IF
      END IF

      IF mouseClickedInBox(stateBtnX, stateBtnY, stateBtnW - 1, stateBtnH, 1) THEN stateActivated = 1
    ELSE
      IF editor.WindowState = WIN_STATE_RES THEN
        IF mouseClickedInBox(stateBtnX, stateBtnY, stateBtnW - 1, stateBtnH, 0) THEN stateActivated = 1
      END IF
    END IF
  END IF

  IF stateActivated = 1 THEN
    editor.MenuClicked = 1
    editor.WindowState = editor.WindowState + 1
    IF editor.WindowState > 2 THEN editor.WindowState = 0
    applyWindowState
    editor.TopMenuFocus = 0
  END IF

  IF editor.TopMenuFocus = 4 THEN
    IF mouseClickedInBox(dropX, dropY + 1, dropW, dropH - 1, 1) OR (mouse.Clicked1 AND mouseDownWithinBoxBounds(dropX, dropY + 1, dropW, dropH - 1)) THEN
      editor.MenuClicked = 1
      mouse.Released1 = 0
      SYSTEM
    END IF

    IF mouseClickedInBox(minX, minY + 1, minW, minH - 1, 1) OR (mouse.Clicked1 AND mouseDownWithinBoxBounds(minX, minY + 1, minW, minH - 1)) THEN
      editor.MenuClicked = 1
      _SCREENICON
      editor.TopMenuFocus = 0
    END IF

    IF mouseClickedInBox(SCREENSIZEX - editor.WindowMenuHitWidth, 0, editor.WindowMenuHitWidth, dropY + dropH, 1) THEN editor.MenuClicked = 1
  END IF

  IF mouse.Released1 THEN
    IF statePressHandled = 1 THEN mouse.Released1 = 0
    statePressHandled = 0
  END IF

END SUB ' drawCornerPMI

''''''''''''''''''''''''
SUB drawEditorPMI

  IF editor.CursorY > editor.LastLine THEN editor.LastLine = editor.CursorY

  refreshRoutineList = 0
  IF editorSyntax.LastLine <> editor.LastLine THEN refreshRoutineList = 1

  IF editorSyntax.CursorLine >= 1 AND editorSyntax.CursorLine <= EDITOR_LINE_MAX THEN
    IF editorSyntaxCursorText$ <> editorText$(editorSyntax.CursorLine) THEN
      previousRoutine$ = retUIRoutineName$(editorSyntaxCursorText$)
      currentRoutine$ = retUIRoutineName$(editorText$(editorSyntax.CursorLine))
      IF previousRoutine$ <> currentRoutine$ THEN refreshRoutineList = 1
    END IF
  END IF

  IF editorSyntax.CursorLine <> editor.CursorY THEN
    currentRoutine$ = retUIRoutineName$(editorText$(editor.CursorY))
    previousRoutine$ = ""

    routineIdx = 0
    DO WHILE routineIdx < uiSubCount
      IF uiSubLine(routineIdx) = editor.CursorY THEN
        previousRoutine$ = uiSubName$(routineIdx)
        EXIT DO
      END IF
      IF uiSubLine(routineIdx) > editor.CursorY THEN EXIT DO
      routineIdx = routineIdx + 1
    LOOP

    IF previousRoutine$ <> currentRoutine$ THEN refreshRoutineList = 1
  END IF

  ' Refresh the existing routine list after an edit without changing the source text
  IF refreshRoutineList = 1 THEN
    uiSubCount = 0

    FOR routineLine = 1 TO editor.LastLine
      routineScan$ = LTRIM$(editorText$(routineLine))
      IF LEN(routineScan$) > 0 THEN
        SELECT CASE ASC(routineScan$, 1)
          CASE 83, 115, 70, 102, 9
            routineName$ = retUIRoutineName$(routineScan$)
            IF routineName$ <> "" THEN
              IF uiSubCount >= MAX_UI_SUBS THEN EXIT FOR
              uiSubName$(uiSubCount) = routineName$
              uiSubLine(uiSubCount) = routineLine
              uiSubCount = uiSubCount + 1
            END IF
        END SELECT
      END IF
    NEXT

    maxFuncScroll = 0
    IF uiSubCount + 1 > 14 THEN maxFuncScroll = uiSubCount + 1 - 14
    IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
    IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
  END IF

  editorSyntax.LastLine = editor.LastLine
  editorSyntax.RoutineCount = uiSubCount
  editorSyntax.CursorLine = editor.CursorY
  editorSyntaxCursorText$ = editorText$(editor.CursorY)

  ' Build whole-name matches from the existing list, including names without type suffixes
  routineLookupSize = 1
  routineIdx = 0
  DO WHILE routineIdx < uiSubCount
    routineLookupSize = routineLookupSize + (2 * LEN(uiSubName$(routineIdx))) + 2
    routineIdx = routineIdx + 1
  LOOP

  routineNames$ = SPACE$(routineLookupSize)
  MID$(routineNames$, 1, 1) = "|"
  routineWritePos = 2

  routineIdx = 0
  DO WHILE routineIdx < uiSubCount
    routineFull$ = UCASE$(uiSubName$(routineIdx))
    routineEntry$ = routineFull$ + "|"
    MID$(routineNames$, routineWritePos, LEN(routineEntry$)) = routineEntry$
    routineWritePos = routineWritePos + LEN(routineEntry$)

    routineBaseLen = LEN(routineFull$)
    DO WHILE routineBaseLen > 0
      routineChar = ASC(routineFull$, routineBaseLen)
      IF routineChar = 36 OR routineChar = 37 OR routineChar = 38 OR routineChar = 33 OR routineChar = 35 OR routineChar = 126 THEN
        routineBaseLen = routineBaseLen - 1
      ELSE
        EXIT DO
      END IF
    LOOP

    IF routineBaseLen > 0 AND routineBaseLen < LEN(routineFull$) THEN
      routineEntry$ = LEFT$(routineFull$, routineBaseLen) + "|"
      MID$(routineNames$, routineWritePos, LEN(routineEntry$)) = routineEntry$
      routineWritePos = routineWritePos + LEN(routineEntry$)
    END IF
    routineIdx = routineIdx + 1
  LOOP

  routineNames$ = LEFT$(routineNames$, routineWritePos - 1)

  EDITOR_BOX_X_NEW = editor.EditorDivider
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = editor.editorTextX
  editorTextW = editor.EditorTextWidth

  rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  textH = textRows * rowH
  editorBoxH = textH + 3

  editorScrollBarX = editor.EditorScrollX
  editorScrollBarY = editorBoxTop
  editorScrollBarW = editor.ScrollbarWidth

  hScrollY = editorBoxY + textH
  hScrollX = editor.EditorLeft
  hScrollW = editorScrollBarX - hScrollX

  IF editor.Focus = 1 THEN
    focusX = editor.EditorLeft - 1
    focusY = editorBoxTop - 1
    focusW = (editorScrollBarX + editorScrollBarW + 1) - focusX
    focusH = editorBoxH + editor.EditorFocusExtra
    drawClearBox focusX, focusY, focusW, focusH, sysColor.focusBorder
  END IF

  newBoxX = editor.EditorLeft
  newBoxW = (editorScrollBarX + editorScrollBarW) - newBoxX
  drawBorderBox newBoxX, editorBoxTop, newBoxW, editorBoxH + editor.HScrollHeight, 15, 0

  LINE (EDITOR_BOX_X_NEW, editorBoxTop)-(EDITOR_BOX_X_NEW, editorBoxTop + editorBoxH + editor.HScrollHeight - 1), 15

  drawBorderBox hScrollX, hScrollY, hScrollW, editor.HScrollHeight, 15, 0

  drawBorderBox hScrollX, hScrollY, editor.HScrollArrowWidth, editor.HScrollHeight, 15, 0
  drawBorderBox hScrollX + hScrollW - editor.HScrollRightInset, hScrollY, editor.HScrollArrowWidth, editor.HScrollHeight, 15, 0

  PrintChr hScrollX + 2, hScrollY + 2, CHR$(17), 15, 0, 1
  PrintChr hScrollX + hScrollW - editor.HScrollRightInset + editor.HScrollRightGlyph, hScrollY + 2, CHR$(16), 15, 0, 1

  maxLen = 0
  scanEnd = editor.ScrollY + textRows - 1
  IF scanEnd > editor.LastLine THEN scanEnd = editor.LastLine

  FOR iy = editor.ScrollY TO scanEnd
    i2 = LEN(editorText$(iy))
    IF i2 > maxLen THEN maxLen = i2
  NEXT

  FOR stepIdx = 1 TO 1000
    editor.WidthScanIdx = editor.WidthScanIdx + 1
    IF editor.WidthScanIdx > editor.LastLine THEN
      editor.WidthCachedMaxLen = editor.WidthTempMaxLen
      editor.WidthTempMaxLen = 0
      editor.WidthScanIdx = 1
    END IF
    i2 = LEN(editorText$(editor.WidthScanIdx))
    IF i2 > editor.WidthTempMaxLen THEN editor.WidthTempMaxLen = i2
  NEXT

  IF editor.WidthCachedMaxLen > maxLen THEN maxLen = editor.WidthCachedMaxLen
  IF editor.WidthTempMaxLen > maxLen THEN maxLen = editor.WidthTempMaxLen
  IF editor.CursorX > maxLen THEN maxLen = editor.CursorX

  maxScrollX = maxLen - editor.EditorColumns + 2
  IF maxScrollX < 0 THEN maxScrollX = 0
  IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX

  thumbWEd = hScrollW - editor.HScrollArrowWidth - editor.HScrollRightInset
  IF maxScrollX = 0 THEN
    thumbSizeX = thumbWEd
    thumbXEd = hScrollX + editor.HScrollArrowWidth
  ELSE
    thumbSizeX = (editor.EditorColumns * thumbWEd) \ (maxLen + 2)
    IF thumbSizeX < SCROLL_THUMB_MIN THEN thumbSizeX = SCROLL_THUMB_MIN
    thumbXEd = hScrollX + editor.HScrollArrowWidth + ((editor.ScrollX * (thumbWEd - thumbSizeX)) \ maxScrollX)
  END IF
  drawBorderBox thumbXEd, hScrollY + 1, thumbSizeX, editor.HScrollHeight - 2, 12, 15

  hasSelection = 0
  IF editor.IsSelecting = 1 THEN
    IF editor.SelectStartX <> editor.CursorX OR editor.SelectStartY <> editor.CursorY THEN hasSelection = 1
  END IF

  FOR iy = 0 TO textRows - 1
    actualY = iy + editor.ScrollY
    IF actualY > EDITOR_LINE_MAX THEN EXIT FOR
    lineNum = actualY
    numStr$ = LTRIM$(RTRIM$(STR$(lineNum)))
    numPosX = (EDITOR_BOX_X_NEW - editor.GutterPadding) - (LEN(numStr$) * FONT_WIDTH)

    IF actualY = editor.CursorY THEN
      lineColor = 15
    ELSE
      lineColor = 11
    END IF

    PrintStr numPosX, editorBoxY + (iy * rowH) + TEXT_GAP_TOP, numStr$, lineColor, 0, 1

    IF actualY = editor.CursorY AND hasSelection = 0 THEN
      LINE (EDITOR_BOX_X_NEW + 1, editorBoxY + (iy * rowH))-(editorScrollBarX - 1, editorBoxY + (iy * rowH) + rowH - 1), sysColor.currentLine, BF
    END IF

    IF hasSelection = 1 THEN
      IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
        StartY = editor.SelectStartY
        startX = editor.SelectStartX
        endY = editor.CursorY
        endX = editor.CursorX
      ELSE
        StartY = editor.CursorY
        startX = editor.CursorX
        endY = editor.SelectStartY
        endX = editor.SelectStartX
      END IF

      wholeLines = 0
      IF StartY <> endY THEN wholeLines = 1

      IF actualY >= StartY AND actualY <= endY THEN
        IF wholeLines = 1 THEN
          hlStartX = 0
          hlEndX = editor.EditorColumns
          IF editor.CursorY > StartY AND actualY = endY THEN hlEndX = endX - editor.ScrollX
        ELSE
          hlStartX = startX - editor.ScrollX
          hlEndX = endX - editor.ScrollX
        END IF

        IF hlStartX < 0 THEN hlStartX = 0
        IF hlEndX > editor.EditorColumns THEN hlEndX = editor.EditorColumns

        IF hlStartX < hlEndX THEN
          LINE (editorTextX + (hlStartX * FONT_WIDTH), editorBoxY + (iy * rowH))-(editorTextX + (hlEndX * FONT_WIDTH) - 1, editorBoxY + (iy * rowH) + rowH - 1), 1, BF
        END IF
      END IF
    END IF

    IF actualY <= EDITOR_LINE_MAX THEN
      IF editorText$(actualY) <> "" THEN
        printText$ = MID$(editorText$(actualY), editor.ScrollX + 1, editor.EditorColumns)
        PrintStr editorTextX, editorBoxY + (iy * rowH) + TEXT_GAP_TOP, printText$, 15, 0, 1


        ' Scan from the start of the line so scrolling cannot hide a quote or comment
        syntaxLine$ = editorText$(actualY)
        syntaxLen = LEN(syntaxLine$)
        syntaxFirst = editor.ScrollX + 1
        syntaxLast = editor.ScrollX + editor.EditorColumns
        IF syntaxLast > syntaxLen THEN syntaxLast = syntaxLen
        syntaxPos = 1
        syntaxPrevChar = 0
        syntaxPrevWord$ = ""
        syntaxStatementStart = 1
        syntaxExpectName = 0
        syntaxCommentStart = 0

        DO WHILE syntaxPos <= syntaxLast
          syntaxChar = ASC(syntaxLine$, syntaxPos)

          SELECT CASE syntaxChar

            CASE 32, 9
              syntaxPos = syntaxPos + 1

            CASE 39
              syntaxCommentStart = syntaxPos
              EXIT DO

            CASE 34
              syntaxStart = syntaxPos
              syntaxPos = syntaxPos + 1
              DO WHILE syntaxPos <= syntaxLen
                IF ASC(syntaxLine$, syntaxPos) = 34 THEN
                  syntaxPos = syntaxPos + 1
                  IF syntaxPos <= syntaxLen THEN
                    IF ASC(syntaxLine$, syntaxPos) = 34 THEN
                      syntaxPos = syntaxPos + 1
                    ELSE
                      EXIT DO
                    END IF
                  ELSE
                    EXIT DO
                  END IF
                ELSE
                  syntaxPos = syntaxPos + 1
                END IF
              LOOP

              syntaxDrawStart = syntaxStart
              syntaxDrawEnd = syntaxPos - 1
              IF syntaxDrawStart < syntaxFirst THEN syntaxDrawStart = syntaxFirst
              IF syntaxDrawEnd > syntaxLast THEN syntaxDrawEnd = syntaxLast

              IF syntaxDrawStart <= syntaxDrawEnd THEN
                syntaxText$ = MID$(syntaxLine$, syntaxDrawStart, syntaxDrawEnd - syntaxDrawStart + 1)
                PrintStr editorTextX + ((syntaxDrawStart - syntaxFirst) * FONT_WIDTH), editorBoxY + (iy * rowH) + TEXT_GAP_TOP, syntaxText$, sysColor.stringClr, 0, 1
              END IF

              syntaxPrevChar = 0
              syntaxPrevWord$ = ""
              syntaxStatementStart = 0
              syntaxExpectName = 0

            CASE 58
              syntaxPos = syntaxPos + 1
              syntaxPrevChar = 0
              syntaxPrevWord$ = ""
              syntaxStatementStart = 1
              syntaxExpectName = 0

            CASE 48 TO 57, 46
              syntaxIsNumber = 0
              IF syntaxChar = 46 THEN
                IF syntaxPos < syntaxLen THEN
                  syntaxNextChar = ASC(syntaxLine$, syntaxPos + 1)
                  IF syntaxNextChar >= 48 AND syntaxNextChar <= 57 THEN syntaxIsNumber = 1
                END IF
              ELSE
                syntaxIsNumber = 1
              END IF

              IF syntaxIsNumber = 1 THEN
                syntaxStart = syntaxPos
                DO WHILE syntaxPos <= syntaxLen
                  syntaxChar = ASC(syntaxLine$, syntaxPos)
                  IF (syntaxChar >= 65 AND syntaxChar <= 90) OR (syntaxChar >= 97 AND syntaxChar <= 122) OR (syntaxChar >= 48 AND syntaxChar <= 57) OR syntaxChar = 95 OR syntaxChar = 46 OR syntaxChar = 36 OR syntaxChar = 37 OR syntaxChar = 38 OR syntaxChar = 33 OR syntaxChar = 35 OR syntaxChar = 126 THEN
                    syntaxPos = syntaxPos + 1
                  ELSE
                    EXIT DO
                  END IF
                LOOP

                syntaxDrawStart = syntaxStart
                syntaxDrawEnd = syntaxPos - 1
                IF syntaxDrawStart < syntaxFirst THEN syntaxDrawStart = syntaxFirst
                IF syntaxDrawEnd > syntaxLast THEN syntaxDrawEnd = syntaxLast

                IF syntaxDrawStart <= syntaxDrawEnd THEN
                  syntaxText$ = MID$(syntaxLine$, syntaxDrawStart, syntaxDrawEnd - syntaxDrawStart + 1)
                  PrintStr editorTextX + ((syntaxDrawStart - syntaxFirst) * FONT_WIDTH), editorBoxY + (iy * rowH) + TEXT_GAP_TOP, syntaxText$, sysColor.numbers, 0, 1
                END IF

                syntaxPrevChar = 0
              ELSE
                syntaxPrevChar = syntaxChar
                syntaxPos = syntaxPos + 1
              END IF
              syntaxPrevWord$ = ""
              syntaxStatementStart = 0
              syntaxExpectName = 0

            CASE 38
              syntaxRadix = 0
              IF syntaxPos < syntaxLen THEN
                SELECT CASE UCASE$(MID$(syntaxLine$, syntaxPos + 1, 1))
                  CASE "H", "O", "B"
                    syntaxRadix = 1
                END SELECT
              END IF

              IF syntaxRadix = 1 THEN
                syntaxStart = syntaxPos
                syntaxPos = syntaxPos + 2
                DO WHILE syntaxPos <= syntaxLen
                  syntaxChar = ASC(syntaxLine$, syntaxPos)
                  IF (syntaxChar >= 65 AND syntaxChar <= 90) OR (syntaxChar >= 97 AND syntaxChar <= 122) OR (syntaxChar >= 48 AND syntaxChar <= 57) OR syntaxChar = 95 OR syntaxChar = 36 OR syntaxChar = 37 OR syntaxChar = 38 OR syntaxChar = 33 OR syntaxChar = 35 OR syntaxChar = 126 THEN
                    syntaxPos = syntaxPos + 1
                  ELSE
                    EXIT DO
                  END IF
                LOOP

                syntaxDrawStart = syntaxStart
                syntaxDrawEnd = syntaxPos - 1
                IF syntaxDrawStart < syntaxFirst THEN syntaxDrawStart = syntaxFirst
                IF syntaxDrawEnd > syntaxLast THEN syntaxDrawEnd = syntaxLast

                IF syntaxDrawStart <= syntaxDrawEnd THEN
                  syntaxText$ = MID$(syntaxLine$, syntaxDrawStart, syntaxDrawEnd - syntaxDrawStart + 1)
                  PrintStr editorTextX + ((syntaxDrawStart - syntaxFirst) * FONT_WIDTH), editorBoxY + (iy * rowH) + TEXT_GAP_TOP, syntaxText$, sysColor.numbers, 0, 1
                END IF

                syntaxPrevChar = 0
              ELSE
                syntaxPrevChar = syntaxChar
                syntaxPos = syntaxPos + 1
              END IF
              syntaxPrevWord$ = ""
              syntaxStatementStart = 0
              syntaxExpectName = 0

            CASE 65 TO 90, 97 TO 122, 95
              syntaxStart = syntaxPos
              DO WHILE syntaxPos <= syntaxLen
                syntaxChar = ASC(syntaxLine$, syntaxPos)
                IF (syntaxChar >= 65 AND syntaxChar <= 90) OR (syntaxChar >= 97 AND syntaxChar <= 122) OR (syntaxChar >= 48 AND syntaxChar <= 57) OR syntaxChar = 95 THEN
                  syntaxPos = syntaxPos + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              syntaxBaseEnd = syntaxPos
              syntaxBase$ = UCASE$(MID$(syntaxLine$, syntaxStart, syntaxPos - syntaxStart))

              ' REM followed immediately by a dot belongs to a qualified name
              IF syntaxBase$ = "REM" AND syntaxPrevChar <> 46 THEN
                syntaxIsComment = 1
                IF syntaxBaseEnd <= syntaxLen THEN
                  IF ASC(syntaxLine$, syntaxBaseEnd) = 46 THEN syntaxIsComment = 0
                END IF
                IF syntaxIsComment = 1 THEN
                  syntaxCommentStart = syntaxStart
                  EXIT DO
                END IF
              END IF

              DO WHILE syntaxPos <= syntaxLen
                syntaxChar = ASC(syntaxLine$, syntaxPos)
                IF syntaxChar = 36 OR syntaxChar = 37 OR syntaxChar = 38 OR syntaxChar = 33 OR syntaxChar = 35 OR syntaxChar = 126 THEN
                  syntaxPos = syntaxPos + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              syntaxWord$ = UCASE$(MID$(syntaxLine$, syntaxStart, syntaxPos - syntaxStart))

              syntaxIsRoutine = 0
              IF syntaxPrevChar <> 46 AND syntaxPrevChar <> 35 AND syntaxPrevChar <> 36 THEN
                IF syntaxExpectName = 1 THEN
                  syntaxIsRoutine = 1
                ELSE
                  IF INSTR(routineNames$, "|" + syntaxWord$ + "|") > 0 THEN syntaxIsRoutine = 1
                END IF
              END IF

              syntaxTextClr = 0
              syntaxDrawStart = syntaxStart
              IF syntaxIsRoutine = 1 THEN
                syntaxTextClr = sysColor.routineNameClr
              ELSE
                IF syntaxPrevChar <> 46 THEN
                  syntaxKeyword$ = syntaxWord$
                  syntaxIsKeyword = 0

                  IF syntaxStart > 1 THEN
                    syntaxPrefixChar = ASC(syntaxLine$, syntaxStart - 1)
                    IF syntaxPrefixChar = 35 OR syntaxPrefixChar = 36 THEN
                      syntaxKeyword$ = CHR$(syntaxPrefixChar) + syntaxKeyword$
                      syntaxDrawStart = syntaxStart - 1
                    END IF
                  END IF

                  SELECT CASE syntaxKeyword$
                    CASE "_BYTE", "_INTEGER", "_LONG", "_INTEGER64", "_SINGLE", "_DOUBLE", "_STRING", "_STRINGD", "_UNSIGNED", "_ANY"
                      syntaxKeyword$ = MID$(syntaxKeyword$, 2)
                    CASE "CONST", "ALIAS", "BYREF", "OPTION", "BASE", "IS", "OUTPUT", "USING", "$LET", "$IF", "$ELSE", "$ENDIF", "$END"
                      syntaxIsKeyword = 1
                  END SELECT

                  IF syntaxIsKeyword = 0 THEN
                    syntaxKeywordIdx = kwHash(hashString(syntaxKeyword$))
                    DO WHILE syntaxKeywordIdx <> NO_VALID_INDEX
                      IF voc(syntaxKeywordIdx).text = syntaxKeyword$ THEN
                        syntaxIsKeyword = 1
                        EXIT DO
                      END IF
                      syntaxKeywordIdx = voc(syntaxKeywordIdx).HashNext
                    LOOP
                  END IF

                  IF syntaxIsKeyword = 1 THEN syntaxTextClr = sysColor.keywords
                END IF
              END IF

              IF syntaxTextClr <> 0 THEN
                syntaxDrawEnd = syntaxPos - 1
                IF syntaxDrawStart < syntaxFirst THEN syntaxDrawStart = syntaxFirst
                IF syntaxDrawEnd > syntaxLast THEN syntaxDrawEnd = syntaxLast

                IF syntaxDrawStart <= syntaxDrawEnd THEN
                  syntaxText$ = MID$(syntaxLine$, syntaxDrawStart, syntaxDrawEnd - syntaxDrawStart + 1)
                  PrintStr editorTextX + ((syntaxDrawStart - syntaxFirst) * FONT_WIDTH), editorBoxY + (iy * rowH) + TEXT_GAP_TOP, syntaxText$, syntaxTextClr, 0, 1
                END IF
              END IF

              syntaxExpectName = 0
              IF syntaxWord$ = "SUB" OR syntaxWord$ = "FUNCTION" THEN
                IF syntaxStatementStart = 1 OR syntaxPrevWord$ = "DECLARE" THEN syntaxExpectName = 1
              END IF
              syntaxPrevChar = 0
              syntaxPrevWord$ = syntaxWord$
              syntaxStatementStart = 0

            CASE ELSE
              syntaxPrevChar = syntaxChar
              syntaxPrevWord$ = ""
              syntaxStatementStart = 0
              syntaxExpectName = 0
              syntaxPos = syntaxPos + 1

          END SELECT
        LOOP

        IF syntaxCommentStart > 0 THEN
          syntaxDrawStart = syntaxCommentStart
          IF syntaxDrawStart < syntaxFirst THEN syntaxDrawStart = syntaxFirst
          syntaxDrawEnd = syntaxLast

          IF syntaxDrawStart <= syntaxDrawEnd THEN
            syntaxText$ = MID$(syntaxLine$, syntaxDrawStart, syntaxDrawEnd - syntaxDrawStart + 1)
            PrintStr editorTextX + ((syntaxDrawStart - syntaxFirst) * FONT_WIDTH), editorBoxY + (iy * rowH) + TEXT_GAP_TOP, syntaxText$, sysColor.commentClr, 0, 1
          END IF
        END IF
      END IF
    END IF
  NEXT

  IF editor.Focus = 1 THEN
    IF editor.CursorY >= editor.ScrollY AND editor.CursorY < editor.ScrollY + textRows THEN
      IF editor.CursorX >= editor.ScrollX AND editor.CursorX < editor.ScrollX + editor.EditorColumns THEN
        cursorPixelX = editorTextX + ((editor.CursorX - editor.ScrollX) * FONT_WIDTH)
        cursorPixelY = editorBoxY + ((editor.CursorY - editor.ScrollY) * rowH) + TEXT_GAP_TOP

        cursorBlink = INT(TIMER * 2) AND 1
        IF cursorBlink = 1 THEN
          PrintChr cursorPixelX, cursorPixelY, "*", 14, 0, 1
        ELSE
          PrintChr cursorPixelX, cursorPixelY, "_", 14, 0, 1
        END IF
      END IF
    END IF
  END IF

  LastLine = editor.LastLine
  IF editor.CursorY > LastLine THEN LastLine = editor.CursorY

  IF mouse.Wheel <> 0 THEN
    IF mouseWithinBoxBounds(newBoxX, editorBoxTop, newBoxW, editorBoxH + editor.HScrollHeight) THEN
      editor.Focus = 1
      editor.ScrollY = editor.ScrollY + mouse.Wheel
      maxScroll = LastLine - textRows + 1
      IF maxScroll < 1 THEN maxScroll = 1
      IF editor.ScrollY > maxScroll THEN editor.ScrollY = maxScroll
      IF editor.ScrollY < 1 THEN editor.ScrollY = 1
    END IF
  END IF

  IF mouse.Clicked1 THEN
    lastActionWasTyping = 0
    editor.DragActive = 0
    editor.ScrollDragActiveX = 0

    IF mouseWithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) THEN
      editor.DragActive = 1
      editor.Focus = 1
      clickRelX = mouse.PosX - editorTextX
      clickRelY = mouse.PosY - editorBoxY
      newCX = (clickRelX \ FONT_WIDTH) + editor.ScrollX
      newCY = (clickRelY \ rowH) + editor.ScrollY

      IF newCY <> editor.CursorY THEN
        refineCode editor.CursorY, 0
      END IF

      IF newCY > LastLine THEN newCY = LastLine


      IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
        IF editor.IsSelecting = 0 THEN
          editor.SelectStartX = editor.CursorX
          editor.SelectStartY = editor.CursorY
          editor.IsSelecting = 1
        END IF
        editor.CursorX = newCX
        editor.CursorY = newCY
      ELSE
        IF editor.TextClickActive = 1 AND (TIMER - editor.TextLastClickTime) < 0.3 THEN
          editor.TextClickActive = 0
          editor.DragActive = 0

          lineStr$ = editorText$(newCY)
          lineLen = LEN(lineStr$)

          IF lineLen > 0 AND newCX < lineLen THEN
            clickPos = newCX + 1
            IF clickPos > lineLen THEN clickPos = lineLen

            ch$ = MID$(lineStr$, clickPos, 1)
            cType = 3
            IF ch$ = " " OR ch$ = CHR$(9) THEN
              cType = 1
            ELSE
              IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                cType = 2
              END IF
            END IF

            leftBound = clickPos - 1
            DO WHILE leftBound > 0
              ch$ = MID$(lineStr$, leftBound, 1)
              lType = 3
              IF ch$ = " " OR ch$ = CHR$(9) THEN
                lType = 1
              ELSE
                IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                  lType = 2
                END IF
              END IF
              IF lType <> cType THEN EXIT DO
              leftBound = leftBound - 1
            LOOP

            rightBound = clickPos + 1
            DO WHILE rightBound <= lineLen
              ch$ = MID$(lineStr$, rightBound, 1)
              rType = 3
              IF ch$ = " " OR ch$ = CHR$(9) THEN
                rType = 1
              ELSE
                IF INSTR("(),=+-*/\" + CHR$(34) + ":<>';[]{}", ch$) > 0 THEN
                  rType = 2
                END IF
              END IF
              IF rType <> cType THEN EXIT DO
              rightBound = rightBound + 1
            LOOP

            editor.SelectStartX = leftBound
            editor.SelectStartY = newCY
            editor.CursorX = rightBound - 1
            editor.CursorY = newCY
            editor.IsSelecting = 1
          ELSE
            editor.SelectStartX = newCX
            editor.SelectStartY = newCY
            editor.IsSelecting = 0
            editor.CursorX = newCX
            editor.CursorY = newCY
          END IF
        ELSE
          editor.TextLastClickTime = TIMER
          editor.TextClickActive = 1
          editor.SelectStartX = newCX
          editor.SelectStartY = newCY
          editor.IsSelecting = 0
          editor.CursorX = newCX
          editor.CursorY = newCY
        END IF
      END IF
    END IF

    IF mouseWithinBoxBounds(newBoxX, editorBoxY, editorTextX - newBoxX, textH) THEN
      editor.DragActive = 1
      editor.Focus = 1
      clickRelY = mouse.PosY - editorBoxY
      newCY = (clickRelY \ rowH) + editor.ScrollY

      IF newCY <> editor.CursorY THEN
        refineCode editor.CursorY, 0
      END IF

      IF newCY > LastLine THEN newCY = LastLine
      IF newCY < 1 THEN newCY = 1

      editor.CursorX = 0
      editor.CursorY = newCY
      editor.SelectStartX = 0
      editor.SelectStartY = newCY
      editor.IsSelecting = 0
    END IF

    IF mouseWithinBoxBounds(hScrollX, hScrollY, hScrollW, editor.HScrollHeight) THEN
      editor.Focus = 1
      IF mouseWithinBoxBounds(thumbXEd, hScrollY, thumbSizeX, editor.HScrollHeight) THEN
        editor.ScrollDragActiveX = 1
        editor.ScrollDragOffsetX = mouse.PosX - thumbXEd
      ELSE
        IF mouseWithinBoxBounds(hScrollX, hScrollY, editor.HScrollArrowWidth, editor.HScrollHeight) THEN
          editor.ScrollX = editor.ScrollX - 1
          IF editor.ScrollX < 0 THEN editor.ScrollX = 0
        ELSE
          IF mouseWithinBoxBounds(hScrollX + hScrollW - editor.HScrollRightInset, hScrollY, editor.HScrollArrowWidth, editor.HScrollHeight) THEN
            editor.ScrollX = editor.ScrollX + 1
            IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
          ELSE
            IF mouse.PosX < thumbXEd THEN
              editor.ScrollX = editor.ScrollX - 10
              IF editor.ScrollX < 0 THEN editor.ScrollX = 0
            ELSE
              editor.ScrollX = editor.ScrollX + 10
              IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

  IF mouse.Button1Down AND mouse.Clicked1 = 0 THEN
    IF editor.Focus = 1 AND editor.DragActive = 1 THEN
      clickRelX = mouse.PosX - editorTextX
      clickRelY = mouse.PosY - editorBoxY
      newCX = (clickRelX \ FONT_WIDTH) + editor.ScrollX
      newCY = (clickRelY \ rowH) + editor.ScrollY

      maxScroll = LastLine - textRows + 1
      IF maxScroll < 1 THEN maxScroll = 1

      IF mouse.PosY < editorBoxY THEN
        newCY = editor.ScrollY - 1
        IF newCY < 1 THEN newCY = 1
        editor.ScrollY = newCY
      END IF
      IF mouse.PosY >= editorBoxY + textH THEN
        newCY = editor.ScrollY + textRows
        editor.ScrollY = editor.ScrollY + 1
        IF editor.ScrollY > maxScroll THEN editor.ScrollY = maxScroll
      END IF

      IF mouse.PosX < editorTextX THEN
        newCX = editor.ScrollX - 1
        IF newCX < 0 THEN newCX = 0
        editor.ScrollX = newCX
      END IF
      IF mouse.PosX >= editorTextX + editorTextW THEN
        newCX = editor.ScrollX + editor.EditorColumns
        editor.ScrollX = editor.ScrollX + 1
        IF editor.ScrollX > maxScrollX THEN editor.ScrollX = maxScrollX
      END IF

      IF newCY < 1 THEN newCY = 1
      IF newCY > LastLine THEN newCY = LastLine

      IF newCX < 0 THEN newCX = 0

      IF newCX <> editor.CursorX OR newCY <> editor.CursorY THEN
        editor.IsSelecting = 1
        editor.CursorX = newCX
        editor.CursorY = newCY
      END IF
    END IF
  END IF

  IF mouse.Button1Down AND editor.ScrollDragActiveX = 1 THEN
    IF maxScrollX > 0 THEN
      newThumbX = mouse.PosX - editor.ScrollDragOffsetX
      trackSizeX = thumbWEd - thumbSizeX
      IF trackSizeX > 0 THEN
        newScrollX = ((newThumbX - (hScrollX + editor.HScrollArrowWidth)) * maxScrollX) \ trackSizeX
        IF newScrollX < 0 THEN newScrollX = 0
        IF newScrollX > maxScrollX THEN newScrollX = maxScrollX
        editor.ScrollX = newScrollX
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    editor.DragActive = 0
    editor.ScrollDragActiveX = 0
  END IF

  IF mouse.Released2 THEN
    IF mouseWithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) AND mouseDown2WithinBoxBounds(editorTextX, editorBoxY, editorTextW, textH) THEN
      editor.MenuMode = 1
    END IF
  END IF

END SUB ' drawEditorPMI

''''''''''''''''''''''''
SUB drawFuncListPMI

  DIM copyGroupID AS _UNSIGNED LONG

  ' Build sidebar entries from source comments and the existing routine list
  uiFuncListCount = 1
  uiFuncList(0).RecordName = fileNameBase$ + fileNameCustomExt$
  uiFuncList(0).LineNumber = 1
  uiFuncList(0).RoutineIndex = 0
  routineIdx = 0

  FOR sourceLine = 1 TO editor.LastLine
    IF routineIdx < uiSubCount THEN
      IF uiSubLine(routineIdx) = sourceLine THEN
        uiFuncList(uiFuncListCount).RecordName = uiSubName$(routineIdx)
        uiFuncList(uiFuncListCount).LineNumber = sourceLine
        uiFuncList(uiFuncListCount).RoutineIndex = routineIdx + 1
        uiFuncListCount = uiFuncListCount + 1
        routineIdx = routineIdx + 1
      END IF
    END IF

    headerStart = INSTR(editorText$(sourceLine), "'")
    IF headerStart > 0 THEN
      DO
        IF UCASE$(MID$(editorText$(sourceLine), headerStart, 9)) <> "'IMPORTED" THEN EXIT DO

        headerValid = 1
        FOR headerPos = 1 TO headerStart - 1
          headerChar = ASC(editorText$(sourceLine), headerPos)
          IF headerChar <> 32 AND headerChar <> 9 THEN
            headerValid = 0
            EXIT FOR
          END IF
        NEXT
        IF headerValid = 0 THEN EXIT DO

        headerText$ = MID$(editorText$(sourceLine), headerStart + 9)
        headerLen = LEN(headerText$)
        IF headerLen < 4 THEN EXIT DO

        headerChar = ASC(headerText$, 1)
        IF headerChar <> 32 AND headerChar <> 9 THEN EXIT DO

        headerPos = 1
        DO WHILE headerPos <= headerLen
          headerChar = ASC(headerText$, headerPos)
          IF headerChar <> 32 AND headerChar <> 9 THEN EXIT DO
          headerPos = headerPos + 1
        LOOP
        IF headerPos >= headerLen THEN EXIT DO
        IF ASC(headerText$, headerPos) <> 34 THEN EXIT DO

        headerEnd = INSTR(headerPos + 1, headerText$, CHR$(34))
        IF headerEnd <= headerPos + 1 THEN EXIT DO

        FOR headerTailPos = headerEnd + 1 TO headerLen
          headerChar = ASC(headerText$, headerTailPos)
          IF headerChar <> 32 AND headerChar <> 9 THEN
            headerValid = 0
            EXIT FOR
          END IF
        NEXT
        IF headerValid = 0 THEN EXIT DO

        uiFuncList(uiFuncListCount).RecordName = MID$(headerText$, headerPos + 1, headerEnd - headerPos - 1)
        uiFuncList(uiFuncListCount).LineNumber = sourceLine
        uiFuncList(uiFuncListCount).RoutineIndex = 0
        uiFuncListCount = uiFuncListCount + 1
        EXIT DO
      LOOP
    END IF
  NEXT

  IF funcListFlashRow > 0 THEN
    flashNow = TIMER
    IF flashNow >= funcListFlashTimeGoal OR flashNow < funcListFlashTimeGoal - 1 THEN
      funcListFlashRow = 0
    END IF
  END IF

  editorBoxTop = editor.StartY
  listRowH = editor.FontHeight + 2

  tabH = 16
  tab1W = editor.SideWidth \ 2
  tab2W = editor.SideWidth - tab1W

  LEFT_BOX_X_NEW = 0

  funcListBoxX = LEFT_BOX_X_NEW
  funcListBoxY = editorBoxTop
  nameColumns = editor.FuncNameColumns
  IF editor.MenuMode = 0 AND funcArrowRight = 1 THEN nameColumns = 24
  funcListBoxW = editor.SideWidth + ((nameColumns - editor.FuncNameColumns) * FONT_WIDTH)
  funcListBoxH = (15 * listRowH) + 4

  tab1X = LEFT_BOX_X_NEW
  tab2X = tab1X + tab1W
  tabY = funcListBoxY + funcListBoxH

  scrollBarX = funcListBoxX + funcListBoxW - editor.ScrollbarWidth
  toggleArrowH = FONT_HEIGHT + 3
  scrollBarY = funcListBoxY + toggleArrowH
  scrollBarW = editor.ScrollbarWidth
  scrollBarH = funcListBoxH - toggleArrowH

  toggleClicked = 0
  IF editor.TopMenuFocus = 0 AND editor.MenuMode = 0 THEN
    IF mouseClickedInBox(scrollBarX, funcListBoxY, scrollBarW, toggleArrowH, 0) THEN
      funcArrowRight = 1 - funcArrowRight
      editor.FuncScroll.DragActive = 0
      toggleClicked = 1
      nameColumns = editor.FuncNameColumns
      IF editor.MenuMode = 0 AND funcArrowRight = 1 THEN nameColumns = 24
      funcListBoxW = editor.SideWidth + ((nameColumns - editor.FuncNameColumns) * FONT_WIDTH)
      scrollBarX = funcListBoxX + funcListBoxW - editor.ScrollbarWidth
    END IF
  END IF

  IF editor.MenuMode = 0 THEN
    tab1Bg = &H93
    tab2Bg = sysColor.gray
  ELSE
    tab1Bg = sysColor.gray
    tab2Bg = &H93
  END IF

  drawBorderBox funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH, 15, 0
  LINE (funcListBoxX + 1, funcListBoxY + 1)-(funcListBoxX + funcListBoxW - 2, funcListBoxY + listRowH + 1), sysColor.gray, BF

  drawBorderBox tab1X, tabY, tab1W, tabH, 15, tab1Bg
  PrintStr tab1X + (tab1W - (LEN("FUNC") * FONT_WIDTH)) \ 2, tabY + 4, "FUNC", 15, 0, 1

  drawBorderBox tab2X, tabY, tab2W, tabH, 15, tab2Bg
  PrintStr tab2X + (tab2W - (LEN("EDIT") * FONT_WIDTH)) \ 2, tabY + 4, "EDIT", 15, 0, 1

  maxLines = 14
  listCount = uiFuncListCount
  fileRowClr = 210

  IF editor.MenuMode = 0 THEN
    processVScrollbar SCROLL_FUNC, scrollBarX, scrollBarY, scrollBarW, scrollBarH, listCount, maxLines, 0

    PrintStr funcListBoxX + (funcListBoxW - scrollBarW - (LEN("FUNCTIONS") * FONT_WIDTH)) \ 2, funcListBoxY + 3, "FUNCTIONS", 15, 0, 1
    FOR ii = 0 TO maxLines - 1
      listIdx = ii + editor.FuncScroll.ScrollY
      IF listIdx < listCount THEN
        rowY = funcListBoxY + 3 + ((ii + 1) * listRowH)
        rowBg = 0
        rowTextX = funcListBoxX + editor.FuncTextPadding
        rowNameColumns = nameColumns
        IF funcArrowRight = 1 AND uiFuncList(listIdx).RoutineIndex > 0 THEN
          rowTextX = rowTextX + FONT_WIDTH
          rowNameColumns = rowNameColumns - 1
        END IF
        sOutName$ = LEFT$(uiFuncList(listIdx).RecordName, rowNameColumns)

        IF uiFuncList(listIdx).RoutineIndex = 0 THEN
          rowBg = fileRowClr
          listColor = 15
        ELSE
          subIdx = uiFuncList(listIdx).RoutineIndex - 1

          isCurrent = 0
          startLine = uiSubLine(subIdx)
          endLine = editor.LastLine
          IF subIdx + 1 < uiSubCount THEN
            endLine = uiSubLine(subIdx + 1) - 1
          END IF

          IF editor.CursorY >= startLine AND editor.CursorY <= endLine THEN
            isCurrent = 1
          END IF

          IF isCurrent = 1 THEN
            listColor = 15
          ELSE
            listColor = 11
          END IF

        END IF

        IF funcListFlashRow = listIdx + 1 THEN
          rowBg = 1
          listColor = 15
        END IF

        IF rowBg <> 0 THEN
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - scrollBarW - 1, rowY + listRowH - 1), rowBg, BF
        END IF
        PrintStr rowTextX, rowY + 1, sOutName$, listColor, 0, 1
      END IF
    NEXT
  ELSE
    PrintStr funcListBoxX + (funcListBoxW - (LEN("EDIT") * FONT_WIDTH)) \ 2, funcListBoxY + 3, "EDIT", 15, 0, 1

    IF editor.MenuMode = 1 THEN
      hasSelection = 0
      IF editor.IsSelecting = 1 THEN
        IF editor.CursorY <> editor.SelectStartY OR editor.CursorX <> editor.SelectStartX THEN
          hasSelection = 1
        END IF
      END IF

      IF hasSelection = 1 THEN
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (1 * listRowH), "CUT", 15, 0, 1
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (2 * listRowH), "COPY", 15, 0, 1
      ELSE
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (1 * listRowH), "NO TEXT", sysColor.gray, 0, 1
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (2 * listRowH), "SELECTED", sysColor.gray, 0, 1
      END IF

      PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (3 * listRowH), "PASTE", 15, 0, 1
      PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (4 * listRowH), "CANCEL", 15, 0, 1
    ELSE
      IF editor.MenuMode = 2 THEN
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (1 * listRowH), "COPY", 15, 0, 1
        PrintStr funcListBoxX + editor.FuncMenuPadding, funcListBoxY + 4 + (2 * listRowH), "CANCEL", 15, 0, 1
      END IF
    END IF
  END IF

  IF editor.MenuMode = 0 THEN
    drawBorderBox scrollBarX, funcListBoxY, scrollBarW, toggleArrowH, 15, editor.windowBarClr
    arrowChar = 16
    IF funcArrowRight = 1 THEN arrowChar = 17
    PrintChr scrollBarX + (scrollBarW - FONT_WIDTH) \ 2 + 1, funcListBoxY + 2, CHR$(arrowChar), 15, 0, 1
  END IF

  IF mouse.Wheel <> 0 THEN
    IF editor.TopMenuFocus = 0 THEN
      IF mouseWithinBoxBounds(funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH) THEN
        editor.FuncScroll.ScrollY = editor.FuncScroll.ScrollY + mouse.Wheel
        maxFuncScroll = listCount - maxLines
        IF maxFuncScroll < 0 THEN maxFuncScroll = 0
        IF editor.FuncScroll.ScrollY > maxFuncScroll THEN editor.FuncScroll.ScrollY = maxFuncScroll
        IF editor.FuncScroll.ScrollY < 0 THEN editor.FuncScroll.ScrollY = 0
      END IF
    END IF
  END IF

  IF mouse.Released1 AND toggleClicked = 0 THEN
    IF editor.TopMenuFocus = 0 THEN
      wasMenuMode1 = 0
      wasMenuMode2 = 0

      IF mouseClickedInBox(tab1X, tabY, tab1W, tabH, 0) THEN
        editor.MenuMode = 0
      END IF

      IF mouseClickedInBox(tab2X, tabY, tab2W, tabH, 0) THEN
        editor.MenuMode = 1
      END IF

      IF editor.MenuMode = 1 THEN
        wasMenuMode1 = 1

        hasSelection = 0
        IF editor.IsSelecting = 1 THEN
          IF editor.CursorY <> editor.SelectStartY OR editor.CursorX <> editor.SelectStartX THEN
            hasSelection = 1
          END IF
        END IF

        IF hasSelection = 1 THEN
          IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (1 * listRowH), funcListBoxW, listRowH, 0) THEN
            rowY = funcListBoxY + 3 + (1 * listRowH)
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
            PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "CUT", 15, 0, 1
            dispScreenFlushUpdate
            waitTimer UI_FLASH_TIME

            undo_StateSave
            lastActionWasTyping = 0

            copyText$ = retEditorSelection$
            IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
            deleteSelection
            editor.IsSelecting = 0
            editor.MenuMode = 0
          END IF

          IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (2 * listRowH), funcListBoxW, listRowH, 0) THEN
            rowY = funcListBoxY + 3 + (2 * listRowH)
            LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
            PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "COPY", 15, 0, 1
            dispScreenFlushUpdate
            waitTimer UI_FLASH_TIME

            copyText$ = retEditorSelection$
            IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$
            editor.MenuMode = 0
          END IF
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (3 * listRowH), funcListBoxW, listRowH, 0) THEN
          rowY = funcListBoxY + 3 + (3 * listRowH)
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
          PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "PASTE", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          undo_StateSave
          lastActionWasTyping = 0

          pasteClipboardText
          editor.MenuMode = 0
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (4 * listRowH), funcListBoxW, listRowH, 0) THEN
          rowY = funcListBoxY + 3 + (4 * listRowH)
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
          PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "CANCEL", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          editor.MenuMode = 0
        END IF
      END IF

      IF editor.MenuMode = 2 THEN
        wasMenuMode2 = 1

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (1 * listRowH), funcListBoxW, listRowH, 0) THEN
          rowY = funcListBoxY + 3 + (1 * listRowH)
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
          PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "COPY", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          hlStart = editor.StatusSelectedIndex
          hlEnd = editor.StatusSelectedIndex
          IF hlStart > 0 THEN
            sLine = statusMsg(hlStart).CodeLine
            IF sLine > 0 THEN
              DO WHILE hlStart > 1
                IF statusMsg(hlStart - 1).CodeLine = sLine THEN
                  IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
                  hlStart = hlStart - 1
                ELSE
                  EXIT DO
                END IF
              LOOP
              DO WHILE hlEnd < statusMsgCount - 1
                IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
                  IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
                  hlEnd = hlEnd + 1
                ELSE
                  EXIT DO
                END IF
              LOOP
            ELSE
              copyGroupID = statusMsg(hlStart).GroupID
              DO WHILE hlStart > 1
                IF statusMsg(hlStart - 1).GroupID = copyGroupID THEN
                  hlStart = hlStart - 1
                ELSE
                  EXIT DO
                END IF
              LOOP
              DO WHILE hlEnd < statusMsgCount - 1
                IF statusMsg(hlEnd + 1).GroupID = copyGroupID THEN
                  hlEnd = hlEnd + 1
                ELSE
                  EXIT DO
                END IF
              LOOP
            END IF
          END IF

          copyText$ = ""
          FOR ii = hlStart TO hlEnd
            copyText$ = copyText$ + LTRIM$(RTRIM$(statusMsg(ii).Text))
            IF ii < hlEnd THEN copyText$ = copyText$ + " "
          NEXT
          IF copyText$ <> "" THEN _CLIPBOARD$ = copyText$

          editor.MenuMode = 0
        END IF

        IF mouseClickedInBox(funcListBoxX, funcListBoxY + 3 + (2 * listRowH), funcListBoxW, listRowH, 0) THEN
          rowY = funcListBoxY + 3 + (2 * listRowH)
          LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - 2, rowY + listRowH - 1), 1, BF
          PrintStr funcListBoxX + editor.FuncMenuPadding, rowY + 1, "CANCEL", 15, 0, 1
          dispScreenFlushUpdate
          waitTimer UI_FLASH_TIME

          editor.MenuMode = 0
        END IF

        IF mouseWithinBoxBounds(funcListBoxX, funcListBoxY, funcListBoxW, funcListBoxH) = 0 AND mouseWithinBoxBounds(tab1X, tabY, editor.SideWidth, tabH) = 0 THEN
          editor.MenuMode = 0
        END IF
      END IF

      IF wasMenuMode1 = 0 AND wasMenuMode2 = 0 THEN
        IF editor.MenuMode = 0 THEN
          IF mouseClickedInBox(funcListBoxX, funcListBoxY, funcListBoxW - editor.ScrollbarWidth, funcListBoxH, 0) THEN
            clickRelY = mouse.PosY - (funcListBoxY + 3)
            IF clickRelY < 0 THEN clickRelY = 0
            clickedRow = clickRelY \ listRowH
            IF clickedRow > 0 AND clickedRow <= maxLines THEN
              listIdx = (clickedRow - 1) + editor.FuncScroll.ScrollY
              IF listIdx < listCount THEN
                rowTextX = funcListBoxX + editor.FuncTextPadding
                rowNameColumns = nameColumns
                IF funcArrowRight = 1 AND uiFuncList(listIdx).RoutineIndex > 0 THEN
                  rowTextX = rowTextX + FONT_WIDTH
                  rowNameColumns = rowNameColumns - 1
                END IF
                sOutName$ = LEFT$(uiFuncList(listIdx).RecordName, rowNameColumns)
                jumpLine = uiFuncList(listIdx).LineNumber

                rowY = funcListBoxY + 3 + (clickedRow * listRowH)
                LINE (funcListBoxX + 1, rowY)-(funcListBoxX + funcListBoxW - editor.ScrollbarWidth - 1, rowY + listRowH - 1), 1, BF
                PrintStr rowTextX, rowY + 1, sOutName$, 15, 0, 1
                funcListFlashRow = listIdx + 1
                funcListFlashTimeGoal = TIMER + UI_FLASH_TIME

                editor.CursorY = jumpLine
                editor.CursorX = 0
                IF listIdx = 0 THEN
                  editor.ScrollY = 1
                  editor.Focus = 1
                ELSE
                  editor.Focus = 1
                  visibleRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
                  editor.ScrollY = editor.CursorY - (visibleRows \ 2)
                  IF editor.ScrollY < 1 THEN editor.ScrollY = 1
                END IF
                editor.ScrollX = 0
                editor.SelectStartX = 0
                editor.SelectStartY = 1
                editor.IsSelecting = 0
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF
  END IF

END SUB ' drawFuncListPMI

''''''''''''''''''''''''
SUB drawStatusPMI

  EDITOR_BOX_X_NEW = editor.EditorDivider
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = editor.editorTextX
  editorTextW = editor.EditorTextWidth

  rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  textH = textRows * rowH
  editorBoxH = textH + 3

  statusBoxX = editor.StatusLeft
  statusBoxY = editorBoxY + editorBoxH + STATUS_TOP_GAP + (editor.StatusBarState * 3 * (rowH - STATUS_ROW_HEIGHT))
  statusBoxW = editor.StatusWidth
  statusBoxH = (3 + (editor.StatusBarState * 3)) * STATUS_ROW_HEIGHT + 5

  scrollBarX = statusBoxX + statusBoxW - 1
  scrollBarY = statusBoxY
  scrollBarW = editor.ScrollbarWidth
  scrollBarH = statusBoxH

  IF editor.Focus = 2 THEN
    sFocusX = statusBoxX - 1
    sFocusY = statusBoxY - 1
    sFocusW = (scrollBarX + scrollBarW + 1) - sFocusX
    sFocusH = statusBoxH + 2
    drawClearBox sFocusX, sFocusY, sFocusW, sFocusH, sysColor.focusBorder
  END IF

  drawBorderBox statusBoxX, statusBoxY, statusBoxW, statusBoxH, 15, 0

  ledgeButtonX = statusBoxX
  ledgeButtonY = editorBoxY + textH
  ledgeButtonW = editor.EditorLeft - ledgeButtonX
  ledgeButtonH = editor.HScrollHeight
  ledgeArrow = 24
  IF editor.StatusBarState = 1 THEN
    ledgeArrow = 25
  END IF

  drawBorderBox ledgeButtonX, ledgeButtonY, ledgeButtonW, ledgeButtonH, 15, 0
  PrintChr ledgeButtonX + (ledgeButtonW - FONT_WIDTH) \ 2, ledgeButtonY + 1, CHR$(ledgeArrow), 15, 0, 1

  maxLines = (statusBoxH - 5) \ STATUS_ROW_HEIGHT
  maxStatusScroll = 1
  IF statusMsgCount > maxLines THEN maxStatusScroll = statusMsgCount - maxLines
  IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
  IF editor.StatusScrollY > maxStatusScroll THEN editor.StatusScrollY = maxStatusScroll

  processVScrollbar SCROLL_STATUS, scrollBarX, scrollBarY, scrollBarW, scrollBarH, (statusMsgCount - 1), maxLines, 1

  hlStart = editor.StatusSelectedIndex
  hlEnd = editor.StatusSelectedIndex
  IF hlStart > 0 THEN
    sLine = statusMsg(hlStart).CodeLine
    IF sLine > 0 THEN
      DO WHILE hlStart > 1
        IF statusMsg(hlStart - 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
          hlStart = hlStart - 1
        ELSE
          EXIT DO
        END IF
      LOOP
      DO WHILE hlEnd < statusMsgCount - 1
        IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
          hlEnd = hlEnd + 1
        ELSE
          EXIT DO
        END IF
      LOOP
    END IF
  END IF

  lineY = statusBoxY + 3 + TEXT_GAP_TOP
  linesDrawn = 0
  FOR ii = editor.StatusScrollY TO statusMsgCount - 1
    IF linesDrawn >= maxLines THEN EXIT FOR

    isHighlighted = 0
    IF (editor.Focus = 2 OR editor.MenuMode = 2) AND editor.StatusSelectedIndex > 0 THEN
      IF ii >= hlStart AND ii <= hlEnd THEN isHighlighted = 1
    END IF

    displayText$ = statusMsg(ii).Text
    displayText$ = LEFT$(displayText$, editor.StatusColumns)

    IF isHighlighted = 1 THEN
      LINE (statusBoxX + 1, lineY - TEXT_GAP_TOP)-(scrollBarX - 1, lineY + STATUS_ROW_HEIGHT - TEXT_GAP_TOP - 1), 1, BF
      PrintStr statusBoxX + editor.StatusTextPadding, lineY, displayText$, 15, 0, 1
    ELSE
      PrintStr statusBoxX + editor.StatusTextPadding, lineY, displayText$, 14, 0, 1
    END IF

    lineY = lineY + STATUS_ROW_HEIGHT
    linesDrawn = linesDrawn + 1
  NEXT

  IF mouse.Wheel <> 0 THEN
    IF mouseWithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW - 1, statusBoxH) THEN
      editor.Focus = 2
      editor.StatusScrollY = editor.StatusScrollY + mouse.Wheel
      IF (statusMsgCount - 1) > maxLines THEN
        IF editor.StatusScrollY > statusMsgCount - maxLines THEN editor.StatusScrollY = statusMsgCount - maxLines
      ELSE
        editor.StatusScrollY = 1
      END IF
      IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
    END IF
  END IF

  IF mouse.Clicked1 THEN
    IF mouseWithinBoxBounds(statusBoxX, statusBoxY, statusBoxW + scrollBarW - 1, statusBoxH) THEN
      editor.Focus = 2
    END IF
  END IF

  IF mouse.Released1 THEN
    IF mouseClickedInBox(statusBoxX + 1, statusBoxY + 3, statusBoxW - 2, maxLines * STATUS_ROW_HEIGHT,0) THEN
      clickRelY = mouse.PosY - (statusBoxY + 3)
      IF clickRelY < 0 THEN clickRelY = 0
      clickedRow = clickRelY \ STATUS_ROW_HEIGHT
      IF clickedRow >= 0 AND clickedRow < maxLines THEN
        msgIdx = editor.StatusScrollY + clickedRow
        IF msgIdx > 0 AND msgIdx < statusMsgCount THEN
          editor.StatusSelectedIndex = msgIdx

          errLine = statusMsg(msgIdx).CodeLine
          IF errLine > 0 THEN
            editor.CursorY = errLine
            editor.CursorX = 0
            editor.ScrollY = errLine - (textRows \ 2)
            IF editor.ScrollY < 1 THEN editor.ScrollY = 1
            editor.ScrollX = 0
            editor.SelectStartX = 0
            editor.SelectStartY = errLine
            editor.IsSelecting = 0
            editor.Focus = 1
          END IF
        ELSE
          editor.StatusSelectedIndex = 0
        END IF
      ELSE
        editor.StatusSelectedIndex = 0
      END IF
    END IF
  END IF

  IF mouse.Released2 THEN
    IF mouseWithinBoxBounds(statusBoxX + 1, statusBoxY + 3, statusBoxW - 2, maxLines * STATUS_ROW_HEIGHT) THEN
      IF mouseDown2WithinBoxBounds(statusBoxX + 1, statusBoxY + 3, statusBoxW - 2, maxLines * STATUS_ROW_HEIGHT) THEN
        clickRelY = mouse.PosY - (statusBoxY + 3)
        IF clickRelY < 0 THEN clickRelY = 0
        clickedRow = clickRelY \ STATUS_ROW_HEIGHT
        IF clickedRow >= 0 AND clickedRow < maxLines THEN
          msgIdx = editor.StatusScrollY + clickedRow
          IF msgIdx > 0 AND msgIdx < statusMsgCount THEN
            editor.StatusSelectedIndex = msgIdx
            editor.Focus = 2
            editor.MenuMode = 2
          END IF
        END IF
      END IF
    END IF
  END IF

END SUB ' drawStatusPMI

''''''''''''''''''''''''
SUB drawTopMenuAndScrollPMI

  DIM dropdownY

  EDITOR_BOX_X_NEW = editor.EditorDivider
  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  editorTextX = editor.editorTextX
  editorTextW = editor.EditorTextWidth

  rowH = editor.FontHeight + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = EDITOR_TEXT_ROWS - (editor.StatusBarState * 3)
  textH = textRows * rowH
  editorBoxH = textH + 3

  editorScrollBarX = editor.EditorScrollX
  editorScrollBarY = editorBoxTop
  editorScrollBarW = editor.ScrollbarWidth
  editorScrollBarH = textH + 4

  hScrollY = editorBoxY + textH

  fileMenuX = 4
  editMenuX = fileMenuX + editor.MenuStep
  toolMenuX = editMenuX + editor.MenuStep

  dropdownY = 15

  LINE (0, 0)-(SCREENSIZEX - 1, 14), editor.windowBarClr, BF
  LINE (0, 15)-(SCREENSIZEX - 1, 15), 0

  activeName$ = fileNameBase$ + fileNameCustomExt$
  IF uiSubCount > 0 THEN
    FOR ii = 0 TO uiSubCount - 1
      startLine = uiSubLine(ii)
      endLine = editor.LastLine
      IF ii + 1 < uiSubCount THEN
        endLine = uiSubLine(ii + 1) - 1
      END IF

      IF editor.CursorY >= startLine AND editor.CursorY <= endLine THEN
        activeName$ = uiSubName$(ii)
        EXIT FOR
      END IF
    NEXT
  END IF

  IF activeName$ <> "" THEN
    nameLeft = toolMenuX + editor.MenuItemWidth + editor.TextPadding
    nameRight = SCREENSIZEX - editor.WindowMenuHitWidth - editor.TextPadding
    nameColumns = (nameRight - nameLeft) \ FONT_WIDTH
    activeName$ = LEFT$(activeName$, nameColumns)

    namePixelWidth = LEN(activeName$) * FONT_WIDTH
    nameCenterX = (SCREENSIZEX \ 2) - (namePixelWidth \ 2)
    IF nameCenterX < nameLeft THEN nameCenterX = nameLeft
    IF nameCenterX + namePixelWidth > nameRight THEN nameCenterX = nameRight - namePixelWidth
    PrintStr nameCenterX, 3, activeName$, 15, 0, 1
  END IF

  DIM fileMenu$(3)
  fileMenu$(0) = "OPEN"
  fileMenu$(1) = "SAVE AS"
  fileMenu$(2) = "NEW"
  fileMenu$(3) = "IMPORT"

  IF editor.TopMenuFocus = MENU_FILE THEN
    drawClearBox fileMenuX - 1, 1, editor.MenuItemWidth + 3, FONT_HEIGHT + 4, 9
    PrintStr fileMenuX + 2, 3, "FILE", 15, 0, 1

    ff = processDropdownMenu(fileMenuX - 1, dropdownY, 4, fileMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
    END IF

    curExt$ = fileNameCustomExt$

    fnBoxX = editor.FileNameBoxX - 1
    fnBoxY = dropdownY
    displayName$ = fileNameBase$ + curExt$
    nameColumns = (SCREENSIZEX - fnBoxX - (2 * editor.TextPadding) - 1) \ FONT_WIDTH
    displayName$ = LEFT$(displayName$, nameColumns)
    fnBoxW = 17 + (LEN(displayName$) * FONT_WIDTH)
    fnBoxH = 17

    LINE (fnBoxX, fnBoxY + 1)-(fnBoxX + fnBoxW - 2, fnBoxY + fnBoxH - 2), editor.windowBarClr, BF
    LINE (fnBoxX, fnBoxY)-(fnBoxX + fnBoxW - 1, fnBoxY), 15
    LINE (fnBoxX + fnBoxW - 1, fnBoxY)-(fnBoxX + fnBoxW - 1, fnBoxY + fnBoxH - 1), 15
    LINE (fnBoxX, fnBoxY + fnBoxH - 1)-(fnBoxX + fnBoxW - 1, fnBoxY + fnBoxH - 1), 15

    PrintStr fnBoxX + editor.FileNameTextPadding, fnBoxY + 5, displayName$, 11, 0, 1

    IF ff = 1 THEN
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0
        modalFileMenuOpen
      END IF
      IF clickedIdx = 1 THEN
        editor.TopMenuFocus = 0
        modalFileMenuSave
      END IF
      IF clickedIdx = 2 THEN
        editor.TopMenuFocus = 0
        modalFileMenuNew
      END IF
      IF clickedIdx = 3 THEN
        editor.TopMenuFocus = 0
        modalImportFile
      END IF
    END IF
  ELSE
    PrintStr fileMenuX + 2, 3, "FILE", 15, 0, 1
  END IF

  DIM editMenu$(1)
  IF undoState.Ready = 1 THEN
    editMenu$(0) = "UNDO"
  ELSE
    editMenu$(0) = "~UNDO"
  END IF
  editMenu$(1) = "SEARCH"

  IF editor.TopMenuFocus = MENU_EDIT THEN
    drawClearBox editMenuX - 1, 1, editor.MenuItemWidth + 3, FONT_HEIGHT + 4, 9
    PrintStr editMenuX + 2, 3, "EDIT", 15, 0, 1

    ff = processDropdownMenu(editMenuX - 1, dropdownY, 2, editMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0
        undo_StateRestore
      END IF
      IF clickedIdx = 1 THEN
        editor.TopMenuFocus = 0
        modalSearch
      END IF
    END IF
  ELSE
    PrintStr editMenuX + 2, 3, "EDIT", 15, 0, 1
  END IF

  hasCode = 0
  IF editor.LastLine > 1 THEN
    hasCode = 1
  ELSE
    IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
  END IF

  DIM toolMenu$(3)
  IF hasCode = 1 AND compileState = COMP_IDLE THEN
    toolMenu$(0) = "COMPILE"
  ELSE
    toolMenu$(0) = "~COMPILE"
  END IF

  IF uiFuncListCount > 0 THEN
    toolMenu$(1) = "VIEW SUBS"
  ELSE
    toolMenu$(1) = "~VIEW SUBS"
  END IF
  toolMenu$(2) = "GO TO LINE"
  toolMenu$(3) = "COLORS"

  IF editor.TopMenuFocus = MENU_TOOL THEN
    drawClearBox toolMenuX - 1, 1, editor.MenuItemWidth + 3, FONT_HEIGHT + 4, 9
    PrintStr toolMenuX + 2, 3, "TOOL", 15, 0, 1

    ff = processDropdownMenu(toolMenuX - 1, dropdownY, 4, toolMenu$())
    IF ff = 1 THEN
      clickedIdx = returnedData2
      IF clickedIdx = 0 THEN
        editor.TopMenuFocus = 0

        IF compileState = COMP_IDLE AND hasCode = 1 THEN
          compileState = COMP_REFINE
        END IF
      END IF
      IF clickedIdx = 1 THEN
        editor.TopMenuFocus = 0
        modalViewSubs
      END IF
      IF clickedIdx = 2 THEN
        editor.TopMenuFocus = 0
        modalGoToLine
      END IF
      IF clickedIdx = 3 THEN
        editor.TopMenuFocus = 0
        modalColor
      END IF
    END IF
  ELSE
    PrintStr toolMenuX + 2, 3, "TOOL", 15, 0, 1
  END IF

  LastLine = editor.LastLine
  IF editor.CursorY > LastLine THEN LastLine = editor.CursorY

  processVScrollbar SCROLL_MAIN, editorScrollBarX, editorScrollBarY, editorScrollBarW, editorScrollBarH, LastLine, textRows, 1

  drawBorderBox editorScrollBarX, hScrollY, editorScrollBarW, editor.HScrollHeight, 15, 0

  IF mouse.Clicked1 THEN
    IF mouseWithinBoxBounds(editorScrollBarX, editorScrollBarY, editorScrollBarW, editorScrollBarH) THEN
      editor.Focus = 1
    END IF

    IF mouseWithinBoxBounds(editorScrollBarX, hScrollY, editorScrollBarW, editor.HScrollHeight) THEN
      editor.Focus = 1
      IF editor.CornerClickActive = 1 AND (TIMER - editor.CornerLastClickTime) < 0.25 THEN
        LastLine = editor.LastLine
        IF editor.CursorY > LastLine THEN LastLine = editor.CursorY

        maxScroll = LastLine - textRows + 1
        IF maxScroll < 1 THEN maxScroll = 1

        editor.ScrollY = maxScroll
        editor.CursorY = LastLine
        editor.CursorX = 0
        editor.CornerClickActive = 0
      ELSE
        editor.CornerLastClickTime = TIMER
        editor.CornerClickActive = 1
      END IF
    END IF
  END IF

  IF mouse.Released1 THEN
    IF mouseClickedInBox(editor.MenuFileClickX, 0, editor.MenuFileClickWidth, 15,0) THEN
      IF editor.TopMenuFocus = MENU_FILE THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_FILE
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF

    IF mouseClickedInBox(editMenuX, 0, editor.MenuOtherClickWidth, 15,0) THEN
      IF editor.TopMenuFocus = MENU_EDIT THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_EDIT
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF

    IF mouseClickedInBox(toolMenuX, 0, editor.MenuOtherClickWidth, 15,0) THEN
      IF editor.TopMenuFocus = MENU_TOOL THEN
        editor.TopMenuFocus = 0
      ELSE
        editor.TopMenuFocus = MENU_TOOL
        editor.Focus = 0
      END IF
      editor.MenuClicked = 1
    END IF
  END IF

END SUB ' drawTopMenuAndScrollPMI

''''''''''''''''''''''''
FUNCTION editDirectoryPath (wTextX, wTextY, wColumns, editText$, editCursor, editScroll, editSelectAll, editInvalid)

  entryAction = 0
  entryKey = _KEYHIT
  ctrlHeld = _KEYDOWN(100305) OR _KEYDOWN(100306)
  insertText$ = ""

  IF ctrlHeld AND (entryKey = 65 OR entryKey = 97) THEN entryKey = 1
  IF ctrlHeld AND (entryKey = 86 OR entryKey = 118) THEN entryKey = 22
  IF entryKey = 20992 AND (_KEYDOWN(100303) OR _KEYDOWN(100304)) THEN entryKey = 22

  SELECT CASE entryKey
    CASE 1
      editSelectAll = 1
      editCursor = LEN(editText$)

    CASE 22
      pasteText$ = _CLIPBOARD$
      FOR ii = 1 TO LEN(pasteText$)
        pasteChar = ASC(pasteText$, ii)
        IF pasteChar = 10 OR pasteChar = 13 THEN EXIT FOR
        IF pasteChar >= 32 AND pasteChar <= 126 THEN insertText$ = insertText$ + CHR$(pasteChar)
      NEXT

    CASE 27
      entryAction = 2
      waitKeyRelease "ESC"
      _KEYCLEAR

    CASE 13
      directoryValue$ = LTRIM$(RTRIM$(editText$))
      IF LEN(directoryValue$) >= 2 THEN
        IF LEFT$(directoryValue$, 1) = CHR$(34) AND RIGHT$(directoryValue$, 1) = CHR$(34) THEN
          directoryValue$ = MID$(directoryValue$, 2, LEN(directoryValue$) - 2)
        END IF
      END IF

      editInvalid = 1
      IF directoryValue$ <> "" THEN
        IF _DIREXISTS(directoryValue$) THEN
          CHDIR directoryValue$
          editInvalid = 0
          entryAction = 1
          _KEYCLEAR
        END IF
      END IF

    CASE 8, 212231, 21248
      IF editSelectAll = 1 THEN
        editText$ = ""
        editCursor = 0
        editScroll = 0
        editSelectAll = 0
      ELSE
        IF entryKey = 8 THEN
          IF editCursor > 0 THEN
            editText$ = LEFT$(editText$, editCursor - 1) + MID$(editText$, editCursor + 1)
            editCursor = editCursor - 1
          END IF
        ELSE
          IF editCursor < LEN(editText$) THEN
            editText$ = LEFT$(editText$, editCursor) + MID$(editText$, editCursor + 2)
          END IF
        END IF
      END IF
      editInvalid = 0

    CASE 19200
      IF editSelectAll = 1 THEN
        editCursor = 0
      ELSE
        IF editCursor > 0 THEN editCursor = editCursor - 1
      END IF
      editSelectAll = 0

    CASE 19712
      IF editSelectAll = 1 THEN
        editCursor = LEN(editText$)
      ELSE
        IF editCursor < LEN(editText$) THEN editCursor = editCursor + 1
      END IF
      editSelectAll = 0

    CASE 18176
      editCursor = 0
      editSelectAll = 0

    CASE 20224
      editCursor = LEN(editText$)
      editSelectAll = 0

    CASE ELSE
      IF entryKey >= 32 AND entryKey <= 126 AND ctrlHeld = 0 THEN insertText$ = CHR$(entryKey)
  END SELECT

  IF insertText$ <> "" THEN
    IF editSelectAll = 1 THEN
      editText$ = ""
      editCursor = 0
      editScroll = 0
      editSelectAll = 0
    END IF
    editText$ = LEFT$(editText$, editCursor) + insertText$ + MID$(editText$, editCursor + 1)
    editCursor = editCursor + LEN(insertText$)
    editInvalid = 0
  END IF

  IF entryAction = 0 THEN
    visibleChars = wColumns - 1
    maxPathScroll = LEN(editText$) - visibleChars
    IF maxPathScroll < 0 THEN maxPathScroll = 0
    IF editScroll < 0 THEN editScroll = 0
    IF editScroll > maxPathScroll THEN editScroll = maxPathScroll
    IF editCursor < editScroll THEN editScroll = editCursor
    IF editCursor > editScroll + visibleChars THEN editScroll = editCursor - visibleChars

    pathDisplay$ = MID$(editText$, editScroll + 1, visibleChars)
    cursorColumn = editCursor - editScroll
    cursorText$ = "_"
    IF (INT(TIMER * 2) AND 1) = 1 THEN cursorText$ = "*"
    pathDisplay$ = LEFT$(pathDisplay$, cursorColumn) + cursorText$ + MID$(pathDisplay$, cursorColumn + 1)

    IF editSelectAll = 1 THEN
      drawClearBox wTextX, wTextY, LEN(pathDisplay$) * FONT_WIDTH, FONT_HEIGHT, 9
    END IF
    PrintStr wTextX, wTextY, pathDisplay$, 15, 0, 1
  END IF

  editDirectoryPath = entryAction

END FUNCTION ' editDirectoryPath

''''''''''''''''''''''''
FUNCTION editRGBEntry (wBoxX, wBoxY, wBoxW, wBoxH, entryText$, rsIsActive, rsKeyVal, editCursor, editSelectAll, repeatButton, repeatTimeGoal AS DOUBLE, repeatLastTime AS DOUBLE)

  ' Handles typing and held arrow buttons for one RGB component

  DIM currentTime AS DOUBLE

  beforeText$ = entryText$
  changed = 0

  IF entryText$ <> "" THEN
    IF VAL(entryText$) > 255 THEN entryText$ = "255"
  END IF

  IF rsIsActive = 0 THEN
    IF entryText$ = "" THEN entryText$ = "0"
    IF entryText$ <> beforeText$ THEN changed = 1
    editRGBEntry = changed
    EXIT FUNCTION
  END IF

  arrowW = FONT_WIDTH + editor.TextPadding
  rightArrowX = wBoxX + wBoxW - arrowW
  currentTime = TIMER
  IF currentTime < repeatLastTime AND repeatButton > 0 THEN repeatTimeGoal = repeatTimeGoal - 86400
  repeatLastTime = currentTime
  stepButton = 0

  IF mouse.Clicked1 THEN
    repeatButton = 0
    IF mouseDownWithinBoxBounds(wBoxX, wBoxY, arrowW, wBoxH) AND mouseWithinBoxBounds(wBoxX, wBoxY, arrowW, wBoxH) THEN repeatButton = 1
    IF mouseDownWithinBoxBounds(rightArrowX, wBoxY, arrowW, wBoxH) AND mouseWithinBoxBounds(rightArrowX, wBoxY, arrowW, wBoxH) THEN repeatButton = 2
    IF repeatButton > 0 THEN
      stepButton = repeatButton
      repeatTimeGoal = currentTime + 0.3
    END IF
  END IF

  IF mouse.Button1Down THEN
    IF repeatButton > 0 AND mouse.Clicked1 = 0 THEN
      arrowX = wBoxX
      IF repeatButton = 2 THEN arrowX = rightArrowX
      IF mouseDownWithinBoxBounds(arrowX, wBoxY, arrowW, wBoxH) AND mouseWithinBoxBounds(arrowX, wBoxY, arrowW, wBoxH) THEN
        IF currentTime >= repeatTimeGoal THEN
          stepButton = repeatButton
          repeatTimeGoal = currentTime + 0.04
        END IF
      ELSE
        repeatTimeGoal = currentTime + 0.08
      END IF
    END IF
  ELSE
    repeatButton = 0
  END IF

  IF editCursor > LEN(entryText$) THEN editCursor = LEN(entryText$)
  keyVal = rsKeyVal
  ctrlHeld = _KEYDOWN(100305) OR _KEYDOWN(100306)
  IF ctrlHeld AND (keyVal = 65 OR keyVal = 97) THEN keyVal = 1
  IF ctrlHeld AND (keyVal = 86 OR keyVal = 118) THEN keyVal = 22
  IF keyVal = 20992 AND (_KEYDOWN(100303) OR _KEYDOWN(100304)) THEN keyVal = 22
  insertText$ = ""

  SELECT CASE keyVal
    CASE 1
      editSelectAll = 1
      editCursor = LEN(entryText$)

    CASE 22
      pasteText$ = LTRIM$(RTRIM$(_CLIPBOARD$))
      pasteValid = 1
      IF LEN(pasteText$) = 0 OR LEN(pasteText$) > 3 THEN pasteValid = 0
      FOR ii = 1 TO LEN(pasteText$)
        pasteChar = ASC(pasteText$, ii)
        IF pasteChar < 48 OR pasteChar > 57 THEN pasteValid = 0
      NEXT
      IF pasteValid = 1 THEN insertText$ = pasteText$

    CASE 8, 212231, 21248
      IF editSelectAll = 1 THEN
        entryText$ = ""
        editCursor = 0
        editSelectAll = 0
      ELSE
        IF keyVal = 8 THEN
          IF editCursor > 0 THEN
            entryText$ = LEFT$(entryText$, editCursor - 1) + MID$(entryText$, editCursor + 1)
            editCursor = editCursor - 1
          END IF
        ELSE
          IF editCursor < LEN(entryText$) THEN entryText$ = LEFT$(entryText$, editCursor) + MID$(entryText$, editCursor + 2)
        END IF
      END IF

    CASE 19200
      IF editSelectAll = 1 THEN
        editCursor = 0
      ELSE
        IF editCursor > 0 THEN editCursor = editCursor - 1
      END IF
      editSelectAll = 0

    CASE 19712
      IF editSelectAll = 1 THEN
        editCursor = LEN(entryText$)
      ELSE
        IF editCursor < LEN(entryText$) THEN editCursor = editCursor + 1
      END IF
      editSelectAll = 0

    CASE 18176
      editCursor = 0
      editSelectAll = 0

    CASE 20224
      editCursor = LEN(entryText$)
      editSelectAll = 0

    CASE ELSE
      IF keyVal >= 48 AND keyVal <= 57 AND ctrlHeld = 0 THEN insertText$ = CHR$(keyVal)
  END SELECT

  IF insertText$ <> "" THEN
    proposedText$ = entryText$
    proposedCursor = editCursor
    IF editSelectAll = 1 THEN
      proposedText$ = ""
      proposedCursor = 0
    END IF
    IF LEN(proposedText$) + LEN(insertText$) <= 3 THEN
      entryText$ = LEFT$(proposedText$, proposedCursor) + insertText$ + MID$(proposedText$, proposedCursor + 1)
      editCursor = proposedCursor + LEN(insertText$)
      editSelectAll = 0
    END IF
  END IF

  IF entryText$ <> "" THEN
    IF VAL(entryText$) > 255 THEN
      entryText$ = "255"
      editCursor = LEN(entryText$)
    END IF
  END IF

  IF stepButton > 0 THEN
    entryValue = VAL(entryText$)
    IF entryValue > 255 THEN entryValue = 255
    IF entryValue < 0 THEN entryValue = 0

    SELECT CASE stepButton
      CASE 1
        IF entryValue > 0 THEN entryValue = entryValue - 1
      CASE 2
        IF entryValue < 255 THEN entryValue = entryValue + 1
    END SELECT

    entryText$ = LTRIM$(STR$(entryValue))
    editCursor = LEN(entryText$)
    editSelectAll = 0
  END IF

  IF editCursor > LEN(entryText$) THEN editCursor = LEN(entryText$)
  IF entryText$ <> beforeText$ THEN changed = 1
  editRGBEntry = changed

END FUNCTION ' editRGBEntry

''''''''''''''''''''''''
FUNCTION hexLen$ (wVal, wLen)

  outStr$ = HEX$(wVal)
  FOR ii = 0 TO 2
    IF LEN(outStr$) < wLen THEN
      outStr$ = "0" + outStr$
    END IF
  NEXT

  hexLen$ = outStr$

END FUNCTION ' hexLen$

