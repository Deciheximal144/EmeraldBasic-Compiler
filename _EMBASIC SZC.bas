''''''''''''''''''''''''
SUB tiraNew (opConst AS LONG, argsStr$)

  tiraCheckActive ("tiraNew")

  IF t.LineCount >= MAX_TIRA_LINES THEN
    throwCompilerError "TIRA QUEUE OVERFLOW", ASIS, 0
    EXIT SUB
  END IF

  IF opConst = TC_INVALID OR opConst >= TC_OUTOFRANGE THEN
    throwCompilerError "INVALID TC_", ASIS, 0
    EXIT SUB
  END IF

  ' If we are compiling runtimes, but the safe wrapper is OFF, block manual ABI commands
  IF isCompilingRT = 1 AND rtWrapperActive = 0 THEN
    IF opConst = TC_ABI_PROLOGUE OR opConst = TC_ABI_EPILOGUE OR opConst = TC_ABI_READ_ARG OR opConst = TC_ABI_WRITE_RET THEN
      throwCompilerError "MANUAL ABI COMMANDS NOT ALLOWED IN RUNTIMES, USE tiraRT_Prologue", ASIS, 0
      EXIT SUB
    END IF
  END IF

  tiraClearArgs

  tiraNode(t.LineCount).OpCode = opConst

  DIM aCount AS LONG
  DIM inQuotes AS LONG
  DIM aLen AS LONG
  DIM currArg$
  DIM ch$
  DIM args$(4)

  aCount = 0
  ix = 1
  aLen = LEN(argsStr$)
  currArg$ = ""
  inQuotes = 0

  DO WHILE ix <= aLen
    ch$ = MID$(argsStr$, ix, 1)

    IF ch$ = CHR$(34) THEN
      inQuotes = 1 - inQuotes
    END IF

    IF ch$ = "," AND inQuotes = 0 THEN
      IF aCount < 4 THEN args$(aCount) = LTRIM$(RTRIM$(currArg$))
      aCount = aCount + 1
      currArg$ = ""
    ELSE
      currArg$ = currArg$ + ch$
    END IF
    ix = ix + 1
  LOOP

  IF currArg$ <> "" THEN
    IF aCount < 4 THEN args$(aCount) = LTRIM$(RTRIM$(currArg$))
    aCount = aCount + 1
  END IF

  IF aCount > 0 THEN tiraSetNodeArg 1, args$(0)
  IF aCount > 1 THEN tiraSetNodeArg 2, args$(1)
  IF aCount > 2 THEN tiraSetNodeArg 3, args$(2)
  IF aCount > 3 THEN tiraSetNodeArg 4, args$(3)

  t.LineCount = t.LineCount + 1

END SUB ' tiraNew

''''''''''''''''''''''''
SUB tiraParseArgToNode (argStr$)

  DIM firstChar AS STRING * 1
  DIM isDoubleLit AS LONG
  DIM lastCh$
  DIM vIdx AS LONG
  DIM lit$
  DIM hexAscii AS LONG
  DIM hexCount AS LONG
  DIM hexDigit AS LONG
  DIM hexHighDigit AS LONG
  DIM hexLowValue AS _INTEGER64
  DIM hexPlaceValue AS _INTEGER64
  DIM hexStart AS LONG

  tiraParsedArgType = TIRA_ARG_EMPTY
  tiraParsedArgVal = 0

  IF argStr$ = "" THEN EXIT SUB

  firstChar = LEFT$(argStr$, 1)

  IF firstChar = "@" OR firstChar = "%" THEN
    ff = resolveSymbol(argStr$)
    IF ff = 1 THEN
      tiraParsedArgType = TIRA_ARG_LABEL
      tiraParsedArgVal = returnedData2
    END IF
  ELSE
    IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR firstChar = CHR$(34) OR (firstChar = "&" AND (UCASE$(MID$(argStr$, 2, 1)) = "H" OR UCASE$(MID$(argStr$, 2, 1)) = "O")) THEN
      IF firstChar = CHR$(34) THEN
        lit$ = extractQuotes$(argStr$)
        ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
        t.TiraVarCounter = t.TiraVarCounter + 1

        IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
          throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
          EXIT SUB
        END IF

        IF ff = 1 THEN
          vIdx = returnedData2
          strVarData$(vIdx) = lit$
          tiraParsedArgType = TIRA_ARG_SYMBOL
          tiraParsedArgVal = vIdx
        END IF
      ELSE
        lastCh$ = RIGHT$(argStr$, 1)
        IF INSTR(argStr$, ".") > 0 OR lastCh$ = "#" OR lastCh$ = "!" THEN
          isDoubleLit = 0
          IF lastCh$ = "#" THEN isDoubleLit = 1

          ff = resolveSymbol("!C_PRS_VAL_FLT_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
          t.TiraVarCounter = t.TiraVarCounter + 1

          IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
            throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
            EXIT SUB
          END IF

          IF ff = 1 THEN
            vIdx = returnedData2
            IF isDoubleLit = 1 THEN
              symbols(vIdx).DataType = TYPE_DOUBLE
            ELSE
              symbols(vIdx).DataType = TYPE_SINGLE
            END IF
            floatVarData(vIdx) = VAL(argStr$)
            tiraParsedArgType = TIRA_ARG_SYMBOL
            tiraParsedArgVal = vIdx
          END IF
        ELSE
          IF firstChar = "&" AND UCASE$(MID$(argStr$, 2, 1)) = "H" THEN
            hexStart = 3

            DO WHILE hexStart <= LEN(argStr$)
              IF MID$(argStr$, hexStart, 1) = "0" THEN
                hexStart = hexStart + 1
              ELSE
                EXIT DO
              END IF
            LOOP

            hexCount = LEN(argStr$) - hexStart + 1

            IF hexCount > 16 THEN
              throwCompilerError "HEX LITERAL OUT OF 64-BIT RANGE", ASIS, 0
              EXIT SUB
            END IF

            hexLowValue = 0
            hexHighDigit = 0

            FOR ii = hexStart TO LEN(argStr$)
              hexAscii = ASC(argStr$, ii)

              IF hexAscii >= 48 AND hexAscii <= 57 THEN
                hexDigit = hexAscii - 48
              ELSE
                IF hexAscii >= 65 AND hexAscii <= 70 THEN
                  hexDigit = hexAscii - 55
                ELSE
                  IF hexAscii >= 97 AND hexAscii <= 102 THEN
                    hexDigit = hexAscii - 87
                  ELSE
                    throwCompilerError "INVALID HEX LITERAL", ASIS, 0
                    EXIT SUB
                  END IF
                END IF
              END IF

              IF hexCount = 16 AND ii = hexStart THEN
                hexHighDigit = hexDigit
              ELSE
                hexLowValue = (hexLowValue * 16) + hexDigit
              END IF
            NEXT

            IF hexCount = 16 THEN
              hexPlaceValue = 1

              FOR ii = 1 TO 15
                hexPlaceValue = hexPlaceValue * 16
              NEXT

              IF hexHighDigit >= 8 THEN
                tiraParsedArgVal = ((hexHighDigit - 16) * hexPlaceValue) + hexLowValue
              ELSE
                tiraParsedArgVal = (hexHighDigit * hexPlaceValue) + hexLowValue
              END IF
            ELSE
              tiraParsedArgVal = hexLowValue
            END IF

            tiraParsedArgType = TIRA_ARG_LITERAL
          ELSE
            tiraParsedArgType = TIRA_ARG_LITERAL
            tiraParsedArgVal = VAL(argStr$)
          END IF
        END IF
      END IF
    ELSE

      SELECT CASE argStr$

        CASE "SINGLE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = 32
        CASE "DOUBLE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = 64
        CASE "JE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JE
        CASE "JNE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JNE
        CASE "JL"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JL
        CASE "JLE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JLE
        CASE "JG"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JG
        CASE "JGE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JGE
        CASE "JB"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JB
        CASE "JBE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JBE
        CASE "JA"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JA
        CASE "JAE"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JAE
        CASE "JO"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JO
        CASE "JNO"
          tiraParsedArgType = TIRA_ARG_STR_LITERAL
          tiraParsedArgVal = JCC_JNO

        CASE ELSE
          ' It is a symbol
          IF firstChar = "#" THEN
            tiraParsedArgType = TIRA_ARG_SYMBOL
            tiraParsedArgVal = VAL(MID$(argStr$, 2))
          ELSE
            ff = resolveSymbol(argStr$)
            IF ff = 1 THEN
              tiraParsedArgType = TIRA_ARG_SYMBOL
              tiraParsedArgVal = returnedData2
            END IF
          END IF

      END SELECT ' argStr$

    END IF
  END IF

END SUB ' tiraParseArgToNode

''''''''''''''''''''''''
FUNCTION tiraParseArrayArgs$ (startIdx, endBoundary, allowImplicit)

  returnExtraPrepare

  DIM closeParen AS LONG
  DIM tokParseIdx AS LONG
  DIM arrComma AS LONG
  DIM idxVar$
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  indicesStr$ = ""
  numParsedIndices = 0

  ff = findMatchingParen(startIdx, endBoundary)
  IF ff = 0 THEN
    throwCompilerErrorAndCancelTira "MISSING )", ASIS, 0
    return3 0
    return2 0
    tiraParseArrayArgs$ = ""
    EXIT FUNCTION
  END IF

  closeParen = returnedData2
  tokParseIdx = startIdx + 1

  DO
    arrComma = findComma(tokParseIdx, closeParen - 1)
    IF arrComma > 0 THEN
      idxVar$ = tiraParseExpressionInt$(tokParseIdx, arrComma - 1, allowImplicit, "INDEX MUST BE NUMERIC")
      tokParseIdx = arrComma + 1
    ELSE
      IF tokParseIdx <= closeParen - 1 THEN
        idxVar$ = tiraParseExpressionInt$(tokParseIdx, closeParen - 1, allowImplicit, "INDEX MUST BE NUMERIC")
      ELSE
        EXIT DO
      END IF
    END IF

    IF idxVar$ = "" THEN
      tiraParseArrayArgs$ = ""
      return3 0
      return2 0
      EXIT FUNCTION
    END IF

    numParsedIndices = numParsedIndices + 1
    IF indicesStr$ = "" THEN indicesStr$ = idxVar$ ELSE indicesStr$ = indicesStr$ + "," + idxVar$
    IF arrComma = 0 THEN EXIT DO
  LOOP

  return3 numParsedIndices
  return2 closeParen
  tiraParseArrayArgs$ = indicesStr$

END FUNCTION ' tiraParseArrayArgs$

''''''''''''''''''''''''
FUNCTION tiraParseArrayArgsId (startIdx, endBoundary, allowImplicit)

  returnExtraPrepare

  DIM closeParen AS LONG
  DIM tokParseIdx AS LONG
  DIM arrComma AS LONG
  DIM numParsedIndices AS LONG

  numParsedIndices = 0

  ff = findMatchingParen(startIdx, endBoundary)
  IF ff = 0 THEN
    throwCompilerErrorAndCancelTira "MISSING )", ASIS, 0
    return3 0
    return2 0
    tiraParseArrayArgsId = 0
    EXIT FUNCTION
  END IF

  closeParen = returnedData2
  tokParseIdx = startIdx + 1

  DO
    arrComma = findComma(tokParseIdx, closeParen - 1)
    IF arrComma > 0 THEN
      ff = tiraParseExpressionIntArgId(tokParseIdx, arrComma - 1, allowImplicit, "INDEX MUST BE NUMERIC")
      tokParseIdx = arrComma + 1
    ELSE
      IF tokParseIdx <= closeParen - 1 THEN
        ff = tiraParseExpressionIntArgId(tokParseIdx, closeParen - 1, allowImplicit, "INDEX MUST BE NUMERIC")
      ELSE
        EXIT DO
      END IF
    END IF

    IF ff = 0 THEN
      return3 0
      return2 0
      tiraParseArrayArgsId = 0
      EXIT FUNCTION
    END IF

    numParsedIndices = numParsedIndices + 1
    IF numParsedIndices > 255 THEN
      throwCompilerErrorAndCancelTira "ARRAY DIMENSION LIMIT EXCEEDED", ASIS, 0
      return3 0
      return2 0
      tiraParseArrayArgsId = 0
      EXIT FUNCTION
    END IF

    tiraParsedArrayArgType(numParsedIndices) = tiraParsedArgType
    tiraParsedArrayArgVal(numParsedIndices) = tiraParsedArgVal

    IF arrComma = 0 THEN EXIT DO
  LOOP

  return3 numParsedIndices
  return2 closeParen
  tiraParseArrayArgsId = 1

END FUNCTION ' tiraParseArrayArgsId

''''''''''''''''''''''''
FUNCTION tiraParseExpression$ (startIdx, endIdx, allowImplicit)

  tiraCheckActive ("tiraParseExpression$")

  DIM valTop AS LONG
  DIM opTop AS LONG
  DIM prState AS LONG
  DIM tVal AS LONG
  DIM tVal2 AS LONG
  DIM leafEnd AS LONG
  DIM foundParen AS LONG
  DIM opVal AS LONG
  DIM prec AS LONG
  DIM topOp AS LONG
  DIM topPrec AS LONG
  DIM popIt AS LONG
  DIM opFinalVal AS LONG
  DIM nxtVal AS LONG
  DIM isFuncOrArray AS LONG
  DIM closeParen AS LONG
  DIM fieldName$
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM funcOp AS LONG
  DIM leafVar$

  DIM isFound AS LONG
  DIM testName$
  DIM iSuffix AS LONG
  DIM tmpIdx AS LONG
  DIM tokIdx AS LONG
  DIM isUdtBase AS LONG

  DIM currTargetType AS LONG
  DIM currUdtIndex AS LONG
  DIM currUdtOffset AS LONG
  DIM currFieldSize AS LONG
  DIM currIsDynamic AS LONG
  DIM parseIdx AS LONG

  DIM searchNameGlobal$
  DIM routineSubIdx AS LONG
  DIM routineSymbolIdx AS LONG

  DIM conflictIdx AS LONG
  DIM suffix$
  DIM baseName$
  DIM existingName$
  DIM lastTwo$

  valTop = 0
  opTop = 0
  prState = 0 ' 0 = expect operand/unary/lparen, 1 = expect binary/rparen
  ix = startIdx

  DO WHILE ix <= endIdx
    IF t.IsActive = 0 THEN
      tiraParseExpression$ = ""
      EXIT FUNCTION
    END IF

    tVal = lineTokenVals(ix)

    IF prState = 0 THEN

      SELECT CASE tVal

        CASE TOK_OP_LPAREN
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_LPAREN
          opTop = opTop + 1
          ix = ix + 1

        CASE TOK_OP_RPAREN ' Empty parentheses handling for root array requests e.g., A()
          foundParen = 0
          DO WHILE opTop > 0
            opVal = shuntOp(opTop - 1).OpCode
            IF opVal = TOK_OP_LPAREN THEN
              foundParen = 1
              EXIT DO
            END IF
            opTop = opTop - 1
            ff = tiraScheduleShuntingOp(opVal, valTop)
            IF ff = 0 THEN
              tiraParseExpression$ = ""
              EXIT FUNCTION
            END IF
            valTop = returnedData2
          LOOP

          IF foundParen = 0 THEN
            throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF

          opTop = opTop - 1 ' Pop LPAREN

          IF opTop > 0 THEN
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = SHUNT_FUNC OR topOp = SHUNT_ARRAY THEN
              shuntOp(opTop - 1).ArgCount = 0
              opTop = opTop - 1
              ff = tiraScheduleFuncOrArray(opTop, valTop)
              IF ff = 0 THEN
                tiraParseExpression$ = ""
                EXIT FUNCTION
              END IF
              valTop = returnedData2

              IF topOp = SHUNT_ARRAY THEN
                IF shuntOp(opTop).HasField = 1 THEN
                  DO WHILE ix + 1 <= endIdx
                    IF lineTokenVals(ix + 1) = 256 + ASC(".") THEN
                      ix = ix + 2
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                END IF
              END IF
            END IF
          END IF
          ix = ix + 1
          prState = 1

        CASE TOK_OP_MINUS
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_UNARY_MINUS
          opTop = opTop + 1
          ix = ix + 1

        CASE TOK_NOT
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_UNARY_NOT
          opTop = opTop + 1
          ix = ix + 1

        CASE ELSE
          isFuncOrArray = 0
          IF tVal = 0 OR tVal = TOK_CINT OR tVal = TOK_CLNG OR tVal = TOK_CSNG OR tVal = TOK_CDBL THEN
            IF ix + 1 <= endIdx THEN
              IF lineTokenVals(ix + 1) = 256 + ASC("(") THEN
                isFuncOrArray = 1
              END IF
            END IF
          END IF

          IF isFuncOrArray = 1 THEN
            IF tVal = TOK_CINT OR tVal = TOK_CLNG OR tVal = TOK_CSNG OR tVal = TOK_CDBL THEN
              IF opTop > MAX_SHUNT THEN
                throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                tiraParseExpression$ = ""
                EXIT FUNCTION
              END IF
              shuntOp(opTop).OpCode = SHUNT_CAST

              SELECT CASE tVal

                CASE TOK_CINT: shuntOp(opTop).VIdx = TYPE_INTEGER
                CASE TOK_CLNG: shuntOp(opTop).VIdx = TYPE_LONG
                CASE TOK_CSNG: shuntOp(opTop).VIdx = TYPE_SINGLE
                CASE TOK_CDBL: shuntOp(opTop).VIdx = TYPE_DOUBLE

              END SELECT ' tVal

              shuntOp(opTop).ArgCount = 1
              opTop = opTop + 1
              ix = ix + 1
            ELSE
              vName$ = UCASE$(lineTokens$(ix))
              tokIdx = ix + 1

              ' Legacy dot variable check for arrays
              DO WHILE tokIdx <= endIdx
                IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
                  IF findSymbol(vName$) THEN
                    IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
                  END IF
                  IF cm.ClassicMode = 1 THEN
                    IF tokIdx + 1 <= endIdx THEN
                      vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
                      tokIdx = tokIdx + 2
                    ELSE
                      EXIT DO
                    END IF
                  ELSE
                    throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
                    addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
                    tiraParseExpression$ = ""
                    EXIT FUNCTION
                  END IF
                ELSE
                  EXIT DO
                END IF
              LOOP

              isFound = 0

              IF findSymbol(vName$) THEN
                VIdx = returnedData2
                vDataType = symbols(VIdx).DataType
                isFound = 1

                IF isFuncOrArray = 1 AND symbols(VIdx).IsArray = 0 AND symbols(VIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                  searchNameGlobal$ = vName$
                  IF findSubIndexCanonical(searchNameGlobal$) THEN
                    routineSubIdx = returnedData2
                    routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                    IF routineSymbolIdx > 0 THEN
                      routineSymbolIdx = routineSymbolIdx - 1

                      IF routineSymbolIdx < symbolCount THEN
                        VIdx = routineSymbolIdx
                        vDataType = symbols(VIdx).DataType
                      END IF
                    END IF
                  END IF
                END IF

              ELSE
                ' Fallback for string strictness mapping
                suffix$ = RIGHT$(vName$, 1)
                IF suffix$ = "$" THEN
                  baseName$ = LEFT$(vName$, LEN(vName$) - 1)
                  IF findSymbol(baseName$) THEN
                    conflictIdx = returnedData2
                    existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                    IF cm.ClassicMode = 1 THEN
                      IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                        VIdx = conflictIdx
                        vDataType = symbols(VIdx).DataType
                        isFound = 1
                      END IF
                    ELSE
                      IF cm.StringStrict = 0 THEN
                        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                          VIdx = conflictIdx
                          vDataType = symbols(VIdx).DataType
                          isFound = 1
                        ELSE
                          throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                          tiraParseExpression$ = ""
                          EXIT FUNCTION
                        END IF
                      ELSE
                        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                          throwCompilerError "VARIABLE NAME CONFLICT: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                        ELSE
                          throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                        END IF
                        tiraParseExpression$ = ""
                        EXIT FUNCTION
                      END IF
                    END IF
                  END IF
                ELSE
                  lastTwo$ = RIGHT$(vName$, 2)
                  IF lastTwo$ <> "~&" THEN
                    IF suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "!" AND suffix$ <> "#" AND suffix$ <> "~" THEN
                      IF findSymbol(vName$ + "$") THEN
                        conflictIdx = returnedData2
                        existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                        IF cm.ClassicMode = 1 THEN
                          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                            VIdx = conflictIdx
                            vDataType = symbols(VIdx).DataType
                            isFound = 1
                          END IF
                        ELSE
                          IF cm.StringStrict = 0 THEN
                            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                              VIdx = conflictIdx
                              vDataType = symbols(VIdx).DataType
                              isFound = 1
                            ELSE
                              throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                              tiraParseExpression$ = ""
                              EXIT FUNCTION
                            END IF
                          ELSE
                            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                              throwCompilerError "VARIABLE NAME CONFLICT: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                            ELSE
                              throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                            END IF
                            tiraParseExpression$ = ""
                            EXIT FUNCTION
                          END IF
                        END IF
                      END IF
                    END IF
                  END IF
                END IF

                IF isFound = 1 AND isFuncOrArray = 1 AND symbols(VIdx).IsArray = 0 AND symbols(VIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                  searchNameGlobal$ = RTRIM$(symbols(VIdx).RecordName)
                  IF findSubIndexCanonical(searchNameGlobal$) THEN
                    routineSubIdx = returnedData2
                    routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                    IF routineSymbolIdx > 0 THEN
                      routineSymbolIdx = routineSymbolIdx - 1

                      IF routineSymbolIdx < symbolCount THEN
                        VIdx = routineSymbolIdx
                        vDataType = symbols(VIdx).DataType
                      END IF
                    END IF
                  END IF
                END IF

                IF isFound = 0 THEN
                  ' Fallback lookup for missing suffixes (QB64 tolerance)
                  FOR iSuffix = 1 TO 7
                    IF iSuffix = 1 THEN testName$ = vName$ + "$"
                    IF iSuffix = 2 THEN testName$ = vName$ + "%"
                    IF iSuffix = 3 THEN testName$ = vName$ + "&"
                    IF iSuffix = 4 THEN testName$ = vName$ + "!"
                    IF iSuffix = 5 THEN testName$ = vName$ + "#"
                    IF iSuffix = 6 THEN testName$ = vName$ + "~"
                    IF iSuffix = 7 THEN testName$ = vName$ + "~&"

                    IF findSymbol(testName$) THEN
                      tmpIdx = returnedData2
                      ' Only map if it is actually a Function or an Array
                      IF symbols(tmpIdx).SubIndex <> 0 OR symbols(tmpIdx).IsArray > 0 THEN
                        VIdx = tmpIdx
                        vDataType = symbols(VIdx).DataType
                        isFound = 1
                        EXIT FOR
                      ELSE
                        IF isFuncOrArray = 1 AND symbols(tmpIdx).IsArray = 0 AND symbols(tmpIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                          searchNameGlobal$ = testName$
                          IF findSubIndexCanonical(searchNameGlobal$) THEN
                            routineSubIdx = returnedData2
                            routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                            IF routineSymbolIdx > 0 THEN
                              routineSymbolIdx = routineSymbolIdx - 1

                              IF routineSymbolIdx < symbolCount THEN
                                VIdx = routineSymbolIdx
                                vDataType = symbols(VIdx).DataType
                                isFound = 1
                              END IF
                            END IF
                          END IF
                          IF isFound = 1 THEN EXIT FOR
                        END IF
                      END IF
                    END IF
                  NEXT

                  IF isFound = 0 THEN
                    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
                      throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
                      tiraParseExpression$ = ""
                      EXIT FUNCTION
                    ELSE
                      IF allowImplicit = 0 THEN
                        throwCompilerError "UNDECLARED VARIABLE OR FUNCTION '" + vName$ + "'", ASIS, 0
                        tiraParseExpression$ = ""
                        EXIT FUNCTION
                      ELSE
                        ff = resolveSymbol(vName$)
                        IF ff = 0 THEN
                          tiraParseExpression$ = ""
                          EXIT FUNCTION
                        END IF
                        VIdx = returnedData2
                        vDataType = returnedData3
                      END IF
                    END IF
                  END IF
                END IF
              END IF

              ' Strict RHS Enforcement
              IF allowImplicit = 0 THEN
                IF symbols(VIdx).IsExplicit = DECL_IMPLICIT THEN
                  throwCompilerError "UNDECLARED VARIABLE OR FUNCTION '" + vName$ + "'", ASIS, 0
                  tiraParseExpression$ = ""
                  EXIT FUNCTION
                END IF
              END IF

              IF symbols(VIdx).SubIndex <> 0 THEN
                IF opTop > MAX_SHUNT THEN
                  throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                  tiraParseExpression$ = ""
                  EXIT FUNCTION
                END IF
                shuntOp(opTop).OpCode = SHUNT_FUNC
                shuntOp(opTop).VIdx = symbols(VIdx).SubIndex
                shuntOp(opTop).ArgCount = 1
                opTop = opTop + 1
                ix = tokIdx
              ELSE
                IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
                  IF symbols(VIdx).IsArray = ARRAY_KIND_NONE THEN
                    throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
                    tiraParseExpression$ = ""
                    EXIT FUNCTION
                  END IF
                END IF

                IF opTop > MAX_SHUNT THEN
                  throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                  tiraParseExpression$ = ""
                  EXIT FUNCTION
                END IF
                shuntOp(opTop).OpCode = SHUNT_ARRAY
                shuntOp(opTop).VIdx = VIdx
                shuntOp(opTop).ArgCount = 1
                shuntOp(opTop).TargetType = vDataType
                shuntOp(opTop).UdtOffset = 0
                shuntOp(opTop).HasField = 0
                shuntOp(opTop).FieldSize = 0
                shuntOp(opTop).IsDynamic = 0

                ff = findMatchingParen(tokIdx, endIdx)
                IF ff = 1 THEN
                  closeParen = returnedData2
                  currUdtIndex = symbols(VIdx).UDTIndex
                  currTargetType = vDataType
                  currUdtOffset = 0
                  currFieldSize = 0
                  currIsDynamic = 0

                  parseIdx = closeParen + 1
                  DO WHILE parseIdx <= endIdx
                    IF lineTokenVals(parseIdx) = 256 + ASC(".") THEN
                      IF parseIdx + 1 <= endIdx THEN
                        fieldName$ = UCASE$(lineTokens$(parseIdx + 1))
                        IF currTargetType <> TYPE_UDT THEN
                          throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
                          tiraParseExpression$ = ""
                          EXIT FUNCTION
                        END IF
                        uIdx = currUdtIndex
                        fieldFound = 0

                        IF findUdtFieldIndex(uIdx, fieldName$) THEN
                          iField = returnedData2
                          currUdtOffset = currUdtOffset + udtFields(uIdx, iField).Offset
                          currTargetType = udtFields(uIdx, iField).DataType
                          currUdtIndex = udtFields(uIdx, iField).UDTIndex
                          currFieldSize = udtFields(uIdx, iField).Size
                          currIsDynamic = udtFields(uIdx, iField).IsDynamicString
                          shuntOp(opTop).HasField = 1
                          fieldFound = 1
                        END IF

                        IF fieldFound = 0 THEN
                          IF findUdtFieldIndex(uIdx, fieldName$ + "$") THEN
                            iField = returnedData2
                            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
                              currUdtOffset = currUdtOffset + udtFields(uIdx, iField).Offset
                              currTargetType = udtFields(uIdx, iField).DataType
                              currUdtIndex = udtFields(uIdx, iField).UDTIndex
                              currFieldSize = udtFields(uIdx, iField).Size
                              currIsDynamic = udtFields(uIdx, iField).IsDynamicString
                              shuntOp(opTop).HasField = 1
                              fieldFound = 1
                            END IF
                          END IF
                        END IF

                        IF fieldFound = 0 THEN
                          throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
                          tiraParseExpression$ = ""
                          EXIT FUNCTION
                        END IF
                        parseIdx = parseIdx + 2
                      ELSE
                        throwCompilerError "EXPECTED FIELD NAME", ASIS, 0
                        tiraParseExpression$ = ""
                        EXIT FUNCTION
                      END IF
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                  shuntOp(opTop).UdtOffset = currUdtOffset
                  shuntOp(opTop).TargetType = currTargetType
                  shuntOp(opTop).FieldSize = currFieldSize
                  shuntOp(opTop).IsDynamic = currIsDynamic
                END IF

                opTop = opTop + 1
                ix = tokIdx
              END IF
            END IF
          ELSE
            ' Isolate flat leaf for tiraParseFactor$ (Literal, Scalar, UDT Field)
            leafEnd = ix
            IF tVal = 0 THEN
              DO WHILE leafEnd + 1 <= endIdx
                IF lineTokenVals(leafEnd + 1) = 256 + ASC(".") THEN
                  IF leafEnd + 2 <= endIdx THEN
                    leafEnd = leafEnd + 2
                  ELSE
                    EXIT DO
                  END IF
                ELSE
                  EXIT DO
                END IF
              LOOP
            END IF

            leafVar$ = tiraParseFactor$(ix, leafEnd, allowImplicit)
            IF leafVar$ = "" THEN
              tiraParseExpression$ = ""
              EXIT FUNCTION
            END IF

            IF valTop > MAX_SHUNT THEN
              throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
              tiraParseExpression$ = ""
              EXIT FUNCTION
            END IF
            shuntVal(valTop).VarName = leafVar$
            shuntVal(valTop).DataType = exprIs.DataType
            shuntVal(valTop).VIdx = returnedData2
            shuntVal(valTop).IsComplex = returnedData3
            shuntVal(valTop).AddrVar = returnAddrVar
            valTop = valTop + 1

            ix = leafEnd + 1
            prState = 1
          END IF

      END SELECT ' tVal

    ELSE ' prState = 1
      IF tVal = 256 + ASC(",") THEN
        foundParen = 0
        DO WHILE opTop > 0
          topOp = shuntOp(opTop - 1).OpCode
          IF topOp = TOK_OP_LPAREN THEN
            foundParen = 1
            EXIT DO
          END IF
          opTop = opTop - 1
          ff = tiraScheduleShuntingOp(topOp, valTop)
          IF ff = 0 THEN
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
          valTop = returnedData2
        LOOP

        IF foundParen = 0 THEN
          throwCompilerError "MISPLACED COMMA", ASIS, 0
          tiraParseExpression$ = ""
          EXIT FUNCTION
        END IF

        IF opTop > 1 THEN
          funcOp = shuntOp(opTop - 2).OpCode
          IF funcOp = SHUNT_FUNC OR funcOp = SHUNT_ARRAY THEN
            shuntOp(opTop - 2).ArgCount = shuntOp(opTop - 2).ArgCount + 1
          END IF
        END IF

        ix = ix + 1
        prState = 0

      ELSE
        IF tVal = TOK_OP_RPAREN THEN
          foundParen = 0
          DO WHILE opTop > 0
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = TOK_OP_LPAREN THEN
              foundParen = 1
              EXIT DO
            END IF
            opTop = opTop - 1
            ff = tiraScheduleShuntingOp(topOp, valTop)
            IF ff = 0 THEN
              tiraParseExpression$ = ""
              EXIT FUNCTION
            END IF
            valTop = returnedData2
          LOOP

          IF foundParen = 0 THEN
            throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
          opTop = opTop - 1 ' Pop LPAREN

          IF opTop > 0 THEN
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = SHUNT_FUNC OR topOp = SHUNT_ARRAY OR topOp = SHUNT_CAST THEN
              opTop = opTop - 1
              ff = tiraScheduleFuncOrArray(opTop, valTop)
              IF ff = 0 THEN
                tiraParseExpression$ = ""
                EXIT FUNCTION
              END IF
              valTop = returnedData2

              IF topOp = SHUNT_ARRAY THEN
                IF shuntOp(opTop).HasField = 1 THEN
                  DO WHILE ix + 1 <= endIdx
                    IF lineTokenVals(ix + 1) = 256 + ASC(".") THEN
                      ix = ix + 2
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                END IF
              END IF
            END IF
          END IF

          ix = ix + 1

        ELSE
          IF tVal = TOK_OP_PLUS OR tVal = TOK_OP_MINUS OR tVal = TOK_OP_MUL OR tVal = TOK_OP_DIV OR tVal = TOK_OP_IDIV OR tVal = TOK_OP_POW OR tVal = TOK_OP_EQUAL OR tVal = TOK_OP_LESS OR tVal = TOK_OP_GREATER OR tVal = TOK_AND OR tVal = TOK_OR OR tVal = TOK_XOR OR tVal = TOK_NOR OR tVal = TOK_NAND OR tVal = TOK_XNOR OR tVal = TOK_MOD THEN

            opFinalVal = tVal

            SELECT CASE tVal

              CASE TOK_OP_LESS
                IF ix + 1 <= endIdx THEN
                  nxtVal = lineTokenVals(ix + 1)

                  SELECT CASE nxtVal

                    CASE TOK_OP_EQUAL
                      opFinalVal = TOK_OP_LESS_EQUAL
                      ix = ix + 1

                    CASE TOK_OP_GREATER
                      opFinalVal = TOK_OP_NOT_EQUAL
                      ix = ix + 1

                  END SELECT ' nxtVal

                END IF

              CASE TOK_OP_GREATER
                IF ix + 1 <= endIdx THEN
                  nxtVal = lineTokenVals(ix + 1)
                  IF nxtVal = TOK_OP_EQUAL THEN
                    opFinalVal = TOK_OP_GREATER_EQUAL
                    ix = ix + 1
                  END IF
                END IF

            END SELECT ' tVal

            prec = tiraGetPrecedence(opFinalVal)

            DO WHILE opTop > 0
              topOp = shuntOp(opTop - 1).OpCode
              IF topOp = TOK_OP_LPAREN THEN EXIT DO

              topPrec = tiraGetPrecedence(topOp)

              popIt = 0
              IF opFinalVal = TOK_OP_POW THEN
                IF topPrec > prec THEN popIt = 1
              ELSE
                IF topPrec >= prec THEN popIt = 1
              END IF

              IF popIt = 1 THEN
                opTop = opTop - 1
                ff = tiraScheduleShuntingOp(topOp, valTop)
                IF ff = 0 THEN
                  tiraParseExpression$ = ""
                  EXIT FUNCTION
                END IF
                valTop = returnedData2
              ELSE
                EXIT DO
              END IF
            LOOP

            IF opTop > MAX_SHUNT THEN
              throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
              tiraParseExpression$ = ""
              EXIT FUNCTION
            END IF
            shuntOp(opTop).OpCode = opFinalVal
            opTop = opTop + 1
            ix = ix + 1
            prState = 0
          ELSE
            throwCompilerError "EXPECTED OPERATOR", ASIS, 0
            tiraParseExpression$ = ""
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF
  LOOP

  ' Process remaining operators
  DO WHILE opTop > 0
    opTop = opTop - 1
    opVal = shuntOp(opTop).OpCode
    IF opVal = TOK_OP_LPAREN THEN
      throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
      tiraParseExpression$ = ""
      EXIT FUNCTION
    END IF

    ff = tiraScheduleShuntingOp(opVal, valTop)
    IF ff = 0 THEN
      tiraParseExpression$ = ""
      EXIT FUNCTION
    END IF
    valTop = returnedData2
  LOOP

  IF valTop <> 1 THEN
    throwCompilerError "MALFORMED EXPRESSION", ASIS, 0
    tiraParseExpression$ = ""
    EXIT FUNCTION
  END IF

  exprIs.DataType = shuntVal(0).DataType
  exprIs.IsTemp = 1
  tiraParseExpression$ = shuntVal(0).VarName

END FUNCTION ' tiraParseExpression$

''''''''''''''''''''''''
FUNCTION tiraParseExpressionId (startIdx, endIdx, allowImplicit)

  tiraCheckActive ("tiraParseExpressionId")

  tiraParsedArgType = TIRA_ARG_EMPTY
  tiraParsedArgVal = 0
  tiraParsedAddrType = TIRA_ARG_EMPTY
  tiraParsedAddrVal = 0
  returnAddrVar = ""

  DIM valTop AS LONG
  DIM opTop AS LONG
  DIM prState AS LONG
  DIM tVal AS LONG
  DIM tVal2 AS LONG
  DIM leafEnd AS LONG
  DIM foundParen AS LONG
  DIM opVal AS LONG
  DIM prec AS LONG
  DIM topOp AS LONG
  DIM topPrec AS LONG
  DIM popIt AS LONG
  DIM opFinalVal AS LONG
  DIM nxtVal AS LONG
  DIM isFuncOrArray AS LONG
  DIM closeParen AS LONG
  DIM fieldName$
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM funcOp AS LONG

  DIM isFound AS LONG
  DIM testName$
  DIM iSuffix AS LONG
  DIM tmpIdx AS LONG
  DIM tokIdx AS LONG
  DIM isUdtBase AS LONG

  DIM currTargetType AS LONG
  DIM currUdtIndex AS LONG
  DIM currUdtOffset AS LONG
  DIM currFieldSize AS LONG
  DIM currIsDynamic AS LONG
  DIM parseIdx AS LONG

  DIM searchNameGlobal$
  DIM routineSubIdx AS LONG
  DIM routineSymbolIdx AS LONG
  DIM leafText$
  DIM leafFirstChar AS STRING * 1
  DIM leafIsNumericLiteral AS LONG

  DIM conflictIdx AS LONG
  DIM suffix$
  DIM baseName$
  DIM existingName$
  DIM lastTwo$

  valTop = 0
  opTop = 0
  prState = 0 ' 0 = expect operand/unary/lparen, 1 = expect binary/rparen
  ix = startIdx

  DO WHILE ix <= endIdx
    IF t.IsActive = 0 THEN
      tiraParseExpressionId = 0
      EXIT FUNCTION
    END IF

    tVal = lineTokenVals(ix)

    IF prState = 0 THEN

      SELECT CASE tVal

        CASE TOK_OP_LPAREN
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_LPAREN
          opTop = opTop + 1
          ix = ix + 1

        CASE TOK_OP_RPAREN ' Empty parentheses handling for root array requests e.g., A()
          foundParen = 0
          DO WHILE opTop > 0
            opVal = shuntOp(opTop - 1).OpCode
            IF opVal = TOK_OP_LPAREN THEN
              foundParen = 1
              EXIT DO
            END IF
            opTop = opTop - 1
            ff = tiraScheduleShuntingOpId(opVal, valTop)
            IF ff = 0 THEN
              tiraParseExpressionId = 0
              EXIT FUNCTION
            END IF
            valTop = returnedData2
          LOOP

          IF foundParen = 0 THEN
            throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF

          opTop = opTop - 1 ' Pop LPAREN

          IF opTop > 0 THEN
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = SHUNT_FUNC OR topOp = SHUNT_ARRAY THEN
              shuntOp(opTop - 1).ArgCount = 0
              opTop = opTop - 1
              ff = tiraScheduleFuncOrArrayId(opTop, valTop)
              IF ff = 0 THEN
                tiraParseExpressionId = 0
                EXIT FUNCTION
              END IF
              valTop = returnedData2

              IF topOp = SHUNT_ARRAY THEN
                IF shuntOp(opTop).HasField = 1 THEN
                  DO WHILE ix + 1 <= endIdx
                    IF lineTokenVals(ix + 1) = 256 + ASC(".") THEN
                      ix = ix + 2
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                END IF
              END IF
            END IF
          END IF
          ix = ix + 1
          prState = 1

        CASE TOK_OP_MINUS
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_UNARY_MINUS
          opTop = opTop + 1
          ix = ix + 1

        CASE TOK_NOT
          IF opTop > MAX_SHUNT THEN
            throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
          shuntOp(opTop).OpCode = TOK_OP_UNARY_NOT
          opTop = opTop + 1
          ix = ix + 1

        CASE ELSE
          isFuncOrArray = 0
          IF tVal = 0 OR tVal = TOK_CINT OR tVal = TOK_CLNG OR tVal = TOK_CSNG OR tVal = TOK_CDBL THEN
            IF ix + 1 <= endIdx THEN
              IF lineTokenVals(ix + 1) = 256 + ASC("(") THEN
                isFuncOrArray = 1
              END IF
            END IF
          END IF

          IF isFuncOrArray = 1 THEN
            IF tVal = TOK_CINT OR tVal = TOK_CLNG OR tVal = TOK_CSNG OR tVal = TOK_CDBL THEN
              IF opTop > MAX_SHUNT THEN
                throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                tiraParseExpressionId = 0
                EXIT FUNCTION
              END IF
              shuntOp(opTop).OpCode = SHUNT_CAST

              SELECT CASE tVal

                CASE TOK_CINT: shuntOp(opTop).VIdx = TYPE_INTEGER
                CASE TOK_CLNG: shuntOp(opTop).VIdx = TYPE_LONG
                CASE TOK_CSNG: shuntOp(opTop).VIdx = TYPE_SINGLE
                CASE TOK_CDBL: shuntOp(opTop).VIdx = TYPE_DOUBLE

              END SELECT ' tVal

              shuntOp(opTop).ArgCount = 1
              opTop = opTop + 1
              ix = ix + 1
            ELSE
              vName$ = UCASE$(lineTokens$(ix))
              tokIdx = ix + 1

              ' Legacy dot variable check for arrays
              DO WHILE tokIdx <= endIdx
                IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
                  IF findSymbol(vName$) THEN
                    IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
                  END IF
                  IF cm.ClassicMode = 1 THEN
                    IF tokIdx + 1 <= endIdx THEN
                      vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
                      tokIdx = tokIdx + 2
                    ELSE
                      EXIT DO
                    END IF
                  ELSE
                    throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
                    addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
                    tiraParseExpressionId = 0
                    EXIT FUNCTION
                  END IF
                ELSE
                  EXIT DO
                END IF
              LOOP

              isFound = 0

              IF findSymbol(vName$) THEN
                VIdx = returnedData2
                vDataType = symbols(VIdx).DataType
                isFound = 1

                IF isFuncOrArray = 1 AND symbols(VIdx).IsArray = 0 AND symbols(VIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                  searchNameGlobal$ = vName$
                  IF findSubIndexCanonical(searchNameGlobal$) THEN
                    routineSubIdx = returnedData2
                    routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                    IF routineSymbolIdx > 0 THEN
                      routineSymbolIdx = routineSymbolIdx - 1

                      IF routineSymbolIdx < symbolCount THEN
                        VIdx = routineSymbolIdx
                        vDataType = symbols(VIdx).DataType
                      END IF
                    END IF
                  END IF
                END IF

              ELSE
                ' Fallback for string strictness mapping
                suffix$ = RIGHT$(vName$, 1)
                IF suffix$ = "$" THEN
                  baseName$ = LEFT$(vName$, LEN(vName$) - 1)
                  IF findSymbol(baseName$) THEN
                    conflictIdx = returnedData2
                    existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                    IF cm.ClassicMode = 1 THEN
                      IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                        VIdx = conflictIdx
                        vDataType = symbols(VIdx).DataType
                        isFound = 1
                      END IF
                    ELSE
                      IF cm.StringStrict = 0 THEN
                        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                          VIdx = conflictIdx
                          vDataType = symbols(VIdx).DataType
                          isFound = 1
                        ELSE
                          throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                          tiraParseExpressionId = 0
                          EXIT FUNCTION
                        END IF
                      ELSE
                        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                          throwCompilerError "VARIABLE NAME CONFLICT: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                        ELSE
                          throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                        END IF
                        tiraParseExpressionId = 0
                        EXIT FUNCTION
                      END IF
                    END IF
                  END IF
                ELSE
                  lastTwo$ = RIGHT$(vName$, 2)
                  IF lastTwo$ <> "~&" THEN
                    IF suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "!" AND suffix$ <> "#" AND suffix$ <> "~" THEN
                      IF findSymbol(vName$ + "$") THEN
                        conflictIdx = returnedData2
                        existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                        IF cm.ClassicMode = 1 THEN
                          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                            VIdx = conflictIdx
                            vDataType = symbols(VIdx).DataType
                            isFound = 1
                          END IF
                        ELSE
                          IF cm.StringStrict = 0 THEN
                            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                              VIdx = conflictIdx
                              vDataType = symbols(VIdx).DataType
                              isFound = 1
                            ELSE
                              throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                              tiraParseExpressionId = 0
                              EXIT FUNCTION
                            END IF
                          ELSE
                            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                              throwCompilerError "VARIABLE NAME CONFLICT: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                            ELSE
                              throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                            END IF
                            tiraParseExpressionId = 0
                            EXIT FUNCTION
                          END IF
                        END IF
                      END IF
                    END IF
                  END IF
                END IF

                IF isFound = 1 AND isFuncOrArray = 1 AND symbols(VIdx).IsArray = 0 AND symbols(VIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                  searchNameGlobal$ = RTRIM$(symbols(VIdx).RecordName)
                  IF findSubIndexCanonical(searchNameGlobal$) THEN
                    routineSubIdx = returnedData2
                    routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                    IF routineSymbolIdx > 0 THEN
                      routineSymbolIdx = routineSymbolIdx - 1

                      IF routineSymbolIdx < symbolCount THEN
                        VIdx = routineSymbolIdx
                        vDataType = symbols(VIdx).DataType
                      END IF
                    END IF
                  END IF
                END IF

                IF isFound = 0 THEN
                  ' Fallback lookup for missing suffixes (QB64 tolerance)
                  FOR iSuffix = 1 TO 7
                    IF iSuffix = 1 THEN testName$ = vName$ + "$"
                    IF iSuffix = 2 THEN testName$ = vName$ + "%"
                    IF iSuffix = 3 THEN testName$ = vName$ + "&"
                    IF iSuffix = 4 THEN testName$ = vName$ + "!"
                    IF iSuffix = 5 THEN testName$ = vName$ + "#"
                    IF iSuffix = 6 THEN testName$ = vName$ + "~"
                    IF iSuffix = 7 THEN testName$ = vName$ + "~&"

                    IF findSymbol(testName$) THEN
                      tmpIdx = returnedData2
                      ' Only map if it is actually a Function or an Array
                      IF symbols(tmpIdx).SubIndex <> 0 OR symbols(tmpIdx).IsArray > 0 THEN
                        VIdx = tmpIdx
                        vDataType = symbols(VIdx).DataType
                        isFound = 1
                        EXIT FOR
                      ELSE
                        IF isFuncOrArray = 1 AND symbols(tmpIdx).IsArray = 0 AND symbols(tmpIdx).SubIndex = 0 AND currentScopeID > 0 THEN
                          searchNameGlobal$ = testName$
                          IF findSubIndexCanonical(searchNameGlobal$) THEN
                            routineSubIdx = returnedData2
                            routineSymbolIdx = routineSymbolIndex(routineSubIdx)

                            IF routineSymbolIdx > 0 THEN
                              routineSymbolIdx = routineSymbolIdx - 1

                              IF routineSymbolIdx < symbolCount THEN
                                VIdx = routineSymbolIdx
                                vDataType = symbols(VIdx).DataType
                                isFound = 1
                              END IF
                            END IF
                          END IF
                          IF isFound = 1 THEN EXIT FOR
                        END IF
                      END IF
                    END IF
                  NEXT

                  IF isFound = 0 THEN
                    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
                      throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
                      tiraParseExpressionId = 0
                      EXIT FUNCTION
                    ELSE
                      IF allowImplicit = 0 THEN
                        throwCompilerError "UNDECLARED VARIABLE OR FUNCTION '" + vName$ + "'", ASIS, 0
                        tiraParseExpressionId = 0
                        EXIT FUNCTION
                      ELSE
                        ff = resolveSymbol(vName$)
                        IF ff = 0 THEN
                          tiraParseExpressionId = 0
                          EXIT FUNCTION
                        END IF
                        VIdx = returnedData2
                        vDataType = returnedData3
                      END IF
                    END IF
                  END IF
                END IF
              END IF

              ' Strict RHS Enforcement
              IF allowImplicit = 0 THEN
                IF symbols(VIdx).IsExplicit = DECL_IMPLICIT THEN
                  throwCompilerError "UNDECLARED VARIABLE OR FUNCTION '" + vName$ + "'", ASIS, 0
                  tiraParseExpressionId = 0
                  EXIT FUNCTION
                END IF
              END IF

              IF symbols(VIdx).SubIndex <> 0 THEN
                IF opTop > MAX_SHUNT THEN
                  throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                  tiraParseExpressionId = 0
                  EXIT FUNCTION
                END IF
                shuntOp(opTop).OpCode = SHUNT_FUNC
                shuntOp(opTop).VIdx = symbols(VIdx).SubIndex
                shuntOp(opTop).ArgCount = 1
                opTop = opTop + 1
                ix = tokIdx
              ELSE
                IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
                  IF symbols(VIdx).IsArray = ARRAY_KIND_NONE THEN
                    throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
                    tiraParseExpressionId = 0
                    EXIT FUNCTION
                  END IF
                END IF

                IF opTop > MAX_SHUNT THEN
                  throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
                  tiraParseExpressionId = 0
                  EXIT FUNCTION
                END IF
                shuntOp(opTop).OpCode = SHUNT_ARRAY
                shuntOp(opTop).VIdx = VIdx
                shuntOp(opTop).ArgCount = 1
                shuntOp(opTop).TargetType = vDataType
                shuntOp(opTop).UdtOffset = 0
                shuntOp(opTop).HasField = 0
                shuntOp(opTop).FieldSize = 0
                shuntOp(opTop).IsDynamic = 0

                ff = findMatchingParen(tokIdx, endIdx)
                IF ff = 1 THEN
                  closeParen = returnedData2
                  currUdtIndex = symbols(VIdx).UDTIndex
                  currTargetType = vDataType
                  currUdtOffset = 0
                  currFieldSize = 0
                  currIsDynamic = 0

                  parseIdx = closeParen + 1
                  DO WHILE parseIdx <= endIdx
                    IF lineTokenVals(parseIdx) = 256 + ASC(".") THEN
                      IF parseIdx + 1 <= endIdx THEN
                        fieldName$ = UCASE$(lineTokens$(parseIdx + 1))
                        IF currTargetType <> TYPE_UDT THEN
                          throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
                          tiraParseExpressionId = 0
                          EXIT FUNCTION
                        END IF
                        uIdx = currUdtIndex
                        fieldFound = 0

                        IF findUdtFieldIndex(uIdx, fieldName$) THEN
                          iField = returnedData2
                          currUdtOffset = currUdtOffset + udtFields(uIdx, iField).Offset
                          currTargetType = udtFields(uIdx, iField).DataType
                          currUdtIndex = udtFields(uIdx, iField).UDTIndex
                          currFieldSize = udtFields(uIdx, iField).Size
                          currIsDynamic = udtFields(uIdx, iField).IsDynamicString
                          shuntOp(opTop).HasField = 1
                          fieldFound = 1
                        END IF

                        IF fieldFound = 0 THEN
                          IF findUdtFieldIndex(uIdx, fieldName$ + "$") THEN
                            iField = returnedData2
                            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
                              currUdtOffset = currUdtOffset + udtFields(uIdx, iField).Offset
                              currTargetType = udtFields(uIdx, iField).DataType
                              currUdtIndex = udtFields(uIdx, iField).UDTIndex
                              currFieldSize = udtFields(uIdx, iField).Size
                              currIsDynamic = udtFields(uIdx, iField).IsDynamicString
                              shuntOp(opTop).HasField = 1
                              fieldFound = 1
                            END IF
                          END IF
                        END IF

                        IF fieldFound = 0 THEN
                          throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
                          tiraParseExpressionId = 0
                          EXIT FUNCTION
                        END IF
                        parseIdx = parseIdx + 2
                      ELSE
                        throwCompilerError "EXPECTED FIELD NAME", ASIS, 0
                        tiraParseExpressionId = 0
                        EXIT FUNCTION
                      END IF
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                  shuntOp(opTop).UdtOffset = currUdtOffset
                  shuntOp(opTop).TargetType = currTargetType
                  shuntOp(opTop).FieldSize = currFieldSize
                  shuntOp(opTop).IsDynamic = currIsDynamic
                END IF

                opTop = opTop + 1
                ix = tokIdx
              END IF
            END IF
          ELSE
            ' Isolate flat leaf for tiraParseFactorId (Literal, Scalar, UDT Field)
            leafEnd = ix
            IF tVal = 0 THEN
              DO WHILE leafEnd + 1 <= endIdx
                IF lineTokenVals(leafEnd + 1) = 256 + ASC(".") THEN
                  IF leafEnd + 2 <= endIdx THEN
                    leafEnd = leafEnd + 2
                  ELSE
                    EXIT DO
                  END IF
                ELSE
                  EXIT DO
                END IF
              LOOP
            END IF

            ff = tiraParseFactorId(ix, leafEnd, allowImplicit)
            IF ff = 0 THEN
              tiraParseExpressionId = 0
              EXIT FUNCTION
            END IF

            IF valTop > MAX_SHUNT THEN
              throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
              tiraParseExpressionId = 0
              EXIT FUNCTION
            END IF
            leafIsNumericLiteral = 0
            IF leafEnd = ix THEN
              IF lineTokenVals(ix) = 0 THEN
                leafText$ = lineTokens$(ix)
                leafFirstChar = LEFT$(leafText$, 1)
                IF (leafFirstChar >= "0" AND leafFirstChar <= "9") OR leafFirstChar = "-" OR leafFirstChar = "." OR (leafFirstChar = "&" AND (UCASE$(MID$(leafText$, 2, 1)) = "H" OR UCASE$(MID$(leafText$, 2, 1)) = "O")) THEN
                  leafIsNumericLiteral = 1
                END IF
              END IF
            END IF

            IF leafIsNumericLiteral = 1 THEN
              shuntVal(valTop).VarName = leafText$
            ELSE
              shuntVal(valTop).VarName = ""
            END IF
            shuntVal(valTop).ArgType = tiraParsedArgType
            shuntVal(valTop).ArgVal = tiraParsedArgVal
            shuntVal(valTop).DataType = exprIs.DataType
            shuntVal(valTop).VIdx = returnedData2
            shuntVal(valTop).IsComplex = returnedData3
            shuntVal(valTop).AddrVar = returnAddrVar
            shuntVal(valTop).AddrType = tiraParsedAddrType
            shuntVal(valTop).AddrVal = tiraParsedAddrVal
            valTop = valTop + 1

            ix = leafEnd + 1
            prState = 1
          END IF

      END SELECT ' tVal

    ELSE ' prState = 1
      IF tVal = 256 + ASC(",") THEN
        foundParen = 0
        DO WHILE opTop > 0
          topOp = shuntOp(opTop - 1).OpCode
          IF topOp = TOK_OP_LPAREN THEN
            foundParen = 1
            EXIT DO
          END IF
          opTop = opTop - 1
          ff = tiraScheduleShuntingOpId(topOp, valTop)
          IF ff = 0 THEN
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
          valTop = returnedData2
        LOOP

        IF foundParen = 0 THEN
          throwCompilerError "MISPLACED COMMA", ASIS, 0
          tiraParseExpressionId = 0
          EXIT FUNCTION
        END IF

        IF opTop > 1 THEN
          funcOp = shuntOp(opTop - 2).OpCode
          IF funcOp = SHUNT_FUNC OR funcOp = SHUNT_ARRAY THEN
            shuntOp(opTop - 2).ArgCount = shuntOp(opTop - 2).ArgCount + 1
          END IF
        END IF

        ix = ix + 1
        prState = 0

      ELSE
        IF tVal = TOK_OP_RPAREN THEN
          foundParen = 0
          DO WHILE opTop > 0
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = TOK_OP_LPAREN THEN
              foundParen = 1
              EXIT DO
            END IF
            opTop = opTop - 1
            ff = tiraScheduleShuntingOpId(topOp, valTop)
            IF ff = 0 THEN
              tiraParseExpressionId = 0
              EXIT FUNCTION
            END IF
            valTop = returnedData2
          LOOP

          IF foundParen = 0 THEN
            throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
          opTop = opTop - 1 ' Pop LPAREN

          IF opTop > 0 THEN
            topOp = shuntOp(opTop - 1).OpCode
            IF topOp = SHUNT_FUNC OR topOp = SHUNT_ARRAY OR topOp = SHUNT_CAST THEN
              opTop = opTop - 1
              ff = tiraScheduleFuncOrArrayId(opTop, valTop)
              IF ff = 0 THEN
                tiraParseExpressionId = 0
                EXIT FUNCTION
              END IF
              valTop = returnedData2

              IF topOp = SHUNT_ARRAY THEN
                IF shuntOp(opTop).HasField = 1 THEN
                  DO WHILE ix + 1 <= endIdx
                    IF lineTokenVals(ix + 1) = 256 + ASC(".") THEN
                      ix = ix + 2
                    ELSE
                      EXIT DO
                    END IF
                  LOOP
                END IF
              END IF
            END IF
          END IF

          ix = ix + 1

        ELSE
          IF tVal = TOK_OP_PLUS OR tVal = TOK_OP_MINUS OR tVal = TOK_OP_MUL OR tVal = TOK_OP_DIV OR tVal = TOK_OP_IDIV OR tVal = TOK_OP_POW OR tVal = TOK_OP_EQUAL OR tVal = TOK_OP_LESS OR tVal = TOK_OP_GREATER OR tVal = TOK_AND OR tVal = TOK_OR OR tVal = TOK_XOR OR tVal = TOK_NOR OR tVal = TOK_NAND OR tVal = TOK_XNOR OR tVal = TOK_MOD THEN

            opFinalVal = tVal

            SELECT CASE tVal

              CASE TOK_OP_LESS
                IF ix + 1 <= endIdx THEN
                  nxtVal = lineTokenVals(ix + 1)

                  SELECT CASE nxtVal

                    CASE TOK_OP_EQUAL
                      opFinalVal = TOK_OP_LESS_EQUAL
                      ix = ix + 1

                    CASE TOK_OP_GREATER
                      opFinalVal = TOK_OP_NOT_EQUAL
                      ix = ix + 1

                  END SELECT ' nxtVal

                END IF

              CASE TOK_OP_GREATER
                IF ix + 1 <= endIdx THEN
                  nxtVal = lineTokenVals(ix + 1)
                  IF nxtVal = TOK_OP_EQUAL THEN
                    opFinalVal = TOK_OP_GREATER_EQUAL
                    ix = ix + 1
                  END IF
                END IF

            END SELECT ' tVal

            prec = tiraGetPrecedence(opFinalVal)

            DO WHILE opTop > 0
              topOp = shuntOp(opTop - 1).OpCode
              IF topOp = TOK_OP_LPAREN THEN EXIT DO

              topPrec = tiraGetPrecedence(topOp)

              popIt = 0
              IF opFinalVal = TOK_OP_POW THEN
                IF topPrec > prec THEN popIt = 1
              ELSE
                IF topPrec >= prec THEN popIt = 1
              END IF

              IF popIt = 1 THEN
                opTop = opTop - 1
                ff = tiraScheduleShuntingOpId(topOp, valTop)
                IF ff = 0 THEN
                  tiraParseExpressionId = 0
                  EXIT FUNCTION
                END IF
                valTop = returnedData2
              ELSE
                EXIT DO
              END IF
            LOOP

            IF opTop > MAX_SHUNT THEN
              throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
              tiraParseExpressionId = 0
              EXIT FUNCTION
            END IF
            shuntOp(opTop).OpCode = opFinalVal
            opTop = opTop + 1
            ix = ix + 1
            prState = 0
          ELSE
            throwCompilerError "EXPECTED OPERATOR", ASIS, 0
            tiraParseExpressionId = 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF
  LOOP

  ' Process remaining operators
  DO WHILE opTop > 0
    opTop = opTop - 1
    opVal = shuntOp(opTop).OpCode
    IF opVal = TOK_OP_LPAREN THEN
      throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
      tiraParseExpressionId = 0
      EXIT FUNCTION
    END IF

    ff = tiraScheduleShuntingOpId(opVal, valTop)
    IF ff = 0 THEN
      tiraParseExpressionId = 0
      EXIT FUNCTION
    END IF
    valTop = returnedData2
  LOOP

  IF valTop <> 1 THEN
    throwCompilerError "MALFORMED EXPRESSION", ASIS, 0
    tiraParseExpressionId = 0
    EXIT FUNCTION
  END IF

  exprIs.DataType = shuntVal(0).DataType
  exprIs.IsTemp = 1
  tiraParsedArgType = shuntVal(0).ArgType
  tiraParsedArgVal = shuntVal(0).ArgVal
  tiraParsedAddrType = shuntVal(0).AddrType
  tiraParsedAddrVal = shuntVal(0).AddrVal
  returnAddrVar = shuntVal(0).AddrVar
  tiraParseExpressionId = 1

END FUNCTION ' tiraParseExpressionId

''''''''''''''''''''''''
FUNCTION tiraParseExpressionInt$ (startIdx, endIdx, allowImplicit, errMsg$)

  tiraCheckActive ("tiraParseExpressionInt$")

  DIM resVar$
  resVar$ = tiraParseExpressionNumeric$(startIdx, endIdx, allowImplicit, errMsg$)

  IF resVar$ = "" THEN
    tiraParseExpressionInt$ = ""
    EXIT FUNCTION
  END IF

  tiraParseExpressionInt$ = tiraForceInt$(resVar$)

END FUNCTION '  tiraParseExpressionInt$

''''''''''''''''''''''''
FUNCTION tiraParseExpressionArgId (startIdx, endIdx, allowImplicit)

  tiraParseExpressionArgId = tiraParseExpressionId(startIdx, endIdx, allowImplicit)

END FUNCTION ' tiraParseExpressionArgId

''''''''''''''''''''''''
FUNCTION tiraParseExpressionIntArgId (startIdx, endIdx, allowImplicit, errMsg$)

  DIM literalStartIdx AS LONG
  DIM literalEndIdx AS LONG
  DIM isNumericLiteral AS LONG
  DIM firstChar AS STRING * 1
  DIM literalText$

  IF tiraParseExpressionNumericArgId(startIdx, endIdx, allowImplicit, errMsg$) = 0 THEN
    tiraParseExpressionIntArgId = 0
    EXIT FUNCTION
  END IF

  literalStartIdx = startIdx
  literalEndIdx = endIdx

  DO WHILE literalStartIdx < literalEndIdx
    IF lineTokenVals(literalStartIdx) = 256 + ASC("(") THEN
      ff = findMatchingParen(literalStartIdx, literalEndIdx)
      IF ff = 1 THEN
        IF returnedData2 = literalEndIdx THEN
          literalStartIdx = literalStartIdx + 1
          literalEndIdx = literalEndIdx - 1
        ELSE
          EXIT DO
        END IF
      ELSE
        EXIT DO
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  isNumericLiteral = 0
  IF literalStartIdx = literalEndIdx THEN
    IF lineTokenVals(literalStartIdx) = 0 THEN
      literalText$ = lineTokens$(literalStartIdx)
      firstChar = LEFT$(literalText$, 1)

      IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR (firstChar = "&" AND (UCASE$(MID$(literalText$, 2, 1)) = "H" OR UCASE$(MID$(literalText$, 2, 1)) = "O")) THEN
        isNumericLiteral = 1
      END IF
    END IF
  END IF

  IF isNumericLiteral = 1 THEN
    IF INSTR(literalText$, ".") > 0 THEN
      tiraParsedArgType = TIRA_ARG_LITERAL
      tiraParsedArgVal = INT(VAL(literalText$))
    END IF
  ELSE
    tiraForceIntArgId tiraParsedArgType, tiraParsedArgVal, exprIs.DataType
  END IF

  tiraParseExpressionIntArgId = 1

END FUNCTION ' tiraParseExpressionIntArgId

''''''''''''''''''''''''
FUNCTION tiraParseExpressionNumeric$ (startIdx, endIdx, allowImplicit, errMsg$)

  tiraCheckActive ("tiraParseExpressionNumeric$")

  DIM resVar$
  resVar$ = tiraParseExpression$(startIdx, endIdx, allowImplicit)

  IF resVar$ = "" THEN
    tira_Cancel
    tiraParseExpressionNumeric$ = ""
    EXIT FUNCTION
  END IF

  IF exprIs.DataType = TYPE_STRING THEN
    throwCompilerErrorAndCancelTira errMsg$, ASIS, 0
    tiraParseExpressionNumeric$ = ""
    EXIT FUNCTION
  END IF

  tiraParseExpressionNumeric$ = resVar$

END FUNCTION ' tiraParseExpressionNumeric$

''''''''''''''''''''''''
FUNCTION tiraParseExpressionNumericArgId (startIdx, endIdx, allowImplicit, errMsg$)

  IF tiraParseExpressionId(startIdx, endIdx, allowImplicit) = 0 THEN
    tira_Cancel
    tiraParseExpressionNumericArgId = 0
    EXIT FUNCTION
  END IF

  IF exprIs.DataType = TYPE_STRING THEN
    throwCompilerErrorAndCancelTira errMsg$, ASIS, 0
    tiraParseExpressionNumericArgId = 0
    EXIT FUNCTION
  END IF

  tiraParseExpressionNumericArgId = 1

END FUNCTION ' tiraParseExpressionNumericArgId

''''''''''''''''''''''''
FUNCTION tiraParseFactor$ (startIdx, endIdx, allowImplicit)

  returnExtraPrepare

  tiraCheckActive ("tiraParseFactor$")

  returnAddrVar = ""

  DIM tVal AS LONG
  DIM vIdx AS LONG
  DIM vDataType AS LONG
  DIM firstChar AS STRING * 1
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tokIdx AS LONG
  DIM resVar$
  DIM currUdtIndex AS LONG
  DIM tempFieldSize AS LONG
  DIM tempIsDynamicString AS LONG
  DIM isFixedUdtString AS LONG
  DIM descPtr$
  DIM finalAddr$
  DIM skipNullLbl$
  DIM subIdx AS LONG
  DIM retVarIdx AS LONG
  DIM resType AS LONG
  DIM subName$

  DIM isFound AS LONG
  DIM conflictIdx AS LONG
  DIM suffix$
  DIM baseName$
  DIM existingName$
  DIM lastTwo$

  '''' Literals
  IF startIdx = endIdx THEN
    tVal = lineTokenVals(startIdx)
    IF tVal = 0 THEN
      firstChar = LEFT$(lineTokens$(startIdx), 1)
      IF firstChar = CHR$(34) THEN
        lit$ = extractQuotes$(lineTokens$(startIdx))
        ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
        t.TiraVarCounter = t.TiraVarCounter + 1

        ' Ordinary program literals must not enter the generated-ID range reserved
        ' for runtime helpers. Fail this factor before using the resolved symbol.
        IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
          throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
          tiraParseFactor$ = ""
          return3 0
          return2 0
          EXIT FUNCTION
        END IF

        IF ff = 1 THEN
          vIdx = returnedData2
          strVarData$(vIdx) = lit$
          exprIs.DataType = TYPE_STRING
          exprIs.IsTemp = 0
          return3 1 ' isComplex (Prevents ref write-back)
          return2 vIdx
          tiraParseFactor$ = RTRIM$(symbols(vIdx).RecordName)
          EXIT FUNCTION
        END IF
        tiraParseFactor$ = ""
        return3 0
        return2 0
        EXIT FUNCTION
      ELSE
        IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR (firstChar = "&" AND (UCASE$(MID$(lineTokens$(startIdx), 2, 1)) = "H" OR UCASE$(MID$(lineTokens$(startIdx), 2, 1)) = "O")) THEN
          IF LEN(lineTokens$(startIdx)) >= 2 THEN
            lastTwoFactor$ = RIGHT$(lineTokens$(startIdx), 2)
          ELSE
            lastTwoFactor$ = ""
          END IF

          IF lastTwoFactor$ = "~&" THEN
            exprIs.DataType = TYPE_ULONG
            tiraParseFactor$ = lineTokens$(startIdx)
          ELSE
            lastChFactor$ = RIGHT$(lineTokens$(startIdx), 1)

            SELECT CASE lastChFactor$

              CASE "~"
                exprIs.DataType = TYPE_ULONG
                tiraParseFactor$ = lineTokens$(startIdx)

              CASE "!"
                exprIs.DataType = TYPE_SINGLE
                tiraParseFactor$ = lineTokens$(startIdx)

              CASE "#"
                exprIs.DataType = TYPE_DOUBLE
                tiraParseFactor$ = lineTokens$(startIdx)

              CASE "&"
                exprIs.DataType = TYPE_LONG
                tiraParseFactor$ = lineTokens$(startIdx)

              CASE ELSE
                IF INSTR(lineTokens$(startIdx), ".") > 0 THEN
                  IF expectedSymType = TYPE_DOUBLE THEN
                    exprIs.DataType = TYPE_DOUBLE
                    tiraParseFactor$ = lineTokens$(startIdx) + "#"
                  ELSE
                    exprIs.DataType = TYPE_SINGLE
                    tiraParseFactor$ = lineTokens$(startIdx)
                  END IF
                ELSE
                  exprIs.DataType = TYPE_LONG
                  tiraParseFactor$ = lineTokens$(startIdx)
                END IF

            END SELECT ' lastChFactor$
          END IF
          exprIs.IsTemp = 0
          return3 1 ' isComplex (Prevents ref write-back)
          return2 -1
          EXIT FUNCTION
        END IF
      END IF
    END IF
  END IF

  '''' Identifiers (Scalars and UDT fields only. Parens, arrays, funcs natively stripped out via tiraParseExpression$)
  vTok$ = lineTokens$(startIdx)
  IF lineTokenVals(startIdx) = 0 AND LEN(vTok$) > 0 THEN
    firstChar = LEFT$(vTok$, 1)
    IF (firstChar >= "A" AND firstChar <= "Z") OR (firstChar >= "a" AND firstChar <= "z") OR firstChar = "!" THEN

      vName$ = UCASE$(vTok$)
      tokIdx = startIdx + 1

      '''' Legacy dot variable check
      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          IF findSymbol(vName$) THEN
            IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
          END IF
          IF cm.ClassicMode = 1 THEN
            IF tokIdx + 1 <= endIdx THEN
              vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
              tokIdx = tokIdx + 2
            ELSE
              EXIT DO
            END IF
          ELSE
            throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
            addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      isFound = 0
      IF findSymbol(vName$) THEN
        vIdx = returnedData2
        vDataType = symbols(vIdx).DataType
        isFound = 1
      ELSE
        ' Fallback for string strictness mapping
        suffix$ = RIGHT$(vName$, 1)
        IF suffix$ = "$" THEN
          baseName$ = LEFT$(vName$, LEN(vName$) - 1)
          IF findSymbol(baseName$) THEN
            conflictIdx = returnedData2
            existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

            IF cm.ClassicMode = 1 THEN
              IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                vIdx = conflictIdx
                vDataType = symbols(vIdx).DataType
                isFound = 1
              END IF
            ELSE
              IF cm.StringStrict = 0 THEN
                IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                  vIdx = conflictIdx
                  vDataType = symbols(vIdx).DataType
                  isFound = 1
                ELSE
                  throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                  tiraParseFactor$ = ""
                  return3 0
                  return2 0
                  EXIT FUNCTION
                END IF
              ELSE
                IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                  throwCompilerError "VARIABLE NAME CONFLICT: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                ELSE
                  throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                END IF
                tiraParseFactor$ = ""
                return3 0
                return2 0
                EXIT FUNCTION
              END IF
            END IF
          END IF
        ELSE
          lastTwo$ = RIGHT$(vName$, 2)
          IF lastTwo$ <> "~&" THEN
            IF suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "!" AND suffix$ <> "#" AND suffix$ <> "~" THEN
              IF findSymbol(vName$ + "$") THEN
                conflictIdx = returnedData2
                existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                IF cm.ClassicMode = 1 THEN
                  IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                    vIdx = conflictIdx
                    vDataType = symbols(vIdx).DataType
                    isFound = 1
                  END IF
                ELSE
                  IF cm.StringStrict = 0 THEN
                    IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                      vIdx = conflictIdx
                      vDataType = symbols(vIdx).DataType
                      isFound = 1
                    ELSE
                      throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                      tiraParseFactor$ = ""
                      return3 0
                      return2 0
                      EXIT FUNCTION
                    END IF
                  ELSE
                    IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                      throwCompilerError "VARIABLE NAME CONFLICT: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                    ELSE
                      throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                    END IF
                    tiraParseFactor$ = ""
                    return3 0
                    return2 0
                    EXIT FUNCTION
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isFound = 1 THEN
        IF allowImplicit = 0 THEN
          IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
            throwCompilerError "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        END IF
      ELSE
        IF allowImplicit = 0 THEN
          throwCompilerError "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
          tiraParseFactor$ = ""
          return3 0
          return2 0
          EXIT FUNCTION
        ELSE
          ff = resolveSymbol(vName$)
          IF ff = 0 THEN
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
          vIdx = returnedData2
          vDataType = returnedData3
        END IF
      END IF

      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
        IF symbols(vIdx).SubIndex = 0 THEN
          IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
            throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        END IF
      END IF

      ' Bare zero-argument user functions are valid expression factors without parentheses
      IF symbols(vIdx).SubIndex <> 0 THEN
        subIdx = symbols(vIdx).SubIndex
        IF subs(subIdx).IsFunction = 1 AND subs(subIdx).ArgCount = 0 THEN
          subName$ = RTRIM$(subs(subIdx).RecordName)
          IF currentSubName$ <> subName$ THEN
            tiraCall subName$, 0, ""

            retVarIdx = subs(subIdx).ReturnVarIdx
            resType = symbols(retVarIdx).DataType
            resVar$ = tiraDimVar$("T", resType)
            tiraNew TC_GET_RET, resVar$

            exprIs.DataType = resType
            exprIs.IsTemp = 1
            return3 1
            return2 -1
            tiraParseFactor$ = resVar$
            EXIT FUNCTION
          END IF
        END IF
      END IF

      '''' Real UDT member check iterative walkdown
      hasField = 0
      udtOffset = 0
      targetType = vDataType
      currUdtIndex = symbols(vIdx).UDTIndex

      tempFieldSize = 0
      tempIsDynamicString = 0
      isFixedUdtString = 0

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          hasField = 1
          tokIdx = tokIdx + 1
          IF tokIdx > endIdx THEN
            throwCompilerError "EXPECTED FIELD NAME", ASIS, 0
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
          fieldName$ = UCASE$(lineTokens$(tokIdx))
          tokIdx = tokIdx + 1

          IF targetType <> TYPE_UDT THEN
            throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF

          fieldFound = 0

          IF findUdtFieldIndex(currUdtIndex, fieldName$) THEN
            iField = returnedData2
            udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
            targetType = udtFields(currUdtIndex, iField).DataType
            tempFieldSize = udtFields(currUdtIndex, iField).Size
            tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
            currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
            fieldFound = 1
          END IF

          IF fieldFound = 0 THEN
            IF findUdtFieldIndex(currUdtIndex, fieldName$ + "$") THEN
              iField = returnedData2
              IF udtFields(currUdtIndex, iField).DataType = TYPE_STRING THEN
                udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
                targetType = udtFields(currUdtIndex, iField).DataType
                tempFieldSize = udtFields(currUdtIndex, iField).Size
                tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
                currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
                fieldFound = 1
              END IF
            END IF
          END IF

          IF fieldFound = 0 THEN
            throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      IF targetType = TYPE_STRING AND hasField = 1 THEN
        IF tempIsDynamicString = 0 THEN
          isFixedUdtString = 1
        END IF
      END IF

      ff = verifyNoExtraTokens(endIdx, tokIdx - 1, "FACTOR")
      IF ff = 0 THEN
        tiraParseFactor$ = ""
        return3 0
        return2 0
        EXIT FUNCTION
      END IF

      ' Route bare array identifiers to evaluate gracefully to their 32-byte descriptor pointer for parameter passing
      IF symbols(vIdx).IsArray > 0 THEN
        resVar$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADDRESS_OF, resVar$, "#" + LTRIM$(STR$(vIdx)), ""
        targetType = TYPE_INTEGER64
      ELSE
        resVar$ = tiraDimVar$("T", targetType)

        IF hasField = 0 THEN
          tiraAssign resVar$, "#" + LTRIM$(STR$(vIdx))
          IF targetType = TYPE_STRING THEN
            skipNullLbl$ = tiraLabelCreateNew$("SKIP_NULL")
            tiraJmpCond "JNE", resVar$, "0", skipNullLbl$
            tiraAssign resVar$, "!G_SYS_DSC_EMPTY"
            tiraLabel skipNullLbl$
          END IF
        ELSE
          finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), "", udtOffset)
          IF finalAddr$ = "" THEN
            tiraParseFactor$ = ""
            return3 0
            return2 0
            EXIT FUNCTION
          END IF

          IF isFixedUdtString = 1 THEN
            ' Sythesize a dynamic descriptor representing the fixed data block so functions can process the string natively
            resVar$ = tiraResolveHoistVar$("FSTR", "_DSC")
            descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraAssign descPtr$, resVar$
            tiraBuildStrDesc descPtr$, finalAddr$, LTRIM$(STR$(tempFieldSize)), "0"
          ELSE
            tiraNew TC_READ_MEM, resVar$ + ", " + finalAddr$
            IF targetType = TYPE_STRING THEN
              skipNullLbl$ = tiraLabelCreateNew$("SKIP_NULL")
              tiraJmpCond "JNE", resVar$, "0", skipNullLbl$
              tiraAssign resVar$, "!G_SYS_DSC_EMPTY"
              tiraLabel skipNullLbl$
            END IF
          END IF
        END IF
      END IF

      exprIs.DataType = targetType
      exprIs.IsTemp = 0
      return3 hasField
      return2 vIdx
      tiraParseFactor$ = resVar$
      EXIT FUNCTION
    END IF
  END IF

  throwCompilerError "MALFORMED EXPRESSION FACTOR (Missing hoist?)", ASIS, 0
  return3 0
  return2 0
  tiraParseFactor$ = ""

END FUNCTION ' tiraParseFactor$

''''''''''''''''''''''''
FUNCTION tiraParseFactorId (startIdx, endIdx, allowImplicit)

  returnExtraPrepare

  tiraCheckActive ("tiraParseFactorId")

  returnAddrVar = ""
  tiraParsedArgType = TIRA_ARG_EMPTY
  tiraParsedArgVal = 0
  tiraParsedAddrType = TIRA_ARG_EMPTY
  tiraParsedAddrVal = 0

  DIM tVal AS LONG
  DIM vIdx AS LONG
  DIM vDataType AS LONG
  DIM firstChar AS STRING * 1
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tokIdx AS LONG
  DIM resVarIdx AS LONG
  DIM currUdtIndex AS LONG
  DIM tempFieldSize AS LONG
  DIM tempIsDynamicString AS LONG
  DIM isFixedUdtString AS LONG
  DIM descPtrIdx AS LONG
  DIM finalAddrIdx AS LONG
  DIM skipNullLblIdx AS LONG
  DIM emptyDescIdx AS LONG
  DIM subIdx AS LONG
  DIM retVarIdx AS LONG
  DIM resType AS LONG
  DIM targetType AS LONG
  DIM callFuncIdx AS LONG

  DIM isFound AS LONG
  DIM conflictIdx AS LONG
  DIM suffix$
  DIM baseName$
  DIM existingName$
  DIM lastTwo$

  DIM literalText$
  DIM lastTwoFactor$
  DIM lastChFactor$
  DIM isDoubleLit AS LONG
  DIM hexAscii AS LONG
  DIM hexCount AS LONG
  DIM hexDigit AS LONG
  DIM hexHighDigit AS LONG
  DIM hexLowValue AS _INTEGER64
  DIM hexPlaceValue AS _INTEGER64
  DIM hexStart AS LONG

  '''' Literals
  IF startIdx = endIdx THEN
    tVal = lineTokenVals(startIdx)
    IF tVal = 0 THEN
      firstChar = LEFT$(lineTokens$(startIdx), 1)
      IF firstChar = CHR$(34) THEN
        literalText$ = extractQuotes$(lineTokens$(startIdx))
        ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
        t.TiraVarCounter = t.TiraVarCounter + 1

        ' Ordinary program literals must not enter the generated-ID range reserved
        ' for runtime helpers. Fail this factor before using the resolved symbol.
        IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
          throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
          tiraParseFactorId = 0
          return3 0
          return2 0
          EXIT FUNCTION
        END IF

        IF ff = 1 THEN
          vIdx = returnedData2
          strVarData$(vIdx) = literalText$
          exprIs.DataType = TYPE_STRING
          exprIs.IsTemp = 0
          tiraParsedArgType = TIRA_ARG_SYMBOL
          tiraParsedArgVal = vIdx
          return3 1 ' isComplex (Prevents ref write-back)
          return2 vIdx
          tiraParseFactorId = 1
          EXIT FUNCTION
        END IF
        tiraParseFactorId = 0
        return3 0
        return2 0
        EXIT FUNCTION
      ELSE
        IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR (firstChar = "&" AND (UCASE$(MID$(lineTokens$(startIdx), 2, 1)) = "H" OR UCASE$(MID$(lineTokens$(startIdx), 2, 1)) = "O")) THEN
          IF LEN(lineTokens$(startIdx)) >= 2 THEN
            lastTwoFactor$ = RIGHT$(lineTokens$(startIdx), 2)
          ELSE
            lastTwoFactor$ = ""
          END IF

          IF lastTwoFactor$ = "~&" THEN
            exprIs.DataType = TYPE_ULONG
          ELSE
            lastChFactor$ = RIGHT$(lineTokens$(startIdx), 1)

            SELECT CASE lastChFactor$

              CASE "~"
                exprIs.DataType = TYPE_ULONG

              CASE "!"
                exprIs.DataType = TYPE_SINGLE

              CASE "#"
                exprIs.DataType = TYPE_DOUBLE

              CASE "&"
                exprIs.DataType = TYPE_LONG

              CASE ELSE
                IF INSTR(lineTokens$(startIdx), ".") > 0 THEN
                  IF expectedSymType = TYPE_DOUBLE THEN
                    exprIs.DataType = TYPE_DOUBLE
                  ELSE
                    exprIs.DataType = TYPE_SINGLE
                  END IF
                ELSE
                  exprIs.DataType = TYPE_LONG
                END IF

            END SELECT ' lastChFactor$
          END IF

          IF exprIs.DataType = TYPE_SINGLE OR exprIs.DataType = TYPE_DOUBLE THEN
            isDoubleLit = 0
            IF exprIs.DataType = TYPE_DOUBLE THEN isDoubleLit = 1

            ff = resolveSymbol("!C_PRS_VAL_FLT_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
            t.TiraVarCounter = t.TiraVarCounter + 1

            IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
              throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
              tiraParseFactorId = 0
              return3 0
              return2 0
              EXIT FUNCTION
            END IF

            IF ff = 0 THEN
              tiraParseFactorId = 0
              return3 0
              return2 0
              EXIT FUNCTION
            END IF

            vIdx = returnedData2
            IF isDoubleLit = 1 THEN
              symbols(vIdx).DataType = TYPE_DOUBLE
            ELSE
              symbols(vIdx).DataType = TYPE_SINGLE
            END IF
            floatVarData(vIdx) = VAL(lineTokens$(startIdx))
            tiraParsedArgType = TIRA_ARG_SYMBOL
            tiraParsedArgVal = vIdx
          ELSE
            IF firstChar = "&" AND UCASE$(MID$(lineTokens$(startIdx), 2, 1)) = "H" THEN
              hexStart = 3

              DO WHILE hexStart <= LEN(lineTokens$(startIdx))
                IF MID$(lineTokens$(startIdx), hexStart, 1) = "0" THEN
                  hexStart = hexStart + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              hexCount = LEN(lineTokens$(startIdx)) - hexStart + 1

              IF hexCount > 16 THEN
                throwCompilerError "HEX LITERAL OUT OF 64-BIT RANGE", ASIS, 0
                tiraParseFactorId = 0
                return3 0
                return2 0
                EXIT FUNCTION
              END IF

              hexLowValue = 0
              hexHighDigit = 0

              FOR ii = hexStart TO LEN(lineTokens$(startIdx))
                hexAscii = ASC(lineTokens$(startIdx), ii)

                IF hexAscii >= 48 AND hexAscii <= 57 THEN
                  hexDigit = hexAscii - 48
                ELSE
                  IF hexAscii >= 65 AND hexAscii <= 70 THEN
                    hexDigit = hexAscii - 55
                  ELSE
                    IF hexAscii >= 97 AND hexAscii <= 102 THEN
                      hexDigit = hexAscii - 87
                    ELSE
                      throwCompilerError "INVALID HEX LITERAL", ASIS, 0
                      tiraParseFactorId = 0
                      return3 0
                      return2 0
                      EXIT FUNCTION
                    END IF
                  END IF
                END IF

                IF hexCount = 16 AND ii = hexStart THEN
                  hexHighDigit = hexDigit
                ELSE
                  hexLowValue = (hexLowValue * 16) + hexDigit
                END IF
              NEXT ii

              IF hexCount = 16 THEN
                hexPlaceValue = 1

                FOR ii = 1 TO 15
                  hexPlaceValue = hexPlaceValue * 16
                NEXT ii

                IF hexHighDigit >= 8 THEN
                  tiraParsedArgVal = ((hexHighDigit - 16) * hexPlaceValue) + hexLowValue
                ELSE
                  tiraParsedArgVal = (hexHighDigit * hexPlaceValue) + hexLowValue
                END IF
              ELSE
                tiraParsedArgVal = hexLowValue
              END IF

              tiraParsedArgType = TIRA_ARG_LITERAL
            ELSE
              tiraParsedArgType = TIRA_ARG_LITERAL
              tiraParsedArgVal = VAL(lineTokens$(startIdx))
            END IF
          END IF

          exprIs.IsTemp = 0
          return3 1 ' isComplex (Prevents ref write-back)
          return2 -1
          tiraParseFactorId = 1
          EXIT FUNCTION
        END IF
      END IF
    END IF
  END IF

  '''' Identifiers (Scalars and UDT fields only. Parens, arrays, funcs natively stripped out via tiraParseExpression$)
  vTok$ = lineTokens$(startIdx)
  IF lineTokenVals(startIdx) = 0 AND LEN(vTok$) > 0 THEN
    firstChar = LEFT$(vTok$, 1)
    IF (firstChar >= "A" AND firstChar <= "Z") OR (firstChar >= "a" AND firstChar <= "z") OR firstChar = "!" THEN

      vName$ = UCASE$(vTok$)
      tokIdx = startIdx + 1

      '''' Legacy dot variable check
      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          IF findSymbol(vName$) THEN
            IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
          END IF
          IF cm.ClassicMode = 1 THEN
            IF tokIdx + 1 <= endIdx THEN
              vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
              tokIdx = tokIdx + 2
            ELSE
              EXIT DO
            END IF
          ELSE
            throwCompilerErrorAndCancelTira "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
            addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      isFound = 0
      IF findSymbol(vName$) THEN
        vIdx = returnedData2
        vDataType = symbols(vIdx).DataType
        isFound = 1
      ELSE
        ' Fallback for string strictness mapping
        suffix$ = RIGHT$(vName$, 1)
        IF suffix$ = "$" THEN
          baseName$ = LEFT$(vName$, LEN(vName$) - 1)
          IF findSymbol(baseName$) THEN
            conflictIdx = returnedData2
            existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

            IF cm.ClassicMode = 1 THEN
              IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                vIdx = conflictIdx
                vDataType = symbols(vIdx).DataType
                isFound = 1
              END IF
            ELSE
              IF cm.StringStrict = 0 THEN
                IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                  vIdx = conflictIdx
                  vDataType = symbols(vIdx).DataType
                  isFound = 1
                ELSE
                  throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                  tiraParseFactorId = 0
                  return3 0
                  return2 0
                  EXIT FUNCTION
                END IF
              ELSE
                IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                  throwCompilerError "VARIABLE NAME CONFLICT: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                ELSE
                  throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                END IF
                tiraParseFactorId = 0
                return3 0
                return2 0
                EXIT FUNCTION
              END IF
            END IF
          END IF
        ELSE
          lastTwo$ = RIGHT$(vName$, 2)
          IF lastTwo$ <> "~&" THEN
            IF suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "!" AND suffix$ <> "#" AND suffix$ <> "~" THEN
              IF findSymbol(vName$ + "$") THEN
                conflictIdx = returnedData2
                existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

                IF cm.ClassicMode = 1 THEN
                  IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                    vIdx = conflictIdx
                    vDataType = symbols(vIdx).DataType
                    isFound = 1
                  END IF
                ELSE
                  IF cm.StringStrict = 0 THEN
                    IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                      vIdx = conflictIdx
                      vDataType = symbols(vIdx).DataType
                      isFound = 1
                    ELSE
                      throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                      tiraParseFactorId = 0
                      return3 0
                      return2 0
                      EXIT FUNCTION
                    END IF
                  ELSE
                    IF symbols(conflictIdx).DataType = TYPE_STRING THEN
                      throwCompilerError "VARIABLE NAME CONFLICT: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                    ELSE
                      throwCompilerError "VARIABLE NAME CONFLICT: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + vName$, ASIS, 0
                    END IF
                    tiraParseFactorId = 0
                    return3 0
                    return2 0
                    EXIT FUNCTION
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isFound = 1 THEN
        IF allowImplicit = 0 THEN
          IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
            throwCompilerError "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        END IF
      ELSE
        IF allowImplicit = 0 THEN
          throwCompilerError "UNDECLARED VARIABLE '" + vName$ + "'", ASIS, 0
          tiraParseFactorId = 0
          return3 0
          return2 0
          EXIT FUNCTION
        ELSE
          ff = resolveSymbol(vName$)
          IF ff = 0 THEN
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
          vIdx = returnedData2
          vDataType = returnedData3
        END IF
      END IF

      IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
        IF symbols(vIdx).SubIndex = 0 THEN
          IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
            throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        END IF
      END IF

      ' Bare zero-argument user functions are valid expression factors without parentheses
      IF symbols(vIdx).SubIndex <> 0 THEN
        subIdx = symbols(vIdx).SubIndex
        IF subs(subIdx).IsFunction = 1 AND subs(subIdx).ArgCount = 0 THEN
          IF currentSubName$ <> RTRIM$(subs(subIdx).RecordName) THEN
            callFuncIdx = vIdx
            tiraCallId0 callFuncIdx

            retVarIdx = subs(subIdx).ReturnVarIdx
            resType = symbols(retVarIdx).DataType
            resVarIdx = tiraDimVarId&("T", resType)
            tiraGetRetId resVarIdx

            exprIs.DataType = resType
            exprIs.IsTemp = 1
            tiraParsedArgType = TIRA_ARG_SYMBOL
            tiraParsedArgVal = resVarIdx
            return3 1
            return2 -1
            tiraParseFactorId = 1
            EXIT FUNCTION
          END IF
        END IF
      END IF

      '''' Real UDT member check iterative walkdown
      hasField = 0
      udtOffset = 0
      targetType = vDataType
      currUdtIndex = symbols(vIdx).UDTIndex

      tempFieldSize = 0
      tempIsDynamicString = 0
      isFixedUdtString = 0

      DO WHILE tokIdx <= endIdx
        IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
          hasField = 1
          tokIdx = tokIdx + 1
          IF tokIdx > endIdx THEN
            throwCompilerError "EXPECTED FIELD NAME", ASIS, 0
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
          fieldName$ = UCASE$(lineTokens$(tokIdx))
          tokIdx = tokIdx + 1

          IF targetType <> TYPE_UDT THEN
            throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF

          fieldFound = 0

          IF findUdtFieldIndex(currUdtIndex, fieldName$) THEN
            iField = returnedData2
            udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
            targetType = udtFields(currUdtIndex, iField).DataType
            tempFieldSize = udtFields(currUdtIndex, iField).Size
            tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
            currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
            fieldFound = 1
          END IF

          IF fieldFound = 0 THEN
            IF findUdtFieldIndex(currUdtIndex, fieldName$ + "$") THEN
              iField = returnedData2
              IF udtFields(currUdtIndex, iField).DataType = TYPE_STRING THEN
                udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
                targetType = udtFields(currUdtIndex, iField).DataType
                tempFieldSize = udtFields(currUdtIndex, iField).Size
                tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
                currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
                fieldFound = 1
              END IF
            END IF
          END IF

          IF fieldFound = 0 THEN
            throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP

      IF targetType = TYPE_STRING AND hasField = 1 THEN
        IF tempIsDynamicString = 0 THEN
          isFixedUdtString = 1
        END IF
      END IF

      ff = verifyNoExtraTokens(endIdx, tokIdx - 1, "FACTOR")
      IF ff = 0 THEN
        tiraParseFactorId = 0
        return3 0
        return2 0
        EXIT FUNCTION
      END IF

      ' Route bare array identifiers to evaluate gracefully to their 32-byte descriptor pointer for parameter passing
      IF symbols(vIdx).IsArray > 0 THEN
        resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
        targetType = TYPE_INTEGER64
      ELSE
        resVarIdx = tiraDimVarId&("T", targetType)

        IF hasField = 0 THEN
          tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, vIdx
          IF targetType = TYPE_STRING THEN
            skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
            tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipNullLblIdx
            ff = resolveSymbol("!G_SYS_DSC_EMPTY")
            emptyDescIdx = returnedData2
            tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, emptyDescIdx
            tiraLabelId skipNullLblIdx
          END IF
        ELSE
          finalAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, 0, udtOffset)
          IF compileError = 1 THEN
            tiraParseFactorId = 0
            return3 0
            return2 0
            EXIT FUNCTION
          END IF

          tiraParsedAddrType = TIRA_ARG_SYMBOL
          tiraParsedAddrVal = finalAddrIdx

          IF isFixedUdtString = 1 THEN
            ' Sythesize a dynamic descriptor representing the fixed data block so functions can process the string natively
            resVarIdx = tiraResolveHoistVarId&("FSTR", "_DSC")
            IF compileError = 1 THEN
              tiraParseFactorId = 0
              return3 0
              return2 0
              EXIT FUNCTION
            END IF
            descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, resVarIdx
            tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, tempFieldSize, TIRA_ARG_LITERAL, 0
          ELSE
            tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, finalAddrIdx
            IF targetType = TYPE_STRING THEN
              skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
              tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipNullLblIdx
              ff = resolveSymbol("!G_SYS_DSC_EMPTY")
              emptyDescIdx = returnedData2
              tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, emptyDescIdx
              tiraLabelId skipNullLblIdx
            END IF
          END IF
        END IF
      END IF

      exprIs.DataType = targetType
      exprIs.IsTemp = 0
      tiraParsedArgType = TIRA_ARG_SYMBOL
      tiraParsedArgVal = resVarIdx
      return3 hasField
      return2 vIdx
      tiraParseFactorId = 1
      EXIT FUNCTION
    END IF
  END IF

  throwCompilerError "MALFORMED EXPRESSION FACTOR (Missing hoist?)", ASIS, 0
  return3 0
  return2 0
  tiraParseFactorId = 0

END FUNCTION ' tiraParseFactorId

''''''''''''''''''''''''
FUNCTION tiraParseRhsUdtBase$ (startTokIdx, exprEndBoundary, passLhsUdtIndex)

  DIM rhsTokIdx AS LONG
  DIM rhsName$
  DIM rhsIdx AS LONG
  DIM rhsHasIndex AS LONG
  DIM rhsCloseParenIdx AS LONG
  DIM rhsUdtOffset AS LONG
  DIM rhsUdtIndex AS LONG
  DIM isRhsUdtFound AS LONG
  DIM rhsFieldName$
  DIM rUIdx AS LONG
  DIM rFieldFound AS LONG
  DIM iField AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempBase$
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  tiraCheckActive ("tiraParseRhsUdtBase$")

  rhsTokIdx = startTokIdx
  IF rhsTokIdx > exprEndBoundary THEN
    throwCompilerErrorAndCancelTira "EXPECTED UDT VARIABLE", ASIS, 0
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF

  rhsName$ = UCASE$(lineTokens$(rhsTokIdx))
  symbolCountBefore = symbolCount
  ff = resolveSymbol(rhsName$)
  IF ff = 0 THEN
    tira_Cancel
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF
  rhsIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  rhsTokIdx = rhsTokIdx + 1
  rhsHasIndex = 0
  rhsCloseParenIdx = 0

  indicesStr$ = ""
  numParsedIndices = 0

  IF rhsTokIdx <= exprEndBoundary THEN
    IF lineTokenVals(rhsTokIdx) = 256 + ASC("(") THEN
      rhsHasIndex = 1
      indicesStr$ = tiraParseArrayArgs$(rhsTokIdx, exprEndBoundary, 0)
      IF indicesStr$ = "" AND compileError = 1 THEN
        tiraParseRhsUdtBase$ = ""
        EXIT FUNCTION
      END IF
      rhsCloseParenIdx = returnedData2
      numParsedIndices = returnedData3
      rhsTokIdx = rhsCloseParenIdx + 1
    END IF
  END IF

  ff = validateSymbolArrayScalar(rhsIdx, rhsName$, rhsHasIndex, wasNewSymbol, 0, 1)
  IF ff = 0 THEN
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF

  rhsUdtOffset = 0
  rhsUdtIndex = 0
  isRhsUdtFound = 0

  IF symbols(rhsIdx).DataType = TYPE_UDT THEN
    rhsUdtIndex = symbols(rhsIdx).UDTIndex
    isRhsUdtFound = 1
  END IF

  DO WHILE rhsTokIdx <= exprEndBoundary
    IF lineTokenVals(rhsTokIdx) = 256 + ASC(".") THEN
      rhsTokIdx = rhsTokIdx + 1
      IF rhsTokIdx > exprEndBoundary THEN
        throwCompilerErrorAndCancelTira "EXPECTED FIELD NAME", ASIS, 0
        tiraParseRhsUdtBase$ = ""
        EXIT FUNCTION
      END IF

      rhsFieldName$ = UCASE$(lineTokens$(rhsTokIdx))
      rhsTokIdx = rhsTokIdx + 1

      IF isRhsUdtFound = 0 THEN
        throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
        tiraParseRhsUdtBase$ = ""
        EXIT FUNCTION
      END IF

      rFieldFound = 0

      IF findUdtFieldIndex(rhsUdtIndex, rhsFieldName$) THEN
        iField = returnedData2
        rhsUdtOffset = rhsUdtOffset + udtFields(rhsUdtIndex, iField).Offset
        IF udtFields(rhsUdtIndex, iField).DataType <> TYPE_UDT THEN
          isRhsUdtFound = 0
        ELSE
          rhsUdtIndex = udtFields(rhsUdtIndex, iField).UDTIndex
        END IF
        rFieldFound = 1
      END IF

      IF rFieldFound = 0 THEN
        throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
        tiraParseRhsUdtBase$ = ""
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  IF isRhsUdtFound = 0 THEN
    throwCompilerErrorAndCancelTira "RHS MUST BE A UDT", ASIS, 0
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF

  IF rhsUdtIndex <> passLhsUdtIndex THEN
    throwCompilerErrorAndCancelTira "UDT TYPE MISMATCH", ASIS, 0
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF

  IF rhsHasIndex = 1 THEN
    IF symbols(rhsIdx).IsArray = 0 THEN
      throwCompilerErrorAndCancelTira "ARRAY NOT DIMMED", ASIS, 0
      tiraParseRhsUdtBase$ = ""
      EXIT FUNCTION
    END IF
    IF symbols(rhsIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(rhsIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  tempBase$ = tiraFrontendCalcAddress$(RTRIM$(symbols(rhsIdx).RecordName), indicesStr$, rhsUdtOffset)
  IF tempBase$ = "" THEN
    tira_Cancel
    tiraParseRhsUdtBase$ = ""
    EXIT FUNCTION
  END IF

  tiraParseRhsUdtBase$ = tempBase$

END FUNCTION ' tiraParseRhsUdtBase$

''''''''''''''''''''''''
SUB tiraOp (opConst AS LONG, destOrIAT$, src1$, src2$)

  tiraCheckActive ("tiraOp")
  IF tiraLineCheck THEN EXIT SUB

  tiraClearArgs ' Unknown number of args used at this point, so clear them all

  SELECT CASE opConst

    CASE TC_ADD, TC_SUB, TC_MUL, TC_DIV, TC_IDIV, TC_MOD, TC_AND, TC_OR, TC_XOR, TC_NOR, TC_NAND, TC_XNOR, TC_POW, TC_CONCAT, TC_SHL, TC_SHR, TC_SAR, TC_NEG, TC_NOT, TC_CALL, TC_ADDRESS_OF, TC_CAST, TC_COMPARE, TC_TEST, TC_JCC, TC_LEA_SIB
      ' Valid
    CASE ELSE
      throwCompilerError "UNKNOWN OR UNSUPPORTED TIRA CONSTANT IN OP", ASIS, 0
      EXIT SUB

  END SELECT ' opConst

  tiraNode(t.LineCount).OpCode = opConst
  tiraSetNodeArg 1, destOrIAT$

  SELECT CASE opConst

    CASE TC_NEG, TC_NOT, TC_COMPARE, TC_TEST, TC_JCC
      tiraSetNodeArg 2, src1$

    CASE TC_CALL
      IF src1$ = "0" OR src1$ = "" THEN
        tiraSetNodeArg 2, "0"
      ELSE
        tiraSetNodeArg 2, src1$
        tiraSetNodeArg 3, src2$
      END IF

    CASE ELSE
      tiraSetNodeArg 2, src1$
      tiraSetNodeArg 3, src2$

  END SELECT ' opConst

  t.LineCount = t.LineCount + 1

END SUB ' tiraOp

