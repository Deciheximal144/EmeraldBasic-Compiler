SUB tiraCallShuntId (funcVal AS LONG, argCount AS LONG, baseArgIdx AS LONG)

  tiraCheckActive ("tiraCallShuntId")
  IF tiraLineCheck THEN EXIT SUB

  IF argCount < 0 OR argCount > 16 THEN
    throwCompilerError "INVALID TIRA CALL ARG COUNT", ASIS, 0
    EXIT SUB
  END IF

  IF baseArgIdx < 0 OR baseArgIdx + argCount > MAX_SHUNT + 1 THEN
    throwCompilerError "INVALID TIRA CALL ARG RANGE", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_CALL

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_SYMBOL
  tiraNode(t.LineCount).Arg1Val = funcVal

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg2Val = argCount

  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  IF argCount > 0 THEN
    FOR argIdx = 0 TO argCount - 1
      tiraCallArg(t.LineCount, argIdx).ArgType = shuntVal(baseArgIdx + argIdx).ArgType
      tiraCallArg(t.LineCount, argIdx).ArgVal = shuntVal(baseArgIdx + argIdx).ArgVal
    NEXT
  END IF

  t.LineCount = t.LineCount + 1

END SUB ' tiraCallShuntId

''''''''''''''''''''''''
FUNCTION tiraCaptureExpressionArgId (argStr$)

  DIM firstChar AS STRING * 1
  DIM lastCh$
  DIM isDoubleLit AS LONG
  DIM lit$
  DIM vIdx AS LONG
  DIM hexAscii AS LONG
  DIM hexCount AS LONG
  DIM hexDigit AS LONG
  DIM hexHighDigit AS LONG
  DIM hexLowValue AS _INTEGER64
  DIM hexPlaceValue AS _INTEGER64
  DIM hexStart AS LONG

  tiraParsedArgType = TIRA_ARG_EMPTY
  tiraParsedArgVal = 0

  IF argStr$ = "" THEN
    tiraCaptureExpressionArgId = 0
    EXIT FUNCTION
  END IF

  firstChar = LEFT$(argStr$, 1)

  IF firstChar = "@" OR firstChar = "%" THEN
    ff = resolveSymbol(argStr$)
    IF ff = 1 THEN
      tiraParsedArgType = TIRA_ARG_LABEL
      tiraParsedArgVal = returnedData2
    END IF
  ELSE
    IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR firstChar = CHR$(34) OR (firstChar = "&" AND (UCASE$(MID$(argStr$, 2, 1)) = "H" OR UCASE$(MID$(argStr$, 2, 1)) = "O")) THEN
      IF firstChar = CHR$(34) THEN
        lit$ = extractQuotes$(argStr$)
        ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
        t.TiraVarCounter = t.TiraVarCounter + 1

        IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
          throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
          tiraCaptureExpressionArgId = 0
          EXIT FUNCTION
        END IF

        IF ff = 1 THEN
          vIdx = returnedData2
          strVarData$(vIdx) = lit$
          tiraParsedArgType = TIRA_ARG_SYMBOL
          tiraParsedArgVal = vIdx
        END IF
      ELSE
        lastCh$ = RIGHT$(argStr$, 1)
        IF INSTR(argStr$, ".") > 0 OR lastCh$ = "#" OR lastCh$ = "!" THEN
          isDoubleLit = 0
          IF lastCh$ = "#" THEN isDoubleLit = 1

          ff = resolveSymbol("!C_PRS_VAL_FLT_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
          t.TiraVarCounter = t.TiraVarCounter + 1

          IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
            throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
            tiraCaptureExpressionArgId = 0
            EXIT FUNCTION
          END IF

          IF ff = 1 THEN
            vIdx = returnedData2
            IF isDoubleLit = 1 THEN
              symbols(vIdx).DataType = TYPE_DOUBLE
            ELSE
              symbols(vIdx).DataType = TYPE_SINGLE
            END IF
            floatVarData(vIdx) = VAL(argStr$)
            tiraParsedArgType = TIRA_ARG_SYMBOL
            tiraParsedArgVal = vIdx
          END IF
        ELSE
          IF firstChar = "&" AND UCASE$(MID$(argStr$, 2, 1)) = "H" THEN
            hexStart = 3

            DO WHILE hexStart <= LEN(argStr$)
              IF MID$(argStr$, hexStart, 1) = "0" THEN
                hexStart = hexStart + 1
              ELSE
                EXIT DO
              END IF
            LOOP

            hexCount = LEN(argStr$) - hexStart + 1

            IF hexCount > 16 THEN
              throwCompilerError "HEX LITERAL OUT OF 64-BIT RANGE", ASIS, 0
              tiraCaptureExpressionArgId = 0
              EXIT FUNCTION
            END IF

            hexLowValue = 0
            hexHighDigit = 0

            FOR ii = hexStart TO LEN(argStr$)
              hexAscii = ASC(argStr$, ii)

              IF hexAscii >= 48 AND hexAscii <= 57 THEN
                hexDigit = hexAscii - 48
              ELSE
                IF hexAscii >= 65 AND hexAscii <= 70 THEN
                  hexDigit = hexAscii - 55
                ELSE
                  IF hexAscii >= 97 AND hexAscii <= 102 THEN
                    hexDigit = hexAscii - 87
                  ELSE
                    throwCompilerError "INVALID HEX LITERAL", ASIS, 0
                    tiraCaptureExpressionArgId = 0
                    EXIT FUNCTION
                  END IF
                END IF
              END IF

              IF hexCount = 16 AND ii = hexStart THEN
                hexHighDigit = hexDigit
              ELSE
                hexLowValue = (hexLowValue * 16) + hexDigit
              END IF
            NEXT ii

            IF hexCount = 16 THEN
              hexPlaceValue = 1

              FOR ii = 1 TO 15
                hexPlaceValue = hexPlaceValue * 16
              NEXT ii

              IF hexHighDigit >= 8 THEN
                tiraParsedArgVal = ((hexHighDigit - 16) * hexPlaceValue) + hexLowValue
              ELSE
                tiraParsedArgVal = (hexHighDigit * hexPlaceValue) + hexLowValue
              END IF
            ELSE
              tiraParsedArgVal = hexLowValue
            END IF

            tiraParsedArgType = TIRA_ARG_LITERAL
          ELSE
            tiraParsedArgType = TIRA_ARG_LITERAL
            tiraParsedArgVal = VAL(argStr$)
          END IF
        END IF
      END IF
    ELSE
      IF firstChar = "#" THEN
        tiraParsedArgType = TIRA_ARG_SYMBOL
        tiraParsedArgVal = VAL(MID$(argStr$, 2))
      ELSE
        ff = resolveSymbol(argStr$)
        IF ff = 1 THEN
          tiraParsedArgType = TIRA_ARG_SYMBOL
          tiraParsedArgVal = returnedData2
        END IF
      END IF
    END IF
  END IF

  IF tiraParsedArgType = TIRA_ARG_EMPTY THEN
    tiraCaptureExpressionArgId = 0
  ELSE
    tiraCaptureExpressionArgId = 1
  END IF

END FUNCTION ' tiraCaptureExpressionArgId

''''''''''''''''''''''''
SUB tiraCheckActive (callerName$)

  IF t.IsActive <> 1 THEN
    throwCompilerError callerName$ + ": TIRA NOT VALUE 1, NO tira_Start CALL", ASIS, 0
  END IF

END SUB ' tiraCheckActive

''''''''''''''''''''''''
SUB tiraClamp (varToClamp$, minStr$, maxStr$)

  tiraCheckActive ("tiraClamp")
  IF tiraLineCheck THEN EXIT SUB

  IF minStr$ <> "" THEN
    skipMinLbl$ = tiraLabelCreateNew$("CLAMP_MIN")
    tiraJmpCond "JGE", varToClamp$, minStr$, skipMinLbl$
    tiraAssign varToClamp$, minStr$
    tiraLabel skipMinLbl$
  END IF

  IF maxStr$ <> "" THEN
    skipMaxLbl$ = tiraLabelCreateNew$("CLAMP_MAX")
    tiraJmpCond "JLE", varToClamp$, maxStr$, skipMaxLbl$
    tiraAssign varToClamp$, maxStr$
    tiraLabel skipMaxLbl$
  END IF

END SUB ' tiraClamp

''''''''''''''''''''''''
SUB tiraClampId (varVal AS LONG, minType AS LONG, minVal AS _INTEGER64, maxType AS LONG, maxVal AS _INTEGER64)

  tiraCheckActive ("tiraClampId")
  IF tiraLineCheck THEN EXIT SUB

  DIM skipMinLblIdx AS LONG
  DIM skipMaxLblIdx AS LONG

  IF minType <> TIRA_ARG_EMPTY THEN
    skipMinLblIdx = tiraLabelCreateNewId&("CLAMP_MIN")
    tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, varVal, minType, minVal, skipMinLblIdx
    tiraAssignId varVal, minType, minVal
    tiraLabelId skipMinLblIdx
  END IF

  IF maxType <> TIRA_ARG_EMPTY THEN
    skipMaxLblIdx = tiraLabelCreateNewId&("CLAMP_MAX")
    tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, varVal, maxType, maxVal, skipMaxLblIdx
    tiraAssignId varVal, maxType, maxVal
    tiraLabelId skipMaxLblIdx
  END IF

END SUB ' tiraClampId

