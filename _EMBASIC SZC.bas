''''''''''''''''''''''''
SUB tiraCopyUdtValueId (destBaseType AS LONG, destBaseVal AS _INTEGER64, srcBaseType AS LONG, srcBaseVal AS _INTEGER64, uIdx AS LONG)

  tiraCheckActive ("tiraCopyUdtValueId")
  IF tiraLineCheck THEN EXIT SUB

  DIM workUdtIndex(MAX_UDTS) AS LONG
  DIM workFieldIndex(MAX_UDTS) AS LONG
  DIM workBaseOffset(MAX_UDTS) AS LONG
  DIM workDepth AS LONG
  DIM currentUdtIndex AS LONG
  DIM currentFieldIndex AS LONG
  DIM nestedUdtIndex AS LONG
  DIM fieldOffset AS LONG
  DIM fieldSize AS LONG
  DIM fieldType AS LONG
  DIM destFieldAddrIdx AS LONG
  DIM srcFieldAddrIdx AS LONG
  DIM srcDescPtrIdx AS LONG
  DIM skipSrcNullLblIdx AS LONG
  DIM emptyDescIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM strAssignIdx AS LONG

  IF uIdx < 0 OR uIdx >= udtCount THEN
    throwCompilerError "INVALID UDT INDEX IN ARGUMENT COPY", ASIS, 0
    EXIT SUB
  END IF

  workDepth = 0
  workUdtIndex(0) = uIdx
  workFieldIndex(0) = 0
  workBaseOffset(0) = 0

  DO WHILE workDepth >= 0
    currentUdtIndex = workUdtIndex(workDepth)
    currentFieldIndex = workFieldIndex(workDepth)

    IF currentFieldIndex >= udts(currentUdtIndex).FieldCount THEN
      workDepth = workDepth - 1
    ELSE
      workFieldIndex(workDepth) = currentFieldIndex + 1

      fieldOffset = workBaseOffset(workDepth) + udtFields(currentUdtIndex, currentFieldIndex).Offset
      fieldSize = udtFields(currentUdtIndex, currentFieldIndex).Size
      fieldType = udtFields(currentUdtIndex, currentFieldIndex).DataType

      IF fieldType = TYPE_UDT THEN
        nestedUdtIndex = udtFields(currentUdtIndex, currentFieldIndex).UDTIndex

        IF nestedUdtIndex < 0 OR nestedUdtIndex >= udtCount THEN
          throwCompilerError "INVALID NESTED UDT INDEX IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        IF workDepth >= MAX_UDTS - 1 THEN
          throwCompilerError "UDT NESTING LIMIT REACHED IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        workDepth = workDepth + 1
        workUdtIndex(workDepth) = nestedUdtIndex
        workFieldIndex(workDepth) = 0
        workBaseOffset(workDepth) = fieldOffset
      ELSE
        destFieldAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destFieldAddrIdx, destBaseType, destBaseVal, TIRA_ARG_LITERAL, fieldOffset

        srcFieldAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcFieldAddrIdx, srcBaseType, srcBaseVal, TIRA_ARG_LITERAL, fieldOffset

        IF fieldType = TYPE_STRING AND udtFields(currentUdtIndex, currentFieldIndex).IsDynamicString = 1 THEN
          srcDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraReadMemId srcDescPtrIdx, TIRA_ARG_SYMBOL, srcFieldAddrIdx

          skipSrcNullLblIdx = tiraLabelCreateNewId&("SKIP_UDT_SRC_NULL")
          tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, srcDescPtrIdx, TIRA_ARG_LITERAL, 0, skipSrcNullLblIdx
          ff = resolveSymbol("!G_SYS_DSC_EMPTY")
          IF ff = 0 THEN EXIT SUB
          emptyDescIdx = returnedData2
          tiraAssignId srcDescPtrIdx, TIRA_ARG_SYMBOL, emptyDescIdx
          tiraLabelId skipSrcNullLblIdx

          destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraReadMemId destDescPtrIdx, TIRA_ARG_SYMBOL, destFieldAddrIdx

          tiraEnsureStringAllocId destDescPtrIdx, TIRA_ARG_SYMBOL, destFieldAddrIdx

          ff = resolveSymbol("RT_STR_ASSIGN")
          IF ff = 0 THEN EXIT SUB
          strAssignIdx = returnedData2
          tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, destDescPtrIdx, TIRA_ARG_SYMBOL, srcDescPtrIdx
        ELSE
          tiraMemcpyId TIRA_ARG_SYMBOL, destFieldAddrIdx, TIRA_ARG_SYMBOL, srcFieldAddrIdx, TIRA_ARG_LITERAL, fieldSize
        END IF
      END IF
    END IF
  LOOP

END SUB ' tiraCopyUdtValueId

''''''''''''''''''''''''
SUB tiraCopyUdtValue (destBase$, srcBase$, uIdx AS LONG)

  tiraCheckActive ("tiraCopyUdtValue")
  IF tiraLineCheck THEN EXIT SUB

  DIM workUdtIndex(MAX_UDTS) AS LONG
  DIM workFieldIndex(MAX_UDTS) AS LONG
  DIM workBaseOffset(MAX_UDTS) AS LONG
  DIM workDepth AS LONG
  DIM currentUdtIndex AS LONG
  DIM currentFieldIndex AS LONG
  DIM nestedUdtIndex AS LONG
  DIM fieldOffset AS LONG
  DIM fieldSize AS LONG
  DIM fieldType AS LONG

  IF uIdx < 0 OR uIdx >= udtCount THEN
    throwCompilerError "INVALID UDT INDEX IN ARGUMENT COPY", ASIS, 0
    EXIT SUB
  END IF

  workDepth = 0
  workUdtIndex(0) = uIdx
  workFieldIndex(0) = 0
  workBaseOffset(0) = 0

  DO WHILE workDepth >= 0
    currentUdtIndex = workUdtIndex(workDepth)
    currentFieldIndex = workFieldIndex(workDepth)

    IF currentFieldIndex >= udts(currentUdtIndex).FieldCount THEN
      workDepth = workDepth - 1
    ELSE
      workFieldIndex(workDepth) = currentFieldIndex + 1

      fieldOffset = workBaseOffset(workDepth) + udtFields(currentUdtIndex, currentFieldIndex).Offset
      fieldSize = udtFields(currentUdtIndex, currentFieldIndex).Size
      fieldType = udtFields(currentUdtIndex, currentFieldIndex).DataType

      IF fieldType = TYPE_UDT THEN
        nestedUdtIndex = udtFields(currentUdtIndex, currentFieldIndex).UDTIndex

        IF nestedUdtIndex < 0 OR nestedUdtIndex >= udtCount THEN
          throwCompilerError "INVALID NESTED UDT INDEX IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        IF workDepth >= MAX_UDTS - 1 THEN
          throwCompilerError "UDT NESTING LIMIT REACHED IN ARGUMENT COPY", ASIS, 0
          EXIT SUB
        END IF

        workDepth = workDepth + 1
        workUdtIndex(workDepth) = nestedUdtIndex
        workFieldIndex(workDepth) = 0
        workBaseOffset(workDepth) = fieldOffset
      ELSE
        destFieldAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADD, destFieldAddr$, destBase$, LTRIM$(STR$(fieldOffset))

        srcFieldAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADD, srcFieldAddr$, srcBase$, LTRIM$(STR$(fieldOffset))

        IF fieldType = TYPE_STRING AND udtFields(currentUdtIndex, currentFieldIndex).IsDynamicString = 1 THEN
          srcDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraNew TC_READ_MEM, srcDescPtr$ + ", " + srcFieldAddr$

          skipSrcNullLbl$ = tiraLabelCreateNew$("SKIP_UDT_SRC_NULL")
          tiraJmpCond "JNE", srcDescPtr$, "0", skipSrcNullLbl$
          tiraAssign srcDescPtr$, "!G_SYS_DSC_EMPTY"
          tiraLabel skipSrcNullLbl$

          destDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraNew TC_READ_MEM, destDescPtr$ + ", " + destFieldAddr$

          tiraEnsureStringAlloc destDescPtr$, destFieldAddr$
          tiraCall "RT_STR_ASSIGN", 2, destDescPtr$ + ", " + srcDescPtr$
        ELSE
          tiraMemcpy destFieldAddr$, srcFieldAddr$, LTRIM$(STR$(fieldSize))
        END IF
      END IF
    END IF
  LOOP

END SUB ' tiraCopyUdtValue

''''''''''''''''''''''''
FUNCTION tiraDimVar$ (baseName$, wDataType AS LONG)

  tiraCheckActive ("tiraDimVar$")

  DIM vIdx AS LONG
  DIM varSize AS LONG
  DIM remainder AS LONG

  SELECT CASE wDataType

    CASE TYPE_STRING: typePrefix$ = "TSTR_"
    CASE TYPE_SINGLE: typePrefix$ = "TSNG_"
    CASE TYPE_DOUBLE: typePrefix$ = "TDBL_"
    CASE TYPE_BYTE: typePrefix$ = "TBYT_"
    CASE TYPE_UBYTE: typePrefix$ = "TUBY_"
    CASE TYPE_INTEGER: typePrefix$ = "TINT_"
    CASE TYPE_UINTEGER: typePrefix$ = "TUIN_"
    CASE TYPE_LONG: typePrefix$ = "TLNG_"
    CASE TYPE_ULONG: typePrefix$ = "TULN_"
    CASE TYPE_INTEGER64: typePrefix$ = "TI64_"
    CASE TYPE_UINT64: typePrefix$ = "TU64_"
    CASE TYPE_UDT: typePrefix$ = "TUDT_"
    CASE ELSE: typePrefix$ = "TUNK_"

  END SELECT ' wDataType

  ' Creates a highly readable, SSA-safe ephemeral variable name strictly bound to its datatype
  ' Segregate Runtime Helper variables into their own namespace to prevent corrupting user code variables
  IF isCompilingRT = 1 THEN
    tempName$ = "!R_" + typePrefix$ + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TempCounter)))
  ELSE
    tempName$ = "!" + typePrefix$ + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TempCounter)))
  END IF
  t.TempCounter = t.TempCounter + 1

  ff = resolveSymbol(tempName$)
  IF ff = 1 THEN
    vIdx = returnedData2
    symbols(vIdx).DataType = wDataType

    ' Automated Local Routing for Runtime Helpers
    IF isCompilingRT = 1 THEN
      symbols(vIdx).IsLocal = LOCAL_ABSOLUTE

      varSize = 8 ' Default fallback

      SELECT CASE wDataType

        CASE TYPE_BYTE, TYPE_UBYTE: varSize = 1
        CASE TYPE_INTEGER, TYPE_UINTEGER: varSize = 2
        CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE: varSize = 4
        CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE, TYPE_STRING: varSize = 8
        CASE TYPE_UDT: varSize = udts(symbols(vIdx).UDTIndex).TotalSize

      END SELECT ' wDataType

      ' Pad the size to an 8-byte boundary to guarantee stack alignment
      remainder = varSize AND 7 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
      IF remainder <> 0 THEN varSize = varSize + (8 - remainder)

      rtFrameSize = rtFrameSize + varSize
      ' -8 offset accounts for the pushed RBX register in TC_ABI_PROLOGUE
      symbols(vIdx).LocalOffset = -8 - rtFrameSize
    END IF
  END IF

  tiraDimVar$ = tempName$

END FUNCTION ' tiraDimVar$

