''''''''''''''''''''''''
FUNCTION tiraResolveHoistVarId& (intrinsicName$, role$)

  tiraCheckActive ("tiraResolveHoistVarId&")

  DIM roleNoUnderscore$
  DIM tempName$
  DIM vIdx AS LONG

  ' Extract the pure three-character hardware role by stripping the leading underscore
  roleNoUnderscore$ = MID$(role$, 2)

  ' Build the global internal variable name using !C to denote a compiler-generated construct
  tempName$ = "!C_EVL_" + roleNoUnderscore$ + "_HOIS" + intrinsicName$ + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))

  ' Increment the global TIRA counter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    tiraResolveHoistVarId& = 0
    EXIT FUNCTION
  END IF

  ' Register this variable name in the global symbol table
  ff = resolveSymbol(tempName$)
  IF ff = 0 THEN
    tira_Cancel
    tiraResolveHoistVarId& = 0
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF currentScopeID > 0 THEN
    symbols(vIdx).IsLocal = LOCAL_STANDARD
  END IF

  tiraResolveHoistVarId& = vIdx

END FUNCTION ' tiraResolveHoistVarId&

''''''''''''''''''''''''
SUB tiraInitClassicImplicitArrays (targetScopeID AS LONG)

  DIM vIdx AS LONG
  DIM isTarget AS LONG
  DIM hasTarget AS LONG
  DIM descriptorByteSize AS LONG
  DIM elemSize AS LONG
  DIM descAddr$
  DIM dataAddr$
  DIM metaValue$

  tiraCheckActive ("tiraInitClassicImplicitArrays")
  IF tiraLineCheck THEN EXIT SUB

  IF cm.ClassicMode = 0 THEN EXIT SUB

  hasTarget = 0
  IF symbolCount > 0 THEN
    FOR vIdx = 0 TO symbolCount - 1
      isTarget = 0

      IF targetScopeID = 0 THEN
        isTarget = 1
        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 0
      ELSE
        IF symbols(vIdx).ScopeID = targetScopeID THEN
          IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 1
        END IF
      END IF

      IF isTarget = 1 THEN
        IF symbols(vIdx).IsArray = ARRAY_KIND_STATIC THEN
          IF symbols(vIdx).IsExplicit = DECL_IMPLICIT OR symbols(vIdx).IsExplicit = DECL_QUIET THEN
            IF symbols(vIdx).NumDimensions > 0 THEN
              hasTarget = 1
              EXIT FOR
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  IF hasTarget = 0 THEN EXIT SUB

  descAddr$ = tiraDimVar$("CLASSIC_ARRAY_DESC", TYPE_INTEGER64)
  dataAddr$ = tiraDimVar$("CLASSIC_ARRAY_DATA", TYPE_INTEGER64)
  metaValue$ = tiraDimVar$("CLASSIC_ARRAY_META", TYPE_LONG)

  FOR vIdx = 0 TO symbolCount - 1
    isTarget = 0

    IF targetScopeID = 0 THEN
      isTarget = 1
      IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 0
    ELSE
      IF symbols(vIdx).ScopeID = targetScopeID THEN
        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 THEN isTarget = 1
      END IF
    END IF

    IF isTarget = 1 THEN
      IF symbols(vIdx).IsArray = ARRAY_KIND_STATIC THEN
        IF symbols(vIdx).IsExplicit = DECL_IMPLICIT OR symbols(vIdx).IsExplicit = DECL_QUIET THEN
          IF symbols(vIdx).NumDimensions > 0 THEN
            descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
            elemSize = retElementByteSize(vIdx)

            tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""
            tiraOp TC_ADD, dataAddr$, descAddr$, LTRIM$(STR$(descriptorByteSize))
            tiraWriteMem descAddr$, dataAddr$, "8"

            tiraAssign metaValue$, LTRIM$(STR$(elemSize))
            tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 8, " + metaValue$ + ", 4"

            tiraAssign metaValue$, LTRIM$(STR$(symbols(vIdx).NumDimensions))
            tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 12, " + metaValue$ + ", 4"

            ' Every implicit dimension has lower bound 0 and element count 11
            ' OPTION BASE 1 changes the implicit lower bound while leaving the upper bound at 10
            FOR iDim = 1 TO symbols(vIdx).NumDimensions
              tiraAssign metaValue$, LTRIM$(STR$(optionBaseValue))
              tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8))) + ", " + metaValue$ + ", 4"

              tiraAssign metaValue$, LTRIM$(STR$(11 - optionBaseValue))
              tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8) + 4)) + ", " + metaValue$ + ", 4"
            NEXT
          END IF
        END IF
      END IF
    END IF
  NEXT

END SUB ' tiraInitClassicImplicitArrays

''''''''''''''''''''''''
SUB tiraInjectPendingDisplayFlush

  tiraCheckActive ("tiraInjectPendingDisplayFlush")
  IF tiraLineCheck THEN EXIT SUB

  IF cm.HasGraphics = 1 THEN
    skipAutoLbl$ = tiraLabelCreateNew$("SKIP_AUTO_FLUSH")
    tiraJmpCond "JE", "!G_GFX_FLG_AUTO", "0", skipAutoLbl$
    tiraCall "RT_AUTODISPLAY_CHECK", 0, ""
    tiraLabel skipAutoLbl$
  END IF

END SUB ' tiraInjectPendingDisplayFlush

''''''''''''''''''''''''
SUB tiraInjectPendingDisplayFlushId

  tiraCheckActive ("tiraInjectPendingDisplayFlushId")
  IF tiraLineCheck THEN EXIT SUB

  DIM autoDisplayIdx AS LONG
  DIM autoDisplayCheckIdx AS LONG
  DIM skipAutoLblIdx AS LONG

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_FLG_AUTO")
    autoDisplayIdx = returnedData2

    ff = resolveSymbol("RT_AUTODISPLAY_CHECK")
    autoDisplayCheckIdx = returnedData2

    skipAutoLblIdx = tiraLabelCreateNewId&("SKIP_AUTO_FLUSH")
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, autoDisplayIdx, TIRA_ARG_LITERAL, 0, skipAutoLblIdx
    tiraCallId0 autoDisplayCheckIdx
    tiraLabelId skipAutoLblIdx
  END IF

END SUB ' tiraInjectPendingDisplayFlushId

''''''''''''''''''''''''
SUB tiraJmp (labelName$)

  tiraCheckActive ("tiraJmp")
  IF tiraLineCheck THEN EXIT SUB

  firstChar$ = LEFT$(labelName$, 1)

  IF firstChar$ <> "@" THEN
    throwCompilerError "Internal jump targets must use @ prefix", ASIS, 0
    EXIT SUB
  END IF

  tiraClearArgs

  tiraNode(t.LineCount).OpCode = TC_JMP
  tiraSetNodeArg 1, labelName$

  t.LineCount = t.LineCount + 1

END SUB ' tiraJmp
''''''''''''''''''''''''
SUB tiraJmpCondId (jccConst AS LONG, src1Type AS LONG, src1Val AS _INTEGER64, src2Type AS LONG, src2Val AS _INTEGER64, labelIdx AS LONG)

  tiraCheckActive ("tiraJmpCondId")
  IF tiraLineCheck THEN EXIT SUB

  SELECT CASE jccConst

    CASE JCC_JE, JCC_JNE, JCC_JL, JCC_JLE, JCC_JG, JCC_JGE, JCC_JB, JCC_JBE, JCC_JA, JCC_JAE, JCC_JO, JCC_JNO
      ' Valid
    CASE ELSE
      throwCompilerError "INVALID JCC CONSTANT IN TIRAJMPCONDID", ASIS, 0
      EXIT SUB

  END SELECT ' jccConst

  IF labelIdx < 0 THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF labelIdx >= symbolCount THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF symbols(labelIdx).DataType <> TYPE_LABEL THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF LEFT$(symbols(labelIdx).RecordName, 1) <> "@" THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_JMP_COND

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_STR_LITERAL
  tiraNode(t.LineCount).Arg1Val = jccConst

  tiraNode(t.LineCount).Arg2Type = src1Type
  tiraNode(t.LineCount).Arg2Val = src1Val

  tiraNode(t.LineCount).Arg3Type = src2Type
  tiraNode(t.LineCount).Arg3Val = src2Val

  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_LABEL
  tiraNode(t.LineCount).Arg4Val = labelIdx

  t.LineCount = t.LineCount + 1

END SUB ' tiraJmpCondId
''''''''''''''''''''''''
SUB tiraJmpId (labelIdx AS LONG)

  tiraCheckActive ("tiraJmpId")
  IF tiraLineCheck THEN EXIT SUB

  IF labelIdx < 0 THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF labelIdx >= symbolCount THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF symbols(labelIdx).DataType <> TYPE_LABEL THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF LEFT$(symbols(labelIdx).RecordName, 1) <> "@" THEN
    throwCompilerError "Internal jump target must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_JMP

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LABEL
  tiraNode(t.LineCount).Arg1Val = labelIdx

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg2Val = 0
  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraJmpId

