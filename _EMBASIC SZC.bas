  END IF

  genSymbolRouteSSE = 1

END FUNCTION ' genSymbolRouteSSE

''''''''''''''''''''''''
FUNCTION hashString& (wStr$)

  DIM hVal AS _UNSIGNED LONG
  DIM sLen AS _UNSIGNED LONG
  DIM ii AS _UNSIGNED LONG

  hVal = 5381
  sLen = LEN(wStr$)
  FOR ii = 1 TO sLen
    hVal = ((hVal * 33) + ASC(wStr$, ii)) AND SYMBOL_HASH_MASK
  NEXT

  hashString = hVal

END FUNCTION ' hashString

''''''''''''''''''''''''
FUNCTION hashSymbolString& (wStr$)

  DIM hVal AS _UNSIGNED LONG
  DIM sLen AS _UNSIGNED LONG
  DIM ii AS _UNSIGNED LONG

  hVal = 5381
  sLen = LEN(wStr$)
  FOR ii = 1 TO sLen
    hVal = ((hVal * 33) + ASC(wStr$, ii)) AND SYMBOL_LOOKUP_HASH_MASK
  NEXT

  hashSymbolString = hVal

END FUNCTION ' hashSymbolString

''''''''''''''''''''''''
SUB hoistIntrinsics

  DIM hasIntrinsics AS LONG
  DIM iSearch AS LONG
  DIM deepestStart AS LONG
  DIM deepestEnd AS LONG
  DIM foundDeeper AS LONG
  DIM tVal AS LONG
  DIM isIntrinsic AS LONG
  DIM isZeroArg AS LONG
  DIM repVar$
  DIM pEnd AS LONG

  DO
    hasIntrinsics = 0
    deepestStart = -1

    IF lineTokenCount > 0 THEN
      ' Find the first migrated intrinsic
      FOR iSearch = 0 TO lineTokenCount - 1
        tVal = lineTokenVals(iSearch)
        isIntrinsic = 0

        ' Only trap intrinsics that have been successfully migrated to the Hoisting Architecture
        IF tVal >= 0 AND tVal <= 1024 THEN
          IF isHoistedIntrinsic(tVal) > 0 THEN
            isIntrinsic = 1

            ' Prevent the _MEM type descriptor from being hoisted as a math intrinsic
            IF iSearch > 0 THEN
              IF lineTokenVals(iSearch - 1) = TOK_AS THEN isIntrinsic = 0
            END IF

            ' Preserve the LEN = record-length clause in OPEN FOR RANDOM statements
            IF tVal = TOK_LEN THEN
              IF iSearch + 1 < lineTokenCount THEN
                IF lineTokenVals(iSearch + 1) = 256 + ASC("=") THEN
                  IF lineTokenVals(0) = TOK_OPEN THEN isIntrinsic = 0
                END IF
              END IF
            END IF

            ' Prevent statement keywords from being hoisted when they appear at the start of a statement
            IF iSearch = 0 THEN
              IF isHoistedIntrinsic(tVal) = HOIST_CMD_REQ_ARGS OR isHoistedIntrinsic(tVal) = HOIST_CMD_NO_ARGS THEN isIntrinsic = 0
            END IF

            ' Prevent assignable intrinsics from hoisting when they are the target of an assignment
            IF isHoistedIntrinsic(tVal) = HOIST_ASSIGN_REQ_ARGS THEN
              IF iSearch = 0 OR (iSearch = 1 AND lineTokenVals(0) = TOK_LET) THEN
                IF iSearch + 1 < lineTokenCount THEN
                  IF lineTokenVals(iSearch + 1) = 256 + ASC("(") THEN
                    ff = findMatchingParen(iSearch + 1, lineTokenCount - 1)
                    IF ff = 1 THEN
                      pEnd = returnedData2
                      IF pEnd + 1 < lineTokenCount THEN
                        IF lineTokenVals(pEnd + 1) = 256 + ASC("=") THEN
                          isIntrinsic = 0
                        END IF
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF

        IF isIntrinsic = 1 THEN
          hasIntrinsics = 1
          deepestStart = iSearch
          EXIT FOR
        END IF
      NEXT
    END IF

    IF hasIntrinsics = 0 THEN EXIT DO ' No intrinsic found

    '  Drill down to find the deepest nested one
    DO
      isZeroArg = 0
      IF isHoistedIntrinsic(lineTokenVals(deepestStart)) = HOIST_NO_ARGS OR isHoistedIntrinsic(lineTokenVals(deepestStart)) = HOIST_CMD_NO_ARGS THEN
        isZeroArg = 1
      END IF

      ' Tier 5: Intrinsics that can optionally take arguments (like RND)
      IF isHoistedIntrinsic(lineTokenVals(deepestStart)) = HOIST_OPT_ARGS THEN
        IF deepestStart + 1 < lineTokenCount THEN
          IF lineTokenVals(deepestStart + 1) <> 256 + ASC("(") THEN
            isZeroArg = 1
          END IF
        ELSE
          isZeroArg = 1
        END IF
      END IF

      IF isZeroArg = 1 THEN
        deepestEnd = deepestStart
      ELSE
        IF deepestStart + 1 < lineTokenCount THEN
          IF lineTokenVals(deepestStart + 1) = 256 + ASC("(") THEN
            ff = findMatchingParen(deepestStart + 1, lineTokenCount - 1)
            IF ff = 0 THEN
              throwCompilerError "MISSING ) ON INTRINSIC", ASIS, 0
              EXIT SUB
            END IF
            deepestEnd = returnedData2
          ELSE
            throwCompilerError "INTRINSIC MISSING (", ASIS, 0
            EXIT SUB
          END IF
        ELSE
          throwCompilerError "INTRINSIC MISSING (", ASIS, 0
          EXIT SUB
        END IF
      END IF

      foundDeeper = 0
      IF deepestEnd - 1 >= deepestStart + 2 THEN
        FOR ii = deepestStart + 2 TO deepestEnd - 1
          tVal = lineTokenVals(ii)
          isIntrinsic = 0

          IF tVal >= 0 AND tVal <= 1024 THEN
            IF isHoistedIntrinsic(tVal) > 0 THEN
              isIntrinsic = 1

              ' Prevent the _MEM type descriptor from being hoisted as a math intrinsic
              IF ii > 0 THEN
                IF lineTokenVals(ii - 1) = TOK_AS THEN isIntrinsic = 0
              END IF
            END IF
          END IF

          IF isIntrinsic = 1 THEN
            foundDeeper = 1
            deepestStart = ii
            EXIT FOR
          END IF
        NEXT
      END IF

      IF foundDeeper = 0 THEN EXIT DO
    LOOP

    ' Route the deepest intrinsic to its parser
    repVar$ = parseIntrinsic$(deepestStart, deepestEnd, cm.ClassicMode) ' Use compile classic mode here, to determine whether to allow or not. Inside the function, specific overrides can be set
    IF repVar$ = "" OR compileError = 1 THEN
      EXIT SUB
    END IF

    ' Flatten the array to replace the intrinsic block with the generated variable
    collapseTokens deepestStart, deepestEnd, repVar$
  LOOP

END SUB ' hoistIntrinsics

''''''''''''''''''''''''
SUB indexSymbol (vIdx AS LONG)

  DIM hashValue AS LONG

  IF vIdx < 0 OR vIdx >= symbolCount THEN EXIT SUB

  symbols(vIdx).HashNext = -1
  recordName$ = RTRIM$(symbols(vIdx).RecordName)

  IF recordName$ <> "" THEN
    hashValue = hashSymbolString(recordName$)
    symbols(vIdx).HashNext = symHash(hashValue)
    symHash(hashValue) = vIdx

    indexSymbolScope vIdx, hashValue
  END IF

  symScopeIndexedSymbolCount = symbolCount

END SUB ' indexSymbol

''''''''''''''''''''''''
SUB initSymbolHash

  DIM clearMem AS _MEM

  symScopeIndexedSymbolCount = 0
  staticArrayDimensionCount = 0

  IF routineLookupEntryCount > 0 THEN
    FOR ii = 0 TO routineLookupEntryCount - 1
      routineLookupName$(ii) = ""
    NEXT
  END IF

  routineLookupEntryCount = 0
  routineLookupIndexedSubCount = 1
  udtNameIndexedCount = 0

  clearMem = _MEM(staticArrayLayoutStart())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(symHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(symScopeHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  FOR ii = 0 TO MAX_SUBS
    scopeSymbolHead(ii) = 0
    scopeSymbolTail(ii) = 0
  NEXT

  clearMem = _MEM(routineSymbolIndex())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(routineLookupHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(udtNameHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(udtFieldHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  clearMem = _MEM(udtFieldIndexedCount())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  IF tokenStrCache(256) = "" THEN
    FOR ii = 256 TO 1023
      tokenStrCache(ii) = CHR$(ii \ 256) + CHR$(ii AND 255)
    NEXT
  END IF

END SUB ' initSymbolHash

''''''''''''''''''''''''
SUB indexSymbolScope (vIdx AS LONG, rsHashValue AS LONG)

  DIM hashValue AS LONG
  DIM scopeIdx AS LONG
  DIM tailLink AS LONG

  IF vIdx < 0 OR vIdx >= symbolCount THEN EXIT SUB

  hashValue = (rsHashValue + (symbols(vIdx).ScopeID * 257)) AND SYMBOL_LOOKUP_HASH_MASK

  symScopeHashNext(vIdx) = symScopeHash(hashValue)
  symScopeHash(hashValue) = vIdx

  scopeSymbolNext(vIdx) = 0
  scopeIdx = symbols(vIdx).ScopeID

  IF scopeIdx >= 0 AND scopeIdx <= MAX_SUBS THEN
    IF scopeSymbolHead(scopeIdx) = 0 THEN
      scopeSymbolHead(scopeIdx) = vIdx + 1
    ELSE
      tailLink = scopeSymbolTail(scopeIdx)
      scopeSymbolNext(tailLink - 1) = vIdx + 1
    END IF

    scopeSymbolTail(scopeIdx) = vIdx + 1
  END IF

END SUB ' indexSymbolScope

