  impFuncs(0, 13).FuncName = "SetConsoleCursorPosition"
  impFuncs(0, 14).FuncName = "SetConsoleTextAttribute"
  impFuncs(0, 15).FuncName = "Sleep"
  impFuncs(0, 16).FuncName = "CreateFileA"
  impFuncs(0, 17).FuncName = "CloseHandle"
  impFuncs(0, 18).FuncName = "GetFileSize"
  impFuncs(0, 19).FuncName = "DeleteFileA"
  impFuncs(0, 20).FuncName = "GetTickCount"
  impFuncs(0, 21).FuncName = "ScrollConsoleScreenBufferA"
  impFuncs(0, 22).FuncName = "FillConsoleOutputCharacterA"
  impFuncs(0, 23).FuncName = "FillConsoleOutputAttribute"
  impFuncs(0, 24).FuncName = "GetConsoleScreenBufferInfo"
  impFuncs(0, 25).FuncName = "GetCurrentThreadId"
  impFuncs(0, 26).FuncName = "GetFileAttributesA"
  impFuncs(0, 27).FuncName = "WinExec"
  impFuncs(0, 28).FuncName = "SetFilePointer"
  impFuncs(0, 29).FuncName = "GlobalAlloc"
  impFuncs(0, 30).FuncName = "GlobalLock"
  impFuncs(0, 31).FuncName = "GlobalUnlock"
  impFuncs(0, 32).FuncName = "GetConsoleWindow"
  impFuncs(0, 33).FuncName = "CreateProcessA"
  impFuncs(0, 34).FuncName = "WaitForSingleObject"
  impFuncs(0, 35).FuncName = "GetModuleFileNameA"

  impDlls(1).DllName = "USER32.dll"
  impDlls(1).FuncCount = 28
  impFuncs(1, 0).FuncName = "DefWindowProcA"
  impFuncs(1, 1).FuncName = "RegisterClassExA"
  impFuncs(1, 2).FuncName = "CreateWindowExA"
  impFuncs(1, 3).FuncName = "ShowWindow"
  impFuncs(1, 4).FuncName = "PeekMessageA"
  impFuncs(1, 5).FuncName = "TranslateMessage"
  impFuncs(1, 6).FuncName = "DispatchMessageA"
  impFuncs(1, 7).FuncName = "PostQuitMessage"
  impFuncs(1, 8).FuncName = "AdjustWindowRectEx"
  impFuncs(1, 9).FuncName = "BeginPaint"
  impFuncs(1, 10).FuncName = "EndPaint"
  impFuncs(1, 11).FuncName = "GetAsyncKeyState"
  impFuncs(1, 12).FuncName = "InvalidateRect"
  impFuncs(1, 13).FuncName = "LoadCursorA"
  impFuncs(1, 14).FuncName = "UpdateWindow"
  impFuncs(1, 15).FuncName = "GetSystemMetrics"
  impFuncs(1, 16).FuncName = "SetWindowLongA"
  impFuncs(1, 17).FuncName = "SetWindowPos"
  impFuncs(1, 18).FuncName = "GetKeyState"
  impFuncs(1, 19).FuncName = "keybd_event"
  impFuncs(1, 20).FuncName = "GetCursorPos"
  impFuncs(1, 21).FuncName = "ScreenToClient"
  impFuncs(1, 22).FuncName = "OpenClipboard"
  impFuncs(1, 23).FuncName = "EmptyClipboard"
  impFuncs(1, 24).FuncName = "SetClipboardData"
  impFuncs(1, 25).FuncName = "CloseClipboard"
  impFuncs(1, 26).FuncName = "GetClipboardData"
  impFuncs(1, 27).FuncName = "IsClipboardFormatAvailable"

  impDlls(2).DllName = "GDI32.dll"
  impDlls(2).FuncCount = 16
  impFuncs(2, 0).FuncName = "BitBlt"
  impFuncs(2, 1).FuncName = "CreateCompatibleBitmap"
  impFuncs(2, 2).FuncName = "CreateCompatibleDC"
  impFuncs(2, 3).FuncName = "CreateDIBSection" ' Creates a Device-Independent Bitmap (DIB) that the program can write to directly. Allocates memory for the bitmap's pixels and hands off a direct memory pointer to those pixels
  impFuncs(2, 4).FuncName = "CreateFontA"
  impFuncs(2, 5).FuncName = "DeleteDC"
  impFuncs(2, 6).FuncName = "DeleteObject"
  impFuncs(2, 7).FuncName = "GetStockObject"
  impFuncs(2, 8).FuncName = "SelectObject"
  impFuncs(2, 9).FuncName = "SetBkColor"
  impFuncs(2, 10).FuncName = "SetDIBColorTable"
  impFuncs(2, 11).FuncName = "SetPixel"
  impFuncs(2, 12).FuncName = "SetTextColor"
  impFuncs(2, 13).FuncName = "StretchBlt"
  impFuncs(2, 14).FuncName = "TextOutA"
  impFuncs(2, 15).FuncName = "StretchDIBits"

  impDlls(3).DllName = "DWMAPI.dll"
  impDlls(3).FuncCount = 1
  impFuncs(3, 0).FuncName = "DwmSetWindowAttribute"

  impDlls(4).DllName = "msvcrt.dll"
  impDlls(4).FuncCount = 9
  impFuncs(4, 0).FuncName = "atan"
  impFuncs(4, 1).FuncName = "cos"
  impFuncs(4, 2).FuncName = "pow"
  impFuncs(4, 3).FuncName = "sin"
  impFuncs(4, 4).FuncName = "sprintf"
  impFuncs(4, 5).FuncName = "srand"
  impFuncs(4, 6).FuncName = "rand"
  impFuncs(4, 7).FuncName = "_kbhit"
  impFuncs(4, 8).FuncName = "_getch"

  impDlls(5).DllName = "winmm.dll"
  impDlls(5).FuncCount = 7
  impFuncs(5, 0).FuncName = "waveOutOpen"
  impFuncs(5, 1).FuncName = "waveOutPrepareHeader"
  impFuncs(5, 2).FuncName = "waveOutWrite"
  impFuncs(5, 3).FuncName = "waveOutUnprepareHeader"
  impFuncs(5, 4).FuncName = "waveOutClose"
  impFuncs(5, 5).FuncName = "joyGetPosEx"
  impFuncs(5, 6).FuncName = "joyGetDevCapsA"

  impDlls(6).DllName = "XINPUT9_1_0.dll"
  impDlls(6).FuncCount = 1
  impFuncs(6, 0).FuncName = "XInputGetState"

  ' Dynamically inject user DECLARE LIBRARY functions into the Import Table
  FOR iSub = 1 TO subCount - 1
    IF subs(iSub).IsDll = 1 THEN
      dName$ = RTRIM$(subs(iSub).DllName)
      IF dName$ = "" THEN dName$ = "USER32.dll" ' Default to User32 for generic unquoted DECLARE LIBRARY blocks
      IF INSTR(dName$, ".") = 0 THEN dName$ = dName$ + ".dll"

      ' Find if DLL already exists in the compiler's tracking records
      foundDll = -1
      FOR iDll = 0 TO impTbl.numDlls - 1
        IF UCASE$(RTRIM$(impDlls(iDll).DllName)) = UCASE$(dName$) THEN
          foundDll = iDll
          EXIT FOR
        END IF
      NEXT

      ' If the DLL isn't registered yet, add it as a new library dependency
      IF foundDll = -1 THEN
        IF impTbl.numDlls < 32 THEN
          foundDll = impTbl.numDlls
          impDlls(foundDll).DllName = dName$
          impDlls(foundDll).FuncCount = 0
          impTbl.numDlls = impTbl.numDlls + 1
        ELSE
          ESCAPETEXT "TOO MANY IMPORT DLLS"
        END IF
      END IF

      IF foundDll <> -1 THEN
        fCount = impDlls(foundDll).FuncCount

        ' Scan the existing function entries for this DLL to see if the requested API function
        ' has already been registered natively by the engine (e.g. GetCursorPos)
        foundFunc = -1
        IF fCount > 0 THEN
          FOR iFunc = 0 TO fCount - 1
            IF UCASE$(RTRIM$(impFuncs(foundDll, iFunc).FuncName)) = UCASE$(RTRIM$(subs(iSub).AliasName)) THEN
              foundFunc = iFunc ' Match found! Save the index so we can reuse it securely
              EXIT FOR
            END IF
          NEXT
        END IF

        IF foundFunc = -1 THEN
          ' The function is not in the table yet, so we append it as a completely new import entry
          IF fCount < 256 THEN
            impFuncs(foundDll, fCount).FuncName = RTRIM$(subs(iSub).AliasName)
            subs(iSub).IatDllIdx = foundDll
            subs(iSub).IatFuncIdx = fCount
            impDlls(foundDll).FuncCount = fCount + 1
          ELSE
            ESCAPETEXT "TOO MANY IMPORT FUNCTIONS IN " + dName$
          END IF
        ELSE
          ' The function is already imported. Route this subroutine's jump index to the
          ' existing IAT slot instead of duplicating it, which would corrupt the routing table
          subs(iSub).IatDllIdx = foundDll
          subs(iSub).IatFuncIdx = foundFunc
        END IF
      END IF
    END IF
  NEXT

  currentRVA = impTbl.baseRVA

  impTbl.idtSize = (impTbl.numDlls + 1) * 20
  currentRVA = currentRVA + impTbl.idtSize

  FOR iDll = 0 TO impTbl.numDlls - 1
    impDlls(iDll).IltRVA = currentRVA
    iltSize = (impDlls(iDll).FuncCount + 1) * 8
    currentRVA = currentRVA + iltSize
  NEXT

  impTbl.totalIatSize = 0
  FOR iDll = 0 TO impTbl.numDlls - 1
    impDlls(iDll).IatRVA = currentRVA
    iatSize = (impDlls(iDll).FuncCount + 1) * 8
    impTbl.totalIatSize = impTbl.totalIatSize + iatSize
    currentRVA = currentRVA + iatSize
  NEXT

  flatIdx = 0
  FOR iDll = 0 TO impTbl.numDlls - 1
    FOR iFunc = 0 TO impDlls(iDll).FuncCount - 1
      impFuncs(iDll, iFunc).FuncRVA = currentRVA
      impFlatIatRVA(flatIdx) = impDlls(iDll).IatRVA + (iFunc * 8)
      flatIdx = flatIdx + 1

      fName$ = RTRIM$(impFuncs(iDll, iFunc).FuncName)
      nameLen = LEN(fName$) + 1
      entrySize = 2 + nameLen
      IF (entrySize AND 1) <> 0 THEN entrySize = entrySize + 1
      currentRVA = currentRVA + entrySize
    NEXT
  NEXT

  flatIdx = 0
  FOR iDll = 0 TO impTbl.numDlls - 1
    FOR iFunc = 0 TO impDlls(iDll).FuncCount - 1
      fName$ = RTRIM$(impFuncs(iDll, iFunc).FuncName)
      iatConst = retIatConstByName(fName$, 0)
      IF iatConst <> IAT_INVALID THEN
        impIatFlatIdx(iatConst) = flatIdx
      END IF

      FOR iSub = 1 TO subCount - 1
        IF subs(iSub).IsDll = 1 THEN
          IF subs(iSub).IatDllIdx = iDll AND subs(iSub).IatFuncIdx = iFunc THEN
            subs(iSub).IatFlatIdx = flatIdx
          END IF
        END IF
      NEXT

      flatIdx = flatIdx + 1
    NEXT
  NEXT

  FOR iDll = 0 TO impTbl.numDlls - 1
    impDlls(iDll).NameRVA = currentRVA
    dName$ = RTRIM$(impDlls(iDll).DllName)
    nameLen = LEN(dName$) + 1
    IF (nameLen AND 1) <> 0 THEN nameLen = nameLen + 1
    currentRVA = currentRVA + nameLen
  NEXT

  exactIdataSize = currentRVA - impTbl.baseRVA
  impTbl.idataRawSize = ((exactIdataSize + PE_FILE_ALIGNMENT - 1) \ PE_FILE_ALIGNMENT) * PE_FILE_ALIGNMENT

END SUB ' buildImportTable

''''''''''''''''''''''''
SUB buildRoutineDeclarationIndex

  ' Builds the routine-name lookup used while resolving label and implicit-call ambiguity

  DIM declarationStart AS LONG
  DIM declarationChar AS LONG
  DIM hashValue AS LONG
  DIM checkIdx AS LONG
  DIM isFound AS LONG
  DIM aliasCount AS LONG
  DIM aliasIdx AS LONG
  DIM previousLineNumber AS _UNSIGNED LONG

  previousLineNumber = currentLineNumber

  IF routineDeclCount > 0 THEN
    FOR ii = 0 TO routineDeclCount - 1
      routineDeclName$(ii) = ""
      routineDeclHashNext(ii) = 0
    NEXT
  END IF

  FOR ii = 0 TO SYMBOL_HASH_MASK
    routineDeclHash(ii) = -1
  NEXT

  routineDeclCount = 0

  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN
      currentLineNumber = previousLineNumber
      EXIT SUB
    END IF

    currentLineNumber = editorLineLinkMap(iy)
    declarationLine$ = UCASE$(LTRIM$(RTRIM$(compileText$(iy))))
    declarationStart = 0

    IF LEFT$(declarationLine$, 4) = "SUB " THEN
      declarationStart = 5
    ELSE
      IF LEFT$(declarationLine$, 9) = "FUNCTION " THEN
        declarationStart = 10
      ELSE
        IF LEFT$(declarationLine$, 12) = "DECLARE SUB " THEN
          declarationStart = 13
        ELSE
          IF LEFT$(declarationLine$, 17) = "DECLARE FUNCTION " THEN
            declarationStart = 18
          END IF
        END IF
      END IF
    END IF

    IF declarationStart > 0 THEN
      declarationName$ = ""

      FOR i2 = declarationStart TO LEN(declarationLine$)
        declarationChar = ASC(declarationLine$, i2)

        IF (declarationChar >= 65 AND declarationChar <= 90) OR (declarationChar >= 48 AND declarationChar <= 57) OR declarationChar = 95 OR declarationChar = 36 OR declarationChar = 35 OR declarationChar = 33 OR declarationChar = 37 OR declarationChar = 38 THEN
          declarationName$ = declarationName$ + CHR$(declarationChar)
        ELSE
          EXIT FOR
        END IF
      NEXT

      IF declarationName$ <> "" THEN
        baseName$ = retRoutineBaseName$(declarationName$)
        aliasCount = 1
        IF baseName$ <> "" AND baseName$ <> declarationName$ THEN aliasCount = 2

        FOR aliasIdx = 0 TO aliasCount - 1
          routineName$ = declarationName$
          IF aliasIdx = 1 THEN routineName$ = baseName$

          hashValue = hashString(routineName$)
          checkIdx = routineDeclHash(hashValue)
          isFound = 0

          DO WHILE checkIdx <> -1
            IF routineDeclName$(checkIdx) = routineName$ THEN
              isFound = 1
              EXIT DO
            END IF

            checkIdx = routineDeclHashNext(checkIdx)
          LOOP

          IF isFound = 0 THEN
            IF routineDeclCount >= MAX_SUBS * 2 THEN
              throwCompilerError "ROUTINE DECLARATION INDEX LIMIT REACHED", ASIS, 0
              currentLineNumber = previousLineNumber
              EXIT SUB
            END IF

            routineDeclName$(routineDeclCount) = routineName$
            routineDeclHashNext(routineDeclCount) = routineDeclHash(hashValue)
            routineDeclHash(hashValue) = routineDeclCount
            routineDeclCount = routineDeclCount + 1
          END IF
        NEXT
      END IF
    END IF
  NEXT

  currentLineNumber = previousLineNumber

END SUB ' buildRoutineDeclarationIndex

''''''''''''''''''''''''
FUNCTION calcRex (opSize AS LONG, regR AS LONG, regB AS LONG, regX AS LONG)

  DIM rexByte AS LONG
  rexByte = 0

  IF opSize = 64 THEN rexByte = rexByte OR &H08
  IF regR >= 8 THEN
    IF regR <> REG_NONE THEN rexByte = rexByte OR &H04
  END IF
  IF regX >= 8 THEN
    IF regX <> REG_NONE THEN rexByte = rexByte OR &H02
  END IF
  IF regB >= 8 THEN
    IF regB <> REG_NONE THEN rexByte = rexByte OR &H01
  END IF

  IF opSize = 8 THEN
    IF regR >= 4 AND regR <= 7 THEN
      rexByte = rexByte OR &H40
    ELSE
      IF regB >= 4 AND regB <= 7 THEN
        rexByte = rexByte OR &H40
      END IF
    END IF
  END IF

  IF rexByte > 0 THEN rexByte = rexByte OR &H40

  calcRex = rexByte

END FUNCTION ' calcRex

''''''''''''''''''''''''
'' SUB checkEmergencyClose ' This is found within Z_EMLINF.BLB
'
' Checks to see if user is asking to leave compile early

''''''''''''''''''''''''
FUNCTION checkIntrinsicSyntax (startIdx, endIdx, funcName$, minTokens)

  IF startIdx + minTokens > endIdx THEN
    throwCompilerError "MALFORMED " + funcName$, ASIS, 0
    checkIntrinsicSyntax = 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(startIdx + 1) <> 256 + ASC("(") OR lineTokenVals(endIdx) <> 256 + ASC(")") THEN
    throwCompilerError "MALFORMED " + funcName$, ASIS, 0
    checkIntrinsicSyntax = 0
    EXIT FUNCTION
  END IF

  checkIntrinsicSyntax = 1

END FUNCTION ' checkIntrinsicSyntax

''''''''''''''''''''''''
FUNCTION checkIfPreprocessorKeyword (passCheckDir$)

  DIM tempRet AS LONG
  DIM dirWord$
  DIM chCheck$

  tempRet = 0

  IF LEFT$(passCheckDir$, 1) = "#" THEN
    dirWord$ = ""
    FOR ix = 1 TO LEN(passCheckDir$)
      chCheck$ = MID$(passCheckDir$, ix, 1)
      IF chCheck$ = " " OR chCheck$ = CHR$(9) THEN EXIT FOR
      dirWord$ = dirWord$ + UCASE$(chCheck$)
    NEXT

    IF dirWord$ = "#STRINGSTRICT" OR dirWord$ = "#GRAPHICS" OR dirWord$ = "#GLDEFINT" OR dirWord$ = "#EMERALD" OR dirWord$ = "#CLASSIC" OR dirWord$ = "#NOREF" OR dirWord$ = "#INCLUDE" OR dirWord$ = "#PASCAL" THEN
      tempRet = 1
    END IF
  END IF

  checkIfPreprocessorKeyword = tempRet

END FUNCTION ' checkIfPreprocessorKeyword

''''''''''''''''''''''''
SUB checkRegisterBounds (wReg, wName$)

  IF wReg < 0 OR wReg > 15 THEN
    ESCAPETEXT2 "COMPILER FAIL: Register out of bounds (" + LTRIM$(STR$(wReg)) + ")", "in " + wName$
  END IF

END SUB ' checkRegisterBounds

''''''''''''''''''''''''
SUB collapseTokens (startIdx, endIdx, repVar$)

  DIM shiftDist AS LONG

  shiftDist = endIdx - startIdx

  ' Overwrite the intrinsic call with the calculated  ! ... HOIST variable
  lineTokens$(startIdx) = repVar$
  lineTokenVals(startIdx) = 0 ' Null the value so the system treats it as an identifier

  ' Shift the remaining line elements leftwards to fill the gap
  FOR ii = endIdx + 1 TO lineTokenCount - 1
    lineTokens$(ii - shiftDist) = lineTokens$(ii)
    lineTokenVals(ii - shiftDist) = lineTokenVals(ii)
  NEXT

  lineTokenCount = lineTokenCount - shiftDist

END SUB ' collapseTokens

''''''''''''''''''''''''
FUNCTION compile

  currentLineNumber = 1
  compileStatusMsg$ = ""
  compileError = 0
  stream.emitPos = 0
  tokenCacheEnabled = 0
  tokenCacheLineCount = 0
  tokenCacheTokenCount = 0

  FOR ii = 0 TO TOKEN_CACHE_HASH_MASK
    tokenCacheHash(ii) = 0
  NEXT

  ' Execute the refinement process immediately when compilation begins to ensure
  ' newly pasted code is formatted and case-corrected before lexical scanning begins
  ' This already occurs in COMP_REFINE through refineCode 0, 1

  IF compileError = 1 THEN
    EXIT FUNCTION
  END IF

  symbolCount = 0
  scopeCounter = 0
  currentScopeID = 0 ' Start in the global scope
  lineTokenCount = 0
  patchCount = 0
  iatPatchCount = 0
  cm.HasGraphics = 0
  cm.HasGlobalDefInt = 0
  expectedSymType = TYPE_ANY
  compileWindowTitle$ = "Default"

  scanGlobalDirectives 0

  ctrlCount = 0
  gotoPatchCount = 0
  lastNumericLabel = 0 ' 0 is not a valid label, so signals invalid
  t.TiraVarCounter = 0

  t.LineCount = 0
  t.TempCounter = 0
  t.IsActive = 3

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 0

  rt.PatchCount = 0

  FOR ii = 0 TO MAX_RT_ROUTINES
    rtIsUsed(ii) = 0
    rtOffset(ii) = 0
  NEXT

  FOR ii = 0 TO 25
    defIntMap(ii) = 0
  NEXT

  subCount = 1 ' Starts at 1 to reserve 0 for the main program
  FOR ii = 0 TO MAX_SUBS
    scopeSubIndex(ii) = 0
  NEXT
  subs(0).RecordName = "MAIN"
  subs(0).ScopeID = 0
  subs(0).IsFunction = 0
  subs(0).ArgCount = 0
  subs(0).LocalFrameSize = 0

  callPatchCount = 0
  insideSub = 0
  currentSubName$ = ""
  declareCount = 0
  dataItemCount = 0

  initSymbolHash
  initStackLayout

  ff = updateStackAlignment

  gfxConfig.SizeX = 640 ' Defaults if not specified
  gfxConfig.SizeY = 480

  compileInitEngineGlobals

  engineSymbolLimit = symbolCount

  t.IsActive = 0 ' Setup complete, clear tira persmission flag

  compileText$(0) = "LINE 0: YOU SHOULD NEVER SEE THIS"
  editorLineLinkMap(0) = 0

  compileLineHighWater = 0

  loadIncludesAndBaseCode
  IF compileLastLine > compileLineHighWater THEN compileLineHighWater = compileLastLine
  IF compileError = 1 THEN EXIT FUNCTION

  buildRoutineDeclarationIndex
  IF compileError = 1 THEN EXIT FUNCTION

  DO
    ff = compilePass1Flatten
    IF compileLastLine > compileLineHighWater THEN compileLineHighWater = compileLastLine
  LOOP WHILE ff = 1 ' 1 indicates more work needs to be done

  compilePass2LexiConsts

  scanGlobalDirectives 1
  IF compileError = 1 THEN
    EXIT FUNCTION
  END IF

  tokenCacheEnabled = 1

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 1 THEN
    gfxPalIdx = returnedData2
    palStr$ = ""
    FOR ii = 0 TO 255
      palStr$ = palStr$ + CHR$(outputPal(ii, palBLUE))
      palStr$ = palStr$ + CHR$(outputPal(ii, palGREEN))
      palStr$ = palStr$ + CHR$(outputPal(ii, palRED))
      palStr$ = palStr$ + CHR$(0)
    NEXT
    strVarData$(gfxPalIdx) = palStr$
  END IF

  ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
  IF ff = 1 THEN
    defPalIdx = returnedData2
    strVarData$(defPalIdx) = palStr$
  END IF

  ff = resolveSymbol("!G_GFX_VAL_FG")
  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")

  compilePass3Scan

  IF compileError = 1 THEN
    EXIT FUNCTION
  END IF

  ' Register Window literals safely after directives are scanned
  ff = resolveSymbol("!G_WND_DSC_CLASS")
  IF ff = 1 THEN
    clsIdx = returnedData2
    strVarData$(clsIdx) = "DefaultClass"
  END IF

  ff = resolveSymbol("!G_WND_DSC_TITLE")
  IF ff = 1 THEN
    winIdx = returnedData2
    strVarData$(winIdx) = compileWindowTitle$
  END IF

  ff = resolveSymbol("!G_GFX_DSC_FONT")
  IF ff = 1 THEN
    fntIdx = returnedData2
    strVarData$(fntIdx) = "Terminal"
  END IF

  compilePass4Symbols

  IF compileError = 1 THEN
    EXIT FUNCTION
  END IF

  ' Build the direct scope lookup after all routines are registered
  FOR ii = 1 TO subCount - 1
    scopeSubIndex(subs(ii).ScopeID) = ii
  NEXT

  compile = 1

END FUNCTION ' compile

