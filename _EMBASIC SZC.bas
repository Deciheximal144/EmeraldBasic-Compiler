''''''''''''''''''''''''
SUB tiraEmitPassByRefCopyOut (srcArgIdx AS LONG, targetVarIdx AS LONG)

  DIM srcName$
  DIM targetVarName$
  DIM targetType AS LONG
  DIM fixedLen AS LONG
  DIM lhsDataPtr$
  DIM lhsDescPtr$
  DIM rhsDataPtr$
  DIM rhsLen$
  DIM minLen$
  DIM padLen$
  DIM skipPadLbl$
  DIM padAddr$
  DIM srcBaseAddr$
  DIM tgtBaseAddr$

  srcName$ = "#" + LTRIM$(STR$(srcArgIdx))
  targetVarName$ = "#" + LTRIM$(STR$(targetVarIdx))
  targetType = symbols(targetVarIdx).DataType

  IF targetType = TYPE_STRING THEN
    fixedLen = retFixeSTRINGDLength(srcArgIdx)
    IF fixedLen > 0 THEN
      lhsDataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign lhsDescPtr$, srcName$
      tiraNew TC_READ_MEM, lhsDataPtr$ + ", " + lhsDescPtr$

      rhsDataPtr$ = tiraGetStringData$(targetVarName$)
      rhsLen$ = tiraGetStringLen$(targetVarName$)

      minLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign minLen$, rhsLen$
      tiraClamp minLen$, "", LTRIM$(STR$(fixedLen))

      tiraMemcpy lhsDataPtr$, rhsDataPtr$, minLen$

      padLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_SUB, padLen$, LTRIM$(STR$(fixedLen)), minLen$
      skipPadLbl$ = tiraLabelCreateNew$("SKIP_PAD")
      tiraJmpCond "JLE", padLen$, "0", skipPadLbl$

      padAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADD, padAddr$, lhsDataPtr$, minLen$
      tiraMemSet padAddr$, "32", padLen$
      tiraLabel skipPadLbl$
    ELSE
      tiraCall "RT_STR_ASSIGN", 2, srcName$ + ", " + targetVarName$
    END IF
  ELSE
    IF targetType = TYPE_UDT THEN
      srcBaseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADDRESS_OF, srcBaseAddr$, srcName$, ""

      tgtBaseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADDRESS_OF, tgtBaseAddr$, targetVarName$, ""

      tiraCopyUdtValue srcBaseAddr$, tgtBaseAddr$, symbols(targetVarIdx).UDTIndex
    ELSE
      tiraAssign srcName$, targetVarName$
    END IF
  END IF

END SUB ' tiraEmitPassByRefCopyOut

''''''''''''''''''''''''
SUB tiraEmitPassByRefCopyOutId (srcArgIdx AS LONG, targetVarIdx AS LONG)

  DIM targetType AS LONG
  DIM fixedLen AS LONG
  DIM lhsDataPtrIdx AS LONG
  DIM lhsDescPtrIdx AS LONG
  DIM rhsDataPtrIdx AS LONG
  DIM rhsLenIdx AS LONG
  DIM minLenIdx AS LONG
  DIM padLenIdx AS LONG
  DIM skipPadLblIdx AS LONG
  DIM padAddrIdx AS LONG
  DIM srcBaseAddrIdx AS LONG
  DIM tgtBaseAddrIdx AS LONG
  DIM strAssignIdx AS LONG

  targetType = symbols(targetVarIdx).DataType

  IF targetType = TYPE_STRING THEN
    fixedLen = retFixeSTRINGDLength(srcArgIdx)
    IF fixedLen > 0 THEN
      lhsDataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      lhsDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId lhsDescPtrIdx, TIRA_ARG_SYMBOL, srcArgIdx
      tiraReadMemId lhsDataPtrIdx, TIRA_ARG_SYMBOL, lhsDescPtrIdx

      rhsDataPtrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, targetVarIdx)
      rhsLenIdx = tiraGetStringLenId&(TIRA_ARG_SYMBOL, targetVarIdx)

      minLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraAssignId minLenIdx, TIRA_ARG_SYMBOL, rhsLenIdx
      tiraClampId minLenIdx, TIRA_ARG_EMPTY, 0, TIRA_ARG_LITERAL, fixedLen

      tiraMemcpyId TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, rhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx

      padLenIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_SYMBOL, minLenIdx
      skipPadLblIdx = tiraLabelCreateNewId&("SKIP_PAD")
      tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, padLenIdx, TIRA_ARG_LITERAL, 0, skipPadLblIdx

      padAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_SYMBOL, lhsDataPtrIdx, TIRA_ARG_SYMBOL, minLenIdx
      tiraMemSetId TIRA_ARG_SYMBOL, padAddrIdx, TIRA_ARG_LITERAL, 32, TIRA_ARG_SYMBOL, padLenIdx
      tiraLabelId skipPadLblIdx
    ELSE
      ff = resolveSymbol("RT_STR_ASSIGN")
      IF ff = 0 THEN EXIT SUB
      strAssignIdx = returnedData2
      tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, srcArgIdx, TIRA_ARG_SYMBOL, targetVarIdx
    END IF
  ELSE
    IF targetType = TYPE_UDT THEN
      srcBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, srcBaseAddrIdx, TIRA_ARG_SYMBOL, srcArgIdx

      tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx

      tiraCopyUdtValueId TIRA_ARG_SYMBOL, srcBaseAddrIdx, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, symbols(targetVarIdx).UDTIndex
    ELSE
      tiraAssignId srcArgIdx, TIRA_ARG_SYMBOL, targetVarIdx
    END IF
  END IF

END SUB ' tiraEmitPassByRefCopyOutId

''''''''''''''''''''''''
SUB tiraEnsureStringAlloc (descPtrVar$, targetAddrVar$)

  tiraCheckActive ("tiraEnsureStringAlloc")
  IF tiraLineCheck THEN EXIT SUB

  skipNullLbl$ = tiraLabelCreateNew$("SKIP_NULL")
  tiraJmpCond "JNE", descPtrVar$, "0", skipNullLbl$

  tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, 24"
  tiraNew TC_GET_RET, descPtrVar$

  ' Ensure the new descriptor allocation is successful before writing to memory
  skipOomLbl$ = tiraLabelCreateNew$("ENSURE_STR_OOM_SKIP")
  tiraJmpCond "JNE", descPtrVar$, "0", skipOomLbl$

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRsp

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 1 THEN strVarData$(returnedData2) = "OUT OF MEMORY"

  tiraCall "RT_PRINT_STR", 1, "!G_ERR_DSC_OOM"
  tiraCall "RT_CRLF", 0, ""

  IF cm.HasGraphics = 1 THEN
    tiraCall "RT_SWAP_BUFFERS", 0, ""
  END IF

  tiraJmp "@END_PROGRAM"

  tiraLabel skipOomLbl$

  tiraWriteMem targetAddrVar$, descPtrVar$, "8"

  tiraLabel skipNullLbl$

END SUB ' tiraEnsureStringAlloc

''''''''''''''''''''''''
SUB tiraEnsureStringAllocId (descPtrVal AS LONG, targetAddrType AS LONG, targetAddrVal AS _INTEGER64)

  tiraCheckActive ("tiraEnsureStringAllocId")
  IF tiraLineCheck THEN EXIT SUB

  DIM skipNullLblIdx AS LONG
  DIM heapAllocIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG

  skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 0, skipNullLblIdx

  ff = resolveSymbol("IAT_HEAPALLOC")
  IF ff = 0 THEN EXIT SUB
  heapAllocIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  IF ff = 0 THEN EXIT SUB
  processHeapIdx = returnedData2

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_LITERAL, 24
  tiraGetRetId descPtrVal

  ' Ensure the new descriptor allocation is successful before writing to memory
  skipOomLblIdx = tiraLabelCreateNewId&("ENSURE_STR_OOM_SKIP")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 0, skipOomLblIdx

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRsp

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 0 THEN EXIT SUB
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = "OUT OF MEMORY"

  ff = resolveSymbol("RT_PRINT_STR")
  IF ff = 0 THEN EXIT SUB
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("RT_CRLF")
  IF ff = 0 THEN EXIT SUB
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    IF ff = 0 THEN EXIT SUB
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 0 THEN EXIT SUB
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

  tiraLabelId skipOomLblIdx

  tiraWriteMemId targetAddrType, targetAddrVal, TIRA_ARG_SYMBOL, descPtrVal, TIRA_ARG_LITERAL, 8

  tiraLabelId skipNullLblIdx

END SUB ' tiraEnsureStringAllocId

''''''''''''''''''''''''
SUB tiraFatalError (errorText$)

  tiraCheckActive ("tiraFatalError")
  IF tiraLineCheck THEN EXIT SUB

  DIM winScale AS LONG

  ' Repair the stack to pristine state to guarantee ABI compliance for the print APIs
  tiraSetRsp

  IF cm.HasGraphics = 1 THEN
    ' Release spinlock immediately in case crash occurred during a backbuffer swap
    tiraAssign "!G_WND_FLG_RENDER_LOCK", "0"

    ' Restore corrupted window dimensions to prevent main thread stretchblt crash
    lblFixFs$ = tiraLabelCreateNew$("FATAL_FIX_FS")
    lblFixDone$ = tiraLabelCreateNew$("FATAL_FIX_DONE")

    tiraJmpCond "JE", "!G_GFX_VAL_IS_FULLSCREEN", "1", lblFixFs$

    ' Windowed mode restore
    wWidth$ = tiraDimVar$("T", TYPE_LONG)
    wHeight$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign wWidth$, LTRIM$(STR$(gfxConfig.SizeX))
    tiraAssign wHeight$, LTRIM$(STR$(gfxConfig.SizeY))

    skipGDFixLbl$ = tiraLabelCreateNew$("FATAL_GD_SKIP")
    tiraJmpCond "JE", "!G_GFX_FLG_GDOUBLE", "0", skipGDFixLbl$
    tiraOp TC_MUL, wWidth$, wWidth$, "2"
    tiraOp TC_MUL, wHeight$, wHeight$, "2"
    tiraLabel skipGDFixLbl$

    tiraAssign "!G_WND_VAL_WIDTH", wWidth$
    tiraAssign "!G_WND_VAL_HEIGHT", wHeight$
    tiraJmp lblFixDone$

    tiraLabel lblFixFs$
    ' Fullscreen mode restore
    tiraCall "IAT_GETSYSTEMMETRICS", 1, "0"
    tiraNew TC_GET_RET, "!G_WND_VAL_WIDTH"
    tiraCall "IAT_GETSYSTEMMETRICS", 1, "1"
    tiraNew TC_GET_RET, "!G_WND_VAL_HEIGHT"

    tiraLabel lblFixDone$

    ' Sanitize the GDI text overlay counts to prevent the font from glitching out with garbage memory
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "0"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_BACK", "0"

    ' Reset cursor and viewport bounds to guarantee visibility
    tiraAssign "!G_GFX_VAL_VIEW_X1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_Y1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_X2", LTRIM$(STR$(gfxConfig.SizeX))
    tiraAssign "!G_GFX_VAL_VIEW_Y2", LTRIM$(STR$(gfxConfig.SizeY))
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"

    ' Force a high-contrast palette index for the error message
    tiraAssign "!G_GFX_VAL_FG", "15"
    tiraAssign "!G_GFX_VAL_LAST_BG", "0"

    ' Zero out the top section of the screen to guarantee the text isn't obscured
    tiraMemSet "!G_GFX_PTR_FRMB_BACK", "0", LTRIM$(STR$(gfxConfig.SizeX * 40))
  END IF

  errStr$ = CHR$(34) + errorText$ + " ON LINE " + CHR$(34)
  tiraCall "RT_PRINT_STR", 1, errStr$
  tiraCall "RT_PRINT_INT", 1, "!G_SYS_VAL_CURRENT_LINE"
  tiraCall "RT_CRLF", 0, ""

  IF cm.HasGraphics = 1 THEN
    tiraCall "RT_SWAP_BUFFERS", 0, ""
  END IF

  tiraJmp "@END_PROGRAM"

END SUB ' tiraFatalError

''''''''''''''''''''''''
SUB tiraFatalErrorId (errorText$)

  tiraCheckActive ("tiraFatalErrorId")
  IF tiraLineCheck THEN EXIT SUB

  DIM renderLockIdx AS LONG
  DIM isFullscreenIdx AS LONG
  DIM lblFixFsIdx AS LONG
  DIM lblFixDoneIdx AS LONG
  DIM wWidthIdx AS LONG
  DIM wHeightIdx AS LONG
  DIM skipGDFixLblIdx AS LONG
  DIM gDoubleIdx AS LONG
  DIM windowWidthIdx AS LONG
  DIM windowHeightIdx AS LONG
  DIM getSystemMetricsIdx AS LONG
  DIM frontCountIdx AS LONG
  DIM backCountIdx AS LONG
  DIM viewX1Idx AS LONG
  DIM viewY1Idx AS LONG
  DIM viewX2Idx AS LONG
  DIM viewY2Idx AS LONG
  DIM viewOffsetXIdx AS LONG
  DIM viewOffsetYIdx AS LONG
  DIM foregroundIdx AS LONG
  DIM backgroundIdx AS LONG
  DIM frameBackIdx AS LONG
  DIM errorDescIdx AS LONG
  DIM printStrIdx AS LONG
  DIM currentLineIdx AS LONG
  DIM printIntIdx AS LONG
  DIM crlfIdx AS LONG
  DIM swapBuffersIdx AS LONG
  DIM endProgramIdx AS LONG

  ' Repair the stack to pristine state to guarantee ABI compliance for the print APIs
  tiraSetRsp

  IF cm.HasGraphics = 1 THEN
    ' Release spinlock immediately in case crash occurred during a backbuffer swap
    ff = resolveSymbol("!G_WND_FLG_RENDER_LOCK")
    renderLockIdx = returnedData2
    tiraAssignId renderLockIdx, TIRA_ARG_LITERAL, 0

    ' Restore corrupted window dimensions to prevent main thread stretchblt crash
    lblFixFsIdx = tiraLabelCreateNewId&("FATAL_FIX_FS")
    lblFixDoneIdx = tiraLabelCreateNewId&("FATAL_FIX_DONE")

    ff = resolveSymbol("!G_GFX_VAL_IS_FULLSCREEN")
    isFullscreenIdx = returnedData2
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, isFullscreenIdx, TIRA_ARG_LITERAL, 1, lblFixFsIdx

    ' Windowed mode restore
    wWidthIdx = tiraDimVarId&("T", TYPE_LONG)
    wHeightIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraAssignId wWidthIdx, TIRA_ARG_LITERAL, gfxConfig.SizeX
    tiraAssignId wHeightIdx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    skipGDFixLblIdx = tiraLabelCreateNewId&("FATAL_GD_SKIP")
    ff = resolveSymbol("!G_GFX_FLG_GDOUBLE")
    gDoubleIdx = returnedData2
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, gDoubleIdx, TIRA_ARG_LITERAL, 0, skipGDFixLblIdx
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, wWidthIdx, TIRA_ARG_SYMBOL, wWidthIdx, TIRA_ARG_LITERAL, 2
    tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, wHeightIdx, TIRA_ARG_SYMBOL, wHeightIdx, TIRA_ARG_LITERAL, 2
    tiraLabelId skipGDFixLblIdx

    ff = resolveSymbol("!G_WND_VAL_WIDTH")
    windowWidthIdx = returnedData2
    tiraAssignId windowWidthIdx, TIRA_ARG_SYMBOL, wWidthIdx

    ff = resolveSymbol("!G_WND_VAL_HEIGHT")
    windowHeightIdx = returnedData2
    tiraAssignId windowHeightIdx, TIRA_ARG_SYMBOL, wHeightIdx
    tiraJmpId lblFixDoneIdx

    tiraLabelId lblFixFsIdx
    ' Fullscreen mode restore
    ff = resolveSymbol("IAT_GETSYSTEMMETRICS")
    getSystemMetricsIdx = returnedData2
    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 0
    tiraGetRetId windowWidthIdx
    tiraCallId1 getSystemMetricsIdx, TIRA_ARG_LITERAL, 1
    tiraGetRetId windowHeightIdx

    tiraLabelId lblFixDoneIdx

    ' Sanitize the GDI text overlay counts to prevent the font from glitching out with garbage memory
    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
    frontCountIdx = returnedData2
    tiraAssignId frontCountIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    backCountIdx = returnedData2
    tiraAssignId backCountIdx, TIRA_ARG_LITERAL, 0

    ' Reset cursor and viewport bounds to guarantee visibility
    ff = resolveSymbol("!G_GFX_VAL_VIEW_X1")
    viewX1Idx = returnedData2
    tiraAssignId viewX1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y1")
    viewY1Idx = returnedData2
    tiraAssignId viewY1Idx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_X2")
    viewX2Idx = returnedData2
    tiraAssignId viewX2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeX

    ff = resolveSymbol("!G_GFX_VAL_VIEW_Y2")
    viewY2Idx = returnedData2
    tiraAssignId viewY2Idx, TIRA_ARG_LITERAL, gfxConfig.SizeY

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_X")
    viewOffsetXIdx = returnedData2
    tiraAssignId viewOffsetXIdx, TIRA_ARG_LITERAL, 0

    ff = resolveSymbol("!G_GFX_VAL_VIEW_OFFSET_Y")
    viewOffsetYIdx = returnedData2
    tiraAssignId viewOffsetYIdx, TIRA_ARG_LITERAL, 0

    ' Force a high-contrast palette index for the error message
    ff = resolveSymbol("!G_GFX_VAL_FG")
    foregroundIdx = returnedData2
    tiraAssignId foregroundIdx, TIRA_ARG_LITERAL, 15

    ff = resolveSymbol("!G_GFX_VAL_LAST_BG")
    backgroundIdx = returnedData2
    tiraAssignId backgroundIdx, TIRA_ARG_LITERAL, 0

    ' Zero out the top section of the screen to guarantee the text isn't obscured
    ff = resolveSymbol("!G_GFX_PTR_FRMB_BACK")
    frameBackIdx = returnedData2
    tiraMemSetId TIRA_ARG_SYMBOL, frameBackIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, gfxConfig.SizeX * 40
  END IF

  ff = resolveSymbol("!C_PRS_DSC_LTRL_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter))))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    EXIT SUB
  END IF

  IF ff = 0 THEN
    tira_Cancel
    EXIT SUB
  END IF
  errorDescIdx = returnedData2
  strVarData$(errorDescIdx) = errorText$ + " ON LINE "

  ff = resolveSymbol("RT_PRINT_STR")
  printStrIdx = returnedData2
  tiraCallId1 printStrIdx, TIRA_ARG_SYMBOL, errorDescIdx

  ff = resolveSymbol("!G_SYS_VAL_CURRENT_LINE")
  currentLineIdx = returnedData2
  ff = resolveSymbol("RT_PRINT_INT")
  printIntIdx = returnedData2
  tiraCallId1 printIntIdx, TIRA_ARG_SYMBOL, currentLineIdx

  ff = resolveSymbol("RT_CRLF")
  crlfIdx = returnedData2
  tiraCallId0 crlfIdx

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("RT_SWAP_BUFFERS")
    swapBuffersIdx = returnedData2
    tiraCallId0 swapBuffersIdx
  END IF

  ff = resolveSymbol("@END_PROGRAM")
  endProgramIdx = returnedData2
  tiraJmpId endProgramIdx

END SUB ' tiraFatalErrorId

''''''''''''''''''''''''
SUB tiraFlushFileWriteBuffer

  tiraCheckActive ("tiraFlushFileWriteBuffer")
  IF tiraLineCheck THEN EXIT SUB

  ff = findSymbol("!G_FLS_PTR_WRITE_BUFFER")
  IF ff = 0 THEN EXIT SUB

  ff = findSymbol("!G_FLS_PTR_WRITE_HANDLE")
  IF ff = 0 THEN EXIT SUB

  ff = findSymbol("!G_FLS_IDX_WRITE_COUNT")
  IF ff = 0 THEN EXIT SUB

  skipFlushLbl$ = tiraLabelCreateNew$("FILE_WRITE_FLUSH_SKIP")

  tiraJmpCond "JLE", "!G_FLS_IDX_WRITE_COUNT", "0", skipFlushLbl$
  tiraJmpCond "JE", "!G_FLS_PTR_WRITE_HANDLE", "0", skipFlushLbl$
  tiraJmpCond "JE", "!G_FLS_PTR_WRITE_BUFFER", "0", skipFlushLbl$

  numWrt$ = tiraDimVar$("T", TYPE_LONG)
  numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

  tiraCall "IAT_WRITEFILE", 5, "!G_FLS_PTR_WRITE_HANDLE, !G_FLS_PTR_WRITE_BUFFER, !G_FLS_IDX_WRITE_COUNT, " + numWrtPtr$ + ", 0"

  tiraAssign "!G_FLS_IDX_WRITE_COUNT", "0"
  tiraAssign "!G_FLS_PTR_WRITE_HANDLE", "0"

  tiraLabel skipFlushLbl$

END SUB ' tiraFlushFileWriteBuffer

''''''''''''''''''''''''
SUB tiraFlushFileWriteBufferId

  tiraCheckActive ("tiraFlushFileWriteBufferId")
  IF tiraLineCheck THEN EXIT SUB

  DIM writeBufferIdx AS LONG
  DIM writeHandleIdx AS LONG
  DIM writeCountIdx AS LONG
  DIM writeFileIdx AS LONG
  DIM skipFlushLblIdx AS LONG
  DIM numWrtIdx AS LONG
  DIM numWrtPtrIdx AS LONG

  ff = findSymbol("!G_FLS_PTR_WRITE_BUFFER")
  IF ff = 0 THEN EXIT SUB
  writeBufferIdx = returnedData2

  ff = findSymbol("!G_FLS_PTR_WRITE_HANDLE")
  IF ff = 0 THEN EXIT SUB
  writeHandleIdx = returnedData2

  ff = findSymbol("!G_FLS_IDX_WRITE_COUNT")
  IF ff = 0 THEN EXIT SUB
  writeCountIdx = returnedData2

  ff = resolveSymbol("IAT_WRITEFILE")
  writeFileIdx = returnedData2

  skipFlushLblIdx = tiraLabelCreateNewId&("FILE_WRITE_FLUSH_SKIP")

  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeHandleIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_LITERAL, 0, skipFlushLblIdx

  numWrtIdx = tiraDimVarId&("T", TYPE_LONG)
  numWrtPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_SYMBOL, numWrtIdx

  tiraCallId5 writeFileIdx, TIRA_ARG_SYMBOL, writeHandleIdx, TIRA_ARG_SYMBOL, writeBufferIdx, TIRA_ARG_SYMBOL, writeCountIdx, TIRA_ARG_SYMBOL, numWrtPtrIdx, TIRA_ARG_LITERAL, 0

  tiraAssignId writeCountIdx, TIRA_ARG_LITERAL, 0
  tiraAssignId writeHandleIdx, TIRA_ARG_LITERAL, 0

  tiraLabelId skipFlushLblIdx

END SUB ' tiraFlushFileWriteBufferId

''''''''''''''''''''''''
FUNCTION tiraForceInt$ (srcVar$)

  tiraCheckActive ("tiraForceInt$")

  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM firstChar AS STRING * 1
  DIM resVarIdx AS LONG

  firstChar = LEFT$(srcVar$, 1)

  ' Prevent literals from being evaluated as variable names in the symbol table
  IF (firstChar >= "0" AND firstChar <= "9") OR firstChar = "-" OR firstChar = "." OR firstChar = CHR$(34) OR (firstChar = "&" AND (UCASE$(MID$(srcVar$, 2, 1)) = "H" OR UCASE$(MID$(srcVar$, 2, 1)) = "O")) THEN
    ' If the literal contains a decimal, truncate it into an integer
    IF INSTR(srcVar$, ".") > 0 THEN
      tiraForceInt$ = LTRIM$(RTRIM$(STR$(INT(VAL(srcVar$)))))
    ELSE
      tiraForceInt$ = srcVar$
    END IF
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(srcVar$)
  IF ff = 1 THEN
    vIdx = returnedData2
    dt = returnedData3

    ' If the virtual register holds a float, we must create a new integer temp
    ' register and explicitly cast it to force a TIRA conversion in the scheduler
    IF dt = TYPE_SINGLE OR dt = TYPE_DOUBLE THEN
      resVarIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx, TIRA_ARG_LITERAL, TYPE_LONG
      tiraForceInt$ = RTRIM$(symbols(resVarIdx).RecordName)
    ELSE
      tiraForceInt$ = srcVar$
    END IF
  ELSE
    tiraForceInt$ = srcVar$
  END IF

END FUNCTION ' tiraForceInt$

''''''''''''''''''''''''
SUB tiraForceIntArgId (srcType AS LONG, srcVal AS _INTEGER64, srcDataType AS LONG)

  tiraCheckActive ("tiraForceIntArgId")

  DIM resVarIdx AS LONG

  tiraParsedArgType = srcType
  tiraParsedArgVal = srcVal

  ' If the virtual register holds a float, we must create a new integer temp
  ' register and explicitly cast it to force a TIRA conversion in the scheduler
  IF srcDataType = TYPE_SINGLE OR srcDataType = TYPE_DOUBLE THEN
    resVarIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, resVarIdx, srcType, srcVal, TIRA_ARG_LITERAL, TYPE_LONG
    tiraParsedArgType = TIRA_ARG_SYMBOL
    tiraParsedArgVal = resVarIdx
  END IF

END SUB ' tiraForceIntArgId

''''''''''''''''''''''''
FUNCTION tiraFrontendCalcAddress$ (vName$, indicesStr$, udtOffset AS LONG)

  tiraCheckActive ("tiraFrontendCalcAddress$")
  IF tiraLineCheck THEN EXIT FUNCTION

  DIM vIdx AS LONG
  DIM vDataType AS LONG
  DIM elemSize AS LONG
  DIM actualName AS STRING
  DIM idxVars$(255)
  DIM numIndices AS LONG
  DIM commaPos AS LONG
  DIM tempStr$
  DIM useStaticLayout AS LONG
  DIM staticLayoutStart AS LONG
  DIM staticDimensionIdx AS LONG
  DIM staticLowerBound AS LONG
  DIM staticElementCount AS LONG
  DIM staticStride AS _INTEGER64
  DIM descriptorByteSize AS LONG

  DIM dimLBound$
  DIM dimNumElems$
  DIM idxOffset$
  DIM dimNumElems64$
  DIM idxOffset64$

  returnAddrVar = ""

  ' Split indicesStr$ by comma
  numIndices = 0
  IF indicesStr$ <> "" THEN
    tempStr$ = indicesStr$
    DO
      commaPos = INSTR(tempStr$, ",")
      IF commaPos > 0 THEN
        numIndices = numIndices + 1
        idxVars$(numIndices) = LEFT$(tempStr$, commaPos - 1)
        tempStr$ = MID$(tempStr$, commaPos + 1)
      ELSE
        numIndices = numIndices + 1
        idxVars$(numIndices) = tempStr$
        EXIT DO
      END IF
    LOOP
  END IF

  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tiraFrontendCalcAddress$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2
  vDataType = returnedData3

  useStaticLayout = 0

  IF symbols(vIdx).IsArray = ARRAY_KIND_STATIC THEN
    IF numIndices > 0 AND numIndices = symbols(vIdx).NumDimensions THEN
      staticLayoutStart = staticArrayLayoutStart(vIdx)

      IF staticLayoutStart > 0 THEN
        IF staticLayoutStart + numIndices - 1 <= staticArrayDimensionCount THEN useStaticLayout = 1
      END IF
    END IF
  END IF

  baseAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > 0 THEN
    IF useStaticLayout = 1 THEN
      tiraOp TC_ADDRESS_OF, baseAddrVar$, "#" + LTRIM$(STR$(vIdx)), ""
      descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
      tiraOp TC_ADD, baseAddrVar$, baseAddrVar$, LTRIM$(STR$(descriptorByteSize))
    ELSE
      descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""
      tiraNew TC_READ_MEM, baseAddrVar$ + ", " + descAddr$
    END IF
  ELSE
    tiraOp TC_ADDRESS_OF, baseAddrVar$, "#" + LTRIM$(STR$(vIdx)), ""
  END IF

  offsetVar$ = ""

  IF numIndices > 0 THEN
    IF useStaticLayout = 1 THEN
      ' Static arrays use fixed metadata without descriptor reads or runtime stride construction
      FOR iDim = 1 TO numIndices
        curIdx$ = idxVars$(iDim)
        staticDimensionIdx = staticLayoutStart + iDim - 1
        staticLowerBound = staticArrayDimensions(staticDimensionIdx).LowerBound
        staticElementCount = staticArrayDimensions(staticDimensionIdx).ElementCount
        staticStride = staticArrayDimensions(staticDimensionIdx).Stride

        idxOffset$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_SUB, idxOffset$, curIdx$, LTRIM$(STR$(staticLowerBound))

        idxOffset64$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_CAST, idxOffset64$, idxOffset$, LTRIM$(STR$(TYPE_INTEGER64))

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraNode(t.LineCount).OpCode = TC_BOUNDS_CHECK

          tiraSetNodeArg 1, idxOffset64$
          tiraSetNodeArg 2, LTRIM$(STR$(staticElementCount))

          ' Remove stale data from remainder
          tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
          tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

          t.LineCount = t.LineCount + 1
        END IF

        IF staticStride = 1 THEN
          idxTerm$ = idxOffset64$
        ELSE
          idxTerm$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_MUL, idxTerm$, idxOffset64$, LTRIM$(STR$(staticStride))
        END IF

        IF offsetVar$ = "" THEN
          offsetVar$ = idxTerm$
        ELSE
          tiraOp TC_ADD, offsetVar$, offsetVar$, idxTerm$
        END IF
      NEXT iDim
    ELSE
      offsetVar$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign offsetVar$, "0"

      multiplier$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign multiplier$, "1"

      FOR iDim = 1 TO numIndices
        curIdx$ = idxVars$(iDim)

        dimLBound$ = tiraDimVar$("T", TYPE_LONG)
        tiraNew TC_READ_MEM_OFFSET, dimLBound$ + ", " + descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8)))

        dimNumElems$ = tiraDimVar$("T", TYPE_LONG)
        tiraNew TC_READ_MEM_OFFSET, dimNumElems$ + ", " + descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8) + 4))

        idxOffset$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_SUB, idxOffset$, curIdx$, dimLBound$

        dimNumElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_CAST, dimNumElems64$, dimNumElems$, LTRIM$(STR$(TYPE_INTEGER64))

        idxOffset64$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_CAST, idxOffset64$, idxOffset$, LTRIM$(STR$(TYPE_INTEGER64))

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraNode(t.LineCount).OpCode = TC_BOUNDS_CHECK

          tiraSetNodeArg 1, idxOffset64$
          tiraSetNodeArg 2, dimNumElems64$

          ' Remove stale data from remainder
          tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
          tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

          t.LineCount = t.LineCount + 1
        END IF

        idxTerm$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_MUL, idxTerm$, idxOffset64$, multiplier$

        tiraOp TC_ADD, offsetVar$, offsetVar$, idxTerm$

        ' Update multiplier for next dimension: multiplier = multiplier * dimNumElems64
        IF iDim < numIndices THEN
          tiraOp TC_MUL, multiplier$, multiplier$, dimNumElems64$
        END IF
      NEXT iDim
    END IF

    elemSize = retElementByteSize(vIdx)

  END IF

  finalAddr$ = baseAddrVar$
  IF offsetVar$ <> "" THEN

    IF elemSize = 1 OR elemSize = 2 OR elemSize = 4 OR elemSize = 8 THEN
      ' Fast Path: Hardware Array Scaling (TC_LEA_SIB)
      newAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraLeaSIB newAddr$, finalAddr$, offsetVar$, LTRIM$(RTRIM$(STR$(elemSize)))
      finalAddr$ = newAddr$
    ELSE
      ' Slow Path: Fallback to TC_MUL and TC_ADD
      byteOffset$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_MUL, byteOffset$, offsetVar$, LTRIM$(RTRIM$(STR$(elemSize)))

      newAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADD, newAddr$, finalAddr$, byteOffset$
      finalAddr$ = newAddr$
    END IF
  END IF

  IF udtOffset > 0 THEN
    newAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, newAddr$, finalAddr$, LTRIM$(RTRIM$(STR$(udtOffset)))
    finalAddr$ = newAddr$
  END IF

  returnAddrVar = finalAddr$
  tiraFrontendCalcAddress$ = finalAddr$

END FUNCTION ' tiraFrontendCalcAddress$

''''''''''''''''''''''''
FUNCTION tiraFrontendCalcAddressArgsId& (vIdx AS LONG, numIndices AS LONG, udtOffset AS LONG)

  tiraCheckActive ("tiraFrontendCalcAddressArgsId&")
  IF tiraLineCheck THEN EXIT FUNCTION

  DIM elemSize AS LONG
  DIM useStaticLayout AS LONG
  DIM staticLayoutStart AS LONG
  DIM staticDimensionIdx AS LONG
  DIM staticLowerBound AS LONG
  DIM staticElementCount AS LONG
  DIM staticStride AS _INTEGER64
  DIM descriptorByteSize AS LONG
  DIM baseAddrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM hasOffset AS LONG
  DIM multiplierIdx AS LONG
  DIM dimLBoundIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM idxOffsetIdx AS LONG
  DIM idxOffset64Idx AS LONG
  DIM idxTermIdx AS LONG
  DIM curIdxType AS LONG
  DIM curIdxVal AS _INTEGER64
  DIM finalAddrIdx AS LONG
  DIM newAddrIdx AS LONG
  DIM byteOffsetIdx AS LONG

  returnAddrVar = ""

  IF vIdx < 0 OR vIdx >= symbolCount THEN
    throwCompilerError "INVALID SYMBOL INDEX IN ADDRESS CALCULATION", ASIS, 0
    tiraFrontendCalcAddressArgsId& = 0
    EXIT FUNCTION
  END IF

  IF numIndices < 0 OR numIndices > 255 THEN
    throwCompilerError "INVALID INDEX COUNT IN ADDRESS CALCULATION", ASIS, 0
    tiraFrontendCalcAddressArgsId& = 0
    EXIT FUNCTION
  END IF

  useStaticLayout = 0

  IF symbols(vIdx).IsArray = ARRAY_KIND_STATIC THEN
    IF numIndices > 0 AND numIndices = symbols(vIdx).NumDimensions THEN
      staticLayoutStart = staticArrayLayoutStart(vIdx)

      IF staticLayoutStart > 0 THEN
        IF staticLayoutStart + numIndices - 1 <= staticArrayDimensionCount THEN useStaticLayout = 1
      END IF
    END IF
  END IF

  baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > 0 THEN
    IF useStaticLayout = 1 THEN
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
      descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_LITERAL, descriptorByteSize
    ELSE
      descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx
      tiraReadMemId baseAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx
    END IF
  ELSE
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
  END IF

  offsetVarIdx = 0
  hasOffset = 0

  IF numIndices > 0 THEN
    IF useStaticLayout = 1 THEN
      ' Static arrays use fixed metadata without descriptor reads or runtime stride construction
      FOR iDim = 1 TO numIndices
        curIdxType = tiraParsedArrayArgType(iDim)
        curIdxVal = tiraParsedArrayArgVal(iDim)

        staticDimensionIdx = staticLayoutStart + iDim - 1
        staticLowerBound = staticArrayDimensions(staticDimensionIdx).LowerBound
        staticElementCount = staticArrayDimensions(staticDimensionIdx).ElementCount
        staticStride = staticArrayDimensions(staticDimensionIdx).Stride

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_LITERAL, staticLowerBound

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticElementCount
        END IF

        IF staticStride = 1 THEN
          idxTermIdx = idxOffset64Idx
        ELSE
          idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticStride
        END IF

        IF hasOffset = 0 THEN
          offsetVarIdx = idxTermIdx
          hasOffset = 1
        ELSE
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx
        END IF
      NEXT iDim
    ELSE
      offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId offsetVarIdx, TIRA_ARG_LITERAL, 0
      hasOffset = 1

      multiplierIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId multiplierIdx, TIRA_ARG_LITERAL, 1

      FOR iDim = 1 TO numIndices
        curIdxType = tiraParsedArrayArgType(iDim)
        curIdxVal = tiraParsedArrayArgVal(iDim)

        dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8)

        dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_SYMBOL, dimLBoundIdx

        dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF

        idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, multiplierIdx

        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx

        ' Update multiplier for next dimension: multiplier = multiplier * dimNumElems64
        IF iDim < numIndices THEN
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF
      NEXT iDim
    END IF

    elemSize = retElementByteSize(vIdx)

  END IF

  finalAddrIdx = baseAddrIdx
  IF hasOffset = 1 THEN

    IF elemSize = 1 OR elemSize = 2 OR elemSize = 4 OR elemSize = 8 THEN
      ' Fast Path: Hardware Array Scaling (TC_LEA_SIB)
      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize
      finalAddrIdx = newAddrIdx
    ELSE
      ' Slow Path: Fallback to TC_MUL and TC_ADD
      byteOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteOffsetIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize

      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, byteOffsetIdx
      finalAddrIdx = newAddrIdx
    END IF
  END IF

  IF udtOffset > 0 THEN
    newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, udtOffset
    finalAddrIdx = newAddrIdx
  END IF

  returnAddrVar = RTRIM$(symbols(finalAddrIdx).RecordName)
  tiraFrontendCalcAddressArgsId& = finalAddrIdx

END FUNCTION ' tiraFrontendCalcAddressArgsId&

''''''''''''''''''''''''
FUNCTION tiraFrontendCalcAddressId& (vIdx AS LONG, indicesStr$, udtOffset AS LONG)

  tiraCheckActive ("tiraFrontendCalcAddressId&")
  IF tiraLineCheck THEN EXIT FUNCTION

  DIM elemSize AS LONG
  DIM idxVars$(255)
  DIM numIndices AS LONG
  DIM commaPos AS LONG
  DIM tempStr$
  DIM useStaticLayout AS LONG
  DIM staticLayoutStart AS LONG
  DIM staticDimensionIdx AS LONG
  DIM staticLowerBound AS LONG
  DIM staticElementCount AS LONG
  DIM staticStride AS _INTEGER64
  DIM descriptorByteSize AS LONG
  DIM baseAddrIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM hasOffset AS LONG
  DIM multiplierIdx AS LONG
  DIM dimLBoundIdx AS LONG
  DIM dimNumElemsIdx AS LONG
  DIM dimNumElems64Idx AS LONG
  DIM idxOffsetIdx AS LONG
  DIM idxOffset64Idx AS LONG
  DIM idxTermIdx AS LONG
  DIM curIdxType AS LONG
  DIM curIdxVal AS _INTEGER64
  DIM finalAddrIdx AS LONG
  DIM newAddrIdx AS LONG
  DIM byteOffsetIdx AS LONG

  returnAddrVar = ""

  ' Split indicesStr$ by comma
  numIndices = 0
  IF indicesStr$ <> "" THEN
    tempStr$ = indicesStr$
    DO
      commaPos = INSTR(tempStr$, ",")
      IF commaPos > 0 THEN
        numIndices = numIndices + 1
        idxVars$(numIndices) = LEFT$(tempStr$, commaPos - 1)
        tempStr$ = MID$(tempStr$, commaPos + 1)
      ELSE
        numIndices = numIndices + 1
        idxVars$(numIndices) = tempStr$
        EXIT DO
      END IF
    LOOP
  END IF

  IF vIdx < 0 OR vIdx >= symbolCount THEN
    throwCompilerError "INVALID SYMBOL INDEX IN ADDRESS CALCULATION", ASIS, 0
    tiraFrontendCalcAddressId& = 0
    EXIT FUNCTION
  END IF

  useStaticLayout = 0

  IF symbols(vIdx).IsArray = ARRAY_KIND_STATIC THEN
    IF numIndices > 0 AND numIndices = symbols(vIdx).NumDimensions THEN
      staticLayoutStart = staticArrayLayoutStart(vIdx)

      IF staticLayoutStart > 0 THEN
        IF staticLayoutStart + numIndices - 1 <= staticArrayDimensionCount THEN useStaticLayout = 1
      END IF
    END IF
  END IF

  baseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > 0 THEN
    IF useStaticLayout = 1 THEN
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
      descriptorByteSize = 16 + (symbols(vIdx).NumDimensions * 8)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_LITERAL, descriptorByteSize
    ELSE
      descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx
      tiraReadMemId baseAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx
    END IF
  ELSE
    tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_SYMBOL, vIdx
  END IF

  offsetVarIdx = 0
  hasOffset = 0

  IF numIndices > 0 THEN
    IF useStaticLayout = 1 THEN
      ' Static arrays use fixed metadata without descriptor reads or runtime stride construction
      FOR iDim = 1 TO numIndices
        tiraParseArgToNode idxVars$(iDim)
        curIdxType = tiraParsedArgType
        curIdxVal = tiraParsedArgVal

        staticDimensionIdx = staticLayoutStart + iDim - 1
        staticLowerBound = staticArrayDimensions(staticDimensionIdx).LowerBound
        staticElementCount = staticArrayDimensions(staticDimensionIdx).ElementCount
        staticStride = staticArrayDimensions(staticDimensionIdx).Stride

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_LITERAL, staticLowerBound

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticElementCount
        END IF

        IF staticStride = 1 THEN
          idxTermIdx = idxOffset64Idx
        ELSE
          idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_LITERAL, staticStride
        END IF

        IF hasOffset = 0 THEN
          offsetVarIdx = idxTermIdx
          hasOffset = 1
        ELSE
          tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx
        END IF
      NEXT iDim
    ELSE
      offsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId offsetVarIdx, TIRA_ARG_LITERAL, 0
      hasOffset = 1

      multiplierIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId multiplierIdx, TIRA_ARG_LITERAL, 1

      FOR iDim = 1 TO numIndices
        tiraParseArgToNode idxVars$(iDim)
        curIdxType = tiraParsedArgType
        curIdxVal = tiraParsedArgVal

        dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8)

        dimNumElemsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimNumElemsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 16 + ((iDim - 1) * 8) + 4

        idxOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, idxOffsetIdx, curIdxType, curIdxVal, TIRA_ARG_SYMBOL, dimLBoundIdx

        dimNumElems64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, dimNumElems64Idx, TIRA_ARG_SYMBOL, dimNumElemsIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        idxOffset64Idx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, idxOffsetIdx, TIRA_ARG_LITERAL, TYPE_INTEGER64

        ' Release QuickBASIC omitted array bounds checks unless debug code was enabled
        IF cm.ClassicMode = 0 THEN
          tiraBoundsCheckId TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF

        idxTermIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, idxTermIdx, TIRA_ARG_SYMBOL, idxOffset64Idx, TIRA_ARG_SYMBOL, multiplierIdx

        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, idxTermIdx

        ' Update multiplier for next dimension: multiplier = multiplier * dimNumElems64
        IF iDim < numIndices THEN
          tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, multiplierIdx, TIRA_ARG_SYMBOL, dimNumElems64Idx
        END IF
      NEXT iDim
    END IF

    elemSize = retElementByteSize(vIdx)

  END IF

  finalAddrIdx = baseAddrIdx
  IF hasOffset = 1 THEN

    IF elemSize = 1 OR elemSize = 2 OR elemSize = 4 OR elemSize = 8 THEN
      ' Fast Path: Hardware Array Scaling (TC_LEA_SIB)
      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId4 TC_LEA_SIB, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize
      finalAddrIdx = newAddrIdx
    ELSE
      ' Slow Path: Fallback to TC_MUL and TC_ADD
      byteOffsetIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, byteOffsetIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, elemSize

      newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_SYMBOL, byteOffsetIdx
      finalAddrIdx = newAddrIdx
    END IF
  END IF

  IF udtOffset > 0 THEN
    newAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newAddrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, udtOffset
    finalAddrIdx = newAddrIdx
  END IF

  returnAddrVar = RTRIM$(symbols(finalAddrIdx).RecordName)
  tiraFrontendCalcAddressId& = finalAddrIdx

END FUNCTION ' tiraFrontendCalcAddressId&

''''''''''''''''''''''''
FUNCTION tiraGetPrecedence& (opVal AS LONG)

  tiraCheckActive ("tiraGetPrecedence")

  DIM precLevel AS _UNSIGNED LONG

  SELECT CASE opVal

    CASE TOK_OP_POW
      precLevel = 11
    CASE TOK_OP_UNARY_MINUS
      precLevel = 10
    CASE TOK_OP_MUL, TOK_OP_DIV
      precLevel = 9
    CASE TOK_OP_IDIV
      precLevel = 8
    CASE TOK_MOD
      precLevel = 7
    CASE TOK_OP_PLUS, TOK_OP_MINUS
      precLevel = 6
    CASE TOK_OP_EQUAL, TOK_OP_LESS, TOK_OP_GREATER, TOK_OP_LESS_EQUAL, TOK_OP_GREATER_EQUAL, TOK_OP_NOT_EQUAL
      precLevel = 5
    CASE TOK_OP_UNARY_NOT
      precLevel = 4
    CASE TOK_AND, TOK_NAND
      precLevel = 3
    CASE TOK_OR, TOK_NOR
      precLevel = 2
    CASE TOK_XOR, TOK_XNOR
      precLevel = 1
    CASE ELSE
      precLevel = 0

  END SELECT ' opVal

  tiraGetPrecedence = precLevel

END FUNCTION ' tiraGetPrecedence

