  moveModeReadyLbl$ = tiraLabelCreateNew$("DRAW_MOVE_MODE_READY")
  moveRelativeLbl$ = tiraLabelCreateNew$("DRAW_MOVE_RELATIVE")

  turnReadyLbl$ = tiraLabelCreateNew$("DRAW_TURN_READY")

  tiraLabel drawLoopTop$

  tiraDrawCmdSkipWhitespace drawData$, drawIndex$, drawSize$
  tiraJmpCond "JGE", drawIndex$, drawSize$, drawDoneLbl$

  tiraOp TC_ADD, commandPtr$, drawData$, drawIndex$
  tiraNew TC_READ_MEM, commandByte$ + ", " + commandPtr$
  tiraOp TC_ADD, drawIndex$, drawIndex$, "1"

  tiraJmpCond "JE", commandByte$, "59", drawLoopTop$

  ' Fold lower-case command bytes to upper case
  tiraJmpCond "JL", commandByte$, "97", commandUpperDoneLbl$
  tiraJmpCond "JG", commandByte$, "122", commandUpperDoneLbl$
  tiraOp TC_SUB, commandByte$, commandByte$, "32"
  tiraLabel commandUpperDoneLbl$

  tiraJmpCond "JE", commandByte$, "66", drawBlindLbl$
  tiraJmpCond "JE", commandByte$, "78", drawNoMoveLbl$
  tiraJmpCond "JE", commandByte$, "77", drawMoveLbl$
  tiraJmpCond "JE", commandByte$, "85", drawUpLbl$
  tiraJmpCond "JE", commandByte$, "68", drawDownLbl$
  tiraJmpCond "JE", commandByte$, "76", drawLeftLbl$
  tiraJmpCond "JE", commandByte$, "82", drawRightLbl$
  tiraJmpCond "JE", commandByte$, "69", drawNELbl$
  tiraJmpCond "JE", commandByte$, "70", drawSELbl$
  tiraJmpCond "JE", commandByte$, "71", drawSWLbl$
  tiraJmpCond "JE", commandByte$, "72", drawNWLbl$
  tiraJmpCond "JE", commandByte$, "67", drawColorLbl$
  tiraJmpCond "JE", commandByte$, "83", drawScaleLbl$
  tiraJmpCond "JE", commandByte$, "65", drawAngleLbl$
  tiraJmpCond "JE", commandByte$, "84", drawTurnLbl$
  tiraJmpCond "JE", commandByte$, "80", drawPaintLbl$
  tiraJmp drawInvalidLbl$

  tiraLabel drawBlindLbl$
  tiraAssign blindVar$, "1"
  tiraJmp drawLoopTop$

  tiraLabel drawNoMoveLbl$
  tiraAssign noMoveVar$, "1"
  tiraJmp drawLoopTop$

  tiraLabel drawUpLbl$
  tiraAssign vectorX$, "0"
  tiraAssign vectorY$, "-1"
  tiraJmp directionAmountLbl$

  tiraLabel drawDownLbl$
  tiraAssign vectorX$, "0"
  tiraAssign vectorY$, "1"
  tiraJmp directionAmountLbl$

  tiraLabel drawLeftLbl$
  tiraAssign vectorX$, "-1"
  tiraAssign vectorY$, "0"
  tiraJmp directionAmountLbl$

  tiraLabel drawRightLbl$
  tiraAssign vectorX$, "1"
  tiraAssign vectorY$, "0"
  tiraJmp directionAmountLbl$

  tiraLabel drawNELbl$
  tiraAssign vectorX$, "1"
  tiraAssign vectorY$, "-1"
  tiraJmp directionAmountLbl$

  tiraLabel drawSELbl$
  tiraAssign vectorX$, "1"
  tiraAssign vectorY$, "1"
  tiraJmp directionAmountLbl$

  tiraLabel drawSWLbl$
  tiraAssign vectorX$, "-1"
  tiraAssign vectorY$, "1"
  tiraJmp directionAmountLbl$

  tiraLabel drawNWLbl$
  tiraAssign vectorX$, "-1"
  tiraAssign vectorY$, "-1"

  tiraLabel directionAmountLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JNE", numberFound$, "0", directionHaveAmountLbl$
  tiraAssign numberOne$, "1"

  tiraLabel directionHaveAmountLbl$

  tiraDrawCmdMoveVector vectorX$, vectorY$, numberOne$, "!G_GFX_V32_DRAWSCALE", drawSine$, drawCosine$, drawColor$, blindVar$, noMoveVar$, currentX$, currentY$
  tiraJmp drawLoopTop$

  tiraLabel drawMoveLbl$

  tiraDrawCmdSkipWhitespace drawData$, drawIndex$, drawSize$
  tiraJmpCond "JGE", drawIndex$, drawSize$, drawInvalidLbl$

  tiraOp TC_ADD, commandPtr$, drawData$, drawIndex$
  tiraNew TC_READ_MEM, commandByte$ + ", " + commandPtr$

  tiraAssign relativeMode$, "0"
  tiraJmpCond "JE", commandByte$, "43", moveRelativeSetLbl$
  tiraJmpCond "JNE", commandByte$, "45", moveModeReadyLbl$

  tiraLabel moveRelativeSetLbl$
  tiraAssign relativeMode$, "1"

  tiraLabel moveModeReadyLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$

  tiraDrawCmdSkipWhitespace drawData$, drawIndex$, drawSize$
  tiraJmpCond "JGE", drawIndex$, drawSize$, drawInvalidLbl$

  tiraOp TC_ADD, commandPtr$, drawData$, drawIndex$
  tiraNew TC_READ_MEM, commandByte$ + ", " + commandPtr$
  tiraJmpCond "JNE", commandByte$, "44", drawInvalidLbl$
  tiraOp TC_ADD, drawIndex$, drawIndex$, "1"

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberTwo$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$

  tiraJmpCond "JNE", relativeMode$, "0", moveRelativeLbl$

  tiraDrawCmdFinishMove numberOne$, numberTwo$, drawColor$, blindVar$, noMoveVar$, currentX$, currentY$
  tiraJmp drawLoopTop$

  tiraLabel moveRelativeLbl$

  tiraDrawCmdMoveVector numberOne$, numberTwo$, "1", "!G_GFX_V32_DRAWSCALE", drawSine$, drawCosine$, drawColor$, blindVar$, noMoveVar$, currentX$, currentY$
  tiraJmp drawLoopTop$

  tiraLabel drawColorLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$

  tiraOp TC_AND, drawColor$, numberOne$, "255"
  tiraAssign "!G_GFX_VAL_FG", drawColor$
  tiraJmp drawLoopTop$

  tiraLabel drawScaleLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$
  tiraJmpCond "JL", numberOne$, "1", drawInvalidLbl$
  tiraJmpCond "JG", numberOne$, "255", drawInvalidLbl$

  tiraAssign "!G_GFX_V32_DRAWSCALE", numberOne$
  tiraJmp drawLoopTop$

  tiraLabel drawAngleLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$
  tiraJmpCond "JL", numberOne$, "0", drawInvalidLbl$
  tiraJmpCond "JG", numberOne$, "3", drawInvalidLbl$

  tiraOp TC_MUL, "!G_GFX_V32_DRAWANGLE", numberOne$, "90"
  tiraDrawCmdSetRotation "!G_GFX_V32_DRAWANGLE", drawSine$, drawCosine$
  tiraJmp drawLoopTop$

  tiraLabel drawTurnLbl$

  tiraDrawCmdSkipWhitespace drawData$, drawIndex$, drawSize$
  tiraJmpCond "JGE", drawIndex$, drawSize$, drawInvalidLbl$

  tiraOp TC_ADD, commandPtr$, drawData$, drawIndex$
  tiraNew TC_READ_MEM, commandByte$ + ", " + commandPtr$

  tiraJmpCond "JE", commandByte$, "65", turnReadyLbl$
  tiraJmpCond "JNE", commandByte$, "97", drawInvalidLbl$

  tiraLabel turnReadyLbl$
  tiraOp TC_ADD, drawIndex$, drawIndex$, "1"

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$
  tiraJmpCond "JL", numberOne$, "-360", drawInvalidLbl$
  tiraJmpCond "JG", numberOne$, "360", drawInvalidLbl$

  tiraAssign "!G_GFX_V32_DRAWANGLE", numberOne$
  tiraDrawCmdSetRotation "!G_GFX_V32_DRAWANGLE", drawSine$, drawCosine$
  tiraJmp drawLoopTop$

  tiraLabel drawPaintLbl$

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberOne$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$

  tiraDrawCmdSkipWhitespace drawData$, drawIndex$, drawSize$
  tiraJmpCond "JGE", drawIndex$, drawSize$, drawInvalidLbl$

  tiraOp TC_ADD, commandPtr$, drawData$, drawIndex$
  tiraNew TC_READ_MEM, commandByte$ + ", " + commandPtr$
  tiraJmpCond "JNE", commandByte$, "44", drawInvalidLbl$
  tiraOp TC_ADD, drawIndex$, drawIndex$, "1"

  tiraDrawCmdReadNumber drawData$, drawIndex$, drawSize$, numberTwo$, numberFound$, numberInvalid$
  tiraJmpCond "JNE", numberInvalid$, "0", drawInvalidLbl$
  tiraJmpCond "JE", numberFound$, "0", drawInvalidLbl$

  tiraCall "RT_PAINT", 5, currentX$ + ", " + currentY$ + ", " + numberOne$ + ", 0, " + numberTwo$

  tiraOp TC_AND, fillMask$, numberOne$, "255"
  tiraAssign drawColor$, fillMask$
  tiraJmp drawLoopTop$

  tiraLabel drawInvalidLbl$
  tiraFatalError "ILLEGAL FUNCTION CALL"

  tiraLabel drawDoneLbl$

  tiraAssign "!G_GFX_VAL_CUR_X", currentX$
  tiraAssign "!G_GFX_VAL_CUR_Y", currentY$

  tiraTriggerAutoDisplay

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeDraw

''''''''''''''''''''''''
SUB emitRuntimeDrawTextAbsolute

  DIM textRowHeight AS LONG
  DIM sourceFontHeight AS LONG

  rtOffset(RT_DRAW_TEXT_ABSOLUTE) = stream.emitPos

  textRowHeight = 8
  sourceFontHeight = 8

  SELECT CASE compileScreenMode

    CASE 9
      textRowHeight = 14

    CASE 11, 12
      textRowHeight = 16
      sourceFontHeight = 16

  END SELECT ' compileScreenMode

  tira_Start
  tiraRT_Prologue

  argPtr$ = tiraDimVar$("ARG_PTR", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argPtr$ + ", 1"

  argLen$ = tiraDimVar$("ARG_LEN", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argLen$ + ", 2"

  argX$ = tiraDimVar$("ARG_X", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX$ + ", 3"

  argY$ = tiraDimVar$("ARG_Y", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY$ + ", 4"

  argFg$ = tiraDimVar$("ARG_FG", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argFg$ + ", 5"

  fontHeight$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign fontHeight$, "!G_GFX_V32_FONTHEIGHT"

  fontHeightReadyLbl$ = tiraLabelCreateNew$("FONT_HEIGHT_READY")
  tiraJmpCond "JG", fontHeight$, "0", fontHeightReadyLbl$
  tiraAssign fontHeight$, LTRIM$(STR$(textRowHeight))
  tiraLabel fontHeightReadyLbl$

  sourceFontHeightVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign sourceFontHeightVar$, LTRIM$(STR$(sourceFontHeight))

  sourceFontReadyLbl$ = tiraLabelCreateNew$("SOURCE_FONT_READY")
  tiraJmpCond "JE", fontHeight$, LTRIM$(STR$(textRowHeight)), sourceFontReadyLbl$
  tiraAssign sourceFontHeightVar$, "8"
  tiraJmpCond "JNE", fontHeight$, "16", sourceFontReadyLbl$
  tiraAssign sourceFontHeightVar$, "16"
  tiraLabel sourceFontReadyLbl$

  fontPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, fontPtr$, "!G_SYS_ARR_FONT", ""

  fontPtrReadyLbl$ = tiraLabelCreateNew$("FONT_PTR_READY")
  tiraJmpCond "JNE", sourceFontHeightVar$, "16", fontPtrReadyLbl$
  tiraOp TC_ADD, fontPtr$, fontPtr$, LTRIM$(STR$(FONT8_DATA_SIZE))
  tiraLabel fontPtrReadyLbl$

  charIdx$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign charIdx$, "0"

  lblCharLoop$ = tiraLabelCreateNew$("CHAR_LOOP")
  lblCharDone$ = tiraLabelCreateNew$("CHAR_DONE")
  tiraLabel lblCharLoop$
  tiraJmpCond "JGE", charIdx$, argLen$, lblCharDone$

  charAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, charAddr$, argPtr$, charIdx$

  charByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, charByte$ + ", " + charAddr$
  charVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign charVal$, charByte$

  fontOffsetX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MOD, fontOffsetX$, charVal$, "16"
  tiraOp TC_MUL, fontOffsetX$, fontOffsetX$, "8"

  fontOffsetY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_IDIV, fontOffsetY$, charVal$, "16"
  tiraOp TC_MUL, fontOffsetY$, fontOffsetY$, sourceFontHeightVar$

  iy$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iy$, "0"
  lblYLoop$ = tiraLabelCreateNew$("Y_LOOP")
  lblYDone$ = tiraLabelCreateNew$("Y_DONE")
  tiraLabel lblYLoop$
  tiraJmpCond "JGE", iy$, fontHeight$, lblYDone$

  sourceFontY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, sourceFontY$, iy$, sourceFontHeightVar$
  tiraOp TC_IDIV, sourceFontY$, sourceFontY$, fontHeight$

  ix$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign ix$, "0"
  lblXLoop$ = tiraLabelCreateNew$("X_LOOP")
  lblXDone$ = tiraLabelCreateNew$("X_DONE")
  tiraLabel lblXLoop$
  tiraJmpCond "JGE", ix$, "8", lblXDone$

  pixY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, pixY$, fontOffsetY$, sourceFontY$
  pixX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, pixX$, fontOffsetX$, ix$

  pixOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, pixOffset$, pixY$, "128"
  tiraOp TC_ADD, pixOffset$, pixOffset$, pixX$

  pixAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, pixAddr$, fontPtr$, pixOffset$

  fontPix$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, fontPix$ + ", " + pixAddr$

  ' Evaluate absolute pixel coordinates
  charPixelX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, charPixelX$, charIdx$, "8"

  tgtX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, tgtX$, argX$, charPixelX$
  tiraOp TC_ADD, tgtX$, tgtX$, ix$

  tgtY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, tgtY$, argY$, iy$

  lblSkipPset$ = tiraLabelCreateNew$("SKIP_PSET")

  ' Check bounds cleanly. The unsigned jump handles both zero limits and maximum boundaries seamlessly
  tiraJmpCond "JAE", tgtX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), lblSkipPset$
  tiraJmpCond "JAE", tgtY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), lblSkipPset$

  fbOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, fbOffset$, tgtY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, fbOffset$, fbOffset$, tgtX$

  fbAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fbAddr$, "!G_GFX_PTR_DEST_FRMB", fbOffset$

  lblDrawBg$ = tiraLabelCreateNew$("DRAW_BG")
  lblDrawDone$ = tiraLabelCreateNew$("DRAW_DONE")

  tiraJmpCond "JE", fontPix$, "0", lblDrawBg$
  tiraWriteMem fbAddr$, argFg$, "1"
  tiraJmp lblDrawDone$

  tiraLabel lblDrawBg$
  tiraWriteMem fbAddr$, "!G_GFX_VAL_LAST_BG", "1"

  tiraLabel lblDrawDone$
  tiraLabel lblSkipPset$

  tiraOp TC_ADD, ix$, ix$, "1"
  tiraJmp lblXLoop$
  tiraLabel lblXDone$

  tiraOp TC_ADD, iy$, iy$, "1"
  tiraJmp lblYLoop$
  tiraLabel lblYDone$

  tiraOp TC_ADD, charIdx$, charIdx$, "1"
  tiraJmp lblCharLoop$

  tiraLabel lblCharDone$

  tiraRT_Epilogue

  tira_EndAndProcess

END SUB ' emitRuntimeDrawTextAbsolute

''''''''''''''''''''''''
SUB emitRuntimeFullscreen

  rtOffset(RT_FULLSCREEN) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  modeArg$ = tiraDimVar$("ARGMODE", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, modeArg$ + ", 1"

  fullscreenOffLabel$ = tiraLabelCreateNew$("FULLSCREEN_OFF")
  fullscreenDoneLabel$ = tiraLabelCreateNew$("FULLSCREEN_DONE")

  tiraJmpCond "JE", modeArg$, "0", fullscreenOffLabel$

  ' GetSystemMetrics(SM_CXSCREEN = 0)
  tiraCall "IAT_GETSYSTEMMETRICS", 1, "0"
  screenWidth$ = tiraDimVar$("FSSCREENWIDTH", TYPE_LONG)
  tiraNew TC_GET_RET, screenWidth$

  ' GetSystemMetrics(SM_CYSCREEN = 1)
  tiraCall "IAT_GETSYSTEMMETRICS", 1, "1"
  screenHeight$ = tiraDimVar$("FSSCREENHEIGHT", TYPE_LONG)
  tiraNew TC_GET_RET, screenHeight$

  tiraAssign "!G_GFX_FLG_GDOUBLE", "0"
  tiraAssign "!G_GFX_VAL_IS_FULLSCREEN", "1"
  tiraAssign "!G_WND_VAL_WIDTH", screenWidth$
  tiraAssign "!G_WND_VAL_HEIGHT", screenHeight$

  ' SetWindowLongA(HWND, GWL_STYLE = -16, WS_POPUP | WS_VISIBLE = -1879048192)
  tiraCall "IAT_SETWINDOWLONGA", 3, "!G_WND_VAL_HWND, -16, -1879048192"

  ' SetWindowPos(HWND, HWND_TOP = 0, 0, 0, cx, cy, SWP_SHOWWINDOW | SWP_FRAMECHANGED = 96)
  tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, 0, 0, 0, " + screenWidth$ + ", " + screenHeight$ + ", 96"

  tiraJmp fullscreenDoneLabel$

  tiraLabel fullscreenOffLabel$

  ' Avoid disturbing custom RES, MED or MAX states when fullscreen is already off
  tiraJmpCond "JE", "!G_GFX_VAL_IS_FULLSCREEN", "0", fullscreenDoneLabel$

  clientWidth$ = tiraDimVar$("FSCLIENTWIDTH", TYPE_LONG)
  clientHeight$ = tiraDimVar$("FSCLIENTHEIGHT", TYPE_LONG)

  tiraAssign clientWidth$, "!G_GFX_V32_SCRNW"
  tiraAssign clientHeight$, "!G_GFX_V32_SCRNH"

  skipScaleLbl$ = tiraLabelCreateNew$("FS_SKIP_SCALE")
  tiraJmpCond "JE", "!G_GFX_FLG_GDOUBLE", "0", skipScaleLbl$
  tiraOp TC_MUL, clientWidth$, clientWidth$, "2"
  tiraOp TC_MUL, clientHeight$, clientHeight$, "2"
  tiraLabel skipScaleLbl$

  ' Two adjacent 64-bit temporaries provide the required 16-byte RECT
  rectLow$ = tiraDimVar$("FSRECTLOW", TYPE_INTEGER64)
  rectHigh$ = tiraDimVar$("FSRECTHIGH", TYPE_INTEGER64)
  tiraAssign rectLow$, "0"
  tiraAssign rectHigh$, "0"

  rectPtr$ = tiraDimVar$("FSRECTPTR", TYPE_INTEGER64)
  ' Runtime locals grow downward, so the second temporary is the RECT base
  tiraOp TC_ADDRESS_OF, rectPtr$, rectHigh$, ""

  tiraNew TC_WRITE_MEM_OFFSET, rectPtr$ + ", 8, " + clientWidth$ + ", 4"
  tiraNew TC_WRITE_MEM_OFFSET, rectPtr$ + ", 12, " + clientHeight$ + ", 4"

  ' Restore WS_OVERLAPPEDWINDOW
  tiraCall "IAT_SETWINDOWLONGA", 3, "!G_WND_VAL_HWND, -16, 13565952"
  tiraCall "IAT_ADJUSTWINDOWRECTEX", 4, rectPtr$ + ", 13565952, 0, 0"

  rectLeft$ = tiraDimVar$("FSRECTLEFT", TYPE_LONG)
  tiraNew TC_READ_MEM, rectLeft$ + ", " + rectPtr$

  rectTop$ = tiraDimVar$("FSRECTTOP", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rectTop$ + ", " + rectPtr$ + ", 4"

  rectRight$ = tiraDimVar$("FSRECTRIGHT", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rectRight$ + ", " + rectPtr$ + ", 8"

  rectBottom$ = tiraDimVar$("FSRECTBOTTOM", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rectBottom$ + ", " + rectPtr$ + ", 12"

  outerWidth$ = tiraDimVar$("FSOUTERWIDTH", TYPE_LONG)
  tiraOp TC_SUB, outerWidth$, rectRight$, rectLeft$

  outerHeight$ = tiraDimVar$("FSOUTERHEIGHT", TYPE_LONG)
  tiraOp TC_SUB, outerHeight$, rectBottom$, rectTop$

  ' HWND_NOTOPMOST with SWP_NOMOVE, SWP_FRAMECHANGED and SWP_SHOWWINDOW
  tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, -2, 0, 0, " + outerWidth$ + ", " + outerHeight$ + ", 98"

  ' Correct each outer dimension from the actual client size reported by WM_SIZE
  widthCorrection$ = tiraDimVar$("FSWIDTHCORRECTION", TYPE_LONG)
  tiraOp TC_SUB, widthCorrection$, clientWidth$, "!G_WND_VAL_WIDTH"
  tiraOp TC_ADD, outerWidth$, outerWidth$, widthCorrection$

  heightCorrection$ = tiraDimVar$("FSHEIGHTCORRECTION", TYPE_LONG)
  tiraOp TC_SUB, heightCorrection$, clientHeight$, "!G_WND_VAL_HEIGHT"
  tiraOp TC_ADD, outerHeight$, outerHeight$, heightCorrection$

  tiraCall "IAT_SETWINDOWPOS", 7, "!G_WND_VAL_HWND, -2, 0, 0, " + outerWidth$ + ", " + outerHeight$ + ", 98"

  tiraAssign "!G_GFX_VAL_IS_FULLSCREEN", "0"

  tiraLabel fullscreenDoneLabel$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeFullscreen

''''''''''''''''''''''''
SUB emitRuntimeGfxCopyPage

  ' Stretches and copies pixel data from a source graphics page into a destination page rectangle

  rtOffset(33) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  destX1$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destX1$ + ", 1"
  destY1$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destY1$ + ", 2"
  destX2$ = tiraDimVar$("ARG3", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destX2$ + ", 3"
  destY2$ = tiraDimVar$("ARG4", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, destY2$ + ", 4"
  argSrc$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argSrc$ + ", 5"
  argDest$ = tiraDimVar$("ARG6", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argDest$ + ", 6"

  heapMark$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign heapMark$, "!G_MEM_PTR_TEMP_HEAP"

  lblDone$ = tiraLabelCreateNew$("PUTIMG_DONE")

  skipXSwap$ = tiraLabelCreateNew$("PUTIMG_SKIP_X")
  tiraJmpCond "JLE", destX1$, destX2$, skipXSwap$
  ptr1$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, ptr1$, destX1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, destX2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipXSwap$

  skipYSwap$ = tiraLabelCreateNew$("PUTIMG_SKIP_Y")
  tiraJmpCond "JLE", destY1$, destY2$, skipYSwap$
  ptr1_y$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2_y$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, ptr1_y$, destY1$, ""
  tiraOp TC_ADDRESS_OF, ptr2_y$, destY2$, ""
  tiraSwapMem ptr1_y$, ptr2_y$, "4"
  tiraLabel skipYSwap$

  tiraJmpCond "JL", argSrc$, "0", lblDone$
  tiraJmpCond "JG", argSrc$, "3", lblDone$
  tiraJmpCond "JL", argDest$, "0", lblDone$
  tiraJmpCond "JG", argDest$, "3", lblDone$

  ' Page 0 and page 1 use the fixed framebuffer that the window procedure stretches
  ' Normalize a larger full-screen destination so the complete source reaches that framebuffer
  keepDestRect$ = tiraLabelCreateNew$("PUTIMG_KEEP_DEST")
  normalizeDest$ = tiraLabelCreateNew$("PUTIMG_NORMALIZE_DEST")

  tiraJmpCond "JG", argDest$, "1", keepDestRect$
  tiraJmpCond "JNE", destX1$, "0", keepDestRect$
  tiraJmpCond "JNE", destY1$, "0", keepDestRect$

  requestedW$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, requestedW$, destX2$, destX1$
  tiraOp TC_ADD, requestedW$, requestedW$, "1"

  requestedH$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, requestedH$, destY2$, destY1$
  tiraOp TC_ADD, requestedH$, requestedH$, "1"

  tiraJmpCond "JG", requestedW$, LTRIM$(STR$(gfxConfig.SizeX)), normalizeDest$
  tiraJmpCond "JG", requestedH$, LTRIM$(STR$(gfxConfig.SizeY)), normalizeDest$
  tiraJmp keepDestRect$

  tiraLabel normalizeDest$
  tiraAssign destX2$, LTRIM$(STR$(gfxConfig.SizeX - 1))
  tiraAssign destY2$, LTRIM$(STR$(gfxConfig.SizeY - 1))

  tiraLabel keepDestRect$

  dstW$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, dstW$, destX2$, destX1$
  tiraOp TC_ADD, dstW$, dstW$, "1"

  dstH$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, dstH$, destY2$, destY1$
  tiraOp TC_ADD, dstH$, dstH$, "1"

  tiraJmpCond "JLE", dstW$, "0", lblDone$
  tiraJmpCond "JLE", dstH$, "0", lblDone$

  lblSrc0$ = tiraLabelCreateNew$("SRC_0")
  lblSrc1$ = tiraLabelCreateNew$("SRC_1")
  lblSrc2$ = tiraLabelCreateNew$("SRC_2")
  lblSrc3$ = tiraLabelCreateNew$("SRC_3")
  lblSrcEnd$ = tiraLabelCreateNew$("SRC_END")

  ptrSrcFb$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argSrc$, "0", lblSrc0$
  tiraJmpCond "JE", argSrc$, "1", lblSrc1$
  tiraJmpCond "JE", argSrc$, "2", lblSrc2$
  tiraJmpCond "JE", argSrc$, "3", lblSrc3$
  tiraJmp lblDone$

  tiraLabel lblSrc0$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc1$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE1"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc2$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraJmp lblSrcEnd$

  tiraLabel lblSrc3$
  tiraAssign ptrSrcFb$, "!G_GFX_PTR_FRMB_PAGE3"

  tiraLabel lblSrcEnd$

  lblDest0$ = tiraLabelCreateNew$("DEST_0")
  lblDest1$ = tiraLabelCreateNew$("DEST_1")
  lblDest2$ = tiraLabelCreateNew$("DEST_2")
  lblDest3$ = tiraLabelCreateNew$("DEST_3")
  lblDestEnd$ = tiraLabelCreateNew$("DEST_END")

  ptrDestFb$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraJmpCond "JE", argDest$, "0", lblDest0$
  tiraJmpCond "JE", argDest$, "1", lblDest1$
  tiraJmpCond "JE", argDest$, "2", lblDest2$
  tiraJmpCond "JE", argDest$, "3", lblDest3$
  tiraJmp lblDone$

  tiraLabel lblDest0$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_BACK"
  tiraJmp lblDestEnd$

  tiraLabel lblDest1$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE1"
  tiraJmp lblDestEnd$

  tiraLabel lblDest2$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE2"
  tiraJmp lblDestEnd$

  tiraLabel lblDest3$
  tiraAssign ptrDestFb$, "!G_GFX_PTR_FRMB_PAGE3"

  tiraLabel lblDestEnd$

  srcW$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcW$, LTRIM$(STR$(gfxConfig.SizeX))

  srcH$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign srcH$, LTRIM$(STR$(gfxConfig.SizeY))

  ' Page 2 and Page 3 retain the dimensions supplied to _NEWIMAGE
  srcDimsDone$ = tiraLabelCreateNew$("PUTIMG_SRC_DIMS_DONE")
  checkPage3$ = tiraLabelCreateNew$("PUTIMG_CHK_PG3")

  tiraJmpCond "JE", argSrc$, "3", checkPage3$

  tiraJmpCond "JNE", argSrc$, "2", srcDimsDone$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE2W", "0", srcDimsDone$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE2H", "0", srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE2W", LTRIM$(STR$(gfxConfig.SizeX)), srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE2H", LTRIM$(STR$(gfxConfig.SizeY)), srcDimsDone$

  tiraAssign srcW$, "!G_GFX_V32_PAGE2W"
  tiraAssign srcH$, "!G_GFX_V32_PAGE2H"
  tiraJmp srcDimsDone$

  tiraLabel checkPage3$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE3W", "0", srcDimsDone$
  tiraJmpCond "JLE", "!G_GFX_V32_PAGE3H", "0", srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE3W", LTRIM$(STR$(gfxConfig.SizeX)), srcDimsDone$
  tiraJmpCond "JG", "!G_GFX_V32_PAGE3H", LTRIM$(STR$(gfxConfig.SizeY)), srcDimsDone$

  tiraAssign srcW$, "!G_GFX_V32_PAGE3W"
  tiraAssign srcH$, "!G_GFX_V32_PAGE3H"

  tiraLabel srcDimsDone$

  ' When source and destination share a framebuffer, preserve the complete source before drawing
  sourceCopyDone$ = tiraLabelCreateNew$("PUTIMG_SOURCE_COPY_DONE")
  tiraJmpCond "JNE", ptrSrcFb$, ptrDestFb$, sourceCopyDone$

  sourceCopySize$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign sourceCopySize$, LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

  sourceCopyPtr$ = tiraAllocTempMem$(sourceCopySize$)
  tiraMemcpy sourceCopyPtr$, ptrSrcFb$, sourceCopySize$
  tiraAssign ptrSrcFb$, sourceCopyPtr$

  tiraLabel sourceCopyDone$

  srcW_minus_1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, srcW_minus_1$, srcW$, "1"

  srcH_minus_1$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, srcH_minus_1$, srcH$, "1"

  yItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign yItr$, "0"

  lblLoopY$ = tiraLabelCreateNew$("PUTIMG_LOOPY")
  lblDoneY$ = tiraLabelCreateNew$("PUTIMG_DONEY")

  tiraLabel lblLoopY$
  tiraJmpCond "JGE", yItr$, dstH$, lblDoneY$

  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, destY1$, yItr$

  skipRow$ = tiraLabelCreateNew$("PUTIMG_SKIPROW")
  tiraJmpCond "JL", absY$, "0", skipRow$
  tiraJmpCond "JGE", absY$, LTRIM$(STR$(gfxConfig.SizeY)), skipRow$

  srcY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcY$, yItr$, srcH$
  tiraOp TC_IDIV, srcY$, srcY$, dstH$
  tiraClamp srcY$, "0", srcH_minus_1$

  srcRowOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcRowOffset$, srcY$, LTRIM$(STR$(gfxConfig.SizeX))

  dstRowOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, dstRowOffset$, absY$, LTRIM$(STR$(gfxConfig.SizeX))

  xItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign xItr$, "0"

  lblLoopX$ = tiraLabelCreateNew$("PUTIMG_LOOPX")
  lblDoneX$ = tiraLabelCreateNew$("PUTIMG_DONEX")

  tiraLabel lblLoopX$
  tiraJmpCond "JGE", xItr$, dstW$, lblDoneX$

  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, destX1$, xItr$

  skipPix$ = tiraLabelCreateNew$("PUTIMG_SKIPPIX")
  tiraJmpCond "JL", absX$, "0", skipPix$
  tiraJmpCond "JGE", absX$, LTRIM$(STR$(gfxConfig.SizeX)), skipPix$

  srcX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, srcX$, xItr$, srcW$
  tiraOp TC_IDIV, srcX$, srcX$, dstW$
  tiraClamp srcX$, "0", srcW_minus_1$

  srcOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, srcOffset$, srcRowOffset$, srcX$

  srcAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, srcAddr$, ptrSrcFb$, srcOffset$

  pixel$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel$ + ", " + srcAddr$

  dstOffset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, dstOffset$, dstRowOffset$, absX$

  dstAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dstAddr$, ptrDestFb$, dstOffset$

  tiraWriteMem dstAddr$, pixel$, "1"

  tiraLabel skipPix$

  tiraOp TC_ADD, xItr$, xItr$, "1"
  tiraJmp lblLoopX$

  tiraLabel lblDoneX$
  tiraLabel skipRow$

  tiraOp TC_ADD, yItr$, yItr$, "1"
  tiraJmp lblLoopY$

  tiraLabel lblDoneY$

  ' Explicit destinations can differ from the currently selected _DEST page
  skipExplicitRedraw$ = tiraLabelCreateNew$("PUTIMG_SKIP_REDRAW")
  tiraJmpCond "JE", argDest$, "!G_GFX_VAL_DEST_PAGE", skipExplicitRedraw$
  tiraRefreshVisualPage argDest$
  tiraLabel skipExplicitRedraw$

  tiraLabel lblDone$

  tiraAssign "!G_MEM_PTR_TEMP_HEAP", heapMark$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeGfxCopyPage

''''''''''''''''''''''''
SUB emitRuntimeGfxGet

  DIM captureBits AS LONG

  captureBits = 8

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      captureBits = 4

  END SELECT ' compileScreenMode

  rtOffset(RT_GET) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  argX1$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX1$ + ", 1"

  argY1$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY1$ + ", 2"

  argX2$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argX2$ + ", 3"

  argY2$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, argY2$ + ", 4"

  argPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argPtr$ + ", 5"

  argEnd$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, argEnd$ + ", 6"

  ' Adjust incoming bounds cleanly using the established viewing origin
  tiraOp TC_ADD, argX1$, argX1$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY1$, argY1$, "!G_GFX_VAL_VIEW_OFFSET_Y"
  tiraOp TC_ADD, argX2$, argX2$, "!G_GFX_VAL_VIEW_OFFSET_X"
  tiraOp TC_ADD, argY2$, argY2$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ' Swap X bounds if X1 > X2
  ptr1$ = tiraDimVar$("T", TYPE_INTEGER64)
  ptr2$ = tiraDimVar$("T", TYPE_INTEGER64)

  skipXSwap$ = tiraLabelCreateNew$("GET_SKIP_X")
  tiraJmpCond "JLE", argX1$, argX2$, skipXSwap$
  tiraOp TC_ADDRESS_OF, ptr1$, argX1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, argX2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipXSwap$

  ' Swap Y bounds if Y1 > Y2
  skipYSwap$ = tiraLabelCreateNew$("GET_SKIP_Y")
  tiraJmpCond "JLE", argY1$, argY2$, skipYSwap$
  tiraOp TC_ADDRESS_OF, ptr1$, argY1$, ""
  tiraOp TC_ADDRESS_OF, ptr2$, argY2$, ""
  tiraSwapMem ptr1$, ptr2$, "4"
  tiraLabel skipYSwap$

  ' Calculate captured width and height
  width$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, width$, argX2$, argX1$
  tiraOp TC_ADD, width$, width$, "1"

  height$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, height$, argY2$, argY1$
  tiraOp TC_ADD, height$, height$, "1"

  headerWidth$ = tiraDimVar$("T", TYPE_LONG)
  rowBytes$ = tiraDimVar$("T", TYPE_LONG)
  rowPayloadBytes$ = tiraDimVar$("T", TYPE_LONG)

  IF captureBits = 4 THEN
    ' SCREEN 7, 8, 9 and 12 store the pixel width directly
    tiraAssign headerWidth$, width$

    ' Each bitplane scanline is padded to a complete byte
    tiraOp TC_ADD, rowBytes$, width$, "7"
    tiraOp TC_IDIV, rowBytes$, rowBytes$, "8"

    ' Four consecutive bitplanes are stored for every scanline
    tiraOp TC_MUL, rowPayloadBytes$, rowBytes$, "4"
  ELSE
    ' SCREEN 13 stores the width in bits
    tiraOp TC_MUL, headerWidth$, width$, "8"
    tiraAssign rowBytes$, width$
    tiraAssign rowPayloadBytes$, width$
  END IF

  payloadBytes$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, payloadBytes$, rowPayloadBytes$, height$

  requiredEnd$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, requiredEnd$, argPtr$, "4"
  tiraOp TC_ADD, requiredEnd$, requiredEnd$, payloadBytes$

  doneLbl$ = tiraLabelCreateNew$("GET_DONE")

  ' Reject the complete operation before writing if the array is too small
  tiraJmpCond "JG", requiredEnd$, argEnd$, doneLbl$

  ' QB graphics arrays begin with two unsigned 16-bit dimensions
  tiraWriteMem argPtr$, headerWidth$, "2"

  heightPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, heightPtr$, argPtr$, "2"
  tiraWriteMem heightPtr$, height$, "2"

  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dataPtr$, argPtr$, "4"

  IF captureBits = 4 THEN
    ' Clear the planar payload so unused trailing bits remain zero
    tiraMemSet dataPtr$, "0", payloadBytes$
  END IF

  ' Fetch Framebuffer Base from user working buffer using the SOURCE page
  fbBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign fbBase$, "!G_GFX_PTR_SRC_FRMB"

  iterY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterY$, "0"

  loopY$ = tiraLabelCreateNew$("GET_LOOP_Y")
  tiraLabel loopY$
  tiraJmpCond "JGE", iterY$, height$, doneLbl$

  rowOffset$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, rowOffset$, iterY$, rowPayloadBytes$

  rowStartPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, rowStartPtr$, dataPtr$, rowOffset$

  IF captureBits = 4 THEN
    bitMask$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign bitMask$, "128"

    byteIndex$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign byteIndex$, "0"
  END IF

  iterX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterX$, "0"

  loopX$ = tiraLabelCreateNew$("GET_LOOP_X")
  tiraLabel loopX$

  endXLbl$ = tiraLabelCreateNew$("GET_END_X")
  tiraJmpCond "JGE", iterX$, width$, endXLbl$

  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, argX1$, iterX$

  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, argY1$, iterY$

  ' Clip boundaries to prevent reading outside the physical window coordinates
  pixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixel$, "0"

  skipBounds$ = tiraLabelCreateNew$("GET_SKIP_BND")

  tiraJmpCond "JL", absX$, "!G_GFX_VAL_VIEW_X1", skipBounds$
  tiraJmpCond "JGE", absX$, "!G_GFX_VAL_VIEW_X2", skipBounds$
  tiraJmpCond "JL", absY$, "!G_GFX_VAL_VIEW_Y1", skipBounds$
  tiraJmpCond "JGE", absY$, "!G_GFX_VAL_VIEW_Y2", skipBounds$

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCond "JAE", absX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), skipBounds$
  tiraJmpCond "JAE", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), skipBounds$

  ' Scan pixel byte from memory safely within visual area
  offset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offset$, absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offset$, offset$, absX$

  pixAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, pixAddr$, fbBase$, offset$

  pixel8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, pixel8$ + ", " + pixAddr$
  tiraAssign pixel$, pixel8$

  tiraLabel skipBounds$

  IF captureBits = 4 THEN
    ' Plane zero carries color bit zero
    planeBit$ = tiraDimVar$("T", TYPE_LONG)
    planeAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    planeByte$ = tiraDimVar$("T", TYPE_UBYTE)
    planeOffset$ = tiraDimVar$("T", TYPE_LONG)

    skipPlane1$ = tiraLabelCreateNew$("GET_SKIP_PLANE1")
    tiraOp TC_AND, planeBit$, pixel$, "1"
    tiraJmpCond "JE", planeBit$, "0", skipPlane1$

    tiraOp TC_ADD, planeAddr$, rowStartPtr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_OR, planeByte$, planeByte$, bitMask$
    tiraWriteMem planeAddr$, planeByte$, "1"

    tiraLabel skipPlane1$

    ' Plane one carries color bit one
    skipPlane2$ = tiraLabelCreateNew$("GET_SKIP_PLANE2")
    tiraOp TC_AND, planeBit$, pixel$, "2"
    tiraJmpCond "JE", planeBit$, "0", skipPlane2$

    tiraOp TC_ADD, planeAddr$, rowStartPtr$, rowBytes$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_OR, planeByte$, planeByte$, bitMask$
    tiraWriteMem planeAddr$, planeByte$, "1"

    tiraLabel skipPlane2$

    ' Plane two carries color bit two
    skipPlane3$ = tiraLabelCreateNew$("GET_SKIP_PLANE3")
    tiraOp TC_AND, planeBit$, pixel$, "4"
    tiraJmpCond "JE", planeBit$, "0", skipPlane3$

    tiraOp TC_MUL, planeOffset$, rowBytes$, "2"
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, planeOffset$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_OR, planeByte$, planeByte$, bitMask$
    tiraWriteMem planeAddr$, planeByte$, "1"

    tiraLabel skipPlane3$

    ' Plane three carries color bit three
    skipPlane4$ = tiraLabelCreateNew$("GET_SKIP_PLANE4")
    tiraOp TC_AND, planeBit$, pixel$, "8"
    tiraJmpCond "JE", planeBit$, "0", skipPlane4$

    tiraOp TC_MUL, planeOffset$, rowBytes$, "3"
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, planeOffset$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_OR, planeByte$, planeByte$, bitMask$
    tiraWriteMem planeAddr$, planeByte$, "1"

    tiraLabel skipPlane4$

    ' Advance from the most significant bit toward the least significant bit
    bitAdvanceDone$ = tiraLabelCreateNew$("GET_BIT_ADVANCE_DONE")
    tiraOp TC_SHR, bitMask$, bitMask$, "1"
    tiraJmpCond "JNE", bitMask$, "0", bitAdvanceDone$

    tiraAssign bitMask$, "128"
    tiraOp TC_ADD, byteIndex$, byteIndex$, "1"

    tiraLabel bitAdvanceDone$
  ELSE
    ' SCREEN 13 stores one palette index for every pixel
    writeAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, writeAddr$, rowStartPtr$, iterX$
    tiraWriteMem writeAddr$, pixel$, "1"
  END IF

  tiraOp TC_ADD, iterX$, iterX$, "1"
  tiraJmp loopX$

  tiraLabel endXLbl$

  tiraOp TC_ADD, iterY$, iterY$, "1"
  tiraJmp loopY$

  tiraLabel doneLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeGfxGet

''''''''''''''''''''''''
SUB emitRuntimeGfxPut

  ' Reads color data from a memory array and draws the corresponding pixels as a rectangular image to the graphics screen

  DIM captureBits AS LONG

  captureBits = 8

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      captureBits = 4

  END SELECT ' compileScreenMode

  rtOffset(RT_PUT) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  arg2Var$ = tiraDimVar$("ARG2", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"

  arg3Var$ = tiraDimVar$("ARG3", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg3Var$ + ", 3"

  arg4Var$ = tiraDimVar$("ARG4", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg4Var$ + ", 4"

  arg5Var$ = tiraDimVar$("ARG5", TYPE_LONG)
  tiraNew TC_ABI_READ_ARG, arg5Var$ + ", 5"

  argX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign argX$, arg1Var$
  tiraOp TC_ADD, argX$, argX$, "!G_GFX_VAL_VIEW_OFFSET_X"

  argY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign argY$, arg2Var$
  tiraOp TC_ADD, argY$, argY$, "!G_GFX_VAL_VIEW_OFFSET_Y"

  ptr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign ptr$, arg3Var$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign endPtr$, arg4Var$

  jmpDonePut1$ = tiraLabelCreateNew$("PUT_DONE1")
  jmpDonePut2$ = tiraLabelCreateNew$("PUT_DONE2")

  ' Check if the complete four-byte QB graphics header is available
  chkPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, chkPtr$, ptr$, "4"
  tiraJmpCond "JG", chkPtr$, endPtr$, jmpDonePut1$

  storedWidth$ = tiraDimVar$("T", TYPE_UINTEGER)
  tiraNew TC_READ_MEM, storedWidth$ + ", " + ptr$

  storedHeight$ = tiraDimVar$("T", TYPE_UINTEGER)
  tiraNew TC_READ_MEM_OFFSET, storedHeight$ + ", " + ptr$ + ", 2"

  width$ = tiraDimVar$("T", TYPE_LONG)
  height$ = tiraDimVar$("T", TYPE_LONG)
  rowBytes$ = tiraDimVar$("T", TYPE_LONG)
  rowPayloadBytes$ = tiraDimVar$("T", TYPE_LONG)
  pixelMask$ = tiraDimVar$("T", TYPE_LONG)

  tiraAssign height$, storedHeight$

  IF captureBits = 4 THEN
    ' SCREEN 7, 8, 9 and 12 store the pixel width directly
    tiraAssign width$, storedWidth$

    ' Each bitplane scanline is padded to a complete byte
    tiraOp TC_ADD, rowBytes$, width$, "7"
    tiraOp TC_IDIV, rowBytes$, rowBytes$, "8"

    ' Four consecutive bitplanes are stored for every scanline
    tiraOp TC_MUL, rowPayloadBytes$, rowBytes$, "4"

    tiraAssign pixelMask$, "15"
  ELSE
    ' SCREEN 13 stores the width in bits and requires a multiple of eight
    widthRemainder$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_AND, widthRemainder$, storedWidth$, "7"
    tiraJmpCond "JNE", widthRemainder$, "0", jmpDonePut1$

    tiraOp TC_IDIV, width$, storedWidth$, "8"
    tiraAssign rowBytes$, width$
    tiraAssign rowPayloadBytes$, width$
    tiraAssign pixelMask$, "255"
  END IF

  payloadBytes$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, payloadBytes$, rowPayloadBytes$, height$

  requiredEnd$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, requiredEnd$, ptr$, "4"
  tiraOp TC_ADD, requiredEnd$, requiredEnd$, payloadBytes$

  ' Reject the complete operation before reading if the array is too small
  tiraJmpCond "JG", requiredEnd$, endPtr$, jmpDonePut1$

  tiraOp TC_ADD, ptr$, ptr$, "4"

  fbBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign fbBase$, "!G_GFX_PTR_DEST_FRMB"

  iterY$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterY$, "0"

  ' Outer Loop Y
  lblLoopY$ = tiraLabelCreateNew$("PUT_LOOP_Y")
  tiraLabel lblLoopY$
  tiraJmpCond "JGE", iterY$, height$, jmpDonePut2$

  rowOffset$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, rowOffset$, iterY$, rowPayloadBytes$

  rowStartPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, rowStartPtr$, ptr$, rowOffset$

  IF captureBits = 4 THEN
    bitMask$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign bitMask$, "128"

    byteIndex$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign byteIndex$, "0"
  END IF

  iterX$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign iterX$, "0"

  ' Inner Loop X
  lblLoopX$ = tiraLabelCreateNew$("PUT_LOOP_X")
  tiraLabel lblLoopX$

  jmpEndX$ = tiraLabelCreateNew$("PUT_END_X")
  tiraJmpCond "JGE", iterX$, width$, jmpEndX$

  pixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign pixel$, "0"

  IF captureBits = 4 THEN
    planeAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    planeByte$ = tiraDimVar$("T", TYPE_UBYTE)
    planeTest$ = tiraDimVar$("T", TYPE_LONG)
    planeOffset$ = tiraDimVar$("T", TYPE_LONG)

    ' Plane zero supplies color bit zero
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_AND, planeTest$, planeByte$, bitMask$

    skipPlane1$ = tiraLabelCreateNew$("PUT_SKIP_PLANE1")
    tiraJmpCond "JE", planeTest$, "0", skipPlane1$
    tiraOp TC_OR, pixel$, pixel$, "1"
    tiraLabel skipPlane1$

    ' Plane one supplies color bit one
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, rowBytes$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_AND, planeTest$, planeByte$, bitMask$

    skipPlane2$ = tiraLabelCreateNew$("PUT_SKIP_PLANE2")
    tiraJmpCond "JE", planeTest$, "0", skipPlane2$
    tiraOp TC_OR, pixel$, pixel$, "2"
    tiraLabel skipPlane2$

    ' Plane two supplies color bit two
    tiraOp TC_MUL, planeOffset$, rowBytes$, "2"
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, planeOffset$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_AND, planeTest$, planeByte$, bitMask$

    skipPlane3$ = tiraLabelCreateNew$("PUT_SKIP_PLANE3")
    tiraJmpCond "JE", planeTest$, "0", skipPlane3$
    tiraOp TC_OR, pixel$, pixel$, "4"
    tiraLabel skipPlane3$

    ' Plane three supplies color bit three
    tiraOp TC_MUL, planeOffset$, rowBytes$, "3"
    tiraOp TC_ADD, planeAddr$, rowStartPtr$, planeOffset$
    tiraOp TC_ADD, planeAddr$, planeAddr$, byteIndex$
    tiraNew TC_READ_MEM, planeByte$ + ", " + planeAddr$
    tiraOp TC_AND, planeTest$, planeByte$, bitMask$

    skipPlane4$ = tiraLabelCreateNew$("PUT_SKIP_PLANE4")
    tiraJmpCond "JE", planeTest$, "0", skipPlane4$
    tiraOp TC_OR, pixel$, pixel$, "8"
    tiraLabel skipPlane4$
  ELSE
    ' SCREEN 13 stores one palette index for every pixel
    readPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, readPtr$, rowStartPtr$, iterX$

    pixel8$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, pixel8$ + ", " + readPtr$
    tiraAssign pixel$, pixel8$
  END IF

  absX$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absX$, argX$, iterX$

  absY$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, absY$, argY$, iterY$

  jmpSkipDraw$ = tiraLabelCreateNew$("PUT_SKIP_DRW")

  tiraJmpCond "JL", absX$, "!G_GFX_VAL_VIEW_X1", jmpSkipDraw$
  tiraJmpCond "JGE", absX$, "!G_GFX_VAL_VIEW_X2", jmpSkipDraw$
  tiraJmpCond "JL", absY$, "!G_GFX_VAL_VIEW_Y1", jmpSkipDraw$
  tiraJmpCond "JGE", absY$, "!G_GFX_VAL_VIEW_Y2", jmpSkipDraw$

  ' Speed boost optimization: Unsigned JAE bounds check validates both < 0 and >= max simultaneously
  tiraJmpCond "JAE", absX$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX))), jmpSkipDraw$
  tiraJmpCond "JAE", absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeY))), jmpSkipDraw$

  offset$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offset$, absY$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
  tiraOp TC_ADD, offset$, offset$, absX$

  fbTarget$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, fbTarget$, fbBase$, offset$

  ' Put Mode Support (0=PSET, 1=XOR, 2=AND, 3=OR, 4=PRESET)
  lblModePset$ = tiraLabelCreateNew$("PUT_MODE_PSET")
  lblModeAnd$ = tiraLabelCreateNew$("PUT_MODE_AND")
  lblModeOr$ = tiraLabelCreateNew$("PUT_MODE_OR")
  lblModePreset$ = tiraLabelCreateNew$("PUT_MODE_PRESET")
  lblModeEnd$ = tiraLabelCreateNew$("PUT_MODE_END")

  tiraJmpCond "JE", arg5Var$, "0", lblModePset$

  bgPixel8$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, bgPixel8$ + ", " + fbTarget$

  bgPixel$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign bgPixel$, bgPixel8$

  tiraJmpCond "JE", arg5Var$, "2", lblModeAnd$
  tiraJmpCond "JE", arg5Var$, "3", lblModeOr$
  tiraJmpCond "JE", arg5Var$, "4", lblModePreset$

  ' Default to XOR if 1 or an unrecognized mode reaches the runtime
  tiraOp TC_XOR, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModeAnd$
  tiraOp TC_AND, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModeOr$
  tiraOp TC_OR, pixel$, pixel$, bgPixel$
  tiraJmp lblModeEnd$

  tiraLabel lblModePreset$
  tiraOp TC_NOT, pixel$, pixel$, ""
  tiraJmp lblModeEnd$

  tiraLabel lblModePset$
  tiraLabel lblModeEnd$

  ' Keep every result inside the active palette-index range
  tiraOp TC_AND, pixel$, pixel$, pixelMask$

  tiraWriteMem fbTarget$, pixel$, "1"

  tiraLabel jmpSkipDraw$

  IF captureBits = 4 THEN
    ' Advance through each packed byte from its most significant bit
    bitAdvanceDone$ = tiraLabelCreateNew$("PUT_BIT_ADVANCE_DONE")
    tiraOp TC_SHR, bitMask$, bitMask$, "1"
    tiraJmpCond "JNE", bitMask$, "0", bitAdvanceDone$

    tiraAssign bitMask$, "128"
    tiraOp TC_ADD, byteIndex$, byteIndex$, "1"

    tiraLabel bitAdvanceDone$
  END IF

  tiraOp TC_ADD, iterX$, iterX$, "1"
  tiraJmp lblLoopX$

  tiraLabel jmpEndX$

  tiraOp TC_ADD, iterY$, iterY$, "1"
  tiraJmp lblLoopY$

  tiraLabel jmpDonePut1$
  tiraLabel jmpDonePut2$

  ' Numeric QBasic SCREEN modes require immediate PUT presentation
  ' Automatic presentation is scheduled independently so consecutive PUT operations can be combined
  tiraTriggerAutoDisplay

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeGfxPut

''''''''''''''''''''''''
SUB emitRuntimeStrAssign

  '''' String Assignment Runtime Helper
  ' Inputs: Arg1 = LHS Descriptor Ptr, Arg2 = RHS Descriptor Ptr
  rtOffset(RT_STR_ASSIGN) = stream.emitPos

  tira_Start
  tiraRT_Prologue

  arg1Var$ = tiraDimVar$("ARG1", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg1Var$ + ", 1"

  arg2Var$ = tiraDimVar$("ARG2", TYPE_INTEGER64)
  tiraNew TC_ABI_READ_ARG, arg2Var$ + ", 2"

  fastRetLbl$ = tiraLabelCreateNew$("STR_FASTRET")
  epilogueLbl$ = tiraLabelCreateNew$("STR_EPI")

  ' Check if LHS == RHS (e.g. A$ = A$) to prevent freeing the data we are trying to copy
  tiraJmpCond "JE", arg1Var$, arg2Var$, fastRetLbl$

  ' Get RHS length and data pointer
  rhsLen$ = tiraGetStringLen$(arg2Var$)
  rhsData$ = tiraGetStringData$(arg2Var$)

  ' Check if LHS needs freeing (Flags == 1)
  lhsFlags$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, lhsFlags$ + ", " + arg1Var$ + ", 16"

  ' Check if LHS Data Pointer is null
  lhsData$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, lhsData$ + ", " + arg1Var$

  lhsLen$ = tiraGetStringLen$(arg1Var$)

  nonEmptyLbl$ = tiraLabelCreateNew$("STR_NONEMPTY")
  tiraJmpCond "JG", rhsLen$, "0", nonEmptyLbl$

  ' If length is 0, zero LHS Descriptor and exit early
  skipEmptyFreeLbl$ = tiraLabelCreateNew$("STR_EMPTY_SKIPFREE")
  tiraJmpCond "JNE", lhsFlags$, "1", skipEmptyFreeLbl$
  tiraJmpCond "JE", lhsData$, "0", skipEmptyFreeLbl$

  ' Call HeapFree(hHeap, 0, dataPtr)
  tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + lhsData$

  tiraLabel skipEmptyFreeLbl$

  tiraBuildStrDesc arg1Var$, "0", "0", "0"
  tiraJmp epilogueLbl$

  tiraLabel nonEmptyLbl$

  ' Reuse an owned LHS allocation whenever its current size is large enough
  allocateLbl$ = tiraLabelCreateNew$("STR_ALLOCATE")
  tiraJmpCond "JNE", lhsFlags$, "1", allocateLbl$
  tiraJmpCond "JE", lhsData$, "0", allocateLbl$
  tiraJmpCond "JL", lhsLen$, rhsLen$, allocateLbl$

  reuseCopyManyLbl$ = tiraLabelCreateNew$("STR_REUSE_COPY_MANY")
  reuseCopyDoneLbl$ = tiraLabelCreateNew$("STR_REUSE_COPY_DONE")

  ' Copy Data
  tiraJmpCond "JNE", rhsLen$, "1", reuseCopyManyLbl$

  reuseByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, reuseByte$ + ", " + rhsData$
  tiraWriteMem lhsData$, reuseByte$, "1"
  tiraJmp reuseCopyDoneLbl$

  tiraLabel reuseCopyManyLbl$
  tiraMemcpy lhsData$, rhsData$, rhsLen$

  tiraLabel reuseCopyDoneLbl$

  ' Write null terminator at the end of the newly copied string data
  reuseNullPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, reuseNullPtr$, lhsData$, rhsLen$
  tiraWriteMem reuseNullPtr$, "0", "1"

  ' Update LHS Desc with the existing memory address
  tiraBuildStrDesc arg1Var$, lhsData$, rhsLen$, "1"
  tiraJmp epilogueLbl$

  tiraLabel allocateLbl$

  ' Call HeapAlloc(hHeap, 0, length + 1)
  allocSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, allocSize$, rhsLen$, "1"

  tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + allocSize$

  newPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, newPtr$

  ' Ensure the new memory allocation is successful to prevent crashes
  skipOomLbl$ = tiraLabelCreateNew$("STR_ALLOC_OOM_SKIP")
  tiraJmpCond "JNE", newPtr$, "0", skipOomLbl$

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRsp

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 1 THEN strVarData$(returnedData2) = "OUT OF MEMORY"

  tiraCall "RT_PRINT_STR", 1, "!G_ERR_DSC_OOM"
  tiraCall "RT_CRLF", 0, ""

  IF cm.HasGraphics = 1 THEN
    tiraCall "RT_SWAP_BUFFERS", 0, ""
  END IF

  tiraJmp "@END_PROGRAM"

  tiraLabel skipOomLbl$

  allocCopyManyLbl$ = tiraLabelCreateNew$("STR_ALLOC_COPY_MANY")
  allocCopyDoneLbl$ = tiraLabelCreateNew$("STR_ALLOC_COPY_DONE")

  ' Copy Data
  tiraJmpCond "JNE", rhsLen$, "1", allocCopyManyLbl$

  allocByte$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, allocByte$ + ", " + rhsData$
  tiraWriteMem newPtr$, allocByte$, "1"
  tiraJmp allocCopyDoneLbl$

  tiraLabel allocCopyManyLbl$
  tiraMemcpy newPtr$, rhsData$, rhsLen$

  tiraLabel allocCopyDoneLbl$

  ' Write null terminator at the end of the newly copied string data
  nullPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, nullPtr$, newPtr$, rhsLen$
  tiraWriteMem nullPtr$, "0", "1"

  ' Release the old LHS allocation only after the RHS data has been copied safely
  skipOldFreeLbl$ = tiraLabelCreateNew$("STR_OLD_SKIPFREE")
  tiraJmpCond "JNE", lhsFlags$, "1", skipOldFreeLbl$
  tiraJmpCond "JE", lhsData$, "0", skipOldFreeLbl$

  ' Call HeapFree(hHeap, 0, dataPtr)
  tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + lhsData$

  tiraLabel skipOldFreeLbl$

  ' Update LHS Desc with the newly allocated memory address
  tiraBuildStrDesc arg1Var$, newPtr$, rhsLen$, "1"

  tiraLabel epilogueLbl$
  tiraLabel fastRetLbl$

  tiraRT_Epilogue
  tira_EndAndProcess

END SUB ' emitRuntimeStrAssign

''''''''''''''''''''''''
SUB emitByteCode (wByte AS _UNSIGNED _BYTE)

  IF compileError = 1 THEN EXIT SUB

  ' Measurement passes count bytes without writing to the fixed machine-code array.
  IF isMeasurePass = 1 THEN
    stream.emitPos = stream.emitPos + 1
    EXIT SUB
  END IF

  IF stream.emitPos >= MAX_CODE_SIZE THEN
    throwCompilerError "MACHINE CODE BUFFER OVERFLOW (MAX " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES)", ASIS, 0
    addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
    addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
    EXIT SUB
  END IF

  intermediateCode(stream.emitPos) = wByte
  stream.emitPos = stream.emitPos + 1

END SUB ' emitByteCode

''''''''''''''''''''''''
SUB emitBytes32 (wVal AS LONG)

  DIM uVal AS _UNSIGNED LONG
  DIM writePos AS _UNSIGNED LONG
  DIM writeEnd AS _INTEGER64
  DIM overflowPos AS _INTEGER64

  IF compileError = 1 THEN EXIT SUB

  IF isMeasurePass = 1 THEN
    stream.emitPos = stream.emitPos + 4
    EXIT SUB
  END IF

  writePos = stream.emitPos
  writeEnd = writePos
  writeEnd = writeEnd + 4

  IF writeEnd > MAX_CODE_SIZE THEN
    overflowPos = writePos
    IF overflowPos < MAX_CODE_SIZE THEN overflowPos = MAX_CODE_SIZE

    throwCompilerError "MACHINE CODE BUFFER OVERFLOW (MAX " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES)", ASIS, 0
    addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(overflowPos))
    addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
    EXIT SUB
  END IF

  uVal = wVal
  intermediateCode(writePos) = uVal AND 255
  intermediateCode(writePos + 1) = (uVal \ 256) AND 255
  intermediateCode(writePos + 2) = (uVal \ 65536) AND 255
  intermediateCode(writePos + 3) = (uVal \ 16777216) AND 255
  stream.emitPos = writePos + 4

END SUB ' emitBytes32

''''''''''''''''''''''''
SUB emitEpilogue

  DIM hStdinIdx AS LONG
  DIM stateIdx AS LONG

  epilogueStartPos = stream.emitPos

  ensureFileWriteBufferSymbols

  tira_Start

  tiraFlushFileWriteBuffer

  SELECT CASE cm.HasGraphics

    CASE 0 ' Console epilogue

      tiraCall "RT_CRLF", 0, ""
      tiraCall "RT_PRINT_STR", 1, "!G_INO_DSC_PAUSE"

      ' hStdin = GetStdHandle(-10)
      tiraCall "IAT_GETSTDHANDLE", 1, "-10"
      hStdin$ = tiraDimVar$("T", TYPE_INTEGER64)
      hStdinIdx = returnedData2
      tiraGetRetId hStdinIdx

      ' SetConsoleMode(hStdin, 0) to disable line input and echo
      tiraCall "IAT_SETCONSOLEMODE", 2, hStdin$ + ", 0"

      ' ReadFile (Wait for key)
      bwPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      bwVal$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADDRESS_OF, bwPtr$, bwVal$, ""
      tiraCall "IAT_READFILE", 5, hStdin$ + ", !G_MEM_PTR_TEMP_HEAP, 1, " + bwPtr$ + ", 0"

      ' Restore Console Mode to standard flags (503) to prevent terminal lockup
      tiraCall "IAT_SETCONSOLEMODE", 2, hStdin$ + ", 503"

      tiraLabel "@INSTANT_EXIT"
      tiraCall "IAT_EXITPROCESS", 1, "!G_SYS_VAL_EXIT"

    CASE 1 ' Graphics epilogue

      tiraCall "RT_CRLF", 0, ""
      tiraCall "RT_CRLF", 0, ""
      tiraCall "RT_PRINT_STR", 1, "!G_INO_DSC_PAUSE"

      ' Flush the backbuffer to ensure final messages are visible before halting
      tiraCall "RT_SWAP_BUFFERS", 0, ""

      '''' Wait until no keys are pressed
      relWaitCount$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign relWaitCount$, "0"

      relLoop$ = tiraLabelCreateNew$("REL_WAIT")
      relKeyDown$ = tiraLabelCreateNew$("REL_KEY_DOWN")
      relDone$ = tiraLabelCreateNew$("REL_DONE")
      tiraLabel relLoop$
      tiraCall "IAT_SLEEP", 1, "10"

      idx$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign idx$, "8"

      relKeyLoop$ = tiraLabelCreateNew$("REL_KEY_LOOP")
      tiraLabel relKeyLoop$
      tiraCall "IAT_GETASYNCKEYSTATE", 1, idx$
      state$ = tiraDimVar$("T", TYPE_LONG)
      stateIdx = returnedData2
      tiraGetRetId stateIdx

      tiraOp TC_AND, state$, state$, "32768"
      tiraJmpCond "JNE", state$, "0", relKeyDown$ ' Restart if any key is pressed

      tiraOp TC_ADD, idx$, idx$, "1"
      tiraJmpCond "JLE", idx$, "255", relKeyLoop$

      tiraJmp relDone$

      tiraLabel relKeyDown$

      ' Limit the release wait so a latched virtual key cannot trap the program in the epilogue forever
      tiraOp TC_ADD, relWaitCount$, relWaitCount$, "1"
      tiraJmpCond "JGE", relWaitCount$, "50", relDone$
      tiraJmp relLoop$

      tiraLabel relDone$

      '''' Wait until ANY key is pressed
      pressLoop$ = tiraLabelCreateNew$("PRESS_WAIT")
      tiraLabel pressLoop$
      tiraCall "IAT_SLEEP", 1, "10"

      tiraAssign idx$, "8"

      pressKeyLoop$ = tiraLabelCreateNew$("PRESS_KEY_LOOP")
      tiraLabel pressKeyLoop$
      tiraCall "IAT_GETASYNCKEYSTATE", 1, idx$
      tiraGetRetId stateIdx

      tiraOp TC_AND, state$, state$, "32768"
      doneLbl$ = tiraLabelCreateNew$("DONE")
      tiraJmpCond "JNE", state$, "0", doneLbl$ ' Exit if any key is pressed

      tiraOp TC_ADD, idx$, idx$, "1"
      tiraJmpCond "JLE", idx$, "255", pressKeyLoop$

      tiraJmp pressLoop$ ' Restart press wait loop

      tiraLabel doneLbl$
      tiraLabel "@INSTANT_EXIT"
      tiraCall "IAT_EXITPROCESS", 1, "!G_SYS_VAL_EXIT"

  END SELECT ' cm.HasGraphics

  tira_EndAndProcess

  metrics.EpilogueSize = stream.emitPos - epilogueStartPos

END SUB ' emitEpilogue

''''''''''''''''''''''''
SUB emitMemoryOperand (regField AS LONG, baseReg AS LONG, dispType AS LONG, dispVal AS LONG)

  DIM baseRegMod AS LONG
  DIM regFieldMod AS LONG
  DIM modRM AS LONG

  baseRegMod = baseReg AND 7
  regFieldMod = regField AND 7

  IF dispType = 0 THEN
    IF baseRegMod = 5 THEN
      modRM = &H40 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      emitByteCode 0
    ELSE
      modRM = &H00 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      IF baseRegMod = 4 THEN emitByteCode &H24
    END IF
  ELSE
    IF dispType = 8 THEN
      modRM = &H40 + (regFieldMod * 8) + baseRegMod
      emitByteCode modRM
      IF baseRegMod = 4 THEN emitByteCode &H24
      emitByteCode dispVal AND 255
    ELSE
      IF dispType = 32 THEN
        modRM = &H80 + (regFieldMod * 8) + baseRegMod
        emitByteCode modRM
        IF baseRegMod = 4 THEN emitByteCode &H24
        emitBytes32 dispVal
      END IF
    END IF
  END IF

END SUB ' emitMemoryOperand

''''''''''''''''''''''''
SUB emitPrologue

  '''' Prologue
  tira_Start

  ' We allocate the main program frame using TC_MAIN_PROLOGUE instead of TC_ABI_PROLOGUE,
  ' because initStackLayout precisely calculates consoleFrameSize assuming no RBX push,
  ' which TC_ABI_PROLOGUE would alter and misalign hardcoded slot offsets.
  tiraNew TC_MAIN_PROLOGUE, LTRIM$(STR$(currentFrameSize))

  ' Save the base stack pointer layout so the error handler knows where the stack began cleanly
  tiraNew TC_GET_RSP, "!G_SYS_PTR_SAFE_RSP"

  IF cm.HasGraphics = 1 THEN
    ' Keep the active SCREEN coordinate size separate from the physical client size
    tiraAssign "!G_GFX_V32_SCRNW", LTRIM$(STR$(gfxConfig.SizeX))
    tiraAssign "!G_GFX_V32_SCRNH", LTRIM$(STR$(gfxConfig.SizeY))

    ' Preserve fixed page one storage while the FRONT pointers become visual aliases
    tiraAssign "!G_GFX_PTR_FRMB_PAGE1", "!G_GFX_PTR_FRMB_FRONT"
    tiraAssign "!G_GFX_PTR_BUFR_PAGE1", "!G_GFX_PTR_BUFR_FRONT"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE1", "!G_GFX_VAL_BUFR_COUNT_FRONT"
    tiraAssign "!G_GFX_PTR_FRMB_DISPLAY", "!G_GFX_PTR_FRMB_PAGE1"
    tiraAssign "!G_GFX_PTR_BUFR_DISPLAY", "!G_GFX_PTR_BUFR_PAGE1"
    tiraAssign "!G_GFX_FLG_PAGING", "0"
    tiraAssign "!G_GFX_VAL_VISUAL_PAGE", "0"

    IF compileScreenMode = 9 THEN
      tiraAssign "!G_INO_VAL_VIEW_TOP", "0"
      tiraAssign "!G_INO_VAL_VIEW_BOT", LTRIM$(STR$(gfxConfig.SizeY))
    END IF
  END IF

  IF cm.HasGraphics = 0 THEN
    ' In Console Mode there is only one thread, capture it here safely for the VEH
    tiraCall "IAT_GETCURRENTTHREADID", 0, ""
    tiraNew TC_GET_RET, "!G_SYS_VAL_USER_THREAD_ID"
  END IF

  ' Register the Vectored Exception Handler Block
  vehPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, vehPtr$, "RT_VEH_HANDLER", ""
  tiraCall "IAT_ADDVECTOREDEXCEPTIONHANDLER", 2, "1, " + vehPtr$

  ' Call GetProcessHeap
  tiraCall "IAT_GETPROCESSHEAP", 0, ""

  ' Save rax into !G_MEM_PTR_PROCESS_HEAP
  tiraNew TC_GET_RET, "!G_MEM_PTR_PROCESS_HEAP"

  IF cm.HasGraphics = 1 THEN
    ' Allocate an isolated automatic-display snapshot without consuming a logical page
    displayAllocSize$ = LTRIM$(STR$((gfxConfig.SizeX * gfxConfig.SizeY) + (GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize)))
    tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, " + displayAllocSize$

    displayAllocPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, displayAllocPtr$

    displayReadyLbl$ = tiraLabelCreateNew$("PROLOGUE_DISPLAY_READY")
    tiraJmpCond "JE", displayAllocPtr$, "0", displayReadyLbl$

    tiraAssign "!G_GFX_PTR_FRMB_DISPLAY", displayAllocPtr$
    tiraOp TC_ADD, "!G_GFX_PTR_BUFR_DISPLAY", displayAllocPtr$, LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

    tiraLabel displayReadyLbl$

    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_DISPLAY"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_DISPLAY"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "0"
  END IF

  ' call HeapAlloc
  tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, " + LTRIM$(STR$(TEMP_HEAP_SIZE))

  ' Retrieve allocated pointer into the absolute boundary tracker
  tiraNew TC_GET_RET, "!G_MEM_PTR_TEMP_BASE"

  ' Verify the allocation was successful to prevent a null pointer dereference
  skipOomLbl$ = "@PROLOGUE_OOM_SKIP"
  IF isDummyPass = 1 THEN skipOomLbl$ = "@PROLOGUE_OOM_SKIP_DUMMY"

  tiraJmpCond "JNE", "!G_MEM_PTR_TEMP_BASE", "0", skipOomLbl$

  ' Reset the stack so we can safely jump to the program exit
  tiraSetRsp

  ff = resolveSymbol("!G_ERR_DSC_OOM")
  IF ff = 1 THEN strVarData$(returnedData2) = "OUT OF MEMORY"

  tiraCall "RT_PRINT_STR", 1, "!G_ERR_DSC_OOM"
  tiraCall "RT_CRLF", 0, ""

  IF cm.HasGraphics = 1 THEN
    tiraCall "RT_SWAP_BUFFERS", 0, ""
  END IF

  tiraJmp "@END_PROGRAM"

  tiraLabel skipOomLbl$

  ' Add TEMP_HEAP_SIZE to pointer so it points to the END of the allocated block
  ' This allows string operations (like MID$) to safely subtract memory backwards
  tiraOp TC_ADD, "!G_MEM_PTR_TEMP_START", "!G_MEM_PTR_TEMP_BASE", LTRIM$(STR$(TEMP_HEAP_SIZE))

  ' Initialize the dynamic tracking heap pointer to the start location
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", "!G_MEM_PTR_TEMP_START"
  tiraAssign "!G_MEM_PTR_SPILL_HEAD", "0"

  IF cm.HasGraphics = 0 THEN
    ' Initialize console viewport boundaries
    tiraAssign "!G_INO_VAL_VIEW_TOP", "0"
    tiraAssign "!G_INO_VAL_VIEW_BOT", "25"

    ' Console INKEY$ polls the native console queue directly
  END IF

  ' Setup the DATA and READ layout tracker indexes natively in TIRA memory
  tiraAssign "!G_SYS_VAL_DATA_COUNT", LTRIM$(STR$(dataItemCount))
  tiraAssign "!G_SYS_VAL_DATAINDEX", "0"

  tira_EndAndProcess

  metrics.PrologueSize = stream.emitPos

END SUB ' emitPrologue

''''''''''''''''''''''''
SUB emitPrologueWindowSetup

  ' Sets up the Win64 window, registers the class, and starts the message loop for software rendering

  ' Software rendering mode only

  ' Isolate labels during the dummy pass with a suffix so they do not trigger adjustAllPatchOffsets
  ' This prevents the calculated offsets from being corrupted by the prologue shift
  lblProc$ = "@WND_PROC_ENTRY"
  lblUser$ = "@USER_CODE_ENTRY"

  IF isDummyPass = 1 THEN
    lblProc$ = "@WND_PROC_ENTRY_DUMMY"
    lblUser$ = "@USER_CODE_ENTRY_DUMMY"
  END IF

  '''' Initialize !G_GFX_VAL_FG to white and allocate the setup stack frame
  tira_Start
  tiraNew TC_ABI_PROLOGUE, LTRIM$(STR$(stack.GFX_SETUP_FRAME))
  tiraAssign "!G_GFX_VAL_FG", "15"

  ' Initialize the spinlock flag and buffers to zero
  tiraAssign "!G_WND_FLG_READY", "0"
  tiraAssign "!G_WND_FLG_RENDER_LOCK", "0"
  tiraAssign "!G_WND_VAL_LAST_MSG", "0"

  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_ARR_BUFR_FRONT", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_BUFR_BACK", "!G_GFX_ARR_BUFR_BACK", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_BUFR_PAGE2", "!G_GFX_ARR_BUFR_PAGE2", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_BUFR_PAGE3", "!G_GFX_ARR_BUFR_PAGE3", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_ARR_FRMB_FRONT", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_FRMB_BACK", "!G_GFX_ARR_FRMB_BACK", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_FRMB_PAGE2", "!G_GFX_ARR_FRMB_PAGE2", ""
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_FRMB_PAGE3", "!G_GFX_ARR_FRMB_PAGE3", ""

  tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "0"
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_BACK", "0"
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE2", "0"
  tiraAssign "!G_GFX_VAL_BUFR_COUNT_PAGE3", "0"

  tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraAssign "!G_GFX_VAL_DEST_PAGE", "0"

  tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
  tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
  tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
  tiraAssign "!G_GFX_VAL_SRC_PAGE", "0"

  ' Initialize autodisplay to ON by default
  tiraAssign "!G_GFX_FLG_AUTO", "1"
  tiraAssign "!G_GFX_FLG_GDOUBLE", "0"
  tiraAssign "!G_GFX_VAL_IS_FULLSCREEN", "0"

  '''' Initialize RECT structure with client area size for AdjustWindowRectEx
  ' RECT - Left(4), Top(4), Right(4), Bottom(4)
  rspBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RSP, rspBase$

  ' Left = 0
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 0)) + ", 0, 4"

  ' Top = 0
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 4)) + ", 0, 4"

  ' SET DEFAULT STRETCH DIMS EARLY TO PREVENT DIV BY ZERO DURING WINDOW CREATION
  tiraAssign "!G_WND_VAL_WIDTH", LTRIM$(STR$(gfxConfig.SizeX))
  tiraAssign "!G_WND_VAL_HEIGHT", LTRIM$(STR$(gfxConfig.SizeY))

  ' Initialize viewport boundaries to full screen
  tiraAssign "!G_INO_VAL_VIEW_TOP", "0"
  tiraAssign "!G_INO_VAL_VIEW_BOT", LTRIM$(STR$((gfxConfig.SizeY \ 8) * 8))

  tiraAssign "!G_GFX_VAL_VIEW_X1", "0"
  tiraAssign "!G_GFX_VAL_VIEW_Y1", "0"
  tiraAssign "!G_GFX_VAL_VIEW_X2", LTRIM$(STR$(gfxConfig.SizeX))
  tiraAssign "!G_GFX_VAL_VIEW_Y2", LTRIM$(STR$(gfxConfig.SizeY))
  tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
  tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"

  ' Right = gfxConfig.SizeX
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 8)) + ", " + LTRIM$(STR$(gfxConfig.SizeX)) + ", 4"

  ' Bottom = gfxConfig.SizeY
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 12)) + ", " + LTRIM$(STR$(gfxConfig.SizeY)) + ", 4"

  ' Call AdjustWindowRectEx to calculate total window size
  ' BOOL AdjustWindowRectEx(LPRECT lpRect, DWORD dwStyle, BOOL bMenu, DWORD dwExStyle)
  rectPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, rectPtr$, rspBase$, LTRIM$(STR$(stack.SETUP_SLOT_RECT))

  ' dwStyle = WS_OVERLAPPEDWINDOW (0x00CF0000 -> 13565952 in decimal)
  ' bMenu = 0
  ' dwExStyle = 0
  tiraCall "IAT_ADJUSTWINDOWRECTEX", 4, rectPtr$ + ", 13565952, 0, 0"

  ' Calculate Width - Right - Left
  rightVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, rightVal$ + ", " + rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 8))
  leftVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, leftVal$ + ", " + rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 0))
  widthVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, widthVal$, rightVal$, leftVal$
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_NWIDTH)) + ", " + widthVal$ + ", 4"

  ' Calculate Height - Bottom - Top
  bottomVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, bottomVal$ + ", " + rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 12))
  topVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, topVal$ + ", " + rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_RECT + 4))
  heightVal$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, heightVal$, bottomVal$, topVal$
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_NHEIGHT)) + ", " + heightVal$ + ", 4"

  '''' RegisterClassExA Setup
  tiraCall "IAT_GETMODULEHANDLEA", 1, "0"
  hInstance$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hInstance$
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HINSTANCE)) + ", " + hInstance$ + ", 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_WNDCLASSEX_HINSTANCE)) + ", " + hInstance$ + ", 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_CREATE_HINSTANCE)) + ", " + hInstance$ + ", 8"

  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_WNDCLASSEX)) + ", 80, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_STYLE)) + ", 3, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_CBCLSEXTRA)) + ", 0, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_CBWNDEXTRA)) + ", 0, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HICON)) + ", 0, 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_LPSZMENUNAME)) + ", 0, 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HICONSM)) + ", 0, 8"

  tiraCall "IAT_LOADCURSORA", 2, "0, 32512"
  hCursor$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hCursor$
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HCURSOR)) + ", " + hCursor$ + ", 8"

  tiraCall "IAT_GETSTOCKOBJECT", 1, "4"
  hBr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hBr$
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HBRBACKGROUND)) + ", " + hBr$ + ", 8"

  ' CW_USEDEFAULT = 0x80000000 = -2147483648
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_X)) + ", -2147483648, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_Y)) + ", -2147483648, 4"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HWNDPARENT)) + ", 0, 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HMENU)) + ", 0, 8"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_LPPARAM)) + ", 0, 8"

  classDataPtrSetup$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, classDataPtrSetup$ + ", !G_WND_DSC_CLASS"
  tiraNew TC_WRITE_MEM_OFFSET, rspBase$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_LPSZCLASSNAME)) + ", " + classDataPtrSetup$ + ", 8"

  wndProcPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, wndProcPtr$, lblProc$, ""

  rspVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RSP, rspVar$

  tiraNew TC_WRITE_MEM_OFFSET, rspVar$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_LPFNWNDPROC)) + ", " + wndProcPtr$ + ", 8"

  wndClassPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, wndClassPtr$, rspVar$, LTRIM$(STR$(stack.SETUP_SLOT_WNDCLASSEX))

  tiraCall "IAT_REGISTERCLASSEXA", 1, wndClassPtr$

  classDataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, classDataPtr$ + ", !G_WND_DSC_CLASS"

  titleDataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, titleDataPtr$ + ", !G_WND_DSC_TITLE"

  argsList$ = "0, " + classDataPtr$ + ", " + titleDataPtr$ + ", 13565952, -2147483648, -2147483648, " + widthVal$ + ", " + heightVal$ + ", 0, 0, " + hInstance$ + ", 0"
  tiraCall "IAT_CREATEWINDOWEXA", 12, argsList$

  hwndVarSetup$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, hwndVarSetup$

  tiraNew TC_WRITE_MEM_OFFSET, rspVar$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HWND)) + ", " + hwndVarSetup$ + ", 8"

  tiraNew TC_WRITE_MEM_OFFSET, rspVar$ + ", " + LTRIM$(STR$(stack.SETUP_SLOT_HICONSM)) + ", 1, 4"
  attrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, attrPtr$, rspVar$, LTRIM$(STR$(stack.SETUP_SLOT_HICONSM))

  tiraCall "IAT_DWMSETWINDOWATTRIBUTE", 4, hwndVarSetup$ + ", 33, " + attrPtr$ + ", 4"

  tiraCall "IAT_SHOWWINDOW", 2, hwndVarSetup$ + ", 1"

  tiraAssign "!G_WND_VAL_HWND", hwndVarSetup$

  threadEntryPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, threadEntryPtr$, lblUser$, ""

  tiraCall "IAT_CREATETHREAD", 6, "0, 0, " + threadEntryPtr$ + ", 0, 0, 0"

  lblMsgLoopTop$ = tiraLabelCreateNew$("MSG_LOOP_TOP")
  lblMsgAutoDone$ = tiraLabelCreateNew$("MSG_AUTO_DONE")
  tiraLabel lblMsgLoopTop$

  ' Keep automatic presentation independent of the user-code thread
  tiraJmpCond "JE", "!G_GFX_FLG_AUTO", "0", lblMsgAutoDone$

  msgPendingBits$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, msgPendingBits$, "!G_GFX_FLG_DISPLAYI_PENDING", "1"
  tiraJmpCond "JE", msgPendingBits$, "0", lblMsgAutoDone$

  tiraCall "RT_AUTODISPLAY_CHECK", 0, ""

  tiraLabel lblMsgAutoDone$

  tiraNew TC_GET_RSP, "!G_WND_PTR_MSG_LOOP_RSP"
  tiraOp TC_ADD, "!G_WND_PTR_MSG_LOOP", "!G_WND_PTR_MSG_LOOP_RSP", LTRIM$(STR$(stack.GRAPHICS_MSG_SLOT))

  tiraCall "IAT_PEEKMESSAGEA", 5, "!G_WND_PTR_MSG_LOOP, 0, 0, 0, 1"

  tiraNew TC_GET_RET, "!G_WND_VAL_MSG_LOOP_RET"

  lblNoMessage$ = tiraLabelCreateNew$("NO_MESSAGE")
  tiraJmpCond "JE", "!G_WND_VAL_MSG_LOOP_RET", "0", lblNoMessage$

  tiraNew TC_READ_MEM_OFFSET, "!G_WND_VAL_MSG_LOOP_MSGID, !G_WND_PTR_MSG_LOOP, 8"

  lblExit$ = tiraLabelCreateNew$("MSG_EXIT")
  tiraJmpCond "JE", "!G_WND_VAL_MSG_LOOP_MSGID", "18", lblExit$

  tiraCall "IAT_TRANSLATEMESSAGE", 1, "!G_WND_PTR_MSG_LOOP"
  tiraCall "IAT_DISPATCHMESSAGEA", 1, "!G_WND_PTR_MSG_LOOP"

  tiraJmp lblMsgLoopTop$

  tiraLabel lblNoMessage$
  tiraCall "IAT_SLEEP", 1, "1"
  tiraJmp lblMsgLoopTop$

  tiraLabel lblExit$

  tiraCall "IAT_EXITPROCESS", 1, "!G_SYS_VAL_EXIT"

  lblOnDestroy$ = tiraLabelCreateNew$("WND_DESTROY")
  lblOnPaint$ = tiraLabelCreateNew$("WND_PAINT")
  lblOnChar$ = tiraLabelCreateNew$("WND_CHAR")
  lblOnKeyDown$ = tiraLabelCreateNew$("WND_KEYDOWN")
  lblOnKeyUp$ = tiraLabelCreateNew$("WND_KEYUP")
  lblOnSize$ = tiraLabelCreateNew$("WND_SIZE")
  lblOnDefault$ = tiraLabelCreateNew$("WND_DEFAULT")

  tiraLabel lblProc$
  tiraNew TC_ABI_PROLOGUE, LTRIM$(STR$(stack.GFX_WNDPROC_FRAME))

  msgVal$ = tiraStackVar$("MSG", TYPE_LONG, stack.WNDPROC_SLOT_MSG)
  wParamVal$ = tiraStackVar$("WPARAM", TYPE_INTEGER64, stack.WNDPROC_SLOT_WPARAM)
  lParamVal$ = tiraStackVar$("LPARAM", TYPE_INTEGER64, stack.WNDPROC_SLOT_LPARAM)
  retVal$ = tiraStackVar$("RET", TYPE_INTEGER64, stack.WNDPROC_SLOT_RET)
  hwndVar$ = tiraStackVar$("HWND", TYPE_INTEGER64, stack.WNDPROC_SLOT_HWND)

  tiraNew TC_ABI_READ_ARG, hwndVar$ + ", 1"
  tiraNew TC_ABI_READ_ARG, msgVal$ + ", 2"
  tiraNew TC_ABI_READ_ARG, wParamVal$ + ", 3"
  tiraNew TC_ABI_READ_ARG, lParamVal$ + ", 4"

  tiraJmpCond "JE", msgVal$, "2", lblOnDestroy$
  tiraJmpCond "JE", msgVal$, "5", lblOnSize$
  tiraJmpCond "JE", msgVal$, "15", lblOnPaint$
  tiraJmpCond "JE", msgVal$, "258", lblOnChar$
  tiraJmpCond "JE", msgVal$, "256", lblOnKeyDown$
  tiraJmpCond "JE", msgVal$, "257", lblOnKeyUp$

  lblOnMouse$ = tiraLabelCreateNew$("WND_MOUSE")
  tiraJmpCond "JL", msgVal$, "512", lblOnDefault$
  tiraJmpCond "JLE", msgVal$, "522", lblOnMouse$

  tiraJmp lblOnDefault$

  tiraLabel lblOnSize$
  newWidth$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_AND, newWidth$, lParamVal$, "65535"
  tiraAssign "!G_WND_VAL_WIDTH", newWidth$

  newHeight$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SHR, newHeight$, lParamVal$, "16"
  tiraOp TC_AND, newHeight$, newHeight$, "65535"
  tiraAssign "!G_WND_VAL_HEIGHT", newHeight$

  tiraJmp lblOnDefault$

  tiraLabel lblOnDefault$
  tiraCall "IAT_DEFWINDOWPROCA", 4, hwndVar$ + ", " + msgVal$ + ", " + wParamVal$ + ", " + lParamVal$
  tiraNew TC_GET_RET, retVal$
  tiraNew TC_ABI_WRITE_RET, retVal$
  tiraNew TC_ABI_EPILOGUE, LTRIM$(STR$(stack.GFX_WNDPROC_FRAME))

  tiraLabel lblOnDestroy$
  tiraCall "IAT_POSTQUITMESSAGE", 1, "0"
  tiraAssign retVal$, "0"
  tiraNew TC_ABI_WRITE_RET, retVal$
  tiraNew TC_ABI_EPILOGUE, LTRIM$(STR$(stack.GFX_WNDPROC_FRAME))

  tiraLabel lblOnPaint$

  paintStruct$ = tiraStackVar$("PAINTSTRUCT", TYPE_STRING, stack.WNDPROC_SLOT_PAINTSTRUCT)
  paintStructPtr$ = tiraStackVar$("PS_PTR", TYPE_INTEGER64, stack.WNDPROC_SLOT_PAINTSTRUCT_PTR)
  tiraOp TC_ADDRESS_OF, paintStructPtr$, paintStruct$, ""

  tiraCall "IAT_BEGINPAINT", 2, hwndVar$ + ", " + paintStructPtr$
  hdcVar$ = tiraStackVar$("HDC", TYPE_INTEGER64, stack.WNDPROC_SLOT_HDC)
  tiraNew TC_GET_RET, hdcVar$

  tiraCall "IAT_CREATECOMPATIBLEDC", 1, hdcVar$
  memDcVar$ = tiraStackVar$("MEMDC", TYPE_INTEGER64, stack.WNDPROC_SLOT_MEMDC)
  tiraNew TC_GET_RET, memDcVar$

  tiraCall "IAT_CREATECOMPATIBLEBITMAP", 3, hdcVar$ + ", " + LTRIM$(STR$(gfxConfig.SizeX)) + ", " + LTRIM$(STR$(gfxConfig.SizeY))
  hBmpVar$ = tiraStackVar$("HBMP", TYPE_INTEGER64, stack.WNDPROC_SLOT_HBITMAP)
  tiraNew TC_GET_RET, hBmpVar$

  tiraCall "IAT_SELECTOBJECT", 2, memDcVar$ + ", " + hBmpVar$
  oldBmpVar$ = tiraStackVar$("OLD_HBITMAP", TYPE_INTEGER64, stack.WNDPROC_SLOT_OLD_HBITMAP)
  tiraNew TC_GET_RET, oldBmpVar$

  tiraCall "IAT_BITBLT", 9, memDcVar$ + ", 0, 0, " + LTRIM$(STR$(gfxConfig.SizeX)) + ", " + LTRIM$(STR$(gfxConfig.SizeY)) + ", 0, 0, 0, 66"

  fontPtrVar$ = tiraStackVar$("FONT_PTR", TYPE_INTEGER64, stack.WNDPROC_SLOT_FONT_PTR)
  tiraNew TC_READ_MEM, fontPtrVar$ + ", !G_GFX_DSC_FONT"
  tiraCall "IAT_CREATEFONTA", 14, "8, 8, 0, 0, 400, 0, 0, 0, 255, 0, 0, 0, 49, " + fontPtrVar$

  hFontVar$ = tiraStackVar$("HFONT", TYPE_INTEGER64, stack.WNDPROC_SLOT_HFONT)
  tiraNew TC_GET_RET, hFontVar$

  tiraCall "IAT_SELECTOBJECT", 2, memDcVar$ + ", " + hFontVar$
  oldFontVar$ = tiraStackVar$("OLD_HFONT", TYPE_INTEGER64, stack.WNDPROC_SLOT_OLD_HFONT)
  tiraNew TC_GET_RET, oldFontVar$

