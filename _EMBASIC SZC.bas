''''''''''''''''''''''''
SUB ensureKeyEventSymbols

  ' Registers ON KEY handler addresses and event states

  DIM savedScopeID AS LONG
  DIM handlerIdx AS _UNSIGNED LONG
  DIM stateIdx AS _UNSIGNED LONG
  DIM runtimeIdx AS _UNSIGNED LONG

  savedScopeID = currentScopeID
  currentScopeID = 0

  ff = resolveSymbol("!G_INO_ARR_KEYHANDLER")
  IF ff = 1 THEN
    handlerIdx = returnedData2
    symbols(handlerIdx).DataType = TYPE_UBYTE
    symbols(handlerIdx).IsArray = 0
    symbols(handlerIdx).Size = KEY_EVENT_COUNT * KEY_EVENT_SLOT_BYTES
    symbols(handlerIdx).NumDimensions = 0
  END IF

  ff = resolveSymbol("!G_INO_ARR_KEYSTATE")
  IF ff = 1 THEN
    stateIdx = returnedData2
    symbols(stateIdx).DataType = TYPE_UBYTE
    symbols(stateIdx).IsArray = 0
    symbols(stateIdx).Size = KEY_EVENT_COUNT * KEY_EVENT_SLOT_BYTES
    symbols(stateIdx).NumDimensions = 0
  END IF

  ff = resolveSymbol("!G_INO_FLG_KEYACTIVE")
