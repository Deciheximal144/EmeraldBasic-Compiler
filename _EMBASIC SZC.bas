''''''''''''''''''''''''
FUNCTION compilePass1Flatten

  DIM outCount AS LONG
  DIM origLineMap AS LONG
  DIM stripLen AS LONG
  DIM isSingleLineIf AS LONG
  DIM hasElse AS LONG
  DIM elseIdx AS LONG
  DIM thenIdx AS LONG
  DIM parenDepth AS LONG
  DIM ifDepth AS LONG
  DIM endThen AS LONG
  DIM needsExtraPass AS LONG
  DIM tokensReady AS LONG

  ' Variables for inline flattening
  DIM rangeStart(2) AS LONG
  DIM rangeEnd(2) AS LONG
  DIM rangeCount AS LONG
  DIM flattenStart AS LONG
  DIM flattenEnd AS LONG
  DIM chunkStart AS LONG
  DIM tVal AS LONG
  DIM tVal2 AS LONG
  DIM hasIf AS LONG
  DIM thenPos AS LONG
  DIM ignoreColon AS LONG
  DIM inQuotes AS LONG
  DIM commentPos AS LONG
  DIM hasDirectiveComment AS LONG
  DIM isLabel AS LONG
  DIM sliceStr$
  DIM underscoreStart AS LONG
  DIM baseText$
  DIM nextIy AS LONG
  DIM nextText$
  DIM nextLine$

  outCount = 0
  needsExtraPass = 0

  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN
      EXIT FUNCTION
    END IF

    curLine$ = compileText$(iy)
    origLineMap = editorLineLinkMap(iy)

    ' Properly track the original line number so tokenization errors reflect the true location
    currentLineNumber = origLineMap

    tempLine$ = LTRIM$(RTRIM$(curLine$))
    tokensReady = 0

    IF tempLine$ <> "" THEN
      DO
        tokenizeLine tempLine$
        IF compileError = 1 THEN EXIT FUNCTION
        tokensReady = 1

        IF lineTokenCount > 0 THEN
          IF lineTokens$(lineTokenCount - 1) = "_" THEN
            IF cm.ClassicMode = 0 THEN
              throwCompilerError "_ AT END OF LINE ONLY SUPPORTED IN #CLASSIC MODE", ASIS, 0
              EXIT FUNCTION
            END IF

            underscoreStart = lineTokenStartChar(lineTokenCount - 1)
            baseText$ = LEFT$(tempLine$, underscoreStart - 1)

            nextIy = iy + 1
            nextText$ = ""
            DO WHILE nextIy <= compileLastLine
              nextLine$ = LTRIM$(RTRIM$(compileText$(nextIy)))
              IF nextLine$ <> "" THEN
                nextText$ = nextLine$
                compileText$(nextIy) = ""
                EXIT DO
              END IF
              nextIy = nextIy + 1
            LOOP

            tempLine$ = LTRIM$(RTRIM$(baseText$ + " " + nextText$))
            needsExtraPass = 1
          ELSE
            EXIT DO
          END IF
        ELSE
          EXIT DO
        END IF
      LOOP
    END IF

    IF tempLine$ <> "" THEN
      ' Isolate Labels so we don't accidentally split code connected to them
      labelStr$ = retLabelStripLength$(tempLine$)
      stripLen = returnedData2

      IF stripLen > 0 THEN
        ff = retRoutineDeclarationExists(labelStr$)
        IF ff = 1 THEN stripLen = 0
      END IF

      IF stripLen > 0 THEN
        outCount = outCount + 1
        IF outCount >= COMPILE_LINE_MAX THEN
          throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
          EXIT FUNCTION
        END IF
        flattenScratchText$(outCount) = labelStr$ + ":"
        flattenScratchMap(outCount) = origLineMap
        tempLine$ = LTRIM$(MID$(tempLine$, stripLen + 1))
        tokensReady = 0
        IF tempLine$ <> "" THEN needsExtraPass = 1 ' A label obscuring a command triggers an extra pass
      END IF

      hasDirectiveComment = 0
      remText$ = ""

      IF tempLine$ <> "" THEN
        inQuotes = 0
        commentPos = 0
        FOR ix = 1 TO LEN(tempLine$)
          chCheck$ = MID$(tempLine$, ix, 1)
          IF chCheck$ = CHR$(34) THEN inQuotes = 1 - inQuotes
          IF inQuotes = 0 AND chCheck$ = "'" THEN
            commentPos = ix
            EXIT FOR
          END IF
        NEXT

        IF commentPos > 0 THEN
          remText$ = MID$(tempLine$, commentPos)
          checkDir$ = LTRIM$(MID$(tempLine$, commentPos + 1))
          IF checkIfPreprocessorKeyword(checkDir$) = 1 THEN
            hasDirectiveComment = 1
          END IF
        END IF
      END IF

      IF tempLine$ <> "" THEN
        IF tokensReady = 0 THEN
          tokenizeLine tempLine$
          IF compileError = 1 THEN
            EXIT FUNCTION
          END IF
          tokensReady = 1
        END IF

        IF cm.ClassicMode = 0 THEN
          IF lineTokenCount > 1 THEN
            FOR iTok = 0 TO lineTokenCount - 2
              IF lineTokenVals(iTok) = TOK_ELSE THEN
                IF lineTokenVals(iTok + 1) = TOK_IF THEN
                  throwCompilerError "ELSE IF REQUIRES #CLASSIC MODE", ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            NEXT
          END IF
        END IF

        IF lineTokenCount > 0 THEN
          isSingleLineIf = 0
          hasElse = 0
          elseIdx = 0
          thenIdx = 0

          IF lineTokenVals(0) = TOK_IF THEN
            FOR iTok = 1 TO lineTokenCount - 1
              IF lineTokenVals(iTok) = TOK_THEN THEN
                thenIdx = iTok
                IF iTok < lineTokenCount - 1 THEN
                  isSingleLineIf = 1
                END IF
                EXIT FOR
              END IF
            NEXT

            IF isSingleLineIf = 1 THEN
              parenDepth = 0
              ifDepth = 0
              FOR iTok = thenIdx + 1 TO lineTokenCount - 1
                tVal = lineTokenVals(iTok)
                IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
                IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1
                IF parenDepth = 0 THEN
                  IF tVal = TOK_IF THEN ifDepth = ifDepth + 1
                  IF tVal = TOK_ELSE THEN
                    IF ifDepth = 0 THEN
                      hasElse = 1
                      elseIdx = iTok
                      EXIT FOR
                    ELSE
                      ifDepth = ifDepth - 1
                    END IF
                  END IF
                END IF
              NEXT
            END IF
          END IF

          rangeCount = 0

          IF isSingleLineIf = 1 THEN
            outCount = outCount + 1
            IF outCount >= COMPILE_LINE_MAX THEN
              throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
              EXIT FUNCTION
            END IF
            ' Flawless extraction using the tokenizer's exact start and end map
            sliceStr$ = MID$(tempLine$, lineTokenStartChar(0), lineTokenEndChar(thenIdx) - lineTokenStartChar(0) + 1)
            flattenScratchText$(outCount) = LTRIM$(RTRIM$(sliceStr$))
            flattenScratchMap(outCount) = origLineMap

            endThen = lineTokenCount - 1
            IF hasElse = 1 THEN endThen = elseIdx - 1

            ' Enqueue THEN branch
            rangeStart(rangeCount) = thenIdx + 1
            rangeEnd(rangeCount) = endThen
            rangeCount = rangeCount + 1

            IF hasElse = 1 THEN
              ' Enqueue ELSE branch
              rangeStart(rangeCount) = elseIdx + 1
              rangeEnd(rangeCount) = lineTokenCount - 1
              rangeCount = rangeCount + 1
            END IF
          ELSE
            ' Enqueue regular statement
            rangeStart(rangeCount) = 0
            rangeEnd(rangeCount) = lineTokenCount - 1
            rangeCount = rangeCount + 1
          END IF

          ' Iterate over the enqueued ranges sequentially
          FOR iRange = 0 TO rangeCount - 1
            flattenStart = rangeStart(iRange)
            flattenEnd = rangeEnd(iRange)

            chunkStart = flattenStart
            parenDepth = 0

            FOR ii = flattenStart TO flattenEnd
              tVal = lineTokenVals(ii)
              IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
              IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

              IF parenDepth = 0 AND tVal = 256 + ASC(":") THEN
                ignoreColon = 0
                isLabel = 0

                ' Preserve a nested single-line IF so the next flattening pass can separate all of its branches
                IF lineTokenVals(chunkStart) = TOK_IF THEN
                  ignoreColon = 1
                  needsExtraPass = 1
                END IF

                IF ii = chunkStart + 1 THEN
                  IF lineTokenVals(chunkStart) = TOK_CASE THEN
                    ignoreColon = 1
                  ELSE
                    IF lineTokenVals(chunkStart) = 0 THEN
                      IF LEFT$(lineTokens$(chunkStart), 1) <> CHR$(34) THEN
                        isLabel = 1
                      END IF
                    END IF
                  END IF
                END IF

                IF isLabel = 1 THEN
                  ff = retRoutineDeclarationExists(lineTokens$(chunkStart))
                  IF ff = 1 THEN isLabel = 0
                END IF

                IF ignoreColon = 0 THEN
                  IF isLabel = 1 THEN
                    outCount = outCount + 1
                    IF outCount >= COMPILE_LINE_MAX THEN
                      throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
                      EXIT FUNCTION
                    END IF
                    ' Notice `ii` is used for the endpoint to deliberately catch the colon inside the slice!
                    sliceStr$ = MID$(tempLine$, lineTokenStartChar(chunkStart), lineTokenEndChar(ii) - lineTokenStartChar(chunkStart) + 1)
                    flattenScratchText$(outCount) = LTRIM$(RTRIM$(sliceStr$))
                    flattenScratchMap(outCount) = origLineMap
                  ELSE
                    IF ii > chunkStart THEN
                      outCount = outCount + 1
                      IF outCount >= COMPILE_LINE_MAX THEN
                        throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
                        EXIT FUNCTION
                      END IF
                      ' Notice `ii - 1` is used to cleanly exclude the colon from standard command slices
                      sliceStr$ = MID$(tempLine$, lineTokenStartChar(chunkStart), lineTokenEndChar(ii - 1) - lineTokenStartChar(chunkStart) + 1)
                      flattenScratchText$(outCount) = LTRIM$(RTRIM$(sliceStr$))
                      flattenScratchMap(outCount) = origLineMap

                      ' Targeted evaluation: Only trigger an extra pass if the chunk we just split contains a nested single-line IF
                      hasIf = 0
                      thenPos = 0
                      IF lineTokenVals(chunkStart) = TOK_IF THEN hasIf = 1
                      FOR jj = chunkStart TO ii - 1
                        tVal2 = lineTokenVals(jj)
                        IF tVal2 = TOK_THEN THEN thenPos = jj
                      NEXT
                      IF hasIf = 1 AND thenPos > 0 AND thenPos < ii - 1 THEN needsExtraPass = 1
                    END IF
                  END IF
                  chunkStart = ii + 1
                END IF
              END IF
            NEXT

            ' Strip trailing colons from the end of the line to prevent them from corrupting the final slice
            DO WHILE flattenEnd >= chunkStart
              IF lineTokenVals(flattenEnd) = 256 + ASC(":") THEN
                flattenEnd = flattenEnd - 1
              ELSE
                EXIT DO
              END IF
            LOOP

            IF chunkStart <= flattenEnd THEN
              outCount = outCount + 1
              IF outCount >= COMPILE_LINE_MAX THEN
                throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
                EXIT FUNCTION
              END IF
              sliceStr$ = MID$(tempLine$, lineTokenStartChar(chunkStart), lineTokenEndChar(flattenEnd) - lineTokenStartChar(chunkStart) + 1)
              flattenScratchText$(outCount) = LTRIM$(RTRIM$(sliceStr$))
              flattenScratchMap(outCount) = origLineMap

              hasIf = 0
              thenPos = 0
              IF lineTokenVals(chunkStart) = TOK_IF THEN hasIf = 1
              FOR jj = chunkStart TO flattenEnd
                tVal2 = lineTokenVals(jj)
                IF tVal2 = TOK_THEN THEN thenPos = jj
              NEXT
              IF hasIf = 1 AND thenPos > 0 AND thenPos < flattenEnd THEN needsExtraPass = 1
            END IF

            ' Handle intermediate insertions for single line IF ELSE statements
            IF isSingleLineIf = 1 THEN
              IF hasElse = 1 THEN
                IF iRange = 0 THEN
                  outCount = outCount + 1
                  IF outCount >= COMPILE_LINE_MAX THEN
                    throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
                    EXIT FUNCTION
                  END IF
                  flattenScratchText$(outCount) = "ELSE"
                  flattenScratchMap(outCount) = origLineMap
                END IF
              END IF
            END IF
          NEXT iRange

          ' Append trailing END IF if necessary
          IF isSingleLineIf = 1 THEN
            outCount = outCount + 1
            IF outCount >= COMPILE_LINE_MAX THEN
              throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
              EXIT FUNCTION
            END IF
            flattenScratchText$(outCount) = "END IF"
            flattenScratchMap(outCount) = origLineMap
          END IF
        END IF

        IF hasDirectiveComment = 1 THEN
          outCount = outCount + 1
          IF outCount >= COMPILE_LINE_MAX THEN
            throwCompilerError "FLATTEN LIMIT REACHED", ASIS, 0
            EXIT FUNCTION
          END IF
          flattenScratchText$(outCount) = remText$
          flattenScratchMap(outCount) = origLineMap
        END IF
      END IF
    END IF
  NEXT

  compileLastLine = outCount
  FOR iy = 1 TO compileLastLine
    compileText$(iy) = flattenScratchText$(iy)
    editorLineLinkMap(iy) = flattenScratchMap(iy)
  NEXT

  compilePass1Flatten = needsExtraPass

END FUNCTION ' compilePass1Flatten

''''''''''''''''''''''''
SUB compilePass2LexiConsts

  ' Pass 2: Performs a double sweep to register and evaluate all CONST declarations
  ' Replaces all constant names with literal values throughout the source file
  ' Fully expanded lines are written to the compileText$ array for pass 2

  DIM stripLen AS LONG
  DIM eqPos AS LONG
  DIM inQuotes AS LONG
  DIM valLen AS LONG
  DIM isIdentStart AS LONG
  DIM isMatchFound AS LONG
  DIM matchedIdx AS LONG
  DIM inQ AS LONG
  DIM lineLen AS LONG
  DIM preventExpansion AS LONG
  DIM prevIx AS LONG
  DIM inTypeBlock AS LONG
  DIM firstWordFound AS LONG
  DIM isRem AS LONG
  DIM isDir AS LONG
  DIM cLen AS LONG
  DIM iv AS LONG
  DIM isColon AS LONG
  DIM isComment AS LONG
  DIM stmtStart AS LONG
  DIM isConstStmt AS LONG
  DIM firstWord$
  DIM isAssignment AS LONG
  DIM nextIx AS LONG
  DIM cNext AS LONG
  DIM constNameHashValue AS LONG
  DIM constHashValue AS LONG
  DIM constCheckIdx AS LONG

  textConstCount = 0

  FOR ii = 0 TO SYMBOL_HASH_MASK
    textConstHash(ii) = -1
  NEXT

  ' Sweep 1, harvest constants
  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    currentLineNumber = editorLineLinkMap(iy)
    curLine$ = compileText$(iy)

    inQ = 0
    stmtStart = 1
    cLen = LEN(curLine$)

    FOR ix = 1 TO cLen + 1
      isColon = 0
      isComment = 0

      IF ix <= cLen THEN
        cAs = ASC(curLine$, ix)
        IF cAs = 34 THEN inQ = 1 - inQ
        IF inQ = 0 THEN
          IF cAs = 58 THEN isColon = 1
          IF cAs = 39 THEN isComment = 1
          IF ix <= cLen - 2 THEN
            IF UCASE$(MID$(curLine$, ix, 3)) = "REM" THEN
              isRem = 0
              IF ix = 1 THEN
                isRem = 1
              ELSE
                pAs = ASC(curLine$, ix - 1)
                IF pAs = 32 OR pAs = 9 OR pAs = 58 THEN isRem = 1
              END IF
              IF isRem = 1 THEN
                IF ix + 3 > cLen THEN
                  isComment = 1
                ELSE
                  nAs = ASC(curLine$, ix + 3)
                  IF nAs = 32 OR nAs = 9 THEN isComment = 1
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isComment = 1 OR isColon = 1 OR ix > cLen THEN
        stmt$ = MID$(curLine$, stmtStart, ix - stmtStart)
        stmtTrim$ = LTRIM$(RTRIM$(stmt$))

        ' Strip label from the FIRST statement on the line if it exists
        IF stmtStart = 1 THEN
          fs$ = retLabelStripLength$(stmtTrim$)
          stripLen = returnedData2
          IF stripLen > 0 THEN
            stmtTrim$ = LTRIM$(MID$(stmtTrim$, stripLen + 1))
          END IF
        END IF

        IF UCASE$(LEFT$(stmtTrim$, 6)) = "CONST " THEN
          remLine$ = LTRIM$(MID$(stmtTrim$, 7))
          eqPos = INSTR(remLine$, "=")
          IF eqPos > 0 THEN
            cName$ = UCASE$(LTRIM$(RTRIM$(LEFT$(remLine$, eqPos - 1))))

            cSuffix$ = RIGHT$(cName$, 1)
            IF cSuffix$ = "$" OR cSuffix$ = "#" OR cSuffix$ = "!" OR cSuffix$ = "%" OR cSuffix$ = "&" OR cSuffix$ = "~" THEN
              throwCompilerError "CONSTANTS CANNOT HAVE TYPE SUFFIXES", ASIS, 0
              EXIT SUB
            END IF

            ' Validate the constant name to prevent spaces or malformed identifiers
            isValidName = 1
            IF cName$ = "" THEN isValidName = 0
            firstChName$ = LEFT$(cName$, 1)
            IF firstChName$ >= "0" AND firstChName$ <= "9" THEN isValidName = 0
            IF firstChName$ = "_" THEN isValidName = 0

            FOR iCheck = 1 TO LEN(cName$)
              chCheckName$ = MID$(cName$, iCheck, 1)
              IF NOT ((chCheckName$ >= "A" AND chCheckName$ <= "Z") OR (chCheckName$ >= "0" AND chCheckName$ <= "9") OR chCheckName$ = "_") THEN
                isValidName = 0
                EXIT FOR
              END IF
            NEXT
            IF isValidName = 0 THEN
              throwCompilerError "INVALID CONSTANT NAME", ASIS, 0
              EXIT SUB
            END IF

            cValRaw$ = LTRIM$(RTRIM$(MID$(remLine$, eqPos + 1)))

            constNameHashValue = hashString(cName$)
            constCheckIdx = textConstHash(constNameHashValue)

            DO WHILE constCheckIdx <> -1
              IF textConsts(constCheckIdx).Name = cName$ THEN
                throwCompilerError "CONSTANT ALREADY DEFINED", ASIS, 0
                EXIT SUB
              END IF
              constCheckIdx = textConstHashNext(constCheckIdx)
            LOOP

            expandedVal$ = ""
            inQuotes = 0
            valLen = LEN(cValRaw$)
            iv = 1

            DO WHILE iv <= valLen
              cAs = ASC(cValRaw$, iv)

              IF cAs = 34 THEN
                inQuotes = 1 - inQuotes
                expandedVal$ = expandedVal$ + CHR$(34)
                iv = iv + 1
              ELSE
                isIdentStart = 0
                IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) THEN isIdentStart = 1

                IF inQuotes = 0 AND isIdentStart = 1 THEN
                  preventExpansion = 0
                  prevIx = iv - 1
                  DO WHILE prevIx > 0
                    prevAs = ASC(cValRaw$, prevIx)
                    IF prevAs = 32 OR prevAs = 9 THEN
                      prevIx = prevIx - 1
                    ELSE
                      IF prevAs = 46 OR prevAs = 38 OR prevAs = 35 OR prevAs = 36 OR prevAs = 37 OR prevAs = 33 THEN preventExpansion = 1
                      EXIT DO
                    END IF
                  LOOP

                  tStart = iv
                  DO WHILE iv <= valLen
                    c2As = ASC(cValRaw$, iv)
                    IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 THEN
                      iv = iv + 1
                    ELSE
                      EXIT DO
                    END IF
                  LOOP

                  IF iv <= valLen THEN
                    c2As = ASC(cValRaw$, iv)
                    IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 37 OR c2As = 38 THEN
                      iv = iv + 1
                    END IF
                  END IF

                  ident$ = MID$(cValRaw$, tStart, iv - tStart)

                  isMatchFound = 0
                  matchedIdx = 0
                  searchIdent$ = UCASE$(ident$)

                  IF preventExpansion = 0 AND textConstCount > 0 THEN
                    constHashValue = hashString(searchIdent$)
                    constCheckIdx = textConstHash(constHashValue)

                    DO WHILE constCheckIdx <> -1
                      IF textConsts(constCheckIdx).Name = searchIdent$ THEN
                        matchedIdx = constCheckIdx
                        isMatchFound = 1
                        EXIT DO
                      END IF
                      constCheckIdx = textConstHashNext(constCheckIdx)
                    LOOP
                  END IF

                  IF isMatchFound = 1 THEN
                    expandedVal$ = expandedVal$ + textConsts(matchedIdx).Value
                  ELSE
                    expandedVal$ = expandedVal$ + ident$
                  END IF
                ELSE
                  chunkStart = iv
                  DO WHILE iv <= valLen
                    c2As = ASC(cValRaw$, iv)
                    IF c2As = 34 THEN EXIT DO
                    IF inQuotes = 0 AND ((c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122)) THEN EXIT DO
                    iv = iv + 1
                  LOOP
                  expandedVal$ = expandedVal$ + MID$(cValRaw$, chunkStart, iv - chunkStart)
                END IF
              END IF
            LOOP

            expandedVal$ = LTRIM$(RTRIM$(expandedVal$))
            expandedVal$ = evalMathConst$(expandedVal$)

            IF textConstCount < MAX_TEXT_CONSTS THEN
              textConsts(textConstCount).Name = cName$
              textConsts(textConstCount).Value = expandedVal$
              textConstHashNext(textConstCount) = textConstHash(constNameHashValue)
              textConstHash(constNameHashValue) = textConstCount
              textConstCount = textConstCount + 1
            ELSE
              throwCompilerError "CONSTANT LIMIT EXCEEDED", ASIS, 0
              EXIT SUB
            END IF
          ELSE
            throwCompilerError "EXPECTED = IN CONST DECLARATION", ASIS, 0
            EXIT SUB
          END IF
        END IF

        IF isComment = 1 THEN EXIT FOR
        stmtStart = ix + 1
      END IF
    NEXT
  NEXT

  IF textConstCount = 0 THEN
    currentLineNumber = 1
    EXIT SUB
  END IF

  ' Sweep 2, replace constants with literal values
  inTypeBlock = 0

  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    currentLineNumber = editorLineLinkMap(iy)
    curLine$ = compileText$(iy)

    ' Check END TYPE before processing line
    tempLine$ = LTRIM$(RTRIM$(curLine$))
    fs$ = retLabelStripLength$(tempLine$)
    stripLen = returnedData2
    rawNoLabel$ = tempLine$
    IF stripLen > 0 THEN
      rawNoLabel$ = LTRIM$(MID$(tempLine$, stripLen + 1))
    END IF
    IF UCASE$(LEFT$(rawNoLabel$, 8)) = "END TYPE" THEN
      inTypeBlock = 0
    END IF

    inQ = 0
    stmtStart = 1
    cLen = LEN(curLine$)
    expandedLine$ = ""

    FOR ix = 1 TO cLen + 1
      isColon = 0
      isComment = 0

      IF ix <= cLen THEN
        cAs = ASC(curLine$, ix)
        IF cAs = 34 THEN inQ = 1 - inQ
        IF inQ = 0 THEN
          IF cAs = 58 THEN isColon = 1
          IF cAs = 39 THEN isComment = 1
          IF ix <= cLen - 2 THEN
            IF UCASE$(MID$(curLine$, ix, 3)) = "REM" THEN
              isRem = 0
              IF ix = 1 THEN
                isRem = 1
              ELSE
                pAs = ASC(curLine$, ix - 1)
                IF pAs = 32 OR pAs = 9 OR pAs = 58 THEN isRem = 1
              END IF
              IF isRem = 1 THEN
                IF ix + 3 > cLen THEN
                  isComment = 1
                ELSE
                  nAs = ASC(curLine$, ix + 3)
                  IF nAs = 32 OR nAs = 9 THEN isComment = 1
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF

      IF isComment = 1 OR isColon = 1 OR ix > cLen THEN
        stmt$ = MID$(curLine$, stmtStart, ix - stmtStart)
        stmtTrim$ = LTRIM$(RTRIM$(stmt$))

        isConstStmt = 0

        ' Strip label from the FIRST statement on the line if it exists
        IF stmtStart = 1 THEN
          fs$ = retLabelStripLength$(stmtTrim$)
          stripLen = returnedData2
          IF stripLen > 0 THEN
            stmtTrim$ = LTRIM$(MID$(stmtTrim$, stripLen + 1))
          END IF
        END IF

        IF UCASE$(LEFT$(stmtTrim$, 6)) = "CONST " THEN
          isConstStmt = 1
        END IF

        IF isConstStmt = 0 THEN
          firstWordFound = 0
          firstWord$ = ""
          inQuotes = 0
          valLen = LEN(stmt$)
          iv = 1
          stmtExpanded$ = ""

          DO WHILE iv <= valLen
            cAs = ASC(stmt$, iv)

            IF cAs = 34 THEN
              inQuotes = 1 - inQuotes
              stmtExpanded$ = stmtExpanded$ + CHR$(34)
              iv = iv + 1
            ELSE
              isIdentStart = 0
              IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) THEN isIdentStart = 1

              IF inQuotes = 0 AND isIdentStart = 1 THEN
                preventExpansion = 0
                prevIx = iv - 1
                DO WHILE prevIx > 0
                  prevAs = ASC(stmt$, prevIx)
                  IF prevAs = 32 OR prevAs = 9 THEN
                    prevIx = prevIx - 1
                  ELSE
                    IF prevAs = 46 OR prevAs = 38 OR prevAs = 35 OR prevAs = 36 OR prevAs = 37 OR prevAs = 33 THEN preventExpansion = 1
                    EXIT DO
                  END IF
                LOOP

                IF inTypeBlock = 1 AND firstWordFound = 0 THEN
                  preventExpansion = 1
                END IF

                tStart = iv
                DO WHILE iv <= valLen
                  c2As = ASC(stmt$, iv)
                  IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 THEN
                    iv = iv + 1
                  ELSE
                    EXIT DO
                  END IF
                LOOP

                IF iv <= valLen THEN
                  c2As = ASC(stmt$, iv)
                  IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 37 OR c2As = 38 THEN
                    iv = iv + 1
                  END IF
                END IF

                ident$ = MID$(stmt$, tStart, iv - tStart)

                isMatchFound = 0
                matchedIdx = 0
                searchIdent$ = UCASE$(ident$)

                IF preventExpansion = 0 AND textConstCount > 0 THEN
                  constHashValue = hashString(searchIdent$)
                  constCheckIdx = textConstHash(constHashValue)

                  DO WHILE constCheckIdx <> -1
                    IF textConsts(constCheckIdx).Name = searchIdent$ THEN
                      matchedIdx = constCheckIdx
                      isMatchFound = 1
                      EXIT DO
                    END IF
                    constCheckIdx = textConstHashNext(constCheckIdx)
                  LOOP
                END IF

                IF isMatchFound = 1 THEN
                  isAssignment = 0

                  IF firstWordFound = 0 THEN
                    isAssignment = 1
                  ELSE
                    IF UCASE$(firstWord$) = "LET" OR UCASE$(firstWord$) = "FOR" THEN
                      nextIx = iv
                      DO WHILE nextIx <= valLen
                        cNext = ASC(stmt$, nextIx)
                        IF cNext = 32 OR cNext = 9 THEN
                          nextIx = nextIx + 1
                        ELSE
                          EXIT DO
                        END IF
                      LOOP

                      IF nextIx <= valLen THEN
                        IF ASC(stmt$, nextIx) = 61 THEN ' '='
                          isAssignment = 1
                        END IF
                      END IF
                    END IF
                  END IF

                  IF isAssignment = 1 THEN
                    throwCompilerError "CANNOT ASSIGN TO CONSTANT " + searchIdent$, ASIS, 0
                    EXIT SUB
                  END IF

                  stmtExpanded$ = stmtExpanded$ + textConsts(matchedIdx).Value
                ELSE
                  stmtExpanded$ = stmtExpanded$ + ident$
                END IF

                IF firstWordFound = 0 THEN
                  firstWordFound = 1
                  firstWord$ = ident$
                END IF
              ELSE
                chunkStart = iv
                DO WHILE iv <= valLen
                  c2As = ASC(stmt$, iv)
                  IF c2As = 34 THEN EXIT DO
                  IF inQuotes = 0 AND ((c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122)) THEN EXIT DO
                  iv = iv + 1
                LOOP
                stmtExpanded$ = stmtExpanded$ + MID$(stmt$, chunkStart, iv - chunkStart)
              END IF
            END IF
          LOOP

          expandedLine$ = expandedLine$ + stmtExpanded$
        ELSE
          ' Safely restore labels onto lines whose CONST statement was deleted
          IF stmtStart = 1 AND stripLen > 0 THEN
            expandedLine$ = expandedLine$ + LEFT$(stmt$, stripLen)
          END IF
        END IF

        IF isComment = 1 THEN
          isDir = 0
          checkDir$ = LTRIM$(MID$(curLine$, ix + 1))
          IF ix <= cLen - 2 THEN
            IF UCASE$(MID$(curLine$, ix, 3)) = "REM" THEN
              checkDir$ = LTRIM$(MID$(curLine$, ix + 3))
            END IF
          END IF

          IF checkIfPreprocessorKeyword(checkDir$) = 1 THEN isDir = 1

          IF isDir = 1 THEN
            IF ix <= cLen - 2 THEN
              IF UCASE$(MID$(curLine$, ix, 3)) = "REM" THEN
                expandedLine$ = expandedLine$ + "REM " + checkDir$
              ELSE
                expandedLine$ = expandedLine$ + "'" + checkDir$
              END IF
            ELSE
              expandedLine$ = expandedLine$ + "'" + checkDir$
            END IF
          ELSE
            expandedLine$ = expandedLine$ + MID$(curLine$, ix)
          END IF
          EXIT FOR
        END IF

        IF isColon = 1 THEN
          expandedLine$ = expandedLine$ + ":"
        END IF

        stmtStart = ix + 1
      END IF
    NEXT

    compileText$(iy) = expandedLine$

    IF UCASE$(LEFT$(rawNoLabel$, 5)) = "TYPE " THEN
      inTypeBlock = 1
    END IF
  NEXT

  currentLineNumber = 1

END SUB ' compilePass2LexiConsts

''''''''''''''''''''''''
SUB compilePass3Scan

  ' Pass 3: Evaluates standard mid-code DEFINT bounds and checks for deprecated visual keywords
  ' Global preprocessor directives have already been processed and converted to comments by this point

  DIM firstCodeLineFound AS LONG
  DIM stripLen AS LONG
  DIM tVal AS LONG
  DIM warnedTok(1024) AS LONG

  DIM screenHandled AS LONG
  DIM screenParenEnd AS LONG
  DIM screenComma1 AS LONG
  DIM screenComma2 AS LONG
  DIM screenWidth AS LONG
  DIM screenHeight AS LONG
  DIM screenWidthStr$
  DIM screenHeightStr$
  DIM tokStr$
  DIM uTok$
  DIM valStr$
  DIM vName$

  DIM trackedVars(256) AS STRING
  DIM trackedVals(256) AS LONG
  DIM numTracked AS LONG
  DIM isNum AS LONG
  DIM foundIdx AS LONG

  FOR ii = 0 TO 1024
    warnedTok(ii) = 0
  NEXT

  firstCodeLineFound = 0
  defaultArrayDynamic = 0
  compileScreenMode = 0
  optionBaseValue = 0
  numTracked = 0

  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    currentLineNumber = editorLineLinkMap(iy)
    curLine$ = compileText$(iy)
    tempLine$ = LTRIM$(RTRIM$(curLine$))

    IF LEN(tempLine$) > 0 THEN
      fs$ = retLabelStripLength$(tempLine$)
      stripLen = returnedData2

      IF stripLen > 0 THEN
        tempLine$ = LTRIM$(MID$(tempLine$, stripLen + 1))
      END IF

      IF LEN(tempLine$) > 0 THEN
        tokenizeLine tempLine$
        IF compileError = 1 THEN EXIT SUB

        IF lineTokenCount > 0 THEN
          ' OPTION BASE is consumed here so every array layout pass uses the same default
          IF lineTokenVals(0) = 0 THEN
            IF UCASE$(lineTokens$(0)) = "OPTION" THEN
              IF lineTokenCount < 2 THEN
                throwCompilerError "ONLY OPTION BASE IS SUPPORTED", ASIS, 0
                EXIT SUB
              END IF

              IF UCASE$(lineTokens$(1)) <> "BASE" THEN
                throwCompilerError "ONLY OPTION BASE IS SUPPORTED", ASIS, 0
                EXIT SUB
              END IF

              IF lineTokenCount <> 3 THEN
                throwCompilerError "OPTION BASE REQUIRES 0 OR 1", ASIS, 0
                EXIT SUB
              END IF

              valStr$ = lineTokens$(2)

              IF valStr$ = "0" THEN
                optionBaseValue = 0
              ELSE
                IF valStr$ = "1" THEN
                  optionBaseValue = 1
                ELSE
                  throwCompilerError "OPTION BASE REQUIRES 0 OR 1", ASIS, 0
                  EXIT SUB
                END IF
              END IF

              IF stripLen > 0 THEN
                compileText$(iy) = fs$ + ":"
              ELSE
                compileText$(iy) = ""
              END IF

              lineTokenVals(0) = TOK_REM
              lineTokenCount = 1
            END IF
          END IF

          IF lineTokenVals(0) = 0 THEN
            IF lineTokenCount >= 3 THEN
              IF lineTokenVals(1) = 256 + ASC("=") THEN
                IF lineTokenVals(2) = 0 THEN
                  valStr$ = lineTokens$(2)
                  isNum = 1
                  FOR ii = 1 TO LEN(valStr$)
                    IF ASC(valStr$, ii) < 48 OR ASC(valStr$, ii) > 57 THEN isNum = 0
                  NEXT
                  IF isNum = 1 THEN
                    vName$ = UCASE$(lineTokens$(0))
                    foundIdx = -1
                    FOR ii = 0 TO numTracked - 1
                      IF trackedVars(ii) = vName$ THEN
                        foundIdx = ii
                        EXIT FOR
                      END IF
                    NEXT
                    IF foundIdx <> -1 THEN
                      trackedVals(foundIdx) = VAL(valStr$)
                    ELSE
                      IF numTracked < 256 THEN
                        trackedVars(numTracked) = vName$
                        trackedVals(numTracked) = VAL(valStr$)
                        numTracked = numTracked + 1
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF

          FOR iTok = 0 TO lineTokenCount - 1
            tVal = lineTokenVals(iTok)

            SELECT CASE tVal

              CASE TOK_SCREEN
                screenHandled = 0

                IF compileScreenMode <= 0 THEN
                  IF iTok + 2 < lineTokenCount THEN
                    IF lineTokenVals(iTok + 1) = TOK_NEWIMAGE THEN
                      IF lineTokenVals(iTok + 2) = 256 + ASC("(") THEN

                        ff = findMatchingParen(iTok + 2, lineTokenCount - 1)

                        IF ff = 1 THEN
                          screenParenEnd = returnedData2

                          screenComma1 = findComma(iTok + 3, screenParenEnd - 1)

                          IF screenComma1 > 0 THEN
                            screenComma2 = findComma(screenComma1 + 1, screenParenEnd - 1)

                            IF screenComma2 > 0 THEN
                              screenWidthStr$ = ""

                              FOR ii = iTok + 3 TO screenComma1 - 1
                                tokStr$ = retTokenText$(lineTokens$(ii))
                                IF lineTokenVals(ii) = 0 THEN
                                  uTok$ = UCASE$(tokStr$)
                                  FOR jj = 0 TO numTracked - 1
                                    IF trackedVars(jj) = uTok$ THEN
                                      tokStr$ = LTRIM$(STR$(trackedVals(jj)))
                                      EXIT FOR
                                    END IF
                                  NEXT
                                END IF
                                screenWidthStr$ = screenWidthStr$ + tokStr$
                              NEXT

                              screenHeightStr$ = ""

                              FOR ii = screenComma1 + 1 TO screenComma2 - 1
                                tokStr$ = retTokenText$(lineTokens$(ii))
                                IF lineTokenVals(ii) = 0 THEN
                                  uTok$ = UCASE$(tokStr$)
                                  FOR jj = 0 TO numTracked - 1
                                    IF trackedVars(jj) = uTok$ THEN
                                      tokStr$ = LTRIM$(STR$(trackedVals(jj)))
                                      EXIT FOR
                                    END IF
                                  NEXT
                                END IF
                                screenHeightStr$ = screenHeightStr$ + tokStr$
                              NEXT

                              screenWidthStr$ = evalMathConst$(screenWidthStr$)
                              screenHeightStr$ = evalMathConst$(screenHeightStr$)

                              screenWidth = VAL(screenWidthStr$)
                              screenHeight = VAL(screenHeightStr$)

                              IF screenWidth > 0 AND screenHeight > 0 THEN
                                IF screenWidth < 64 OR screenWidth > FRAMEBUF_MAX_WIDTH THEN
                                  throwCompilerError "SCREEN WIDTH MUST BE 64 TO 1024", ASIS, 0
                                  EXIT SUB
                                END IF

                                IF screenHeight < 64 OR screenHeight > FRAMEBUF_MAX_HEIGHT THEN
                                  throwCompilerError "SCREEN HEIGHT IS OUTSIDE THE FRAMEBUFFER LIMIT", ASIS, 0
                                  EXIT SUB
                                END IF

                                IF compileScreenMode = 0 THEN
                                  gfxConfig.SizeX = screenWidth
                                  gfxConfig.SizeY = screenHeight
                                ELSE
                                  IF screenWidth > gfxConfig.SizeX THEN gfxConfig.SizeX = screenWidth
                                  IF screenHeight > gfxConfig.SizeY THEN gfxConfig.SizeY = screenHeight
                                END IF

                                ' Negative one marks an image-defined screen.
                                compileScreenMode = -1
                                screenHandled = 1
                              END IF
                            END IF
                          END IF
                        END IF
                      END IF
                    END IF
                  END IF
                END IF

                ' Handle classic numeric SCREEN modes
                IF screenHandled = 0 THEN
                  IF iTok + 1 < lineTokenCount THEN
                    IF lineTokenVals(iTok + 1) = 0 THEN
                      sMode$ = lineTokens$(iTok + 1)
                      uTok$ = UCASE$(sMode$)
                      FOR jj = 0 TO numTracked - 1
                        IF trackedVars(jj) = uTok$ THEN
                          sMode$ = LTRIM$(STR$(trackedVals(jj)))
                          EXIT FOR
                        END IF
                      NEXT

                      IF sMode$ = "7" OR sMode$ = "1" OR sMode$ = "2" OR sMode$ = "8" OR sMode$ = "9" OR sMode$ = "10" OR sMode$ = "11" OR sMode$ = "12" OR sMode$ = "13" THEN
                        IF sMode$ <> "13" AND cm.ClassicMode = 0 THEN
                          throwCompilerError "SCREEN " + sMode$ + " REQUIRES #CLASSIC MODE", ASIS, 0
                          EXIT SUB
                        END IF

                        ' Ensure the primary screen mode is dictated by the first command seen
                        IF compileScreenMode <= 0 THEN
                          compileScreenMode = VAL(sMode$)

                          SELECT CASE compileScreenMode

                            CASE 1, 7, 13
                              gfxConfig.SizeX = 320
                              gfxConfig.SizeY = 200

                            CASE 2, 8
                              gfxConfig.SizeX = 640
                              gfxConfig.SizeY = 200

                            CASE 9, 10
                              gfxConfig.SizeX = 640
                              gfxConfig.SizeY = 350

                            CASE 11, 12
                              gfxConfig.SizeX = 640
                              gfxConfig.SizeY = 480

                          END SELECT ' compileScreenMode
                        END IF

                        screenHandled = 1
                      END IF
                    END IF
                  END IF
                END IF

                ' Preserve page-only SCREEN statements for the runtime parser
                IF screenHandled = 0 THEN
                  IF iTok + 1 < lineTokenCount THEN
                    IF lineTokenVals(iTok + 1) = 256 + ASC(",") THEN
                      screenHandled = 1
                    END IF
                  END IF
                END IF

                ' Warn only when the SCREEN form could not be used
                IF screenHandled = 0 THEN
                  IF warnedTok(tVal) = 0 THEN
                    warnStr$ = retTokenText$(lineTokens$(iTok))
                    IF warnStr$ = "" THEN warnStr$ = "UNKNOWN"
                    addStatusMsg "WARNING line " + retLineNumberStr$ + ": " + warnStr$ + " ENCOUNTERED AND IGNORED"
                    warnedTok(tVal) = 1
                  END IF
                END IF

              CASE TOK_WIDTH, TOK_SNDOPEN, TOK_SNDPLAY, TOK_SOUND
                IF warnedTok(tVal) = 0 THEN
                  warnStr$ = retTokenText$(lineTokens$(iTok))
                  IF warnStr$ = "" THEN warnStr$ = "UNKNOWN"
                  addStatusMsg "WARNING line " + retLineNumberStr$ + ": " + warnStr$ + " ENCOUNTERED AND IGNORED"
                  warnedTok(tVal) = 1
                END IF

            END SELECT ' tVal

          NEXT

          tVal = lineTokenVals(0)

          SELECT CASE tVal

            CASE TOK_DEFINT
              IF cm.HasGlobalDefInt = 1 THEN
                addStatusMsg "WARNING line " + retLineNumberStr$ + ": DEFINT IGNORED, #GLDEFINT ACTIVE"
              END IF
              firstCodeLineFound = 1

            CASE TOK_REM
              ' Ignore comment lines so they do not falsely flag as the first line of code

            CASE ELSE
              firstCodeLineFound = 1

          END SELECT ' tVal

        END IF
      END IF
    END IF
  NEXT

  IF cm.EmeraldMode = 1 AND cm.ClassicMode = 1 THEN
    throwCompilerError "CANNOT USE BOTH #EMERALD AND #CLASSIC", ASIS, 0
    EXIT SUB
  END IF

  ' Save the global directive baseline before the sequential parsing passes begin
  FOR ix = 0 TO 25
    baseDefIntMap(ix) = defIntMap(ix)
  NEXT

  currentLineNumber = 1

END SUB ' compilePass3Scan

''''''''''''''''''''''''
SUB compilePass4Symbols

  ' Pass 4: Discovers and registers all symbols (Labels, Subs, Functions, UDTs, Declares)
  ' Validates matching signatures between DECLARE statements and actual subroutine definitions
  ' Builds the scope mapping and structure offsets for complex data types

  DIM inTypeBlock AS LONG
  DIM currentUdtIdx AS LONG
  DIM stripLen AS LONG
  DIM isNum AS LONG
  DIM numVal AS LONG
  DIM vIdx AS LONG
  DIM tVal AS LONG
  DIM isUdtLine AS LONG
  DIM tVal2 AS LONG
  DIM dRetType AS LONG
  DIM charIdx AS LONG
  DIM tokIdx AS LONG
  DIM aType AS LONG
  DIM aArray AS LONG
  DIM fieldSize AS LONG
  DIM fieldType AS LONG
  DIM fIdx AS LONG
  DIM nameIdx AS LONG
  DIM vIdxArg AS LONG
  DIM subIdx AS LONG
  DIM retVarIdx AS LONG
  DIM argVarIdx AS LONG
  DIM tempUdtIndex AS LONG
  DIM tempIsDynamicString AS LONG
  DIM dtMapped AS LONG
  DIM fixedLen AS LONG
  DIM typeData AS LONG
  DIM inDeclareBlock AS LONG
  DIM currentDllName$
  DIM isLibBlock AS LONG
  DIM scanTok AS LONG
  DIM vIdxRet AS LONG
  DIM isByValArg AS LONG

  inTypeBlock = 0
  currentUdtIdx = 0
  udtCount = 0 ' Initialize the global UDT counter
  defaultArrayDynamic = 0
  inDeclareBlock = 0
  currentDllName$ = ""

  ' Inject _MEM UDT for native memory manipulation
  udts(udtCount).RecordName = "_MEM"
  udtFields(udtCount, 0).FieldName = "OFFSET"
  udtFields(udtCount, 0).DataType = TYPE_INTEGER64
  udtFields(udtCount, 0).Offset = 0
  udtFields(udtCount, 0).Size = 8
  udtFields(udtCount, 0).UDTIndex = 0
  udtFields(udtCount, 0).IsDynamicString = 0

  udtFields(udtCount, 1).FieldName = "SIZE"
  udtFields(udtCount, 1).DataType = TYPE_INTEGER64
  udtFields(udtCount, 1).Offset = 8
  udtFields(udtCount, 1).Size = 8
  udtFields(udtCount, 1).UDTIndex = 0
  udtFields(udtCount, 1).IsDynamicString = 0

  udtFields(udtCount, 2).FieldName = "ELEMENTSIZE"
  udtFields(udtCount, 2).DataType = TYPE_INTEGER64
  udtFields(udtCount, 2).Offset = 16
  udtFields(udtCount, 2).Size = 8
  udtFields(udtCount, 2).UDTIndex = 0
  udtFields(udtCount, 2).IsDynamicString = 0

  udtFields(udtCount, 3).FieldName = "TYPE"
  udtFields(udtCount, 3).DataType = TYPE_LONG
  udtFields(udtCount, 3).Offset = 24
  udtFields(udtCount, 3).Size = 4
  udtFields(udtCount, 3).UDTIndex = 0
  udtFields(udtCount, 3).IsDynamicString = 0

  udts(udtCount).FieldCount = 4
  udts(udtCount).TotalSize = 28
  currentUdtIdx = 1
  udtCount = 1

  FOR iy = 1 TO compileLastLine
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    currentLineNumber = editorLineLinkMap(iy)
    curLine$ = compileText$(iy)
    tempLine$ = LTRIM$(RTRIM$(curLine$))

    IF LEN(tempLine$) > 0 THEN
      labelStr$ = retLabelStripLength$(tempLine$)
      stripLen = returnedData2

      IF stripLen > 0 THEN
        labelName$ = UCASE$(labelStr$)

        isNum = 1
        FOR ii = 1 TO LEN(labelName$)
          chCheck$ = MID$(labelName$, ii, 1)
          IF chCheck$ < "0" OR chCheck$ > "9" THEN
            isNum = 0
            EXIT FOR
          END IF
        NEXT

        IF isNum = 1 THEN
          IF currentScopeID > 0 THEN
            throwCompilerError "NUMERIC LABELS NOT ALLOWED IN SUB OR FUNCTION", ASIS, 0
            EXIT SUB
          END IF

          numVal = VAL(labelName$)

          IF numVal = 0 THEN
            throwCompilerError "NUMERIC LABEL 0 IS NOT ALLOWED", ASIS, 0
            EXIT SUB
          END IF

          IF cm.ClassicMode = 0 THEN
            IF numVal <= lastNumericLabel THEN
              throwCompilerError "NUMERIC LABEL " + LTRIM$(RTRIM$(STR$(numVal))) + " FOUND AFTER " + LTRIM$(RTRIM$(STR$(lastNumericLabel))), ASIS, 0
              EXIT SUB
            END IF
          END IF
          lastNumericLabel = numVal
        END IF

        ' Unconditionally prefix ALL user labels with % to isolate them from variable namespaces
        labelName$ = "%" + labelName$

        ff = resolveSymbol(labelName$)
        IF ff = 0 THEN EXIT SUB
        vIdx = returnedData2

        IF symbols(vIdx).alreadyParsed = 1 THEN
          throwCompilerError "DUPLICATE LABEL " + labelStr$, ASIS, 0
          EXIT SUB
        END IF

        symbols(vIdx).DataType = TYPE_LABEL
        symbols(vIdx).Offset = -1
        symbols(vIdx).IsExplicit = DECL_EXPLICIT
        symbols(vIdx).alreadyParsed = 1
        symbols(vIdx).DataIndex = dataItemCount

        tempLine$ = LTRIM$(MID$(tempLine$, stripLen + 1))
      END IF

      IF LEN(tempLine$) > 0 THEN
        tokenizeLine tempLine$

        IF compileError = 1 THEN EXIT SUB

        IF lineTokenCount > 0 THEN
          firstTok$ = lineTokens$(0)
          tVal = lineTokenVals(0)
          isUdtLine = 0

          IF tVal = TOK_DECLARE OR tVal = TOK_DECLARE_META THEN
            isUdtLine = 1 ' Mark as handled so it ignores SUB/FUNCTION registration

            isLibBlock = 0
            IF tVal = TOK_DECLARE_META THEN isLibBlock = 1
            IF lineTokenCount >= 2 THEN
              tVal2 = lineTokenVals(1)
              IF tVal2 = TOK_DYNAMIC OR tVal2 = TOK_LIBRARY OR tVal2 = TOK_STATIC_VAR THEN
                isLibBlock = 1
              END IF
            END IF

            IF isLibBlock = 1 THEN
              inDeclareBlock = 1
              currentDllName$ = ""

              FOR scanTok = 1 TO lineTokenCount - 1
                IF LEFT$(lineTokens$(scanTok), 1) = CHR$(34) THEN
                  currentDllName$ = extractQuotes$(lineTokens$(scanTok))
                  EXIT FOR
                END IF
              NEXT

              compileText$(iy) = "" ' Erase line so Pass 5 ignores it
            ELSE
              IF lineTokenCount >= 3 THEN
                tVal2 = lineTokenVals(1)
                IF tVal2 = TOK_SUB OR tVal2 = TOK_FUNCTION THEN
                  IF declareCount >= MAX_SUBS THEN
                    throwCompilerError "DECLARE LIMIT REACHED", ASIS, 0
                    EXIT SUB
                  END IF

                  dName$ = UCASE$(lineTokens$(2))
                  dRetType = TYPE_UNDEFINED ' Default inert type for SUB

                  IF LEFT$(dName$, 1) = "_" THEN
                    throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
                    EXIT SUB
                  END IF

                  IF tVal2 = TOK_FUNCTION THEN
                    declares(declareCount).IsFunction = 1

                    IF dName$ = "" THEN
                      throwCompilerError "EXPECTED FUNCTION NAME", ASIS, 0
                      EXIT SUB
                    END IF

                    dRetType = TYPE_SINGLE
                    lastTwo$ = RIGHT$(dName$, 2)
                    IF lastTwo$ = "&&" THEN
                      dRetType = TYPE_INTEGER64
                    ELSE
                      IF lastTwo$ = "~&" THEN
                        dRetType = TYPE_ULONG
                      ELSE
                        suffix$ = RIGHT$(dName$, 1)
                        IF suffix$ = "$" THEN dRetType = TYPE_STRING
                        IF suffix$ = "#" THEN dRetType = TYPE_DOUBLE
                        IF suffix$ = "!" THEN dRetType = TYPE_SINGLE
                        IF suffix$ = "%" THEN dRetType = TYPE_INTEGER
                        IF suffix$ = "&" THEN dRetType = TYPE_LONG
                        IF suffix$ = "~" THEN dRetType = TYPE_ULONG
                        IF suffix$ <> "$" AND suffix$ <> "#" AND suffix$ <> "!" AND suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "~" THEN
                          charIdx = ASC(LEFT$(dName$, 1)) - 65
                          IF charIdx >= 0 AND charIdx <= 25 THEN
                            IF defIntMap(charIdx) = 1 THEN dRetType = TYPE_INTEGER
                          END IF
                        END IF
                      END IF
                    END IF
                  ELSE
                    declares(declareCount).IsFunction = 0
                  END IF

                  declares(declareCount).RecordName = dName$
                  declares(declareCount).RetType = dRetType
                  declares(declareCount).LineNumber = currentLineNumber
                  declares(declareCount).ArgCount = 0

                  tokIdx = 3
                  IF tokIdx < lineTokenCount THEN
                    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
                      tokIdx = tokIdx + 1
                      DO WHILE tokIdx < lineTokenCount
                        argTok$ = lineTokens$(tokIdx)
                        IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN EXIT DO

                        isByValArg = 0
                        IF lineTokenVals(tokIdx) = TOK_BYVAL THEN
                          isByValArg = 1
                          tokIdx = tokIdx + 1
                          IF tokIdx < lineTokenCount THEN
                            argTok$ = lineTokens$(tokIdx)
                          ELSE
                            throwCompilerError "EXPECTED ARG NAME AFTER BYVAL", ASIS, 0
                            EXIT SUB
                          END IF
                        ELSE
                          IF lineTokenVals(tokIdx) = 0 AND UCASE$(argTok$) = "BYVAL" THEN
                            isByValArg = 1
                            tokIdx = tokIdx + 1
                            IF tokIdx < lineTokenCount THEN
                              argTok$ = lineTokens$(tokIdx)
                            ELSE
                              throwCompilerError "EXPECTED ARG NAME AFTER BYVAL", ASIS, 0
                              EXIT SUB
                            END IF
                          END IF
                        END IF

                        IF lineTokenVals(tokIdx) = 0 THEN
                          aName$ = UCASE$(argTok$)

                          IF aName$ = "" THEN
                            throwCompilerError "EXPECTED ARGUMENT NAME", ASIS, 0
                            EXIT SUB
                          END IF

                          IF LEFT$(aName$, 1) = "_" THEN
                            throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
                            EXIT SUB
                          END IF

                          aType = TYPE_SINGLE
                          lastTwo$ = RIGHT$(aName$, 2)
                          IF lastTwo$ = "&&" THEN
                            aType = TYPE_INTEGER64
                          ELSE
                            IF lastTwo$ = "~&" THEN
                              aType = TYPE_ULONG
                            ELSE
                              suffix$ = RIGHT$(aName$, 1)
                              IF suffix$ = "$" THEN aType = TYPE_STRING
                              IF suffix$ = "#" THEN aType = TYPE_DOUBLE
                              IF suffix$ = "!" THEN aType = TYPE_SINGLE
                              IF suffix$ = "%" THEN aType = TYPE_INTEGER
                              IF suffix$ = "&" THEN aType = TYPE_LONG
                              IF suffix$ = "~" THEN aType = TYPE_ULONG
                              IF suffix$ <> "$" AND suffix$ <> "#" AND suffix$ <> "!" AND suffix$ <> "%" AND suffix$ <> "&" AND suffix$ <> "~" THEN
                                charIdx = ASC(LEFT$(aName$, 1)) - 65
                                IF charIdx >= 0 AND charIdx <= 25 THEN
                                  IF defIntMap(charIdx) = 1 THEN aType = TYPE_INTEGER
                                END IF
                              END IF
                            END IF
                          END IF

                          aArray = 0

                          IF tokIdx + 1 < lineTokenCount THEN
                            IF lineTokenVals(tokIdx + 1) = 256 + ASC("(") THEN
                              IF tokIdx + 2 < lineTokenCount THEN
                                IF lineTokenVals(tokIdx + 2) = 256 + ASC(")") THEN
                                  aArray = 2
                                  tokIdx = tokIdx + 2
                                ELSE
                                  throwCompilerError "EXPECTED )", ASIS, 0
                                  EXIT SUB
                                END IF
                              ELSE
                                throwCompilerError "EXPECTED )", ASIS, 0
                                EXIT SUB
                              END IF
                            END IF
                          END IF

                          IF tokIdx + 1 < lineTokenCount THEN
                            IF lineTokenVals(tokIdx + 1) = TOK_AS THEN
                              tokIdx = tokIdx + 2
                              tokIdx = parseTypeClause(tokIdx, lineTokenCount - 1, 0) - 1
                              aType = returnedData2
                              IF aType = TYPE_UNDEFINED THEN EXIT SUB
                            END IF
                          END IF

                          IF declares(declareCount).ArgCount < 16 THEN
                            declareArgType(declareCount, declares(declareCount).ArgCount) = aType
                            declareArgArray(declareCount, declares(declareCount).ArgCount) = aArray
                            byValTracker(declareCount, declares(declareCount).ArgCount).DeclareArg = isByValArg
                            declares(declareCount).ArgCount = declares(declareCount).ArgCount + 1
                          ELSE
                            throwCompilerError "TOO MANY ARGS IN DECLARE", ASIS, 0
                            EXIT SUB
                          END IF
                        END IF

                        tokIdx = tokIdx + 1
                        IF tokIdx < lineTokenCount THEN
                          IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
                            tokIdx = tokIdx + 1
                          ELSE
                            IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN
                            ELSE
                              throwCompilerError "EXPECTED COMMA IN DECLARE", ASIS, 0
                              EXIT SUB
                            END IF
                          END IF
                        END IF
                      LOOP
                    END IF
                  END IF

                  declareCount = declareCount + 1
                  compileText$(iy) = "" ' Erase line so Pass 5 ignores it

                ELSE
                  throwCompilerError "EXPECTED SUB OR FUNCTION AFTER DECLARE", ASIS, 0
                  EXIT SUB
                END IF
              ELSE
                throwCompilerError "MALFORMED DECLARE", ASIS, 0
                EXIT SUB
              END IF
            END IF
          END IF

          IF tVal = TOK_DATA THEN
            isUdtLine = 1 ' Mark as handled so it ignores SUB/FUNCTION registration
            tokIdx = 1
            DO WHILE tokIdx < lineTokenCount
              itemStr$ = ""
              DO WHILE tokIdx < lineTokenCount
                IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN EXIT DO
                tTok$ = lineTokens$(tokIdx)
                IF LEFT$(tTok$, 1) = CHR$(34) THEN
                  itemStr$ = itemStr$ + extractQuotes$(tTok$)
                ELSE
                  itemStr$ = itemStr$ + retTokenText$(tTok$)
                END IF
                tokIdx = tokIdx + 1
              LOOP

              IF dataItemCount > MAX_DATA_ITEMS THEN
                throwCompilerError "DATA LIMIT REACHED", ASIS, 0
                EXIT SUB
              END IF

              ff = resolveSymbol("!C_SYS_DSC_DATA_ITEM_" + LTRIM$(RTRIM$(STR$(dataItemCount))))
              IF ff = 1 THEN
                descIdx = returnedData2
                strVarData$(descIdx) = itemStr$
                dataItemDescIdx(dataItemCount) = descIdx
              END IF
              dataItemCount = dataItemCount + 1

              IF tokIdx < lineTokenCount THEN
                IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN tokIdx = tokIdx + 1
              END IF
            LOOP
            compileText$(iy) = "" ' Erase line so Pass 5 ignores it
          END IF

          IF tVal = TOK_DEFINT THEN
            isUdtLine = 1 ' Mark as handled so it ignores SUB/FUNCTION registration
            ff = parse_DEFINT(0)
            IF ff = 0 THEN EXIT SUB
            ' Do NOT erase the line, because Pass 5 still needs to execute it sequentially
            ' to apply the rules to implicit variables within standard body statements.
          END IF

          IF inTypeBlock = 1 THEN
            isUdtLine = 1
            IF tVal = TOK_END THEN
              IF lineTokenCount >= 2 THEN
                IF lineTokenVals(1) = TOK_TYPE THEN
                  inTypeBlock = 0
                  compileText$(iy) = "" ' Erase line so Pass 5 ignores it
                ELSE
                  throwCompilerError "EXPECTED TYPE AFTER END", ASIS, 0
                  EXIT SUB
                END IF
              ELSE
                throwCompilerError "EXPECTED TYPE AFTER END", ASIS, 0
                EXIT SUB
              END IF
            ELSE
              fName$ = UCASE$(firstTok$)

              IF LEFT$(fName$, 1) = "_" THEN
                throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
                EXIT SUB
              END IF

              IF udts(currentUdtIdx).FieldCount > 0 THEN
                IF findUdtFieldIndex(currentUdtIdx, fName$) THEN
                  throwCompilerError "DUPLICATE UDT FIELD", ASIS, 0
                  EXIT SUB
                END IF
              END IF

              IF lineTokenCount >= 3 THEN
                IF lineTokenVals(1) = TOK_AS THEN
                  tokIdx = 2
                  fieldSize = 0
                  fieldType = 0
                  tempUdtIndex = 0
                  tempIsDynamicString = 0

                  tokIdx = parseTypeClause(tokIdx, lineTokenCount - 1, 1)
                  fieldType = returnedData2
                  typeData = returnedData3

                  IF fieldType = TYPE_UNDEFINED THEN EXIT SUB

                  IF fieldType = TYPE_UDT THEN tempUdtIndex = typeData
                  IF fieldType = TYPE_STRING THEN fixedLen = typeData

                  IF fieldType = TYPE_UDT THEN
                    IF tempUdtIndex = currentUdtIdx THEN
                      throwCompilerError "SELF REFERENCE UDT ATTEMPTED", ASIS, 0
                      EXIT SUB
                    END IF
                  END IF

                  SELECT CASE fieldType
                    CASE TYPE_BYTE, TYPE_UBYTE: fieldSize = 1
                    CASE TYPE_INTEGER, TYPE_UINTEGER: fieldSize = 2
                    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE: fieldSize = 4
                    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE: fieldSize = 8
                    CASE TYPE_STRING
                      IF fixedLen > 0 THEN
                        fieldSize = fixedLen
                      ELSE
                        fieldSize = 8
                        tempIsDynamicString = 1
                      END IF
                    CASE TYPE_UDT
                      fieldSize = udts(tempUdtIndex).TotalSize
                  END SELECT

                  IF udts(currentUdtIdx).FieldCount >= MAX_UDT_FIELDS THEN
                    throwCompilerError "UDT FIELD LIMIT REACHED", ASIS, 0
                    EXIT SUB
                  END IF

                  fIdx = udts(currentUdtIdx).FieldCount
                  udtFields(currentUdtIdx, fIdx).FieldName = fName$
                  udtFields(currentUdtIdx, fIdx).DataType = fieldType
                  udtFields(currentUdtIdx, fIdx).Offset = udts(currentUdtIdx).TotalSize
                  udtFields(currentUdtIdx, fIdx).Size = fieldSize
                  udtFields(currentUdtIdx, fIdx).UDTIndex = tempUdtIndex
                  udtFields(currentUdtIdx, fIdx).IsDynamicString = tempIsDynamicString

                  udts(currentUdtIdx).TotalSize = udts(currentUdtIdx).TotalSize + fieldSize
                  udts(currentUdtIdx).FieldCount = udts(currentUdtIdx).FieldCount + 1

                  compileText$(iy) = "" ' Erase line so Pass 5 ignores it
                ELSE
                  throwCompilerError "EXPECTED AS", ASIS, 0
                  EXIT SUB
                END IF
              ELSE
                throwCompilerError "MALFORMED UDT FIELD", ASIS, 0
                EXIT SUB
              END IF
            END IF
          ELSE
            IF tVal = TOK_TYPE THEN
              isUdtLine = 1
              IF currentScopeID <> 0 THEN
                throwCompilerError "TYPE MUST BE GLOBAL", ASIS, 0
                EXIT SUB
              END IF
              IF lineTokenCount >= 2 THEN
                uName$ = UCASE$(lineTokens$(1))

                IF LEFT$(uName$, 1) = "_" THEN
                  throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
                  EXIT SUB
                END IF

                IF udtCount > 0 THEN
                  IF findUdtIndex(uName$) THEN
                    throwCompilerError "DUPLICATE UDT NAME", ASIS, 0
                    EXIT SUB
                  END IF
                END IF

                IF udtCount >= MAX_UDTS THEN
                  throwCompilerError "UDT LIMIT REACHED", ASIS, 0
                  EXIT SUB
                END IF

                udts(udtCount).RecordName = uName$
                udts(udtCount).FieldCount = 0
                udts(udtCount).TotalSize = 0
                currentUdtIdx = udtCount
                udtCount = udtCount + 1
                inTypeBlock = 1

                compileText$(iy) = "" ' Erase line so Pass 5 ignores it
              ELSE
                throwCompilerError "EXPECTED UDT NAME", ASIS, 0
                EXIT SUB
              END IF
            END IF
          END IF

          IF isUdtLine = 0 THEN
            IF tVal = TOK_SUB OR tVal = TOK_FUNCTION OR tVal = TOK_DEF THEN
              IF lineTokenCount >= 2 THEN
                nameIdx = 1
                subName$ = UCASE$(lineTokens$(1))

                IF tVal = TOK_DEF THEN
                  IF subName$ = "FN" THEN
                    IF lineTokenCount >= 3 THEN
                      nameIdx = 2
                      subName$ = "FN" + UCASE$(lineTokens$(2))
                    END IF
                  END IF
                END IF

                IF tVal = TOK_DEF AND subName$ = "SEG" THEN
                ELSE
                  baseSubName$ = retRoutineBaseName$(subName$)

                  IF findSubIndexCanonical(baseSubName$) THEN
                    throwCompilerError "NAME ALREADY IN USE", ASIS, 0
                    EXIT SUB
                  END IF

                  ff = resolveSymbol(subName$)
                  IF ff = 0 THEN EXIT SUB
                  vIdx = returnedData2

                  IF symbols(vIdx).SubIndex <> 0 THEN
                    throwCompilerError "DUPLICATE SUB OR FUNCTION", ASIS, 0
                    EXIT SUB
                  END IF

                  IF subCount >= MAX_SUBS THEN
                    throwCompilerError "SUB LIMIT REACHED", ASIS, 0
                    EXIT SUB
                  END IF

                  symbols(vIdx).SubIndex = subCount
                  routineSymbolIndex(subCount) = vIdx + 1
                  symbols(vIdx).IsExplicit = DECL_EXPLICIT
                  subs(subCount).RecordName = subName$
                  subs(subCount).ArgCount = 0
                  subs(subCount).LocalFrameSize = 0

                  IF inDeclareBlock = 1 THEN
                    subs(subCount).IsDll = 1
                    subs(subCount).DllName = currentDllName$
                  ELSE
                    subs(subCount).IsDll = 0
                    subs(subCount).DllName = ""
                  END IF

                  IF inDeclareBlock = 1 THEN
                    importName$ = lineTokens$(nameIdx)
                    lastTwo$ = RIGHT$(importName$, 2)
                    IF lastTwo$ = "&&" THEN
                      importName$ = LEFT$(importName$, LEN(importName$) - 2)
                    ELSE
                      lastCh$ = RIGHT$(importName$, 1)
                      IF lastCh$ = "$" OR lastCh$ = "%" OR lastCh$ = "&" OR lastCh$ = "!" OR lastCh$ = "#" THEN
                        importName$ = LEFT$(importName$, LEN(importName$) - 1)
                      END IF
                      lastCh$ = RIGHT$(importName$, 1)
                      IF lastCh$ = "~" THEN
                        importName$ = LEFT$(importName$, LEN(importName$) - 1)
                      END IF
                    END IF

                    subs(subCount).AliasName = importName$
                  ELSE
                    subs(subCount).AliasName = subName$
                  END IF

                  scopeCounter = scopeCounter + 1
                  currentScopeID = scopeCounter
                  subs(subCount).ScopeID = currentScopeID

                  IF tVal = TOK_FUNCTION OR tVal = TOK_DEF THEN
                    subs(subCount).IsFunction = 1
                  ELSE
                    subs(subCount).IsFunction = 0
                    symbols(vIdx).DataType = TYPE_UNDEFINED
                  END IF

                  IF subs(subCount).IsFunction = 1 THEN
                    IF symbolCount >= MAX_SYMBOLS THEN
                      throwCompilerError "SYMBOL LIMIT", ASIS, 0
                      EXIT SUB
                    END IF

                    vIdxRet = symbolCount
                    symbolCount = symbolCount + 1

                    symbols(vIdxRet).RecordName = subName$
                    symbols(vIdxRet).DataType = symbols(vIdx).DataType
                    symbols(vIdxRet).ScopeID = currentScopeID
                    symbols(vIdxRet).IsShared = 0
                    symbols(vIdxRet).IsArray = 0
                    symbols(vIdxRet).Size = 1
                    symbols(vIdxRet).NumDimensions = 0
                    symbols(vIdxRet).Offset = 0
                    symbols(vIdxRet).SubIndex = 0
                    symbols(vIdxRet).UDTIndex = -1
                    symbols(vIdxRet).IsExplicit = DECL_EXPLICIT
                    symbols(vIdxRet).alreadyParsed = 0
                    symbols(vIdxRet).IsLocal = LOCAL_STANDARD
                    symbols(vIdxRet).LocalOffset = 0
                    symbols(vIdxRet).DescOffset = 0
                    symbols(vIdxRet).StrOffset = 0
                    symbols(vIdxRet).FixedStrLen = 0

                    indexSymbol vIdxRet

                    subs(subCount).ReturnVarIdx = vIdxRet
                  ELSE
                    subs(subCount).ReturnVarIdx = 0
                  END IF

                  tokIdx = nameIdx + 1

                  ' Bypass ALIAS stub string
                  IF tokIdx < lineTokenCount THEN
                    IF lineTokenVals(tokIdx) = 0 AND UCASE$(lineTokens$(tokIdx)) = "ALIAS" THEN
                      tokIdx = tokIdx + 1
                      IF tokIdx < lineTokenCount THEN
                        IF LEFT$(lineTokens$(tokIdx), 1) = CHR$(34) THEN
                          subs(subCount).AliasName = extractQuotes$(lineTokens$(tokIdx))
                        ELSE
                          subs(subCount).AliasName = lineTokens$(tokIdx)
                        END IF
                        tokIdx = tokIdx + 1
                      END IF
                    END IF
                  END IF

                  IF tokIdx < lineTokenCount THEN
                    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
                      tokIdx = tokIdx + 1
                      DO WHILE tokIdx < lineTokenCount
                        argTok$ = lineTokens$(tokIdx)
                        IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN EXIT DO

                        isByValArg = 0
                        IF lineTokenVals(tokIdx) = TOK_BYVAL THEN
                          isByValArg = 1
                          tokIdx = tokIdx + 1
                          IF tokIdx < lineTokenCount THEN
                            argTok$ = lineTokens$(tokIdx)
                          ELSE
                            throwCompilerError "EXPECTED ARG NAME AFTER BYVAL", ASIS, 0
                            EXIT SUB
                          END IF
                        ELSE
                          IF lineTokenVals(tokIdx) = 0 AND UCASE$(argTok$) = "BYVAL" THEN
                            isByValArg = 1
                            tokIdx = tokIdx + 1
                            IF tokIdx < lineTokenCount THEN
                              argTok$ = lineTokens$(tokIdx)
                            ELSE
                              throwCompilerError "EXPECTED ARG NAME AFTER BYVAL", ASIS, 0
                              EXIT SUB
                            END IF
                          END IF
                        END IF

                        IF lineTokenVals(tokIdx) = 0 THEN
                          argName$ = UCASE$(argTok$)

                          ff = resolveSymbol(argName$)
                          IF ff = 0 THEN EXIT SUB
                          vIdxArg = returnedData2

                          ' Flag as explicit so lookahead typing ignores it (bypass implicit lookahead resolution)
                          symbols(vIdxArg).IsExplicit = DECL_EXPLICIT

                          ' Force arguments global to allow caller-callee communication
                          symbols(vIdxArg).IsLocal = LOCAL_GLOBAL

                          IF tokIdx + 1 < lineTokenCount THEN
                            IF lineTokenVals(tokIdx + 1) = 256 + ASC("(") THEN
                              IF tokIdx + 2 < lineTokenCount THEN
                                IF lineTokenVals(tokIdx + 2) = 256 + ASC(")") THEN
                                  symbols(vIdxArg).IsArray = 2
                                  tokIdx = tokIdx + 2
                                ELSE
                                  throwCompilerError "EXPECTED )", ASIS, 0
                                  EXIT SUB
                                END IF
                              ELSE
                                throwCompilerError "EXPECTED )", ASIS, 0
                                EXIT SUB
                              END IF
                            END IF
                          END IF

                          IF tokIdx + 1 < lineTokenCount THEN
                            IF lineTokenVals(tokIdx + 1) = TOK_AS THEN
                              tokIdx = tokIdx + 2
                              tokIdx = parseTypeClause(tokIdx, lineTokenCount - 1, 0) - 1
                              dtMapped = returnedData2
                              typeData = returnedData3

                              IF dtMapped = TYPE_UNDEFINED THEN EXIT SUB

                              symbols(vIdxArg).DataType = dtMapped
                              IF dtMapped = TYPE_UDT THEN
                                symbols(vIdxArg).UDTIndex = typeData
                              END IF
                            END IF
                          END IF

                          IF subs(subCount).ArgCount < 16 THEN
                            subArgVarIdx(subCount, subs(subCount).ArgCount) = vIdxArg
                            byValTracker(subCount, subs(subCount).ArgCount).SubArg = isByValArg
                            subs(subCount).ArgCount = subs(subCount).ArgCount + 1
                          ELSE
                            throwCompilerError "TOO MANY ARGS", ASIS, 0
                            EXIT SUB
                          END IF
                        END IF
                        tokIdx = tokIdx + 1
                        IF tokIdx < lineTokenCount THEN
                          IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
                            tokIdx = tokIdx + 1
                          ELSE
                            IF lineTokenVals(tokIdx) = 256 + ASC(")") THEN
                            ELSE
                              throwCompilerError "EXPECTED COMMA", ASIS, 0
                              EXIT SUB
                            END IF
                          END IF
                        END IF
                      LOOP
                    END IF
                  END IF
                  subCount = subCount + 1

                  IF tVal = TOK_DEF THEN
                    currentScopeID = 0
                  END IF

                  IF inDeclareBlock = 1 THEN
                    currentScopeID = 0
                    compileText$(iy) = "" ' Erase line so Pass 5 ignores it
                  END IF
                END IF
              END IF
            END IF

            IF tVal = TOK_END THEN
              IF lineTokenCount >= 2 THEN
                IF lineTokenVals(1) = TOK_SUB OR lineTokenVals(1) = TOK_FUNCTION THEN
                  currentScopeID = 0
                END IF
                IF lineTokenVals(1) = TOK_DECLARE THEN
                  inDeclareBlock = 0
                  isUdtLine = 1
                  compileText$(iy) = "" ' Erase line so Pass 5 ignores it
                END IF
              END IF
            END IF
          END IF

        END IF
      END IF
    END IF
  NEXT

  IF inTypeBlock = 1 THEN
    throwCompilerError "UNCLOSED TYPE BLOCK", ASIS, 0
    EXIT SUB
  END IF

  IF declareCount > 0 THEN
    FOR iDecl = 0 TO declareCount - 1
      dName$ = RTRIM$(declares(iDecl).RecordName)

      ff = findSubIndex(dName$)
      IF ff = 1 THEN
        subIdx = returnedData2

        IF declares(iDecl).IsFunction <> subs(subIdx).IsFunction THEN
          currentLineNumber = declares(iDecl).LineNumber
          throwCompilerError "DECLARE " + dName$ + " SUB/FUNCTION TYPE MISMATCH", ASIS, 0
          EXIT SUB
        END IF

        IF declares(iDecl).ArgCount <> subs(subIdx).ArgCount THEN
          currentLineNumber = declares(iDecl).LineNumber
          throwCompilerError "DECLARE " + dName$ + " ARG COUNT MISMATCH", ASIS, 0
          EXIT SUB
        END IF

        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          IF declares(iDecl).RetType <> symbols(retVarIdx).DataType THEN
            currentLineNumber = declares(iDecl).LineNumber
            throwCompilerError "DECLARE " + dName$ + " RETURN TYPE MISMATCH", ASIS, 0
            EXIT SUB
          END IF
        END IF

        IF declares(iDecl).ArgCount > 0 THEN
          FOR iArg = 0 TO declares(iDecl).ArgCount - 1
            argVarIdx = subArgVarIdx(subIdx, iArg)

            IF declareArgArray(iDecl, iArg) <> symbols(argVarIdx).IsArray THEN
              currentLineNumber = declares(iDecl).LineNumber
              throwCompilerError "DECLARE " + dName$ + " ARRAY MISMATCH ON ARG " + LTRIM$(STR$(iArg + 1)), ASIS, 0
              EXIT SUB
            END IF

            IF declareArgType(iDecl, iArg) <> TYPE_ANY THEN
              IF declareArgType(iDecl, iArg) <> symbols(argVarIdx).DataType THEN
                currentLineNumber = declares(iDecl).LineNumber
                throwCompilerError "DECLARE " + dName$ + " TYPE MISMATCH ON ARG " + LTRIM$(STR$(iArg + 1)), ASIS, 0
                EXIT SUB
              END IF
            END IF

            IF byValTracker(subIdx, iArg).SubArg <> byValTracker(iDecl, iArg).DeclareArg THEN
              currentLineNumber = declares(iDecl).LineNumber
              throwCompilerError "DECLARE " + dName$ + " BYVAL MISMATCH ON ARG " + LTRIM$(STR$(iArg + 1)), ASIS, 0
              EXIT SUB
            END IF
          NEXT
        END IF
      END IF
    NEXT
  END IF

  currentLineNumber = 1
  currentScopeID = 0

END SUB ' compilePass4Symbols

''''''''''''''''''''''''
FUNCTION compilePass5LocalLayoutStable

  DIM expectedFrame(MAX_SUBS) AS LONG
  DIM sIdx AS LONG
  DIM localByteSize AS LONG
  DIM remainder AS LONG
  DIM routineName$
  DIM symbolName$

  compilePass5LocalLayoutStable = 0
  pass5Trace 910

  pass5Trace 911
  IF subCount > 1 THEN
    FOR iSub = 1 TO subCount - 1
      expectedFrame(iSub) = 0
    NEXT
  END IF
  pass5Trace 912

  pass5Trace 920
  IF symbolCount > engineSymbolLimit THEN
    FOR ii = engineSymbolLimit TO symbolCount - 1
      IF symbols(ii).IsLocal = LOCAL_STANDARD AND symbols(ii).IsShared = 0 THEN
        ff = findSubIndexByScope(symbols(ii).ScopeID)
        IF ff = 0 THEN
          symbolName$ = RTRIM$(symbols(ii).RecordName)
          throwCompilerErrorNoLineNum "FATAL: LOCAL SYMBOL HAS NO OWNING SUB OR FUNCTION"
          addStatusMsgContinuation "SYMBOL: " + symbolName$
          EXIT FUNCTION
        END IF

        sIdx = returnedData2

        IF symbols(ii).LocalOffset <> expectedFrame(sIdx) THEN
          symbolName$ = RTRIM$(symbols(ii).RecordName)
          routineName$ = RTRIM$(subs(sIdx).RecordName)
          throwCompilerErrorNoLineNum "FATAL: LOCAL VARIABLE LAYOUT CHANGED AFTER PASS 5A"
          addStatusMsgContinuation "SUB/FUNCTION: " + routineName$
          addStatusMsgContinuation "SYMBOL: " + symbolName$
          addStatusMsgContinuation "EXPECTED OFFSET: " + LTRIM$(STR$(expectedFrame(sIdx))) + " | ACTUAL OFFSET: " + LTRIM$(STR$(symbols(ii).LocalOffset))
          EXIT FUNCTION
        END IF

        localByteSize = retSymbolByteSize(ii)
        expectedFrame(sIdx) = expectedFrame(sIdx) + localByteSize
      END IF
    NEXT
  END IF
  pass5Trace 921

  pass5Trace 930
  IF subCount > 1 THEN
    FOR iSub = 1 TO subCount - 1
      remainder = expectedFrame(iSub) AND 15
      IF remainder <> 0 THEN
        expectedFrame(iSub) = expectedFrame(iSub) + (16 - remainder)
      END IF

      IF expectedFrame(iSub) <> subs(iSub).LocalFrameSize THEN
        routineName$ = RTRIM$(subs(iSub).RecordName)
        throwCompilerErrorNoLineNum "FATAL: LOCAL FRAME SIZE CHANGED AFTER PASS 5A"
        addStatusMsgContinuation "SUB/FUNCTION: " + routineName$
        addStatusMsgContinuation "EXPECTED FRAME: " + LTRIM$(STR$(expectedFrame(iSub))) + " | FINALIZED FRAME: " + LTRIM$(STR$(subs(iSub).LocalFrameSize))
        EXIT FUNCTION
      END IF
    NEXT
  END IF
  pass5Trace 931

  pass5Trace 938
  compilePass5LocalLayoutStable = 1
  pass5Trace 939

END FUNCTION ' compilePass5LocalLayoutStable

''''''''''''''''''''''''
SUB compilePass5MarkArgumentsLocal

  DIM argIdx AS LONG
  DIM argVarIdx AS LONG

  IF subCount > 1 THEN
    FOR iSub = 1 TO subCount - 1
      IF subs(iSub).IsDll = 0 THEN
        IF subs(iSub).ArgCount > 0 THEN
          FOR argIdx = 0 TO subs(iSub).ArgCount - 1
            argVarIdx = subArgVarIdx(iSub, argIdx)
            symbols(argVarIdx).IsLocal = LOCAL_STANDARD
          NEXT
        END IF
      END IF
    NEXT
  END IF

END SUB ' compilePass5MarkArgumentsLocal

''''''''''''''''''''''''
SUB compilePass5Prepare (passMode AS LONG)

  DIM runtimeUsedCount AS LONG

  pass5.Mode = passMode
  pass5Trace 600

  isDummyPass = 0
  isMeasurePass = 0
  pass5Trace 601

  SELECT CASE passMode

    CASE PASS5_MODE_DISCOVERY
      isDummyPass = 1
      isMeasurePass = 1

    CASE PASS5_MODE_LAYOUT
      ' Pass 5B emits the runtime and user code while measuring its final size
      ' prepareBinary includes the separately measured prologue and epilogue
      ' so the complete linked machine-code image is verified before final linking
      isMeasurePass = 0

    CASE ELSE
      throwCompilerErrorNoLineNum "FATAL: INVALID PASS 5 MODE"
      EXIT SUB

  END SELECT ' passMode

  pass5Trace 602

  IF passMode = PASS5_MODE_DISCOVERY THEN
    pass5Trace 603
    compilePass5MarkArgumentsLocal
    pass5Trace 604
    IF compileError = 1 THEN EXIT SUB
  END IF

  pass5Trace 610
  compilePass5ResetScanState
  pass5Trace 611

  IF passMode = PASS5_MODE_DISCOVERY THEN
    pass5Trace 612

    ' Dry-run setup and epilogue blocks so every TIRA symbol exists before layout finalization
    IF cm.HasGraphics = 1 THEN
      IF USE_DIB_SECTION = 1 THEN
        ESCAPETEXT "USE_DIB_SECTION SET TO 1, HARDWARE GRAPHICS NOT SUPPORTED YET"
      ELSE
        emitPrologueWindowSetup
      END IF
    END IF

    emitPrologue
    emitEpilogue

    pass5Trace 613

    IF compileError = 1 THEN EXIT SUB

    ' Remove all sequential emission state produced by the discovery-only prelude
    ' while preserving the symbols the prelude discovered
    pass5Trace 614
    compilePass5ResetScanState
    pass5Trace 615
  END IF

  IF passMode = PASS5_MODE_LAYOUT THEN
    ' Measure setup and epilogue sizes after discovery so Pass 5A never enters the native backend
    ' Keep setup labels isolated so prepareBinary only shifts runtime and user-code labels
    isDummyPass = 1
    isMeasurePass = 1

    IF cm.HasGraphics = 1 THEN
      IF USE_DIB_SECTION = 1 THEN
        ESCAPETEXT "USE_DIB_SECTION SET TO 1, HARDWARE GRAPHICS NOT SUPPORTED YET"
      ELSE
        emitPrologueWindowSetup
      END IF
    END IF

    emitPrologue
    emitEpilogue
    isMeasurePass = 0
    isDummyPass = 0

    IF compileError = 1 THEN EXIT SUB

    ' Remove all sequential emission state produced by size measurement
    compilePass5ResetScanState
  END IF

  pass5Trace 620
  emitRuntimeAll
  pass5Trace 621

  IF compileError = 1 THEN EXIT SUB

  ' Rebuild after runtime emission so the source scan receives a complete scope index
  rebuildSymbolScopeHash
  pass5Trace 622

  pass5.ScanStartSymbolCount = symbolCount
  pass5Trace 630

  pass5Trace 640
  runtimeUsedCount = 0
  FOR ii = 0 TO MAX_RT_ROUTINES
    IF rtIsUsed(ii) = 1 THEN runtimeUsedCount = runtimeUsedCount + 1
  NEXT
  pass5Trace 641

  pass5.ScanStartRuntimeCount = runtimeUsedCount
  pass5Trace 642

  pass5Trace 698
  pass5.LINE = 1
  pass5.SUCCESS = 1
  pass5Trace 699

END SUB ' compilePass5Prepare

''''''''''''''''''''''''
SUB pass5Trace (traceStep AS LONG)

  DIM traceFile AS LONG
  DIM traceValue AS LONG
  DIM traceText AS STRING * 64

  IF TRACE_COMPILE <> 1 THEN EXIT SUB

  traceValue = traceStep

  IF pass5.Mode = PASS5_MODE_DISCOVERY THEN
    traceValue = traceValue + 1000
  END IF

  IF pass5.Mode = PASS5_MODE_LAYOUT THEN
    traceValue = traceValue + 2000
  END IF

  traceText = "CHECKPOINT " + LTRIM$(STR$(traceValue)) + " PASS5LINE " + LTRIM$(STR$(pass5.LINE)) + " SOURCE " + LTRIM$(STR$(currentLineNumber))

  traceFile = FREEFILE
  OPEN "PASS5TRACE.TXT" FOR BINARY AS #traceFile
  PUT #traceFile, 1, traceText
  CLOSE #traceFile

END SUB ' pass5Trace

''''''''''''''''''''''''
SUB compilePass5ResetScanState

  DIM recordName$

  stream.emitPos = 0
  patchCount = 0
  iatPatchCount = 0
  gotoPatchCount = 0
  callPatchCount = 0
  rt.PatchCount = 0
  ctrlCount = 0

  currentLineNumber = 1
  currentScopeID = 0
  insideSub = 0
  currentSubName$ = ""
  defaultArrayDynamic = 0
  expectedSymType = TYPE_ANY
  lineTokenCount = 0

  stack.currentStackOffset = 0
  ff = updateStackAlignment

  t.TiraVarCounter = 0
  t.LineCount = 0
  t.TempCounter = 0
  t.IsActive = 0

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 0

  isCompilingRT = 0
  rtWrapperActive = 0
  rtFrameSize = 0
  rtPrologueIdx = 0

  FOR ii = 0 TO 25
    defIntMap(ii) = baseDefIntMap(ii)
  NEXT

  FOR ii = 0 TO MAX_RT_ROUTINES
    rtOffset(ii) = 0
  NEXT

  IF subCount > 0 THEN
    FOR ii = 0 TO subCount - 1
      subs(ii).Offset = 0
      subs(ii).ExitPatchList = 0
    NEXT
  END IF

  IF symbolCount > 0 THEN
    FOR ii = 0 TO symbolCount - 1
      recordName$ = RTRIM$(symbols(ii).RecordName)
      IF symbols(ii).DataType = TYPE_LABEL OR LEFT$(recordName$, 1) = "%" OR LEFT$(recordName$, 1) = "@" THEN
        symbols(ii).Offset = 0
      END IF
    NEXT
  END IF

END SUB ' compilePass5ResetScanState

''''''''''''''''''''''''
SUB compilePass5ScanOrEmit

  ' Pass 5: Processes stream-based tokens and emits x64 machine code or builds intermediate IR
  ' Operates in time-boxed cycles to yield back to the main UI loop
  ' Discovery mode registers symbols, and layout mode writes finalized machine code and patch records

  DIM tempSuccess AS LONG
  DIM stripLen AS LONG
  DIM vIdx AS LONG
  DIM stmtRes AS LONG
  DIM vIdxEnd AS LONG
  DIM vIdxInstant AS LONG
  DIM timeLimit AS DOUBLE

  IF pass5.LINE = 1 THEN
    defaultArrayDynamic = 0

    IF cm.ClassicMode = 1 THEN
      tira_Start
      tiraInitClassicImplicitArrays 0
      IF compileError = 1 THEN
        tira_Cancel
        pass5.SUCCESS = 0
        EXIT SUB
      END IF
      tira_EndAndProcess
    END IF
  END IF

  timeLimit = TIMER + 0.015

  DO
    IF pass5.LINE <= compileLastLine THEN
      iy = pass5.LINE
      currentLineNumber = editorLineLinkMap(iy)

      curLine$ = compileText$(iy)
      tempLine$ = LTRIM$(RTRIM$(curLine$))

      IF LEN(tempLine$) > 0 THEN

        labelStr$ = retLabelStripLength$(tempLine$)
        stripLen = returnedData2

        IF stripLen > 0 THEN
          ff = findSubIndex(labelStr$)
          IF ff = 1 THEN
            ' It is a sub call, not a label! Restore the implicit call and reverse Pass 4's label tracking
            ff = resolveSymbol("%" + UCASE$(labelStr$))
            IF ff = 1 THEN
              symbols(returnedData2).alreadyParsed = 0
            END IF
            tempLine$ = labelStr$ + " " + LTRIM$(MID$(tempLine$, stripLen + 1))
            stripLen = 0
          ELSE
            labelName$ = "%" + UCASE$(labelStr$)

            ' Find label and set offset
            expectedSymType = TYPE_LABEL
            ff = resolveSymbol(labelName$)
            IF ff = 1 THEN
              vIdx = returnedData2
              symbols(vIdx).Offset = stream.emitPos
              symbols(vIdx).IsExplicit = DECL_EXPLICIT
              symbols(vIdx).alreadyParsed = 1
            END IF

            ' Strip label for keyword scanning on the same line
            tempLine$ = LTRIM$(MID$(tempLine$, stripLen + 1))
          END IF
        END IF

        IF LEN(tempLine$) > 0 THEN
          tokenizeLine tempLine$

          IF compileError = 1 THEN
            pass5.SUCCESS = 0
            EXIT SUB
          END IF

          IF lineTokenCount > 0 THEN
            ' Non-Classic array and scalar validation occurs in the semantic parser paths
            IF cm.ClassicMode = 1 THEN
              regClassicImplArrays
            END IF
            IF compileError = 1 THEN
              pass5.SUCCESS = 0
              EXIT SUB
            END IF

            isStackSpanning = 0
            t.TempCounter = 0 ' Ensure ephemeral TIRA tracking is reset for every statement

            preStmtStackOffset = stack.currentStackOffset ' Snapshot the stack offset before compiling the statement

            ' Update runtime line tracking for executable error handling natively via TIRA
            tira_Start
            tiraAssign "!G_SYS_VAL_CURRENT_LINE", LTRIM$(RTRIM$(STR$(currentLineNumber)))
            tira_EndAndProcess

            stmtRes = parseStatement(0)
            IF stmtRes = 0 THEN
              pass5.SUCCESS = 0
              EXIT SUB
            END IF

            ' parseStatement reports SUB, FUNCTION, and matching END forms as stack-spanning
            IF stmtRes > 1 THEN isStackSpanning = 1
            ' Catch hidden stack alignment bugs right at the source
            IF isStackSpanning = 0 THEN
              IF stack.currentStackOffset <> preStmtStackOffset THEN
                err1$ = "COMPILER FAIL: Stack alignment check failed at line " + retLineNumberStr$
                err2$ = "Offset: " + LTRIM$(STR$(stack.currentStackOffset)) + " bytes. Expected " + LTRIM$(STR$(preStmtStackOffset))
                ESCAPETEXT2 err1$, err2$
              END IF
            END IF
          END IF
        END IF
      END IF

      SELECT CASE pass5.Mode

        CASE PASS5_MODE_DISCOVERY

        CASE PASS5_MODE_LAYOUT

        CASE ELSE
          throwCompilerErrorNoLineNum "FATAL: INVALID PASS 5 MODE DURING SOURCE SCAN"
          pass5.SUCCESS = 0
          EXIT SUB

      END SELECT ' pass5.Mode

      pass5.LINE = pass5.LINE + 1
    ELSE
      ' Finalize Phase
      tempSuccess = pass5.SUCCESS

      IF tempSuccess = 1 THEN
        IF ctrlCount > 0 THEN
          throwCompilerError "UNCLOSED BLOCK", ASIS, 0
          tempSuccess = 0
        END IF
      END IF

      ' Validate that all GOTO targets exist
      IF tempSuccess = 1 THEN
        expectedSymType = TYPE_LABEL
        ff = resolveSymbol("@END_PROGRAM")
        IF ff = 1 THEN
          vIdxEnd = returnedData2
          symbols(vIdxEnd).DataType = TYPE_LABEL
          symbols(vIdxEnd).alreadyParsed = 1
        END IF

        expectedSymType = TYPE_LABEL
        ff = resolveSymbol("@INSTANT_EXIT")
        IF ff = 1 THEN
          vIdxInstant = returnedData2
          symbols(vIdxInstant).DataType = TYPE_LABEL
          symbols(vIdxInstant).alreadyParsed = 1
        END IF

        IF gotoPatchCount > 0 THEN
          FOR ii = 0 TO gotoPatchCount - 1
            vIdx = gotoPatches(ii).VarIdx
            IF symbols(vIdx).DataType <> TYPE_LABEL OR symbols(vIdx).alreadyParsed = 0 THEN
              uName$ = RTRIM$(symbols(vIdx).RecordName)
              IF LEFT$(uName$, 1) = "%" OR LEFT$(uName$, 1) = "@" THEN uName$ = MID$(uName$, 2)
              throwCompilerError "LABEL " + uName$ + " NOT FOUND", ASIS, 0
              tempSuccess = 0
              EXIT FOR
            END IF
          NEXT
        END IF
      END IF

      pass5.SUCCESS = tempSuccess
      pass5.SubState = PASS5_STATE_COMPLETE ' Mark as fully finalized
      EXIT DO
    END IF
  LOOP WHILE TIMER < timeLimit

END SUB ' compilePass5ScanOrEmit

''''''''''''''''''''''''
SUB compilePass5bLocalVariables

  ' Pass 5B: Calculates memory footprints and byte offsets for local sub/function variables
  ' Runs just before x64 emission to ensure stack frames are aligned to the Windows ABI
  ' Global variables are handled later to account for temporary TIRA variable generation

  DIM sIdx AS LONG
  DIM localByteSize AS LONG
  DIM remainder AS LONG
  DIM requiredStackSize AS _INTEGER64
  DIM reserveTarget AS _INTEGER64
  DIM routineName$
  DIM routineType$

  peStackReserve = PE_STACK_RESERVE

  ' Local variable tracking
  ' Calculate LocalOffset for local variables and LocalFrameSize for each subroutine
  IF subCount > 1 THEN
    FOR iSub = 1 TO subCount - 1
      subs(iSub).LocalFrameSize = 0
    NEXT
  END IF

  IF symbolCount > engineSymbolLimit THEN
    FOR ii = engineSymbolLimit TO symbolCount - 1
      IF symbols(ii).IsLocal = LOCAL_STANDARD AND symbols(ii).IsShared = 0 THEN
        ' Find which sub this belongs to via ScopeID
        ff = findSubIndexByScope(symbols(ii).ScopeID)

        IF ff = 1 THEN
          sIdx = returnedData2
          ' Calculate the exact byte size this variable will demand on the stack
          localByteSize = retSymbolByteSize(ii)

          ' Assign offset and increment the subroutine's local frame size requirement
          symbols(ii).LocalOffset = subs(sIdx).LocalFrameSize
          subs(sIdx).LocalFrameSize = subs(sIdx).LocalFrameSize + localByteSize
        END IF
      END IF
    NEXT
  END IF

  ' Enforce the 16-byte ABI stack alignment rule to lock in the final LocalFrameSize
  IF subCount > 1 THEN
    FOR iSub = 1 TO subCount - 1
      remainder = subs(iSub).LocalFrameSize AND 15 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values
      IF remainder <> 0 THEN
        subs(iSub).LocalFrameSize = subs(iSub).LocalFrameSize + (16 - remainder)
      END IF

      ' Include the shared call frame and fixed hardware prologue storage in the safety check
      requiredStackSize = subs(iSub).LocalFrameSize
      requiredStackSize = requiredStackSize + stack.consoleFrameSize
      requiredStackSize = requiredStackSize + PE_STACK_FRAME_OVERHEAD

      reserveTarget = requiredStackSize + PE_STACK_RESERVE_MARGIN

      IF reserveTarget > PE_STACK_RESERVE_MAX THEN
        routineName$ = RTRIM$(subs(iSub).RecordName)
        routineType$ = "SUB"

        IF subs(iSub).IsFunction = 1 THEN
          routineType$ = "FUNCTION"
        END IF

        throwCompilerErrorNoLineNum "FATAL: STACK RESERVE SAFETY LIMIT EXCEEDED IN " + routineType$ + " " + routineName$
        addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(requiredStackSize)) + " BYTES"
        addStatusMsgContinuation "MAXIMUM RESERVE: " + LTRIM$(STR$(PE_STACK_RESERVE_MAX)) + " BYTES"

        EXIT SUB
      END IF

      DO WHILE peStackReserve < reserveTarget
        peStackReserve = peStackReserve + peStackReserve
      LOOP
    NEXT
  END IF

END SUB ' compilePass5bLocalVariables

''''''''''''''''''''''''
FUNCTION compilePass5ScanStateStable

  DIM runtimeUsedCount AS LONG

  compilePass5ScanStateStable = 0
  pass5Trace 800

  pass5Trace 810
  IF symbolCount <> pass5.ScanStartSymbolCount THEN
    throwCompilerErrorNoLineNum "FATAL: PASS 5 DISCOVERED NEW SYMBOLS AFTER LOCAL LAYOUT FINALIZATION"
    addStatusMsgContinuation "START SYMBOLS: " + LTRIM$(STR$(pass5.ScanStartSymbolCount)) + " | END SYMBOLS: " + LTRIM$(STR$(symbolCount))
    EXIT FUNCTION
  END IF
  pass5Trace 811

  pass5Trace 820
  runtimeUsedCount = 0
  FOR ii = 0 TO MAX_RT_ROUTINES
    IF rtIsUsed(ii) = 1 THEN runtimeUsedCount = runtimeUsedCount + 1
  NEXT
  pass5Trace 821

  IF runtimeUsedCount <> pass5.ScanStartRuntimeCount THEN
    throwCompilerErrorNoLineNum "FATAL: PASS 5 DISCOVERED NEW RUNTIME REQUIREMENTS AFTER RUNTIME EMISSION"
    addStatusMsgContinuation "START ROUTINES: " + LTRIM$(STR$(pass5.ScanStartRuntimeCount)) + " | END ROUTINES: " + LTRIM$(STR$(runtimeUsedCount))
    EXIT FUNCTION
  END IF
  pass5Trace 822

  pass5Trace 830
  IF currentScopeID <> 0 OR insideSub <> 0 OR currentSubName$ <> "" THEN
    throwCompilerErrorNoLineNum "FATAL: PASS 5 ENDED WITH AN ACTIVE SUB OR FUNCTION SCOPE"
    addStatusMsgContinuation "SCOPE ID: " + LTRIM$(STR$(currentScopeID)) + " | INSIDE SUB: " + LTRIM$(STR$(insideSub)) + " | NAME: " + currentSubName$
    EXIT FUNCTION
  END IF
  pass5Trace 831

  pass5Trace 839
  pass5Trace 846

  pass5Trace 850
  IF t.IsActive <> 0 OR t.LineCount <> 0 THEN
    throwCompilerErrorNoLineNum "FATAL: PASS 5 ENDED WITH AN ACTIVE TIRA QUEUE"
    addStatusMsgContinuation "TIRA STATE: " + LTRIM$(STR$(t.IsActive)) + " | QUEUED LINES: " + LTRIM$(STR$(t.LineCount))
    EXIT FUNCTION
  END IF
  pass5Trace 851

  pass5Trace 860
  ff = compilePass5LocalLayoutStable
  pass5Trace 861

  pass5Trace 862
  IF ff = 0 THEN EXIT FUNCTION

  pass5Trace 898
  compilePass5ScanStateStable = 1
  pass5Trace 899

END FUNCTION ' compilePass5ScanStateStable

''''''''''''''''''''''''
SUB compilePass6GlobalMap

  ' Pass 6: Calculates final executable payload offsets for strings, variables, and descriptors
  ' This executes strictly after Pass 5 emission to guarantee that all ephemeral
  ' TIRA intermediate variables and expression temporaries are mapped into the data segment

  DIM symbolByteSize AS _INTEGER64
  DIM totalBssSize AS _INTEGER64
  DIM totalVarSize AS _INTEGER64
  DIM internalBssSize AS _INTEGER64
  DIM gfxBufTotalSize AS _INTEGER64
  DIM maxUserBssSize AS _INTEGER64

  '''' Internal BSS reserve

  gfxBufTotalSize = GFX_BUFFER_ENTRIES
  gfxBufTotalSize = gfxBufTotalSize * layout.GfxBufEntrySize

  internalBssSize = gfxBufTotalSize * 4
  internalBssSize = internalBssSize + (layout.FramebufSize * 4)

  internalBssSize = internalBssSize + 8 ' HWND
  internalBssSize = internalBssSize + 256 ' Keyboard buffer
  internalBssSize = internalBssSize + 8 ' Keyboard head
  internalBssSize = internalBssSize + 8 ' Keyboard tail
  internalBssSize = internalBssSize + 2048 ' File handles
  internalBssSize = internalBssSize + 256 ' Keyboard state
  internalBssSize = internalBssSize + 8192 ' Mouse buffer
  internalBssSize = internalBssSize + 8 ' Mouse head
  internalBssSize = internalBssSize + 8 ' Mouse tail

  maxUserBssSize = PE_SIGNED_LAYOUT_MAX
  maxUserBssSize = maxUserBssSize - PE_BSS_ADDRESS_HEADROOM
  maxUserBssSize = maxUserBssSize - internalBssSize

  '''' Global variable layout tracking

  textLayout.TotalStrSize = 0
  textLayout.TotalVarSize = 0
  textLayout.TotalDescSize = 0
  textLayout.TotalBssSize = 0

  totalVarSize = 0
  totalBssSize = 0

  IF symbolCount > 0 THEN
    FOR ii = 0 TO symbolCount - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "MAPPING GLOBALS", ii + 1, symbolCount, 0
      END IF

      ' We skip mapping local variables into the global data segment
      ' since they reside natively on the RBP stack frame
      IF (symbols(ii).IsLocal = LOCAL_STANDARD AND symbols(ii).IsShared = 0) OR symbols(ii).DataType = TYPE_LABEL THEN
        ' Do nothing
      ELSE
        recName$ = RTRIM$(symbols(ii).RecordName)
        firstChar$ = LEFT$(recName$, 1)

        IF symbols(ii).IsArray > 0 AND firstChar$ <> "!" THEN
          ' User Arrays are gracefully handed over to the BSS section

          symbolByteSize = retSymbolByteSize(ii)

          IF symbolByteSize < 0 THEN
            throwCompilerErrorNoLineNum "NEGATIVE BSS SYMBOL SIZE"
            addStatusMsgContinuation "SYMBOL: " + recName$
            addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
            EXIT SUB
          END IF

          IF symbolByteSize > maxUserBssSize THEN
            throwCompilerErrorNoLineNum "ARRAY EXCEEDS SAFE BSS LAYOUT LIMIT"
            addStatusMsgContinuation "SYMBOL: " + recName$
            addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
            addStatusMsgContinuation "MAX USER BSS: " + LTRIM$(STR$(maxUserBssSize))
            EXIT SUB
          END IF

          IF totalBssSize > maxUserBssSize - symbolByteSize THEN
            throwCompilerErrorNoLineNum "BSS EXCEEDS SAFE SIGNED LAYOUT LIMIT"
            addStatusMsgContinuation "SYMBOL: " + recName$
            addStatusMsgContinuation "CURRENT USER BSS: " + LTRIM$(STR$(totalBssSize))
            addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
            addStatusMsgContinuation "MAX USER BSS: " + LTRIM$(STR$(maxUserBssSize))
            EXIT SUB
          END IF

          symbols(ii).Offset = totalBssSize
          totalBssSize = totalBssSize + symbolByteSize
        ELSE
          IF symbols(ii).DataType = TYPE_STRING AND symbols(ii).IsArray = 0 THEN
            IF totalVarSize > PE_SIGNED_LAYOUT_MAX - 8 THEN
              throwCompilerErrorNoLineNum "GLOBAL STRING SLOTS EXCEED SIGNED LAYOUT LIMIT"
              addStatusMsgContinuation "SYMBOL: " + recName$
              addStatusMsgContinuation "CURRENT GLOBAL BYTES: " + LTRIM$(STR$(totalVarSize))
              EXIT SUB
            END IF

            symbols(ii).Offset = totalVarSize
            totalVarSize = totalVarSize + 8 ' Global string slot

            symbols(ii).DescOffset = textLayout.TotalDescSize
            textLayout.TotalDescSize = textLayout.TotalDescSize + 24

            symbols(ii).StrOffset = textLayout.TotalStrSize
            IF strVarData$(ii) <> "" THEN
              textLayout.TotalStrSize = textLayout.TotalStrSize + LEN(strVarData$(ii)) + 1
            END IF
          ELSE
            symbolByteSize = retSymbolByteSize(ii)

            IF symbolByteSize < 0 THEN
              throwCompilerErrorNoLineNum "NEGATIVE GLOBAL SYMBOL SIZE"
              addStatusMsgContinuation "SYMBOL: " + recName$
              addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
              EXIT SUB
            END IF

            IF symbolByteSize > PE_SIGNED_LAYOUT_MAX THEN
              throwCompilerErrorNoLineNum "GLOBAL SYMBOL EXCEEDS SIGNED LAYOUT LIMIT"
              addStatusMsgContinuation "SYMBOL: " + recName$
              addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
              EXIT SUB
            END IF

            IF totalVarSize > PE_SIGNED_LAYOUT_MAX - symbolByteSize THEN
              throwCompilerErrorNoLineNum "GLOBAL VARIABLES EXCEED SIGNED LAYOUT LIMIT"
              addStatusMsgContinuation "SYMBOL: " + recName$
              addStatusMsgContinuation "CURRENT GLOBAL BYTES: " + LTRIM$(STR$(totalVarSize))
              addStatusMsgContinuation "SYMBOL BYTES: " + LTRIM$(STR$(symbolByteSize))
              EXIT SUB
            END IF

            symbols(ii).Offset = totalVarSize
            totalVarSize = totalVarSize + symbolByteSize
          END IF
        END IF
      END IF
    NEXT
  END IF

  textLayout.TotalVarSize = totalVarSize
  textLayout.TotalBssSize = totalBssSize

END SUB ' compilePass6GlobalMap

''''''''''''''''''''''''
SUB compileSaveTracker (wPhase$, wCurrent, wTotal, forceUpdate)

  DIM currentTime AS DOUBLE
  DIM shouldUpdate AS LONG
  DIM progressPercent AS _UNSIGNED LONG
  DIM trackerIdx AS LONG
  DIM editorBoxTop AS LONG
  DIM editorBoxY AS LONG
  DIM editorBoxH AS LONG
  DIM rowH AS LONG
  DIM textRows AS LONG
  DIM textH AS LONG
  DIM statusBoxX AS LONG
  DIM statusBoxY AS LONG
  DIM statusBoxW AS LONG
  DIM statusBoxH AS LONG
  DIM scrollBarX AS LONG
  DIM maxLines AS LONG
  DIM hlStart AS LONG
  DIM hlEnd AS LONG
  DIM sLine AS LONG
  DIM lineY AS LONG
  DIM linesDrawn AS LONG
  DIM statusIdx AS LONG
  DIM isHighlighted AS LONG

  IF compileState <> COMP_SAVE THEN EXIT SUB
  IF compileError = 1 THEN EXIT SUB

  currentTime = TIMER
  shouldUpdate = forceUpdate

  IF forceUpdate = 1 THEN
    compileSaveStatus.Pulse = 0

    IF statusMsgCount <= 1 THEN
      addStatusMsg "SAVING FOR COMPILE..."
    END IF

    compileSaveStatus.StatusIndex = statusMsgCount - 1
    compileSaveStatus.TimeGoal = currentTime
  ELSE
    ' Correct the future update goal when TIMER rolls over at midnight
    IF currentTime < compileSaveStatus.LastTime THEN
      compileSaveStatus.TimeGoal = compileSaveStatus.TimeGoal - 86400
    END IF

    IF currentTime >= compileSaveStatus.TimeGoal THEN
      shouldUpdate = 1
    END IF
  END IF

  compileSaveStatus.LastTime = currentTime

  IF shouldUpdate = 0 THEN EXIT SUB

  compileSaveStatus.TimeGoal = currentTime + COMPILE_SAVE_STATUS_INTERVAL
  compileSaveStatus.Pulse = compileSaveStatus.Pulse + 1

  trackerIdx = compileSaveStatus.StatusIndex
  IF trackerIdx <= 0 THEN EXIT SUB
  IF trackerIdx >= statusMsgCount THEN EXIT SUB

  trackerText$ = "SAVING FOR COMPILE [" + LTRIM$(STR$(compileSaveStatus.Pulse)) + "] " + wPhase$

  IF wTotal > 0 THEN
    IF wCurrent <= 0 THEN
      progressPercent = 0
    ELSE
      progressPercent = INT((wCurrent / wTotal) * 100)
      IF progressPercent > 100 THEN progressPercent = 100
    END IF

    trackerText$ = trackerText$ + " " + LTRIM$(STR$(progressPercent)) + "%"
  END IF

  statusMsg(trackerIdx).Text = trackerText$

  editorBoxTop = editor.StartY
  editorBoxY = editorBoxTop + 3

  rowH = 8 + TEXT_GAP_TOP + TEXT_GAP_BOT
  textRows = 29
  textH = textRows * rowH
  editorBoxH = textH + 3

  statusBoxX = 124
  statusBoxY = editorBoxY + editorBoxH + 9
  statusBoxW = 505
  statusBoxH = 38

  scrollBarX = statusBoxX + statusBoxW - 1
  maxLines = (statusBoxH - 5) \ 11

  IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1

  ' Keep the active tracker visible without running the status bar mouse handling
  IF trackerIdx < editor.StatusScrollY OR trackerIdx >= editor.StatusScrollY + maxLines THEN
    editor.StatusScrollY = trackerIdx - maxLines + 1
    IF editor.StatusScrollY < 1 THEN editor.StatusScrollY = 1
  END IF

  hlStart = editor.StatusSelectedIndex
  hlEnd = editor.StatusSelectedIndex
  IF hlStart > 0 THEN
    sLine = statusMsg(hlStart).CodeLine
    IF sLine > 0 THEN
      DO WHILE hlStart > 1
        IF statusMsg(hlStart - 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlStart).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlStart).Text, 7) = "WARNING" THEN EXIT DO
          hlStart = hlStart - 1
        ELSE
          EXIT DO
        END IF
      LOOP
      DO WHILE hlEnd < statusMsgCount - 1
        IF statusMsg(hlEnd + 1).CodeLine = sLine THEN
          IF LEFT$(statusMsg(hlEnd + 1).Text, 5) = "ERROR" OR LEFT$(statusMsg(hlEnd + 1).Text, 7) = "WARNING" THEN EXIT DO
          hlEnd = hlEnd + 1
        ELSE
          EXIT DO
        END IF
      LOOP
    END IF
  END IF

  ' Redraw only the status message area so compile input is not processed twice
  _DEST logicalScreen
  LINE (statusBoxX + 1, statusBoxY + 1)-(scrollBarX - 1, statusBoxY + statusBoxH - 2), 0, BF

  lineY = statusBoxY + 4
  linesDrawn = 0
  FOR statusIdx = editor.StatusScrollY TO statusMsgCount - 1
    IF linesDrawn >= maxLines THEN EXIT FOR

    isHighlighted = 0
    IF (editor.Focus = 2 OR editor.MenuMode = 2) AND editor.StatusSelectedIndex > 0 THEN
      IF statusIdx >= hlStart AND statusIdx <= hlEnd THEN isHighlighted = 1
    END IF

    IF isHighlighted = 1 THEN
      LINE (statusBoxX + 1, lineY - 1)-(scrollBarX - 1, lineY + 9), 1, BF
      PrintStr statusBoxX + LEFT_SPACING, lineY, statusMsg(statusIdx).Text, 15, 0, 1
    ELSE
      PrintStr statusBoxX + LEFT_SPACING, lineY, statusMsg(statusIdx).Text, 14, 0, 1
    END IF

    lineY = lineY + 11
    linesDrawn = linesDrawn + 1
  NEXT

  dispScreenFlushUpdate

END SUB ' compileSaveTracker

''''''''''''''''''''''''
SUB compileWrapUp

  DIM clearMem AS _MEM

  ' Clear large string arrays to free memory and remove stagnant data from the compile run
  IF symbolCount > 0 THEN
    FOR ii = 0 TO symbolCount - 1
      strVarData$(ii) = ""
    NEXT
  END IF

  clearMem = _MEM(floatVarData())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  FOR iy = 0 TO compileLineHighWater
    compileText$(iy) = ""
  NEXT

  clearMem = _MEM(editorLineLinkMap())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  FOR ii = 0 TO MAX_TOKENS
    lineTokens$(ii) = ""
    lineTokenVals(ii) = 0
    lineTokenStartChar(ii) = 0
    lineTokenEndChar(ii) = 0
  NEXT

  ' Ensure argument flags are securely zeroed out to prevent state bleeding between runs
  clearMem = _MEM(byValTracker())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 0 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  ' Reset core tracking variables
  compileError = 0
  compileLastLine = 0
  compileLineHighWater = 0
  cm.HasGraphics = 0
  cm.HasGlobalDefInt = 0
  cm.StringStrict = 0
  cm.EmeraldMode = 0
  cm.ClassicMode = 0
  compileScreenMode = 0
  compileWindowTitle$ = "Default"
  cm.NoRef = 0
  cm.PascalMode = 0
  gfxConfig.SizeX = 640
  gfxConfig.SizeY = 480
  symbolCount = 0
  subCount = 0
  udtCount = 0
  textConstCount = 0
  declareCount = 0
  dataItemCount = 0
  patchCount = 0
  iatPatchCount = 0
  gotoPatchCount = 0
  callPatchCount = 0
  rt.PatchCount = 0
  ctrlCount = 0
  t.TiraVarCounter = 0
  t.LineCount = 0
  t.TempCounter = 0
  t.IsActive = 0
  stream.emitPos = 0
  outputFileIdx = 0
  lineTokenCount = 0
  currentLineNumber = 0
  scopeCounter = 0
  currentScopeID = 0
  lastNumericLabel = 0
  insideSub = 0
  currentSubName$ = ""
  defaultArrayDynamic = 0
  expectedSymType = TYPE_ANY
  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 0
  returnF2data = 0
  returnF3data = 0
  returnAddrVar = ""
  returnFieldSize = 0
  returnIsDynamic = 0
  tiraParsedArgType = TIRA_ARG_EMPTY
  tiraParsedArgVal = 0
  internalTempHeapSymbolIdx = 0
  engineSymbolLimit = 0
  currentFrameSize = 0
  peStackReserve = 0
  stack.currentStackOffset = 0
  isCompilingRT = 0
  rtWrapperActive = 0
  rtFrameSize = 0
  rtPrologueIdx = 0
  isDummyPass = 0
  isMeasurePass = 0

  FOR ii = 0 TO 25
    defIntMap(ii) = 0
    baseDefIntMap(ii) = 0
  NEXT

  FOR ii = 0 TO MAX_RT_ROUTINES
    rtIsUsed(ii) = 0
    rtOffset(ii) = 0
  NEXT

  initSymbolHash

  ' Reset the Pass 5 compile stream state to prevent compilation loops from stalling
  pass5.SubState = PASS5_STATE_START
  pass5.LINE = 0
  pass5.SUCCESS = 0
  pass5.Mode = PASS5_MODE_NONE
  pass5.ScanStartSymbolCount = 0
  pass5.ScanStartRuntimeCount = 0

  ' Unified transition back to idle editor state
  compileState = COMP_IDLE

END SUB ' compileWrapUp

