''''''''''''''''''''''''
SUB tiraRefreshVisualPage (pageVar$)

  tiraCheckActive ("tiraRefreshVisualPage")
  IF tiraLineCheck THEN EXIT SUB

  IF cm.HasGraphics = 1 THEN
    skipRefreshLbl$ = tiraLabelCreateNew$("SKIP_VISUAL_REFRESH")
    page0Lbl$ = tiraLabelCreateNew$("VISUAL_COUNT_0")
    page1Lbl$ = tiraLabelCreateNew$("VISUAL_COUNT_1")
    page2Lbl$ = tiraLabelCreateNew$("VISUAL_COUNT_2")
    page3Lbl$ = tiraLabelCreateNew$("VISUAL_COUNT_3")
    countDoneLbl$ = tiraLabelCreateNew$("VISUAL_COUNT_DONE")

    tiraJmpCond "JE", "!G_GFX_FLG_PAGING", "0", skipRefreshLbl$
    tiraJmpCond "JNE", pageVar$, "!G_GFX_VAL_VISUAL_PAGE", skipRefreshLbl$

    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "0", page0Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "1", page1Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "2", page2Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "3", page3Lbl$
    tiraJmp skipRefreshLbl$

    tiraLabel page0Lbl$
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_BACK"
    tiraJmp countDoneLbl$

    tiraLabel page1Lbl$
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE1"
    tiraJmp countDoneLbl$

    tiraLabel page2Lbl$
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE2"
    tiraJmp countDoneLbl$

    tiraLabel page3Lbl$
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE3"

    tiraLabel countDoneLbl$

    ' Repaint only after the complete visual-page operation has finished
    tiraCall "IAT_INVALIDATERECT", 3, "!G_WND_VAL_HWND, 0, 0"
    tiraCall "IAT_UPDATEWINDOW", 1, "!G_WND_VAL_HWND"

    tiraLabel skipRefreshLbl$
  END IF

END SUB ' tiraRefreshVisualPage

''''''''''''''''''''''''
SUB tiraRefreshVisualPageId (pageType AS LONG, pageVal AS _INTEGER64)

  tiraCheckActive ("tiraRefreshVisualPageId")
  IF tiraLineCheck THEN EXIT SUB

  DIM skipRefreshLblIdx AS LONG
  DIM page0LblIdx AS LONG
  DIM page1LblIdx AS LONG
  DIM page2LblIdx AS LONG
  DIM page3LblIdx AS LONG
  DIM countDoneLblIdx AS LONG
  DIM pagingIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM frontCountIdx AS LONG
  DIM backCountIdx AS LONG
  DIM page1CountIdx AS LONG
  DIM page2CountIdx AS LONG
  DIM page3CountIdx AS LONG
  DIM windowHandleIdx AS LONG
  DIM invalidateRectIdx AS LONG
  DIM updateWindowIdx AS LONG

  IF cm.HasGraphics = 1 THEN
    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    pagingIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    visualPageIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_FRONT")
    frontCountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_BACK")
    backCountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE1")
    page1CountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE2")
    page2CountIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_BUFR_COUNT_PAGE3")
    page3CountIdx = returnedData2

    ff = resolveSymbol("!G_WND_VAL_HWND")
    windowHandleIdx = returnedData2

    ff = resolveSymbol("IAT_INVALIDATERECT")
    invalidateRectIdx = returnedData2

    ff = resolveSymbol("IAT_UPDATEWINDOW")
    updateWindowIdx = returnedData2

    skipRefreshLblIdx = tiraLabelCreateNewId&("SKIP_VISUAL_REFRESH")
    page0LblIdx = tiraLabelCreateNewId&("VISUAL_COUNT_0")
    page1LblIdx = tiraLabelCreateNewId&("VISUAL_COUNT_1")
    page2LblIdx = tiraLabelCreateNewId&("VISUAL_COUNT_2")
    page3LblIdx = tiraLabelCreateNewId&("VISUAL_COUNT_3")
    countDoneLblIdx = tiraLabelCreateNewId&("VISUAL_COUNT_DONE")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, skipRefreshLblIdx
    tiraJmpCondId JCC_JNE, pageType, pageVal, TIRA_ARG_SYMBOL, visualPageIdx, skipRefreshLblIdx

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 0, page0LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 1, page1LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 2, page2LblIdx
    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, visualPageIdx, TIRA_ARG_LITERAL, 3, page3LblIdx
    tiraJmpId skipRefreshLblIdx

    tiraLabelId page0LblIdx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, backCountIdx
    tiraJmpId countDoneLblIdx

    tiraLabelId page1LblIdx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, page1CountIdx
    tiraJmpId countDoneLblIdx

    tiraLabelId page2LblIdx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, page2CountIdx
    tiraJmpId countDoneLblIdx

    tiraLabelId page3LblIdx
    tiraAssignId frontCountIdx, TIRA_ARG_SYMBOL, page3CountIdx

    tiraLabelId countDoneLblIdx

    ' Repaint only after the complete visual-page operation has finished
    tiraCallId3 invalidateRectIdx, TIRA_ARG_SYMBOL, windowHandleIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 0
    tiraCallId1 updateWindowIdx, TIRA_ARG_SYMBOL, windowHandleIdx

    tiraLabelId skipRefreshLblIdx
  END IF

END SUB ' tiraRefreshVisualPageId

''''''''''''''''''''''''
FUNCTION tiraResolveHoistVar$ (intrinsicName$, role$)

  tiraCheckActive ("tiraResolveHoistVar$")

  ' Extract the pure three-character hardware role by stripping the leading underscore
  roleNoUnderscore$ = MID$(role$, 2)

  ' Build the global internal variable name using !C to denote a compiler-generated construct
  tempName$ = "!C_EVL_" + roleNoUnderscore$ + "_HOIS" + intrinsicName$ + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))

  ' Increment the global TIRA counter
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tira_Cancel
    tiraResolveHoistVar$ = ""
    EXIT FUNCTION
  END IF

  ' Register this variable name in the global symbol table
  ff = resolveSymbol(tempName$)
  IF ff = 0 THEN
    tira_Cancel
    tiraResolveHoistVar$ = ""
    EXIT FUNCTION
  END IF

  IF currentScopeID > 0 THEN
    symbols(returnedData2).IsLocal = LOCAL_STANDARD
  END IF

  ' Set the function return value to the resolved variable name
  tiraResolveHoistVar$ = tempName$

END FUNCTION ' tiraResolveHoistVar$

''''''''''''''''''''''''
SUB tiraRT_Epilogue

  tiraCheckActive ("tiraRT_Epilogue")

  tiraParseArgToNode LTRIM$(STR$(rtFrameSize))
  tiraNode(rtPrologueIdx).Arg1Type = tiraParsedArgType
  tiraNode(rtPrologueIdx).Arg1Val = tiraParsedArgVal

  tiraNew TC_ABI_EPILOGUE, LTRIM$(STR$(rtFrameSize))

  ' Turn the safe wrapper off for the next helper in the queue
  rtWrapperActive = 0

END SUB ' tiraRT_Epilogue

''''''''''''''''''''''''
SUB tiraRT_EpilogueId

  tiraCheckActive ("tiraRT_EpilogueId")

  tiraNode(rtPrologueIdx).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(rtPrologueIdx).Arg1Val = rtFrameSize

  IF tiraLineCheck = 0 THEN
    tiraNode(t.LineCount).OpCode = TC_ABI_EPILOGUE

    tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
    tiraNode(t.LineCount).Arg1Val = rtFrameSize

    tiraNode(t.LineCount).Arg2Type = TIRA_ARG_EMPTY
    tiraNode(t.LineCount).Arg2Val = 0

    tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY
    tiraNode(t.LineCount).Arg3Val = 0

    tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY
    tiraNode(t.LineCount).Arg4Val = 0

    t.LineCount = t.LineCount + 1
  END IF

  ' Turn the safe wrapper off for the next helper in the queue
  rtWrapperActive = 0

END SUB ' tiraRT_EpilogueId

''''''''''''''''''''''''
SUB tiraRT_Prologue

  tiraCheckActive ("tiraRT_Prologue")

  isCompilingRT = 1

  ' Turn the safe wrapper on so tiraNew allows the ABI stack allocation commands
  rtWrapperActive = 1

  rtFrameSize = 0
  rtPrologueIdx = t.LineCount

  tiraNew TC_ABI_PROLOGUE, "0"

END SUB ' tiraRT_Prologue

''''''''''''''''''''''''
SUB tiraRT_PrologueId

  tiraCheckActive ("tiraRT_PrologueId")

  isCompilingRT = 1

  ' Turn the safe wrapper on for the ABI stack allocation commands
  rtWrapperActive = 1

  rtFrameSize = 0
  rtPrologueIdx = t.LineCount

  IF tiraLineCheck THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_ABI_PROLOGUE

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LITERAL
  tiraNode(t.LineCount).Arg1Val = 0

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_EMPTY
  tiraNode(t.LineCount).Arg2Val = 0

  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY
  tiraNode(t.LineCount).Arg3Val = 0

  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY
  tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraRT_PrologueId

''''''''''''''''''''''''
SUB tiraScheduleArrayFree (vIdx AS LONG)

  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM uIdx AS LONG
  DIM hasDynamicStrings AS LONG
  DIM curOff AS LONG
  DIM fixedLen AS LONG
  DIM numDims$
  DIM totalElems$
  DIM dimNumElems$
  DIM dimNumElems64$

  tiraCheckActive ("tiraScheduleArrayFree")

  descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

  arrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, arrPtr$ + ", " + descAddr$

  skipFreeLbl$ = tiraLabelCreateNew$("SKIPFREEARY")
  tiraJmpCond "JE", arrPtr$, "0", skipFreeLbl$

  dt = symbols(vIdx).DataType
  hasDynamicStrings = 0
  elemSize = retElementByteSize(vIdx)

  SELECT CASE dt

    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex
      IF uIdx >= 0 THEN
        hasDynamicStrings = tiraWalkUdtDynamicStrings("", uIdx, 0)
        IF compileError = 1 THEN EXIT SUB
      END IF

    CASE TYPE_STRING
      fixedLen = retFixeSTRINGDLength(vIdx)
      IF fixedLen = 0 THEN
        hasDynamicStrings = 1
      END IF

  END SELECT ' dt

  IF hasDynamicStrings = 1 THEN
    numDims$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, numDims$ + ", " + descAddr$ + ", 12"

    totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign totalElems$, "1"

    dimItr$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign dimItr$, "0"
    lblDimTop$ = tiraLabelCreateNew$("DIM_TOP")
    lblDimDone$ = tiraLabelCreateNew$("DIM_DONE")

    tiraLabel lblDimTop$
    tiraJmpCond "JGE", dimItr$, numDims$, lblDimDone$

    offsetVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, offsetVar$, dimItr$, "8"
    tiraOp TC_ADD, offsetVar$, offsetVar$, "16"

    dimLimitAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, dimLimitAddr$, descAddr$, offsetVar$

    dimNumElems$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM_OFFSET, dimNumElems$ + ", " + dimLimitAddr$ + ", 4"

    dimNumElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_CAST, dimNumElems64$, dimNumElems$, LTRIM$(STR$(TYPE_INTEGER64))

    tiraOp TC_MUL, totalElems$, totalElems$, dimNumElems64$
    tiraOp TC_ADD, dimItr$, dimItr$, "1"
    tiraJmp lblDimTop$

    tiraLabel lblDimDone$

    byteSize$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_MUL, byteSize$, totalElems$, LTRIM$(RTRIM$(STR$(elemSize)))

    itr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign itr$, arrPtr$

    endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, endPtr$, arrPtr$, byteSize$

    loopTop$ = tiraLabelCreateNew$("FREELOOPARY")
    loopDone$ = tiraLabelCreateNew$("FREEDONEARY")

    tiraLabel loopTop$
    tiraJmpCond "JGE", itr$, endPtr$, loopDone$

    IF dt = TYPE_UDT THEN
      ff = tiraWalkUdtDynamicStrings(itr$, uIdx, 1)
      IF compileError = 1 THEN EXIT SUB
    ELSE
      curOff = 0

      descAddrString$ = tiraDimVar$("T", TYPE_INTEGER64)
      IF curOff > 0 THEN
        tiraOp TC_ADD, descAddrString$, itr$, LTRIM$(STR$(curOff))
      ELSE
        tiraAssign descAddrString$, itr$
      END IF

      descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraNew TC_READ_MEM, descPtr$ + ", " + descAddrString$

      skipFreeDescLbl$ = tiraLabelCreateNew$("SKIP_FREE_STR")
      tiraJmpCond "JE", descPtr$, "0", skipFreeDescLbl$

      flagVal$ = tiraDimVar$("T", TYPE_LONG)
      flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADD, flagPtr$, descPtr$, "16"
      tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

      tiraJmpCond "JNE", flagVal$, "1", skipFreeDescLbl$

      dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraNew TC_READ_MEM, dataPtr$ + ", " + descPtr$

      tiraJmpCond "JE", dataPtr$, "0", skipFreeDescLbl$

      tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + dataPtr$

      tiraLabel skipFreeDescLbl$

      ' Also free the dynamically allocated descriptor to prevent a 24-byte leak per element
      emptyDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign emptyDescPtr$, "!G_SYS_DSC_EMPTY"
      skipDescFree$ = tiraLabelCreateNew$("SKIP_STR_FREE")
      tiraJmpCond "JE", descPtr$, "0", skipDescFree$
      tiraJmpCond "JE", descPtr$, emptyDescPtr$, skipDescFree$
      tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + descPtr$
      tiraLabel skipDescFree$
    END IF

    tiraOp TC_ADD, itr$, itr$, LTRIM$(STR$(elemSize))
    tiraJmp loopTop$

    tiraLabel loopDone$
  END IF

  IF symbols(vIdx).IsArray = 2 THEN
    tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + arrPtr$
  END IF

  tiraLabel skipFreeLbl$

END SUB ' tiraScheduleArrayFree

''''''''''''''''''''''''
FUNCTION tiraScheduleFuncOrArray (passOpTop AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleFuncOrArray")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM argCount AS LONG
  DIM argIdx AS LONG
  DIM resVar$
  DIM targetType AS LONG
  DIM udtOffset AS LONG
  DIM baseArgIdx AS LONG
  DIM opVal AS LONG
  DIM castTargetType AS LONG
  DIM argVar$
  DIM subName$
  DIM argDt AS LONG
  DIM targetVarIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM targetVarName$
  DIM srcArgIdx AS LONG
  DIM srcArgDt AS LONG
  DIM retVarIdx AS LONG
  DIM resType AS LONG
  DIM skipNullLbl$
  DIM finalAddr$
  DIM indicesStr$
  DIM idxVar$
  DIM srcIsComplex AS LONG
  DIM firstChar$
  DIM descPtr$
  DIM tgtDescAddr$
  DIM isFixedArr AS LONG

  DIM addrStageVarIdx AS LONG
  DIM addrStageName$
  DIM destDescPtr$
  DIM stageName$
  DIM stageAddr$
  DIM descriptorDimCount$
  DIM descriptorDimLowReady$
  DIM descriptorDimHighReady$
  DIM descriptorDimMatchReady$
  DIM descriptorByteSize$
  DIM tgtBaseAddr$
  DIM sMode$
  DIM castVar$
  DIM argListDll$
  DIM dataPtrVar$

  opVal = shuntOp(passOpTop).OpCode
  argCount = shuntOp(passOpTop).ArgCount

  SELECT CASE opVal

    CASE SHUNT_CAST
      castTargetType = shuntOp(passOpTop).VIdx
      argVar$ = shuntVal(localValTop - 1).VarName
      resVar$ = tiraDimVar$("T", castTargetType)
      tiraOp TC_CAST, resVar$, argVar$, LTRIM$(STR$(castTargetType))
      shuntVal(localValTop - 1).VarName = resVar$
      shuntVal(localValTop - 1).DataType = castTargetType
      shuntVal(localValTop - 1).VIdx = -1
      shuntVal(localValTop - 1).IsComplex = 1
      shuntVal(localValTop - 1).AddrVar = ""
      tiraScheduleFuncOrArray = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_FUNC
      subIdx = shuntOp(passOpTop).VIdx
      subName$ = RTRIM$(subs(subIdx).RecordName)

      IF argCount <> subs(subIdx).ArgCount THEN
        throwCompilerError "INCORRECT ARG COUNT FOR " + subName$, ASIS, 0
        tiraScheduleFuncOrArray = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      baseArgIdx = localValTop - argCount

      FOR argIdx = 0 TO argCount - 1
        formalVarIdx = subArgVarIdx(subIdx, argIdx)
        targetType = symbols(formalVarIdx).DataType
        argVar$ = shuntVal(baseArgIdx + argIdx).VarName
        argDt = shuntVal(baseArgIdx + argIdx).DataType

        IF symbols(formalVarIdx).IsArray = 2 THEN
          ' Array checks are handled dynamically inside the DLL or internal loops below
        ELSE
          IF targetType = TYPE_STRING THEN
            IF argDt <> TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
          ELSE
            IF argDt = TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            IF targetType <> TYPE_ANY AND argDt <> targetType THEN
              IF targetType = TYPE_UDT OR argDt = TYPE_UDT THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArray = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF subs(subIdx).IsDll = 1 OR byValTracker(subIdx, argIdx).DeclareArg = 1 OR byValTracker(subIdx, argIdx).SubArg = 1 OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrVar = "") THEN
                castVar$ = tiraDimVar$("T", targetType)
                tiraOp TC_CAST, castVar$, argVar$, LTRIM$(STR$(targetType))
                argVar$ = castVar$
                shuntVal(baseArgIdx + argIdx).VarName = argVar$
                shuntVal(baseArgIdx + argIdx).DataType = targetType
              END IF
            END IF
          END IF
        END IF
      NEXT

      IF subs(subIdx).IsDll = 1 THEN
        argListDll$ = ""
        FOR argIdx = 0 TO argCount - 1
          argVar$ = shuntVal(baseArgIdx + argIdx).VarName
          targetVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(targetVarIdx).DataType

          IF symbols(targetVarIdx).IsArray = 2 THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx = -1 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = 0 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArray = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(targetVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArray = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + argVar$ + ", 12"

            descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
            tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
            tiraFatalError "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabel descriptorDimLowReady$

            descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
            tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
            tiraFatalError "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabel descriptorDimHighReady$

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
              tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(targetVarIdx).NumDimensions)), descriptorDimMatchReady$
              tiraFatalError "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabel descriptorDimMatchReady$
            END IF

            IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
            argListDll$ = argListDll$ + argVar$
          ELSE
            IF targetType = TYPE_STRING THEN
              dataPtrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraNew TC_READ_MEM, dataPtrVar$ + ", " + argVar$
              IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
              argListDll$ = argListDll$ + dataPtrVar$
            ELSE
              IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
              argListDll$ = argListDll$ + argVar$
            END IF
          END IF
        NEXT

        tiraCall subName$, argCount, argListDll$

        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          resType = symbols(retVarIdx).DataType
          resVar$ = tiraDimVar$("T", resType)
          tiraNew TC_GET_RET, resVar$
        ELSE
          resType = TYPE_LONG
          resVar$ = tiraDimVar$("T", TYPE_LONG)
          tiraAssign resVar$, "0"
        END IF
      ELSE
        FOR argIdx = 0 TO argCount - 1
          argVar$ = shuntVal(baseArgIdx + argIdx).VarName
          argDt = shuntVal(baseArgIdx + argIdx).DataType

          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(formalVarIdx).DataType
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN
            tiraScheduleFuncOrArray = 0
            return2 localValTop
            EXIT FUNCTION
          END IF

          targetVarIdx = stageVarIdx
          targetVarName$ = "#" + LTRIM$(STR$(targetVarIdx))

          IF cm.NoRef = 0 THEN
            IF symbols(formalVarIdx).IsArray = 2 OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrVar <> "") THEN
              addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
              IF addrStageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArray = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))
              IF symbols(formalVarIdx).IsArray = 2 THEN
                tiraAssign addrStageName$, argVar$
              ELSE
                tiraAssign addrStageName$, shuntVal(baseArgIdx + argIdx).AddrVar
              END IF
            END IF
          END IF

          IF symbols(formalVarIdx).IsArray = 2 THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx = -1 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = 0 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArray = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArray = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(formalVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArray = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            tgtDescAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADDRESS_OF, tgtDescAddr$, targetVarName$, ""

            ' Read the actual runtime dimension count from this argument descriptor
            descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + argVar$ + ", 12"

            descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
            tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
            tiraFatalError "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabel descriptorDimLowReady$

            descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
            tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
            tiraFatalError "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabel descriptorDimHighReady$

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
              tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(targetVarIdx).NumDimensions)), descriptorDimMatchReady$
              tiraFatalError "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabel descriptorDimMatchReady$
            END IF

            ' Copy the complete source descriptor including every runtime dimension limit
            descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
            tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
            tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

            tiraMemcpy tgtDescAddr$, argVar$, descriptorByteSize$
          ELSE
            IF targetType = TYPE_UDT THEN
              tgtBase$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraOp TC_ADDRESS_OF, tgtBase$, targetVarName$, ""
              tiraCopyUdtValue tgtBase$, argVar$, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                tiraCall "RT_STR_ASSIGN", 2, targetVarName$ + ", " + argVar$
              ELSE
                tiraAssign targetVarName$, argVar$
              END IF
            END IF
          END IF
        NEXT

        tiraCall subName$, 0, ""

        ' Safely extract the return value from the hardware register BEFORE any pass-by-reference
        ' copy-out logic generates memory movements that could clobber the RAX/XMM0 registers
        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          resType = symbols(retVarIdx).DataType
          resVar$ = tiraDimVar$("T", resType)
          tiraNew TC_GET_RET, resVar$
        ELSE
          resType = TYPE_LONG
          resVar$ = tiraDimVar$("T", TYPE_LONG)
          tiraAssign resVar$, "0"
        END IF

        ' Functions evaluated mid-expression were previously treated as pass-by-value
        ' The callee now writes invocation-local formal values back to the staging symbols before return
        IF cm.NoRef = 0 AND subs(subIdx).IsDll = 0 THEN
          FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
            IF byValTracker(subIdx, argIdx).SubArg = 0 THEN
              formalVarIdx = subArgVarIdx(subIdx, argIdx)
              stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
              IF stageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArray = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF symbols(formalVarIdx).IsArray = 2 THEN
                addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                IF addrStageVarIdx = 0 OR compileError = 1 THEN
                  tiraScheduleFuncOrArray = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF

                addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))
                stageName$ = "#" + LTRIM$(STR$(stageVarIdx))

                stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

                ' Copy the returned staging descriptor back into the caller's original array descriptor
                descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
                tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + stageAddr$ + ", 12"

                descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
                tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
                tiraFatalError "INVALID RETURNED ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabel descriptorDimLowReady$

                descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
                tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
                tiraFatalError "RETURNED ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabel descriptorDimHighReady$

                IF symbols(formalVarIdx).NumDimensions > 0 THEN
                  descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
                  tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
                  tiraFatalError "RETURNED ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
                  tiraLabel descriptorDimMatchReady$
                END IF

                descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
                tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
                tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

                tiraMemcpy addrStageName$, stageAddr$, descriptorByteSize$
              ELSE
                srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
                srcIsComplex = shuntVal(baseArgIdx + argIdx).IsComplex
                IF srcArgIdx <> -1 AND retByRefTypeCompatible(shuntVal(baseArgIdx + argIdx).DataType, symbols(formalVarIdx).DataType) = 1 THEN
                  IF srcIsComplex = 0 THEN
                    firstChar$ = LEFT$(RTRIM$(symbols(srcArgIdx).RecordName), 1)
                    IF firstChar$ <> "!" THEN
                      tiraEmitPassByRefCopyOut srcArgIdx, stageVarIdx
                    END IF
                  ELSE
                    IF shuntVal(baseArgIdx + argIdx).AddrVar <> "" THEN
                      addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                      IF addrStageVarIdx = 0 OR compileError = 1 THEN
                        tiraScheduleFuncOrArray = 0
                        return2 localValTop
                        EXIT FUNCTION
                      END IF

                      addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))

                      IF symbols(formalVarIdx).DataType = TYPE_STRING THEN
                        ' Copy the modified dynamic string back into the original target
                        destDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraNew TC_READ_MEM, destDescPtr$ + ", " + addrStageName$

                        tiraEnsureStringAlloc destDescPtr$, addrStageName$

                        stageName$ = "#" + LTRIM$(STR$(stageVarIdx))
                        tiraCall "RT_STR_ASSIGN", 2, destDescPtr$ + ", " + stageName$
                      ELSE
                        IF symbols(formalVarIdx).DataType = TYPE_UDT THEN
                          tgtBaseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                          tiraOp TC_ADDRESS_OF, tgtBaseAddr$, "#" + LTRIM$(STR$(stageVarIdx)), ""
                          tiraCopyUdtValue addrStageName$, tgtBaseAddr$, symbols(formalVarIdx).UDTIndex
                        ELSE
                          stageName$ = "#" + LTRIM$(STR$(stageVarIdx))
                          argDt = shuntVal(baseArgIdx + argIdx).DataType
                          sMode$ = RTRIM$(typeDb(argDt).TiraMode)
                          IF sMode$ = "" THEN sMode$ = "8"
                          tiraWriteMem addrStageName$, stageName$, sMode$
                        END IF
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          NEXT
        END IF
      END IF

      localValTop = baseArgIdx
      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArray = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = resVar$
      shuntVal(localValTop).DataType = resType
      shuntVal(localValTop).VIdx = -1
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrVar = ""
      localValTop = localValTop + 1

      tiraScheduleFuncOrArray = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_ARRAY
      vIdx = shuntOp(passOpTop).VIdx
      targetType = shuntOp(passOpTop).TargetType
      udtOffset = shuntOp(passOpTop).UdtOffset

      IF argCount = 0 THEN
        ' Passing entire array to a function evaluates to the memory pointer of its descriptor
        resVar$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADDRESS_OF, resVar$, RTRIM$(symbols(vIdx).RecordName), ""
        targetType = TYPE_INTEGER64
      ELSE
        indicesStr$ = ""
        FOR ii = 1 TO argCount
          idxVar$ = shuntVal(localValTop - argCount + ii - 1).VarName
          idxVar$ = tiraForceInt$(idxVar$)
          IF indicesStr$ = "" THEN indicesStr$ = idxVar$ ELSE indicesStr$ = indicesStr$ + "," + idxVar$
        NEXT ii
        localValTop = localValTop - argCount

        IF symbols(vIdx).NumDimensions > 0 AND argCount <> symbols(vIdx).NumDimensions THEN
          throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
          tiraScheduleFuncOrArray = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
        resVar$ = tiraDimVar$("T", targetType)

        isFixedArr = 0
        IF targetType = TYPE_STRING AND shuntOp(passOpTop).HasField = 0 AND symbols(vIdx).IsArray > 0 THEN
          IF retFixeSTRINGDLength(vIdx) > 0 THEN isFixedArr = 1
        END IF

        IF targetType = TYPE_STRING AND ((shuntOp(passOpTop).HasField = 1 AND shuntOp(passOpTop).IsDynamic = 0) OR isFixedArr = 1) THEN
          ' Synthesize a dynamic descriptor representing the fixed data block from the array layout
          resVar$ = tiraResolveHoistVar$("FSTR", "_DSC")
          descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraAssign descPtr$, resVar$
          IF isFixedArr = 1 THEN
            tiraBuildStrDesc descPtr$, finalAddr$, LTRIM$(STR$(retFixeSTRINGDLength(vIdx))), "0"
          ELSE
            tiraBuildStrDesc descPtr$, finalAddr$, LTRIM$(STR$(shuntOp(passOpTop).FieldSize)), "0"
          END IF
        ELSE
          tiraNew TC_READ_MEM, resVar$ + ", " + finalAddr$

          IF targetType = TYPE_STRING THEN
            skipNullLbl$ = tiraLabelCreateNew$("SKIP_NULL")
            tiraJmpCond "JNE", resVar$, "0", skipNullLbl$
            tiraAssign resVar$, "!G_SYS_DSC_EMPTY"
            tiraLabel skipNullLbl$
          END IF
        END IF
      END IF

      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArray = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = resVar$
      shuntVal(localValTop).DataType = targetType
      shuntVal(localValTop).VIdx = vIdx
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrVar = returnAddrVar
      localValTop = localValTop + 1

      return2 localValTop
      tiraScheduleFuncOrArray = 1
      EXIT FUNCTION

  END SELECT ' opVal

  tiraScheduleFuncOrArray = 0
  return2 localValTop

END FUNCTION ' tiraScheduleFuncOrArray

''''''''''''''''''''''''
FUNCTION tiraScheduleFuncOrArrayId (passOpTop AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleFuncOrArrayId")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM argCount AS LONG
  DIM argIdx AS LONG
  DIM resVarIdx AS LONG
  DIM targetType AS LONG
  DIM udtOffset AS LONG
  DIM baseArgIdx AS LONG
  DIM opVal AS LONG
  DIM castTargetType AS LONG
  DIM argType AS LONG
  DIM argVal AS _INTEGER64
  DIM subName$
  DIM argDt AS LONG
  DIM targetVarIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM srcArgIdx AS LONG
  DIM srcArgDt AS LONG
  DIM retVarIdx AS LONG
  DIM resType AS LONG
  DIM skipNullLblIdx AS LONG
  DIM finalAddrIdx AS LONG
  DIM srcIsComplex AS LONG
  DIM firstChar$
  DIM descPtrIdx AS LONG
  DIM isFixedArr AS LONG
  DIM fixedLen AS LONG
  DIM emptyDescIdx AS LONG
  DIM callSymbolLink AS LONG
  DIM callFuncIdx AS LONG
  DIM strAssignIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM idxLiteral$
  DIM idxFirstChar AS STRING * 1
  DIM idxIsNumericLiteral AS LONG

  DIM addrStageVarIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM stageAddrIdx AS LONG
  DIM descriptorDimCountIdx AS LONG
  DIM descriptorDimLowReadyIdx AS LONG
  DIM descriptorDimHighReadyIdx AS LONG
  DIM descriptorDimMatchReadyIdx AS LONG
  DIM descriptorByteSizeIdx AS LONG
  DIM tgtBaseAddrIdx AS LONG
  DIM castVarIdx AS LONG
  DIM tgtDescAddrIdx AS LONG
  DIM sizeModeType AS LONG
  DIM sizeModeVal AS _INTEGER64

  opVal = shuntOp(passOpTop).OpCode
  argCount = shuntOp(passOpTop).ArgCount

  SELECT CASE opVal

    CASE SHUNT_CAST
      castTargetType = shuntOp(passOpTop).VIdx
      argType = shuntVal(localValTop - 1).ArgType
      argVal = shuntVal(localValTop - 1).ArgVal
      resVarIdx = tiraDimVarId&("T", castTargetType)
      tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, resVarIdx, argType, argVal, TIRA_ARG_LITERAL, castTargetType
      shuntVal(localValTop - 1).VarName = ""
      shuntVal(localValTop - 1).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop - 1).ArgVal = resVarIdx
      shuntVal(localValTop - 1).DataType = castTargetType
      shuntVal(localValTop - 1).VIdx = -1
      shuntVal(localValTop - 1).IsComplex = 1
      shuntVal(localValTop - 1).AddrVar = ""
      shuntVal(localValTop - 1).AddrType = TIRA_ARG_EMPTY
      shuntVal(localValTop - 1).AddrVal = 0
      tiraScheduleFuncOrArrayId = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_FUNC
      subIdx = shuntOp(passOpTop).VIdx
      subName$ = RTRIM$(subs(subIdx).RecordName)

      IF argCount <> subs(subIdx).ArgCount THEN
        throwCompilerError "INCORRECT ARG COUNT FOR " + subName$, ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF

      callSymbolLink = routineSymbolIndex(subIdx)
      IF callSymbolLink <= 0 THEN
        throwCompilerError "ROUTINE SYMBOL NOT FOUND FOR " + subName$, ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      callFuncIdx = callSymbolLink - 1

      baseArgIdx = localValTop - argCount

      FOR argIdx = 0 TO argCount - 1
        formalVarIdx = subArgVarIdx(subIdx, argIdx)
        targetType = symbols(formalVarIdx).DataType
        argDt = shuntVal(baseArgIdx + argIdx).DataType

        IF symbols(formalVarIdx).IsArray = 2 THEN
          ' Array checks are handled dynamically inside the DLL or internal loops below
        ELSE
          IF targetType = TYPE_STRING THEN
            IF argDt <> TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
          ELSE
            IF argDt = TYPE_STRING THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            IF targetType <> TYPE_ANY AND argDt <> targetType THEN
              IF targetType = TYPE_UDT OR argDt = TYPE_UDT THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF subs(subIdx).IsDll = 1 OR byValTracker(subIdx, argIdx).DeclareArg = 1 OR byValTracker(subIdx, argIdx).SubArg = 1 OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrType = TIRA_ARG_EMPTY) THEN
                castVarIdx = tiraDimVarId&("T", targetType)
                tiraOpId3 TC_CAST, TIRA_ARG_SYMBOL, castVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, TIRA_ARG_LITERAL, targetType
                shuntVal(baseArgIdx + argIdx).VarName = ""
                shuntVal(baseArgIdx + argIdx).ArgType = TIRA_ARG_SYMBOL
                shuntVal(baseArgIdx + argIdx).ArgVal = castVarIdx
                shuntVal(baseArgIdx + argIdx).DataType = targetType
              END IF
            END IF
          END IF
        END IF
      NEXT

      IF subs(subIdx).IsDll = 1 THEN
        FOR argIdx = 0 TO argCount - 1
          targetVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(targetVarIdx).DataType

          IF symbols(targetVarIdx).IsArray = 2 THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx = -1 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = 0 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(targetVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, 12

            descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
            tiraFatalErrorId "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimLowReadyIdx

            descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
            tiraFatalErrorId "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimHighReadyIdx

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(targetVarIdx).NumDimensions, descriptorDimMatchReadyIdx
              tiraFatalErrorId "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabelId descriptorDimMatchReadyIdx
            END IF
          ELSE
            IF targetType = TYPE_STRING THEN
              dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraReadMemId dataPtrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              shuntVal(baseArgIdx + argIdx).ArgType = TIRA_ARG_SYMBOL
              shuntVal(baseArgIdx + argIdx).ArgVal = dataPtrIdx
            END IF
          END IF
        NEXT

        tiraCallShuntId callFuncIdx, argCount, baseArgIdx

        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          resType = symbols(retVarIdx).DataType
          resVarIdx = tiraDimVarId&("T", resType)
          tiraGetRetId resVarIdx
        ELSE
          resType = TYPE_LONG
          resVarIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
        END IF
      ELSE
        FOR argIdx = 0 TO argCount - 1
          argDt = shuntVal(baseArgIdx + argIdx).DataType

          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          targetType = symbols(formalVarIdx).DataType
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF

          targetVarIdx = stageVarIdx

          IF cm.NoRef = 0 THEN
            IF symbols(formalVarIdx).IsArray = 2 OR (shuntVal(baseArgIdx + argIdx).IsComplex <> 0 AND shuntVal(baseArgIdx + argIdx).AddrType <> TIRA_ARG_EMPTY) THEN
              addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
              IF addrStageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF symbols(formalVarIdx).IsArray = 2 THEN
                tiraAssignId addrStageVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              ELSE
                tiraAssignId addrStageVarIdx, shuntVal(baseArgIdx + argIdx).AddrType, shuntVal(baseArgIdx + argIdx).AddrVal
              END IF
            END IF
          END IF

          IF symbols(formalVarIdx).IsArray = 2 THEN
            srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
            IF srcArgIdx = -1 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            IF symbols(srcArgIdx).IsArray = 0 THEN
              throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF

            srcArgDt = symbols(srcArgIdx).DataType
            IF targetType <> TYPE_ANY THEN
              IF srcArgDt <> targetType THEN
                throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF targetType = TYPE_UDT THEN
                IF symbols(srcArgIdx).UDTIndex <> symbols(formalVarIdx).UDTIndex THEN
                  throwCompilerError "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            tgtDescAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
            tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtDescAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx

            ' Read the actual runtime dimension count from this argument descriptor
            descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraReadMemOffsetId descriptorDimCountIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, 12

            descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
            tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
            tiraFatalErrorId "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimLowReadyIdx

            descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
            tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
            tiraFatalErrorId "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
            tiraLabelId descriptorDimHighReadyIdx

            IF symbols(targetVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
              tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(targetVarIdx).NumDimensions, descriptorDimMatchReadyIdx
              tiraFatalErrorId "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
              tiraLabelId descriptorDimMatchReadyIdx
            END IF

            ' Copy the complete source descriptor including every runtime dimension limit
            descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
            tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
            tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

            tiraMemcpyId TIRA_ARG_SYMBOL, tgtDescAddrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
          ELSE
            IF targetType = TYPE_UDT THEN
              tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
              tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, targetVarIdx
              tiraCopyUdtValueId TIRA_ARG_SYMBOL, tgtBaseAddrIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                ff = resolveSymbol("RT_STR_ASSIGN")
                IF ff = 0 THEN
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF
                strAssignIdx = returnedData2
                tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, targetVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              ELSE
                tiraAssignId targetVarIdx, shuntVal(baseArgIdx + argIdx).ArgType, shuntVal(baseArgIdx + argIdx).ArgVal
              END IF
            END IF
          END IF
        NEXT

        tiraCallId0 callFuncIdx

        ' Safely extract the return value from the hardware register BEFORE any pass-by-reference
        ' copy-out logic generates memory movements that could clobber the RAX/XMM0 registers
        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          resType = symbols(retVarIdx).DataType
          resVarIdx = tiraDimVarId&("T", resType)
          tiraGetRetId resVarIdx
        ELSE
          resType = TYPE_LONG
          resVarIdx = tiraDimVarId&("T", TYPE_LONG)
          tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
        END IF

        ' Functions evaluated mid-expression were previously treated as pass-by-value
        ' The callee now writes invocation-local formal values back to the staging symbols before return
        IF cm.NoRef = 0 AND subs(subIdx).IsDll = 0 THEN
          FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
            IF byValTracker(subIdx, argIdx).SubArg = 0 THEN
              formalVarIdx = subArgVarIdx(subIdx, argIdx)
              stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
              IF stageVarIdx = 0 OR compileError = 1 THEN
                tiraScheduleFuncOrArrayId = 0
                return2 localValTop
                EXIT FUNCTION
              END IF

              IF symbols(formalVarIdx).IsArray = 2 THEN
                addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                IF addrStageVarIdx = 0 OR compileError = 1 THEN
                  tiraScheduleFuncOrArrayId = 0
                  return2 localValTop
                  EXIT FUNCTION
                END IF

                stageAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx

                ' Copy the returned staging descriptor back into the caller's original array descriptor
                descriptorDimCountIdx = tiraDimVarId&("T", TYPE_LONG)
                tiraReadMemOffsetId descriptorDimCountIdx, TIRA_ARG_SYMBOL, stageAddrIdx, 12

                descriptorDimLowReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_LOW")
                tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 0, descriptorDimLowReadyIdx
                tiraFatalErrorId "INVALID RETURNED ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabelId descriptorDimLowReadyIdx

                descriptorDimHighReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_HIGH")
                tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 255, descriptorDimHighReadyIdx
                tiraFatalErrorId "RETURNED ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(argIdx + 1))
                tiraLabelId descriptorDimHighReadyIdx

                IF symbols(formalVarIdx).NumDimensions > 0 THEN
                  descriptorDimMatchReadyIdx = tiraLabelCreateNewId&("ARG_DESC_DIM_MATCH")
                  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, symbols(formalVarIdx).NumDimensions, descriptorDimMatchReadyIdx
                  tiraFatalErrorId "RETURNED ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(argIdx + 1))
                  tiraLabelId descriptorDimMatchReadyIdx
                END IF

                descriptorByteSizeIdx = tiraDimVarId&("T", TYPE_LONG)
                tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorDimCountIdx, TIRA_ARG_LITERAL, 8
                tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx, TIRA_ARG_LITERAL, 16

                tiraMemcpyId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, stageAddrIdx, TIRA_ARG_SYMBOL, descriptorByteSizeIdx
              ELSE
                srcArgIdx = shuntVal(baseArgIdx + argIdx).VIdx
                srcIsComplex = shuntVal(baseArgIdx + argIdx).IsComplex
                IF srcArgIdx <> -1 AND retByRefTypeCompatible(shuntVal(baseArgIdx + argIdx).DataType, symbols(formalVarIdx).DataType) = 1 THEN
                  IF srcIsComplex = 0 THEN
                    firstChar$ = LEFT$(RTRIM$(symbols(srcArgIdx).RecordName), 1)
                    IF firstChar$ <> "!" THEN
                      tiraEmitPassByRefCopyOutId srcArgIdx, stageVarIdx
                    END IF
                  ELSE
                    IF shuntVal(baseArgIdx + argIdx).AddrType <> TIRA_ARG_EMPTY THEN
                      addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, argIdx)
                      IF addrStageVarIdx = 0 OR compileError = 1 THEN
                        tiraScheduleFuncOrArrayId = 0
                        return2 localValTop
                        EXIT FUNCTION
                      END IF

                      IF symbols(formalVarIdx).DataType = TYPE_STRING THEN
                        ' Copy the modified dynamic string back into the original target
                        destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                        tiraReadMemId destDescPtrIdx, TIRA_ARG_SYMBOL, addrStageVarIdx

                        tiraEnsureStringAllocId destDescPtrIdx, TIRA_ARG_SYMBOL, addrStageVarIdx

                        ff = resolveSymbol("RT_STR_ASSIGN")
                        IF ff = 0 THEN
                          tiraScheduleFuncOrArrayId = 0
                          return2 localValTop
                          EXIT FUNCTION
                        END IF
                        strAssignIdx = returnedData2
                        tiraCallId2 strAssignIdx, TIRA_ARG_SYMBOL, destDescPtrIdx, TIRA_ARG_SYMBOL, stageVarIdx
                      ELSE
                        IF symbols(formalVarIdx).DataType = TYPE_UDT THEN
                          tgtBaseAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
                          tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, TIRA_ARG_SYMBOL, stageVarIdx
                          tiraCopyUdtValueId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, tgtBaseAddrIdx, symbols(formalVarIdx).UDTIndex
                        ELSE
                          argDt = shuntVal(baseArgIdx + argIdx).DataType

                          SELECT CASE argDt

                            CASE TYPE_BYTE, TYPE_UBYTE
                              sizeModeType = TIRA_ARG_LITERAL
                              sizeModeVal = 1

                            CASE TYPE_INTEGER, TYPE_UINTEGER
                              sizeModeType = TIRA_ARG_LITERAL
                              sizeModeVal = 2

                            CASE TYPE_LONG, TYPE_ULONG
                              sizeModeType = TIRA_ARG_LITERAL
                              sizeModeVal = 4

                            CASE TYPE_SINGLE
                              sizeModeType = TIRA_ARG_STR_LITERAL
                              sizeModeVal = 32

                            CASE TYPE_DOUBLE
                              sizeModeType = TIRA_ARG_STR_LITERAL
                              sizeModeVal = 64

                            CASE ELSE
                              sizeModeType = TIRA_ARG_LITERAL
                              sizeModeVal = 8

                          END SELECT ' argDt

                          tiraWriteMemId TIRA_ARG_SYMBOL, addrStageVarIdx, TIRA_ARG_SYMBOL, stageVarIdx, sizeModeType, sizeModeVal
                        END IF
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          NEXT
        END IF
      END IF

      localValTop = baseArgIdx
      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = ""
      shuntVal(localValTop).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop).ArgVal = resVarIdx
      shuntVal(localValTop).DataType = resType
      shuntVal(localValTop).VIdx = -1
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrVar = ""
      shuntVal(localValTop).AddrType = TIRA_ARG_EMPTY
      shuntVal(localValTop).AddrVal = 0
      localValTop = localValTop + 1

      tiraScheduleFuncOrArrayId = 1
      return2 localValTop
      EXIT FUNCTION

    CASE SHUNT_ARRAY
      vIdx = shuntOp(passOpTop).VIdx
      targetType = shuntOp(passOpTop).TargetType
      udtOffset = shuntOp(passOpTop).UdtOffset
      tiraParsedAddrType = TIRA_ARG_EMPTY
      tiraParsedAddrVal = 0

      IF argCount = 0 THEN
        ' Passing entire array to a function evaluates to the memory pointer of its descriptor
        resVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, vIdx
        targetType = TYPE_INTEGER64
      ELSE
        FOR ii = 1 TO argCount
          argIdx = localValTop - argCount + ii - 1
          idxLiteral$ = shuntVal(argIdx).VarName
          idxIsNumericLiteral = 0

          IF idxLiteral$ <> "" THEN
            idxFirstChar = LEFT$(idxLiteral$, 1)
            IF (idxFirstChar >= "0" AND idxFirstChar <= "9") OR idxFirstChar = "-" OR idxFirstChar = "." OR (idxFirstChar = "&" AND (UCASE$(MID$(idxLiteral$, 2, 1)) = "H" OR UCASE$(MID$(idxLiteral$, 2, 1)) = "O")) THEN
              idxIsNumericLiteral = 1
            END IF
          END IF

          IF idxIsNumericLiteral = 1 THEN
            tiraParsedArgType = shuntVal(argIdx).ArgType
            tiraParsedArgVal = shuntVal(argIdx).ArgVal
            IF INSTR(idxLiteral$, ".") > 0 THEN
              tiraParsedArgType = TIRA_ARG_LITERAL
              tiraParsedArgVal = INT(VAL(idxLiteral$))
            END IF
          ELSE
            tiraForceIntArgId shuntVal(argIdx).ArgType, shuntVal(argIdx).ArgVal, shuntVal(argIdx).DataType
          END IF
          tiraParsedArrayArgType(ii) = tiraParsedArgType
          tiraParsedArrayArgVal(ii) = tiraParsedArgVal
        NEXT ii
        localValTop = localValTop - argCount

        IF symbols(vIdx).NumDimensions > 0 AND argCount <> symbols(vIdx).NumDimensions THEN
          throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
          tiraScheduleFuncOrArrayId = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        finalAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, argCount, udtOffset)
        IF compileError = 1 THEN
          tiraScheduleFuncOrArrayId = 0
          return2 localValTop
          EXIT FUNCTION
        END IF

        tiraParsedAddrType = TIRA_ARG_SYMBOL
        tiraParsedAddrVal = finalAddrIdx
        returnAddrVar = RTRIM$(symbols(finalAddrIdx).RecordName)

        resVarIdx = tiraDimVarId&("T", targetType)

        isFixedArr = 0
        IF targetType = TYPE_STRING AND shuntOp(passOpTop).HasField = 0 AND symbols(vIdx).IsArray > 0 THEN
          IF retFixeSTRINGDLength(vIdx) > 0 THEN isFixedArr = 1
        END IF

        IF targetType = TYPE_STRING AND ((shuntOp(passOpTop).HasField = 1 AND shuntOp(passOpTop).IsDynamic = 0) OR isFixedArr = 1) THEN
          ' Synthesize a dynamic descriptor representing the fixed data block from the array layout
          resVarIdx = tiraResolveHoistVarId&("FSTR", "_DSC")
          IF resVarIdx = 0 THEN
            tiraScheduleFuncOrArrayId = 0
            return2 localValTop
            EXIT FUNCTION
          END IF
          descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
          tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, resVarIdx
          IF isFixedArr = 1 THEN
            fixedLen = retFixeSTRINGDLength(vIdx)
            tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, fixedLen, TIRA_ARG_LITERAL, 0
          ELSE
            tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, finalAddrIdx, TIRA_ARG_LITERAL, shuntOp(passOpTop).FieldSize, TIRA_ARG_LITERAL, 0
          END IF
        ELSE
          tiraReadMemId resVarIdx, TIRA_ARG_SYMBOL, finalAddrIdx

          IF targetType = TYPE_STRING THEN
            skipNullLblIdx = tiraLabelCreateNewId&("SKIP_NULL")
            tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipNullLblIdx
            ff = resolveSymbol("!G_SYS_DSC_EMPTY")
            IF ff = 0 THEN
              tiraScheduleFuncOrArrayId = 0
              return2 localValTop
              EXIT FUNCTION
            END IF
            emptyDescIdx = returnedData2
            tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, emptyDescIdx
            tiraLabelId skipNullLblIdx
          END IF
        END IF
      END IF

      IF localValTop > MAX_SHUNT THEN
        throwCompilerErrorAndCancelTira "EXPRESSION SHUNT LIMIT EXCEEDED", ASIS, 0
        tiraScheduleFuncOrArrayId = 0
        return2 localValTop
        EXIT FUNCTION
      END IF
      shuntVal(localValTop).VarName = ""
      shuntVal(localValTop).ArgType = TIRA_ARG_SYMBOL
      shuntVal(localValTop).ArgVal = resVarIdx
      shuntVal(localValTop).DataType = targetType
      shuntVal(localValTop).VIdx = vIdx
      shuntVal(localValTop).IsComplex = 1
      shuntVal(localValTop).AddrVar = returnAddrVar
      shuntVal(localValTop).AddrType = tiraParsedAddrType
      shuntVal(localValTop).AddrVal = tiraParsedAddrVal
      localValTop = localValTop + 1

      return2 localValTop
      tiraScheduleFuncOrArrayId = 1
      EXIT FUNCTION

  END SELECT ' opVal

  tiraScheduleFuncOrArrayId = 0
  return2 localValTop

END FUNCTION ' tiraScheduleFuncOrArrayId

''''''''''''''''''''''''
SUB tiraScheduleGC

  DIM dt AS LONG
  DIM uIdx AS LONG
  DIM hasDynamicStrings AS LONG
  DIM vIdx AS LONG
  DIM safeSymbolLimit AS LONG
  DIM scopeLink AS LONG
  DIM nextScopeLink AS LONG
  DIM scopeStopLink AS LONG
  DIM firstChar$
  DIM secondChar$
  DIM isTempInternal AS LONG
  DIM subIdx AS LONG
  DIM argIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM targetType AS LONG
  DIM isFormalArray AS LONG
  DIM recName$
  DIM isReturnVar AS LONG

  tiraCheckActive ("tiraScheduleGC")

  subIdx = 0
  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN subIdx = returnedData2
  END IF

  ' Publish this invocation's final formal values before local strings and UDT fields are released
  IF cm.NoRef = 0 AND subIdx <> 0 THEN
    IF subs(subIdx).ArgCount > 0 THEN
      FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
        IF byValTracker(subIdx, argIdx).SubArg = 0 THEN
          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN EXIT SUB

          targetType = symbols(formalVarIdx).DataType
          formalName$ = "#" + LTRIM$(STR$(formalVarIdx))
          stageName$ = "#" + LTRIM$(STR$(stageVarIdx))

          IF symbols(formalVarIdx).IsArray = 2 THEN
            formalAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADDRESS_OF, formalAddr$, formalName$, ""

            stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

            ' Copy the final formal array descriptor back into the call-boundary staging descriptor
            descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + formalAddr$ + ", 12"

            descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
            tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
            tiraFatalError "INVALID FORMAL ARRAY DESCRIPTOR"
            tiraLabel descriptorDimLowReady$

            descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
            tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
            tiraFatalError "FORMAL ARRAY DESCRIPTOR DIMENSION LIMIT"
            tiraLabel descriptorDimHighReady$

            IF symbols(formalVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
              tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
              tiraFatalError "FORMAL ARRAY DIMENSION MISMATCH"
              tiraLabel descriptorDimMatchReady$
            END IF

            descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
            tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
            tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

            tiraMemcpy stageAddr$, formalAddr$, descriptorByteSize$
          ELSE
            IF targetType = TYPE_UDT THEN
              formalAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraOp TC_ADDRESS_OF, formalAddr$, formalName$, ""

              stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

              tiraCopyUdtValue stageAddr$, formalAddr$, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                tiraCall "RT_STR_ASSIGN", 2, stageName$ + ", " + formalName$
              ELSE
                tiraAssign stageName$, formalName$
              END IF
            END IF
          END IF
        END IF
      NEXT
    END IF
  END IF

  ' Cache the symbol count explicitly into a static limit variable, to prevent cross-pass desynchronization when evaluating temp limits
  ' Because the garbage collection pass generates new ephemeral TIRA variables
  ' and increments the global symbol count dynamically, caching this limit
  ' guarantees a rigid evaluation boundary and prevents infinite loops if
  ' this block is ever refactored into a DO WHILE structure

  syncSymbolScopeIndex
  safeSymbolLimit = symbolCount

  IF insideSub > 0 AND currentScopeID > 0 AND currentScopeID <= MAX_SUBS THEN
    IF safeSymbolLimit > engineSymbolLimit THEN
      scopeLink = scopeSymbolHead(currentScopeID)
      scopeStopLink = scopeSymbolTail(currentScopeID)

      DO WHILE scopeLink > 0
        vIdx = scopeLink - 1
        nextScopeLink = scopeSymbolNext(vIdx)

        IF vIdx >= engineSymbolLimit AND vIdx < safeSymbolLimit THEN
          recName$ = RTRIM$(symbols(vIdx).RecordName)
          firstChar$ = LEFT$(recName$, 1)
          secondChar$ = MID$(recName$, 2, 1)

          isReturnVar = 0
          IF subIdx <> 0 THEN
            IF subs(subIdx).IsFunction = 1 THEN
              IF vIdx = subs(subIdx).ReturnVarIdx THEN isReturnVar = 1
            END IF
          END IF

          IF isReturnVar = 0 THEN
            IF NOT (firstChar$ = "!" AND secondChar$ = "G") THEN
              IF symbols(vIdx).ScopeID = currentScopeID AND symbols(vIdx).IsLocal = LOCAL_STANDARD THEN
                IF symbols(vIdx).IsArray > 0 THEN
                  isFormalArray = 0
                  IF subIdx <> 0 THEN
                    IF subs(subIdx).ArgCount > 0 THEN
                      FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
                        IF subArgVarIdx(subIdx, argIdx) = vIdx THEN
                          isFormalArray = 1
                          EXIT FOR
                        END IF
                      NEXT
                    END IF
                  END IF

                  IF isFormalArray = 0 THEN tiraScheduleArrayFree vIdx
                ELSE
                  isTempInternal = 0
                  IF firstChar$ = "!" AND secondChar$ = "T" THEN
                    isTempInternal = 1
                  END IF

                  dt = symbols(vIdx).DataType

                  IF dt = TYPE_STRING AND isTempInternal = 0 THEN
                    descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                    tiraAssign descPtr$, "#" + LTRIM$(STR$(vIdx))

                    flagVal$ = tiraDimVar$("T", TYPE_LONG)
                    flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                    tiraOp TC_ADD, flagPtr$, descPtr$, "16"
                    tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

                    skipFreeDataLbl$ = tiraLabelCreateNew$("SKIPDATA")
                    tiraJmpCond "JNE", flagVal$, "1", skipFreeDataLbl$

                    dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                    tiraNew TC_READ_MEM, dataPtr$ + ", " + descPtr$

                    tiraJmpCond "JE", dataPtr$, "0", skipFreeDataLbl$

                    tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + dataPtr$

                    tiraLabel skipFreeDataLbl$

                  ELSE
                    IF dt = TYPE_UDT AND isTempInternal = 0 THEN
                      uIdx = symbols(vIdx).UDTIndex

                      IF uIdx = -1 THEN
                        err1$ = "COMPILER FAIL: Missing UDTIndex for variable " + recName$ + " in tiraScheduleGC"
                        err2$ = "vIdx: " + LTRIM$(STR$(vIdx)) + " | ScopeID: " + LTRIM$(STR$(symbols(vIdx).ScopeID)) + " | Sub: " + currentSubName$
                        ESCAPETEXT2 err1$, err2$
                        EXIT SUB
                      END IF

                      hasDynamicStrings = tiraWalkUdtDynamicStrings("", uIdx, 0)
                      IF compileError = 1 THEN EXIT SUB

                      IF hasDynamicStrings = 1 THEN
                        basePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                        tiraOp TC_ADDRESS_OF, basePtr$, "#" + LTRIM$(STR$(vIdx)), ""

                        ' Also free the dynamically allocated descriptor for the UDT string field
                        ff = tiraWalkUdtDynamicStrings(basePtr$, uIdx, 1)
                        IF compileError = 1 THEN EXIT SUB
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF

        IF scopeLink = scopeStopLink THEN EXIT DO
        scopeLink = nextScopeLink
      LOOP
    END IF
  END IF

END SUB ' tiraScheduleGC

''''''''''''''''''''''''
SUB tiraScheduleHeapReset

  tiraCheckActive ("tiraScheduleHeapReset")
  IF tiraLineCheck THEN EXIT SUB

  skipSpillLbl$ = tiraLabelCreateNew$("SKIP_SPILL")
  tiraJmpCond "JE", "!G_MEM_PTR_SPILL_HEAD", "0", skipSpillLbl$

  loopTop$ = tiraLabelCreateNew$("SPILL_LOOP")
  tiraLabel loopTop$

  prevPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, prevPtr$ + ", !G_MEM_PTR_SPILL_HEAD"

  tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, !G_MEM_PTR_SPILL_HEAD"

  tiraAssign "!G_MEM_PTR_SPILL_HEAD", prevPtr$
  tiraJmpCond "JNE", "!G_MEM_PTR_SPILL_HEAD", "0", loopTop$

  tiraLabel skipSpillLbl$

  tiraNode(t.LineCount).OpCode = TC_ASSIGN
  tiraSetNodeArg 1, "!G_MEM_PTR_TEMP_HEAP"
  tiraSetNodeArg 2, "!G_MEM_PTR_TEMP_START"

  ' Remove stale data from remainder
  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraScheduleHeapReset

''''''''''''''''''''''''
SUB tiraScheduleHeapResetId

  tiraCheckActive ("tiraScheduleHeapResetId")
  IF tiraLineCheck THEN EXIT SUB

  DIM spillHeadIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM heapFreeIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM tempStartIdx AS LONG
  DIM skipSpillLblIdx AS LONG
  DIM loopTopLblIdx AS LONG
  DIM prevPtrIdx AS LONG

  ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
  spillHeadIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  processHeapIdx = returnedData2

  ff = resolveSymbol("IAT_HEAPFREE")
  heapFreeIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_TEMP_START")
  tempStartIdx = returnedData2

  skipSpillLblIdx = tiraLabelCreateNewId&("SKIP_SPILL")
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 0, skipSpillLblIdx

  loopTopLblIdx = tiraLabelCreateNewId&("SPILL_LOOP")
  tiraLabelId loopTopLblIdx

  prevPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId prevPtrIdx, TIRA_ARG_SYMBOL, spillHeadIdx

  tiraCallId3 heapFreeIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, spillHeadIdx

  tiraAssignId spillHeadIdx, TIRA_ARG_SYMBOL, prevPtrIdx
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 0, loopTopLblIdx

  tiraLabelId skipSpillLblIdx

  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, tempStartIdx

END SUB ' tiraScheduleHeapResetId

''''''''''''''''''''''''
FUNCTION tiraScheduleShuntingOp (opVal AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleShuntingOp")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM resType AS LONG
  DIM opCmd AS LONG
  DIM t1 AS LONG
  DIM t2 AS LONG
  DIM isPow2 AS LONG
  DIM isConstRHS AS LONG
  DIM shiftAmt AS LONG
  DIM valCheck AS LONG
  DIM firstCh AS STRING * 1
  DIM rhsVar$
  DIM lhsVar$
  DIM resVar$
  DIM condStr$
  DIM lblTrue$
  DIM lblEnd$

  tiraCheckActive ("tiraScheduleShuntingOp")

  ' Any operator produces a computed value, so an operand address cannot remain eligible for copy-out
  returnAddrVar = ""

  IF opVal = TOK_OP_UNARY_MINUS OR opVal = TOK_OP_UNARY_NOT THEN
    IF localValTop < 1 THEN
      throwCompilerError "MISSING OPERAND FOR UNARY", ASIS, 0
      tiraScheduleShuntingOp = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    rhsVar$ = shuntVal(localValTop - 1).VarName
    resType = shuntVal(localValTop - 1).DataType

    resVar$ = tiraDimVar$("T", resType)

    IF opVal = TOK_OP_UNARY_MINUS THEN
      tiraOp TC_NEG, resVar$, rhsVar$, ""
    ELSE
      tiraOp TC_NOT, resVar$, rhsVar$, ""
    END IF

    shuntVal(localValTop - 1).VarName = resVar$
    shuntVal(localValTop - 1).DataType = resType
    shuntVal(localValTop - 1).IsComplex = 1
    shuntVal(localValTop - 1).AddrVar = ""

    return2 localValTop
    tiraScheduleShuntingOp = 1
    EXIT FUNCTION
  END IF

  IF localValTop < 2 THEN
    throwCompilerError "MISSING OPERAND FOR BINARY", ASIS, 0
    tiraScheduleShuntingOp = 0
    return2 localValTop
    EXIT FUNCTION
  END IF

  rhsVar$ = shuntVal(localValTop - 1).VarName
  lhsVar$ = shuntVal(localValTop - 2).VarName

  t1 = shuntVal(localValTop - 2).DataType
  t2 = shuntVal(localValTop - 1).DataType

  IF opVal = TOK_OP_EQUAL OR opVal = TOK_OP_LESS OR opVal = TOK_OP_GREATER OR opVal = TOK_OP_LESS_EQUAL OR opVal = TOK_OP_GREATER_EQUAL OR opVal = TOK_OP_NOT_EQUAL THEN
    IF t1 = TYPE_STRING AND t2 <> TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOp = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
    IF t1 <> TYPE_STRING AND t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOp = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    resType = TYPE_LONG
    resVar$ = tiraDimVar$("T", resType)

    condStr$ = "JE"

    SELECT CASE opVal

      CASE TOK_OP_EQUAL: condStr$ = "JE"
      CASE TOK_OP_LESS: condStr$ = "JL"
      CASE TOK_OP_GREATER: condStr$ = "JG"
      CASE TOK_OP_LESS_EQUAL: condStr$ = "JLE"
      CASE TOK_OP_GREATER_EQUAL: condStr$ = "JGE"
      CASE TOK_OP_NOT_EQUAL: condStr$ = "JNE"

    END SELECT ' opVal

    lblTrue$ = tiraLabelCreateNew$("REL_TRUE")
    lblEnd$ = tiraLabelCreateNew$("REL_END")

    tiraAssign resVar$, "0"
    tiraJmpCond condStr$, lhsVar$, rhsVar$, lblTrue$
    tiraJmp lblEnd$

    tiraLabel lblTrue$
    tiraAssign resVar$, "-1"

    tiraLabel lblEnd$

    shuntVal(localValTop - 2).VarName = resVar$
    shuntVal(localValTop - 2).DataType = resType
    shuntVal(localValTop - 2).IsComplex = 1
    shuntVal(localValTop - 2).AddrVar = ""
    localValTop = localValTop - 1

    return2 localValTop
    tiraScheduleShuntingOp = 1
    EXIT FUNCTION
  END IF

  IF t1 = TYPE_STRING AND t2 = TYPE_STRING THEN
    IF opVal = TOK_OP_PLUS THEN
      resType = TYPE_STRING
      opCmd = TC_CONCAT
    ELSE
      throwCompilerError "INVALID STRING OP", ASIS, 0
      tiraScheduleShuntingOp = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
  ELSE
    IF t1 = TYPE_STRING OR t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOp = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    SELECT CASE opVal

      CASE TOK_OP_IDIV
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE TOK_MOD
        resType = TYPE_LONG

      CASE TOK_OP_POW
        resType = TYPE_DOUBLE

      CASE TOK_AND, TOK_OR, TOK_XOR, TOK_NOR, TOK_NAND, TOK_XNOR
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE ELSE
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64
        IF t1 = TYPE_SINGLE OR t2 = TYPE_SINGLE THEN resType = TYPE_SINGLE
        IF t1 = TYPE_DOUBLE OR t2 = TYPE_DOUBLE THEN resType = TYPE_DOUBLE
        IF opVal = TOK_OP_DIV THEN
          IF resType = TYPE_LONG THEN resType = TYPE_SINGLE
          IF resType = TYPE_INTEGER64 OR resType = TYPE_UINT64 THEN resType = TYPE_DOUBLE
        END IF

    END SELECT ' opVal

    SELECT CASE opVal

      CASE TOK_OP_PLUS: opCmd = TC_ADD
      CASE TOK_OP_MINUS: opCmd = TC_SUB
      CASE TOK_OP_MUL: opCmd = TC_MUL
      CASE TOK_OP_DIV: opCmd = TC_DIV
      CASE TOK_OP_IDIV: opCmd = TC_IDIV
      CASE TOK_MOD: opCmd = TC_MOD
      CASE TOK_OP_POW: opCmd = TC_POW
      CASE TOK_AND: opCmd = TC_AND
      CASE TOK_OR: opCmd = TC_OR
      CASE TOK_XOR: opCmd = TC_XOR
      CASE TOK_NOR: opCmd = TC_NOR
      CASE TOK_NAND: opCmd = TC_NAND
      CASE TOK_XNOR: opCmd = TC_XNOR

    END SELECT ' opVal

  END IF

  ' Speed optimization, convert constant power of two multiplication into a bitwise left shift
  IF opCmd = TC_MUL THEN
    ' Do not attempt to bitwise shift float mathematics!
    IF resType <> TYPE_SINGLE AND resType <> TYPE_DOUBLE THEN
      isPow2 = 0
      isConstRHS = 0
      shiftAmt = 0

      ' Try RHS
      firstCh = LEFT$(rhsVar$, 1)
      IF firstCh >= "0" AND firstCh <= "9" THEN
        valCheck = VAL(rhsVar$)

        SELECT CASE valCheck

          CASE 2: shiftAmt = 1: isPow2 = 1: isConstRHS = 1
          CASE 4: shiftAmt = 2: isPow2 = 1: isConstRHS = 1
          CASE 8: shiftAmt = 3: isPow2 = 1: isConstRHS = 1
          CASE 16: shiftAmt = 4: isPow2 = 1: isConstRHS = 1
          CASE 32: shiftAmt = 5: isPow2 = 1: isConstRHS = 1
          CASE 64: shiftAmt = 6: isPow2 = 1: isConstRHS = 1
          CASE 128: shiftAmt = 7: isPow2 = 1: isConstRHS = 1
          CASE 256: shiftAmt = 8: isPow2 = 1: isConstRHS = 1
          CASE 512: shiftAmt = 9: isPow2 = 1: isConstRHS = 1
          CASE 1024: shiftAmt = 10: isPow2 = 1: isConstRHS = 1
          CASE 2048: shiftAmt = 11: isPow2 = 1: isConstRHS = 1
          CASE 4096: shiftAmt = 12: isPow2 = 1: isConstRHS = 1

        END SELECT ' valCheck

      END IF

      ' Check LHS if the RHS operand was not a constant power of two
      IF isPow2 = 0 THEN
        firstCh = LEFT$(lhsVar$, 1)
        IF firstCh >= "0" AND firstCh <= "9" THEN
          valCheck = VAL(lhsVar$)

          SELECT CASE valCheck

            CASE 2: shiftAmt = 1: isPow2 = 1
            CASE 4: shiftAmt = 2: isPow2 = 1
            CASE 8: shiftAmt = 3: isPow2 = 1
            CASE 16: shiftAmt = 4: isPow2 = 1
            CASE 32: shiftAmt = 5: isPow2 = 1
            CASE 64: shiftAmt = 6: isPow2 = 1
            CASE 128: shiftAmt = 7: isPow2 = 1
            CASE 256: shiftAmt = 8: isPow2 = 1
            CASE 512: shiftAmt = 9: isPow2 = 1
            CASE 1024: shiftAmt = 10: isPow2 = 1
            CASE 2048: shiftAmt = 11: isPow2 = 1
            CASE 4096: shiftAmt = 12: isPow2 = 1

          END SELECT ' valCheck

        END IF
      END IF

      IF isPow2 = 1 THEN
        opCmd = TC_SHL
        IF isConstRHS = 1 THEN
          rhsVar$ = LTRIM$(STR$(shiftAmt))
        ELSE
          ' Swap so the variable is on the left
          lhsVar$ = rhsVar$
          rhsVar$ = LTRIM$(STR$(shiftAmt))
        END IF
      END IF
    END IF
  END IF

  resVar$ = tiraDimVar$("T", resType)
  tiraOp opCmd, resVar$, lhsVar$, rhsVar$

  shuntVal(localValTop - 2).VarName = resVar$
  shuntVal(localValTop - 2).DataType = resType
  shuntVal(localValTop - 2).IsComplex = 1
  shuntVal(localValTop - 2).AddrVar = ""
  localValTop = localValTop - 1

  return2 localValTop
  tiraScheduleShuntingOp = 1

END FUNCTION ' tiraScheduleShuntingOp

''''''''''''''''''''''''
FUNCTION tiraScheduleShuntingOpId (opVal AS LONG, rsPassValTop AS LONG)

  tiraCheckActive ("tiraScheduleShuntingOpId")

  returnExtraPrepare

  DIM localValTop AS LONG
  localValTop = rsPassValTop

  DIM resType AS LONG
  DIM opCmd AS LONG
  DIM t1 AS LONG
  DIM t2 AS LONG
  DIM isPow2 AS LONG
  DIM isConstRHS AS LONG
  DIM shiftAmt AS LONG
  DIM valCheck AS _INTEGER64
  DIM rhsType AS LONG
  DIM rhsVal AS _INTEGER64
  DIM lhsType AS LONG
  DIM lhsVal AS _INTEGER64
  DIM resVarIdx AS LONG
  DIM condConst AS LONG
  DIM lblTrueIdx AS LONG
  DIM lblEndIdx AS LONG

  tiraCheckActive ("tiraScheduleShuntingOpId")

  ' Any operator produces a computed value, so an operand address cannot remain eligible for copy-out
  returnAddrVar = ""

  IF opVal = TOK_OP_UNARY_MINUS OR opVal = TOK_OP_UNARY_NOT THEN
    IF localValTop < 1 THEN
      throwCompilerError "MISSING OPERAND FOR UNARY", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    rhsType = shuntVal(localValTop - 1).ArgType
    rhsVal = shuntVal(localValTop - 1).ArgVal
    resType = shuntVal(localValTop - 1).DataType

    resVarIdx = tiraDimVarId&("T", resType)

    IF opVal = TOK_OP_UNARY_MINUS THEN
      tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, rhsType, rhsVal
    ELSE
      tiraOpId2 TC_NOT, TIRA_ARG_SYMBOL, resVarIdx, rhsType, rhsVal
    END IF

    shuntVal(localValTop - 1).VarName = ""
    shuntVal(localValTop - 1).ArgType = TIRA_ARG_SYMBOL
    shuntVal(localValTop - 1).ArgVal = resVarIdx
    shuntVal(localValTop - 1).DataType = resType
    shuntVal(localValTop - 1).IsComplex = 1
    shuntVal(localValTop - 1).AddrVar = ""
    shuntVal(localValTop - 1).AddrType = TIRA_ARG_EMPTY
    shuntVal(localValTop - 1).AddrVal = 0

    return2 localValTop
    tiraScheduleShuntingOpId = 1
    EXIT FUNCTION
  END IF

  IF localValTop < 2 THEN
    throwCompilerError "MISSING OPERAND FOR BINARY", ASIS, 0
    tiraScheduleShuntingOpId = 0
    return2 localValTop
    EXIT FUNCTION
  END IF

  rhsType = shuntVal(localValTop - 1).ArgType
  rhsVal = shuntVal(localValTop - 1).ArgVal
  lhsType = shuntVal(localValTop - 2).ArgType
  lhsVal = shuntVal(localValTop - 2).ArgVal

  t1 = shuntVal(localValTop - 2).DataType
  t2 = shuntVal(localValTop - 1).DataType

  IF opVal = TOK_OP_EQUAL OR opVal = TOK_OP_LESS OR opVal = TOK_OP_GREATER OR opVal = TOK_OP_LESS_EQUAL OR opVal = TOK_OP_GREATER_EQUAL OR opVal = TOK_OP_NOT_EQUAL THEN
    IF t1 = TYPE_STRING AND t2 <> TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
    IF t1 <> TYPE_STRING AND t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    resType = TYPE_LONG
    resVarIdx = tiraDimVarId&("T", resType)

    condConst = JCC_JE

    SELECT CASE opVal

      CASE TOK_OP_EQUAL: condConst = JCC_JE
      CASE TOK_OP_LESS: condConst = JCC_JL
      CASE TOK_OP_GREATER: condConst = JCC_JG
      CASE TOK_OP_LESS_EQUAL: condConst = JCC_JLE
      CASE TOK_OP_GREATER_EQUAL: condConst = JCC_JGE
      CASE TOK_OP_NOT_EQUAL: condConst = JCC_JNE

    END SELECT ' opVal

    lblTrueIdx = tiraLabelCreateNewId&("REL_TRUE")
    lblEndIdx = tiraLabelCreateNewId&("REL_END")

    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0
    tiraJmpCondId condConst, lhsType, lhsVal, rhsType, rhsVal, lblTrueIdx
    tiraJmpId lblEndIdx

    tiraLabelId lblTrueIdx
    tiraAssignId resVarIdx, TIRA_ARG_LITERAL, -1

    tiraLabelId lblEndIdx

    shuntVal(localValTop - 2).VarName = ""
    shuntVal(localValTop - 2).ArgType = TIRA_ARG_SYMBOL
    shuntVal(localValTop - 2).ArgVal = resVarIdx
    shuntVal(localValTop - 2).DataType = resType
    shuntVal(localValTop - 2).IsComplex = 1
    shuntVal(localValTop - 2).AddrVar = ""
    shuntVal(localValTop - 2).AddrType = TIRA_ARG_EMPTY
    shuntVal(localValTop - 2).AddrVal = 0
    localValTop = localValTop - 1

    return2 localValTop
    tiraScheduleShuntingOpId = 1
    EXIT FUNCTION
  END IF

  IF t1 = TYPE_STRING AND t2 = TYPE_STRING THEN
    IF opVal = TOK_OP_PLUS THEN
      resType = TYPE_STRING
      opCmd = TC_CONCAT
    ELSE
      throwCompilerError "INVALID STRING OP", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF
  ELSE
    IF t1 = TYPE_STRING OR t2 = TYPE_STRING THEN
      throwCompilerError "TYPE MISMATCH", ASIS, 0
      tiraScheduleShuntingOpId = 0
      return2 localValTop
      EXIT FUNCTION
    END IF

    SELECT CASE opVal

      CASE TOK_OP_IDIV
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE TOK_MOD
        resType = TYPE_LONG

      CASE TOK_OP_POW
        resType = TYPE_DOUBLE

      CASE TOK_AND, TOK_OR, TOK_XOR, TOK_NOR, TOK_NAND, TOK_XNOR
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64

      CASE ELSE
        resType = TYPE_LONG
        IF t1 = TYPE_INTEGER64 OR t2 = TYPE_INTEGER64 THEN resType = TYPE_INTEGER64
        IF t1 = TYPE_UINT64 OR t2 = TYPE_UINT64 THEN resType = TYPE_UINT64
        IF t1 = TYPE_SINGLE OR t2 = TYPE_SINGLE THEN resType = TYPE_SINGLE
        IF t1 = TYPE_DOUBLE OR t2 = TYPE_DOUBLE THEN resType = TYPE_DOUBLE
        IF opVal = TOK_OP_DIV THEN
          IF resType = TYPE_LONG THEN resType = TYPE_SINGLE
          IF resType = TYPE_INTEGER64 OR resType = TYPE_UINT64 THEN resType = TYPE_DOUBLE
        END IF

    END SELECT ' opVal

    SELECT CASE opVal

      CASE TOK_OP_PLUS: opCmd = TC_ADD
      CASE TOK_OP_MINUS: opCmd = TC_SUB
      CASE TOK_OP_MUL: opCmd = TC_MUL
      CASE TOK_OP_DIV: opCmd = TC_DIV
      CASE TOK_OP_IDIV: opCmd = TC_IDIV
      CASE TOK_MOD: opCmd = TC_MOD
      CASE TOK_OP_POW: opCmd = TC_POW
      CASE TOK_AND: opCmd = TC_AND
      CASE TOK_OR: opCmd = TC_OR
      CASE TOK_XOR: opCmd = TC_XOR
      CASE TOK_NOR: opCmd = TC_NOR
      CASE TOK_NAND: opCmd = TC_NAND
      CASE TOK_XNOR: opCmd = TC_XNOR

    END SELECT ' opVal

  END IF

  ' Speed optimization, convert constant power of two multiplication into a bitwise left shift
  IF opCmd = TC_MUL THEN
    ' Do not attempt to bitwise shift float mathematics!
    IF resType <> TYPE_SINGLE AND resType <> TYPE_DOUBLE THEN
      isPow2 = 0
      isConstRHS = 0
      shiftAmt = 0

      ' Try RHS
      IF rhsType = TIRA_ARG_LITERAL THEN
        valCheck = rhsVal

        SELECT CASE valCheck

          CASE 2: shiftAmt = 1: isPow2 = 1: isConstRHS = 1
          CASE 4: shiftAmt = 2: isPow2 = 1: isConstRHS = 1
          CASE 8: shiftAmt = 3: isPow2 = 1: isConstRHS = 1
          CASE 16: shiftAmt = 4: isPow2 = 1: isConstRHS = 1
          CASE 32: shiftAmt = 5: isPow2 = 1: isConstRHS = 1
          CASE 64: shiftAmt = 6: isPow2 = 1: isConstRHS = 1
          CASE 128: shiftAmt = 7: isPow2 = 1: isConstRHS = 1
          CASE 256: shiftAmt = 8: isPow2 = 1: isConstRHS = 1
          CASE 512: shiftAmt = 9: isPow2 = 1: isConstRHS = 1
          CASE 1024: shiftAmt = 10: isPow2 = 1: isConstRHS = 1
          CASE 2048: shiftAmt = 11: isPow2 = 1: isConstRHS = 1
          CASE 4096: shiftAmt = 12: isPow2 = 1: isConstRHS = 1

        END SELECT ' valCheck

      END IF

      ' Check LHS if the RHS operand was not a constant power of two
      IF isPow2 = 0 THEN
        IF lhsType = TIRA_ARG_LITERAL THEN
          valCheck = lhsVal

          SELECT CASE valCheck

            CASE 2: shiftAmt = 1: isPow2 = 1
            CASE 4: shiftAmt = 2: isPow2 = 1
            CASE 8: shiftAmt = 3: isPow2 = 1
            CASE 16: shiftAmt = 4: isPow2 = 1
            CASE 32: shiftAmt = 5: isPow2 = 1
            CASE 64: shiftAmt = 6: isPow2 = 1
            CASE 128: shiftAmt = 7: isPow2 = 1
            CASE 256: shiftAmt = 8: isPow2 = 1
            CASE 512: shiftAmt = 9: isPow2 = 1
            CASE 1024: shiftAmt = 10: isPow2 = 1
            CASE 2048: shiftAmt = 11: isPow2 = 1
            CASE 4096: shiftAmt = 12: isPow2 = 1

          END SELECT ' valCheck

        END IF
      END IF

      IF isPow2 = 1 THEN
        opCmd = TC_SHL
        IF isConstRHS = 1 THEN
          rhsType = TIRA_ARG_LITERAL
          rhsVal = shiftAmt
        ELSE
          ' Swap so the variable is on the left
          lhsType = rhsType
          lhsVal = rhsVal
          rhsType = TIRA_ARG_LITERAL
          rhsVal = shiftAmt
        END IF
      END IF
    END IF
  END IF

  resVarIdx = tiraDimVarId&("T", resType)
  tiraOpId3 opCmd, TIRA_ARG_SYMBOL, resVarIdx, lhsType, lhsVal, rhsType, rhsVal

  shuntVal(localValTop - 2).VarName = ""
  shuntVal(localValTop - 2).ArgType = TIRA_ARG_SYMBOL
  shuntVal(localValTop - 2).ArgVal = resVarIdx
  shuntVal(localValTop - 2).DataType = resType
  shuntVal(localValTop - 2).IsComplex = 1
  shuntVal(localValTop - 2).AddrVar = ""
  shuntVal(localValTop - 2).AddrType = TIRA_ARG_EMPTY
  shuntVal(localValTop - 2).AddrVal = 0
  localValTop = localValTop - 1

  return2 localValTop
  tiraScheduleShuntingOpId = 1

END FUNCTION ' tiraScheduleShuntingOpId

''''''''''''''''''''''''
SUB tiraScheduleSubEpilogue

  tiraCheckActive ("tiraScheduleSubEpilogue")

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM totalFrame AS LONG
  DIM expectedStackOffset AS LONG
  DIM msg1$
  DIM msg2$
  DIM retVarIdx AS LONG
  DIM targetType AS LONG
  DIM targetVarName$
  DIM safeDescPtr$
  DIM safeDescPtrIdx AS LONG
  DIM localDescAddr$
  DIM strLen$
  DIM strData$
  DIM safeDataPtr$
  DIM flagVal$
  DIM flagPtr$
  DIM skipFreeLbl$

  totalFrame = stack.consoleFrameSize
  subIdx = 0

  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        totalFrame = totalFrame + subs(subIdx).LocalFrameSize
      END IF
    END IF
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    expectedStackOffset = totalFrame + PE_STACK_FRAME_OVERHEAD

    IF stack.currentStackOffset <> expectedStackOffset THEN
      msg1$ = "FATAL: Lost routine frame before epilogue Actual=" + LTRIM$(STR$(stack.currentStackOffset)) + " Expected=" + LTRIM$(STR$(expectedStackOffset))
      msg2$ = "Routine=" + currentSubName$ + " Local=" + LTRIM$(STR$(subs(subIdx).LocalFrameSize)) + " Console=" + LTRIM$(STR$(stack.consoleFrameSize))
      ESCAPETEXT2 msg1$, msg2$
    END IF
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    heapSaveName$ = "!T_PTR_HEAPSAVE_" + LTRIM$(STR$(subIdx))
    tiraAssign "!G_MEM_PTR_TEMP_HEAP", "!G_MEM_PTR_TEMP_START"
    tiraAssign "!G_MEM_PTR_TEMP_START", heapSaveName$

    spillSaveName$ = "!T_PTR_SPILLSAVE_" + LTRIM$(STR$(subIdx))
    tiraAssign "!G_MEM_PTR_SPILL_HEAD", spillSaveName$
  END IF

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    IF subs(subIdx).IsFunction = 1 THEN
      retVarIdx = subs(subIdx).ReturnVarIdx
      IF retVarIdx <> 0 THEN
        targetType = symbols(retVarIdx).DataType
        targetVarName$ = "#" + LTRIM$(STR$(retVarIdx))

        IF targetType = TYPE_STRING THEN
          localDescAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADDRESS_OF, localDescAddr$, targetVarName$, ""

          strLen$ = tiraGetStringLen$(localDescAddr$)
          strData$ = tiraGetStringData$(localDescAddr$)

          safeDataPtr$ = tiraAllocTempMem$(strLen$)
          tiraMemcpy safeDataPtr$, strData$, strLen$

          flagVal$ = tiraDimVar$("T", TYPE_LONG)
          flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, flagPtr$, localDescAddr$, "16"
          tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

          skipFreeLbl$ = tiraLabelCreateNew$("EPI_SKIP_FREE")
          tiraJmpCond "JNE", flagVal$, "1", skipFreeLbl$
          tiraJmpCond "JE", strData$, "0", skipFreeLbl$
          tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + strData$
          tiraLabel skipFreeLbl$

          safeDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          safeDescPtrIdx = returnedData2
          tiraAssign safeDescPtr$, "!G_MEM_PTR_TEMP_HEAP"
          tiraOp TC_SUB, safeDescPtr$, safeDescPtr$, "24"
          tiraAssign "!G_MEM_PTR_TEMP_HEAP", safeDescPtr$

          tiraBuildStrDesc safeDescPtr$, safeDataPtr$, strLen$, "0"

          tiraAbiWriteRetId safeDescPtrIdx
        ELSE
          tiraAbiWriteRetId retVarIdx
        END IF
      END IF
    END IF
  END IF

  tiraNew TC_LEAVE_FRAME, LTRIM$(RTRIM$(STR$(totalFrame)))

END SUB ' tiraScheduleSubEpilogue

''''''''''''''''''''''''
SUB tiraScheduleSubPrologue

  tiraCheckActive ("tiraScheduleSubPrologue")

  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM totalFrame AS LONG
  DIM iSym AS LONG
  DIM safeSymbolLimit AS LONG
  DIM scopeLink AS LONG
  DIM nextScopeLink AS LONG
  DIM scopeStopLink AS LONG
  DIM fixedLen AS LONG
  DIM argIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM targetType AS LONG
  DIM retVarIdx AS LONG

  totalFrame = stack.consoleFrameSize
  subIdx = 0

  IF currentSubName$ <> "" THEN
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        subs(subIdx).ExitPatchList = 0 ' Initialize the Exit Patch List

        heapSaveName$ = "!T_PTR_HEAPSAVE_" + LTRIM$(STR$(subIdx))
        ff = resolveSymbol(heapSaveName$)
        IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_INTEGER64

        spillSaveName$ = "!T_PTR_SPILLSAVE_" + LTRIM$(STR$(subIdx))
        ff = resolveSymbol(spillSaveName$)
        IF ff = 1 THEN symbols(returnedData2).DataType = TYPE_INTEGER64

        totalFrame = totalFrame + subs(subIdx).LocalFrameSize
      END IF
    END IF
  END IF

  framePtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_ENTER_FRAME, LTRIM$(RTRIM$(STR$(totalFrame))) + ", " + framePtr$

  ' Zero out the local stack frame to prevent garbage data from causing issues
  tiraMemSet framePtr$, "0", LTRIM$(RTRIM$(STR$(totalFrame)))

  tiraInitClassicImplicitArrays currentScopeID
  IF compileError = 1 THEN EXIT SUB

  IF currentSubName$ <> "" AND subIdx <> 0 THEN
    heapSaveName$ = "!T_PTR_HEAPSAVE_" + LTRIM$(STR$(subIdx))
    tiraAssign heapSaveName$, "!G_MEM_PTR_TEMP_START"
    tiraAssign "!G_MEM_PTR_TEMP_START", "!G_MEM_PTR_TEMP_HEAP"

    spillSaveName$ = "!T_PTR_SPILLSAVE_" + LTRIM$(STR$(subIdx))
    tiraAssign spillSaveName$, "!G_MEM_PTR_SPILL_HEAD"
    tiraAssign "!G_MEM_PTR_SPILL_HEAD", "0"

    ' Zero out the invocation-local return variable at the start of the function
    ' This prevents persistent state leakage between calls
    ff = findSubIndex(currentSubName$)
    IF ff = 1 THEN
      subIdx = returnedData2
      IF subIdx <> 0 THEN
        IF subs(subIdx).IsFunction = 1 THEN
          retVarIdx = subs(subIdx).ReturnVarIdx
          IF retVarIdx <> 0 THEN
            IF symbols(retVarIdx).DataType = TYPE_STRING THEN
              tiraAssign "#" + LTRIM$(STR$(retVarIdx)), "!G_SYS_DSC_EMPTY"
            ELSE
              tiraAssign "#" + LTRIM$(STR$(retVarIdx)), "0"
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Initialize descriptors and buffers for local fixed-length strings
    IF symbolCount > 0 THEN
      syncSymbolScopeIndex
      safeSymbolLimit = symbolCount

      IF currentScopeID >= 0 AND currentScopeID <= MAX_SUBS THEN
        scopeLink = scopeSymbolHead(currentScopeID)
        scopeStopLink = scopeSymbolTail(currentScopeID)

        DO WHILE scopeLink > 0
          iSym = scopeLink - 1
          nextScopeLink = scopeSymbolNext(iSym)

          IF iSym < safeSymbolLimit THEN
            IF symbols(iSym).ScopeID = currentScopeID AND symbols(iSym).IsLocal = LOCAL_STANDARD AND symbols(iSym).IsShared = 0 THEN
              IF symbols(iSym).DataType = TYPE_STRING AND symbols(iSym).IsArray = 0 THEN
                fixedLen = retFixeSTRINGDLength(iSym)
                IF fixedLen > 0 THEN
                  descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                  tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(iSym)), ""

                  dataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                  tiraOp TC_ADD, dataAddr$, descAddr$, "24"

                  tiraMemSet dataAddr$, "32", LTRIM$(STR$(fixedLen))

                  tiraBuildStrDesc descAddr$, dataAddr$, LTRIM$(STR$(fixedLen)), "0"
                END IF
              END IF
            END IF
          END IF

          IF scopeLink = scopeStopLink THEN EXIT DO
          scopeLink = nextScopeLink
        LOOP
      END IF
    END IF

    ' Copy the call-boundary staging values into this invocation's local parameter slots
    IF subIdx <> 0 THEN
      IF subs(subIdx).ArgCount > 0 THEN
        FOR argIdx = 0 TO subs(subIdx).ArgCount - 1
          formalVarIdx = subArgVarIdx(subIdx, argIdx)
          stageVarIdx = retSubArgStageVarIdx(subIdx, argIdx)
          IF stageVarIdx = 0 OR compileError = 1 THEN EXIT SUB

          targetType = symbols(formalVarIdx).DataType
          formalName$ = "#" + LTRIM$(STR$(formalVarIdx))
          stageName$ = "#" + LTRIM$(STR$(stageVarIdx))

          IF symbols(formalVarIdx).IsArray = 2 THEN
            formalAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADDRESS_OF, formalAddr$, formalName$, ""

            stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

            descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + stageAddr$ + ", 12"

            descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
            tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
            tiraFatalError "INVALID STAGED ARRAY DESCRIPTOR"
            tiraLabel descriptorDimLowReady$

            descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
            tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
            tiraFatalError "STAGED ARRAY DESCRIPTOR DIMENSION LIMIT"
            tiraLabel descriptorDimHighReady$

            IF symbols(formalVarIdx).NumDimensions > 0 THEN
              descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
              tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
              tiraFatalError "STAGED ARRAY DIMENSION MISMATCH"
              tiraLabel descriptorDimMatchReady$
            END IF

            descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
            tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
            tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

            tiraMemcpy formalAddr$, stageAddr$, descriptorByteSize$
          ELSE
            IF targetType = TYPE_UDT THEN
              formalAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraOp TC_ADDRESS_OF, formalAddr$, formalName$, ""

              stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
              tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

              tiraCopyUdtValue formalAddr$, stageAddr$, symbols(formalVarIdx).UDTIndex
            ELSE
              IF targetType = TYPE_STRING THEN
                tiraCall "RT_STR_ASSIGN", 2, formalName$ + ", " + stageName$
              ELSE
                tiraAssign formalName$, stageName$
              END IF
            END IF
          END IF
        NEXT
      END IF
    END IF
  END IF

END SUB ' tiraScheduleSubPrologue

''''''''''''''''''''''''
SUB tiraSeekFilePosition (handleVar$, fileModeVar$, recordLenVar$, positionVar$)

  tiraCheckActive ("tiraSeekFilePosition")
  IF tiraLineCheck THEN EXIT SUB

  DIM position64$
  DIM positionValidLbl$
  DIM seekOffset$
  DIM randomModeLbl$
  DIM seekReadyLbl$
  DIM recordLenValidLbl$
  DIM recordLen64$
  DIM recordIndex64$
  DIM seekOffsetNonNegativeLbl$
  DIM seekOffsetCheck$
  DIM seekOffsetValidLbl$
  DIM seekHigh64$
  DIM seekHigh$
  DIM seekHighPtr$
  DIM seekLow$

  position64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_CAST, position64$, positionVar$, LTRIM$(STR$(TYPE_INTEGER64))

  positionValidLbl$ = tiraLabelCreateNew$("FILE_POSITION_VALID")
  tiraJmpCond "JG", position64$, "0", positionValidLbl$
  tiraFatalError "INVALID FILE POSITION"
  tiraLabel positionValidLbl$

  seekOffset$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_SUB, seekOffset$, position64$, "1"

  randomModeLbl$ = tiraLabelCreateNew$("FILE_SEEK_RANDOM")
  seekReadyLbl$ = tiraLabelCreateNew$("FILE_SEEK_READY")

  tiraJmpCond "JE", fileModeVar$, LTRIM$(STR$(FS_MODE_RANDOM)), randomModeLbl$
  tiraJmpCond "JE", fileModeVar$, LTRIM$(STR$(FS_MODE_BINARY)), seekReadyLbl$
  tiraFatalError "BAD FILE MODE"

  tiraLabel randomModeLbl$

  recordLenValidLbl$ = tiraLabelCreateNew$("FILE_RECORD_LENGTH_VALID")
  tiraJmpCond "JG", recordLenVar$, "0", recordLenValidLbl$
  tiraFatalError "INVALID RECORD LENGTH"
  tiraLabel recordLenValidLbl$

  recordLen64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_CAST, recordLen64$, recordLenVar$, LTRIM$(STR$(TYPE_INTEGER64))

  recordIndex64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign recordIndex64$, seekOffset$

  tiraOp TC_MUL, seekOffset$, recordIndex64$, recordLen64$

  seekOffsetNonNegativeLbl$ = tiraLabelCreateNew$("FILE_OFFSET_NONNEGATIVE")
  tiraJmpCond "JGE", seekOffset$, "0", seekOffsetNonNegativeLbl$
  tiraFatalError "FILE POSITION TOO LARGE"
  tiraLabel seekOffsetNonNegativeLbl$

  seekOffsetValidLbl$ = tiraLabelCreateNew$("FILE_OFFSET_VALID")
  tiraJmpCond "JE", recordIndex64$, "0", seekOffsetValidLbl$

  seekOffsetCheck$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_IDIV, seekOffsetCheck$, seekOffset$, recordLen64$
  tiraJmpCond "JE", seekOffsetCheck$, recordIndex64$, seekOffsetValidLbl$
  tiraFatalError "FILE POSITION TOO LARGE"

  tiraLabel seekOffsetValidLbl$
  tiraLabel seekReadyLbl$

  seekHigh64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign seekHigh64$, seekOffset$
  tiraOp TC_SHR, seekHigh64$, seekHigh64$, "32"

  seekHigh$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_CAST, seekHigh$, seekHigh64$, LTRIM$(STR$(TYPE_LONG))

  seekHighPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, seekHighPtr$, seekHigh$, ""

  seekLow$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_CAST, seekLow$, seekOffset$, LTRIM$(STR$(TYPE_LONG))

  tiraCall "IAT_SETFILEPOINTER", 4, handleVar$ + ", " + seekLow$ + ", " + seekHighPtr$ + ", 0"

END SUB ' tiraSeekFilePosition

