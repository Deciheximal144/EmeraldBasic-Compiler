''''''''''''''''''''''''
SUB tiraBuildStylePlot (x$, y$)

  tiraCheckActive ("tiraBuildStylePlot")

  styleBit$ = tiraDimVar$("T", TYPE_LONG)
  styleHigh$ = tiraDimVar$("T", TYPE_LONG)
  styleLow$ = tiraDimVar$("T", TYPE_LONG)

  lblSkipPlot$ = tiraLabelCreateNew$("SKIP_PLOT")

  tiraOp TC_AND, styleBit$, "!G_GFX_VAL_STYLE", "32768"
  tiraJmpCond "JE", styleBit$, "0", lblSkipPlot$

  tiraCall "RT_PLOT_PIXEL", 3, x$ + ", " + y$ + ", !G_GFX_VAL_COLOR"

  tiraLabel lblSkipPlot$

  ' Emulate a 16-bit ROL command purely using native TIRA bitwise shift commands
  tiraOp TC_SHL, styleHigh$, "!G_GFX_VAL_STYLE", "1"
  tiraOp TC_AND, styleHigh$, styleHigh$, "65535"
  tiraOp TC_SHR, styleLow$, "!G_GFX_VAL_STYLE", "15"
  tiraOp TC_AND, styleLow$, styleLow$, "1"
  tiraOp TC_OR, "!G_GFX_VAL_STYLE", styleHigh$, styleLow$

END SUB ' tiraBuildStylePlot

''''''''''''''''''''''''
SUB tiraBuildStylePlotId (xType AS LONG, xVal AS _INTEGER64, yType AS LONG, yVal AS _INTEGER64, styleVal AS LONG, colorVal AS LONG, plotFuncVal AS LONG)

  tiraCheckActive ("tiraBuildStylePlotId")

  DIM styleBitIdx AS LONG
  DIM styleHighIdx AS LONG
  DIM styleLowIdx AS LONG
  DIM lblSkipPlotIdx AS LONG

  styleBitIdx = tiraDimVarId&("T", TYPE_LONG)
  styleHighIdx = tiraDimVarId&("T", TYPE_LONG)
  styleLowIdx = tiraDimVarId&("T", TYPE_LONG)

  lblSkipPlotIdx = tiraLabelCreateNewId&("SKIP_PLOT")

  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, styleBitIdx, TIRA_ARG_SYMBOL, styleVal, TIRA_ARG_LITERAL, 32768
  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, styleBitIdx, TIRA_ARG_LITERAL, 0, lblSkipPlotIdx

  tiraCallId3 plotFuncVal, xType, xVal, yType, yVal, TIRA_ARG_SYMBOL, colorVal

  tiraLabelId lblSkipPlotIdx

  ' Emulate a 16-bit ROL command purely using native TIRA bitwise shift commands
  tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, styleHighIdx, TIRA_ARG_SYMBOL, styleVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, styleHighIdx, TIRA_ARG_SYMBOL, styleHighIdx, TIRA_ARG_LITERAL, 65535
  tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, styleLowIdx, TIRA_ARG_SYMBOL, styleVal, TIRA_ARG_LITERAL, 15
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, styleLowIdx, TIRA_ARG_SYMBOL, styleLowIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, styleVal, TIRA_ARG_SYMBOL, styleHighIdx, TIRA_ARG_SYMBOL, styleLowIdx

END SUB ' tiraBuildStylePlotId

''''''''''''''''''''''''
SUB tiraCall (funcName$, argCount AS LONG, argList$)

  tiraCheckActive ("tiraCall")
  IF tiraLineCheck THEN EXIT SUB

  tiraNode(t.LineCount).OpCode = TC_CALL

  tiraSetNodeArg 1, funcName$
  tiraSetNodeArg 2, LTRIM$(STR$(argCount))

  ' Remove stale data from remainder
  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  DIM aCount AS LONG
  DIM inQuotes AS LONG
  DIM aLen AS LONG
  DIM currArg$
  DIM ch$

  IF argCount > 0 THEN
    aCount = 0
    ix = 1
    aLen = LEN(argList$)
    currArg$ = ""
    inQuotes = 0

    DO WHILE ix <= aLen
      ch$ = MID$(argList$, ix, 1)

      IF ch$ = CHR$(34) THEN
        inQuotes = 1 - inQuotes
      END IF

      IF ch$ = "," AND inQuotes = 0 THEN
        IF aCount < 16 THEN
          tiraParseArgToNode LTRIM$(RTRIM$(currArg$))
          tiraCallArg(t.LineCount, aCount).ArgType = tiraParsedArgType
          tiraCallArg(t.LineCount, aCount).ArgVal = tiraParsedArgVal
        END IF
        aCount = aCount + 1
        currArg$ = ""
      ELSE
        currArg$ = currArg$ + ch$
      END IF
      ix = ix + 1
    LOOP

    IF currArg$ <> "" THEN
      IF aCount < 16 THEN
        tiraParseArgToNode LTRIM$(RTRIM$(currArg$))
        tiraCallArg(t.LineCount, aCount).ArgType = tiraParsedArgType
        tiraCallArg(t.LineCount, aCount).ArgVal = tiraParsedArgVal
      END IF
      aCount = aCount + 1
    END IF
  END IF

  t.LineCount = t.LineCount + 1

END SUB ' tiraCall

