''''''''''''''''''''''''
FUNCTION retStaticArrayLayoutStart (vIdx AS LONG, numDimensions AS LONG)

  DIM layoutStart AS LONG

  layoutStart = 0

  IF vIdx >= 0 AND vIdx < symbolCount THEN
    IF numDimensions > 0 AND numDimensions <= 255 THEN
      layoutStart = staticArrayLayoutStart(vIdx)

      IF layoutStart = 0 THEN
        IF staticArrayDimensionCount <= MAX_CACHED_ARRAY_DIMENSIONS - numDimensions THEN
          layoutStart = staticArrayDimensionCount + 1
          staticArrayDimensionCount = staticArrayDimensionCount + numDimensions
          staticArrayLayoutStart(vIdx) = layoutStart
        END IF
      END IF
    END IF
  END IF

  retStaticArrayLayoutStart = layoutStart

END FUNCTION ' retStaticArrayLayoutStart

''''''''''''''''''''''''
FUNCTION retSubArgAddrStageVarIdx (subIdx, argIdx)

  returnExtraPrepare

  DIM stageVarIdx AS LONG
  DIM savedScopeID AS LONG
  DIM stageName$

  retSubArgAddrStageVarIdx = 0

  IF subIdx <= 0 OR subIdx >= subCount THEN
    throwCompilerError "INVALID SUB INDEX FOR ARGUMENT ADDRESS STAGE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF argIdx < 0 OR argIdx >= subs(subIdx).ArgCount THEN
    throwCompilerError "INVALID ARG INDEX FOR ARGUMENT ADDRESS STAGE", ASIS, 0
    EXIT FUNCTION
  END IF

  stageName$ = "!C_OTH_PTR_ARGADDR_" + LTRIM$(STR$(subIdx)) + "_" + LTRIM$(STR$(argIdx))

  savedScopeID = currentScopeID
  currentScopeID = 0
  ff = resolveSymbol(stageName$)
  currentScopeID = savedScopeID
  IF ff = 0 THEN EXIT FUNCTION
  stageVarIdx = returnedData2

  symbols(stageVarIdx).DataType = TYPE_INTEGER64
  symbols(stageVarIdx).ScopeID = 0
  symbols(stageVarIdx).IsShared = 0
  symbols(stageVarIdx).IsArray = 0
  symbols(stageVarIdx).Size = 1
  symbols(stageVarIdx).NumDimensions = 0
  symbols(stageVarIdx).UDTIndex = -1
  symbols(stageVarIdx).IsExplicit = DECL_EXPLICIT
  symbols(stageVarIdx).IsLocal = LOCAL_GLOBAL
  symbols(stageVarIdx).FixedStrLen = 0

  retSubArgAddrStageVarIdx = stageVarIdx

END FUNCTION ' retSubArgAddrStageVarIdx

''''''''''''''''''''''''
FUNCTION retSubArgStageVarIdx (subIdx, argIdx)

  returnExtraPrepare

  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM savedScopeID AS LONG
  DIM targetType AS LONG
  DIM roleName$
  DIM stageName$

  retSubArgStageVarIdx = 0

  IF subIdx <= 0 OR subIdx >= subCount THEN
    throwCompilerError "INVALID SUB INDEX FOR ARGUMENT STAGE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF argIdx < 0 OR argIdx >= subs(subIdx).ArgCount THEN
    throwCompilerError "INVALID ARG INDEX FOR ARGUMENT STAGE", ASIS, 0
    EXIT FUNCTION
  END IF

  formalVarIdx = subArgVarIdx(subIdx, argIdx)
  targetType = symbols(formalVarIdx).DataType

  roleName$ = "VAL_"
  IF symbols(formalVarIdx).IsArray = 2 THEN
    roleName$ = "ARR_"
  ELSE
    IF targetType = TYPE_STRING THEN
      roleName$ = "DSC_"
    ELSE
      IF targetType = TYPE_UDT THEN roleName$ = "UDT_"
    END IF
  END IF

  stageName$ = "!C_OTH_" + roleName$ + "ARGSTAGE_" + LTRIM$(STR$(subIdx)) + "_" + LTRIM$(STR$(argIdx))

  savedScopeID = currentScopeID
  currentScopeID = 0
  ff = resolveSymbol(stageName$)
  currentScopeID = savedScopeID
  IF ff = 0 THEN EXIT FUNCTION
  stageVarIdx = returnedData2

  symbols(stageVarIdx).DataType = targetType
  symbols(stageVarIdx).ScopeID = 0
  symbols(stageVarIdx).IsShared = 0
  symbols(stageVarIdx).IsArray = symbols(formalVarIdx).IsArray
  symbols(stageVarIdx).Size = symbols(formalVarIdx).Size
  symbols(stageVarIdx).NumDimensions = symbols(formalVarIdx).NumDimensions
  symbols(stageVarIdx).UDTIndex = symbols(formalVarIdx).UDTIndex
  symbols(stageVarIdx).IsExplicit = DECL_EXPLICIT
  symbols(stageVarIdx).IsLocal = LOCAL_GLOBAL
  symbols(stageVarIdx).FixedStrLen = 0

  retSubArgStageVarIdx = stageVarIdx

END FUNCTION ' retSubArgStageVarIdx

''''''''''''''''''''''''
FUNCTION retSymbolByteSize&& (vIdx)

  ' Historical note: getSymbolByteSize was apparently made better, this is a compatability wrapper until we can transition
  ' The transition is complete; this is now the direct signed 64-bit implementation

  DIM paddedSize AS _INTEGER64
  DIM remainder AS _INTEGER64
  DIM dt AS LONG
  DIM fixedLen AS _INTEGER64
  DIM uIdx AS LONG
  DIM elemSize AS _INTEGER64
  DIM statElems AS _INTEGER64
  DIM isTempInternal AS LONG

  dt = symbols(vIdx).DataType

  IF dt = TYPE_UNDEFINED THEN
    IF symbols(vIdx).SubIndex <> 0 THEN
      IF subs(symbols(vIdx).SubIndex).IsFunction = 0 THEN
        retSymbolByteSize = 0
        EXIT FUNCTION
      END IF
    END IF
    ESCAPETEXT2 "RSBS: FATAL IN retSymbolByteSize", "TYPE_UNDEFINED on symbol: " + RTRIM$(symbols(vIdx).RecordName)
  END IF

  IF RTRIM$(symbols(vIdx).RecordName) = "!G_SYS_ARR_FONT" THEN
    retSymbolByteSize = FONT_TOTAL_DATA_SIZE
    EXIT FUNCTION
  END IF

  IF RTRIM$(symbols(vIdx).RecordName) = "!G_SYS_ARR_GOSUB" THEN
    retSymbolByteSize = 2048
    EXIT FUNCTION
  END IF

  elemSize = 8

  SELECT CASE dt

    CASE TYPE_BYTE, TYPE_UBYTE
      elemSize = 1

    CASE TYPE_INTEGER, TYPE_UINTEGER
      elemSize = 2

    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE
      elemSize = 4

    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE
      elemSize = 8

    CASE TYPE_STRING
      fixedLen = retFixeSTRINGDLength(vIdx)
      IF fixedLen > 0 THEN
        elemSize = fixedLen
      ELSE
        elemSize = 8
      END IF

    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex
      IF uIdx >= 0 THEN
        elemSize = udts(uIdx).TotalSize
      ELSE
        elemSize = 8
      END IF

  END SELECT ' dt

  IF symbols(vIdx).IsArray > 0 THEN
    IF symbols(vIdx).IsArray = 2 THEN
      ' Dynamic arrays need room for the maximum supported descriptor because REDIM can change the dimension count
      paddedSize = 16 + (255 * 8)
    ELSE
      paddedSize = 16 + (symbols(vIdx).NumDimensions * 8)
    END IF

    IF symbols(vIdx).IsArray = 1 THEN
      statElems = symbols(vIdx).Size
      paddedSize = paddedSize + (statElems * elemSize)
    END IF

    remainder = paddedSize AND 7
    IF remainder <> 0 THEN
      paddedSize = paddedSize + (8 - remainder)
    END IF

    IF symbols(vIdx).IsArray = 2 THEN
      IF paddedSize < 32 THEN paddedSize = 32
    END IF

    retSymbolByteSize = paddedSize
    EXIT FUNCTION
  END IF

  paddedSize = 0

  SELECT CASE dt

    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE
      paddedSize = 8

    CASE TYPE_BYTE, TYPE_UBYTE, TYPE_INTEGER, TYPE_UINTEGER
      paddedSize = symbols(vIdx).Size

      IF dt = TYPE_INTEGER OR dt = TYPE_UINTEGER THEN
        paddedSize = paddedSize * 2
      END IF

      remainder = paddedSize AND 7
      IF remainder <> 0 THEN
        paddedSize = paddedSize + (8 - remainder)
      END IF

    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE
      paddedSize = symbols(vIdx).Size * 4

      remainder = paddedSize AND 7
      IF remainder <> 0 THEN
        paddedSize = paddedSize + (8 - remainder)
      END IF

    CASE TYPE_STRING
      IF symbols(vIdx).IsArray = 1 THEN
        fixedLen = retFixeSTRINGDLength(vIdx)

        IF fixedLen > 0 THEN
          paddedSize = symbols(vIdx).Size * fixedLen

          remainder = paddedSize AND 7
          IF remainder <> 0 THEN
            paddedSize = paddedSize + (8 - remainder)
          END IF
        ELSE
          paddedSize = symbols(vIdx).Size * 8
        END IF
      ELSE
        firstChar$ = LEFT$(symbols(vIdx).RecordName, 1)
        secondChar$ = MID$(symbols(vIdx).RecordName, 2, 1)
        isTempInternal = 0

        IF firstChar$ = "!" AND secondChar$ = "T" THEN
          isTempInternal = 1
        END IF

        IF symbols(vIdx).IsLocal = LOCAL_STANDARD AND symbols(vIdx).IsShared = 0 AND isTempInternal = 0 THEN
          fixedLen = retFixeSTRINGDLength(vIdx)
          IF fixedLen > 0 THEN
            paddedSize = 24 + fixedLen

            remainder = paddedSize AND 7
            IF remainder <> 0 THEN
              paddedSize = paddedSize + (8 - remainder)
            END IF
          ELSE
            paddedSize = 24
          END IF
        ELSE
          paddedSize = 8
        END IF
      END IF

    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex

      IF uIdx >= 0 THEN
        paddedSize = symbols(vIdx).Size * udts(uIdx).TotalSize

        remainder = paddedSize AND 7
        IF remainder <> 0 THEN
          paddedSize = paddedSize + (8 - remainder)
        END IF
      ELSE
        paddedSize = 8
      END IF

    CASE ELSE
      paddedSize = symbols(vIdx).Size * 8

  END SELECT ' dt

  retSymbolByteSize = paddedSize

END FUNCTION ' retSymbolByteSize

''''''''''''''''''''''''
FUNCTION retTokenVal& (wTok$)

  DIM tRet AS _UNSIGNED LONG
  DIM firstAsc AS _UNSIGNED LONG

  tRet = 0
  IF LEN(wTok$) = 2 THEN
    firstAsc = ASC(LEFT$(wTok$, 1))
    IF firstAsc < 32 THEN
      tRet = (firstAsc * 256) + ASC(MID$(wTok$, 2, 1))
    END IF
  END IF

  IF tRet = 0 THEN
    IF LEN(wTok$) > MAX_IDENTIFIER_LENGTH THEN
      firstAsc = ASC(LEFT$(wTok$, 1))
      IF (firstAsc >= 65 AND firstAsc <= 90) OR (firstAsc >= 97 AND firstAsc <= 122) OR firstAsc = 95 THEN
        throwCompilerError "IDENTIFIER EXCEEDS " + LTRIM$(STR$(MAX_IDENTIFIER_LENGTH)) + " CHARACTER LIMIT", ASIS, 0
        retTokenVal = 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  retTokenVal = tRet

END FUNCTION ' retTokenVal

''''''''''''''''''''''''
FUNCTION retTokenText$ (wTok$)

  ' For if I want parts of the code to be blind to token values
  ' Safely reconstructs strings for identifiers (0), ASCII symbols (256-511), and keywords (512-1023)

  DIM tVal AS _UNSIGNED LONG

  tempRet$ = wTok$
  tVal = retTokenVal(wTok$)

  IF tVal <> 0 THEN
    IF tVal >= 256 AND tVal <= 511 THEN
      tempRet$ = CHR$(tVal - 256)
    ELSE
      IF tVal >= 512 AND tVal <= 1023 THEN
        IF voc(tVal).text <> "" THEN
          tempRet$ = voc(tVal).text
        END IF
      END IF
    END IF
  END IF

  retTokenText$ = tempRet$

END FUNCTION ' retTokenText$

''''''''''''''''''''''''
FUNCTION retTypeFromToken (tType AS LONG, isUnsigned AS LONG)

  DIM tempType AS LONG
  tempType = TYPE_UNDEFINED

  IF isUnsigned = 1 THEN

    SELECT CASE tType

      CASE TOK_BYTE
        tempType = TYPE_UBYTE
      CASE TOK_INTEGER
        tempType = TYPE_UINTEGER
      CASE TOK_LONG
        tempType = TYPE_ULONG
      CASE TOK_INTEGER64, TOK_OFFSET
        tempType = TYPE_UINT64

    END SELECT ' tType

  ELSE

    SELECT CASE tType

      CASE TOK_BYTE
        tempType = TYPE_BYTE
      CASE TOK_INTEGER
        tempType = TYPE_INTEGER
      CASE TOK_LONG
        tempType = TYPE_LONG
      CASE TOK_INTEGER64, TOK_OFFSET
        tempType = TYPE_INTEGER64
      CASE TOK_SINGLE
        tempType = TYPE_SINGLE
      CASE TOK_DOUBLE
        tempType = TYPE_DOUBLE
      CASE TOK_STRINGD
        tempType = TYPE_STRING
      CASE TOK_STRING
        tempType = TYPE_STRING
      CASE TOK_ANY
        tempType = TYPE_ANY

    END SELECT ' tType
  END IF

  retTypeFromToken = tempType

END FUNCTION ' retTypeFromToken

''''''''''''''''''''''''
SUB scanGlobalDirectives (scanMode AS LONG)

  DIM maxLines AS LONG
  DIM firstCodeLineFound AS LONG
  DIM isDir AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM newX AS LONG
  DIM newY AS LONG
  DIM commaPos AS LONG
  DIM dashPos AS LONG
  DIM c1 AS LONG
  DIM c2 AS LONG
  DIM cIdx AS LONG

  cm.StringStrict = 0
  cm.EmeraldMode = 0
  cm.ClassicMode = 0
  cm.NoRef = 0
  cm.PascalMode = 0
  cm.HasGraphics = 0
  cm.HasGlobalDefInt = 0
  compileWindowTitle$ = "Default"
  gfxConfig.SizeX = 640
  gfxConfig.SizeY = 480

  FOR ix = 0 TO 25
    defIntMap(ix) = 0
  NEXT

  IF scanMode = 0 THEN
    maxLines = editor.LastLine
    IF maxLines > 256 THEN maxLines = 256
  ELSE
    maxLines = compileLastLine
  END IF

  firstCodeLineFound = 0

  FOR iy = 1 TO maxLines
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    IF scanMode = 0 THEN
      origLine$ = editorText$(iy)
      currentLineNumber = iy
    ELSE
      origLine$ = compileText$(iy)
      currentLineNumber = editorLineLinkMap(iy)
    END IF

    tempScan$ = UCASE$(LTRIM$(RTRIM$(origLine$)))
    origDir$ = LTRIM$(RTRIM$(origLine$))

    IF tempScan$ <> "" THEN
      isDir = 0
      checkDir$ = tempScan$

      IF LEFT$(tempScan$, 1) = "'" THEN
        checkDir$ = LTRIM$(MID$(tempScan$, 2))
        origDir$ = LTRIM$(MID$(origDir$, 2))
      ELSE
        IF LEFT$(tempScan$, 4) = "REM " OR tempScan$ = "REM" THEN
          checkDir$ = LTRIM$(MID$(tempScan$, 5))
          origDir$ = LTRIM$(MID$(origDir$, 5))
        END IF
      END IF

      IF checkIfPreprocessorKeyword(checkDir$) = 1 THEN
        isDir = 1

        IF scanMode = 1 THEN
          IF currentLineNumber > 256 THEN
            throwCompilerError "DIRECTIVES MUST BE IN THE FIRST 256 LINES", ASIS, 0
            EXIT SUB
          END IF

          IF firstCodeLineFound = 1 THEN
            throwCompilerError "DIRECTIVES MUST COME BEFORE CODE", ASIS, 0
            EXIT SUB
          END IF
        END IF

        IF LEFT$(checkDir$, 13) = "#STRINGSTRICT" THEN cm.StringStrict = 1
        IF LEFT$(checkDir$, 8) = "#CLASSIC" THEN cm.ClassicMode = 1
        IF LEFT$(checkDir$, 6) = "#NOREF" THEN cm.NoRef = 1
        IF LEFT$(checkDir$, 7) = "#PASCAL" THEN cm.PascalMode = 1
        IF LEFT$(checkDir$, 8) = "#EMERALD" THEN
          cm.EmeraldMode = 1
          cm.StringStrict = 1
          cm.PascalMode = 1
        END IF

        IF LEFT$(checkDir$, 9) = "#GRAPHICS" THEN
          cm.HasGraphics = 1
          argStr$ = LTRIM$(MID$(origDir$, 10))
          IF argStr$ <> "" THEN
            comma1 = INSTR(argStr$, ",")
            IF comma1 > 0 THEN
              xStr$ = LTRIM$(RTRIM$(LEFT$(argStr$, comma1 - 1)))
              argStr$ = LTRIM$(MID$(argStr$, comma1 + 1))
              newX = VAL(xStr$)
              IF newX > 0 THEN gfxConfig.SizeX = newX

              comma2 = INSTR(argStr$, ",")
              IF comma2 > 0 THEN
                yStr$ = LTRIM$(RTRIM$(LEFT$(argStr$, comma2 - 1)))
                argStr$ = LTRIM$(MID$(argStr$, comma2 + 1))
              ELSE
                yStr$ = LTRIM$(RTRIM$(argStr$))
                argStr$ = ""
              END IF
              newY = VAL(yStr$)
              IF newY > 0 THEN gfxConfig.SizeY = newY

              IF argStr$ <> "" THEN
                IF LEFT$(argStr$, 1) = CHR$(34) THEN
                  compileWindowTitle$ = extractQuotes$(argStr$)
                END IF
              END IF
            ELSE
              newX = VAL(argStr$)
              IF newX > 0 THEN gfxConfig.SizeX = newX
            END IF

            IF scanMode = 1 THEN
              IF gfxConfig.SizeX < 64 OR gfxConfig.SizeX > FRAMEBUF_MAX_WIDTH THEN
                throwCompilerError "X MUST BE 64 TO 1024", ASIS, 0
                EXIT SUB
              END IF
              IF gfxConfig.SizeY < 64 OR gfxConfig.SizeY > FRAMEBUF_MAX_HEIGHT THEN
                throwCompilerError "Y MUST BE 64 TO 1080", ASIS, 0
                EXIT SUB
              END IF
            END IF
          END IF
        END IF

        IF LEFT$(checkDir$, 9) = "#GLDEFINT" THEN
          cm.HasGlobalDefInt = 1
          argStr$ = UCASE$(LTRIM$(MID$(checkDir$, 10)))

          IF argStr$ = "" THEN
            IF scanMode = 1 THEN
              throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
              EXIT SUB
            END IF
          END IF

          DO WHILE argStr$ <> ""
            commaPos = INSTR(argStr$, ",")
            IF commaPos > 0 THEN
              chunk$ = LTRIM$(RTRIM$(LEFT$(argStr$, commaPos - 1)))
              argStr$ = LTRIM$(MID$(argStr$, commaPos + 1))
            ELSE
              chunk$ = LTRIM$(RTRIM$(argStr$))
              argStr$ = ""
            END IF

            IF chunk$ <> "" THEN
              dashPos = INSTR(chunk$, "-")
              IF dashPos > 0 THEN
                char1$ = LTRIM$(RTRIM$(LEFT$(chunk$, dashPos - 1)))
                char2$ = LTRIM$(RTRIM$(MID$(chunk$, dashPos + 1)))
                IF LEN(char1$) = 1 AND LEN(char2$) = 1 THEN
                  c1 = ASC(char1$)
                  c2 = ASC(char2$)
                  IF c1 >= 65 AND c1 <= 90 AND c2 >= 65 AND c2 <= 90 AND c2 >= c1 THEN
                    FOR cIdx = c1 TO c2
                      defIntMap(cIdx - 65) = 1
                    NEXT
                  ELSE
                    IF scanMode = 1 THEN
                      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
                      EXIT SUB
                    END IF
                  END IF
                ELSE
                  IF scanMode = 1 THEN
                    throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
                    EXIT SUB
                  END IF
                END IF
              ELSE
                IF LEN(chunk$) = 1 THEN
                  c1 = ASC(chunk$)
                  IF c1 >= 65 AND c1 <= 90 THEN
                    defIntMap(c1 - 65) = 1
                  ELSE
                    IF scanMode = 1 THEN
                      throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
                      EXIT SUB
                    END IF
                  END IF
                ELSE
                  IF scanMode = 1 THEN
                    throwCompilerError "DEFINT NEEDS LETTER A-Z", ASIS, 0
                    EXIT SUB
                  END IF
                END IF
              END IF
            END IF
          LOOP
        END IF
      END IF

      IF isDir = 0 THEN
        IF LEFT$(tempScan$, 1) <> "'" AND LEFT$(tempScan$, 4) <> "REM " AND tempScan$ <> "REM" THEN
          lblStr$ = retLabelStripLength$(origLine$)
          stripLen = returnedData2
          IF stripLen > 0 THEN
            remLine$ = LTRIM$(RTRIM$(MID$(origLine$, stripLen + 1)))
            IF remLine$ <> "" AND LEFT$(remLine$, 1) <> "'" THEN
              firstCodeLineFound = 1
            END IF
          ELSE
            firstCodeLineFound = 1
          END IF
        END IF
      END IF

    END IF
  NEXT

  currentLineNumber = 1

END SUB ' scanGlobalDirectives

