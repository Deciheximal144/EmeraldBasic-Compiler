''''''''''''''''''''''''
FUNCTION tiraLabelCreateNew$ (baseName$)

  tiraCheckActive ("tiraLabelCreateNew$")

  ' Keep ordinary compiler-generated labels in the established @BASE_counter form.
  ' Runtime-helper labels receive @R_ automatically here so individual emitRuntime
  ' routines do not need special label calls or coordinated conversion. Direct fixed
  ' internal anchors passed to tiraLabel remain valid with the ordinary @ prefix.
  IF isCompilingRT = 1 THEN
    tempName$ = "@R_" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  ELSE
    tempName$ = "@" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  END IF

  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tiraLabelCreateNew$ = ""
    EXIT FUNCTION
  END IF

  tiraLabelCreateNew$ = tempName$

END FUNCTION ' tiraLabelCreateNew$

''''''''''''''''''''''''
FUNCTION tiraLabelCreateNewId& (baseName$)

  tiraCheckActive ("tiraLabelCreateNewId&")

  DIM vIdx AS LONG

  IF isCompilingRT = 1 THEN
    labelName$ = "@R_" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  ELSE
    labelName$ = "@" + baseName$ + "_" + LTRIM$(RTRIM$(STR$(t.TiraVarCounter)))
  END IF

  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    tiraLabelCreateNewId& = 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol(labelName$)
  IF ff = 0 THEN
    tiraLabelCreateNewId& = 0
    EXIT FUNCTION
  END IF

  vIdx = returnedData2
  tiraLabelCreateNewId& = vIdx

END FUNCTION ' tiraLabelCreateNewId&

''''''''''''''''''''''''
SUB tiraLabelId (labelIdx AS LONG)

  tiraCheckActive ("tiraLabelId")
  IF tiraLineCheck THEN EXIT SUB

  IF labelIdx < 0 THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF labelIdx >= symbolCount THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF symbols(labelIdx).DataType <> TYPE_LABEL THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  IF LEFT$(symbols(labelIdx).RecordName, 1) <> "@" THEN
    throwCompilerError "Internal label must use valid @ label ID", ASIS, 0
    EXIT SUB
  END IF

  tiraNode(t.LineCount).OpCode = TC_LABEL

  tiraNode(t.LineCount).Arg1Type = TIRA_ARG_LABEL
  tiraNode(t.LineCount).Arg1Val = labelIdx

  tiraNode(t.LineCount).Arg2Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg2Val = 0
  tiraNode(t.LineCount).Arg3Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg3Val = 0
  tiraNode(t.LineCount).Arg4Type = TIRA_ARG_EMPTY: tiraNode(t.LineCount).Arg4Val = 0

  t.LineCount = t.LineCount + 1

END SUB ' tiraLabelId

