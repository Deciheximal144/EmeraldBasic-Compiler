''''''''''''''''''''''''
SUB a_Main

  DIM redrawTimeGoal AS DOUBLE
  DIM redrawLastTime AS DOUBLE
  DIM currentRedrawTime AS DOUBLE

  editor.DragActive = 0
  editor.WindowState = WIN_STATE_MED

  ' Default to native screen bounds to prevent early draw errors
  physicalScreenX = SCREENSIZEX
  physicalScreenY = SCREENSIZEY

  applyWindowState

  redrawTimeGoal = 0
  redrawLastTime = TIMER
  previousCompileState = compileState
  previousPass5SubState = pass5.SubState
  previousStatusMsgCount = statusMsgCount
  lastMouseX = mouse.PosX
  lastMouseY = mouse.PosY

  DO ' Start of main loop

    mouseReadInput

    ' Mouse input always runs at full speed and forces an immediate redraw
    mouseActivity = 0

    IF mouse.PosX <> lastMouseX OR mouse.PosY <> lastMouseY THEN
      mouseActivity = 1
    END IF

    IF mouse.Clicked1 <> 0 OR mouse.Clicked2 <> 0 THEN
      mouseActivity = 1
    END IF

    IF mouse.Released1 <> 0 OR mouse.Released2 <> 0 THEN
      mouseActivity = 1
    END IF

    IF mouse.Button1Down <> 0 OR mouse.Button2Down <> 0 THEN
      mouseActivity = 1
    END IF

    IF mouse.Wheel <> 0 THEN
      mouseActivity = 1
    END IF

    lastMouseX = mouse.PosX
    lastMouseY = mouse.PosY

    limitSpeed

    processInput
    processCompileState

    currentRedrawTime = TIMER

    ' Correct the future redraw goal when TIMER rolls over at midnight
    IF currentRedrawTime < redrawLastTime THEN
      redrawTimeGoal = currentRedrawTime
    END IF

    redrawLastTime = currentRedrawTime
    redrawNow = 0

    IF compileState = COMP_IDLE THEN
      redrawNow = 1
    ELSE
      ' Keep unattended compile redraws to ten per second
      IF currentRedrawTime >= redrawTimeGoal THEN
        redrawNow = 1
      END IF

      IF mouseActivity = 1 THEN
        redrawNow = 1
      END IF

      IF compileState <> previousCompileState THEN
        redrawNow = 1
      END IF

      IF pass5.SubState <> previousPass5SubState THEN
        redrawNow = 1
      END IF

      IF statusMsgCount <> previousStatusMsgCount THEN
        redrawNow = 1
      END IF
    END IF

    IF redrawNow = 1 THEN
      ' Divert all standard drawing commands to our fixed resolution canvas
      _DEST logicalScreen

      redrawAll

      ' Target the physical window and stretch the completed frame to fit
      _DEST 0
      _PUTIMAGE (0, 0)-(physicalScreenX - 1, physicalScreenY - 1), logicalScreen, 0

      _DISPLAY

      redrawTimeGoal = currentRedrawTime + 0.1
    END IF

    previousCompileState = compileState
    previousPass5SubState = pass5.SubState
    previousStatusMsgCount = statusMsgCount

  LOOP ' End of main loop

END SUB ' a_Main

''''''''''''''''''''''''
SUB addKeyword (passKw$, passTokVal, passIsPre, isIntrinsic, isStandardCmd)

  voc(passTokVal).text = passKw$
  voc(passTokVal).IsPreprocessor = passIsPre
  voc(passTokVal).IsStandardCmd = isStandardCmd

  hVal = hashString(passKw$)
  voc(passTokVal).HashNext = kwHash(hVal)
  kwHash(hVal) = passTokVal

  IF isIntrinsic > 0 THEN
    isHoistedIntrinsic(passTokVal) = isIntrinsic
  END IF

END SUB ' addKeyword

''''''''''''''''''''''''
SUB addPatch (passType AS LONG, passOffset AS LONG, passTargetInt AS LONG)

  DIM patchName$
  DIM instructionValid AS LONG
  DIM targetSubIdx AS LONG

  IF isMeasurePass = 1 THEN EXIT SUB
  IF compileError = 1 THEN EXIT SUB

  SELECT CASE passType

    CASE PATCH_VAR
      patchName$ = "VARIABLE"

    CASE PATCH_IAT
      patchName$ = "IAT"

    CASE PATCH_GOTO
      patchName$ = "GOTO"

    CASE PATCH_RT
      patchName$ = "RUNTIME"

    CASE PATCH_CALL
      patchName$ = "CALL"

    CASE ELSE
      throwCompilerError "INVALID PATCH TYPE: " + LTRIM$(STR$(passType)), ASIS, 0
      EXIT SUB

  END SELECT ' passType

  ' Zero is the emitter failure result for patch locations
  IF passOffset = 0 THEN
    throwCompilerError patchName$ + " PATCH EMITTER FAILED", ASIS, 0
    EXIT SUB
  END IF

  IF passOffset < 0 THEN
    throwCompilerError patchName$ + " PATCH OFFSET IS NEGATIVE", ASIS, 0
    EXIT SUB
  END IF

  IF passOffset > MAX_CODE_SIZE - 4 THEN
    throwCompilerError patchName$ + " PATCH EXCEEDS CODE BUFFER", ASIS, 0
    EXIT SUB
  END IF

  IF stream.emitPos < 4 THEN
    throwCompilerError patchName$ + " PATCH HAS NO GENERATED INSTRUCTION", ASIS, 0
    EXIT SUB
  END IF

  IF passOffset > stream.emitPos - 4 THEN
    throwCompilerError patchName$ + " PATCH EXCEEDS GENERATED CODE", ASIS, 0
    EXIT SUB
  END IF

  IF intermediateCode(passOffset) <> 0 OR intermediateCode(passOffset + 1) <> 0 OR intermediateCode(passOffset + 2) <> 0 OR intermediateCode(passOffset + 3) <> 0 THEN
    throwCompilerError patchName$ + " PATCH PLACEHOLDER IS NOT ZERO", ASIS, 0
    EXIT SUB
  END IF

  instructionValid = 0

  SELECT CASE passType

    CASE PATCH_VAR
      IF passOffset >= 1 THEN
        IF (intermediateCode(passOffset - 1) AND &HC7) = &H05 THEN
          instructionValid = 1
        END IF
      END IF

    CASE PATCH_IAT
      IF passOffset >= 2 THEN
        IF intermediateCode(passOffset - 2) = &HFF AND intermediateCode(passOffset - 1) = &H15 THEN
          instructionValid = 1
        END IF
      END IF

    CASE PATCH_GOTO
      IF passOffset >= 1 THEN
        IF intermediateCode(passOffset - 1) = &HE9 THEN
          instructionValid = 1
        END IF

        IF (intermediateCode(passOffset - 1) AND &HC7) = &H05 THEN
          instructionValid = 1
        END IF
      END IF

      IF passOffset >= 2 THEN
        IF intermediateCode(passOffset - 2) = &H0F THEN
          IF intermediateCode(passOffset - 1) >= &H80 AND intermediateCode(passOffset - 1) <= &H8F THEN
            instructionValid = 1
          END IF
        END IF
      END IF

    CASE PATCH_RT
      IF passOffset >= 1 THEN
        IF intermediateCode(passOffset - 1) = &HE8 THEN
          instructionValid = 1
        END IF

        IF (intermediateCode(passOffset - 1) AND &HC7) = &H05 THEN
          instructionValid = 1
        END IF
      END IF

    CASE PATCH_CALL
      IF passOffset >= 1 THEN
        IF intermediateCode(passOffset - 1) = &HE8 THEN
          instructionValid = 1
        END IF
      END IF

  END SELECT ' passType

  IF instructionValid = 0 THEN
    throwCompilerError patchName$ + " PATCH DOES NOT BELONG TO THE EXPECTED INSTRUCTION", ASIS, 0
    EXIT SUB
  END IF

  SELECT CASE passType

    CASE PATCH_VAR
      IF passTargetInt < 0 OR passTargetInt >= symbolCount THEN
        throwCompilerError "VARIABLE PATCH TARGET DOES NOT EXIST: " + LTRIM$(STR$(passTargetInt)), ASIS, 0
        EXIT SUB
      END IF

      IF patchCount >= MAX_PATCHES THEN
        throwCompilerError "PATCH LIMIT", ASIS, 0
        EXIT SUB
      END IF

      patches(patchCount).Offset = passOffset
      patches(patchCount).VarIdx = passTargetInt
      patchCount = patchCount + 1

    CASE PATCH_IAT
      IF passTargetInt <= IAT_INVALID THEN
        throwCompilerError "IAT PATCH TARGET IS INVALID", ASIS, 0
        EXIT SUB
      END IF

      IF passTargetInt >= 1000 THEN
        targetSubIdx = passTargetInt - 1000

        IF targetSubIdx < 1 OR targetSubIdx >= subCount THEN
          throwCompilerError "DLL PATCH TARGET DOES NOT EXIST: " + LTRIM$(STR$(targetSubIdx)), ASIS, 0
          EXIT SUB
        END IF
      END IF

      IF iatPatchCount >= MAX_IAT_PATCHES THEN
        throwCompilerError "IAT PATCH LIMIT", ASIS, 0
        EXIT SUB
      END IF

      iatPatches(iatPatchCount).Offset = passOffset
      iatPatches(iatPatchCount).IATIdx = passTargetInt
      iatPatchCount = iatPatchCount + 1

    CASE PATCH_GOTO
      ' Forward labels may still have a provisional suffix-derived type here
      IF passTargetInt < 0 OR passTargetInt >= symbolCount THEN
        throwCompilerError "GOTO PATCH TARGET DOES NOT EXIST: " + LTRIM$(STR$(passTargetInt)), ASIS, 0
        EXIT SUB
      END IF

      IF gotoPatchCount >= MAX_GOTO_PATCHES THEN
        throwCompilerError "GOTO PATCH LIMIT", ASIS, 0
        EXIT SUB
      END IF

      gotoPatches(gotoPatchCount).Offset = passOffset
      gotoPatches(gotoPatchCount).VarIdx = passTargetInt
      gotoPatchCount = gotoPatchCount + 1

    CASE PATCH_RT
      IF passTargetInt <= RT_INVALID OR passTargetInt > MAX_RT_ROUTINES THEN
        throwCompilerError "RUNTIME PATCH TARGET DOES NOT EXIST: " + LTRIM$(STR$(passTargetInt)), ASIS, 0
        EXIT SUB
      END IF

      IF rt.PatchCount >= MAX_RT_PATCHES THEN
        throwCompilerError "RT PATCH LIMIT", ASIS, 0
        EXIT SUB
      END IF

      rtPatches(rt.PatchCount).Offset = passOffset
      rtPatches(rt.PatchCount).Routine = passTargetInt
      rt.PatchCount = rt.PatchCount + 1

    CASE PATCH_CALL
      IF passTargetInt < 0 OR passTargetInt >= subCount THEN
        throwCompilerError "CALL PATCH TARGET DOES NOT EXIST: " + LTRIM$(STR$(passTargetInt)), ASIS, 0
        EXIT SUB
      END IF

      IF callPatchCount >= MAX_CALL_PATCHES THEN
        throwCompilerError "CALL PATCH LIMIT", ASIS, 0
        EXIT SUB
      END IF

      callPatches(callPatchCount).Offset = passOffset
      callPatches(callPatchCount).SubIndex = passTargetInt
      callPatchCount = callPatchCount + 1

  END SELECT ' passType

END SUB ' addPatch

''''''''''''''''''''''''
FUNCTION addStackSpace (wSize)

  tempOffset = currentFrameSize
  currentFrameSize = currentFrameSize + wSize
  addStackSpace = tempOffset

END FUNCTION ' addStackSpace

''''''''''''''''''''''''
SUB adjustAllPatchOffsets (offsetDiff AS LONG, userPatchCnt AS LONG, userIatPatchCnt AS LONG, userGotoPatchCnt AS LONG, userCallPatchCnt AS LONG, userRtPatchCnt AS LONG, userSubCnt AS LONG, userSymbolCnt AS LONG)

  DIM ii AS LONG

  IF userPatchCnt > 0 THEN
    FOR ii = 0 TO userPatchCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING VARIABLE PATCHES", ii + 1, userPatchCnt, 0
      END IF

      patches(ii).Offset = patches(ii).Offset + offsetDiff
    NEXT
  END IF

  IF userIatPatchCnt > 0 THEN
    FOR ii = 0 TO userIatPatchCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING IMPORT PATCHES", ii + 1, userIatPatchCnt, 0
      END IF

      iatPatches(ii).Offset = iatPatches(ii).Offset + offsetDiff
    NEXT
  END IF

  IF userGotoPatchCnt > 0 THEN
    FOR ii = 0 TO userGotoPatchCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING JUMP PATCHES", ii + 1, userGotoPatchCnt, 0
      END IF

      gotoPatches(ii).Offset = gotoPatches(ii).Offset + offsetDiff
    NEXT
  END IF

  IF userSymbolCnt > 0 THEN
    FOR ii = 0 TO userSymbolCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING SYMBOL OFFSETS", ii + 1, userSymbolCnt, 0
      END IF

      IF symbols(ii).DataType = TYPE_LABEL THEN
        ' Preserve the unresolved-label sentinel until validation reports it
        IF symbols(ii).Offset <> -1 THEN
          symbols(ii).Offset = symbols(ii).Offset + offsetDiff
        END IF
      END IF
    NEXT
  END IF

  IF userCallPatchCnt > 0 THEN
    FOR ii = 0 TO userCallPatchCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING CALL PATCHES", ii + 1, userCallPatchCnt, 0
      END IF

      callPatches(ii).Offset = callPatches(ii).Offset + offsetDiff
    NEXT
  END IF

  IF userRtPatchCnt > 0 THEN
    FOR ii = 0 TO userRtPatchCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING RUNTIME PATCHES", ii + 1, userRtPatchCnt, 0
      END IF

      rtPatches(ii).Offset = rtPatches(ii).Offset + offsetDiff
    NEXT
  END IF

  IF userSubCnt > 0 THEN
    FOR ii = 0 TO userSubCnt - 1
      IF (ii AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "SHIFTING SUB OFFSETS", ii + 1, userSubCnt, 0
      END IF

      subs(ii).Offset = subs(ii).Offset + offsetDiff
    NEXT
  END IF

  ' Shift the absolute runtime entry point offsets
  FOR ii = 0 TO MAX_RT_ROUTINES
    rtOffset(ii) = rtOffset(ii) + offsetDiff
  NEXT

END SUB ' adjustAllPatchOffsets

''''''''''''''''''''''''
FUNCTION alignStackFrame

  remainder = currentFrameSize AND 15 ' Bitwise AND is used instead of MOD to prevent floating point promotion precision loss on large values

  SELECT CASE remainder

    CASE 0
      currentFrameSize = currentFrameSize + 8
    CASE 1 TO 7
      currentFrameSize = currentFrameSize + (8 - remainder)
    CASE 8
      ' The frame is already perfectly aligned for Windows x64 API calls (16-byte aligned minus 8)
    CASE IS > 8
      currentFrameSize = currentFrameSize + (24 - remainder)

  END SELECT ' remainder

  alignStackFrame = currentFrameSize

END FUNCTION ' alignStackFrame

''''''''''''''''''''''''
SUB applyWindowState

  DIM wa AS dataTypeRect
  DIM winStyleRes AS LONG
  DIM winStyle AS LONG
  DIM hwnd AS _OFFSET

  ' Ensure the permanent logical image exists exactly once
  IF logicalScreen = 0 THEN
    logicalScreen = _NEWIMAGE(SCREENSIZEX, SCREENSIZEY, 13)
  END IF

  ' RES, MED and MAX are custom window states rather than QB64 fullscreen states
  _FULLSCREEN _OFF

  SELECT CASE editor.WindowState

    CASE WIN_STATE_RES
      _DEST 0
      physicalScreenX = SCREENSIZEX
      physicalScreenY = SCREENSIZEY

      SCREEN _NEWIMAGE(physicalScreenX, physicalScreenY, 13), 1, 0
      DO UNTIL _SCREENEXISTS
        _LIMIT 120
      LOOP
      _DELAY 0.05

      hwnd = _WINDOWHANDLE
      winStyleRes = GetWindowLongA&(hwnd, GWL_STYLE)
      winStyleRes = winStyleRes OR (WS_CAPTION OR WS_THICKFRAME)
      ff = SetWindowLongA&(hwnd, GWL_STYLE, winStyleRes)

      ff = SetWindowPos&(hwnd, 0, 0, 0, 0, 0, SWP_FRAMECHANGED OR SWP_NOMOVE OR SWP_NOSIZE OR SWP_NOZORDER OR SWP_SHOWWINDOW)

      ' Re-apply the font and custom hardware palette, as new screens wipe them
      _DEST logicalScreen
      _FONT 8
      setPalettes256
      _DEST 0
      _FONT 8
      setPalettes256

    CASE WIN_STATE_MED
      _DEST 0
      ff = SystemParametersInfoA&(SPI_GETWORKAREA, 0, _OFFSET(wa), 0)

      IF ff <> 0 AND wa.Right > wa.Left AND wa.BOTTOM > wa.TOP THEN
        physicalScreenX = wa.Right - wa.Left
        physicalScreenY = wa.BOTTOM - wa.TOP

        SCREEN _NEWIMAGE(physicalScreenX, physicalScreenY, 13), 1, 0
        DO UNTIL _SCREENEXISTS
          _LIMIT 120
        LOOP
        _DELAY 0.05

        hwnd = _WINDOWHANDLE
        winStyle = GetWindowLongA&(hwnd, GWL_STYLE)
        winStyle = winStyle AND NOT WS_CAPTION
        winStyle = winStyle AND NOT WS_THICKFRAME
        winStyle = winStyle AND NOT WS_MAXIMIZE
        ff = SetWindowLongA&(hwnd, GWL_STYLE, winStyle)

        ff = SetWindowPos&(hwnd, HWND_NOTOPMOST, wa.Left, wa.TOP, physicalScreenX, physicalScreenY, SWP_FRAMECHANGED OR SWP_SHOWWINDOW)

        ' Apply the final dimensions a second time after giving Windows time to process the style removal
        _DELAY 0.03
        ff = SetWindowPos&(hwnd, HWND_NOTOPMOST, wa.Left, wa.TOP, physicalScreenX, physicalScreenY, SWP_FRAMECHANGED OR SWP_SHOWWINDOW)

        _DEST logicalScreen
        _FONT 8
        setPalettes256
        _DEST 0
        _FONT 8
        setPalettes256
      END IF

    CASE WIN_STATE_MAX
      _DEST 0
      physicalScreenX = _DESKTOPWIDTH
      physicalScreenY = _DESKTOPHEIGHT

      SCREEN _NEWIMAGE(physicalScreenX, physicalScreenY, 13), 1, 0
      DO UNTIL _SCREENEXISTS
        _LIMIT 120
      LOOP
      _DELAY 0.05

      hwnd = _WINDOWHANDLE
      winStyle = GetWindowLongA&(hwnd, GWL_STYLE)
      winStyle = winStyle AND NOT WS_CAPTION
      winStyle = winStyle AND NOT WS_THICKFRAME
      winStyle = winStyle AND NOT WS_MAXIMIZE
      ff = SetWindowLongA&(hwnd, GWL_STYLE, winStyle)

      ff = SetWindowPos&(hwnd, HWND_TOPMOST, 0, 0, physicalScreenX, physicalScreenY, SWP_FRAMECHANGED OR SWP_SHOWWINDOW)
      ff = SetForegroundWindow&(hwnd)

      _DELAY 0.03
      ff = SetWindowPos&(hwnd, HWND_TOPMOST, 0, 0, physicalScreenX, physicalScreenY, SWP_FRAMECHANGED OR SWP_SHOWWINDOW)

      _DEST logicalScreen
      _FONT 8
      setPalettes256
      _DEST 0
      _FONT 8
      setPalettes256

  END SELECT ' editor.WindowState

END SUB ' applyWindowState

''''''''''''''''''''''''
SUB arrayPadNumBytes (wCount AS _UNSIGNED LONG, wValue AS LONG)

  DIM iLong AS _UNSIGNED LONG

  FOR iLong = 1 TO wCount
    IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
      compileSaveTracker "PADDING FILE", iLong, wCount, 0
    END IF

    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
      IF compileError = 0 THEN throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
      EXIT SUB
    END IF
    outputFile(outputFileIdx) = wValue
    outputFileIdx = outputFileIdx + 1
  NEXT

END SUB ' arrayPadNumBytes

''''''''''''''''''''''''
SUB arrayPadUpTo (wAddress AS _UNSIGNED LONG, wValue)

  IF outputFileIdx < wAddress THEN
    padCount = wAddress - outputFileIdx
    arrayPadNumBytes padCount, wValue
  END IF

END SUB ' arraypadUpTo

''''''''''''''''''''''''
SUB arrayWrite16LE (wVal)

  ' writes little endian

  DIM uVal AS _UNSIGNED LONG
  DIM byte0 AS _UNSIGNED _BYTE
  DIM byte1 AS _UNSIGNED _BYTE

  IF outputFileIdx + 1 >= MAX_OUTPUT_SIZE THEN
    IF compileError = 0 THEN throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
    EXIT SUB
  END IF

  uVal = wVal AND 65535

  byte0 = uVal AND 255
  byte1 = (uVal \ 256) AND 255

  outputFile(outputFileIdx) = byte0
  outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = byte1
  outputFileIdx = outputFileIdx + 1

END SUB ' arrayWrite16LE

''''''''''''''''''''''''
SUB arrayWrite32F (wVal AS SINGLE)

  ' Float version, little endian

  DIM vStr AS STRING * 4

  vStr = MKS$(wVal)
  FOR ii = 1 TO 4
    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
      IF compileError = 0 THEN throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
      EXIT SUB
    END IF
    outputFile(outputFileIdx) = ASC(MID$(vStr, ii, 1))
    outputFileIdx = outputFileIdx + 1
  NEXT

END SUB ' arrayWrite32F

''''''''''''''''''''''''
SUB arrayWrite32LE (wVal AS _UNSIGNED LONG)

  ' writes little endian

  DIM uVal AS _UNSIGNED LONG
  DIM byte0 AS _UNSIGNED _BYTE
  DIM byte1 AS _UNSIGNED _BYTE
  DIM byte2 AS _UNSIGNED _BYTE
  DIM byte3 AS _UNSIGNED _BYTE

  IF outputFileIdx + 3 >= MAX_OUTPUT_SIZE THEN
    throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
    EXIT SUB
  END IF

  uVal = wVal

  byte0 = uVal AND 255
  byte1 = (uVal \ 256) AND 255
  byte2 = (uVal \ 65536) AND 255
  byte3 = (uVal \ 16777216) AND 255

  outputFile(outputFileIdx) = byte0
  outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = byte1
  outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = byte2
  outputFileIdx = outputFileIdx + 1
  outputFile(outputFileIdx) = byte3
  outputFileIdx = outputFileIdx + 1

END SUB ' arrayWrite32LE

''''''''''''''''''''''''
SUB arrayWrite64F (wVal AS DOUBLE)

  ' Float version, little endian

  DIM vStr AS STRING * 8

  vStr = MKD$(wVal)
  FOR ii = 1 TO 8
    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
      IF compileError = 0 THEN throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
      EXIT SUB
    END IF
    outputFile(outputFileIdx) = ASC(MID$(vStr, ii, 1))
    outputFileIdx = outputFileIdx + 1
  NEXT

END SUB ' arrayWrite64F

''''''''''''''''''''''''
SUB arrayWriteCharString (wStr$)

  FOR ii = 1 TO LEN(wStr$)
    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
      throwCompilerErrorNoLineNum "COMPILER FAIL: OUTPUT FILE BUFFER EXCEEDED"
      EXIT SUB
    END IF
    outputFile(outputFileIdx) = ASC(MID$(wStr$, ii, 1))
    outputFileIdx = outputFileIdx + 1
  NEXT

END SUB ' arrayWriteCharString

''''''''''''''''''''''''
SUB buildImportTable

  DIM currentRVA AS LONG
  DIM iltSize AS LONG
  DIM iatSize AS LONG
  DIM flatIdx AS LONG
  DIM exactIdataSize AS LONG
  DIM entrySize AS LONG
  DIM nameLen AS LONG

  impTbl.numDlls = 7

  impDlls(0).DllName = "KERNEL32.dll"
  impDlls(0).FuncCount = 36
  impFuncs(0, 0).FuncName = "GetStdHandle"
  impFuncs(0, 1).FuncName = "WriteFile"
  impFuncs(0, 2).FuncName = "ReadFile"
  impFuncs(0, 3).FuncName = "ExitProcess"
  impFuncs(0, 4).FuncName = "GetModuleHandleA"
  impFuncs(0, 5).FuncName = "SetConsoleMode"
  impFuncs(0, 6).FuncName = "AddVectoredExceptionHandler"
  impFuncs(0, 7).FuncName = "Beep"
