''''''''''''''''''''''''
FUNCTION tiraWalkUdtDynamicStrings (basePtr$, uIdx AS LONG, scheduleFree AS LONG)

  tiraCheckActive ("tiraWalkUdtDynamicStrings")
  IF tiraLineCheck THEN
    tiraWalkUdtDynamicStrings = 0
    EXIT FUNCTION
  END IF

  DIM workUdtIndex(MAX_UDTS) AS LONG
  DIM workFieldIndex(MAX_UDTS) AS LONG
  DIM workBaseOffset(MAX_UDTS) AS LONG
  DIM workDepth AS LONG
  DIM currentUdtIndex AS LONG
  DIM currentFieldIndex AS LONG
  DIM nestedUdtIndex AS LONG
  DIM fieldOffset AS LONG
  DIM fieldType AS LONG
  DIM foundDynamicString AS LONG

  IF uIdx < 0 OR uIdx >= udtCount THEN
    throwCompilerError "INVALID UDT INDEX IN DYNAMIC STRING WALK", ASIS, 0
    tiraWalkUdtDynamicStrings = 0
    EXIT FUNCTION
  END IF

  foundDynamicString = 0
  workDepth = 0
  workUdtIndex(0) = uIdx
  workFieldIndex(0) = 0
  workBaseOffset(0) = 0

  DO WHILE workDepth >= 0
    currentUdtIndex = workUdtIndex(workDepth)
    currentFieldIndex = workFieldIndex(workDepth)

    IF currentFieldIndex >= udts(currentUdtIndex).FieldCount THEN
      workDepth = workDepth - 1
    ELSE
      workFieldIndex(workDepth) = currentFieldIndex + 1

      fieldOffset = workBaseOffset(workDepth) + udtFields(currentUdtIndex, currentFieldIndex).Offset
      fieldType = udtFields(currentUdtIndex, currentFieldIndex).DataType

      IF fieldType = TYPE_UDT THEN
        nestedUdtIndex = udtFields(currentUdtIndex, currentFieldIndex).UDTIndex

        IF nestedUdtIndex < 0 OR nestedUdtIndex >= udtCount THEN
          throwCompilerError "INVALID NESTED UDT INDEX IN DYNAMIC STRING WALK", ASIS, 0
          tiraWalkUdtDynamicStrings = 0
          EXIT FUNCTION
        END IF

        IF workDepth >= MAX_UDTS - 1 THEN
          throwCompilerError "UDT NESTING LIMIT REACHED IN DYNAMIC STRING WALK", ASIS, 0
          tiraWalkUdtDynamicStrings = 0
          EXIT FUNCTION
        END IF

        workDepth = workDepth + 1
        workUdtIndex(workDepth) = nestedUdtIndex
        workFieldIndex(workDepth) = 0
        workBaseOffset(workDepth) = fieldOffset
      ELSE
        IF fieldType = TYPE_STRING THEN
          IF udtFields(currentUdtIndex, currentFieldIndex).IsDynamicString = 1 THEN
            foundDynamicString = 1

            IF scheduleFree = 0 THEN
              tiraWalkUdtDynamicStrings = 1
              EXIT FUNCTION
            END IF

            descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
            IF fieldOffset > 0 THEN
              tiraOp TC_ADD, descAddr$, basePtr$, LTRIM$(STR$(fieldOffset))
            ELSE
              tiraAssign descAddr$, basePtr$
            END IF

            descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraNew TC_READ_MEM, descPtr$ + ", " + descAddr$

            skipFreeDataLbl$ = tiraLabelCreateNew$("SKIP_UDT_DATA")
            tiraJmpCond "JE", descPtr$, "0", skipFreeDataLbl$

            flagVal$ = tiraDimVar$("T", TYPE_LONG)
            flagPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADD, flagPtr$, descPtr$, "16"
            tiraNew TC_READ_MEM, flagVal$ + ", " + flagPtr$

            tiraJmpCond "JNE", flagVal$, "1", skipFreeDataLbl$

            dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraNew TC_READ_MEM, dataPtr$ + ", " + descPtr$

            tiraJmpCond "JE", dataPtr$, "0", skipFreeDataLbl$

            tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + dataPtr$

            tiraLabel skipFreeDataLbl$

            emptyDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraAssign emptyDescPtr$, "!G_SYS_DSC_EMPTY"
            skipFreeDescLbl$ = tiraLabelCreateNew$("SKIP_UDT_DESC")
            tiraJmpCond "JE", descPtr$, "0", skipFreeDescLbl$
            tiraJmpCond "JE", descPtr$, emptyDescPtr$, skipFreeDescLbl$
            tiraCall "IAT_HEAPFREE", 3, "!G_MEM_PTR_PROCESS_HEAP, 0, " + descPtr$
            tiraLabel skipFreeDescLbl$
          END IF
        END IF
      END IF
    END IF
  LOOP

  tiraWalkUdtDynamicStrings = foundDynamicString

END FUNCTION ' tiraWalkUdtDynamicStrings

