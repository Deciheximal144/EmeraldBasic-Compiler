''''''''''''''
'' SUB modalFileMenuNew ' This is found within Z_EMLINF.BLB
'
' Confirmation pop up box for new file

''''''''''''''''''''''''
SUB loadIncludesAndBaseCode

  DIM qStart AS LONG
  DIM qEnd AS LONG
  DIM ffTmp AS LONG
  DIM fileLen AS _UNSIGNED LONG
  DIM startPos AS _UNSIGNED LONG
  DIM nextNl AS _UNSIGNED LONG
  DIM chunkLen AS _UNSIGNED LONG

  compileLastLine = 0
  FOR iy = 1 TO editor.LastLine
    compileLastLine = compileLastLine + 1
    compileText$(compileLastLine) = editorText$(iy)
    editorLineLinkMap(compileLastLine) = iy
  NEXT

  FOR iy = 1 TO editor.LastLine
    tempScan$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
    origDir$ = LTRIM$(RTRIM$(editorText$(iy)))

    IF LEFT$(tempScan$, 1) = "'" THEN
      tempScan$ = LTRIM$(MID$(tempScan$, 2))
      origDir$ = LTRIM$(MID$(origDir$, 2))
    ELSE
      IF LEFT$(tempScan$, 4) = "REM " OR tempScan$ = "REM" THEN
        tempScan$ = LTRIM$(MID$(tempScan$, 5))
        origDir$ = LTRIM$(MID$(origDir$, 5))
      END IF
    END IF

    IF LEFT$(tempScan$, 8) = "#INCLUDE" THEN
      qStart = INSTR(origDir$, CHR$(34))
      IF qStart > 0 THEN
        qEnd = INSTR(qStart + 1, origDir$, CHR$(34))
        IF qEnd > 0 THEN
          fName$ = MID$(origDir$, qStart + 1, qEnd - qStart - 1)
          IF _FILEEXISTS(fName$) THEN
            ffTmp = FREEFILE
            OPEN fName$ FOR BINARY AS #ffTmp
            fileLen = LOF(ffTmp)
            IF fileLen > 0 THEN
              fullText$ = SPACE$(fileLen)
              GET #ffTmp, , fullText$
              startPos = 1
              DO WHILE startPos <= fileLen
                nextNl = INSTR(startPos, fullText$, CHR$(10))
                IF nextNl > 0 THEN
                  chunkLen = nextNl - startPos
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, nextNl - 1) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                    ELSE
                      IF chunkLen > 0 THEN
                        CLOSE #ffTmp
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  startPos = nextNl + 1
                ELSE
                  chunkLen = fileLen - startPos + 1
                  IF chunkLen > 0 THEN
                    IF ASC(fullText$, fileLen) = 13 THEN chunkLen = chunkLen - 1
                    IF chunkLen > 0 AND compileLastLine < COMPILE_LINE_MAX THEN
                      compileLastLine = compileLastLine + 1
                      compileText$(compileLastLine) = MID$(fullText$, startPos, chunkLen)
                      editorLineLinkMap(compileLastLine) = iy
                    ELSE
                      IF chunkLen > 0 THEN
                        CLOSE #ffTmp
                        throwCompilerError "COMPILE LINE LIMIT EXCEEDED", ASIS, 0
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                  EXIT DO
                END IF
              LOOP
            END IF
            CLOSE #ffTmp
          ELSE
            currentLineNumber = iy
            throwCompilerError "INCLUDE FILE NOT FOUND: " + fName$, ASIS, 0
            EXIT SUB
          END IF
        ELSE
          currentLineNumber = iy
          throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
          EXIT SUB
        END IF
      ELSE
        currentLineNumber = iy
        throwCompilerError "#INCLUDE REQUIRES FILE NAME IN DOUBLE QUOTES", ASIS, 0
        EXIT SUB
      END IF
    END IF
  NEXT

END SUB ' loadIncludesAndBaseCode

''''''''''''''''''''''''
SUB op_SafetyCheck (wStr$)

  IF TIRA_OP_SAFETY = 1 THEN
    IF t.IsActive < 2 THEN ESCAPETEXT "OP FATAL: UNAUTHORIZED OP CALL IN " + wStr$
  END IF

END SUB ' opSafetyCheck

''''''''''''''''''''''''
SUB opAddRsp32 (wVal AS LONG)

  ' Using opALU instead of this function will output 4 bytes instead of 7 bytes since opALU compresses values under 128

  op_SafetyCheck "opAddRsp32"

  emitByteCode &H48 ' REX.W
  emitByteCode &H81 ' ALU format 81
  emitByteCode &HC4 ' ModRM for ADD RSP
  emitBytes32 wVal

  stack.currentStackOffset = stack.currentStackOffset - wVal
  ff = updateStackAlignment

END SUB ' opAddRsp32

''''''''''''''''''''''''
FUNCTION opALU& (aluOpCode, destType, destInfo, srcType, srcInfo, opSizeOrFlag)

  op_SafetyCheck "opALU"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG
  DIM useImm8 AS LONG

  DIM opBase03 AS LONG
  DIM opBase01 AS LONG
  DIM opBase81 AS LONG
  DIM opBase83 AS LONG

  tempRet = 0 ' Default return value, 0 means no patch position

  ' RSP (4) is permitted because opALU natively handles SUB RSP and ADD RSP for stack frame allocation
  ' RBP (5) is prohibited to prevent accidental modifications to the stable base frame pointer anchoring local variables
  IF destType = OP_TYPE_REG THEN
    IF destInfo < 0 OR destInfo > 15 OR destInfo = 5 THEN
      ESCAPETEXT "COMPILER FAIL: Invalid reg target (" + LTRIM$(STR$(destInfo)) + ") in opALU. RBP (5) is protected."
    END IF
  END IF

  IF opSizeOrFlag = MODE_RIP THEN
    srcReg = srcInfo
    rex = calcRex(64, srcReg, REG_NONE, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &H01 + (aluOpCode * 8)
    modRM = ((srcReg AND 7) * 8) + 5
    emitByteCode modRM
    tempRet = stream.emitPos
    emitBytes32 0
    opALU = tempRet
    EXIT FUNCTION
  END IF

  ' Set dynamic opcode bases based on operation bit size
  opBase03 = &H03
  opBase01 = &H01
  opBase81 = &H81
  opBase83 = &H83

  IF opSizeOrFlag = 8 THEN
    opBase03 = &H02
    opBase01 = &H00
    opBase81 = &H80
    opBase83 = &H80 ' 8-bit immediate operations don't need the sign-extended 83 base
  END IF

  SELECT CASE destType

    CASE OP_TYPE_ACC ' Explicit Accumulator-to-Immediate operations
      ' Requires srcType to be OP_TYPE_IMM
      rex = calcRex(opSizeOrFlag, REG_NONE, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF opSizeOrFlag = 8 THEN
        emitByteCode (aluOpCode * 8) + &H04
        emitByteCode (srcInfo AND 255)
      ELSE
        emitByteCode (aluOpCode * 8) + &H05
        IF opSizeOrFlag = 16 THEN
          emitByteCode (srcInfo AND 255)
          emitByteCode ((srcInfo \ 256) AND 255)
        ELSE
          emitBytes32 srcInfo
        END IF
      END IF

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, destReg, srcReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_REG_ALT
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          rex = calcRex(opSizeOrFlag, 0, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN
            emitByteCode opBase83
            modRM = &HC0 + (aluOpCode * 8) + (destReg AND 7)
            emitByteCode modRM
            emitByteCode (srcInfo AND 255)
          ELSE
            emitByteCode opBase81
            modRM = &HC0 + (aluOpCode * 8) + (destReg AND 7)
            emitByteCode modRM
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

        CASE OP_TYPE_MEM_RIP ' Memory-to-Register (RIP-relative)
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' Memory-to-Register (RSP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory-to-Register (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' Memory-to-Register (Register-Indirect, no displacement)
          baseReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' Memory-to-Register (Register-Indirect with 8-bit disp)
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory-to-Register (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase03 + (aluOpCode * 8)
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Register-to-Memory (RIP-relative)
      srcReg = srcInfo
      rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex
      emitByteCode opBase01 + (aluOpCode * 8)
      modRM = ((srcReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RSP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RSP-relative)
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand aluOpCode, 4, 8, destInfo
          ELSE
            emitMemoryOperand aluOpCode, 4, 32, destInfo
          END IF

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RBP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, 5, 32, destInfo

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, 5, 32, destInfo

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 0, 0

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 0, 0

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 8, disp8

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 8, disp8

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase01 + (aluOpCode * 8)
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          useImm8 = 0
          IF opSizeOrFlag = MODE_IMM8 THEN
            useImm8 = 1
          ELSE
            IF srcInfo >= -128 AND srcInfo <= 127 THEN useImm8 = 1
          END IF
          IF opSizeOrFlag = 8 THEN useImm8 = 1

          IF useImm8 = 1 THEN emitByteCode opBase83 ELSE emitByteCode opBase81
          emitMemoryOperand aluOpCode, baseReg, 32, disp32

          IF useImm8 = 1 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opALU = tempRet

END FUNCTION ' opALU

''''''''''''''''''''''''
FUNCTION opCall& (wInfo, wMode)

  op_SafetyCheck "opCall"

  DIM tempRet AS LONG
  tempRet = 0

  IF STACKSAFETYCHECK = 1 THEN

    IF updateStackAlignment = 0 THEN
      err1$ = "FATAL: Unaligned call offset:" + LTRIM$(STR$(stack.currentStackOffset)) + " bytes"

      ' Safely append the line number and subroutine name to the error string so the user knows exactly where it failed
      IF currentLineNumber > 0 AND currentLineNumber <= EDITOR_LINE_MAX THEN
        err1$ = err1$ + " Line: " + LTRIM$(STR$(currentLineNumber))
      END IF
      IF currentSubName$ <> "" THEN
        err1$ = err1$ + " in SUB: " + currentSubName$
      END IF

      ' Grab the actual text of the line from the editor array to print to the screen for visual debugging
      err2$ = ""
      IF currentLineNumber > 0 AND currentLineNumber <= EDITOR_LINE_MAX THEN
        IF compileText$(currentLineNumber) <> "" THEN
          err2$ = "[" + LTRIM$(RTRIM$(compileText$(currentLineNumber))) + "]"
        END IF
      END IF

      ' Append the internal caller metadata (IAT Index or Sub Index) to assist the compiler developer
      err2$ = err2$ + " (wInfo: " + LTRIM$(STR$(wInfo)) + ", wMode: " + LTRIM$(STR$(wMode)) + ")"

      ' Terminate compiler immediately to prevent generating a corrupted executable
      ESCAPETEXT2 err1$, err2$
    END IF
  END IF

  IF wMode = CALLMODE_IAT THEN
    ' Emit 0xFF 0x15, which is the x64 opcode for an absolute indirect call (CALL QWORD PTR [RIP+disp])
    emitByteCode &HFF
    emitByteCode &H15

    ' Emit 4 null bytes as a placeholder for the 32-bit displacement value
    tempRet = stream.emitPos
    emitBytes32 0

    IF compileError = 1 THEN
      opCall = 0
      EXIT FUNCTION
    END IF

    ' IAT_INVALID remains the caller-managed patch sentinel
    IF wInfo <> IAT_INVALID THEN
      ' Queue the offset in the IAT patch list so prepareBinary can link it to the OS DLL table later
      addPatch PATCH_IAT, tempRet, wInfo
      IF compileError = 1 THEN
        opCall = 0
        EXIT FUNCTION
      END IF
    END IF

  ELSE
    IF wMode = CALLMODE_REL32 THEN
      ' Internal subroutine / runtime helper emission (relative 32-bit Call)
      emitByteCode &HE8

      ' Emit 4 null bytes as a placeholder for the displacement value
      tempRet = stream.emitPos
      emitBytes32 0

      IF compileError = 1 THEN
        opCall = 0
        EXIT FUNCTION
      END IF
    ELSE
      throwCompilerError "INVALID CALL MODE", ASIS, 0
      addStatusMsgContinuation "CALL MODE: " + LTRIM$(STR$(wMode)) + " | CALL INFO: " + LTRIM$(STR$(wInfo))
      opCall = 0
      EXIT FUNCTION
    END IF
  END IF

  ' Return the stream offset where the 4-byte displacement needs to be patched
  opCall = tempRet

END FUNCTION ' opCall

''''''''''''''''''''''''
SUB opExtend (wExtendType)

  op_SafetyCheck "opExtend"

  SELECT CASE wExtendType

    CASE EXTEND_CWD
      emitByteCode &H66
      emitByteCode &H99
    CASE EXTEND_CDQ
      emitByteCode &H99

    CASE EXTEND_CQO
      emitByteCode &H48
      emitByteCode &H99

  END SELECT ' wExtendType

END SUB ' opExtend

''''''''''''''''''''''''
SUB opFlag (wFlagType)

  op_SafetyCheck "opFlag"

  SELECT CASE wFlagType

    CASE FLAG_CLD
      emitByteCode &HFC

    CASE FLAG_STD
      emitByteCode &HFD

    CASE FLAG_CLI
      emitByteCode &HFA

    CASE FLAG_STI
      emitByteCode &HFB

    CASE FLAG_CLC
      emitByteCode &HF8

    CASE FLAG_STC
      emitByteCode &HF9

    CASE FLAG_CMC
      emitByteCode &HF5

  END SELECT ' wFlagType

END SUB ' opFlag

''''''''''''''''''''''''
SUB opHelperEmitSIBoperand (regField AS LONG, baseReg AS LONG, indexReg AS LONG, scaleVal AS LONG, dispVal AS LONG)

  op_SafetyCheck "opHelperEmitSIBoperand"

  DIM modBits AS LONG
  DIM scaleBits AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM sibByte AS _UNSIGNED _BYTE

  IF dispVal = 0 AND (baseReg AND 7) <> 5 THEN
    modBits = 0
  ELSE
    IF dispVal >= -128 AND dispVal <= 127 THEN
      modBits = 1
    ELSE
      modBits = 2
    END IF
  END IF

  modRM = (modBits * 64) + ((regField AND 7) * 8) + 4
  emitByteCode modRM

  SELECT CASE scaleVal

    CASE 2: scaleBits = 1
    CASE 4: scaleBits = 2
    CASE 8: scaleBits = 3
    CASE ELSE: scaleBits = 0

  END SELECT ' scaleVal

  sibByte = (scaleBits * 64) + ((indexReg AND 7) * 8) + (baseReg AND 7)
  emitByteCode sibByte

  IF modBits = 1 THEN
    emitByteCode dispVal AND 255
  ELSE
    IF modBits = 2 THEN
      emitBytes32 dispVal
    END IF
  END IF

END SUB ' opHelperEmitSIBoperand

''''''''''''''''''''''''
FUNCTION opImul& (destReg AS LONG, srcType AS LONG, srcInfo AS _INTEGER64, immVal AS _INTEGER64, opMode AS LONG)

  op_SafetyCheck "opImul"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG
  DIM useImm8 AS LONG
  DIM opSize AS LONG
  DIM isImmMode AS LONG

  checkRegisterBounds destReg, "opImul"

  tempRet = 0
  opSize = 32
  isImmMode = 0

  IF opMode = MODE_IMUL64_REG OR opMode = MODE_IMUL64_IMM OR opMode = MODE_IMUL64_IMM32 THEN opSize = 64
  IF opMode = MODE_IMUL32_IMM OR opMode = MODE_IMUL64_IMM OR opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN isImmMode = 1

  SELECT CASE srcType

    CASE OP_TYPE_REG
      srcReg = srcInfo
      rex = calcRex(opSize, destReg, srcReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
      emitByteCode modRM

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(opSize, destReg, REG_NONE, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      modRM = ((destReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_RSP
      rex = calcRex(opSize, destReg, 4, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      IF srcInfo >= -128 AND srcInfo <= 127 THEN
        emitMemoryOperand destReg, 4, 8, srcInfo
      ELSE
        emitMemoryOperand destReg, 4, 32, srcInfo
      END IF

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG
      baseReg = srcInfo AND 15
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 0, 0

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = srcInfo AND 15
      disp8 = ((srcInfo - baseReg) \ 256) AND 255
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 8, disp8

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = srcInfo AND 15
      disp32 = (srcInfo - baseReg) \ 256
      rex = calcRex(opSize, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex

      IF isImmMode = 1 THEN
        IF opMode = MODE_IMUL32_IMM32 OR opMode = MODE_IMUL64_IMM32 THEN
          useImm8 = 0
        ELSE
          IF immVal >= -128 AND immVal <= 127 THEN useImm8 = 1 ELSE useImm8 = 0
        END IF
        IF useImm8 = 1 THEN emitByteCode &H6B ELSE emitByteCode &H69
      ELSE
        emitByteCode &H0F
        emitByteCode &HAF
      END IF

      emitMemoryOperand destReg, baseReg, 32, disp32

      IF isImmMode = 1 THEN
        IF useImm8 = 1 THEN
          emitByteCode (immVal AND 255)
        ELSE
          emitBytes32 immVal
        END IF
      END IF

  END SELECT ' srcType

  opImul = tempRet

END FUNCTION ' opImul

''''''''''''''''''''''''
FUNCTION opJcc& (condCode, wMode, wTarget AS _UNSIGNED LONG, wJumpType)

  op_SafetyCheck "opJcc"

  DIM tempRet AS _UNSIGNED LONG
  DIM relativeOffset AS _INTEGER64

  tempRet = 0

  IF wJumpType = JCC_TYPE_SHORT THEN
    IF condCode = JCC_JMP THEN
      emitByteCode &HEB
    ELSE
      emitByteCode &H70 + condCode
    END IF

    IF wMode = JCC_MODE_FORWARD THEN
      tempRet = stream.emitPos
      emitByteCode 0
    ELSE
      relativeOffset = wTarget
      relativeOffset = relativeOffset - stream.emitPos
      relativeOffset = relativeOffset - 1
      emitByteCode relativeOffset AND 255
    END IF
  ELSE
    IF condCode = JCC_JMP THEN
      emitByteCode &HE9
    ELSE
      emitByteCode &H0F
      emitByteCode &H80 + condCode
    END IF

    IF wMode = JCC_MODE_FORWARD THEN
      ' We must capture the exact placement of the 4 displacement bytes.
      ' Because prepareBinary calculates offsets via (pOffEmit + 4) to find the instruction
      ' endpoint, we must consistently deliver the exact byte address immediately prior to the payload.
      tempRet = stream.emitPos
      emitBytes32 0
    ELSE
      relativeOffset = wTarget
      relativeOffset = relativeOffset - stream.emitPos
      relativeOffset = relativeOffset - 4
      emitBytes32 relativeOffset
    END IF
  END IF

  opJcc = tempRet

END FUNCTION ' opJcc

''''''''''''''''''''''''
FUNCTION opLea& (destType, destReg AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  op_SafetyCheck "opLea"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  tempRet = 0

  IF destType <> OP_TYPE_REG THEN
    opLea = tempRet
    EXIT FUNCTION
  END IF

  checkRegisterBounds destReg, "opLea"

  SELECT CASE srcType

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      modRM = ((destReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP
      rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      IF srcInfo >= -128 AND srcInfo <= 127 THEN
        emitMemoryOperand destReg, 4, 8, srcInfo
      ELSE
        emitMemoryOperand destReg, 4, 32, srcInfo
      END IF

    CASE OP_TYPE_MEM_RBP
      rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, 5, 32, srcInfo

    CASE OP_TYPE_MEM_REG
      baseReg = srcInfo AND 15
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 0, 0

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = srcInfo AND 15
      disp8 = ((srcInfo - baseReg) \ 256) AND 255
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 8, disp8

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = srcInfo AND 15
      disp32 = (srcInfo - baseReg) \ 256
      rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
      IF rex > 0 THEN emitByteCode rex
      emitByteCode &H8D
      emitMemoryOperand destReg, baseReg, 32, disp32

  END SELECT ' srcType

  opLea = tempRet

END FUNCTION ' opLea

''''''''''''''''''''''''
FUNCTION opLea_SIB (destReg AS LONG, baseReg AS LONG, indexReg AS LONG, scaleVal AS LONG, dispVal AS LONG, opSize AS LONG)

  op_SafetyCheck "opLea_SIB"

  DIM rex AS _UNSIGNED _BYTE
  DIM tempRet AS LONG

  checkRegisterBounds destReg, "opLea_SIB"

  tempRet = 0
  rex = 0

  IF opSize = 64 THEN rex = rex OR &H08
  IF destReg >= 8 THEN rex = rex OR &H04
  IF indexReg >= 8 THEN rex = rex OR &H02
  IF baseReg >= 8 THEN rex = rex OR &H01

  IF rex > 0 THEN emitByteCode &H40 OR rex

  emitByteCode &H8D

  opHelperEmitSIBoperand destReg, baseReg, indexReg, scaleVal, dispVal

  opLea_SIB = tempRet

END FUNCTION ' opLea_SIB

''''''''''''''''''''''''
FUNCTION opMov& (destType, destInfo AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  op_SafetyCheck "opMov"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM uVal64 AS _UNSIGNED _INTEGER64
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM is8bitSource AS LONG
  DIM is0FPrefix AS LONG
  DIM opCodeByte AS _UNSIGNED _BYTE
  DIM destOpSize AS LONG
  DIM tempRet AS LONG

  tempRet = 0 ' Default return value, 0 means no patch position

  IF destType = OP_TYPE_REG THEN
    ' RSP (4) is blocked because stack pointer modifications must go through explicit stack tracking subroutines
    ' RBP (5) is permitted because opMov natively handles MOV RBP, RSP for stack frame setup
    IF destInfo < 0 OR destInfo > 15 OR destInfo = 4 THEN
      ESCAPETEXT "FATAL: Invalid reg target (" + LTRIM$(STR$(destInfo)) + ") in opMov. RSP (4) is protected."
    END IF
  END IF

  SELECT CASE opSizeOrFlag

    CASE MODE_MOVZX32_8, MODE_MOVZX32_16, MODE_MOVZX64_8, MODE_MOVZX64_16, MODE_MOVSX32_8, MODE_MOVSX32_16, MODE_MOVSX64_8, MODE_MOVSX64_16, MODE_MOVSXD
      ' Handles movzx, movsx, movsxd
      IF destType <> OP_TYPE_REG THEN
        opMov = tempRet
        EXIT FUNCTION
      END IF

      destReg = destInfo
      is8bitSource = 0
      is0FPrefix = 1
      destOpSize = 32

      IF opSizeOrFlag = MODE_MOVZX64_8 OR opSizeOrFlag = MODE_MOVZX64_16 OR opSizeOrFlag = MODE_MOVSX64_8 OR opSizeOrFlag = MODE_MOVSX64_16 OR opSizeOrFlag = MODE_MOVSXD THEN
        destOpSize = 64
      END IF

      IF opSizeOrFlag = MODE_MOVZX32_8 OR opSizeOrFlag = MODE_MOVZX64_8 OR opSizeOrFlag = MODE_MOVSX32_8 OR opSizeOrFlag = MODE_MOVSX64_8 THEN
        is8bitSource = 1
      END IF

      IF opSizeOrFlag = MODE_MOVSXD THEN
        is0FPrefix = 0
        opCodeByte = &H63
      ELSE

        SELECT CASE opSizeOrFlag

          CASE MODE_MOVZX32_8, MODE_MOVZX64_8
            opCodeByte = &HB6
          CASE MODE_MOVZX32_16, MODE_MOVZX64_16
            opCodeByte = &HB7
          CASE MODE_MOVSX32_8, MODE_MOVSX64_8
            opCodeByte = &HBE
          CASE MODE_MOVSX32_16, MODE_MOVSX64_16
            opCodeByte = &HBF

        END SELECT ' opSizeOrFlag

      END IF

      SELECT CASE srcType

        CASE OP_TYPE_REG ' MOVZX/MOVSX r_dest, r_src
          srcReg = srcInfo
          rex = calcRex(destOpSize, destReg, srcReg, REG_NONE)
          IF is8bitSource = 1 THEN
            IF srcReg >= 4 AND srcReg <= 7 THEN rex = rex OR &H40
          END IF

          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_MEM_RIP ' MOVZX/MOVSX r_dest, [rip+disp32]
          rex = calcRex(destOpSize, destReg, REG_NONE, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' MOVZX/MOVSX r_dest, [rsp+disp]
          rex = calcRex(destOpSize, destReg, 4, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' MOVZX/MOVSX r_dest, [rbp+disp32]
          rex = calcRex(destOpSize, destReg, 5, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' MOVZX/MOVSX r_dest, [base_reg]
          baseReg = srcInfo AND 15
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' MOVZX/MOVSX r_dest, [base_reg+disp8]
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' MOVZX/MOVSX r_dest, [base_reg+disp32]
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 32, disp32

        CASE OP_TYPE_MEM_GS_ABS32 ' MOVZX/MOVSX r_dest, gs:[abs32]
          emitByteCode &H65
          rex = calcRex(destOpSize, destReg, REG_NONE, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          modRM = ((destReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 srcInfo

        CASE OP_TYPE_MEM_GS_REG_DISP32 ' MOVZX/MOVSX r_dest, gs:[base_reg+disp32]
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          emitByteCode &H65
          rex = calcRex(destOpSize, destReg, baseReg, REG_NONE)
          IF rex > 0 THEN emitByteCode rex
          IF is0FPrefix = 1 THEN emitByteCode &H0F
          emitByteCode opCodeByte
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

      opMov = tempRet
      EXIT FUNCTION ' Extension logic is complete, exit

  END SELECT ' opSizeOrFlag

  IF opSizeOrFlag = MODE_IMM64 THEN
    destReg = destInfo
    rex = calcRex(64, REG_NONE, destReg, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &HB8 + (destReg AND 7)

    uVal64 = srcInfo
    FOR ii = 1 TO 8
      emitByteCode (uVal64 AND 255)
      uVal64 = uVal64 \ 256
    NEXT
    opMov = tempRet
    EXIT FUNCTION
  END IF

  IF opSizeOrFlag = MODE_RIP THEN
    srcReg = srcInfo
    rex = calcRex(64, srcReg, REG_NONE, REG_NONE)
    IF rex > 0 THEN emitByteCode rex
    emitByteCode &H89
    modRM = ((srcReg AND 7) * 8) + 5
    emitByteCode modRM
    tempRet = stream.emitPos
    emitBytes32 0
    opMov = tempRet
    EXIT FUNCTION
  END IF

  SELECT CASE destType

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_REG_ALT
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, destReg, srcReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = &HC0 + ((destReg AND 7) * 8) + (srcReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          IF opSizeOrFlag = 8 THEN
            rex = calcRex(8, REG_NONE, destReg, REG_NONE)
            IF rex > 0 THEN emitByteCode rex
            emitByteCode &HB0 + (destReg AND 7)
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 64 THEN
              uVal64 = srcInfo
              IF srcInfo >= -2147483648 AND srcInfo <= 2147483647 THEN
                rex = calcRex(64, 0, destReg, REG_NONE)
                IF rex > 0 THEN emitByteCode rex
                emitByteCode &HC7
                modRM = &HC0 + (destReg AND 7)
                emitByteCode modRM
                emitBytes32 srcInfo
              ELSE
                rex = calcRex(64, REG_NONE, destReg, REG_NONE)
                IF rex > 0 THEN emitByteCode rex
                emitByteCode &HB8 + (destReg AND 7)
                FOR ii = 1 TO 8
                  emitByteCode (uVal64 AND 255)
                  uVal64 = uVal64 \ 256
                NEXT
              END IF
            ELSE ' opSizeOrFlag = 32 or 16
              rex = calcRex(opSizeOrFlag, REG_NONE, destReg, REG_NONE)
              IF opSizeOrFlag = 16 THEN emitByteCode &H66
              IF rex > 0 THEN emitByteCode rex
              emitByteCode &HB8 + (destReg AND 7)
              IF opSizeOrFlag = 16 THEN
                emitByteCode (srcInfo AND 255)
                emitByteCode ((srcInfo \ 256) AND 255)
              ELSE
                emitBytes32 srcInfo
              END IF
            END IF
          END IF

        CASE OP_TYPE_MEM_RIP ' Memory-to-Register (RIP-relative)
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = ((destReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0

        CASE OP_TYPE_MEM_RSP ' Memory-to-Register (RSP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          IF srcInfo >= -128 AND srcInfo <= 127 THEN
            emitMemoryOperand destReg, 4, 8, srcInfo
          ELSE
            emitMemoryOperand destReg, 4, 32, srcInfo
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory-to-Register (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG ' Memory-to-Register (Register-Indirect, no displacement)
          baseReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 0, 0

        CASE OP_TYPE_MEM_REG_DISP8 ' Memory-to-Register (Register-Indirect with 8-bit disp)
          baseReg = srcInfo AND 15
          disp8 = ((srcInfo - baseReg) \ 256) AND 255
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 8, disp8

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory-to-Register (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 32, disp32

        CASE OP_TYPE_MEM_GS_ABS32 ' Memory-to-Register (GS Segment Absolute 32-bit)
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, destReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          modRM = ((destReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 srcInfo

        CASE OP_TYPE_MEM_GS_REG_DISP32 ' Memory-to-Register (GS Segment Register-Indirect 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H8A ELSE emitByteCode &H8B
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Register-to-Memory (RIP-relative)
      srcReg = srcInfo
      rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
      IF opSizeOrFlag = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex
      IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
      modRM = ((srcReg AND 7) * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RSP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RSP-relative)
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand 0, 4, 8, destInfo
          ELSE
            emitMemoryOperand 0, 4, 32, destInfo
          END IF
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Memory (RBP-relative)
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, 5, 32, destInfo

        CASE OP_TYPE_IMM ' Immediate-to-Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, 5, 32, destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 0, 0

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 0, 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 8, disp8

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 8, disp8
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_ABS32 ' Register/Immediate-to-Memory (GS Segment Absolute 32-bit)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = ((srcReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          modRM = 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_REG_DISP32 ' Register/Immediate-to-Memory (GS Segment Register-Indirect 32-bit disp)
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opMov = tempRet

END FUNCTION ' opMov

''''''''''''''''''''''''
SUB opPopReg (wReg)

  op_SafetyCheck "opPopReg"

  ' RSP (4) and RBP (5) are strictly protected from POP to prevent stack frame desynchronization
  ' The backend epilogues in tira_EndAndProcess manually bypass this to tear down stack frames

  IF wReg < 0 OR wReg > 15 OR wReg = 4 OR wReg = 5 THEN
    ESCAPETEXT2 "FATAL: Invalid reg target (" + LTRIM$(STR$(wReg)) + ") in opPopReg.", "RSP (4) and RBP (5) are protected."
  END IF

  ' Safety bounds check to ensure we do not underflow the compiler's tracked stack frame
  IF stack.currentStackOffset - 8 < 0 THEN
    routineName$ = currentSubName$

    IF routineName$ = "" THEN
      IF isCompilingRT = 1 THEN
        routineName$ = "RUNTIME"
      ELSE
        routineName$ = "MAIN"
      END IF
    END IF

    msg1$ = "FATAL: opPopReg underflow | Reg=" + LTRIM$(STR$(wReg)) + " Stack=" + LTRIM$(STR$(stack.currentStackOffset)) + "->" + LTRIM$(STR$(stack.currentStackOffset - 8)) + " Emit=&H" + HEX$(stream.emitPos)
    msg2$ = "Line=" + LTRIM$(STR$(currentLineNumber)) + " Flat=" + LTRIM$(STR$(pass5.LINE)) + " Routine=" + routineName$ + " Scope=" + LTRIM$(STR$(currentScopeID)) + " Pass=" + LTRIM$(STR$(pass5.Mode)) + " RT=" + LTRIM$(STR$(isCompilingRT))
    ESCAPETEXT2 msg1$, msg2$
  END IF

  IF wReg >= 8 THEN
    emitByteCode &H41
    emitByteCode (&H58 + (wReg AND 7))
  ELSE
    emitByteCode (&H58 + wReg)
  END IF

  stack.currentStackOffset = stack.currentStackOffset - 8
  ff = updateStackAlignment

END SUB ' opPopReg

''''''''''''''''''''''''
SUB opPushReg (wReg)

  op_SafetyCheck "opPushReg"

  ' Unlike POP which overwrites registers, PUSH only reads them
  ' Therefore RSP (4) and RBP (5) are safe to use here without strict manual protection
  checkRegisterBounds wReg, "opPushReg"

  IF wReg >= 8 THEN
    emitByteCode &H41
    emitByteCode (&H50 + (wReg AND 7))
  ELSE
    emitByteCode (&H50 + wReg)
  END IF

  stack.currentStackOffset = stack.currentStackOffset + 8
  ff = updateStackAlignment

END SUB ' opPushReg

''''''''''''''''''''''''
SUB opRet

  op_SafetyCheck "opRet"

  emitByteCode &HC3

END SUB ' opRet

''''''''''''''''''''''''
FUNCTION opSetcc (passCondCode, passDestReg)

  op_SafetyCheck "opSetcc"

  DIM rex AS _UNSIGNED _BYTE
  DIM modRM AS _UNSIGNED _BYTE
  DIM tempRet AS LONG

  checkRegisterBounds passDestReg, "opSetcc"

  tempRet = 0
  rex = 0

  IF passDestReg >= 8 THEN
    rex = rex OR &H01
  END IF

  ' If using SIL, DIL, BPL, SPL (regs 4-7) for an 8-bit operation, we need an empty REX prefix
  IF passDestReg >= 4 AND passDestReg <= 7 THEN
    rex = rex OR &H40
  END IF

  IF rex > 0 THEN emitByteCode &H40 OR rex

  emitByteCode &H0F
  emitByteCode &H90 + passCondCode

  modRM = &HC0 + (passDestReg AND 7)
  emitByteCode modRM

  opSetcc = tempRet

END FUNCTION ' opSetcc

''''''''''''''''''''''''
FUNCTION opSSE& (sseOpCode AS LONG, destType AS LONG, destInfo AS LONG, srcType AS LONG, srcInfo AS LONG, opMode AS LONG)

  op_SafetyCheck "opSSE"

  DIM tempRet AS LONG
  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM prefix AS LONG
  DIM opByte AS LONG
  DIM isReverse AS LONG
  DIM primaryReg AS LONG
  DIM rmReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM opSize AS LONG

  tempRet = 0

  IF destType = OP_TYPE_REG THEN checkRegisterBounds destInfo, "opSSE"

  prefix = 0
  opByte = 0
  isReverse = 0
  opSize = 32

  IF opMode = MODE_SSE_SINGLE THEN prefix = &HF3
  IF opMode = MODE_SSE_DOUBLE THEN prefix = &HF2

  SELECT CASE sseOpCode

    CASE SSE_ADD: opByte = &H58
    CASE SSE_SUB: opByte = &H5C
    CASE SSE_MUL: opByte = &H59
    CASE SSE_DIV: opByte = &H5E

    CASE SSE_MOV
      IF destType = OP_TYPE_REG THEN
        opByte = &H10
      ELSE
        opByte = &H11
        isReverse = 1
      END IF

    CASE SSE_CVTSI2SD
      opSize = 64
      opByte = &H2A

    CASE SSE_CVTTSD2SI
      opSize = 64
      opByte = &H2C
      isReverse = 0

    CASE SSE_CVTSD2SI
      opSize = 64
      opByte = &H2D
      isReverse = 0

    CASE SSE_CVTSS2SD, SSE_CVTSD2SS
      opByte = &H5A

    CASE SSE_MOVQ_XMM_REG
      prefix = &H66
      opSize = 64
      opByte = &H6E
      isReverse = 0

    CASE SSE_MOVQ_REG_XMM
      prefix = &H66
      opSize = 64
      opByte = &H7E
      isReverse = 1

    CASE SSE_UCOMI
      IF opMode = MODE_SSE_SINGLE THEN prefix = 0
      IF opMode = MODE_SSE_DOUBLE THEN prefix = &H66
      opByte = &H2E

    CASE SSE_XOR
      IF opMode = MODE_SSE_SINGLE THEN prefix = 0
      IF opMode = MODE_SSE_DOUBLE THEN prefix = &H66
      opByte = &H57

  END SELECT ' sseOpCode

  IF isReverse = 1 THEN
    primaryReg = srcInfo
    rmReg = destInfo
  ELSE
    primaryReg = destInfo
    rmReg = srcInfo
  END IF

  baseReg = REG_NONE
  IF isReverse = 1 THEN
    IF destType = OP_TYPE_REG THEN baseReg = rmReg
    IF destType = OP_TYPE_MEM_RSP THEN baseReg = 4
    IF destType = OP_TYPE_MEM_RBP THEN baseReg = 5
    IF destType = OP_TYPE_MEM_REG OR destType = OP_TYPE_MEM_REG_DISP8 OR destType = OP_TYPE_MEM_REG_DISP32 THEN baseReg = rmReg AND 15
  ELSE
    IF srcType = OP_TYPE_REG THEN baseReg = rmReg
    IF srcType = OP_TYPE_MEM_RSP THEN baseReg = 4
    IF srcType = OP_TYPE_MEM_RBP THEN baseReg = 5
    IF srcType = OP_TYPE_MEM_REG OR srcType = OP_TYPE_MEM_REG_DISP8 OR srcType = OP_TYPE_MEM_REG_DISP32 THEN baseReg = rmReg AND 15
  END IF

  rex = calcRex(opSize, primaryReg, baseReg, REG_NONE)

  IF prefix <> 0 THEN emitByteCode prefix
  IF rex > 0 THEN emitByteCode rex
  emitByteCode &H0F
  emitByteCode opByte

  IF isReverse = 1 THEN

    SELECT CASE destType

      CASE OP_TYPE_REG
        modRM = &HC0 + ((primaryReg AND 7) * 8) + (rmReg AND 7)
        emitByteCode modRM

      CASE OP_TYPE_MEM_RIP
        modRM = ((primaryReg AND 7) * 8) + 5
        emitByteCode modRM
        tempRet = stream.emitPos
        emitBytes32 0

      CASE OP_TYPE_MEM_RSP
        IF rmReg >= -128 AND rmReg <= 127 THEN
          emitMemoryOperand primaryReg, 4, 8, rmReg
        ELSE
          emitMemoryOperand primaryReg, 4, 32, rmReg
        END IF

      CASE OP_TYPE_MEM_RBP
        emitMemoryOperand primaryReg, 5, 32, rmReg

      CASE OP_TYPE_MEM_REG
        baseReg = rmReg AND 15
        emitMemoryOperand primaryReg, baseReg, 0, 0

      CASE OP_TYPE_MEM_REG_DISP8
        baseReg = rmReg AND 15
        disp8 = ((rmReg - baseReg) \ 256) AND 255
        emitMemoryOperand primaryReg, baseReg, 8, disp8

      CASE OP_TYPE_MEM_REG_DISP32
        baseReg = rmReg AND 15
        disp32 = (rmReg - baseReg) \ 256
        emitMemoryOperand primaryReg, baseReg, 32, disp32

    END SELECT ' destType

  ELSE

    SELECT CASE srcType

      CASE OP_TYPE_REG
        modRM = &HC0 + ((primaryReg AND 7) * 8) + (rmReg AND 7)
        emitByteCode modRM

      CASE OP_TYPE_MEM_RIP
        modRM = ((primaryReg AND 7) * 8) + 5
        emitByteCode modRM
        tempRet = stream.emitPos
        emitBytes32 0

      CASE OP_TYPE_MEM_RSP
        IF rmReg >= -128 AND rmReg <= 127 THEN
          emitMemoryOperand primaryReg, 4, 8, rmReg
        ELSE
          emitMemoryOperand primaryReg, 4, 32, rmReg
        END IF

      CASE OP_TYPE_MEM_RBP
        emitMemoryOperand primaryReg, 5, 32, rmReg

      CASE OP_TYPE_MEM_REG
        baseReg = rmReg AND 15
        emitMemoryOperand primaryReg, baseReg, 0, 0

      CASE OP_TYPE_MEM_REG_DISP8
        baseReg = rmReg AND 15
        disp8 = ((rmReg - baseReg) \ 256) AND 255
        emitMemoryOperand primaryReg, baseReg, 8, disp8

      CASE OP_TYPE_MEM_REG_DISP32
        baseReg = rmReg AND 15
        disp32 = (rmReg - baseReg) \ 256
        emitMemoryOperand primaryReg, baseReg, 32, disp32

    END SELECT ' srcType

  END IF

  opSSE = tempRet

END FUNCTION ' opSSE

''''''''''''''''''''''''
SUB opString (wStrOp, wPrefix, wSize)

  op_SafetyCheck "opString"

  IF wPrefix = REP_REP THEN emitByteCode &HF3
  IF wPrefix = REP_REPNE THEN emitByteCode &HF2

  IF wSize = 16 THEN emitByteCode &H66
  IF wSize = 64 THEN emitByteCode &H48

  baseOp = 0

  SELECT CASE wStrOp

    CASE STR_MOVS
      baseOp = &HA4

    CASE STR_CMPS
      baseOp = &HA6

    CASE STR_STOS
      baseOp = &HAA

    CASE STR_LODS
      baseOp = &HAC

    CASE STR_SCAS
      baseOp = &HAE

  END SELECT ' wStrOp

  IF wSize <> 8 THEN baseOp = baseOp + 1

  emitByteCode baseOp

END SUB ' opString

''''''''''''''''''''''''
SUB opSubRsp32 (wVal AS LONG)

  op_SafetyCheck "opSubRsp32"

  'Using opALU instead of this function will output 4 bytes instead of 7 bytes since opALU compresses values under 128

  emitByteCode &H48 ' REX.W
  emitByteCode &H81 ' ALU format 81
  emitByteCode &HEC ' ModRM for SUB RSP
  emitBytes32 wVal

  stack.currentStackOffset = stack.currentStackOffset + wVal
  ff = updateStackAlignment

END SUB ' opSubRsp32

''''''''''''''''''''''''
FUNCTION opTest& (destType, destInfo AS LONG, srcType, srcInfo AS _INTEGER64, opSizeOrFlag)

  op_SafetyCheck "opTest"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM destReg AS LONG
  DIM srcReg AS LONG
  DIM baseReg AS LONG
  DIM disp8 AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  DIM opBase85 AS LONG
  DIM opBaseF7 AS LONG

  tempRet = 0

  IF destType = OP_TYPE_REG THEN checkRegisterBounds destInfo, "opTest"

  opBase85 = &H85
  opBaseF7 = &HF7

  IF opSizeOrFlag = 8 THEN
    opBase85 = &H84
    opBaseF7 = &HF6
  END IF

  SELECT CASE destType

    CASE OP_TYPE_REG
      destReg = destInfo

      SELECT CASE srcType

        CASE OP_TYPE_REG ' Register-to-Register
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          emitByteCode opBase85
          modRM = &HC0 + ((srcReg AND 7) * 8) + (destReg AND 7)
          emitByteCode modRM

        CASE OP_TYPE_IMM ' Immediate-to-Register
          rex = calcRex(opSizeOrFlag, 0, destReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex

          emitByteCode opBaseF7
          modRM = &HC0 + (destReg AND 7) ' reg field is 0 for TEST imm
          emitByteCode modRM

          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

        CASE OP_TYPE_MEM_RBP ' Memory (RBP-relative)
          rex = calcRex(opSizeOrFlag, destReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand destReg, 5, 32, srcInfo

        CASE OP_TYPE_MEM_REG_DISP32 ' Memory (Register-Indirect with 32-bit disp)
          baseReg = srcInfo AND 15
          disp32 = (srcInfo - baseReg) \ 256
          rex = calcRex(opSizeOrFlag, destReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand destReg, baseReg, 32, disp32

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RIP ' Memory (RIP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          modRM = ((srcReg AND 7) * 8) + 5
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          modRM = 5 ' reg field is 0
          emitByteCode modRM
          tempRet = stream.emitPos
          emitBytes32 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RSP ' Memory (RSP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand srcReg, 4, 8, destInfo
          ELSE
            emitMemoryOperand srcReg, 4, 32, destInfo
          END IF
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, 4, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          IF destInfo >= -128 AND destInfo <= 127 THEN
            emitMemoryOperand 0, 4, 8, destInfo
          ELSE
            emitMemoryOperand 0, 4, 32, destInfo
          END IF
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_RBP ' Memory (RBP-relative)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          rex = calcRex(opSizeOrFlag, srcReg, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, 5, 32, destInfo
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, 5, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, 5, 32, destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG
      baseReg = destInfo AND 15

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 0, 0
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 0, 0
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = destInfo AND 15
      disp8 = ((destInfo - baseReg) \ 256) AND 255

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 8, disp8
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 8, disp8
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBase85
          emitMemoryOperand srcReg, baseReg, 32, disp32
        CASE OP_TYPE_IMM
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          emitByteCode opBaseF7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_ABS32 ' Register/Immediate-to-Memory (GS Segment Absolute 32-bit)

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          modRM = ((srcReg AND 7) * 8) + 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, REG_NONE, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          modRM = 4
          emitByteCode modRM
          emitByteCode &H25
          emitBytes32 destInfo
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

    CASE OP_TYPE_MEM_GS_REG_DISP32 ' Register/Immediate-to-Memory (GS Segment Register-Indirect 32-bit disp)
      baseReg = destInfo AND 15
      disp32 = (destInfo - baseReg) \ 256

      SELECT CASE srcType

        CASE OP_TYPE_REG
          srcReg = srcInfo AND 15
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, srcReg, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &H88 ELSE emitByteCode &H89
          emitMemoryOperand srcReg, baseReg, 32, disp32

        CASE OP_TYPE_IMM
          emitByteCode &H65
          rex = calcRex(opSizeOrFlag, 0, baseReg, REG_NONE)
          IF opSizeOrFlag = 16 THEN emitByteCode &H66
          IF rex > 0 THEN emitByteCode rex
          IF opSizeOrFlag = 8 THEN emitByteCode &HC6 ELSE emitByteCode &HC7
          emitMemoryOperand 0, baseReg, 32, disp32
          IF opSizeOrFlag = 8 THEN
            emitByteCode (srcInfo AND 255)
          ELSE
            IF opSizeOrFlag = 16 THEN
              emitByteCode (srcInfo AND 255)
              emitByteCode ((srcInfo \ 256) AND 255)
            ELSE
              emitBytes32 srcInfo
            END IF
          END IF

      END SELECT ' srcType

  END SELECT ' destType

  opTest = tempRet

END FUNCTION ' opTest

''''''''''''''''''''''''
FUNCTION opUnary& (passOpCode, passDestType, passDestInfo, passOpSize)

  op_SafetyCheck "opUnary"

  DIM rex AS LONG
  DIM modRM AS _UNSIGNED _BYTE
  DIM baseReg AS LONG
  DIM disp AS LONG
  DIM disp32 AS LONG
  DIM tempRet AS LONG

  tempRet = 0

  IF passDestType = OP_TYPE_REG THEN
    IF passDestInfo < 0 OR passDestInfo > 15 OR passDestInfo = 4 OR passDestInfo = 5 THEN
      ESCAPETEXT "FATAL: Invalid reg target (" + LTRIM$(STR$(passDestInfo)) + ") in opUnary. RSP (4) and RBP (5) are protected."
    END IF
  END IF

  SELECT CASE passDestType

    CASE OP_TYPE_REG
      baseReg = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      modRM = &HC0 + (passOpCode * 8) + (baseReg AND 7)
      emitByteCode modRM

    CASE OP_TYPE_MEM_RIP
      rex = calcRex(passOpSize, REG_NONE, REG_NONE, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      modRM = (passOpCode * 8) + 5
      emitByteCode modRM
      tempRet = stream.emitPos
      emitBytes32 0

    CASE OP_TYPE_MEM_RSP
      disp = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, 4, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      IF disp >= -128 AND disp <= 127 THEN
        emitMemoryOperand passOpCode, 4, 8, disp
      ELSE
        emitMemoryOperand passOpCode, 4, 32, disp
      END IF

    CASE OP_TYPE_MEM_RBP
      disp = passDestInfo
      rex = calcRex(passOpSize, REG_NONE, 5, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, 5, 32, disp

    CASE OP_TYPE_MEM_REG_DISP8
      baseReg = passDestInfo AND 15
      disp8 = ((passDestInfo - baseReg) \ 256) AND 255
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, baseReg, 8, disp8

    CASE OP_TYPE_MEM_REG_DISP32
      baseReg = passDestInfo AND 15
      disp32 = (passDestInfo - baseReg) \ 256
      rex = calcRex(passOpSize, REG_NONE, baseReg, REG_NONE)
      IF passOpSize = 16 THEN emitByteCode &H66
      IF rex > 0 THEN emitByteCode rex

      IF passOpSize = 8 THEN
        IF passOpCode <= 1 THEN emitByteCode &HFE ELSE emitByteCode &HF6
      ELSE
        IF passOpCode <= 1 THEN emitByteCode &HFF ELSE emitByteCode &HF7
      END IF

      emitMemoryOperand passOpCode, baseReg, 32, disp32

  END SELECT ' passDestType

  opUnary = tempRet

END FUNCTION ' opUnary

''''''''''''''''''''''''
FUNCTION parse_ABS$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM resVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM argDataType AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "ABS", 3) = 0 THEN
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionNumericArgId(startIdx + 2, endIdx - 1, allowImplicit, "INTRINSIC REQUIRES NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  argDataType = exprIs.DataType

  scratchIdx = tiraResolveHoistVarId&("ABS", "_VAL")
  IF scratchIdx = 0 THEN
    tira_Cancel
    parse_ABS$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ' Override the default string/single nature dynamically so the temporary variable perfectly matches the supplied argument's byte size and precision
  symbols(scratchIdx).DataType = argDataType

  resVarIdx = tiraDimVarId&("T", argDataType)

  tiraAssignId resVarIdx, arg1Type, arg1Val

  skipLblIdx = tiraLabelCreateNewId&("SKIP_ABS")

  ' If resVar$ >= 0, skip to the end. Since TC_JMP_COND fully supports floating point checks internally via UCOMI, we can safely run this generically
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraOpId2 TC_NEG, TIRA_ARG_SYMBOL, resVarIdx, TIRA_ARG_SYMBOL, resVarIdx
  tiraLabelId skipLblIdx

  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = argDataType
  exprIs.IsTemp = 1
  parse_ABS$ = scratchName$


END FUNCTION ' parse_ABS$

''''''''''''''''''''''''
FUNCTION parse_CIRCLE (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM hasArc AS LONG
  DIM hasAspect AS LONG
  DIM tokIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM comma5 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM rEnd AS LONG
  DIM colEnd AS LONG
  DIM radStart AS LONG
  DIM radEnd AS LONG
  DIM aspStart AS LONG
  DIM aspEnd AS LONG
  DIM xVar$
  DIM yVar$
  DIM radVar$
  DIM colVar$
  DIM startVar$
  DIM endVar$
  DIM aspectVar$
  DIM tmpVar$
  DIM stepX$
  DIM stepY$
  DIM circleChain$
  DIM circleStateReadyLbl$
  DIM circleNoForceLbl$
  DIM circleWarmupState$
  DIM forceTick$
  DIM circleWarmup AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "CIRCLE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  hasStep = 0
  IF lineTokenVals(tokIdx) = TOK_STEP THEN
    hasStep = 1
    tokIdx = tokIdx + 1
    IF tokIdx > endIdx THEN
      throwCompilerError "EXPECTED ( AFTER STEP", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER CIRCLE", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(tokIdx, endIdx)
  comma2 = 0
  comma3 = 0
  comma4 = 0
  comma5 = 0

  IF comma1 > 0 THEN comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 > 0 THEN comma3 = findComma(comma2 + 1, endIdx)
  IF comma3 > 0 THEN comma4 = findComma(comma3 + 1, endIdx)
  IF comma4 > 0 THEN comma5 = findComma(comma4 + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(tokIdx, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "CIRCLE MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  xVar$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF xVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  yVar$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF yVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF hasStep = 1 THEN
    stepX$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, stepX$, xVar$, "!G_GFX_VAL_CUR_X"
    xVar$ = stepX$

    stepY$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_ADD, stepY$, yVar$, "!G_GFX_VAL_CUR_Y"
    yVar$ = stepY$
  END IF

  rEnd = endIdx
  IF comma2 > 0 THEN rEnd = comma2 - 1

  IF comma1 + 1 > rEnd THEN
    throwCompilerErrorAndCancelTira "CIRCLE MISSING RADIUS", ASIS, 0
    EXIT FUNCTION
  END IF

  radVar$ = tiraParseExpressionInt$(comma1 + 1, rEnd, ALIM, "RADIUS MUST BE NUMERIC")
  IF radVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF comma2 > 0 THEN
    colEnd = endIdx
    IF comma3 > 0 THEN colEnd = comma3 - 1
    IF comma2 + 1 > colEnd THEN
      colVar$ = "!G_GFX_VAL_FG"
    ELSE
      colVar$ = tiraParseExpressionInt$(comma2 + 1, colEnd, ALIM, "COLOR MUST BE NUMERIC")
      IF colVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
    END IF
  ELSE
    colVar$ = "!G_GFX_VAL_FG"
  END IF

  startVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign startVar$, "0#"

  endVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign endVar$, "6.283185307179586#"

  aspectVar$ = tiraDimVar$("T", TYPE_DOUBLE)
  tiraAssign aspectVar$, "1#"

  hasArc = 0
  hasAspect = 0

  IF comma3 > 0 THEN
    radStart = comma3 + 1
    radEnd = endIdx
    IF comma4 > 0 THEN radEnd = comma4 - 1
    IF radStart <= radEnd THEN
      tmpVar$ = tiraParseExpressionNumeric$(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssign startVar$, tmpVar$
      hasArc = 1
    END IF
  END IF

  IF comma4 > 0 THEN
    radStart = comma4 + 1
    radEnd = endIdx
    IF comma5 > 0 THEN radEnd = comma5 - 1
    IF radStart <= radEnd THEN
      tmpVar$ = tiraParseExpressionNumeric$(radStart, radEnd, ALIM, "RADIAN MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssign endVar$, tmpVar$
      hasArc = 1
    END IF
  END IF

  IF comma5 > 0 THEN
    aspStart = comma5 + 1
    aspEnd = endIdx
    IF aspStart <= aspEnd THEN
      tmpVar$ = tiraParseExpressionNumeric$(aspStart, aspEnd, ALIM, "ASPECT MUST BE NUMERIC")
      IF tmpVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssign aspectVar$, tmpVar$
      hasAspect = 1
    END IF
  END IF

  IF compileScreenMode > 0 AND hasArc = 0 THEN
    ' Bit zero marks pending pixels and the remaining bits count consecutive full circles
    circleChain$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_AND, circleChain$, "!G_GFX_FLG_DISPLAYI_PENDING", "-2"

    ' Ordinary full circles keep immediate presentation while explicit-aspect constructions get a warmup
    circleWarmup = 1
    IF hasAspect = 1 THEN
      circleWarmup = 16
      IF gfxConfig.SizeX >= 640 THEN circleWarmup = 32
    END IF
    circleWarmupState$ = LTRIM$(STR$(circleWarmup * 2))

    circleStateReadyLbl$ = tiraLabelCreateNew$("CIRCLE_STATE_READY")
    tiraJmpCond "JGE", circleChain$, circleWarmupState$, circleStateReadyLbl$
    tiraOp TC_ADD, circleChain$, circleChain$, "2"
    tiraLabel circleStateReadyLbl$
  END IF

  tiraCall "RT_CIRCLE", 9, xVar$ + ", " + yVar$ + ", " + radVar$ + ", " + colVar$ + ", " + startVar$ + ", " + endVar$ + ", " + LTRIM$(STR$(hasArc)) + ", " + aspectVar$ + ", " + LTRIM$(STR$(hasAspect))

  ' Update graphics tracking coordinates
  tiraAssign "!G_GFX_VAL_CUR_X", xVar$
  tiraAssign "!G_GFX_VAL_CUR_Y", yVar$

  IF compileScreenMode > 0 AND hasArc = 0 THEN
    circleNoForceLbl$ = tiraLabelCreateNew$("CIRCLE_NO_FORCE")
    tiraJmpCond "JL", circleChain$, circleWarmupState$, circleNoForceLbl$
    tiraAssign circleChain$, circleWarmupState$

    ' A sustained circle animation retains the faster-than-60 Hz redraw path after construction settles
    tiraCall "IAT_GETTICKCOUNT", 0, ""
    forceTick$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_GET_RET, forceTick$
    tiraOp TC_SUB, "!G_GFX_VAL_DISPLAYI_TIMER", forceTick$, "16"

    tiraLabel circleNoForceLbl$

    tiraOp TC_ADD, "!G_GFX_FLG_DISPLAYI_PENDING", circleChain$, "1"
    tiraInjectPendingDisplayFlush
  ELSE
    tiraTriggerAutoDisplay
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_CIRCLE = 1

END FUNCTION ' parse_CIRCLE

''''''''''''''''''''''''
FUNCTION parse_CLS (startIdx)

  DIM endIdx AS LONG
  DIM hasArg AS LONG
  DIM argIsLiteral AS LONG
  DIM argFirst AS STRING * 1
  DIM textRowHeight AS LONG
  DIM argNumeric$

  endIdx = lineTokenCount - 1

  hasArg = 0
  argStr$ = ""

  tira_Start

  ' Check if there is an argument provided for CLS
  IF endIdx > startIdx THEN
    hasArg = 1
    argNumeric$ = tiraParseExpressionNumeric$(startIdx + 1, endIdx, ALIM, "CLS REQUIRES NUMERIC ARGUMENT")
    IF argNumeric$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    argStr$ = tiraForceInt$(argNumeric$)

    argIsLiteral = 0
    argFirst = LEFT$(argNumeric$, 1)
    IF (argFirst >= "0" AND argFirst <= "9") OR argFirst = "-" OR argFirst = "." OR argFirst = "&" THEN
      argIsLiteral = 1
    END IF

    IF cm.ClassicMode = 0 THEN
      IF argIsLiteral = 1 THEN
        IF VAL(argNumeric$) <> 0 THEN
          throwCompilerErrorAndCancelTira "ONLY CLS 0 SUPPORTED OUTSIDE OF CLASSIC MODE", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF

      validArgLbl$ = tiraLabelCreateNew$("CLS_ARG_VALID")
      tiraJmpCond "JE", argNumeric$, "0", validArgLbl$
      tiraFatalError "ONLY CLS 0 SUPPORTED OUTSIDE OF CLASSIC MODE"
      tiraLabel validArgLbl$
    ELSE
      IF argIsLiteral = 1 THEN
        IF VAL(argNumeric$) <> 0 AND VAL(argNumeric$) <> 1 AND VAL(argNumeric$) <> 2 THEN
          throwCompilerErrorAndCancelTira "CLS ARGUMENT MUST BE 0, 1, OR 2", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF

      validArgLbl$ = tiraLabelCreateNew$("CLS_ARG_VALID")
      tiraJmpCond "JE", argNumeric$, "0", validArgLbl$
      tiraJmpCond "JE", argNumeric$, "1", validArgLbl$
      tiraJmpCond "JE", argNumeric$, "2", validArgLbl$
      tiraFatalError "CLS ARGUMENT MUST BE 0, 1, OR 2"
      tiraLabel validArgLbl$
    END IF
  END IF

  ' Handle standard console clearing
  IF cm.HasGraphics = 0 THEN
    ' Get the symbol index for the pre-built clear screen string
    ff = resolveSymbol("!G_INO_DSC_CLSSCR")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    clsScratchIdx = returnedData2
    ' Fill the clear screen string with spaces and a newline
    strVarData$(clsScratchIdx) = STRING$(120, 32) + CHR$(13) + CHR$(10)

    ' Create a temporary variable to hold the console output handle
    hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    ' Call Windows API to get the standard output handle
    tiraCall "IAT_GETSTDHANDLE", 1, "-11"
    ' Retrieve the returned handle into the temp variable
    tiraNew TC_GET_RET, hndVar$

    ' Create a variable for the starting row
    topVar$ = tiraDimVar$("T", TYPE_LONG)
    ' Create a variable for the bottom row
    botVar$ = tiraDimVar$("T", TYPE_LONG)

    ' Create a variable for the cursor row used after clearing
    cursorTopVar$ = tiraDimVar$("T", TYPE_LONG)

    IF hasArg = 1 THEN
      currentViewLbl$ = tiraLabelCreateNew$("CLS_CURRENT_VIEW")
      fullViewLbl$ = tiraLabelCreateNew$("CLS_FULL_VIEW")
      boundsReadyLbl$ = tiraLabelCreateNew$("CLS_BOUNDS_READY")

      tiraJmpCond "JE", argStr$, "0", fullViewLbl$
      tiraJmpCond "JE", argStr$, "1", fullViewLbl$
      tiraJmp currentViewLbl$

      tiraLabel fullViewLbl$
      tiraAssign topVar$, "0"
      tiraAssign botVar$, "25"
      tiraAssign cursorTopVar$, "0"
      tiraJmp boundsReadyLbl$

      tiraLabel currentViewLbl$
      tiraAssign topVar$, "!G_INO_VAL_VIEW_TOP"
      tiraAssign botVar$, "!G_INO_VAL_VIEW_BOT"
      tiraAssign cursorTopVar$, "!G_INO_VAL_VIEW_TOP"

      ' CLS two preserves the last physical console row
      consoleBotOkLbl$ = tiraLabelCreateNew$("CLS_CONSOLE_BOT_OK")
      tiraJmpCond "JLE", botVar$, "24", consoleBotOkLbl$
      tiraAssign botVar$, "24"
      tiraLabel consoleBotOkLbl$

      tiraLabel boundsReadyLbl$
    ELSE
      ' Load the bounds of the current text viewport
      tiraAssign topVar$, "!G_INO_VAL_VIEW_TOP"
      tiraAssign botVar$, "!G_INO_VAL_VIEW_BOT"
      tiraAssign cursorTopVar$, "!G_INO_VAL_VIEW_TOP"
    END IF

    ' Create a variable for the total lines to clear
    linesVar$ = tiraDimVar$("T", TYPE_LONG)
    ' Calculate total lines by subtracting top from bottom
    tiraOp TC_SUB, linesVar$, botVar$, topVar$

    noLinesLbl$ = tiraLabelCreateNew$("CLS_NO_LINES")
    tiraJmpCond "JLE", linesVar$, "0", noLinesLbl$

    ' Create a variable for the string descriptor pointer
    strDesc$ = tiraDimVar$("T", TYPE_INTEGER64)
    ' Assign the value of the clear screen string to the descriptor pointer
    tiraAssign strDesc$, "!G_INO_DSC_CLSSCR"

    ' Create a variable for the string data pointer
    strData$ = tiraDimVar$("T", TYPE_INTEGER64)
    ' Read the memory address of the string data from the descriptor
    tiraNew TC_READ_MEM, strData$ + ", " + strDesc$

    ' Create a variable for the string length
    strLen$ = tiraDimVar$("T", TYPE_LONG)
    ' Advance the descriptor pointer by eight bytes to point to the length
    tiraOp TC_ADD, strDesc$, strDesc$, "8"
    ' Read the length from the descriptor memory
    tiraNew TC_READ_MEM, strLen$ + ", " + strDesc$

    ' Create a variable for the bytes written pointer used by WriteFile
    numWrt$ = tiraDimVar$("T", TYPE_LONG)
    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

    ' Create a new jump label for the clearing loop
    loopLbl$ = tiraLabelCreateNew$("CLS_LOOP")
    ' Place the loop label in the TIRA queue
    tiraLabel loopLbl$

    ' Create a variable for the Windows API COORD structure
    coord$ = tiraDimVar$("T", TYPE_LONG)
    ' Shift the Y coordinate to the high word to format the COORD value
    tiraOp TC_MUL, coord$, topVar$, "65536"

    ' Move the console cursor to the current row
    tiraCall "IAT_SETCONSOLECURSORPOSITION", 2, hndVar$ + ", " + coord$
    ' Write the blank spaces to the row
    tiraCall "IAT_WRITEFILE", 5, hndVar$ + ", " + strData$ + ", " + strLen$ + ", " + numWrtPtr$ + ", 0"

    ' Increment the current row variable
    tiraOp TC_ADD, topVar$, topVar$, "1"
    ' Decrement the remaining lines counter
    tiraOp TC_SUB, linesVar$, linesVar$, "1"
    ' Jump back to the top of the loop if lines remain
    tiraJmpCond "JG", linesVar$, "0", loopLbl$

    tiraLabel noLinesLbl$

    ' Calculate the reset coordinate for the top-left of the viewport
    coordReset$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, coordReset$, cursorTopVar$, "65536"

    ' Reset the cursor to the top left of the active viewport when finished
    tiraCall "IAT_SETCONSOLECURSORPOSITION", 2, hndVar$ + ", " + coordReset$

  ELSE
    ' Handle graphics window clearing
    ' Default to using the parsed argument for the clear type
    clsType$ = argStr$
    ' With no argument QuickBASIC clears the active graphics viewport
    IF clsType$ = "" THEN clsType$ = "1"

    clearFullFb$ = tiraLabelCreateNew$("CLS_FULL_FB")
    clearViewFb$ = tiraLabelCreateNew$("CLS_VIEW_FB")
    clearTextFb$ = tiraLabelCreateNew$("CLS_TEXT_FB")
    clearFbDone$ = tiraLabelCreateNew$("CLS_FB_DONE")

    tiraJmpCond "JE", clsType$, "0", clearFullFb$
    tiraJmpCond "JE", clsType$, "1", clearViewFb$
    tiraJmp clearTextFb$

    ' CLS one clears only the active graphics viewport
    tiraLabel clearViewFb$

    viewWidth$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, viewWidth$, "!G_GFX_VAL_VIEW_X2", "!G_GFX_VAL_VIEW_X1"

    viewRows$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, viewRows$, "!G_GFX_VAL_VIEW_Y2", "!G_GFX_VAL_VIEW_Y1"

    tiraAssign "!G_GFX_VAL_CUR_X", "0"
    tiraAssign "!G_GFX_VAL_CUR_Y", "0"
    tiraAssign "!G_INO_VAL_TEXT_X", "0"
    tiraAssign "!G_INO_VAL_TEXT_Y", "0"

    tiraJmpCond "JLE", viewWidth$, "0", clearFbDone$
    tiraJmpCond "JLE", viewRows$, "0", clearFbDone$

    viewStartOffset$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, viewStartOffset$, "!G_GFX_VAL_VIEW_Y1", LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
    tiraOp TC_ADD, viewStartOffset$, viewStartOffset$, "!G_GFX_VAL_VIEW_X1"

    fbPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign fbPtr$, "!G_GFX_PTR_DEST_FRMB"
    tiraOp TC_ADD, fbPtr$, fbPtr$, viewStartOffset$

    clearViewRow$ = tiraLabelCreateNew$("CLS_VIEW_ROW")
    tiraLabel clearViewRow$
    tiraMemSet fbPtr$, "!G_GFX_VAL_LAST_BG", viewWidth$
    tiraOp TC_ADD, fbPtr$, fbPtr$, LTRIM$(RTRIM$(STR$(gfxConfig.SizeX)))
    tiraOp TC_SUB, viewRows$, viewRows$, "1"
    tiraJmpCond "JG", viewRows$, "0", clearViewRow$
    tiraJmp clearFbDone$

    ' CLS zero clears the complete graphics screen regardless of VIEW PRINT
    tiraLabel clearFullFb$
    fbPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign fbPtr$, "!G_GFX_PTR_DEST_FRMB"
    tiraMemSet fbPtr$, "!G_GFX_VAL_LAST_BG", LTRIM$(RTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY)))

    tiraAssign "!G_GFX_VAL_CUR_X", "0"
    tiraAssign "!G_GFX_VAL_CUR_Y", "0"
    tiraAssign "!G_INO_VAL_TEXT_X", "0"
    tiraAssign "!G_INO_VAL_TEXT_Y", "0"
    tiraWriteMem "!G_GFX_PTR_DEST_CNT", "0", "4"
    tiraJmp clearFbDone$

    ' CLS two clears the framebuffer rows occupied by the active text viewport
    tiraLabel clearTextFb$

    textTop$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign textTop$, "!G_INO_VAL_VIEW_TOP"

    textBot$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign textBot$, "!G_INO_VAL_VIEW_BOT"

    textRowHeight = 8
    IF cm.ClassicMode = 1 THEN
      SELECT CASE compileScreenMode

        CASE 9, 10
          textRowHeight = 14

        CASE 11, 12
          textRowHeight = 16

      END SELECT ' compileScreenMode
    END IF

    fontHeight$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign fontHeight$, "!G_GFX_V32_FONTHEIGHT"

    fontHeightReadyLbl$ = tiraLabelCreateNew$("CLS_FONT_READY")
    tiraJmpCond "JG", fontHeight$, "0", fontHeightReadyLbl$
    tiraAssign fontHeight$, LTRIM$(STR$(textRowHeight))
    tiraLabel fontHeightReadyLbl$

    ' QuickBASIC reserves the last physical text row when processing CLS two
    textBottomLimit$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign textBottomLimit$, LTRIM$(STR$(gfxConfig.SizeY))
    tiraOp TC_SUB, textBottomLimit$, textBottomLimit$, fontHeight$

    lastTextRowLbl$ = tiraLabelCreateNew$("CLS_LAST_TEXT_ROW")
    tiraJmpCond "JLE", textBot$, textBottomLimit$, lastTextRowLbl$
    tiraAssign textBot$, textBottomLimit$
    tiraLabel lastTextRowLbl$

    textRows$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, textRows$, textBot$, textTop$

    noTextRowsLbl$ = tiraLabelCreateNew$("CLS_NO_TEXT_ROWS")
    tiraJmpCond "JLE", textRows$, "0", noTextRowsLbl$

    textStartOffset$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, textStartOffset$, textTop$, LTRIM$(STR$(gfxConfig.SizeX))

    textFbPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign textFbPtr$, "!G_GFX_PTR_DEST_FRMB"
    tiraOp TC_ADD, textFbPtr$, textFbPtr$, textStartOffset$

    textClearSize$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_MUL, textClearSize$, textRows$, LTRIM$(STR$(gfxConfig.SizeX))
    tiraMemSet textFbPtr$, "!G_GFX_VAL_LAST_BG", textClearSize$

    tiraLabel noTextRowsLbl$

    tiraAssign "!G_GFX_VAL_CUR_X", "0"
    tiraAssign "!G_GFX_VAL_CUR_Y", textTop$
    tiraAssign "!G_INO_VAL_TEXT_X", "0"
    tiraAssign "!G_INO_VAL_TEXT_Y", textTop$
    tiraWriteMem "!G_GFX_PTR_DEST_CNT", "0", "4"

    tiraLabel clearFbDone$

    tiraTriggerAutoDisplay
  END IF

  tiraScheduleHeapReset
  ' Compile the queued TIRA commands into machine code
  tira_EndAndProcess

  parse_CLS = 1

END FUNCTION ' parse_CLS

''''''''''''''
'' FUNCTION parse_DEVICE$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the description string of a specified connected input device

''''''''''''''
'' FUNCTION parse_DEVICEINPUT$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Polls and processes input events from connected hardware devices

''''''''''''''
'' FUNCTION parse_DEVICES$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the total count of connected hardware input devices

''''''''''''''''''''''''
FUNCTION parse_DIM (startIdx)

  parse_DIM = parse_DIM_Core(startIdx, 0)

END FUNCTION ' parse_DIM

''''''''''''''''''''''''
FUNCTION parse_DIM_Core (startIdx, isStaticVar AS LONG)

  ' Reallocates memory for a dynamic array with new dimensions

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isShared AS LONG
  DIM isArray AS LONG
  DIM parenStart AS LONG
  DIM parenEnd AS LONG
  DIM commaIdx AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM evalStart AS LONG
  DIM isNum AS LONG
  DIM vIdx AS LONG
  DIM fixedLen AS LONG
  DIM dtMapped AS LONG
  DIM elemSize AS LONG
  DIM actualName$
  DIM typeData AS LONG

  DIM dynDimTotalVars$(255)
  DIM dynDimLBoundVars$(255)
  DIM numDims AS LONG
  DIM isNumArray AS LONG
  DIM totalStaticElems AS _INTEGER64
  DIM staticStride AS _INTEGER64
  DIM staticLayoutStart AS LONG
  DIM dimEnd AS LONG
  DIM tokParseIdx AS LONG
  DIM elementCount AS LONG
  DIM parsedLBound$
  DIM lBoundVar$
  DIM numElemsVar$
  DIM numElems64$
  DIM lBoundTok$

  DIM prevIsExplicit AS LONG
  DIM prevDataType AS LONG
  DIM prevUDTIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM tokText$
  DIM firstCh$

  DIM dimOkLbl$
  DIM prevTotal$
  DIM checkDiv$
  DIM multOkLbl$
  DIM allocOkLbl$
  DIM checkAllocDiv$

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  isShared = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_SHARED THEN
      isShared = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  IF endIdx < tokIdx THEN
    IF isStaticVar = 1 THEN
      throwCompilerError "MALFORMED STATIC", ASIS, 0
    ELSE
      throwCompilerError "MALFORMED DIM", ASIS, 0
    END IF
    EXIT FUNCTION
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    aTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED IDENTIFIER", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1
    isArray = 0
    numDims = 0
    totalStaticElems = 1
    isNumArray = 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        isArray = 1
        parenStart = tokIdx

        ff = findMatchingParen(parenStart, endIdx)
        IF ff = 0 THEN
          throwCompilerErrorAndCancelTira "MALFORMED ARRAY DIMENSION", ASIS, 0
          EXIT FUNCTION
        END IF
        parenEnd = returnedData2

        tokParseIdx = parenStart + 1
        DO
          commaIdx = findComma(tokParseIdx, parenEnd - 1)
          IF commaIdx > 0 THEN
            dimEnd = commaIdx - 1
          ELSE
            dimEnd = parenEnd - 1
          END IF

          numDims = numDims + 1
          IF numDims > 255 THEN
            throwCompilerErrorAndCancelTira "TOO MANY DIMENSIONS", ASIS, 0
            EXIT FUNCTION
          END IF

          hasTo = 0
          toIdx = 0
          ff = findNextTokenAtDepth0(tokParseIdx, dimEnd, TOK_TO)
          IF ff = 1 THEN
            hasTo = 1
            toIdx = returnedData2
          END IF

          lBoundVar$ = tiraDimVar$("T", TYPE_LONG)
          IF hasTo = 1 THEN
            parsedLBound$ = tiraParseExpressionInt$(tokParseIdx, toIdx - 1, ALIM, "ARRAY DIM MUST BE NUMERIC")
            IF parsedLBound$ = "" THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraAssign lBoundVar$, parsedLBound$
          ELSE
            tiraAssign lBoundVar$, LTRIM$(STR$(optionBaseValue))
          END IF

          evalStart = tokParseIdx
          IF hasTo = 1 THEN evalStart = toIdx + 1

          dynAxVar$ = tiraParseExpressionInt$(evalStart, dimEnd, ALIM, "ARRAY DIM MUST BE NUMERIC")
          IF dynAxVar$ = "" THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          numElemsVar$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_SUB, numElemsVar$, dynAxVar$, lBoundVar$
          tiraOp TC_ADD, numElemsVar$, numElemsVar$, "1"

          numElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_CAST, numElems64$, numElemsVar$, LTRIM$(STR$(TYPE_INTEGER64))

          dimOkLbl$ = tiraLabelCreateNew$("DIM_OK")
          tiraJmpCond "JG", numElems64$, "0", dimOkLbl$
          tiraFatalError "INVALID ARRAY DIMENSION"
          tiraLabel dimOkLbl$

          dynDimLBoundVars$(numDims) = lBoundVar$
          dynDimTotalVars$(numDims) = numElems64$

          sizeTok$ = ""
          lBoundTok$ = LTRIM$(STR$(optionBaseValue))
          isNum = 1

          IF hasTo = 1 THEN
            lBoundTok$ = ""
            FOR ii = tokParseIdx TO toIdx - 1
              tokText$ = lineTokens$(ii)
              lBoundTok$ = lBoundTok$ + retTokenText$(tokText$)
              IF lineTokenVals(ii) = 0 THEN
                firstCh$ = LEFT$(tokText$, 1)
                IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                  isNum = 0
                END IF
              END IF
            NEXT
          END IF

          FOR ii = evalStart TO dimEnd
            tokText$ = lineTokens$(ii)
            sizeTok$ = sizeTok$ + retTokenText$(tokText$)
            IF lineTokenVals(ii) = 0 THEN
              firstCh$ = LEFT$(tokText$, 1)
              IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                isNum = 0
              END IF
            END IF
          NEXT

          IF isNum = 1 THEN
            sizeTok$ = evalMathConst$(sizeTok$)
            lBoundTok$ = evalMathConst$(lBoundTok$)

            FOR i2 = 1 TO LEN(sizeTok$)
              chCheck$ = MID$(sizeTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
            FOR i2 = 1 TO LEN(lBoundTok$)
              chCheck$ = MID$(lBoundTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
          END IF

          IF isNum = 0 OR sizeTok$ = "" OR lBoundTok$ = "" THEN
            isNumArray = 0
          ELSE
            elementCount = VAL(sizeTok$) - VAL(lBoundTok$) + 1
            IF elementCount <= 0 THEN
              throwCompilerErrorAndCancelTira "DIMENSION CANNOT BE NEGATIVE OR ZERO", ASIS, 0
              EXIT FUNCTION
            END IF
            staticArrayDimensionScratch(numDims).LowerBound = VAL(lBoundTok$)
            staticArrayDimensionScratch(numDims).ElementCount = elementCount
            totalStaticElems = totalStaticElems * elementCount
          END IF

          IF isNumArray = 0 AND (currentScopeID = 0 OR isShared = 1) THEN
            IF cm.ClassicMode = 0 THEN
              throwCompilerErrorAndCancelTira "GLOBAL ARRAYS MUST HAVE CONSTANT DIMENSIONS", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF

          IF commaIdx > 0 THEN
            tokParseIdx = commaIdx + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF isNumArray = 0 THEN
          totalStaticElems = 0
          isArray = 2
        END IF
        IF defaultArrayDynamic = 1 THEN isArray = 2

        tokIdx = parenEnd + 1
      END IF
    END IF

    vName$ = UCASE$(aTok$)

    IF currentScopeID > 0 THEN
      IF isDummyPass = 1 THEN
        ff = findSymbol(vName$)
        IF ff = 1 THEN
          vIdx = returnedData2
          IF symbols(vIdx).ScopeID = currentScopeID THEN

            IF isCompilingRT = 0 AND cm.ClassicMode = 0 THEN
              IF symbols(vIdx).SubIndex = 0 THEN
                IF isArray > ARRAY_KIND_NONE AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
                  throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
                  EXIT FUNCTION
                END IF

                IF isArray = ARRAY_KIND_NONE AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
                  throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            SELECT CASE symbols(vIdx).IsExplicit

              CASE DECL_IMPLICIT, DECL_QUIET
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN SUB/FUNC (IMPLICIT)", ASIS, 0
              CASE DECL_EXPLICIT
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN SUB/FUNC (EXPLICIT)", ASIS, 0
              CASE ELSE
                throwCompilerErrorAndCancelTira "VAR " + vName$ + " ALREADY EXISTS IN THIS SUB OR FUNCTION", ASIS, 0

            END SELECT

            EXIT FUNCTION
          ELSE
            IF isShared = 0 THEN
              declaredKind$ = "LOCAL VARIABLE"
              IF isArray > 0 THEN declaredKind$ = "LOCAL ARRAY"

              existingKind$ = "GLOBAL VARIABLE"
              IF symbols(vIdx).IsArray > 0 THEN existingKind$ = "GLOBAL ARRAY"

              IF symbols(vIdx).SubIndex <> 0 THEN
                IF subs(symbols(vIdx).SubIndex).IsFunction = 1 THEN
                  existingKind$ = "GLOBAL FUNCTION"
                ELSE
                  existingKind$ = "GLOBAL SUB"
                END IF
              END IF

              throwCompilerErrorAndCancelTira declaredKind$ + " " + vName$ + " CLASHES WITH " + existingKind$, ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Dimension expressions must not override the declared variable's implicit DEFINT type
    expectedSymType = TYPE_ANY
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF isArray > ARRAY_KIND_NONE AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
          EXIT FUNCTION
        END IF

        IF isArray = ARRAY_KIND_NONE AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    prevIsExplicit = symbols(vIdx).IsExplicit
    prevDataType = symbols(vIdx).DataType
    prevUDTIndex = symbols(vIdx).UDTIndex

    IF isStaticVar = 1 THEN
      symbols(vIdx).IsLocal = LOCAL_GLOBAL
    END IF

    IF symbols(vIdx).IsArray = 1 THEN
      IF isDummyPass = 1 THEN
        throwCompilerErrorAndCancelTira "ARRAY ALREADY DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    symbols(vIdx).IsArray = isArray
    symbols(vIdx).IsExplicit = DECL_EXPLICIT
    IF isShared = 1 THEN symbols(vIdx).IsShared = 1

    symbols(vIdx).Size = totalStaticElems
    symbols(vIdx).NumDimensions = numDims

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF prevIsExplicit = DECL_EXPLICIT THEN
          IF dtMapped <> prevDataType THEN
            throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
            EXIT FUNCTION
          END IF
          IF dtMapped = TYPE_UDT THEN
            IF typeData <> prevUDTIndex THEN
              throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    IF isArray = ARRAY_KIND_STATIC AND isNumArray = 1 THEN
      staticLayoutStart = retStaticArrayLayoutStart(vIdx, numDims)

      IF staticLayoutStart > 0 THEN
        staticStride = 1

        FOR iDim = 1 TO numDims
          staticArrayDimensions(staticLayoutStart + iDim - 1).LowerBound = staticArrayDimensionScratch(iDim).LowerBound
          staticArrayDimensions(staticLayoutStart + iDim - 1).ElementCount = staticArrayDimensionScratch(iDim).ElementCount
          staticArrayDimensions(staticLayoutStart + iDim - 1).Stride = staticStride

          IF iDim < numDims THEN staticStride = staticStride * staticArrayDimensionScratch(iDim).ElementCount
        NEXT
      END IF
    ELSE
      staticArrayLayoutStart(vIdx) = 0
    END IF

    IF isArray = 2 THEN
      tiraScheduleArrayFree vIdx
    END IF

    IF isArray > 0 THEN
      elemSize = retElementByteSize(vIdx)

      descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

      totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign totalElems$, "1"

      numDimsStr$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign numDimsStr$, LTRIM$(STR$(numDims))
      tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 12, " + numDimsStr$ + ", 4"

      FOR iDim = 1 TO numDims
        tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8))) + ", " + dynDimLBoundVars$(iDim) + ", 4"
        tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8) + 4)) + ", " + dynDimTotalVars$(iDim) + ", 4"

        prevTotal$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraAssign prevTotal$, totalElems$

        tiraOp TC_MUL, totalElems$, totalElems$, dynDimTotalVars$(iDim)

        checkDiv$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_IDIV, checkDiv$, totalElems$, prevTotal$

        multOkLbl$ = tiraLabelCreateNew$("MULT_OK")
        tiraJmpCond "JE", checkDiv$, dynDimTotalVars$(iDim), multOkLbl$
        tiraFatalError "ARRAY ALLOCATION OVERFLOW"
        tiraLabel multOkLbl$
      NEXT iDim

      IF isArray = 2 THEN
        elemSizeStr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraAssign elemSizeStr$, LTRIM$(STR$(elemSize))

        allocSize$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_MUL, allocSize$, totalElems$, elemSizeStr$

        allocOkLbl$ = tiraLabelCreateNew$("ALLOC_OK")
        tiraJmpCond "JE", elemSizeStr$, "1", allocOkLbl$

        checkAllocDiv$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_IDIV, checkAllocDiv$, allocSize$, elemSizeStr$

        tiraJmpCond "JE", checkAllocDiv$, totalElems$, allocOkLbl$
        tiraFatalError "ARRAY ALLOCATION OVERFLOW"
        tiraLabel allocOkLbl$

        tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, " + allocSize$
        arrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraNew TC_GET_RET, arrPtr$

        skipOkLbl$ = tiraLabelCreateNew$("HEAP_OK")
        tiraJmpCond "JNE", arrPtr$, "0", skipOkLbl$
        tiraFatalError "OUT OF MEMORY ALLOCATING ARRAY"
        tiraLabel skipOkLbl$

        tiraWriteMem descAddr$, arrPtr$, "8"
      ELSE
        arrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADD, arrPtr$, descAddr$, LTRIM$(STR$(16 + (numDims * 8)))
        tiraWriteMem descAddr$, arrPtr$, "8"
      END IF

      elemSizeStrDWord$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign elemSizeStrDWord$, LTRIM$(STR$(elemSize))
      tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 8, " + elemSizeStrDWord$ + ", 4"
    END IF

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        IF isStaticVar = 1 THEN
          throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER STATIC", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER DIM", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_DIM_Core = 1

END FUNCTION ' parse_DIM_Core

''''''''''''''''''''''''
FUNCTION parse_DISPLAY (startIdx)

  parse_DISPLAY = parse_DISPLAY_Core(startIdx, 0)

END FUNCTION ' parse_DISPLAY

''''''''''''''''''''''''
FUNCTION parse_DISPLAYI (startIdx)

  parse_DISPLAYI = parse_DISPLAY_Core(startIdx, 1)

END FUNCTION ' parse_DISPLAYI

''''''''''''''''''''''''
FUNCTION parse_DRAW (startIdx)

  DIM endIdx AS LONG
  DIM drawVarType AS LONG
  DIM drawVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG
  DIM savedScopeID AS LONG
  DIM drawRuntimeIdx AS _UNSIGNED LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "DRAW REQUIRES STRING EXPRESSION", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Registers the persistent DRAW state and runtime entry

  savedScopeID = currentScopeID
  currentScopeID = 0

  ff = resolveSymbol("!G_GFX_V32_DRAWANGLE")
  ff = resolveSymbol("!G_GFX_V32_DRAWSCALE")
  ff = resolveSymbol("!G_GFX_FLG_DRAWINIT")

  ff = resolveSymbol("RT_DRAW")
  IF ff = 1 THEN
    drawRuntimeIdx = returnedData2
    symbols(drawRuntimeIdx).ScopeID = 0
    symbols(drawRuntimeIdx).IsLocal = LOCAL_GLOBAL
  END IF

  currentScopeID = savedScopeID

  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  ff = tiraParseExpressionId(startIdx + 1, endIdx, ALIM)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  drawVarType = tiraParsedArgType
  drawVarVal = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "DRAW REQUIRES STRING EXPRESSION", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = resolveSymbol("RT_DRAW")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId1 callFuncIdx, drawVarType, drawVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_DRAW = 1

END FUNCTION ' parse_DRAW

''''''''''''''''''''''''
FUNCTION parse_END (startIdx)

  DIM endIdx AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG

  endIdx = lineTokenCount - 1

  isBlockEnd = 0
  IF endIdx > startIdx THEN
    tok2 = lineTokenVals(startIdx + 1)
    IF tok2 = TOK_SUB OR tok2 = TOK_FUNCTION THEN isBlockEnd = 1
    IF tok2 = TOK_IF THEN isBlockEnd = 1
    IF tok2 = TOK_SELECT THEN isBlockEnd = 1
  END IF

  IF isBlockEnd = 1 THEN
    tok2 = lineTokenVals(startIdx + 1)
    SELECT CASE tok2

      CASE TOK_SUB, TOK_FUNCTION
        IF tok2 = TOK_SUB AND insideSub <> 1 THEN
          throwCompilerError "END SUB WITHOUT SUB", ASIS, 0
          EXIT FUNCTION
        END IF
        IF tok2 = TOK_FUNCTION AND insideSub <> 2 THEN
          throwCompilerError "FUNCTION END WITHOUT FUNCTION", ASIS, 0
          EXIT FUNCTION
        END IF

        ' Resolve all early EXIT SUB / EXIT FUNCTION jumps to land here via TIRA labels
        tira_Start
        tiraLabel "@END_ROUTINE_" + currentSubName$
        tiraScheduleGC

        ' Restore stack alignment, pop ABI non-volatile registers, and return
        tiraScheduleSubEpilogue

        ' Land the jump over the SUB/FUNCTION
        tiraLabel "@SKIP_ROUTINE_" + currentSubName$
        tira_EndAndProcess

        currentScopeID = 0
        insideSub = 0
        currentSubName$ = ""
        stack.currentStackOffset = stack.consoleFrameSize
        ff = updateStackAlignment

        parse_END = 1
        EXIT FUNCTION

      CASE TOK_IF
        IF ctrlCount = 0 THEN
          throwCompilerError "END IF WITHOUT IF", ASIS, 0
          EXIT FUNCTION
        END IF

        ctrlCount = ctrlCount - 1

        IF ctrls(ctrlCount).TYPE = CTRL_IF OR ctrls(ctrlCount).TYPE = CTRL_ELSE THEN
          ifID_end = ctrls(ctrlCount).Patch1
          ifID_false = ctrls(ctrlCount).Patch2

          falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
          endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

          tira_Start

          ' If we never saw an ELSE statement, the FALSE condition must skip to here
          IF ctrls(ctrlCount).TYPE = CTRL_IF THEN
            tiraLabel falseLbl$
          END IF

          ' Any executed blocks will jump directly here to bypass trailing conditions
          tiraLabel endLbl$

          tira_EndAndProcess
        ELSE
          throwCompilerError "END IF MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        parse_END = 1
        EXIT FUNCTION

      CASE TOK_SELECT
        IF ctrlCount = 0 THEN
          throwCompilerError "END SELECT WITHOUT SELECT", ASIS, 0
          EXIT FUNCTION
        END IF

        ctrlCount = ctrlCount - 1

        IF ctrls(ctrlCount).TYPE = CTRL_SELECT THEN
          selID = ctrls(ctrlCount).Patch1
          caseID = ctrls(ctrlCount).SelectCaseSeen

          tira_Start

          IF caseID > 0 THEN
            ' The final case's conditions would skip to right here if they all failed
            prevNextLbl$ = "@SEL_NEXT_" + LTRIM$(RTRIM$(STR$(selID))) + "_" + LTRIM$(RTRIM$(STR$(caseID - 1)))
            tiraLabel prevNextLbl$
          END IF

          endSelLbl$ = "@SEL_END_" + LTRIM$(RTRIM$(STR$(selID)))
          tiraLabel endSelLbl$

          tira_EndAndProcess

        ELSE
          throwCompilerError "END SELECT MISMATCH", ASIS, 0
          EXIT FUNCTION
        END IF

        parse_END = 1
        EXIT FUNCTION

    END SELECT ' tok2
  END IF

  ' Standalone END with optional return code
  tira_Start

  IF endIdx > startIdx THEN
    exprVar$ = tiraParseExpressionInt$(startIdx + 1, endIdx, ALIM, "END REQUIRES NUMERIC")
    IF exprVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    ff = resolveSymbol("!G_SYS_VAL_EXIT")
    IF ff = 1 THEN
      vIdxExit = returnedData2
      tiraAssign "!G_SYS_VAL_EXIT", exprVar$
    END IF
  END IF

  ' Jump to the end of the program
  tiraJmp "@END_PROGRAM"

  tira_EndAndProcess

  parse_END = 1

END FUNCTION ' parse_END

''''''''''''''''''''''''
FUNCTION parse_GET (startIdx)

  ' Captures a portion of the graphics screen

  DIM dashIdx AS LONG
  DIM isFileIO AS LONG
  DIM cComma AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM commaIdx AS LONG
  DIM cComma2 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vIdx AS LONG
  DIM elemSize AS LONG
  DIM statElems AS LONG
  DIM endIdx AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  endIdx = lineTokenCount - 1

  dashIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, 256 + ASC("-"))
  IF ff = 1 THEN
    dashIdx = returnedData2
  END IF

  isFileIO = 0
  IF dashIdx = 0 THEN
    isFileIO = 1
  END IF

  IF isFileIO = 1 THEN
    parse_GET = parse_GET_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GRAPHICS GET REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(startIdx + 1, dashIdx - 1)
  IF cComma = 0 THEN
    throwCompilerError "GET MISSING X1, Y1", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart1 = returnedData2
  cEnd1 = returnedData3

  tira_Start

  x1$ = tiraParseExpressionInt$(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF x1$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  y1$ = tiraParseExpressionInt$(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF y1$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  commaIdx = findComma(dashIdx + 1, endIdx)

  IF commaIdx = 0 THEN
    throwCompilerErrorAndCancelTira "GET MISSING ARRAY VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma2 = retCoordinateBoundaries(dashIdx + 1, commaIdx - 1)
  IF cComma2 = 0 THEN
    throwCompilerErrorAndCancelTira "GET MISSING X2, Y2", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart2 = returnedData2
  cEnd2 = returnedData3

  x2$ = tiraParseExpressionInt$(cStart2, cComma2 - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF x2$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  y2$ = tiraParseExpressionInt$(cComma2 + 1, cEnd2, ALIM, "COORDINATE MUST BE NUMERIC")
  IF y2$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  tokIdx = commaIdx + 1
  vTok$ = lineTokens$(tokIdx)
  vName$ = UCASE$(vTok$)
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerErrorAndCancelTira "GET TARGET MUST BE AN ARRAY", ASIS, 0
    EXIT FUNCTION
  END IF

  indicesStr$ = ""
  numParsedIndices = 0

  tokIdx = tokIdx + 1
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      indicesStr$ = tiraParseArrayArgs$(tokIdx, endIdx, 0)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, 0)
  IF ptr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  elemSize = retElementByteSize(vIdx)

  descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

  numDims$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, numDims$ + ", " + descAddr$ + ", 12"

  totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign totalElems$, "1"

  dimItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign dimItr$, "0"
  lblDimTop$ = tiraLabelCreateNew$("DIM_TOP")
  lblDimDone$ = tiraLabelCreateNew$("DIM_DONE")

  tiraLabel lblDimTop$
  tiraJmpCond "JGE", dimItr$, numDims$, lblDimDone$

  offsetVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetVar$, dimItr$, "8"
  tiraOp TC_ADD, offsetVar$, offsetVar$, "16"

  dimLimitAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dimLimitAddr$, descAddr$, offsetVar$

  dimNumElems$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, dimNumElems$ + ", " + dimLimitAddr$ + ", 4"

  dimNumElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_CAST, dimNumElems64$, dimNumElems$, LTRIM$(STR$(TYPE_INTEGER64))

  tiraOp TC_MUL, totalElems$, totalElems$, dimNumElems64$
  tiraOp TC_ADD, dimItr$, dimItr$, "1"
  tiraJmp lblDimTop$

  tiraLabel lblDimDone$

  byteSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, byteSize$, totalElems$, LTRIM$(RTRIM$(STR$(elemSize)))

  baseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, baseAddr$ + ", " + descAddr$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, endPtr$, baseAddr$, byteSize$

  tiraCall "RT_GET", 6, x1$ + ", " + y1$ + ", " + x2$ + ", " + y2$ + ", " + ptr$ + ", " + endPtr$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_GET = 1

END FUNCTION ' parse_GET

''''''''''''''''''''''''
FUNCTION parse_GET_File (startIdx, endIdx)

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM targetStart AS LONG
  DIM closeParen AS LONG
  DIM tokIdx AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  DIM hasArrayIndices AS LONG
  DIM hasPosition AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM positionVar$
  DIM stateBase$
  DIM stateSlot$
  DIM fileMode$
  DIM recordLen$
  DIM fileModeOkLbl$

  tokIdx = startIdx + 1
  IF lineTokens$(tokIdx) = "#" THEN
    tokIdx = tokIdx + 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "GET MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    targetStart = comma1 + 1
  ELSE
    targetStart = comma2 + 1
  END IF

  IF targetStart > endIdx THEN
    throwCompilerError "GET MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(targetStart)
  vName$ = UCASE$(vTok$)
  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  fileNumVar$ = tiraParseExpressionInt$(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  hasPosition = 0
  positionVar$ = ""

  IF comma2 > 0 THEN
    IF comma2 > comma1 + 1 THEN
      positionVar$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, ALIM, "FILE POSITION MUST BE NUMERIC")
      IF positionVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      hasPosition = 1
    END IF
  END IF

  indicesStr$ = ""
  numParsedIndices = 0
  hasArrayIndices = 0

  IF targetStart < endIdx THEN
    IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
      hasArrayIndices = 1
      indicesStr$ = tiraParseArrayArgs$(targetStart + 1, endIdx, ALIM)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasArrayIndices = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasArrayIndices = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  skipFileIOLbl$ = tiraLabelCreateNew$("SKIP_FILE_IO")

  tiraJmpCond "JE", handleVar$, "0", skipFileIOLbl$
  tiraJmpCond "JE", handleVar$, "-1", skipFileIOLbl$

  stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateBase$, "!G_FLS_V32_FILE_STATE", ""

  stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB stateSlot$, stateBase$, fileNumVar$, LTRIM$(STR$(FS_STATE_SLOT_BYTES))

  fileMode$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, fileMode$ + ", " + stateSlot$

  recordLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, recordLen$ + ", " + stateSlot$ + ", " + LTRIM$(STR$(FS_STATE_RECORD_LENGTH_OFFSET))

  fileModeOkLbl$ = tiraLabelCreateNew$("GET_FILE_MODE_OK")
  tiraJmpCond "JE", fileMode$, LTRIM$(STR$(FS_MODE_BINARY)), fileModeOkLbl$
  tiraJmpCond "JE", fileMode$, LTRIM$(STR$(FS_MODE_RANDOM)), fileModeOkLbl$
  tiraFatalError "BAD FILE MODE"
  tiraLabel fileModeOkLbl$

  ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, 0)
  IF ptr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  dt = symbols(vIdx).DataType
  elemSize = retElementByteSize(vIdx)
  fixedLen = retFixeSTRINGDLength(vIdx)

  dataSize$ = tiraDimVar$("T", TYPE_LONG)
  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF dt = TYPE_STRING AND fixedLen = 0 THEN
    descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

    IF symbols(vIdx).IsArray > 0 THEN
      tiraNew TC_READ_MEM, descPtr$ + ", " + ptr$
    ELSE
      tiraAssign descPtr$, ptr$
    END IF

    tiraJmpCond "JE", descPtr$, "0", skipFileIOLbl$

    tiraAssign dataSize$, tiraGetStringLen$(descPtr$)
    tiraAssign dataPtr$, tiraGetStringData$(descPtr$)

    tiraJmpCond "JLE", dataSize$, "0", skipFileIOLbl$
    tiraJmpCond "JE", dataPtr$, "0", skipFileIOLbl$

  ELSE
    IF dt = TYPE_STRING AND fixedLen > 0 THEN
      tiraAssign dataSize$, LTRIM$(STR$(fixedLen))

      IF symbols(vIdx).IsArray > 0 THEN
        tiraAssign dataPtr$, ptr$
      ELSE
        descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraAssign descPtr$, ptr$

        tiraJmpCond "JE", descPtr$, "0", skipFileIOLbl$

        tiraAssign dataPtr$, tiraGetStringData$(descPtr$)
        tiraJmpCond "JE", dataPtr$, "0", skipFileIOLbl$
      END IF
    ELSE
      tiraAssign dataSize$, LTRIM$(STR$(elemSize))
      tiraAssign dataPtr$, ptr$

      tiraJmpCond "JLE", dataSize$, "0", skipFileIOLbl$
    END IF
  END IF

  tiraFlushFileWriteBuffer

  IF hasPosition = 1 THEN
    tiraSeekFilePosition handleVar$, fileMode$, recordLen$, positionVar$
  END IF

  numWrt$ = tiraDimVar$("T", TYPE_LONG)
  numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

  tiraCall "IAT_READFILE", 5, handleVar$ + ", " + dataPtr$ + ", " + dataSize$ + ", " + numWrtPtr$ + ", 0"

  tiraLabel skipFileIOLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_GET_File = 1

END FUNCTION ' parse_GET_File

''''''''''''''''''''''''
FUNCTION parse_GOSUB (startIdx)

  ' Branches execution to a subroutine label and returns later

  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "GOSUB NEEDS LABEL", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, startIdx + 1, "GOSUB")
  IF ff = 0 THEN EXIT FUNCTION

  targetTok$ = lineTokens$(startIdx + 1)
  targetLabelName$ = "%" + UCASE$(targetTok$)

  expectedSymType = TYPE_LABEL
  ff = resolveSymbol(targetLabelName$)
  IF ff = 0 THEN
    EXIT FUNCTION
  END IF

  tira_Start

  retLbl$ = tiraLabelCreateNew$("GOSUB_RET")
  retAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tgtPtrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  baseAddrVar$ = tiraDimVar$("T", TYPE_INTEGER64)

  tiraOp TC_ADDRESS_OF, retAddrVar$, retLbl$, ""
  tiraOp TC_ADDRESS_OF, baseAddrVar$, "!G_SYS_ARR_GOSUB", ""

  tiraLeaSIB tgtPtrVar$, baseAddrVar$, "!G_SYS_IDX_GOSUB", "8"
  tiraWriteMem tgtPtrVar$, retAddrVar$, "8"
  tiraOp TC_ADD, "!G_SYS_IDX_GOSUB", "!G_SYS_IDX_GOSUB", "1"

  tiraScheduleHeapReset
  tiraJmpUser targetLabelName$

  tiraLabel retLbl$
  tiraScheduleHeapReset

  tira_EndAndProcess

  parse_GOSUB = 1

END FUNCTION ' parse_GOSUB

''''''''''''''''''''''''
FUNCTION parse_INPUT_File (startIdx, endIdx)

  ' Reads sequential text fields from an open file into one or more variables

  DIM fileNumStart AS LONG
  DIM comma1 AS LONG
  DIM nextComma AS LONG
  DIM targetStart AS LONG
  DIM targetEnd AS LONG
  DIM targetCount AS LONG
  DIM parenEnd AS LONG
  DIM hasIndices AS LONG
  DIM numParsedIndices AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM fixedLen AS LONG

  DIM fileNumVar$
  DIM targetName$
  DIM indicesStr$
  DIM baseArr$
  DIM slotAddr$
  DIM handleVar$
  DIM fileDoneLbl$

  DIM fieldBuf$
  DIM fieldLen$
  DIM fieldStarted$
  DIM fieldQuoted$
  DIM charPtr$
  DIM bytesRead$
  DIM bytesReadPtr$
  DIM charByte$
  DIM fieldReadTopLbl$
  DIM fieldStartedLbl$
  DIM fieldUnquotedLbl$
  DIM fieldAppendLbl$
  DIM fieldNoAppendLbl$
  DIM fieldDoneLbl$
  DIM quoteTailTopLbl$

  DIM targetAddr$
  DIM rhsDescPtr$
  DIM lhsDescPtr$
  DIM lhsDataPtr$
  DIM copyLen$
  DIM copyLenReadyLbl$
  DIM copyDoneLbl$
  DIM padLen$
  DIM padAddr$
  DIM padDoneLbl$

  DIM numericPtr$
  DIM numericRemain$
  DIM numericValue$
  DIM numericNeg$
  DIM numericSkipTopLbl$
  DIM numericSkipDoneLbl$
  DIM numericConsumeLbl$
  DIM numericSignDoneLbl$
  DIM numericNegativeLbl$
  DIM numericConsumeSignLbl$
  DIM numericLoopTopLbl$
  DIM numericLoopDoneLbl$
  DIM numericApplySignLbl$
  DIM storeMode$

  fileNumStart = startIdx + 1

  IF fileNumStart > endIdx THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Strip the # symbol so the expression evaluates properly
  IF lineTokens$(fileNumStart) = "#" THEN
    fileNumStart = fileNumStart + 1
  ELSE
    IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
      lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
    ELSE
      throwCompilerError "INPUT FILE MISSING #", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF fileNumStart > endIdx THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = 0
  ff = findNextTokenAtDepth0(fileNumStart, endIdx, 256 + ASC(","))
  IF ff = 1 THEN comma1 = returnedData2

  IF comma1 = 0 THEN
    throwCompilerError "INPUT # MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fileNumStart > comma1 - 1 THEN
    throwCompilerError "INPUT # MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  targetStart = comma1 + 1
  IF targetStart > endIdx THEN
    throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  ' Validate and register every target before emitting the file operation
  targetCount = 0

  DO WHILE targetStart <= endIdx
    nextComma = 0
    ff = findNextTokenAtDepth0(targetStart, endIdx, 256 + ASC(","))
    IF ff = 1 THEN nextComma = returnedData2

    targetEnd = endIdx
    IF nextComma > 0 THEN targetEnd = nextComma - 1

    IF targetStart > targetEnd THEN
      throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF lineTokenVals(targetStart) <> 0 THEN
      throwCompilerError "INPUT # EXPECTED TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    hasIndices = 0

    IF targetStart < targetEnd THEN
      IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
        ff = findMatchingParen(targetStart + 1, targetEnd)
        IF ff = 0 THEN
          throwCompilerError "UNMATCHED PARENTHESIS IN INPUT #", ASIS, 0
          EXIT FUNCTION
        END IF

        parenEnd = returnedData2
        IF parenEnd <> targetEnd THEN
          throwCompilerError "UNEXPECTED TOKEN AFTER INPUT # TARGET", ASIS, 0
          EXIT FUNCTION
        END IF

        hasIndices = 1
      ELSE
        throwCompilerError "UNEXPECTED TOKEN AFTER INPUT # TARGET", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    targetName$ = UCASE$(lineTokens$(targetStart))

    expectedSymType = TYPE_ANY
    ff = resolveSymbol(targetName$)
    IF ff = 0 THEN EXIT FUNCTION

    vIdx = returnedData2
    targetType = returnedData3

    IF symbols(vIdx).SubIndex <> 0 THEN
      throwCompilerError "INPUT # TARGET MUST BE A VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    IF hasIndices = 1 THEN
      IF symbols(vIdx).IsArray = 0 THEN
        throwCompilerError "INPUT # TARGET ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
    ELSE
      IF symbols(vIdx).IsArray > 0 THEN
        throwCompilerError "INPUT # ARRAY TARGET REQUIRES INDEX", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    SELECT CASE targetType

      CASE TYPE_BYTE, TYPE_UBYTE, TYPE_INTEGER, TYPE_UINTEGER
      CASE TYPE_LONG, TYPE_ULONG, TYPE_INTEGER64, TYPE_UINT64
      CASE TYPE_SINGLE, TYPE_DOUBLE, TYPE_STRING

      CASE ELSE
        throwCompilerError "INPUT # TARGET TYPE NOT SUPPORTED", ASIS, 0
        EXIT FUNCTION

    END SELECT ' targetType

    targetCount = targetCount + 1

    IF nextComma = 0 THEN
      EXIT DO
    END IF

    targetStart = nextComma + 1

    IF targetStart > endIdx THEN
      throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF
  LOOP

  IF targetCount = 0 THEN
    throwCompilerError "INPUT # MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  fileNumVar$ = tiraParseExpressionInt$(fileNumStart, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  fileDoneLbl$ = tiraLabelCreateNew$("FINPUT_DONE")

  tiraJmpCond "JE", handleVar$, "0", fileDoneLbl$
  tiraJmpCond "JE", handleVar$, "-1", fileDoneLbl$

  ' One shared field buffer is reused after each completed assignment
  fieldBuf$ = tiraAllocTempMem$("8192")

  targetStart = comma1 + 1

  DO WHILE targetStart <= endIdx
    nextComma = 0
    ff = findNextTokenAtDepth0(targetStart, endIdx, 256 + ASC(","))
    IF ff = 1 THEN nextComma = returnedData2

    targetEnd = endIdx
    IF nextComma > 0 THEN targetEnd = nextComma - 1

    targetName$ = UCASE$(lineTokens$(targetStart))

    expectedSymType = TYPE_ANY
    ff = resolveSymbol(targetName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    vIdx = returnedData2
    targetType = returnedData3

    indicesStr$ = ""
    numParsedIndices = 0
    hasIndices = 0

    IF targetStart < targetEnd THEN
      IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
        hasIndices = 1
        indicesStr$ = tiraParseArrayArgs$(targetStart + 1, targetEnd, ALIM)
        IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
        parenEnd = returnedData2
        numParsedIndices = returnedData3
      END IF
    END IF

    IF hasIndices = 1 THEN
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerErrorAndCancelTira "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    targetAddr$ = tiraFrontendCalcAddress$(targetName$, indicesStr$, 0)
    IF targetAddr$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    ' Read one comma-delimited or line-delimited field
    fieldLen$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign fieldLen$, "0"

    fieldStarted$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign fieldStarted$, "0"

    fieldQuoted$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign fieldQuoted$, "0"

    charPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

    bytesRead$ = tiraDimVar$("T", TYPE_LONG)
    bytesReadPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, bytesReadPtr$, bytesRead$, ""

    charByte$ = tiraDimVar$("T", TYPE_UBYTE)

    fieldReadTopLbl$ = tiraLabelCreateNew$("FINPUT_READ")
    fieldStartedLbl$ = tiraLabelCreateNew$("FINPUT_STARTED")
    fieldUnquotedLbl$ = tiraLabelCreateNew$("FINPUT_UNQUOTED")
    fieldAppendLbl$ = tiraLabelCreateNew$("FINPUT_APPEND")
    fieldNoAppendLbl$ = tiraLabelCreateNew$("FINPUT_NO_APPEND")
    fieldDoneLbl$ = tiraLabelCreateNew$("FINPUT_FIELD_DONE")
    quoteTailTopLbl$ = tiraLabelCreateNew$("FINPUT_QUOTE_TAIL")

    tiraLabel fieldReadTopLbl$

    tiraOp TC_ADD, charPtr$, fieldBuf$, fieldLen$

    tiraAssign bytesRead$, "0"
    tiraCall "IAT_READFILE", 5, handleVar$ + ", " + charPtr$ + ", 1, " + bytesReadPtr$ + ", 0"

    tiraJmpCond "JE", bytesRead$, "0", fieldDoneLbl$

    tiraNew TC_READ_MEM, charByte$ + ", " + charPtr$

    tiraJmpCond "JNE", fieldStarted$, "0", fieldStartedLbl$

    ' Ignore whitespace and line boundaries before the field begins
    tiraJmpCond "JE", charByte$, "32", fieldReadTopLbl$
    tiraJmpCond "JE", charByte$, "9", fieldReadTopLbl$
    tiraJmpCond "JE", charByte$, "13", fieldReadTopLbl$
    tiraJmpCond "JE", charByte$, "10", fieldReadTopLbl$

    tiraAssign fieldStarted$, "1"

    ' An opening quote is structural and is not included in the target string
    tiraJmpCond "JNE", charByte$, "34", fieldStartedLbl$
    tiraAssign fieldQuoted$, "1"
    tiraJmp fieldReadTopLbl$

    tiraLabel fieldStartedLbl$

    tiraJmpCond "JE", fieldQuoted$, "0", fieldUnquotedLbl$

    ' A closing quote ends a quoted field
    tiraJmpCond "JE", charByte$, "34", quoteTailTopLbl$
    tiraJmp fieldAppendLbl$

    tiraLabel fieldUnquotedLbl$

    tiraJmpCond "JE", charByte$, "44", fieldDoneLbl$
    tiraJmpCond "JE", charByte$, "10", fieldDoneLbl$

    ' Consume CR and allow the following LF to terminate the field
    tiraJmpCond "JE", charByte$, "13", fieldReadTopLbl$

    tiraLabel fieldAppendLbl$

    ' Reserve the final byte as a safe one-byte read location after truncation
    tiraJmpCond "JGE", fieldLen$, "8191", fieldNoAppendLbl$
    tiraOp TC_ADD, fieldLen$, fieldLen$, "1"

    tiraLabel fieldNoAppendLbl$
    tiraJmp fieldReadTopLbl$

    ' Consume the delimiter following a quoted field
    tiraLabel quoteTailTopLbl$

    tiraAssign bytesRead$, "0"
    tiraCall "IAT_READFILE", 5, handleVar$ + ", " + charPtr$ + ", 1, " + bytesReadPtr$ + ", 0"

    tiraJmpCond "JE", bytesRead$, "0", fieldDoneLbl$

    tiraNew TC_READ_MEM, charByte$ + ", " + charPtr$

    tiraJmpCond "JE", charByte$, "44", fieldDoneLbl$
    tiraJmpCond "JE", charByte$, "10", fieldDoneLbl$
    tiraJmpCond "JE", charByte$, "13", quoteTailTopLbl$
    tiraJmpCond "JE", charByte$, "32", quoteTailTopLbl$
    tiraJmpCond "JE", charByte$, "9", quoteTailTopLbl$
    tiraJmp fieldDoneLbl$

    tiraLabel fieldDoneLbl$

    IF targetType = TYPE_STRING THEN
      fixedLen = retFixeSTRINGDLength(vIdx)

      IF fixedLen > 0 THEN
        lhsDataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

        IF symbols(vIdx).IsArray > 0 THEN
          tiraAssign lhsDataPtr$, targetAddr$
        ELSE
          tiraNew TC_READ_MEM, lhsDataPtr$ + ", " + targetAddr$
        END IF

        copyLen$ = tiraDimVar$("T", TYPE_LONG)
        tiraAssign copyLen$, fieldLen$

        copyLenReadyLbl$ = tiraLabelCreateNew$("FINPUT_COPY_READY")
        tiraJmpCond "JLE", copyLen$, LTRIM$(STR$(fixedLen)), copyLenReadyLbl$
        tiraAssign copyLen$, LTRIM$(STR$(fixedLen))
        tiraLabel copyLenReadyLbl$

        copyDoneLbl$ = tiraLabelCreateNew$("FINPUT_COPY_DONE")
        tiraJmpCond "JLE", copyLen$, "0", copyDoneLbl$
        tiraMemcpy lhsDataPtr$, fieldBuf$, copyLen$
        tiraLabel copyDoneLbl$

        padLen$ = tiraDimVar$("T", TYPE_LONG)
        tiraOp TC_SUB, padLen$, LTRIM$(STR$(fixedLen)), copyLen$

        padDoneLbl$ = tiraLabelCreateNew$("FINPUT_PAD_DONE")
        tiraJmpCond "JLE", padLen$, "0", padDoneLbl$

        padAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADD, padAddr$, lhsDataPtr$, copyLen$
        tiraMemSet padAddr$, "32", padLen$

        tiraLabel padDoneLbl$
      ELSE
        rhsDescPtr$ = tiraAllocTempMem$("24")
        tiraBuildStrDesc rhsDescPtr$, fieldBuf$, fieldLen$, "0"

        lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

        IF symbols(vIdx).IsArray > 0 THEN
          tiraNew TC_READ_MEM, lhsDescPtr$ + ", " + targetAddr$
          tiraEnsureStringAlloc lhsDescPtr$, targetAddr$
        ELSE
          tiraAssign lhsDescPtr$, targetAddr$
        END IF

        tiraCall "RT_STR_ASSIGN", 2, lhsDescPtr$ + ", " + rhsDescPtr$
      END IF
    ELSE
      ' Convert the field using the same whole-number behavior as standard INPUT
      numericPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign numericPtr$, fieldBuf$

      numericRemain$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign numericRemain$, fieldLen$

      numericValue$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign numericValue$, "0"

      numericNeg$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign numericNeg$, "0"

      numericSkipTopLbl$ = tiraLabelCreateNew$("FINPUT_NUM_SKIP")
      numericSkipDoneLbl$ = tiraLabelCreateNew$("FINPUT_NUM_READY")
      numericConsumeLbl$ = tiraLabelCreateNew$("FINPUT_NUM_CONSUME")

      tiraLabel numericSkipTopLbl$
      tiraJmpCond "JLE", numericRemain$, "0", numericSkipDoneLbl$

      tiraNew TC_READ_MEM, charByte$ + ", " + numericPtr$

      tiraJmpCond "JE", charByte$, "32", numericConsumeLbl$
      tiraJmpCond "JNE", charByte$, "9", numericSkipDoneLbl$

      tiraLabel numericConsumeLbl$
      tiraOp TC_ADD, numericPtr$, numericPtr$, "1"
      tiraOp TC_SUB, numericRemain$, numericRemain$, "1"
      tiraJmp numericSkipTopLbl$

      tiraLabel numericSkipDoneLbl$

      numericSignDoneLbl$ = tiraLabelCreateNew$("FINPUT_SIGN_DONE")
      numericNegativeLbl$ = tiraLabelCreateNew$("FINPUT_NEGATIVE")
      numericConsumeSignLbl$ = tiraLabelCreateNew$("FINPUT_SIGN_CONSUME")

      tiraJmpCond "JLE", numericRemain$, "0", numericSignDoneLbl$

      tiraNew TC_READ_MEM, charByte$ + ", " + numericPtr$

      tiraJmpCond "JE", charByte$, "45", numericNegativeLbl$
      tiraJmpCond "JNE", charByte$, "43", numericSignDoneLbl$
      tiraJmp numericConsumeSignLbl$

      tiraLabel numericNegativeLbl$
      tiraAssign numericNeg$, "1"

      tiraLabel numericConsumeSignLbl$
      tiraOp TC_ADD, numericPtr$, numericPtr$, "1"
      tiraOp TC_SUB, numericRemain$, numericRemain$, "1"

      tiraLabel numericSignDoneLbl$

      numericLoopTopLbl$ = tiraLabelCreateNew$("FINPUT_NUM_LOOP")
      numericLoopDoneLbl$ = tiraLabelCreateNew$("FINPUT_NUM_DONE")

      tiraLabel numericLoopTopLbl$
      tiraJmpCond "JLE", numericRemain$, "0", numericLoopDoneLbl$

      tiraNew TC_READ_MEM, charByte$ + ", " + numericPtr$

      tiraJmpCond "JL", charByte$, "48", numericLoopDoneLbl$
      tiraJmpCond "JG", charByte$, "57", numericLoopDoneLbl$

      tiraOp TC_SUB, charByte$, charByte$, "48"
      tiraOp TC_MUL, numericValue$, numericValue$, "10"
      tiraOp TC_ADD, numericValue$, numericValue$, charByte$

      tiraOp TC_ADD, numericPtr$, numericPtr$, "1"
      tiraOp TC_SUB, numericRemain$, numericRemain$, "1"
      tiraJmp numericLoopTopLbl$

      tiraLabel numericLoopDoneLbl$

      numericApplySignLbl$ = tiraLabelCreateNew$("FINPUT_APPLY_SIGN")
      tiraJmpCond "JE", numericNeg$, "0", numericApplySignLbl$
      tiraOp TC_NEG, numericValue$, numericValue$, ""
      tiraLabel numericApplySignLbl$

      storeMode$ = ""

      SELECT CASE targetType

        CASE TYPE_BYTE, TYPE_UBYTE
          storeMode$ = "1"

        CASE TYPE_INTEGER, TYPE_UINTEGER
          storeMode$ = "2"

        CASE TYPE_LONG, TYPE_ULONG
          storeMode$ = "4"

        CASE TYPE_INTEGER64, TYPE_UINT64
          storeMode$ = "8"

        CASE TYPE_SINGLE
          storeMode$ = "SINGLE"

        CASE TYPE_DOUBLE
          storeMode$ = "DOUBLE"

      END SELECT ' targetType

      tiraWriteMem targetAddr$, numericValue$, storeMode$
    END IF

    IF nextComma = 0 THEN
      EXIT DO
    END IF

    targetStart = nextComma + 1
  LOOP

  tiraLabel fileDoneLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_INPUT_File = 1

END FUNCTION ' parse_INPUT_File

''''''''''''''''''''''''
FUNCTION parse_LBOUND$ (startIdx, endIdx, allowImplicit)

  ' Returns the lowest available index for a given array dimension

  DIM arrNameTok$
  DIM comma1 AS LONG
  DIM vIdx AS LONG
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM dimVar$
  DIM dimVarType AS LONG
  DIM dimVarVal AS _INTEGER64
  DIM dimLBoundIdx AS LONG
  DIM dimLimitAddrIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM numDimsIdx AS LONG
  DIM descAddrIdx AS LONG
  DIM lblEndIdx AS LONG
  DIM resVarIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LBOUND", 3) = 0 THEN
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, endIdx - 1)

  arrNameTok$ = UCASE$(retTokenText$(lineTokens$(startIdx + 2)))
  ff = findSymbol(arrNameTok$)
  IF ff = 0 THEN
    throwCompilerError "UNDECLARED ARRAY IN LBOUND", ASIS, 0
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerError "LBOUND REQUIRES AN ARRAY", ASIS, 0
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  IF comma1 > 0 THEN
    ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx - 1, allowImplicit, "DIMENSION MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      parse_LBOUND$ = ""
      EXIT FUNCTION
    END IF
    dimVarType = tiraParsedArgType
    dimVarVal = tiraParsedArgVal
  ELSE
    dimVarType = TIRA_ARG_LITERAL
    dimVarVal = 1
  END IF

  scratchIdx = tiraResolveHoistVarId&("LBOUND", "_VAL")
  IF scratchIdx = 0 THEN
    parse_LBOUND$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  resVarIdx = tiraDimVarId&("T", TYPE_LONG)

  descAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, vIdx

  numDimsIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId numDimsIdx, TIRA_ARG_SYMBOL, descAddrIdx, 12

  lblEndIdx = tiraLabelCreateNewId&("LB_END")
  tiraAssignId resVarIdx, TIRA_ARG_LITERAL, 0

  tiraJmpCondId JCC_JG, dimVarType, dimVarVal, TIRA_ARG_SYMBOL, numDimsIdx, lblEndIdx
  tiraJmpCondId JCC_JL, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1, lblEndIdx

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, offsetVarIdx, dimVarType, dimVarVal, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 8
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_LITERAL, 16

  dimLimitAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimLimitAddrIdx, TIRA_ARG_SYMBOL, descAddrIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  dimLBoundIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraReadMemOffsetId dimLBoundIdx, TIRA_ARG_SYMBOL, dimLimitAddrIdx, 0

  tiraAssignId resVarIdx, TIRA_ARG_SYMBOL, dimLBoundIdx

  tiraLabelId lblEndIdx
  tiraAssignId scratchIdx, TIRA_ARG_SYMBOL, resVarIdx

  tira_EndAndProcess

  exprIs.DataType = TYPE_LONG
  exprIs.IsTemp = 1
  parse_LBOUND$ = scratchName$

END FUNCTION ' parse_LBOUND$

''''''''''''''''''''''''
FUNCTION parse_LCASE$ (startIdx, endIdx, allowImplicit)

  DIM arg1Type AS LONG
  DIM arg1Val AS _INTEGER64
  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM srcPtrIdx AS LONG
  DIM strLenIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM destItrIdx AS LONG
  DIM srcItrIdx AS LONG
  DIM itrLenIdx AS LONG
  DIM loopTopIdx AS LONG
  DIM loopDoneIdx AS LONG
  DIM byteValIdx AS LONG
  DIM skipUpperLblIdx AS LONG
  DIM descPtrIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "LCASE$", 3) = 0 THEN
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionId(startIdx + 2, endIdx - 1, allowImplicit)
  IF ff = 0 THEN
    tira_Cancel
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF
  arg1Type = tiraParsedArgType
  arg1Val = tiraParsedArgVal

  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "LCASE$ REQUIRES STRING ARGUMENT", ASIS, 0
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  scratchIdx = tiraResolveHoistVarId&("LCASE", "_DSC")
  IF scratchIdx = 0 THEN
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  srcPtrIdx = tiraGetStringDataId&(arg1Type, arg1Val)
  strLenIdx = tiraGetStringLenId&(arg1Type, arg1Val)

  dataPtrIdx = tiraAllocTempMemId&(TIRA_ARG_SYMBOL, strLenIdx)
  IF compileError = 1 THEN
    tira_Cancel
    parse_LCASE$ = ""
    EXIT FUNCTION
  END IF

  destItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destItrIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  srcItrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId srcItrIdx, TIRA_ARG_SYMBOL, srcPtrIdx
  itrLenIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraAssignId itrLenIdx, TIRA_ARG_SYMBOL, strLenIdx

  loopTopIdx = tiraLabelCreateNewId&("LCASE_LOOP")
  loopDoneIdx = tiraLabelCreateNewId&("LCASE_DONE")

  tiraLabelId loopTopIdx
  tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 0, loopDoneIdx

  byteValIdx = tiraDimVarId&("T", TYPE_UBYTE)
  tiraReadMemId byteValIdx, TIRA_ARG_SYMBOL, srcItrIdx

  skipUpperLblIdx = tiraLabelCreateNewId&("LCASE_SKIP")
  tiraJmpCondId JCC_JL, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 65, skipUpperLblIdx
  tiraJmpCondId JCC_JG, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 90, skipUpperLblIdx
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 32
  tiraLabelId skipUpperLblIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, byteValIdx, TIRA_ARG_LITERAL, 1

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_SYMBOL, srcItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_SYMBOL, destItrIdx, TIRA_ARG_LITERAL, 1
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_SYMBOL, itrLenIdx, TIRA_ARG_LITERAL, 1
  tiraJmpId loopTopIdx

  tiraLabelId loopDoneIdx

  descPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId descPtrIdx, TIRA_ARG_SYMBOL, scratchIdx

  tiraBuildStrDescId TIRA_ARG_SYMBOL, descPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, strLenIdx, TIRA_ARG_LITERAL, 0

  tira_EndAndProcess

  exprIs.DataType = TYPE_STRING
  exprIs.IsTemp = 1
  parse_LCASE$ = scratchName$

END FUNCTION ' parse_LCASE$

''''''''''''''''''''''''
FUNCTION parse_LINE (startIdx)

  DIM boxType AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM dashIdx AS LONG
  DIM hasDash AS LONG
  DIM hasFirstCoord AS LONG
  DIM isStep1 AS LONG
  DIM secondCoordStart AS LONG
  DIM isStep2 AS LONG
  DIM cComma AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM p2End AS LONG
  DIM colEnd AS LONG
  DIM x1Type AS LONG
  DIM x1Val AS _INTEGER64
  DIM y1Type AS LONG
  DIM y1Val AS _INTEGER64
  DIM x2Type AS LONG
  DIM x2Val AS _INTEGER64
  DIM y2Type AS LONG
  DIM y2Val AS _INTEGER64
  DIM colorType AS LONG
  DIM colorVal AS _INTEGER64
  DIM newX1Idx AS LONG
  DIM newY1Idx AS LONG
  DIM newX2Idx AS LONG
  DIM newY2Idx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM x2GlobalIdx AS LONG
  DIM y2GlobalIdx AS LONG
  DIM fgIdx AS LONG
  DIM lineFuncIdx AS LONG
  DIM boxStr$

  tokIdx = startIdx + 1

  endIdx = lineTokenCount - 1

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED ( OR - AFTER LINE", ASIS, 0
    EXIT FUNCTION
  END IF

  hasFirstCoord = 1
  hasDash = 0
  isStep1 = 0

  IF lineTokenVals(tokIdx) = 256 + ASC("-") THEN
    hasFirstCoord = 0
    hasDash = 1
    dashIdx = tokIdx
  ELSE
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      isStep1 = 1
      tokIdx = tokIdx + 1
      IF tokIdx > endIdx THEN
        throwCompilerError "EXPECTED ( AFTER STEP", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
      throwCompilerError "EXPECTED ( OR - AFTER LINE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
    IF ff = 1 THEN
      hasDash = 1
      dashIdx = returnedData2
    END IF
  END IF

  IF hasDash = 0 THEN
    throwCompilerError "LINE MISSING -", ASIS, 0
    EXIT FUNCTION
  END IF

  IF dashIdx + 1 > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  secondCoordStart = dashIdx + 1
  isStep2 = 0

  IF lineTokenVals(secondCoordStart) = TOK_STEP THEN
    isStep2 = 1
    secondCoordStart = secondCoordStart + 1
  END IF

  IF secondCoordStart > endIdx THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(secondCoordStart) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER -", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  '''' Parse X1, Y1
  IF hasFirstCoord = 1 THEN
    cComma = retCoordinateBoundaries(tokIdx, dashIdx - 1)
    IF cComma = 0 THEN
      throwCompilerErrorAndCancelTira "LINE MISSING X1, Y1", ASIS, 0
      EXIT FUNCTION
    END IF
    cStart = returnedData2
    cEnd = returnedData3

    ff = tiraParseExpressionIntArgId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    x1Type = tiraParsedArgType
    x1Val = tiraParsedArgVal

    ff = tiraParseExpressionIntArgId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    y1Type = tiraParsedArgType
    y1Val = tiraParsedArgVal

    IF isStep1 = 1 THEN
      newX1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX1Idx, TIRA_ARG_SYMBOL, currentXIdx, x1Type, x1Val
      x1Type = TIRA_ARG_SYMBOL
      x1Val = newX1Idx

      newY1Idx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY1Idx, TIRA_ARG_SYMBOL, currentYIdx, y1Type, y1Val
      y1Type = TIRA_ARG_SYMBOL
      y1Val = newY1Idx
    END IF
  ELSE
    x1Type = TIRA_ARG_SYMBOL
    x1Val = currentXIdx
    y1Type = TIRA_ARG_SYMBOL
    y1Val = currentYIdx
  END IF

  '''' Parse X2, Y2, Color, Box
  comma3 = findComma(secondCoordStart, endIdx)
  comma4 = 0
  IF comma3 > 0 THEN
    comma4 = findComma(comma3 + 1, endIdx)
  END IF

  p2End = endIdx
  IF comma3 > 0 THEN p2End = comma3 - 1

  cComma = retCoordinateBoundaries(secondCoordStart, p2End)
  IF cComma = 0 THEN
    throwCompilerErrorAndCancelTira "LINE MISSING X2, Y2", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  ff = tiraParseExpressionIntArgId(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2Type = tiraParsedArgType
  x2Val = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2Type = tiraParsedArgType
  y2Val = tiraParsedArgVal

  IF isStep2 = 1 THEN
    newX2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newX2Idx, x1Type, x1Val, x2Type, x2Val
    x2Type = TIRA_ARG_SYMBOL
    x2Val = newX2Idx

    newY2Idx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newY2Idx, y1Type, y1Val, y2Type, y2Val
    y2Type = TIRA_ARG_SYMBOL
    y2Val = newY2Idx
  END IF

  '''' Parse color
  IF comma3 > 0 THEN
    colEnd = endIdx
    IF comma4 > 0 THEN colEnd = comma4 - 1
    IF comma3 + 1 > colEnd THEN
      ff = resolveSymbol("!G_GFX_VAL_FG")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      fgIdx = returnedData2
      colorType = TIRA_ARG_SYMBOL
      colorVal = fgIdx
    ELSE
      ff = tiraParseExpressionIntArgId(comma3 + 1, colEnd, ALIM, "COLOR MUST BE NUMERIC")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      colorType = tiraParsedArgType
      colorVal = tiraParsedArgVal
    END IF
  ELSE
    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgIdx = returnedData2
    colorType = TIRA_ARG_SYMBOL
    colorVal = fgIdx
  END IF

  '''' Parse box flag
  boxType = 0
  IF comma4 > 0 THEN
    boxStr$ = UCASE$(lineTokens$(comma4 + 1))
    IF boxStr$ = "B" THEN boxType = 1
    IF boxStr$ = "BF" THEN boxType = 2
  END IF

  ' Compile arguments and invoke the runtime routine natively via TIRA
  ff = resolveSymbol("RT_LINE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  lineFuncIdx = returnedData2

  tiraCallId7 lineFuncIdx, x1Type, x1Val, y1Type, y1Val, x2Type, x2Val, y2Type, y2Val, colorType, colorVal, TIRA_ARG_LITERAL, boxType, TIRA_ARG_LITERAL, 65535

  ' Update global cursor coordinates so subsequent STEP or -() calls originate from the correct endpoint
  ff = resolveSymbol("!G_GFX_VAL_X2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  x2GlobalIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_Y2")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  y2GlobalIdx = returnedData2

  tiraAssignId x2GlobalIdx, x2Type, x2Val
  tiraAssignId y2GlobalIdx, y2Type, y2Val
  tiraAssignId currentXIdx, x2Type, x2Val
  tiraAssignId currentYIdx, y2Type, y2Val

  tiraTriggerAutoDisplayId

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_LINE = 1

END FUNCTION ' parse_LINE

''''''''''''''''''''''''
FUNCTION parse_LINE_INPUT (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasSuppress AS LONG
  DIM hasPrompt AS LONG
  DIM promptStr$
  DIM tVal AS LONG
  DIM vTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM pStr$
  DIM litIdx AS LONG
  DIM litName$
  DIM litPtr$
  DIM tgtAddr$

  DIM isFile AS LONG
  DIM comma1 AS LONG
  DIM vTokIdx AS LONG
  DIM fileNumVar$
  DIM baseArr$
  DIM slotAddr$
  DIM handleVar$
  DIM skipIOLbl$
  DIM bufPtr$
  DIM bufLen$
  DIM loopTop$
  DIM charPtr$
  DIM bytesRead$
  DIM bytesReadPtr$
  DIM charByte$
  DIM skipCRLbl$
  DIM descPtr$

  endIdx = lineTokenCount - 1
  tokIdx = startIdx + 2 ' Skip TOK_LINE and TOK_INPUT

  isFile = 0
  IF tokIdx <= endIdx THEN
    IF lineTokens$(tokIdx) = "#" THEN
      isFile = 1
      tokIdx = tokIdx + 1
    ELSE
      IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
        isFile = 1
        lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
      END IF
    END IF
  END IF

  IF isFile = 1 THEN
    comma1 = findComma(tokIdx, endIdx)
    IF comma1 = 0 THEN
      throwCompilerError "LINE INPUT # MISSING COMMA", ASIS, 0
      EXIT FUNCTION
    END IF

    vTokIdx = comma1 + 1
    IF vTokIdx > endIdx THEN
      throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    vTok$ = lineTokens$(vTokIdx)
    IF lineTokenVals(vTokIdx) <> 0 THEN
      throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    ff = verifyNoExtraTokens(endIdx, vTokIdx, "LINE INPUT #")
    IF ff = 0 THEN EXIT FUNCTION

    vName$ = UCASE$(vTok$)

    ' Assert the expected typing to correctly inherit string nature if implicitly declared
    expectedSymType = TYPE_STRING

    ff = resolveSymbol(vName$)
    IF ff = 0 THEN EXIT FUNCTION
    vIdx = returnedData2

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    IF symbols(vIdx).DataType <> TYPE_STRING THEN
      throwCompilerError "LINE INPUT # REQUIRES STRING VARIABLE", ASIS, 0
      EXIT FUNCTION
    END IF

    tira_Start

    fileNumVar$ = tiraParseExpressionInt$(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
    IF fileNumVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

    slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

    handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

    skipIOLbl$ = tiraLabelCreateNew$("LINPUT_SKIP_IO")

    tiraJmpCond "JE", handleVar$, "0", skipIOLbl$
    tiraJmpCond "JE", handleVar$, "-1", skipIOLbl$

    bufPtr$ = tiraAllocTempMem$("8192")
    bufLen$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign bufLen$, "0"

    loopTop$ = tiraLabelCreateNew$("LINPUT_LOOP")
    tiraLabel loopTop$

    tiraJmpCond "JGE", bufLen$, "8192", skipIOLbl$

    charPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADD, charPtr$, bufPtr$, bufLen$

    bytesRead$ = tiraDimVar$("T", TYPE_LONG)
    bytesReadPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, bytesReadPtr$, bytesRead$, ""

    tiraCall "IAT_READFILE", 5, handleVar$ + ", " + charPtr$ + ", 1, " + bytesReadPtr$ + ", 0"

    tiraJmpCond "JE", bytesRead$, "0", skipIOLbl$

    charByte$ = tiraDimVar$("T", TYPE_UBYTE)
    tiraNew TC_READ_MEM, charByte$ + ", " + charPtr$

    skipCRLbl$ = tiraLabelCreateNew$("LINPUT_SKIP_CR")
    tiraJmpCond "JNE", charByte$, "13", skipCRLbl$
    tiraJmp loopTop$
    tiraLabel skipCRLbl$

    tiraJmpCond "JE", charByte$, "10", skipIOLbl$

    tiraOp TC_ADD, bufLen$, bufLen$, "1"
    tiraJmp loopTop$

    tiraLabel skipIOLbl$

    descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign descPtr$, "!G_MEM_PTR_TEMP_HEAP"
    tiraOp TC_SUB, descPtr$, descPtr$, "24"
    tiraAssign "!G_MEM_PTR_TEMP_HEAP", descPtr$

    tiraBuildStrDesc descPtr$, bufPtr$, bufLen$, "0"

    tgtAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, tgtAddr$, "#" + LTRIM$(STR$(vIdx)), ""
    tiraCall "RT_STR_ASSIGN", 2, tgtAddr$ + ", " + descPtr$

    tiraScheduleHeapReset
    tira_EndAndProcess

    parse_LINE_INPUT = 1
    EXIT FUNCTION
  END IF

  hasSuppress = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC(";") THEN
      hasSuppress = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  hasPrompt = 0
  promptStr$ = ""
  IF tokIdx <= endIdx THEN
    IF LEFT$(lineTokens$(tokIdx), 1) = CHR$(34) THEN
      hasPrompt = 1
      promptStr$ = extractQuotes$(lineTokens$(tokIdx))
      tokIdx = tokIdx + 1

      IF tokIdx <= endIdx THEN
        tVal = lineTokenVals(tokIdx)
        IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
          tokIdx = tokIdx + 1
        ELSE
          throwCompilerError "EXPECTED ; OR ,", ASIS, 0
          EXIT FUNCTION
        END IF
      ELSE
        throwCompilerError "EXPECTED ; OR ,", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF tokIdx > endIdx THEN
    throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(tokIdx)
  IF lineTokenVals(tokIdx) <> 0 THEN
    throwCompilerError "EXPECTED STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = verifyNoExtraTokens(endIdx, tokIdx, "LINE INPUT")
  IF ff = 0 THEN EXIT FUNCTION

  vName$ = UCASE$(vTok$)

  ' Assert the expected typing to correctly inherit string nature if implicitly declared
  expectedSymType = TYPE_STRING

  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF symbols(vIdx).DataType <> TYPE_STRING THEN
    throwCompilerError "LINE INPUT REQUIRES STRING VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  IF hasPrompt = 1 THEN
    pStr$ = promptStr$
  ELSE
    pStr$ = ""
  END IF

  ff = resolveSymbol("!C_EVL_DSC_LTRL_" + _TRIM$(STR$(t.TiraVarCounter)))
  t.TiraVarCounter = t.TiraVarCounter + 1

  IF isCompilingRT = 0 AND t.TiraVarCounter >= TIRA_RUNTIME_ID_BASE THEN
    throwCompilerError "TIRA VAR LIMIT EXCEEDED", ASIS, 0
    parse_LINE_INPUT = 0
    EXIT FUNCTION
  END IF

  IF ff = 0 THEN EXIT FUNCTION
  litIdx = returnedData2
  strVarData$(litIdx) = pStr$

  tira_Start

  litName$ = "!C_EVL_DSC_LTRL_" + _TRIM$(STR$(t.TiraVarCounter - 1))
  litPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign litPtr$, litName$

  tgtAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, tgtAddr$, "#" + LTRIM$(STR$(vIdx)), ""

  tiraCall "RT_INPUT", 5, tgtAddr$ + ", 1, " + litPtr$ + ", " + LTRIM$(STR$(TYPE_STRING)) + ", " + LTRIM$(STR$(hasSuppress))

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_LINE_INPUT = 1

END FUNCTION ' parse_LINE_INPUT

''''''''''''''''''''''''
FUNCTION parse_MEM$ (startIdx, endIdx, allowImplicit)

  ' Provides direct memory access and sizing information for a variable

  DIM scratchName$
  DIM scratchIdx AS LONG
  DIM vNameTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM memUdtIdx AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM baseAddrIdx AS LONG
  DIM destAddrIdx AS LONG
  DIM destSizeAddrIdx AS LONG
  DIM hasIndex AS LONG
  DIM closeParen AS LONG
  DIM numParsedIndices AS LONG
  DIM elemSize AS LONG
  DIM staticByteSize AS _INTEGER64
  DIM memSizeIdx AS LONG
  DIM descriptorAddrIdx AS LONG
  DIM descriptorDimsIdx AS LONG
  DIM runtimeDoneIdx AS LONG
  DIM dimensionIndexIdx AS LONG
  DIM dimensionLoopIdx AS LONG
  DIM dimensionDoneIdx AS LONG
  DIM dimensionOffsetIdx AS LONG
  DIM dimensionAddrIdx AS LONG
  DIM dimensionElemsIdx AS LONG
  DIM descriptorElemSizeIdx AS LONG

  IF checkIntrinsicSyntax(startIdx, endIdx, "_MEM", 3) = 0 THEN
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF

  tira_Start

  vNameTok$ = lineTokens$(startIdx + 2)
  vName$ = UCASE$(vNameTok$)

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  hasIndex = 0
  numParsedIndices = 0
  IF startIdx + 3 < endIdx THEN
    IF lineTokenVals(startIdx + 3) = 256 + ASC("(") THEN
      hasIndex = 1
      ff = tiraParseArrayArgsId(startIdx + 3, endIdx, 0)
      IF ff = 0 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        parse_MEM$ = ""
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        parse_MEM$ = ""
        EXIT FUNCTION
      END IF
    END IF
  END IF

  scratchIdx = tiraResolveHoistVarId&("MEM", "_UDT")
  IF scratchIdx = 0 THEN
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  scratchName$ = RTRIM$(symbols(scratchIdx).RecordName)

  ff = findUdtIndex("_MEM")
  memUdtIdx = returnedData2

  symbols(scratchIdx).DataType = TYPE_UDT
  symbols(scratchIdx).UDTIndex = memUdtIdx

  ' Use tiraFrontendCalcAddress$ to seamlessly fetch the direct memory pointer to the structure's data payload
  baseAddrIdx = tiraFrontendCalcAddressArgsId&(vIdx, numParsedIndices, 0)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF

  destAddrIdx = tiraFrontendCalcAddressArgsId&(scratchIdx, 0, 0)
  IF compileError = 1 THEN
    tira_Cancel
    parse_MEM$ = ""
    EXIT FUNCTION
  END IF
  tiraWriteMemId TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, baseAddrIdx, TIRA_ARG_LITERAL, 8

  ' Ensure SIZE is natively initialized to zero to prevent uninitialized data corruption inside the UDT mapping
  destSizeAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_LITERAL, 8
  tiraWriteMemId TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_LITERAL, 8

  ' Set SIZE to the complete array payload or one addressed element
  elemSize = retElementByteSize(vIdx)
  memSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  IF symbols(vIdx).IsArray > 0 AND numParsedIndices = 0 THEN

    SELECT CASE symbols(vIdx).IsArray

      CASE ARRAY_KIND_STATIC
        staticByteSize = elemSize
        staticByteSize = staticByteSize * symbols(vIdx).Size
        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, staticByteSize

      CASE ARRAY_KIND_RUNTIME
        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, 0

        descriptorAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId2 TC_ADDRESS_OF, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, vIdx

        descriptorDimsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId descriptorDimsIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 12

        runtimeDoneIdx = tiraLabelCreateNewId&("MEM_SIZE_DONE")
        tiraJmpCondId JCC_JLE, TIRA_ARG_SYMBOL, descriptorDimsIdx, TIRA_ARG_LITERAL, 0, runtimeDoneIdx

        tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, 1

        dimensionIndexIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraAssignId dimensionIndexIdx, TIRA_ARG_LITERAL, 0

        dimensionLoopIdx = tiraLabelCreateNewId&("MEM_DIM_LOOP")
        dimensionDoneIdx = tiraLabelCreateNewId&("MEM_DIM_DONE")

        tiraLabelId dimensionLoopIdx
        tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, descriptorDimsIdx, dimensionDoneIdx

        dimensionOffsetIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 8
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx, TIRA_ARG_LITERAL, 16

        dimensionAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionAddrIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, TIRA_ARG_SYMBOL, dimensionOffsetIdx

        dimensionElemsIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId dimensionElemsIdx, TIRA_ARG_SYMBOL, dimensionAddrIdx, 4

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, dimensionElemsIdx
        tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_SYMBOL, dimensionIndexIdx, TIRA_ARG_LITERAL, 1
        tiraJmpId dimensionLoopIdx

        tiraLabelId dimensionDoneIdx

        descriptorElemSizeIdx = tiraDimVarId&("T", TYPE_LONG)
        tiraReadMemOffsetId descriptorElemSizeIdx, TIRA_ARG_SYMBOL, descriptorAddrIdx, 8

        tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_SYMBOL, descriptorElemSizeIdx

        tiraLabelId runtimeDoneIdx

      CASE ELSE
        throwCompilerErrorAndCancelTira "INVALID ARRAY KIND", ASIS, 0
        parse_MEM$ = ""
        EXIT FUNCTION

    END SELECT ' symbols(vIdx).IsArray

  ELSE
    tiraAssignId memSizeIdx, TIRA_ARG_LITERAL, elemSize
  END IF

  tiraWriteMemId TIRA_ARG_SYMBOL, destSizeAddrIdx, TIRA_ARG_SYMBOL, memSizeIdx, TIRA_ARG_LITERAL, 8

  tira_EndAndProcess

  exprIs.DataType = TYPE_UDT
  exprIs.IsTemp = 1
  parse_MEM$ = scratchName$

END FUNCTION ' parse_MEM$

''''''''''''''
'' FUNCTION parse_MOUSEBUTTON$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the current state of a specified mouse button

''''''''''''''
'' FUNCTION parse_MOUSEINPUT$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Captures pending mouse events from the input queue

''''''''''''''
'' FUNCTION parse_MOUSEX$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the current horizontal position of the mouse cursor

''''''''''''''
'' FUNCTION parse_MOUSEY$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the current vertical position of the mouse cursor

''''''''''''''
'' FUNCTION parse_MOUSEWHEEL$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the amount of scroll wheel movement since the last check

''''''''''''''''''''''''
FUNCTION parse_MID_Assign (startIdx)

  DIM endIdx AS LONG
  DIM closeParenIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM strStartIdx AS LONG
  DIM strEndIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG
  DIM udtFieldNames$(256)
  DIM vTok$
  DIM vName$
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM tempUdtIndex AS LONG
  DIM udtOffset AS LONG
  DIM tempIsDynamicString AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM tempFieldSize AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM finalAddr$
  DIM dataPtr$
  DIM strLen$
  DIM lhsDescPtr$
  DIM startVar$
  DIM optLenVar$
  DIM rhsVar$
  DIM rhsDataPtr$
  DIM rhsLen$
  DIM offsetVar$
  DIM maxCopyLen$
  DIM targetAddr$
  DIM lblErr$
  DIM lblValid$
  DIM lblDone$
  DIM skipClampLen$
  DIM skipClampRhs$

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  IF tokIdx > endIdx THEN
    throwCompilerError "MALFORMED MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  IF lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
    throwCompilerError "EXPECTED ( AFTER MID$", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(tokIdx, endIdx)
  IF ff = 0 THEN
    throwCompilerError "UNMATCHED PARENTHESIS", ASIS, 0
    EXIT FUNCTION
  END IF
  closeParenIdx = returnedData2

  IF closeParenIdx + 1 > endIdx OR lineTokenVals(closeParenIdx + 1) <> 256 + ASC("=") THEN
    throwCompilerError "EXPECTED = IN MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 2, closeParenIdx - 1)
  IF comma1 = 0 THEN
    throwCompilerError "EXPECTED COMMA IN MID$ ASSIGNMENT", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, closeParenIdx - 1)

  strStartIdx = startIdx + 2
  strEndIdx = comma1 - 1

  vTok$ = lineTokens$(strStartIdx)
  vName$ = UCASE$(vTok$)
  tokIdx = strStartIdx + 1

  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      IF findSymbol(vName$) THEN
        IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
      END IF
      IF cm.ClassicMode = 1 THEN
        IF tokIdx + 1 <= strEndIdx THEN
          vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
          tokIdx = tokIdx + 2
        ELSE
          EXIT DO
        END IF
      ELSE
        throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
        addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
        EXIT FUNCTION
      END IF
    ELSE
      EXIT DO
    END IF
  LOOP

  hasIndex = 0
  IF tokIdx <= strEndIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasIndex = 1
      parenStartIdx = tokIdx
      ff = findMatchingParen(tokIdx, strEndIdx)
      IF ff = 1 THEN
        tokIdx = returnedData2 + 1
      ELSE
        EXIT FUNCTION
      END IF
    END IF
  END IF

  udtFieldCount = 0
  hasField = 0
  DO WHILE tokIdx <= strEndIdx
    IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
      hasField = 1
      udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
      udtFieldCount = udtFieldCount + 1
      IF udtFieldCount >= 256 THEN
        throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
        EXIT FUNCTION
      END IF
      tokIdx = tokIdx + 2
    ELSE
      EXIT DO
    END IF
  LOOP

  IF tokIdx <= strEndIdx THEN
    throwCompilerError "MID$ TARGET MUST BE A SINGLE ADDRESSABLE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2
  targetType = returnedData3

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
    symbols(vIdx).IsExplicit = DECL_QUIET
  END IF

  IF hasField = 1 THEN
    IF targetType <> TYPE_UDT THEN
      throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
      EXIT FUNCTION
    END IF

    tempUdtIndex = symbols(vIdx).UDTIndex
    udtOffset = 0
    tempIsDynamicString = 0

    FOR iDot = 0 TO udtFieldCount - 1
      uIdx = tempUdtIndex
      fieldFound = 0

      IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
        iField = returnedData2
        udtOffset = udtOffset + udtFields(uIdx, iField).Offset
        targetType = udtFields(uIdx, iField).DataType
        tempUdtIndex = udtFields(uIdx, iField).UDTIndex
        tempFieldSize = udtFields(uIdx, iField).Size
        tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
        fieldFound = 1
      END IF

      IF fieldFound = 0 THEN
        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
          iField = returnedData2
          IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
            udtOffset = udtOffset + udtFields(uIdx, iField).Offset
            targetType = udtFields(uIdx, iField).DataType
            tempUdtIndex = udtFields(uIdx, iField).UDTIndex
            tempFieldSize = udtFields(uIdx, iField).Size
            tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
            fieldFound = 1
          END IF
        END IF
      END IF

      IF fieldFound = 0 THEN
        throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
        EXIT FUNCTION
      END IF

      IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF
    NEXT iDot
  END IF

  IF targetType <> TYPE_STRING THEN
    throwCompilerError "MID$ TARGET MUST BE A STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  indicesStr$ = ""
  numParsedIndices = 0
  IF hasIndex = 1 THEN
    indicesStr$ = tiraParseArrayArgs$(parenStartIdx, strEndIdx, 0)
    IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
    numParsedIndices = returnedData3
  END IF

  IF hasIndex = 1 THEN
    IF symbols(vIdx).IsArray = 0 THEN
      throwCompilerError "ARRAY NOT DIMMED", ASIS, 0
      EXIT FUNCTION
    END IF
    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  isFixedStr = 0
  destLen = 0
  IF hasField = 1 THEN
    IF tempIsDynamicString = 0 THEN
      isFixedStr = 1
      destLen = tempFieldSize
    END IF
  ELSE
    destLen = retFixeSTRINGDLength(vIdx)
    IF destLen > 0 THEN
      isFixedStr = 1
    END IF
  END IF

  IF isFixedStr = 1 THEN
    dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    IF hasField = 0 AND indicesStr$ = "" THEN
      tiraAssign dataPtr$, "#" + LTRIM$(STR$(vIdx))
    ELSE
      finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
      IF finalAddr$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraAssign dataPtr$, finalAddr$
    END IF

    strLen$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign strLen$, LTRIM$(STR$(destLen))
  ELSE
    lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    IF hasField = 0 AND indicesStr$ = "" THEN
      tiraAssign lhsDescPtr$, "#" + LTRIM$(STR$(vIdx))
    ELSE
      finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
      IF finalAddr$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      tiraNew TC_READ_MEM, lhsDescPtr$ + ", " + finalAddr$
    END IF

    dataPtr$ = tiraGetStringData$(lhsDescPtr$)
    strLen$ = tiraGetStringLen$(lhsDescPtr$)
  END IF

  ' Evaluate START argument
  IF comma2 > 0 THEN
    startVar$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, ALIM, "START MUST BE NUMERIC")
  ELSE
    startVar$ = tiraParseExpressionInt$(comma1 + 1, closeParenIdx - 1, ALIM, "START MUST BE NUMERIC")
  END IF

  IF startVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  ' Evaluate LENGTH argument (optional)
  IF comma2 > 0 THEN
    optLenVar$ = tiraParseExpressionInt$(comma2 + 1, closeParenIdx - 1, ALIM, "LENGTH MUST BE NUMERIC")
    IF optLenVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  ELSE
    optLenVar$ = ""
  END IF

  ' Evaluate RHS Expression
  rhsVar$ = tiraParseExpression$(closeParenIdx + 2, endIdx, ALIM)
  IF rhsVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "MID$ ASSIGNMENT REQUIRES STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  rhsDataPtr$ = tiraGetStringData$(rhsVar$)
  rhsLen$ = tiraGetStringLen$(rhsVar$)

  lblErr$ = tiraLabelCreateNew$("MID_ERR")
  lblValid$ = tiraLabelCreateNew$("MID_VALID")
  lblDone$ = tiraLabelCreateNew$("MID_DONE")

  ' Error if start <= 0
  tiraJmpCond "JLE", startVar$, "0", lblErr$
  tiraJmp lblValid$

  tiraLabel lblErr$
  tiraFatalError "ILLEGAL FUNCTION CALL"

  tiraLabel lblValid$

  ' Convert 1-based start to 0-based offset
  offsetVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, offsetVar$, startVar$, "1"

  ' maxCopyLen = strLen - offset
  maxCopyLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_SUB, maxCopyLen$, strLen$, offsetVar$

  ' If offset >= strLen, do nothing
  tiraJmpCond "JLE", maxCopyLen$, "0", lblDone$

  ' Clamp maxCopyLen to optional length if provided
  IF optLenVar$ <> "" THEN
    ' If optional length < 0, illegal function call.
    tiraJmpCond "JL", optLenVar$, "0", lblErr$
    skipClampLen$ = tiraLabelCreateNew$("MID_SKIP_CLAMP_LEN")
    tiraJmpCond "JGE", optLenVar$, maxCopyLen$, skipClampLen$
    tiraAssign maxCopyLen$, optLenVar$
    tiraLabel skipClampLen$
  END IF

  ' Clamp maxCopyLen to RHS length
  skipClampRhs$ = tiraLabelCreateNew$("MID_SKIP_CLAMP_RHS")
  tiraJmpCond "JGE", rhsLen$, maxCopyLen$, skipClampRhs$
  tiraAssign maxCopyLen$, rhsLen$
  tiraLabel skipClampRhs$

  ' Final safety check before copy
  tiraJmpCond "JLE", maxCopyLen$, "0", lblDone$

  targetAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, targetAddr$, dataPtr$, offsetVar$

  tiraMemcpy targetAddr$, rhsDataPtr$, maxCopyLen$

  tiraLabel lblDone$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_MID_Assign = 1

END FUNCTION ' parse_MID_Assign

''''''''''''''''''''''''
FUNCTION parse_OPEN (startIdx)

  ' Opens a file for data access

  DIM hasFor AS LONG
  DIM hasLen AS LONG
  DIM forIdx AS LONG
  DIM asIdx AS LONG
  DIM lenIdx AS LONG
  DIM fileNameStart AS LONG
  DIM fileNameEnd AS LONG
  DIM fileNumStart AS LONG
  DIM fileNumEnd AS LONG
  DIM recordLenStart AS LONG
  DIM fileNameVar$
  DIM fileNumVar$
  DIM recordLenVar$
  DIM tokVal AS LONG
  DIM modeName$
  DIM modeCode AS LONG
  DIM accessVal$
  DIM dispVal$
  DIM strDataPtr$
  DIM argList$
  DIM handleVar$
  DIM openHandleValidLbl$
  DIM baseArr$
  DIM slotAddr$
  DIM stateRecordLen$
  DIM recordLenValidLbl$
  DIM stateBase$
  DIM stateSlot$
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  hasFor = 0
  forIdx = 0
  modeName$ = ""
  modeCode = FS_MODE_RANDOM
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_FOR)
  IF ff = 1 THEN
    hasFor = 1
    forIdx = returnedData2
  END IF

  asIdx = 0
  ff = findNextTokenAtDepth0(startIdx + 1, endIdx, TOK_AS)
  IF ff = 1 THEN
    asIdx = returnedData2
  ELSE
    throwCompilerError "OPEN MISSING AS", ASIS, 0
    EXIT FUNCTION
  END IF

  fileNameStart = startIdx + 1
  fileNameEnd = asIdx - 1
  IF hasFor = 1 THEN fileNameEnd = forIdx - 1

  IF hasFor = 1 THEN
    IF forIdx + 1 < asIdx THEN
      tokVal = lineTokenVals(forIdx + 1)
      modeName$ = UCASE$(lineTokens$(forIdx + 1))
      SELECT CASE tokVal
        CASE TOK_BINARY
          modeCode = FS_MODE_BINARY
        CASE TOK_RANDOM
          modeCode = FS_MODE_RANDOM
        CASE TOK_INPUT
          modeCode = FS_MODE_INPUT
        CASE ELSE
          IF modeName$ = "OUTPUT" THEN
            modeCode = FS_MODE_OUTPUT
          ELSE
            throwCompilerError "INVALID FILE MODE (ONLY BINARY/RANDOM/INPUT/OUTPUT SUPPORTED)", ASIS, 0
            EXIT FUNCTION
          END IF
      END SELECT
    ELSE
      throwCompilerError "OPEN MISSING MODE AFTER FOR", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  fileNumStart = asIdx + 1
  fileNumEnd = endIdx
  hasLen = 0
  lenIdx = 0

  ' Separate the optional LEN clause from the file-number expression
  ff = findNextTokenAtDepth0(fileNumStart, endIdx, TOK_LEN)
  IF ff = 1 THEN
    hasLen = 1
    lenIdx = returnedData2
    fileNumEnd = lenIdx - 1

    IF lenIdx + 1 > endIdx THEN
      throwCompilerError "OPEN LEN MISSING =", ASIS, 0
      EXIT FUNCTION
    END IF

    IF lineTokenVals(lenIdx + 1) <> 256 + ASC("=") THEN
      throwCompilerError "OPEN LEN MISSING =", ASIS, 0
      EXIT FUNCTION
    END IF

    recordLenStart = lenIdx + 2
    IF recordLenStart > endIdx THEN
      throwCompilerError "OPEN LEN MISSING RECORD LENGTH", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  IF fileNumStart > fileNumEnd THEN
    throwCompilerError "OPEN MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  IF fileNumStart <= fileNumEnd THEN
    ' Strip the # symbol so the expression evaluates properly
    IF lineTokens$(fileNumStart) = "#" THEN
      fileNumStart = fileNumStart + 1
    ELSE
      IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
        lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
      END IF
    END IF
  END IF

  IF fileNumStart > fileNumEnd THEN
    throwCompilerError "OPEN MISSING FILE NUMBER", ASIS, 0
    EXIT FUNCTION
  END IF

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  fileNameVar$ = tiraParseExpression$(fileNameStart, fileNameEnd, ALIM)
  IF fileNameVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  IF exprIs.DataType <> TYPE_STRING THEN
    throwCompilerErrorAndCancelTira "FILENAME MUST BE STRING", ASIS, 0
    EXIT FUNCTION
  END IF

  fileNumVar$ = tiraParseExpressionInt$(fileNumStart, fileNumEnd, ALIM, "FILENUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  IF hasLen = 1 THEN
    recordLenVar$ = tiraParseExpressionInt$(recordLenStart, endIdx, ALIM, "RECORD LENGTH MUST BE NUMERIC")
    IF recordLenVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  stateRecordLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign stateRecordLen$, "0"

  IF modeCode <> FS_MODE_BINARY THEN
    IF hasLen = 1 THEN
      tiraAssign stateRecordLen$, recordLenVar$
    ELSE
      IF modeCode = FS_MODE_RANDOM THEN
        tiraAssign stateRecordLen$, LTRIM$(STR$(FS_DEFAULT_RANDOM_RECORD_LENGTH))
      ELSE
        tiraAssign stateRecordLen$, LTRIM$(STR$(FS_DEFAULT_SEQUENTIAL_RECORD_LENGTH))
      END IF
    END IF

    recordLenValidLbl$ = tiraLabelCreateNew$("OPEN_RECORD_LENGTH_VALID")
    tiraJmpCond "JG", stateRecordLen$, "0", recordLenValidLbl$
    tiraFatalError "INVALID RECORD LENGTH"
    tiraLabel recordLenValidLbl$
  END IF

  ' Setup generic OS constants mapping to the required behavior natively to bypass CPU register constraints
  IF modeCode = FS_MODE_INPUT THEN
    accessVal$ = "-2147483648" ' read only access
    dispVal$ = "3" ' opens an existing file
  ELSE
    IF modeCode = FS_MODE_OUTPUT THEN
      accessVal$ = "1073741824" ' write only access
      dispVal$ = "2" ' creates or truncates the file
    ELSE
      accessVal$ = "-1073741824" ' GENERIC_READ OR GENERIC_WRITE
      dispVal$ = "4" ' OPEN_ALWAYS
    END IF
  END IF

  ' String arrays naturally track null terminators so it resolves seamlessly here to map directly into OS requirements
  strDataPtr$ = tiraGetStringData$(fileNameVar$)

  ' Execute the CreateFileA procedure and allow the OS to perform file locking tracking
  ' ShareMode = 3 (FILE_SHARE_READ OR FILE_SHARE_WRITE)
  argList$ = strDataPtr$ + ", " + accessVal$ + ", 3, 0, " + dispVal$ + ", 128, 0"
  tiraCall "IAT_CREATEFILEA", 7, argList$

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_GET_RET, handleVar$

  ' Reject a failed CreateFileA result before recording an invalid file handle
  openHandleValidLbl$ = tiraLabelCreateNew$("OPEN_HANDLE_VALID")
  tiraJmpCond "JNE", handleVar$, "-1", openHandleValidLbl$

  IF modeCode = FS_MODE_INPUT THEN
    tiraFatalError "FILE NOT FOUND"
  ELSE
    tiraFatalError "FILE OPEN FAILED"
  END IF

  tiraLabel openHandleValidLbl$

  ' Push OS Pointer Handle directly into the corresponding layout array index utilizing the provided File Number
  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  tiraWriteMem slotAddr$, handleVar$, "8"

  stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateBase$, "!G_FLS_V32_FILE_STATE", ""

  stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB stateSlot$, stateBase$, fileNumVar$, LTRIM$(STR$(FS_STATE_SLOT_BYTES))

  tiraWriteMem stateSlot$, LTRIM$(STR$(modeCode)), "4"
  tiraNew TC_WRITE_MEM_OFFSET, stateSlot$ + ", " + LTRIM$(STR$(FS_STATE_RECORD_LENGTH_OFFSET)) + ", " + stateRecordLen$ + ", 4"

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_OPEN = 1

END FUNCTION ' parse_OPEN

''''''''''''''''''''''''
FUNCTION parse_PALETTE (startIdx)

  DIM comma1 AS LONG
  DIM idxVarType AS LONG
  DIM idxVarVal AS _INTEGER64
  DIM colorVarType AS LONG
  DIM colorVarVal AS _INTEGER64
  DIM mappedColorIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM srcDefaultIdx AS LONG
  DIM srcDescPtrIdx AS LONG
  DIM srcDataAddrIdx AS LONG
  DIM srcOffsetVarIdx AS LONG
  DIM srcAddrIdx AS LONG
  DIM destPaletteIdx AS LONG
  DIM destDescPtrIdx AS LONG
  DIM destDataAddrIdx AS LONG
  DIM destOffsetVarIdx AS LONG
  DIM destAddrIdx AS LONG
  DIM colorValIdx AS LONG
  DIM redPrimaryIdx AS LONG
  DIM redSecondaryIdx AS LONG
  DIM redValueIdx AS LONG
  DIM greenPrimaryIdx AS LONG
  DIM greenSecondaryIdx AS LONG
  DIM greenValueIdx AS LONG
  DIM bluePrimaryIdx AS LONG
  DIM blueSecondaryIdx AS LONG
  DIM blueValueIdx AS LONG
  DIM pagingIdx AS LONG
  DIM visualPageIdx AS LONG
  DIM paletteAutoLblIdx AS LONG
  DIM paletteDisplayDoneLblIdx AS LONG
  DIM endIdx AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    tira_Start

    ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    srcDefaultIdx = returnedData2

    ff = resolveSymbol("!G_GFX_DSC_PALETTE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    destPaletteIdx = returnedData2

    ff = resolveSymbol("!G_GFX_FLG_PAGING")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    pagingIdx = returnedData2

    ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    visualPageIdx = returnedData2

    ' A bare PALETTE statement restores every entry from the pristine default palette
    srcDataAddrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, srcDefaultIdx)
    destDataAddrIdx = tiraGetStringDataId&(TIRA_ARG_SYMBOL, destPaletteIdx)
    tiraMemcpyId TIRA_ARG_SYMBOL, destDataAddrIdx, TIRA_ARG_SYMBOL, srcDataAddrIdx, TIRA_ARG_LITERAL, 1024

    paletteAutoLblIdx = tiraLabelCreateNewId&("PALETTE_RESET_AUTO")
    paletteDisplayDoneLblIdx = tiraLabelCreateNewId&("PALETTE_RESET_DISPLAY_DONE")

    tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, paletteAutoLblIdx
    tiraRefreshVisualPageId TIRA_ARG_SYMBOL, visualPageIdx
    tiraJmpId paletteDisplayDoneLblIdx

    tiraLabelId paletteAutoLblIdx
    tiraTriggerAutoDisplayId

    tiraLabelId paletteDisplayDoneLblIdx

    tiraScheduleHeapResetId
    tira_EndAndProcess

    parse_PALETTE = 1
    EXIT FUNCTION
  END IF

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "PALETTE REQUIRES 2 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 1, comma1 - 1, ALIM, "PALETTE INDEX MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  idxVarType = tiraParsedArgType
  idxVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx, ALIM, "COLOR VALUE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  colorVarType = tiraParsedArgType
  colorVarVal = tiraParsedArgVal

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PAL")

  tiraJmpCondId JCC_JL, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 0, skipLblIdx
  tiraJmpCondId JCC_JG, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 255, skipLblIdx

  colorValIdx = tiraDimVarId&("T", TYPE_LONG)

  SELECT CASE compileScreenMode

    CASE 7, 8, 9, 12
      ' These modes use sixteen attributes selected from the 64-color EGA range
      mappedColorIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, mappedColorIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 63

      redPrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 4
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_LITERAL, 2
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_LITERAL, 170

      redSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 32
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_LITERAL, 5
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx, TIRA_ARG_LITERAL, 85

      redValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redPrimaryIdx, TIRA_ARG_SYMBOL, redSecondaryIdx

      greenPrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 2
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_LITERAL, 170

      greenSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_LITERAL, 4
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx, TIRA_ARG_LITERAL, 85

      greenValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenPrimaryIdx, TIRA_ARG_SYMBOL, greenSecondaryIdx

      bluePrimaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 1
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_LITERAL, 170

      blueSecondaryIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 8
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_LITERAL, 3
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx, TIRA_ARG_LITERAL, 85

      blueValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, bluePrimaryIdx, TIRA_ARG_SYMBOL, blueSecondaryIdx

      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 8

      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, greenValueIdx
      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, blueValueIdx

    CASE 13
      ' SCREEN 13 PALETTE colors pack six-bit red, green, and blue components into one LONG
      redValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, redValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 4

      greenValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, greenValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 8
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 4

      blueValueIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_SHR, TIRA_ARG_SYMBOL, blueValueIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_LITERAL, 63
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_SYMBOL, blueValueIdx, TIRA_ARG_LITERAL, 4

      ' Store the converted color in the framebuffer palette's native BGR byte order
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_LITERAL, 16
      tiraOpId3 TC_SHL, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_SYMBOL, greenValueIdx, TIRA_ARG_LITERAL, 8

      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, redValueIdx, TIRA_ARG_SYMBOL, greenValueIdx
      tiraOpId3 TC_OR, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_SYMBOL, blueValueIdx

    CASE ELSE
      ' Map non-EGA PALETTE values through the standard sixteen-color block
      mappedColorIdx = tiraDimVarId&("T", TYPE_LONG)
      tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, mappedColorIdx, colorVarType, colorVarVal, TIRA_ARG_LITERAL, 15

      ' Read from the pristine default palette to prevent cumulative mapping corruption bugs
      ff = resolveSymbol("!G_GFX_DSC_DEFPAL")
      IF ff = 0 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      srcDefaultIdx = returnedData2

      srcDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraAssignId srcDescPtrIdx, TIRA_ARG_SYMBOL, srcDefaultIdx

      srcDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraReadMemId srcDataAddrIdx, TIRA_ARG_SYMBOL, srcDescPtrIdx

      srcOffsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, srcOffsetVarIdx, TIRA_ARG_SYMBOL, mappedColorIdx, TIRA_ARG_LITERAL, 4

      srcAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
      tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, srcAddrIdx, TIRA_ARG_SYMBOL, srcDataAddrIdx, TIRA_ARG_SYMBOL, srcOffsetVarIdx

      tiraReadMemId colorValIdx, TIRA_ARG_SYMBOL, srcAddrIdx

  END SELECT ' compileScreenMode

  ff = resolveSymbol("!G_GFX_DSC_PALETTE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destPaletteIdx = returnedData2

  destDescPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId destDescPtrIdx, TIRA_ARG_SYMBOL, destPaletteIdx

  destDataAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraReadMemId destDataAddrIdx, TIRA_ARG_SYMBOL, destDescPtrIdx

  destOffsetVarIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, destOffsetVarIdx, idxVarType, idxVarVal, TIRA_ARG_LITERAL, 4

  destAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, destDataAddrIdx, TIRA_ARG_SYMBOL, destOffsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, destAddrIdx, TIRA_ARG_SYMBOL, colorValIdx, TIRA_ARG_LITERAL, 4

  ff = resolveSymbol("!G_GFX_FLG_PAGING")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  pagingIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_VISUAL_PAGE")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  visualPageIdx = returnedData2

  paletteAutoLblIdx = tiraLabelCreateNewId&("PALETTE_AUTO")
  paletteDisplayDoneLblIdx = tiraLabelCreateNewId&("PALETTE_DISPLAY_DONE")

  tiraJmpCondId JCC_JE, TIRA_ARG_SYMBOL, pagingIdx, TIRA_ARG_LITERAL, 0, paletteAutoLblIdx
  tiraRefreshVisualPageId TIRA_ARG_SYMBOL, visualPageIdx
  tiraJmpId paletteDisplayDoneLblIdx

  tiraLabelId paletteAutoLblIdx
  tiraTriggerAutoDisplayId

  tiraLabelId paletteDisplayDoneLblIdx

  tiraLabelId skipLblIdx

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PALETTE = 1

END FUNCTION ' parse_PALETTE

''''''''''''''''''''''''
FUNCTION parse_PCOPY (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM srcVarType AS LONG
  DIM srcVarVal AS _INTEGER64
  DIM destVarType AS LONG
  DIM destVarVal AS _INTEGER64
  DIM callFuncIdx AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)

  IF comma1 = 0 THEN
    throwCompilerError "PCOPY REQUIRES SOURCE AND DESTINATION", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  ff = tiraParseExpressionIntArgId(startIdx + 1, comma1 - 1, ALIM, "SOURCE PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  srcVarType = tiraParsedArgType
  srcVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(comma1 + 1, endIdx, ALIM, "DESTINATION PAGE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  destVarType = tiraParsedArgType
  destVarVal = tiraParsedArgVal

  ff = resolveSymbol("RT_PCOPY")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  callFuncIdx = returnedData2

  tiraCallId2 callFuncIdx, srcVarType, srcVarVal, destVarType, destVarVal

  tiraScheduleHeapResetId
  tira_EndAndProcess

  parse_PCOPY = 1

END FUNCTION ' parse_PCOPY

''''''''''''''''''''''''
FUNCTION parse_PLAY (startIdx)

  parse_PLAY = parse_DELAY_Core(startIdx, 2)

END FUNCTION ' parse_PLAY

''''''''''''''
'' FUNCTION parse_POINT$ (startIdx, endIdx, allowImplicit) ' This is found within Z_EMLCMD.BLB
'
' Returns the color attribute of a specific pixel on the screen

''''''''''''''
'' FUNCTION parse_POKE (startIdx) ' This is found within Z_EMLCMD.BLB
'
' Writes a byte value directly to a hardware memory address

''''''''''''''''''''''''
FUNCTION parse_PRINT (startIdx)

  DIM endIdx AS LONG
  DIM suppressNewline AS LONG
  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM parenDepth AS LONG
  DIM tVal AS LONG
  DIM exprVar$
  DIM castVar$
  DIM fmtDescName$
  DIM fmtPtr$
  DIM tabArg$
  DIM curCol$
  DIM spacesNeeded$
  DIM dataPtr$
  DIM basePtr$
  DIM descPtr$
  DIM hndVar$
  DIM csbi$
  DIM coordVar$
  DIM skipTabLbl$
  DIM isTab AS LONG
  DIM usingIdx AS LONG
  DIM isFilePrint AS LONG
  DIM fileNumStart AS LONG
  DIM fileCommaIdx AS LONG
  DIM fileNumVar$
  DIM baseArr$
  DIM slotAddr$
  DIM stateBase$
  DIM stateSlot$
  DIM fileMode$
  DIM fileModeOkLbl$
  DIM fileHandle$
  DIM fileHandleNotZeroLbl$
  DIM fileHandleValidLbl$
  DIM strData$
  DIM strLen$
  DIM numWrt$
  DIM numWrtPtr$
  DIM crlfData$
  DIM crlfLen$
  DIM valVar$
  DIM isNeg$
  DIM skipNegLbl$
  DIM loopTop$
  DIM digit$
  DIM skipDigitNegLbl$
  DIM charVar$
  DIM skipSpaceLbl$
  DIM jmpDoneLbl$

  endIdx = lineTokenCount - 1

  isFilePrint = 0
  fileNumStart = startIdx + 1

  IF fileNumStart <= endIdx THEN
    IF lineTokens$(fileNumStart) = "#" THEN
      isFilePrint = 1
      fileNumStart = fileNumStart + 1
    ELSE
      IF LEFT$(lineTokens$(fileNumStart), 1) = "#" THEN
        isFilePrint = 1
        lineTokens$(fileNumStart) = MID$(lineTokens$(fileNumStart), 2)
      END IF
    END IF
  END IF

  IF isFilePrint = 1 THEN
    fileCommaIdx = findComma(fileNumStart, endIdx)

    IF fileCommaIdx = 0 THEN
      throwCompilerError "PRINT # MISSING COMMA", ASIS, 0
      EXIT FUNCTION
    END IF

    IF fileNumStart > fileCommaIdx - 1 THEN
      throwCompilerError "PRINT # MISSING FILE NUMBER", ASIS, 0
      EXIT FUNCTION
    END IF

    ensureFileStateSymbol
    IF compileError = 1 THEN EXIT FUNCTION

    ensureFileWriteBufferSymbols
    IF compileError = 1 THEN EXIT FUNCTION

    tira_Start

    fileNumVar$ = tiraParseExpressionInt$(fileNumStart, fileCommaIdx - 1, ALIM, "FILE NUM MUST BE NUMERIC")
    IF fileNumVar$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

    slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

    fileHandle$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, fileHandle$ + ", " + slotAddr$

    fileHandleNotZeroLbl$ = tiraLabelCreateNew$("PRINT_FILE_HANDLE_NOT_ZERO")
    fileHandleValidLbl$ = tiraLabelCreateNew$("PRINT_FILE_HANDLE_VALID")

    tiraJmpCond "JNE", fileHandle$, "0", fileHandleNotZeroLbl$
    tiraFatalError "BAD FILE NUMBER"
    tiraLabel fileHandleNotZeroLbl$

    tiraJmpCond "JNE", fileHandle$, "-1", fileHandleValidLbl$
    tiraFatalError "BAD FILE NUMBER"
    tiraLabel fileHandleValidLbl$

    stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, stateBase$, "!G_FLS_V32_FILE_STATE", ""

    stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraLeaSIB stateSlot$, stateBase$, fileNumVar$, LTRIM$(STR$(FS_STATE_SLOT_BYTES))

    fileMode$ = tiraDimVar$("T", TYPE_LONG)
    tiraNew TC_READ_MEM, fileMode$ + ", " + stateSlot$

    fileModeOkLbl$ = tiraLabelCreateNew$("PRINT_FILE_MODE_OK")
    tiraJmpCond "JE", fileMode$, LTRIM$(STR$(FS_MODE_OUTPUT)), fileModeOkLbl$
    tiraFatalError "BAD FILE MODE"
    tiraLabel fileModeOkLbl$

    tiraFlushFileWriteBuffer

    numWrt$ = tiraDimVar$("T", TYPE_LONG)
    numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

    suppressNewline = 0
    IF endIdx >= fileCommaIdx + 1 THEN
      tVal = lineTokenVals(endIdx)

      SELECT CASE tVal

        CASE 256 + ASC(";"), 256 + ASC(",")
          suppressNewline = 1
          endIdx = endIdx - 1

      END SELECT ' tVal

    END IF

    itemStart = fileCommaIdx + 1

    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      parenDepth = 0

      FOR ii = itemStart TO endIdx
        tVal = lineTokenVals(ii)
        IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
        IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

        IF parenDepth = 0 THEN
          IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
            itemEnd = ii - 1
            EXIT FOR
          END IF
        END IF
      NEXT

      IF itemEnd >= itemStart THEN
        exprVar$ = tiraParseExpression$(itemStart, itemEnd, ALIM)
        IF exprVar$ = "" THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF exprIs.DataType = TYPE_STRING THEN
          strData$ = tiraGetStringData$(exprVar$)
          strLen$ = tiraGetStringLen$(exprVar$)
        ELSE
          IF exprIs.DataType = TYPE_SINGLE OR exprIs.DataType = TYPE_DOUBLE THEN
            ' Determine format string based on original datatype BEFORE cast
            fmtDescName$ = "!G_INO_DSC_FMT_G_DBL"
            IF exprIs.DataType = TYPE_SINGLE THEN
              fmtDescName$ = "!G_INO_DSC_FMT_G_SNG"
            END IF

            ' Safely promote Singles to Doubles for the sprintf varargs requirement
            IF exprIs.DataType = TYPE_SINGLE THEN
              castVar$ = tiraDimVar$("T", TYPE_DOUBLE)
              tiraOp TC_CAST, castVar$, exprVar$, LTRIM$(STR$(TYPE_DOUBLE))
              exprVar$ = castVar$
            END IF

            strData$ = tiraAllocTempMem$("64")
            fmtPtr$ = tiraGetStringData$(fmtDescName$)

            tiraCall "IAT_SPRINTF", 3, strData$ + ", " + fmtPtr$ + ", " + exprVar$

            strLen$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_GET_RET, strLen$
          ELSE
            ' Reserve an integer buffer and build the formatted value backward
            basePtr$ = tiraAllocTempMem$("32")

            strData$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_ADD, strData$, basePtr$, "32"

            valVar$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraAssign valVar$, exprVar$

            isNeg$ = tiraDimVar$("T", TYPE_LONG)
            tiraAssign isNeg$, "0"

            skipNegLbl$ = tiraLabelCreateNew$("PRINT_FILE_INT_SKIP_NEG")
            tiraJmpCond "JGE", valVar$, "0", skipNegLbl$
            tiraAssign isNeg$, "1"
            tiraLabel skipNegLbl$

            ' Add the trailing space required by PRINT formatting
            tiraOp TC_SUB, strData$, strData$, "1"
            tiraWriteMem strData$, "32", "1"

            loopTop$ = tiraLabelCreateNew$("PRINT_FILE_INT_LOOP")
            tiraLabel loopTop$

            digit$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraOp TC_MOD, digit$, valVar$, "10"

            skipDigitNegLbl$ = tiraLabelCreateNew$("PRINT_FILE_INT_SKIP_DNEG")
            tiraJmpCond "JGE", digit$, "0", skipDigitNegLbl$
            tiraOp TC_NEG, digit$, digit$, ""
            tiraLabel skipDigitNegLbl$

            charVar$ = tiraDimVar$("T", TYPE_LONG)
            tiraOp TC_ADD, charVar$, digit$, "48"

            tiraOp TC_SUB, strData$, strData$, "1"
            tiraWriteMem strData$, charVar$, "1"

            tiraOp TC_IDIV, valVar$, valVar$, "10"
            tiraJmpCond "JNE", valVar$, "0", loopTop$

            ' Add the leading minus sign or space required by PRINT formatting
            tiraOp TC_SUB, strData$, strData$, "1"

            skipSpaceLbl$ = tiraLabelCreateNew$("PRINT_FILE_INT_SKIP_SPACE")
            tiraJmpCond "JE", isNeg$, "0", skipSpaceLbl$
            tiraWriteMem strData$, "45", "1"

            jmpDoneLbl$ = tiraLabelCreateNew$("PRINT_FILE_INT_DONE")
            tiraJmp jmpDoneLbl$

            tiraLabel skipSpaceLbl$
            tiraWriteMem strData$, "32", "1"
            tiraLabel jmpDoneLbl$

            strLen$ = tiraDimVar$("T", TYPE_LONG)
            tiraOp TC_ADD, basePtr$, basePtr$, "32"
            tiraOp TC_SUB, strLen$, basePtr$, strData$
          END IF
        END IF

        tiraCall "IAT_WRITEFILE", 5, fileHandle$ + ", " + strData$ + ", " + strLen$ + ", " + numWrtPtr$ + ", 0"
      END IF

      itemStart = itemEnd + 2
    LOOP

    IF suppressNewline = 0 THEN
      crlfData$ = tiraGetStringData$("!G_INO_DSC_CRLF")
      crlfLen$ = tiraGetStringLen$("!G_INO_DSC_CRLF")

      tiraCall "IAT_WRITEFILE", 5, fileHandle$ + ", " + crlfData$ + ", " + crlfLen$ + ", " + numWrtPtr$ + ", 0"
    END IF

    tiraScheduleHeapReset
    tira_EndAndProcess

    parse_PRINT = 1
    EXIT FUNCTION
  END IF

  usingIdx = 0
  parenDepth = 0

  FOR ii = startIdx + 1 TO endIdx
    tVal = lineTokenVals(ii)
    IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
    IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1

    IF parenDepth = 0 AND tVal = 0 THEN
      IF UCASE$(lineTokens$(ii)) = "USING" THEN
        usingIdx = ii
        EXIT FOR
      END IF
    END IF
  NEXT

  IF usingIdx > 0 THEN
    parse_PRINT = parse_PRINT_USING(startIdx, usingIdx)
    EXIT FUNCTION
  END IF

  suppressNewline = 0
  IF endIdx >= startIdx + 1 THEN
    tVal = lineTokenVals(endIdx)

    SELECT CASE tVal

      CASE 256 + ASC(";"), 256 + ASC(",")
        suppressNewline = 1
        endIdx = endIdx - 1

    END SELECT ' tVal

  END IF

  tira_Start

  IF endIdx < startIdx + 1 THEN
    IF suppressNewline = 0 THEN
      tiraCall "RT_CRLF", 0, ""
    END IF
  ELSE
    itemStart = startIdx + 1
    DO WHILE itemStart <= endIdx
      itemEnd = endIdx
      parenDepth = 0
      FOR ii = itemStart TO endIdx
        tVal = lineTokenVals(ii)
        IF tVal = 256 + ASC("(") THEN parenDepth = parenDepth + 1
        IF tVal = 256 + ASC(")") THEN parenDepth = parenDepth - 1
        IF parenDepth = 0 THEN
          IF tVal = 256 + ASC(";") OR tVal = 256 + ASC(",") THEN
            itemEnd = ii - 1
            EXIT FOR
          END IF
        END IF
      NEXT

      IF itemEnd >= itemStart THEN
        isTab = 0

        IF lineTokenVals(itemStart) = TOK_TAB THEN
          isTab = 1
        END IF

        IF isTab = 1 THEN
          IF checkIntrinsicSyntax(itemStart, itemEnd, "TAB", 3) = 0 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          tabArg$ = tiraParseExpressionInt$(itemStart + 2, itemEnd - 1, ALIM, "TAB REQUIRES NUMERIC ARGUMENT")
          IF tabArg$ = "" THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          curCol$ = tiraDimVar$("T", TYPE_LONG)
          IF cm.HasGraphics = 1 THEN
            tiraOp TC_IDIV, curCol$, "!G_INO_VAL_TEXT_X", "8"
            tiraOp TC_ADD, curCol$, curCol$, "1"
          ELSE
            hndVar$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraCall "IAT_GETSTDHANDLE", 1, "-11"
            tiraNew TC_GET_RET, hndVar$

            csbi$ = tiraAllocTempMem$("24")
            tiraCall "IAT_GETCONSOLESCREENBUFFERINFO", 2, hndVar$ + ", " + csbi$

            coordVar$ = tiraDimVar$("T", TYPE_LONG)
            tiraNew TC_READ_MEM_OFFSET, coordVar$ + ", " + csbi$ + ", 4"

            tiraOp TC_AND, curCol$, coordVar$, "65535"
            tiraOp TC_ADD, curCol$, curCol$, "1"
          END IF

          spacesNeeded$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_SUB, spacesNeeded$, tabArg$, curCol$

          skipTabLbl$ = tiraLabelCreateNew$("SKIP_TAB")
          tiraJmpCond "JLE", spacesNeeded$, "0", skipTabLbl$

          dataPtr$ = tiraAllocTempMem$(spacesNeeded$)
          tiraMemSet dataPtr$, "32", spacesNeeded$

          descPtr$ = tiraAllocTempMem$("24")
          tiraBuildStrDesc descPtr$, dataPtr$, spacesNeeded$, "0"

          tiraCall "RT_PRINT_STR", 1, descPtr$

          tiraLabel skipTabLbl$

        ELSE
          exprVar$ = tiraParseExpression$(itemStart, itemEnd, ALIM)
          IF exprVar$ = "" THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          IF exprIs.DataType = TYPE_STRING THEN
            tiraCall "RT_PRINT_STR", 1, exprVar$
          ELSE
            IF exprIs.DataType = TYPE_SINGLE OR exprIs.DataType = TYPE_DOUBLE THEN
              ' Determine format string based on original datatype BEFORE cast
              fmtDescName$ = "!G_INO_DSC_FMT_G_DBL"
              IF exprIs.DataType = TYPE_SINGLE THEN
                fmtDescName$ = "!G_INO_DSC_FMT_G_SNG"
              END IF

              ' Safely promote Singles to Doubles for the RT_PRINT_FLOAT varargs requirement
              IF exprIs.DataType = TYPE_SINGLE THEN
                castVar$ = tiraDimVar$("T", TYPE_DOUBLE)
                tiraOp TC_CAST, castVar$, exprVar$, LTRIM$(STR$(TYPE_DOUBLE))
                exprVar$ = castVar$
              END IF
              tiraCall "RT_PRINT_FLOAT", 2, exprVar$ + ", " + fmtDescName$
            ELSE
              tiraCall "RT_PRINT_INT", 1, exprVar$
            END IF
          END IF
        END IF
      END IF

      itemStart = itemEnd + 2
    LOOP

    IF suppressNewline = 0 THEN
      tiraCall "RT_CRLF", 0, ""
    END IF
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PRINT = 1

END FUNCTION ' parse_PRINT

''''''''''''''''''''''''
FUNCTION parse_PSET (startIdx)

  DIM endIdx AS LONG
  DIM hasStep AS LONG
  DIM coordStart AS LONG
  DIM coordEnd AS LONG
  DIM colorStart AS LONG
  DIM colorEnd AS LONG
  DIM cComma AS LONG
  DIM xStart AS LONG
  DIM xEnd AS LONG
  DIM yStart AS LONG
  DIM yEnd AS LONG
  DIM xVarType AS LONG
  DIM xVarVal AS _INTEGER64
  DIM yVarType AS LONG
  DIM yVarVal AS _INTEGER64
  DIM cVarType AS LONG
  DIM cVarVal AS _INTEGER64
  DIM newXIdx AS LONG
  DIM newYIdx AS LONG
  DIM currentXIdx AS LONG
  DIM currentYIdx AS LONG
  DIM fgIdx AS LONG
  DIM colorVarIdx AS LONG
  DIM skipLblIdx AS LONG
  DIM cMaskIdx AS LONG
  DIM offsetVarIdx AS LONG
  DIM fbBaseIdx AS LONG
  DIM gfxDestIdx AS LONG
  DIM targetAddrIdx AS LONG
  DIM pixelMask AS LONG

  pixelMask = 255

  SELECT CASE compileScreenMode

    CASE 1, 10
      pixelMask = 3

    CASE 2, 11
      pixelMask = 1

    CASE 7, 8, 9, 12
      pixelMask = 15

  END SELECT ' compileScreenMode

  endIdx = lineTokenCount - 1

  hasStep = 0
  coordStart = startIdx + 1

  IF coordStart <= endIdx THEN
    IF lineTokenVals(coordStart) = TOK_STEP THEN
      hasStep = 1
      coordStart = coordStart + 1
    END IF
  END IF

  IF coordStart > endIdx THEN
    throwCompilerError "PSET EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ' QB64 requires the coordinate pair to be enclosed in parentheses,
  ' including when STEP is used.
  IF lineTokenVals(coordStart) <> 256 + ASC("(") THEN
    throwCompilerError "PSET EXPECTS (X, Y)", ASIS, 0
    EXIT FUNCTION
  END IF

  ff = findMatchingParen(coordStart, endIdx)
  IF ff = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN PSET", ASIS, 0
    EXIT FUNCTION
  END IF
  coordEnd = returnedData2

  colorStart = 0
  colorEnd = 0

  ' Anything following the coordinate pair must begin with the
  ' optional color comma.
  IF coordEnd < endIdx THEN
    IF lineTokenVals(coordEnd + 1) <> 256 + ASC(",") THEN
      throwCompilerError "PSET EXPECTS COMMA AFTER COORDINATES", ASIS, 0
      EXIT FUNCTION
    END IF

    colorStart = coordEnd + 2
    colorEnd = endIdx

    IF colorStart > colorEnd THEN
      throwCompilerError "PSET EXPECTS COLOR AFTER COMMA", ASIS, 0
      EXIT FUNCTION
    END IF
  END IF

  cComma = retCoordinateBoundaries(coordStart, coordEnd)
  IF cComma = 0 THEN
    throwCompilerError "MALFORMED COORDINATES IN PSET", ASIS, 0
    EXIT FUNCTION
  END IF

  xStart = returnedData2
  xEnd = cComma - 1
  yStart = cComma + 1
  yEnd = returnedData3

  tira_Start

  ff = tiraParseExpressionIntArgId(xStart, xEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  xVarType = tiraParsedArgType
  xVarVal = tiraParsedArgVal

  ff = tiraParseExpressionIntArgId(yStart, yEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  yVarType = tiraParsedArgType
  yVarVal = tiraParsedArgVal

  ff = resolveSymbol("!G_GFX_VAL_CUR_X")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentXIdx = returnedData2

  ff = resolveSymbol("!G_GFX_VAL_CUR_Y")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  currentYIdx = returnedData2

  IF hasStep = 1 THEN
    newXIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newXIdx, TIRA_ARG_SYMBOL, currentXIdx, xVarType, xVarVal
    xVarType = TIRA_ARG_SYMBOL
    xVarVal = newXIdx

    newYIdx = tiraDimVarId&("T", TYPE_LONG)
    tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, newYIdx, TIRA_ARG_SYMBOL, currentYIdx, yVarType, yVarVal
    yVarType = TIRA_ARG_SYMBOL
    yVarVal = newYIdx
  END IF

  ' PSET establishes the graphics cursor used by STEP and DRAW.
  tiraAssignId currentXIdx, xVarType, xVarVal
  tiraAssignId currentYIdx, yVarType, yVarVal

  IF colorStart > 0 THEN
    ff = tiraParseExpressionIntArgId(colorStart, colorEnd, ALIM, "COLOR MUST BE NUMERIC")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    cVarType = tiraParsedArgType
    cVarVal = tiraParsedArgVal
  ELSE
    colorVarIdx = tiraDimVarId&("T", TYPE_LONG)

    ff = resolveSymbol("!G_GFX_VAL_FG")
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    fgIdx = returnedData2

    tiraAssignId colorVarIdx, TIRA_ARG_SYMBOL, fgIdx
    cVarType = TIRA_ARG_SYMBOL
    cVarVal = colorVarIdx
  END IF

  skipLblIdx = tiraLabelCreateNewId&("SKIP_PSET")

  ' Unsigned bounds checks reject both negative and oversized coordinates.
  tiraJmpCondId JCC_JAE, xVarType, xVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX, skipLblIdx
  tiraJmpCondId JCC_JAE, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeY, skipLblIdx

  cMaskIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, cMaskIdx, cVarType, cVarVal, TIRA_ARG_LITERAL, pixelMask

  offsetVarIdx = tiraDimVarId&("T", TYPE_LONG)
  tiraOpId3 TC_MUL, TIRA_ARG_SYMBOL, offsetVarIdx, yVarType, yVarVal, TIRA_ARG_LITERAL, gfxConfig.SizeX
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, offsetVarIdx, TIRA_ARG_SYMBOL, offsetVarIdx, xVarType, xVarVal

  fbBaseIdx = tiraDimVarId&("T", TYPE_INTEGER64)

  ff = resolveSymbol("!G_GFX_PTR_DEST_FRMB")
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  gfxDestIdx = returnedData2

  tiraAssignId fbBaseIdx, TIRA_ARG_SYMBOL, gfxDestIdx

  targetAddrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, fbBaseIdx, TIRA_ARG_SYMBOL, offsetVarIdx

  tiraWriteMemId TIRA_ARG_SYMBOL, targetAddrIdx, TIRA_ARG_SYMBOL, cMaskIdx, TIRA_ARG_LITERAL, 1

  tiraLabelId skipLblIdx

  tiraTriggerAutoDisplayId

  tira_EndAndProcess

  parse_PSET = 1

END FUNCTION ' parse_PSET

''''''''''''''''''''''''
FUNCTION parse_PUT (startIdx)

  ' Writes data to a file or draws a stored image array to the screen

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM cComma AS LONG
  DIM isFileIO AS LONG
  DIM cStart AS LONG
  DIM cEnd AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vIdx AS LONG
  DIM elemSize AS LONG
  DIM statElems AS LONG
  DIM endIdx AS LONG
  DIM putMode AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM dimEnd AS LONG

  endIdx = lineTokenCount - 1

  comma1 = findComma(startIdx + 1, endIdx)

  cComma = 0
  IF comma1 > 0 THEN
    cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  END IF

  isFileIO = 0
  IF cComma = 0 THEN
    isFileIO = 1
  END IF

  IF isFileIO = 1 THEN
    parse_PUT = parse_PUT_File(startIdx, endIdx)
    EXIT FUNCTION
  END IF

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "GRAPHICS PUT REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  IF comma1 = 0 THEN
    throwCompilerError "PUT MISSING ARRAY VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  cComma = retCoordinateBoundaries(startIdx + 1, comma1 - 1)
  IF cComma = 0 THEN
    throwCompilerError "PUT MISSING X, Y", ASIS, 0
    EXIT FUNCTION
  END IF
  cStart = returnedData2
  cEnd = returnedData3

  tira_Start

  x$ = tiraParseExpressionInt$(cStart, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
  IF x$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  y$ = tiraParseExpressionInt$(cComma + 1, cEnd, ALIM, "COORDINATE MUST BE NUMERIC")
  IF y$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)

  dimEnd = endIdx
  IF comma2 > 0 THEN dimEnd = comma2 - 1

  tokIdx = comma1 + 1
  vTok$ = lineTokens$(tokIdx)
  vName$ = UCASE$(vTok$)
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN
    tira_Cancel
    EXIT FUNCTION
  END IF
  vIdx = returnedData2

  IF symbols(vIdx).IsArray = 0 THEN
    throwCompilerErrorAndCancelTira "PUT TARGET MUST BE AN ARRAY", ASIS, 0
    EXIT FUNCTION
  END IF

  indicesStr$ = ""
  numParsedIndices = 0

  tokIdx = tokIdx + 1
  IF tokIdx <= dimEnd THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      indicesStr$ = tiraParseArrayArgs$(tokIdx, dimEnd, 0)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, 0)
  IF ptr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  elemSize = retElementByteSize(vIdx)

  descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

  numDims$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, numDims$ + ", " + descAddr$ + ", 12"

  totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign totalElems$, "1"

  dimItr$ = tiraDimVar$("T", TYPE_LONG)
  tiraAssign dimItr$, "0"
  lblDimTop$ = tiraLabelCreateNew$("DIM_TOP")
  lblDimDone$ = tiraLabelCreateNew$("DIM_DONE")

  tiraLabel lblDimTop$
  tiraJmpCond "JGE", dimItr$, numDims$, lblDimDone$

  offsetVar$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_MUL, offsetVar$, dimItr$, "8"
  tiraOp TC_ADD, offsetVar$, offsetVar$, "16"

  dimLimitAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, dimLimitAddr$, descAddr$, offsetVar$

  dimNumElems$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, dimNumElems$ + ", " + dimLimitAddr$ + ", 4"

  dimNumElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_CAST, dimNumElems64$, dimNumElems$, LTRIM$(STR$(TYPE_INTEGER64))

  tiraOp TC_MUL, totalElems$, totalElems$, dimNumElems64$
  tiraOp TC_ADD, dimItr$, dimItr$, "1"
  tiraJmp lblDimTop$

  tiraLabel lblDimDone$

  byteSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_MUL, byteSize$, totalElems$, LTRIM$(RTRIM$(STR$(elemSize)))

  baseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, baseAddr$ + ", " + descAddr$

  endPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, endPtr$, baseAddr$, byteSize$

  putMode = 1
  IF comma2 > 0 THEN
    SELECT CASE lineTokenVals(comma2 + 1)
      CASE TOK_PSET
        putMode = 0
      CASE TOK_XOR
        putMode = 1
      CASE TOK_AND
        putMode = 2
      CASE TOK_OR
        putMode = 3
      CASE TOK_PRESET
        putMode = 4
      CASE ELSE
        throwCompilerErrorAndCancelTira "UNSUPPORTED GRAPHIC STYLE FOR PUT", ASIS, 0
        EXIT FUNCTION
    END SELECT
  END IF

  tiraCall "RT_PUT", 5, x$ + ", " + y$ + ", " + ptr$ + ", " + endPtr$ + ", " + LTRIM$(STR$(putMode))

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PUT = 1

END FUNCTION ' parse_PUT

''''''''''''''''''''''''
FUNCTION parse_PUT_File (startIdx, endIdx)

  ' Writes binary data from a variable into an open file

  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM targetStart AS LONG
  DIM closeParen AS LONG
  DIM tokIdx AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  DIM hasArrayIndices AS LONG
  DIM hasPosition AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM positionVar$
  DIM stateBase$
  DIM stateSlot$
  DIM fileMode$
  DIM recordLen$
  DIM fileModeOkLbl$

  tokIdx = startIdx + 1
  IF lineTokens$(tokIdx) = "#" THEN
    tokIdx = tokIdx + 1
  ELSE
    IF LEFT$(lineTokens$(tokIdx), 1) = "#" THEN
      lineTokens$(tokIdx) = MID$(lineTokens$(tokIdx), 2)
    END IF
  END IF

  comma1 = findComma(tokIdx, endIdx)
  IF comma1 = 0 THEN
    throwCompilerError "PUT MISSING COMMA", ASIS, 0
    EXIT FUNCTION
  END IF

  comma2 = findComma(comma1 + 1, endIdx)
  IF comma2 = 0 THEN
    targetStart = comma1 + 1
  ELSE
    targetStart = comma2 + 1
  END IF

  IF targetStart > endIdx THEN
    throwCompilerError "PUT MISSING TARGET VARIABLE", ASIS, 0
    EXIT FUNCTION
  END IF

  vTok$ = lineTokens$(targetStart)
  vName$ = UCASE$(vTok$)
  symbolCountBefore = symbolCount
  ff = resolveSymbol(vName$)
  IF ff = 0 THEN EXIT FUNCTION
  vIdx = returnedData2

  wasNewSymbol = 0
  IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

  ensureFileStateSymbol
  IF compileError = 1 THEN EXIT FUNCTION

  ensureFileWriteBufferSymbols
  IF compileError = 1 THEN EXIT FUNCTION

  tira_Start

  fileNumVar$ = tiraParseExpressionInt$(tokIdx, comma1 - 1, ALIM, "FILE NUM MUST BE NUMERIC")
  IF fileNumVar$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  hasPosition = 0
  positionVar$ = ""

  IF comma2 > 0 THEN
    IF comma2 > comma1 + 1 THEN
      positionVar$ = tiraParseExpressionInt$(comma1 + 1, comma2 - 1, ALIM, "FILE POSITION MUST BE NUMERIC")
      IF positionVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      hasPosition = 1
    END IF
  END IF

  indicesStr$ = ""
  numParsedIndices = 0
  hasArrayIndices = 0

  IF targetStart < endIdx THEN
    IF lineTokenVals(targetStart + 1) = 256 + ASC("(") THEN
      hasArrayIndices = 1
      indicesStr$ = tiraParseArrayArgs$(targetStart + 1, endIdx, ALIM)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParen = returnedData2
      numParsedIndices = returnedData3
    END IF
  END IF

  IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
    IF symbols(vIdx).SubIndex = 0 THEN
      IF hasArrayIndices = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
        IF wasNewSymbol = 1 THEN
          throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
        ELSE
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
        END IF
        EXIT FUNCTION
      END IF

      IF hasArrayIndices = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
        throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  END IF

  IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
    throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
    EXIT FUNCTION
  END IF

  baseArr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, baseArr$, "!G_FLS_ARR_HANDLES", ""

  slotAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB slotAddr$, baseArr$, fileNumVar$, "8"

  handleVar$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraNew TC_READ_MEM, handleVar$ + ", " + slotAddr$

  skipFileIOLbl$ = tiraLabelCreateNew$("SKIP_FILE_IO")

  tiraJmpCond "JE", handleVar$, "0", skipFileIOLbl$
  tiraJmpCond "JE", handleVar$, "-1", skipFileIOLbl$

  stateBase$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, stateBase$, "!G_FLS_V32_FILE_STATE", ""

  stateSlot$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraLeaSIB stateSlot$, stateBase$, fileNumVar$, LTRIM$(STR$(FS_STATE_SLOT_BYTES))

  fileMode$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM, fileMode$ + ", " + stateSlot$

  recordLen$ = tiraDimVar$("T", TYPE_LONG)
  tiraNew TC_READ_MEM_OFFSET, recordLen$ + ", " + stateSlot$ + ", " + LTRIM$(STR$(FS_STATE_RECORD_LENGTH_OFFSET))

  fileModeOkLbl$ = tiraLabelCreateNew$("PUT_FILE_MODE_OK")
  tiraJmpCond "JE", fileMode$, LTRIM$(STR$(FS_MODE_BINARY)), fileModeOkLbl$
  tiraJmpCond "JE", fileMode$, LTRIM$(STR$(FS_MODE_RANDOM)), fileModeOkLbl$
  tiraFatalError "BAD FILE MODE"
  tiraLabel fileModeOkLbl$

  ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, 0)
  IF ptr$ = "" THEN
    tira_Cancel
    EXIT FUNCTION
  END IF

  dt = symbols(vIdx).DataType
  elemSize = retElementByteSize(vIdx)
  fixedLen = retFixeSTRINGDLength(vIdx)

  dataSize$ = tiraDimVar$("T", TYPE_LONG)
  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

  IF dt = TYPE_STRING AND fixedLen = 0 THEN
    descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)

    IF symbols(vIdx).IsArray > 0 THEN
      tiraNew TC_READ_MEM, descPtr$ + ", " + ptr$
    ELSE
      tiraAssign descPtr$, ptr$
    END IF

    tiraJmpCond "JE", descPtr$, "0", skipFileIOLbl$

    tiraAssign dataSize$, tiraGetStringLen$(descPtr$)
    tiraAssign dataPtr$, tiraGetStringData$(descPtr$)

    tiraJmpCond "JLE", dataSize$, "0", skipFileIOLbl$
    tiraJmpCond "JE", dataPtr$, "0", skipFileIOLbl$

  ELSE
    IF dt = TYPE_STRING AND fixedLen > 0 THEN
      tiraAssign dataSize$, LTRIM$(STR$(fixedLen))

      IF symbols(vIdx).IsArray > 0 THEN
        tiraAssign dataPtr$, ptr$
      ELSE
        descPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraAssign descPtr$, ptr$

        tiraJmpCond "JE", descPtr$, "0", skipFileIOLbl$

        tiraAssign dataPtr$, tiraGetStringData$(descPtr$)
        tiraJmpCond "JE", dataPtr$, "0", skipFileIOLbl$
      END IF
    ELSE
      tiraAssign dataSize$, LTRIM$(STR$(elemSize))
      tiraAssign dataPtr$, ptr$

      tiraJmpCond "JLE", dataSize$, "0", skipFileIOLbl$
    END IF
  END IF

  IF hasPosition = 1 THEN
    tiraFlushFileWriteBuffer
    tiraSeekFilePosition handleVar$, fileMode$, recordLen$, positionVar$
  END IF

  bufferReadyLbl$ = tiraLabelCreateNew$("FILE_WRITE_BUFFER_READY")

  tiraJmpCond "JNE", "!G_FLS_PTR_WRITE_BUFFER", "0", bufferReadyLbl$

  tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, 65536"
  tiraNew TC_GET_RET, "!G_FLS_PTR_WRITE_BUFFER"

  tiraLabel bufferReadyLbl$

  directWriteLbl$ = tiraLabelCreateNew$("FILE_WRITE_DIRECT")
  writeDoneLbl$ = tiraLabelCreateNew$("FILE_WRITE_DONE")

  tiraJmpCond "JE", "!G_FLS_PTR_WRITE_BUFFER", "0", directWriteLbl$
  tiraJmpCond "JGE", dataSize$, "65536", directWriteLbl$

  pendingReadyLbl$ = tiraLabelCreateNew$("FILE_WRITE_PENDING_READY")
  sameHandleLbl$ = tiraLabelCreateNew$("FILE_WRITE_SAME_HANDLE")

  tiraJmpCond "JLE", "!G_FLS_IDX_WRITE_COUNT", "0", pendingReadyLbl$
  tiraJmpCond "JE", "!G_FLS_PTR_WRITE_HANDLE", handleVar$, sameHandleLbl$

  tiraFlushFileWriteBuffer
  tiraJmp pendingReadyLbl$

  tiraLabel sameHandleLbl$

  combinedSize$ = tiraDimVar$("T", TYPE_LONG)
  tiraOp TC_ADD, combinedSize$, "!G_FLS_IDX_WRITE_COUNT", dataSize$
  tiraJmpCond "JLE", combinedSize$, "65536", pendingReadyLbl$

  tiraFlushFileWriteBuffer

  tiraLabel pendingReadyLbl$

  bufferDest$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign bufferDest$, "!G_FLS_PTR_WRITE_BUFFER"
  tiraOp TC_ADD, bufferDest$, bufferDest$, "!G_FLS_IDX_WRITE_COUNT"

  copyManyLbl$ = tiraLabelCreateNew$("FILE_WRITE_COPY_MANY")
  copyDoneLbl$ = tiraLabelCreateNew$("FILE_WRITE_COPY_DONE")

  tiraJmpCond "JNE", dataSize$, "1", copyManyLbl$

  byteVal$ = tiraDimVar$("T", TYPE_UBYTE)
  tiraNew TC_READ_MEM, byteVal$ + ", " + dataPtr$
  tiraWriteMem bufferDest$, byteVal$, "1"
  tiraJmp copyDoneLbl$

  tiraLabel copyManyLbl$
  tiraMemcpy bufferDest$, dataPtr$, dataSize$

  tiraLabel copyDoneLbl$

  tiraOp TC_ADD, "!G_FLS_IDX_WRITE_COUNT", "!G_FLS_IDX_WRITE_COUNT", dataSize$
  tiraAssign "!G_FLS_PTR_WRITE_HANDLE", handleVar$

  tiraJmp writeDoneLbl$

  tiraLabel directWriteLbl$

  tiraFlushFileWriteBuffer

  numWrt$ = tiraDimVar$("T", TYPE_LONG)
  numWrtPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADDRESS_OF, numWrtPtr$, numWrt$, ""

  tiraCall "IAT_WRITEFILE", 5, handleVar$ + ", " + dataPtr$ + ", " + dataSize$ + ", " + numWrtPtr$ + ", 0"

  tiraLabel writeDoneLbl$
  tiraLabel skipFileIOLbl$

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PUT_File = 1

END FUNCTION ' parse_PUT_File

''''''''''''''''''''''''
FUNCTION parse_PUTIMAGE (startIdx)

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasCoords AS LONG
  DIM isStep1 AS LONG
  DIM isStep2 AS LONG
  DIM dashIdx AS LONG
  DIM cComma AS LONG
  DIM cStart1 AS LONG
  DIM cEnd1 AS LONG
  DIM cStart2 AS LONG
  DIM cEnd2 AS LONG
  DIM commaSrcDest AS LONG
  DIM srcStart AS LONG
  DIM srcEnd AS LONG
  DIM destStart AS LONG
  DIM destEnd AS LONG
  DIM x1Var$
  DIM y1Var$
  DIM x2Var$
  DIM y2Var$
  DIM srcVar$
  DIM destVar$
  DIM newX1$
  DIM newY1$
  DIM newX2$
  DIM newY2$
  DIM cComma2 AS LONG

  endIdx = lineTokenCount - 1

  IF cm.HasGraphics = 0 THEN
    throwCompilerError "_PUTIMAGE REQUIRES #GRAPHICS", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = startIdx + 1
  hasCoords = 0
  isStep1 = 0
  isStep2 = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_STEP OR lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      hasCoords = 1
    END IF
  END IF

  tira_Start

  IF hasCoords = 1 THEN
    IF lineTokenVals(tokIdx) = TOK_STEP THEN
      isStep1 = 1
      tokIdx = tokIdx + 1
    END IF

    IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
      throwCompilerErrorAndCancelTira "EXPECTED ( AFTER _PUTIMAGE", ASIS, 0
      EXIT FUNCTION
    END IF

    dashIdx = 0
    ff = findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC("-"))
    IF ff = 1 THEN dashIdx = returnedData2

    IF dashIdx > 0 THEN
      cComma = retCoordinateBoundaries(tokIdx, dashIdx - 1)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      x1Var$ = tiraParseExpressionInt$(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x1Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y1Var$ = tiraParseExpressionInt$(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y1Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      tokIdx = dashIdx + 1
      IF tokIdx <= endIdx THEN
        IF lineTokenVals(tokIdx) = TOK_STEP THEN
          isStep2 = 1
          tokIdx = tokIdx + 1
        END IF
      END IF

      IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("(") THEN
        throwCompilerErrorAndCancelTira "EXPECTED ( AFTER -", ASIS, 0
        EXIT FUNCTION
      END IF

      commaSrcDest = findComma(tokIdx, endIdx)
      cEnd2 = endIdx
      IF commaSrcDest > 0 THEN cEnd2 = commaSrcDest - 1

      cComma2 = retCoordinateBoundaries(tokIdx, cEnd2)
      IF cComma2 = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X2, Y2", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart2 = returnedData2
      cEnd2 = returnedData3

      x2Var$ = tiraParseExpressionInt$(cStart2, cComma2 - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x2Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y2Var$ = tiraParseExpressionInt$(cComma2 + 1, cEnd2, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y2Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      tokIdx = cEnd2 + 2
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    ELSE
      ff = findMatchingParen(tokIdx, endIdx)
      IF ff = 0 THEN
        throwCompilerErrorAndCancelTira "MALFORMED COORDINATES IN _PUTIMAGE", ASIS, 0
        EXIT FUNCTION
      END IF

      cComma = retCoordinateBoundaries(tokIdx, returnedData2)
      IF cComma = 0 THEN
        throwCompilerErrorAndCancelTira "_PUTIMAGE MISSING X1, Y1", ASIS, 0
        EXIT FUNCTION
      END IF
      cStart1 = returnedData2
      cEnd1 = returnedData3

      x1Var$ = tiraParseExpressionInt$(cStart1, cComma - 1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF x1Var$ = "" THEN tira_Cancel: EXIT FUNCTION
      y1Var$ = tiraParseExpressionInt$(cComma + 1, cEnd1, ALIM, "COORDINATE MUST BE NUMERIC")
      IF y1Var$ = "" THEN tira_Cancel: EXIT FUNCTION

      x2Var$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, x2Var$, x1Var$, _TRIM$(STR$(gfxConfig.SizeX))
      tiraOp TC_SUB, x2Var$, x2Var$, "1"

      y2Var$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, y2Var$, y1Var$, _TRIM$(STR$(gfxConfig.SizeY))
      tiraOp TC_SUB, y2Var$, y2Var$, "1"

      tokIdx = returnedData2 + 1
      IF tokIdx <= endIdx AND lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      END IF
    END IF

    IF isStep1 = 1 THEN
      newX1$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newX1$, "!G_GFX_VAL_CUR_X", x1Var$
      x1Var$ = newX1$
      newY1$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newY1$, "!G_GFX_VAL_CUR_Y", y1Var$
      y1Var$ = newY1$
    END IF

    IF isStep2 = 1 THEN
      newX2$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newX2$, x1Var$, x2Var$
      x2Var$ = newX2$
      newY2$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_ADD, newY2$, y1Var$, y2Var$
      y2Var$ = newY2$
    END IF
  ELSE
    x1Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign x1Var$, "0"
    y1Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign y1Var$, "0"
    x2Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, x2Var$, _TRIM$(STR$(gfxConfig.SizeX)), "1"
    y2Var$ = tiraDimVar$("T", TYPE_LONG)
    tiraOp TC_SUB, y2Var$, _TRIM$(STR$(gfxConfig.SizeY)), "1"
  END IF

  commaSrcDest = findComma(tokIdx, endIdx)
  IF commaSrcDest > 0 THEN
    srcStart = tokIdx
    srcEnd = commaSrcDest - 1
    destStart = commaSrcDest + 1
    destEnd = endIdx
  ELSE
    srcStart = tokIdx
    srcEnd = endIdx
    destStart = 0
    destEnd = 0
  END IF

  IF srcStart > 0 AND srcStart <= srcEnd THEN
    srcVar$ = tiraParseExpressionInt$(srcStart, srcEnd, ALIM, "SOURCE MUST BE NUMERIC")
    IF srcVar$ = "" THEN tira_Cancel: EXIT FUNCTION
  ELSE
    srcVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign srcVar$, "!G_GFX_VAL_SRC_PAGE"
  END IF

  IF destStart > 0 AND destStart <= destEnd THEN
    destVar$ = tiraParseExpressionInt$(destStart, destEnd, ALIM, "DEST MUST BE NUMERIC")
    IF destVar$ = "" THEN tira_Cancel: EXIT FUNCTION
  ELSE
    destVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign destVar$, "!G_GFX_VAL_DEST_PAGE"
  END IF

  tiraCall "RT_PUTIMAGE", 6, x1Var$ + ", " + y1Var$ + ", " + x2Var$ + ", " + y2Var$ + ", " + srcVar$ + ", " + destVar$

  tiraTriggerAutoDisplay

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_PUTIMAGE = 1

END FUNCTION ' parse_PUTIMAGE

''''''''''''''''''''''''
FUNCTION parse_READ (startIdx)

  DIM itemStart AS LONG
  DIM itemEnd AS LONG
  DIM commaIdx AS LONG
  DIM tokIdx AS LONG
  DIM closeParen AS LONG
  DIM vTok$, vName$
  DIM vIdx AS LONG
  DIM hasIndex AS LONG
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM fieldName$
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM ptr$
  DIM targetType AS LONG
  DIM isStrVar AS LONG
  DIM endIdx AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG
  DIM currUdtIndex AS LONG
  DIM tempFieldSize AS LONG
  DIM tempIsDynamicString AS LONG
  DIM isFixedStr AS LONG
  DIM fixedLen AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  endIdx = lineTokenCount - 1

  IF endIdx < startIdx + 1 THEN
    throwCompilerError "READ MISSING VARIABLES", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  itemStart = startIdx + 1
  DO WHILE itemStart <= endIdx
    itemEnd = endIdx
    commaIdx = findComma(itemStart, endIdx)
    IF commaIdx > 0 THEN itemEnd = commaIdx - 1

    tokIdx = itemStart
    vTok$ = lineTokens$(tokIdx)
    vName$ = UCASE$(vTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    targetType = symbols(vIdx).DataType

    tokIdx = tokIdx + 1

    hasIndex = 0
    indicesStr$ = ""
    numParsedIndices = 0

    IF tokIdx <= itemEnd THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        indicesStr$ = tiraParseArrayArgs$(tokIdx, itemEnd, 0)
        IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
        closeParen = returnedData2
        numParsedIndices = returnedData3
        tokIdx = closeParen + 1
      END IF
    END IF

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerErrorAndCancelTira "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
      throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF

    hasField = 0
    udtOffset = 0
    currUdtIndex = symbols(vIdx).UDTIndex
    tempFieldSize = 0
    tempIsDynamicString = 0

    DO WHILE tokIdx <= itemEnd
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        tokIdx = tokIdx + 1
        fieldName$ = UCASE$(lineTokens$(tokIdx))
        tokIdx = tokIdx + 1

        IF targetType <> TYPE_UDT THEN
          throwCompilerErrorAndCancelTira "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF

        fieldFound = 0

        IF findUdtFieldIndex(currUdtIndex, fieldName$) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(currUdtIndex, iField).Offset
          targetType = udtFields(currUdtIndex, iField).DataType
          tempFieldSize = udtFields(currUdtIndex, iField).Size
          tempIsDynamicString = udtFields(currUdtIndex, iField).IsDynamicString
          currUdtIndex = udtFields(currUdtIndex, iField).UDTIndex
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          throwCompilerErrorAndCancelTira "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ptr$ = tiraFrontendCalcAddress$(vName$, indicesStr$, udtOffset)
    IF ptr$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF

    isStrVar = 0
    IF targetType = TYPE_STRING THEN isStrVar = 1

    isFixedStr = 0
    fixedLen = 0

    IF isStrVar = 1 THEN
      IF hasField = 1 THEN
        IF tempIsDynamicString = 0 THEN
          isFixedStr = 1
          fixedLen = tempFieldSize
        END IF
      ELSE
        fixedLen = retFixeSTRINGDLength(vIdx)
        IF fixedLen > 0 THEN
          isFixedStr = 1
        END IF
      END IF
    END IF

    IF isFixedStr = 1 THEN
      ' Read safely into a temporary dynamic string to respect raw character constraints
      tempDesc$ = tiraResolveHoistVar$("RDTMP", "_DSC")
      tiraAssign tempDesc$, "!G_SYS_DSC_EMPTY"

      tiraCall "RT_READ", 3, tempDesc$ + ", 1, " + LTRIM$(RTRIM$(STR$(TYPE_STRING)))

      ' Copy raw characters seamlessly into the fixed data buffer without memory corruption
      rhsDataPtr$ = tiraGetStringData$(tempDesc$)
      rhsLen$ = tiraGetStringLen$(tempDesc$)

      minLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraAssign minLen$, rhsLen$
      tiraClamp minLen$, "", LTRIM$(STR$(fixedLen))

      tiraMemcpy ptr$, rhsDataPtr$, minLen$

      padLen$ = tiraDimVar$("T", TYPE_LONG)
      tiraOp TC_SUB, padLen$, LTRIM$(STR$(fixedLen)), minLen$
      skipPadLbl$ = tiraLabelCreateNew$("SKIP_PAD")
      tiraJmpCond "JLE", padLen$, "0", skipPadLbl$

      padAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_ADD, padAddr$, ptr$, minLen$
      tiraMemSet padAddr$, "32", padLen$
      tiraLabel skipPadLbl$

      ' Garbage collect the temporary dynamic string
      tiraCall "RT_STR_ASSIGN", 2, tempDesc$ + ", !G_SYS_DSC_EMPTY"
    ELSE
      tiraCall "RT_READ", 3, ptr$ + ", " + LTRIM$(RTRIM$(STR$(isStrVar))) + ", " + LTRIM$(RTRIM$(STR$(targetType)))
    END IF

    itemStart = itemEnd + 2
  LOOP

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_READ = 1

END FUNCTION ' parse_READ

''''''''''''''''''''''''
FUNCTION parse_REDIM (startIdx)

  ' Reallocates memory for a dynamic array with new dimensions

  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isShared AS LONG
  DIM isArray AS LONG
  DIM parenStart AS LONG
  DIM parenEnd AS LONG
  DIM commaIdx AS LONG
  DIM hasTo AS LONG
  DIM toIdx AS LONG
  DIM evalStart AS LONG
  DIM isNum AS LONG
  DIM vIdx AS LONG
  DIM fixedLen AS LONG
  DIM dtMapped AS LONG
  DIM elemSize AS LONG
  DIM actualName$
  DIM typeData AS LONG
  DIM dynDimTotalVars$(255)
  DIM dynDimLBoundVars$(255)
  DIM numDims AS LONG
  DIM isNumArray AS LONG
  DIM totalStaticElems AS _INTEGER64
  DIM dimEnd AS LONG
  DIM tokParseIdx AS LONG
  DIM elementCount AS LONG
  DIM parsedLBound$
  DIM lBoundVar$
  DIM numElemsVar$
  DIM numElems64$
  DIM lBoundTok$

  DIM prevIsExplicit AS LONG
  DIM prevDataType AS LONG
  DIM prevUDTIndex AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG

  DIM tokText$
  DIM firstCh$

  DIM dimOkLbl$
  DIM prevTotal$
  DIM checkDiv$
  DIM multOkLbl$
  DIM allocOkLbl$
  DIM checkAllocDiv$

  endIdx = lineTokenCount - 1

  tokIdx = startIdx + 1
  isShared = 0

  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = TOK_SHARED THEN
      isShared = 1
      tokIdx = tokIdx + 1
    END IF
  END IF

  IF endIdx < tokIdx THEN
    throwCompilerError "MALFORMED REDIM", ASIS, 0
    EXIT FUNCTION
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    aTok$ = lineTokens$(tokIdx)
    IF lineTokenVals(tokIdx) <> 0 THEN
      throwCompilerErrorAndCancelTira "EXPECTED IDENTIFIER", ASIS, 0
      EXIT FUNCTION
    END IF

    tokIdx = tokIdx + 1
    isArray = 2 ' REDIM always maps to dynamically allocated arrays
    numDims = 0
    totalStaticElems = 1
    isNumArray = 1

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        parenStart = tokIdx

        ff = findMatchingParen(parenStart, endIdx)
        IF ff = 0 THEN
          throwCompilerErrorAndCancelTira "MALFORMED ARRAY DIMENSION", ASIS, 0
          EXIT FUNCTION
        END IF
        parenEnd = returnedData2

        '''' Dimension loop
        tokParseIdx = parenStart + 1
        DO
          commaIdx = findComma(tokParseIdx, parenEnd - 1)
          IF commaIdx > 0 THEN
            dimEnd = commaIdx - 1
          ELSE
            dimEnd = parenEnd - 1
          END IF

          numDims = numDims + 1
          IF numDims > 255 THEN
            throwCompilerErrorAndCancelTira "TOO MANY DIMENSIONS", ASIS, 0
            EXIT FUNCTION
          END IF

          hasTo = 0
          toIdx = 0
          ff = findNextTokenAtDepth0(tokParseIdx, dimEnd, TOK_TO)
          IF ff = 1 THEN
            hasTo = 1
            toIdx = returnedData2
          END IF

          lBoundVar$ = tiraDimVar$("T", TYPE_LONG)
          IF hasTo = 1 THEN
            parsedLBound$ = tiraParseExpressionInt$(tokParseIdx, toIdx - 1, ALIM, "ARRAY DIM MUST BE NUMERIC")
            IF parsedLBound$ = "" THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraAssign lBoundVar$, parsedLBound$
          ELSE
            tiraAssign lBoundVar$, LTRIM$(STR$(optionBaseValue))
          END IF

          evalStart = tokParseIdx
          IF hasTo = 1 THEN evalStart = toIdx + 1

          dynAxVar$ = tiraParseExpressionInt$(evalStart, dimEnd, ALIM, "ARRAY DIM MUST BE NUMERIC")
          IF dynAxVar$ = "" THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          numElemsVar$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_SUB, numElemsVar$, dynAxVar$, lBoundVar$
          tiraOp TC_ADD, numElemsVar$, numElemsVar$, "1"

          numElems64$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_CAST, numElems64$, numElemsVar$, LTRIM$(STR$(TYPE_INTEGER64))

          dimOkLbl$ = tiraLabelCreateNew$("DIM_OK")
          tiraJmpCond "JG", numElems64$, "0", dimOkLbl$
          tiraFatalError "INVALID ARRAY DIMENSION"
          tiraLabel dimOkLbl$

          dynDimLBoundVars$(numDims) = lBoundVar$
          dynDimTotalVars$(numDims) = numElems64$

          sizeTok$ = ""
          lBoundTok$ = LTRIM$(STR$(optionBaseValue))
          isNum = 1

          IF hasTo = 1 THEN
            lBoundTok$ = ""
            FOR ii = tokParseIdx TO toIdx - 1
              tokText$ = lineTokens$(ii)
              lBoundTok$ = lBoundTok$ + retTokenText$(tokText$)
              IF lineTokenVals(ii) = 0 THEN
                firstCh$ = LEFT$(tokText$, 1)
                IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                  isNum = 0
                END IF
              END IF
            NEXT
          END IF

          FOR ii = evalStart TO dimEnd
            tokText$ = lineTokens$(ii)
            sizeTok$ = sizeTok$ + retTokenText$(tokText$)
            IF lineTokenVals(ii) = 0 THEN
              firstCh$ = LEFT$(tokText$, 1)
              IF (firstCh$ >= "A" AND firstCh$ <= "Z") OR (firstCh$ >= "a" AND firstCh$ <= "z") OR firstCh$ = "_" OR firstCh$ = "!" OR firstCh$ = "@" OR firstCh$ = "%" THEN
                isNum = 0
              END IF
            END IF
          NEXT

          IF isNum = 1 THEN
            sizeTok$ = evalMathConst$(sizeTok$)
            lBoundTok$ = evalMathConst$(lBoundTok$)

            FOR i2 = 1 TO LEN(sizeTok$)
              chCheck$ = MID$(sizeTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
            FOR i2 = 1 TO LEN(lBoundTok$)
              chCheck$ = MID$(lBoundTok$, i2, 1)
              IF (chCheck$ < "0" OR chCheck$ > "9") AND chCheck$ <> "-" AND chCheck$ <> "." THEN
                isNum = 0
                EXIT FOR
              END IF
            NEXT
          END IF

          IF isNum = 0 OR sizeTok$ = "" OR lBoundTok$ = "" THEN
            isNumArray = 0
          ELSE
            elementCount = VAL(sizeTok$) - VAL(lBoundTok$) + 1
            IF elementCount <= 0 THEN
              throwCompilerErrorAndCancelTira "DIMENSION CANNOT BE NEGATIVE OR ZERO", ASIS, 0
              EXIT FUNCTION
            END IF
            totalStaticElems = totalStaticElems * elementCount
          END IF

          IF commaIdx > 0 THEN
            tokParseIdx = commaIdx + 1
          ELSE
            EXIT DO
          END IF
        LOOP

        IF isNumArray = 0 THEN totalStaticElems = 0

        tokIdx = parenEnd + 1
      ELSE
        throwCompilerErrorAndCancelTira "REDIM REQUIRES DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    ELSE
      throwCompilerErrorAndCancelTira "REDIM REQUIRES DIMENSIONS", ASIS, 0
      EXIT FUNCTION
    END IF

    vName$ = UCASE$(aTok$)
    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
    vIdx = returnedData2

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY AND wasNewSymbol = 0 THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
          throwCompilerErrorAndCancelTira "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + vName$ + "()", ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    prevIsExplicit = symbols(vIdx).IsExplicit
    prevDataType = symbols(vIdx).DataType
    prevUDTIndex = symbols(vIdx).UDTIndex

    ' Catch instances where the array was already established as STATIC via DIM and throw cleanly
    IF symbols(vIdx).IsArray = 1 THEN
      IF isDummyPass = 1 THEN
        throwCompilerErrorAndCancelTira "ARRAY ALREADY DIMMED AS STATIC", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    symbols(vIdx).IsArray = isArray
    symbols(vIdx).IsExplicit = DECL_EXPLICIT
    IF isShared = 1 THEN symbols(vIdx).IsShared = 1

    symbols(vIdx).Size = totalStaticElems
    symbols(vIdx).NumDimensions = numDims

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = TOK_AS THEN
        tokIdx = tokIdx + 1
        tokIdx = parseTypeClause(tokIdx, endIdx, 0)
        dtMapped = returnedData2
        typeData = returnedData3

        IF dtMapped = TYPE_UNDEFINED THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF prevIsExplicit = DECL_EXPLICIT THEN
          IF dtMapped <> prevDataType THEN
            throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
            EXIT FUNCTION
          END IF
          IF dtMapped = TYPE_UDT THEN
            IF typeData <> prevUDTIndex THEN
              throwCompilerErrorAndCancelTira "ARRAY TYPE CANNOT BE CHANGED", ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF

        symbols(vIdx).DataType = dtMapped
        IF dtMapped = TYPE_UDT THEN
          symbols(vIdx).UDTIndex = typeData
        ELSE
          IF dtMapped = TYPE_STRING THEN
            fixedLen = typeData
            IF fixedLen > 0 THEN
              symbols(vIdx).FixedStrLen = fixedLen
              strVarData$(vIdx) = SPACE$(fixedLen)
            END IF
          END IF
        END IF
      END IF
    END IF

    ' Since this is REDIM, free the previously allocated heap memory natively if it exists
    ' This is done AFTER setting IsArray and DataType so that Pass 5A and Pass 5B generate
    ' the exact same TIRA code and avoid a stack alignment drift error
    tiraScheduleArrayFree vIdx

    elemSize = retElementByteSize(vIdx)

    descAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_ADDRESS_OF, descAddr$, "#" + LTRIM$(STR$(vIdx)), ""

    elemSizeStr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign elemSizeStr$, LTRIM$(STR$(elemSize))

    totalElems$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign totalElems$, "1"

    numDimsStr$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign numDimsStr$, LTRIM$(STR$(numDims))
    tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 12, " + numDimsStr$ + ", 4"

    FOR iDim = 1 TO numDims
      tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8))) + ", " + dynDimLBoundVars$(iDim) + ", 4"
      tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", " + LTRIM$(STR$(16 + ((iDim - 1) * 8) + 4)) + ", " + dynDimTotalVars$(iDim) + ", 4"

      prevTotal$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraAssign prevTotal$, totalElems$

      tiraOp TC_MUL, totalElems$, totalElems$, dynDimTotalVars$(iDim)

      checkDiv$ = tiraDimVar$("T", TYPE_INTEGER64)
      tiraOp TC_IDIV, checkDiv$, totalElems$, prevTotal$

      multOkLbl$ = tiraLabelCreateNew$("MULT_OK")
      tiraJmpCond "JE", checkDiv$, dynDimTotalVars$(iDim), multOkLbl$
      tiraFatalError "ARRAY ALLOCATION OVERFLOW"
      tiraLabel multOkLbl$
    NEXT iDim

    allocSize$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_MUL, allocSize$, totalElems$, elemSizeStr$

    allocOkLbl$ = tiraLabelCreateNew$("ALLOC_OK")
    tiraJmpCond "JE", elemSizeStr$, "1", allocOkLbl$

    checkAllocDiv$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraOp TC_IDIV, checkAllocDiv$, allocSize$, elemSizeStr$

    tiraJmpCond "JE", checkAllocDiv$, totalElems$, allocOkLbl$
    tiraFatalError "ARRAY ALLOCATION OVERFLOW"
    tiraLabel allocOkLbl$

    tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, " + allocSize$
    arrPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_GET_RET, arrPtr$

    skipOkLbl$ = tiraLabelCreateNew$("HEAP_OK")
    tiraJmpCond "JNE", arrPtr$, "0", skipOkLbl$
    tiraFatalError "OUT OF MEMORY ALLOCATING ARRAY"
    tiraLabel skipOkLbl$

    tiraWriteMem descAddr$, arrPtr$, "8"

    elemSizeStrDWord$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign elemSizeStrDWord$, LTRIM$(STR$(elemSize))
    tiraNew TC_WRITE_MEM_OFFSET, descAddr$ + ", 8, " + elemSizeStrDWord$ + ", 4"

    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC(",") THEN
        tokIdx = tokIdx + 1
      ELSE
        throwCompilerErrorAndCancelTira "UNEXPECTED TOKEN AFTER REDIM", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF
  LOOP

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_REDIM = 1

END FUNCTION ' parse_REDIM

''''''''''''''''''''''''
FUNCTION parse_SCREEN (startIdx)

  DIM endIdx AS LONG
  DIM comma1 AS LONG
  DIM comma2 AS LONG
  DIM comma3 AS LONG
  DIM comma4 AS LONG
  DIM modeStart AS LONG
  DIM modeEnd AS LONG
  DIM activeStart AS LONG
  DIM activeEnd AS LONG
  DIM visualStart AS LONG
  DIM visualEnd AS LONG
  DIM hasMode AS LONG
  DIM hasActive AS LONG
  DIM hasVisual AS LONG
  DIM hasPageArgs AS LONG
  DIM stateChange AS LONG
  DIM textRowHeight AS LONG
  DIM srcDescPtr$
  DIM srcDataAddr$
  DIM destDescPtr$
  DIM destDataAddr$

  IF cm.HasGraphics = 0 THEN
    parse_SCREEN = 1
    EXIT FUNCTION
  END IF

  endIdx = lineTokenCount - 1

  comma1 = 0
  comma2 = 0
  comma3 = 0
  comma4 = 0

  modeStart = startIdx + 1
  modeEnd = endIdx
  activeStart = 0
  activeEnd = -1
  visualStart = 0
  visualEnd = -1

  IF startIdx + 1 <= endIdx THEN
    comma1 = findComma(startIdx + 1, endIdx)
  END IF

  IF comma1 > 0 THEN
    modeEnd = comma1 - 1

    IF comma1 + 1 <= endIdx THEN
      comma2 = findComma(comma1 + 1, endIdx)
    END IF

    IF comma2 > 0 THEN
      activeStart = comma2 + 1
      activeEnd = endIdx

      IF activeStart <= endIdx THEN
        comma3 = findComma(activeStart, endIdx)
      END IF

      IF comma3 > 0 THEN
        activeEnd = comma3 - 1
        visualStart = comma3 + 1
        visualEnd = endIdx

        IF visualStart <= endIdx THEN
          comma4 = findComma(visualStart, endIdx)
        END IF
      END IF
    END IF
  END IF

  IF comma4 > 0 THEN
    throwCompilerError "SCREEN TAKES AT MOST 4 ARGUMENTS", ASIS, 0
    EXIT FUNCTION
  END IF

  hasMode = 0
  IF modeStart <= modeEnd THEN hasMode = 1

  hasActive = 0
  IF activeStart > 0 AND activeStart <= activeEnd THEN hasActive = 1

  hasVisual = 0
  IF visualStart > 0 AND visualStart <= visualEnd THEN hasVisual = 1

  hasPageArgs = 0
  IF hasActive = 1 THEN
    hasPageArgs = 1
  ELSE
    IF hasVisual = 1 THEN hasPageArgs = 1
  END IF

  stateChange = 0
  IF hasMode = 1 THEN stateChange = 1
  IF hasPageArgs = 1 THEN stateChange = 1

  textRowHeight = 8
  IF compileScreenMode = 9 THEN textRowHeight = 14
  IF compileScreenMode = 11 OR compileScreenMode = 12 THEN textRowHeight = 16

  tira_Start

  IF hasMode = 1 THEN
    ' Evaluate the requested mode even though Pass 3 selected the output dimensions
    screenMode$ = tiraParseExpressionInt$(modeStart, modeEnd, ALIM, "SCREEN MODE MUST BE NUMERIC")
    IF screenMode$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  IF hasActive = 1 THEN
    activePage$ = tiraParseExpressionInt$(activeStart, activeEnd, ALIM, "ACTIVE PAGE MUST BE NUMERIC")
    IF activePage$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  IF hasVisual = 1 THEN
    visualPage$ = tiraParseExpressionInt$(visualStart, visualEnd, ALIM, "VISUAL PAGE MUST BE NUMERIC")
    IF visualPage$ = "" THEN
      tira_Cancel
      EXIT FUNCTION
    END IF
  END IF

  IF hasPageArgs = 1 THEN
    invalidPageLbl$ = tiraLabelCreateNew$("SCREEN_INVALID_PAGE")
    validPageLbl$ = tiraLabelCreateNew$("SCREEN_VALID_PAGE")

    IF hasActive = 1 THEN
      tiraJmpCond "JL", activePage$, "0", invalidPageLbl$
      tiraJmpCond "JG", activePage$, "3", invalidPageLbl$
    END IF

    IF hasVisual = 1 THEN
      tiraJmpCond "JL", visualPage$, "0", invalidPageLbl$
      tiraJmpCond "JG", visualPage$, "3", invalidPageLbl$
    END IF

    tiraJmp validPageLbl$

    tiraLabel invalidPageLbl$
    tiraAssign "!G_GFX_FLG_PAGING", "0"
    tiraAssign "!G_GFX_VAL_VISUAL_PAGE", "0"
    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_DISPLAY"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_DISPLAY"
    tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
    tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
    tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
    tiraAssign "!G_GFX_VAL_DEST_PAGE", "0"
    tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
    tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
    tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
    tiraAssign "!G_GFX_VAL_SRC_PAGE", "0"
    tiraFatalError "ILLEGAL FUNCTION CALL"

    tiraLabel validPageLbl$
  END IF

  IF stateChange = 1 THEN
    ' Protect visual pointer selection from the window paint procedure
    screenSpinLbl$ = tiraLabelCreateNew$("SCREEN_SPIN")
    screenAcqLbl$ = tiraLabelCreateNew$("SCREEN_ACQ")
    tiraLabel screenSpinLbl$
    screenSpinVar$ = tiraDimVar$("T", TYPE_LONG)
    tiraAssign screenSpinVar$, "1"
    tiraNew TC_XCHG, "!G_WND_FLG_RENDER_LOCK, " + screenSpinVar$ + ", 4"
    tiraJmpCond "JE", screenSpinVar$, "0", screenAcqLbl$
    tiraCall "IAT_SLEEP", 1, "0"
    tiraJmp screenSpinLbl$
    tiraLabel screenAcqLbl$
  END IF

  IF hasMode = 1 THEN
    ' A mode-bearing SCREEN statement restores default page selection
    tiraAssign "!G_GFX_FLG_PAGING", "0"
    tiraAssign "!G_GFX_VAL_VISUAL_PAGE", "0"

    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_DISPLAY"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_DISPLAY"

    tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
    tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
    tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
    tiraAssign "!G_GFX_VAL_DEST_PAGE", "0"

    tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
    tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
    tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
    tiraAssign "!G_GFX_VAL_SRC_PAGE", "0"

    ' SCREEN restores the default text colors before clearing the display
    tiraAssign "!G_GFX_VAL_FG", "15"
    tiraAssign "!G_GFX_VAL_LAST_BG", "0"

    ' SCREEN restores the default palette before clearing the display
    srcDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign srcDescPtr$, "!G_GFX_DSC_DEFPAL"

    srcDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, srcDataAddr$ + ", " + srcDescPtr$

    destDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign destDescPtr$, "!G_GFX_DSC_PALETTE"

    destDataAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraNew TC_READ_MEM, destDataAddr$ + ", " + destDescPtr$

    tiraMemcpy destDataAddr$, srcDataAddr$, "1024"

    ' Clear the complete destination framebuffer before later GET operations can capture stale pixels
    screenFbPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
    tiraAssign screenFbPtr$, "!G_GFX_PTR_DEST_FRMB"
    tiraMemSet screenFbPtr$, "0", LTRIM$(STR$(gfxConfig.SizeX * gfxConfig.SizeY))

    tiraWriteMem "!G_GFX_PTR_DEST_CNT", "0", "4"

    ' Restore the text cursor and full text viewport
    tiraAssign "!G_GFX_V32_FONTHEIGHT", LTRIM$(STR$(textRowHeight))
    tiraAssign "!G_GFX_VAL_CUR_X", "0"
    tiraAssign "!G_GFX_VAL_CUR_Y", "0"
    tiraAssign "!G_INO_VAL_TEXT_X", "0"
    tiraAssign "!G_INO_VAL_TEXT_Y", "0"
    tiraAssign "!G_INO_VAL_VIEW_TOP", "0"
    tiraAssign "!G_INO_VAL_VIEW_BOT", LTRIM$(STR$((gfxConfig.SizeY \ textRowHeight) * textRowHeight))

    ' Restore the complete graphics viewport
    tiraAssign "!G_GFX_VAL_VIEW_X1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_Y1", "0"
    tiraAssign "!G_GFX_VAL_VIEW_X2", LTRIM$(STR$(gfxConfig.SizeX))
    tiraAssign "!G_GFX_VAL_VIEW_Y2", LTRIM$(STR$(gfxConfig.SizeY))
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_X", "0"
    tiraAssign "!G_GFX_VAL_VIEW_OFFSET_Y", "0"
  END IF

  IF hasPageArgs = 1 THEN
    tiraAssign "!G_GFX_FLG_PAGING", "1"

    IF hasActive = 1 THEN
      active0Lbl$ = tiraLabelCreateNew$("SCREEN_ACTIVE_0")
      active1Lbl$ = tiraLabelCreateNew$("SCREEN_ACTIVE_1")
      active2Lbl$ = tiraLabelCreateNew$("SCREEN_ACTIVE_2")
      active3Lbl$ = tiraLabelCreateNew$("SCREEN_ACTIVE_3")
      activeDoneLbl$ = tiraLabelCreateNew$("SCREEN_ACTIVE_DONE")

      tiraJmpCond "JE", activePage$, "0", active0Lbl$
      tiraJmpCond "JE", activePage$, "1", active1Lbl$
      tiraJmpCond "JE", activePage$, "2", active2Lbl$
      tiraJmpCond "JE", activePage$, "3", active3Lbl$

      tiraLabel active0Lbl$
      tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_BACK"
      tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_BACK"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
      tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_BACK"
      tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_BACK"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_BACK", ""
      tiraJmp activeDoneLbl$

      tiraLabel active1Lbl$
      tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE1"
      tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE1"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE1", ""
      tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE1"
      tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE1"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE1", ""
      tiraJmp activeDoneLbl$

      tiraLabel active2Lbl$
      tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE2"
      tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE2"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE2", ""
      tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE2"
      tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE2"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE2", ""
      tiraJmp activeDoneLbl$

      tiraLabel active3Lbl$
      tiraAssign "!G_GFX_PTR_DEST_FRMB", "!G_GFX_PTR_FRMB_PAGE3"
      tiraAssign "!G_GFX_PTR_DEST_BUFR", "!G_GFX_PTR_BUFR_PAGE3"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_DEST_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE3", ""
      tiraAssign "!G_GFX_PTR_SRC_FRMB", "!G_GFX_PTR_FRMB_PAGE3"
      tiraAssign "!G_GFX_PTR_SRC_BUFR", "!G_GFX_PTR_BUFR_PAGE3"
      tiraOp TC_ADDRESS_OF, "!G_GFX_PTR_SRC_CNT", "!G_GFX_VAL_BUFR_COUNT_PAGE3", ""

      tiraLabel activeDoneLbl$
      tiraAssign "!G_GFX_VAL_DEST_PAGE", activePage$
      tiraAssign "!G_GFX_VAL_SRC_PAGE", activePage$
    END IF

    IF hasVisual = 1 THEN
      tiraAssign "!G_GFX_VAL_VISUAL_PAGE", visualPage$
    END IF

    visual0Lbl$ = tiraLabelCreateNew$("SCREEN_VISUAL_0")
    visual1Lbl$ = tiraLabelCreateNew$("SCREEN_VISUAL_1")
    visual2Lbl$ = tiraLabelCreateNew$("SCREEN_VISUAL_2")
    visual3Lbl$ = tiraLabelCreateNew$("SCREEN_VISUAL_3")
    visualDoneLbl$ = tiraLabelCreateNew$("SCREEN_VISUAL_DONE")

    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "0", visual0Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "1", visual1Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "2", visual2Lbl$
    tiraJmpCond "JE", "!G_GFX_VAL_VISUAL_PAGE", "3", visual3Lbl$
    tiraAssign "!G_GFX_VAL_VISUAL_PAGE", "0"
    tiraJmp visual0Lbl$

    tiraLabel visual0Lbl$
    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_BACK"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_BACK"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_BACK"
    tiraJmp visualDoneLbl$

    tiraLabel visual1Lbl$
    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_PAGE1"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_PAGE1"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE1"
    tiraJmp visualDoneLbl$

    tiraLabel visual2Lbl$
    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_PAGE2"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_PAGE2"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE2"
    tiraJmp visualDoneLbl$

    tiraLabel visual3Lbl$
    tiraAssign "!G_GFX_PTR_FRMB_FRONT", "!G_GFX_PTR_FRMB_PAGE3"
    tiraAssign "!G_GFX_PTR_BUFR_FRONT", "!G_GFX_PTR_BUFR_PAGE3"
    tiraAssign "!G_GFX_VAL_BUFR_COUNT_FRONT", "!G_GFX_VAL_BUFR_COUNT_PAGE3"

    tiraLabel visualDoneLbl$
  END IF

  IF stateChange = 1 THEN
    tiraAssign "!G_WND_FLG_RENDER_LOCK", "0"
  END IF

  IF hasPageArgs = 1 THEN
    tiraRefreshVisualPage "!G_GFX_VAL_VISUAL_PAGE"
  ELSE
    IF hasMode = 1 THEN tiraTriggerAutoDisplay
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parse_SCREEN = 1

END FUNCTION ' parse_SCREEN

''''''''''''''''''''''''
FUNCTION parse_SLEEP (startIdx)

  parse_SLEEP = parse_DELAY_Core(startIdx, 1)

END FUNCTION ' parse_SLEEP

''''''''''''''''''''''''
FUNCTION parse_STATIC (startIdx)

  parse_STATIC = parse_DIM_Core(startIdx, 1)

END FUNCTION ' parse_STATIC

''''''''''''''''''''''''
FUNCTION parseAssign (startIdx)

  DIM vTokVal AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM hasIndex AS LONG
  DIM parenStartIdx AS LONG
  DIM hasField AS LONG
  DIM udtOffset AS LONG
  DIM closeParenIdx AS LONG
  DIM eqIdx AS LONG
  DIM vIdx AS LONG
  DIM targetType AS LONG
  DIM uIdx AS LONG
  DIM fieldFound AS LONG
  DIM iField AS LONG
  DIM lhsUdtIndex AS LONG
  DIM fieldCnt AS LONG
  DIM fieldOffset AS LONG
  DIM fieldSize AS LONG
  DIM fType AS LONG
  DIM isFixedStr AS LONG
  DIM destLen AS LONG
  DIM tempUdtIndex AS LONG
  DIM tempIsDynamicString AS LONG
  DIM tempFieldSize AS LONG
  DIM isUdtBase AS LONG
  DIM functionSubIdx AS LONG
  DIM functionReturnIdx AS LONG
  DIM assignmentSuffixType AS LONG
  DIM functionReturnType AS LONG
  DIM symbolCountBefore AS LONG
  DIM wasNewSymbol AS LONG
  DIM indicesStr$
  DIM numParsedIndices AS LONG

  DIM udtFieldNames$(256)
  DIM udtFieldCount AS LONG
  DIM iDot AS LONG

  vTok$ = lineTokens$(startIdx)
  vTokVal = lineTokenVals(startIdx)

  IF vTokVal = 0 AND LEN(vTok$) > 0 THEN
    vName$ = UCASE$(vTok$)

    endIdx = lineTokenCount - 1
    tokIdx = startIdx + 1

    ' 1. Check for legacy dot variable BEFORE resolving as LHS
    DO WHILE tokIdx <= endIdx
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        IF findSymbol(vName$) THEN
          IF symbols(returnedData2).DataType = TYPE_UDT THEN EXIT DO
        END IF
        IF cm.ClassicMode = 1 THEN
          IF tokIdx + 1 <= endIdx THEN
            vName$ = vName$ + "." + UCASE$(lineTokens$(tokIdx + 1))
            tokIdx = tokIdx + 2
          ELSE
            EXIT DO
          END IF
        ELSE
          throwCompilerError "'.' ONLY ALLOWED ON UDT VARIABLES", ASIS, 0
          addStatusMsg "USE #CLASSIC DIRECTIVE FOR DOTS IN VARIABLE NAMES"
          EXIT FUNCTION
        END IF
      ELSE
        EXIT DO
      END IF
    LOOP

    ' 2. Identify and validate array index boundaries
    IF tokIdx <= endIdx THEN
      IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
        hasIndex = 1
        parenStartIdx = tokIdx
        IF findMatchingParen(tokIdx, endIdx) = 1 THEN ' Close parenthesis found
          closeParenIdx = returnedData2
        ELSE
          EXIT FUNCTION
        END IF

        tokIdx = closeParenIdx + 1
      END IF
    END IF

    ' 3. Detect and process UDT field separators iteratively (Now immune to legacy dot variables)
    udtFieldCount = 0
    hasField = 0
    DO WHILE tokIdx <= endIdx
      IF lineTokenVals(tokIdx) = 256 + ASC(".") THEN
        hasField = 1
        udtFieldNames$(udtFieldCount) = UCASE$(lineTokens$(tokIdx + 1))
        udtFieldCount = udtFieldCount + 1
        IF udtFieldCount >= 256 THEN
          throwCompilerError "UDT FIELD DEPTH EXCEEDED", ASIS, 0
          EXIT FUNCTION
        END IF
        tokIdx = tokIdx + 2 ' Skip the dot and the field name
      ELSE
        EXIT DO
      END IF
    LOOP

    ' Verify the presence of assignment operator
    IF tokIdx > endIdx OR lineTokenVals(tokIdx) <> 256 + ASC("=") THEN EXIT FUNCTION
    eqIdx = tokIdx

    ' Match QB64 function-return suffix behavior before ordinary symbol resolution
    IF insideSub = 2 AND currentSubName$ <> "" THEN
      functionName$ = UCASE$(RTRIM$(currentSubName$))
      functionBaseName$ = functionName$

      IF RIGHT$(functionBaseName$, 2) = "&&" THEN
        functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 2)
      ELSE
        IF RIGHT$(functionBaseName$, 2) = "~&" THEN
          functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 2)
        ELSE
          functionSuffix$ = RIGHT$(functionBaseName$, 1)

          SELECT CASE functionSuffix$

            CASE "$", "#", "!", "&", "%", "~"
              functionBaseName$ = LEFT$(functionBaseName$, LEN(functionBaseName$) - 1)

          END SELECT ' functionSuffix$

        END IF
      END IF

      assignmentBaseName$ = vName$
      assignmentSuffix$ = ""

      IF RIGHT$(assignmentBaseName$, 2) = "&&" THEN
        assignmentSuffix$ = "&&"
        assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 2)
      ELSE
        IF RIGHT$(assignmentBaseName$, 2) = "~&" THEN
          assignmentSuffix$ = "~&"
          assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 2)
        ELSE
          assignmentSuffix$ = RIGHT$(assignmentBaseName$, 1)

          SELECT CASE assignmentSuffix$

            CASE "$", "#", "!", "&", "%", "~"
              assignmentBaseName$ = LEFT$(assignmentBaseName$, LEN(assignmentBaseName$) - 1)

            CASE ELSE
              assignmentSuffix$ = ""

          END SELECT ' assignmentSuffix$

        END IF
      END IF

      IF assignmentBaseName$ = functionBaseName$ THEN
        ff = findSubIndex(functionName$)
        IF ff = 0 THEN
          throwCompilerError "FUNCTION RETURN TARGET NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        functionSubIdx = returnedData2
        functionReturnIdx = subs(functionSubIdx).ReturnVarIdx
        functionReturnType = symbols(functionReturnIdx).DataType

        IF assignmentSuffix$ <> "" THEN
          assignmentSuffixType = TYPE_UNDEFINED

          SELECT CASE assignmentSuffix$

            CASE "$"
              assignmentSuffixType = TYPE_STRING

            CASE "#"
              assignmentSuffixType = TYPE_DOUBLE

            CASE "!"
              assignmentSuffixType = TYPE_SINGLE

            CASE "&"
              assignmentSuffixType = TYPE_LONG

            CASE "%"
              assignmentSuffixType = TYPE_INTEGER

            CASE "&&"
              assignmentSuffixType = TYPE_INTEGER64

            CASE "~", "~&"
              assignmentSuffixType = TYPE_ULONG

          END SELECT ' assignmentSuffix$

          IF assignmentSuffixType <> functionReturnType THEN
            throwCompilerError "FUNCTION RETURN SUFFIX MISMATCH: " + vName$ + " DOES NOT MATCH " + functionName$, ASIS, 0
            EXIT FUNCTION
          END IF
        END IF

        vName$ = functionName$
      END IF
    END IF

    expectedSymType = TYPE_ANY

    symbolCountBefore = symbolCount
    ff = resolveSymbol(vName$)
    IF ff = 0 THEN EXIT FUNCTION
    vIdx = returnedData2
    targetType = returnedData3

    wasNewSymbol = 0
    IF symbolCount > symbolCountBefore THEN wasNewSymbol = 1

    IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
      IF symbols(vIdx).SubIndex = 0 THEN
        IF hasIndex = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
          IF wasNewSymbol = 1 THEN
            throwCompilerError "UNDECLARED ARRAY " + vName$ + "()", ASIS, 0
          ELSE
            throwCompilerError "NAME CLASH: SCALAR " + vName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + vName$ + "()", ASIS, 0
          END IF
          EXIT FUNCTION
        END IF

        IF hasIndex = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
          throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
          EXIT FUNCTION
        END IF
      END IF
    END IF

    IF symbols(vIdx).IsExplicit = DECL_IMPLICIT THEN
      symbols(vIdx).IsExplicit = DECL_QUIET
    END IF

    ' Extract and process UDT field metadata through nested command stack
    IF hasField = 1 THEN
      IF targetType <> TYPE_UDT THEN
        throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
        EXIT FUNCTION
      END IF

      tempUdtIndex = symbols(vIdx).UDTIndex
      udtOffset = 0
      tempIsDynamicString = 0

      FOR iDot = 0 TO udtFieldCount - 1
        uIdx = tempUdtIndex
        fieldFound = 0

        IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot)) THEN
          iField = returnedData2
          udtOffset = udtOffset + udtFields(uIdx, iField).Offset
          targetType = udtFields(uIdx, iField).DataType
          tempUdtIndex = udtFields(uIdx, iField).UDTIndex
          tempFieldSize = udtFields(uIdx, iField).Size
          tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
          fieldFound = 1
        END IF

        IF fieldFound = 0 THEN
          IF findUdtFieldIndex(uIdx, udtFieldNames$(iDot) + "$") THEN
            iField = returnedData2
            IF udtFields(uIdx, iField).DataType = TYPE_STRING THEN
              udtOffset = udtOffset + udtFields(uIdx, iField).Offset
              targetType = udtFields(uIdx, iField).DataType
              tempUdtIndex = udtFields(uIdx, iField).UDTIndex
              tempFieldSize = udtFields(uIdx, iField).Size
              tempIsDynamicString = udtFields(uIdx, iField).IsDynamicString
              fieldFound = 1
            END IF
          END IF
        END IF

        IF fieldFound = 0 THEN
          throwCompilerError "UDT FIELD NOT FOUND", ASIS, 0
          EXIT FUNCTION
        END IF

        IF iDot < udtFieldCount - 1 AND targetType <> TYPE_UDT THEN
          throwCompilerError "VARIABLE IS NOT A UDT", ASIS, 0
          EXIT FUNCTION
        END IF
      NEXT iDot
    END IF

    expectedSymType = TYPE_ANY

    tira_Start

    ' Parse the left side array indices
    indicesStr$ = ""
    numParsedIndices = 0
    IF hasIndex = 1 THEN
      indicesStr$ = tiraParseArrayArgs$(parenStartIdx, closeParenIdx, cm.ClassicMode)
      IF indicesStr$ = "" AND compileError = 1 THEN EXIT FUNCTION
      closeParenIdx = returnedData2
      numParsedIndices = returnedData3
    END IF

    ' Validate array dimensions against declaration status
    IF hasIndex = 1 THEN
      IF symbols(vIdx).IsArray = 0 THEN
        throwCompilerError "ARRAY NOT DIMMED", ASIS, 0
        EXIT FUNCTION
      END IF
      IF symbols(vIdx).NumDimensions > 0 AND numParsedIndices <> symbols(vIdx).NumDimensions THEN
        throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        EXIT FUNCTION
      END IF
    END IF

    expectedSymType = targetType

    IF targetType = TYPE_UDT THEN
      lhsUdtIndex = symbols(vIdx).UDTIndex
      IF hasField = 1 THEN lhsUdtIndex = tempUdtIndex

      ' Call the isolated helper function to evaluate and validate the right side UDT
      rhsBase$ = tiraParseRhsUdtBase$(eqIdx + 1, endIdx, lhsUdtIndex)
      IF rhsBase$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      ' Calculate the source and destination memory addresses
      lhsBase$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
      IF lhsBase$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      ' Perform deep cloning of UDT field data
      fieldCnt = udts(lhsUdtIndex).FieldCount
      FOR iField = 0 TO fieldCnt - 1
        fieldOffset = udtFields(lhsUdtIndex, iField).Offset
        fieldSize = udtFields(lhsUdtIndex, iField).Size
        fType = udtFields(lhsUdtIndex, iField).DataType

        IF fType = TYPE_STRING AND udtFields(lhsUdtIndex, iField).IsDynamicString = 1 THEN
          rhsDescAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, rhsDescAddr$, rhsBase$, LTRIM$(STR$(fieldOffset))

          rhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraNew TC_READ_MEM, rhsDescPtr$ + ", " + rhsDescAddr$

          skipRhsNull$ = tiraLabelCreateNew$("SKIP_RHS_NULL")
          tiraJmpCond "JNE", rhsDescPtr$, "0", skipRhsNull$
          tiraAssign rhsDescPtr$, "!G_SYS_DSC_EMPTY"
          tiraLabel skipRhsNull$

          lhsDescAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, lhsDescAddr$, lhsBase$, LTRIM$(STR$(fieldOffset))

          lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraNew TC_READ_MEM, lhsDescPtr$ + ", " + lhsDescAddr$

          tiraEnsureStringAlloc lhsDescPtr$, lhsDescAddr$

          tiraCall "RT_STR_ASSIGN", 2, lhsDescPtr$ + ", " + rhsDescPtr$
        ELSE
          lhsFieldAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, lhsFieldAddr$, lhsBase$, LTRIM$(STR$(fieldOffset))

          rhsFieldAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, rhsFieldAddr$, rhsBase$, LTRIM$(STR$(fieldOffset))

          IF fType = TYPE_UDT THEN
            tiraCopyUdtValue lhsFieldAddr$, rhsFieldAddr$, udtFields(lhsUdtIndex, iField).UDTIndex
          ELSE
            tiraMemcpy lhsFieldAddr$, rhsFieldAddr$, LTRIM$(STR$(fieldSize))
          END IF
        END IF
      NEXT iField
    ELSE
      ' Parse the right side scalar or string expression
      rhsVar$ = tiraParseExpression$(eqIdx + 1, endIdx, cm.ClassicMode)
      IF rhsVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF
      IF targetType = TYPE_STRING AND exprIs.DataType <> TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH: ATTEMPTED ASSIGN NUM TO STRING", ASIS, 0
        EXIT FUNCTION
      END IF
      IF targetType <> TYPE_STRING AND exprIs.DataType = TYPE_STRING THEN
        throwCompilerErrorAndCancelTira "TYPE MISMATCH: ATTEMPTED ASSIGN STRING TO NUM", ASIS, 0
        EXIT FUNCTION
      END IF

      IF targetType = TYPE_STRING THEN
        isFixedStr = 0
        destLen = 0
        IF hasField = 1 THEN
          IF tempIsDynamicString = 0 THEN
            isFixedStr = 1
            destLen = tempFieldSize
          END IF
        ELSE
          destLen = retFixeSTRINGDLength(vIdx)
          IF destLen > 0 THEN
            isFixedStr = 1
          END IF
        END IF

        IF isFixedStr = 1 THEN
          lhsDataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          IF hasField = 0 AND indicesStr$ = "" THEN
            lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
            tiraAssign lhsDescPtr$, "#" + LTRIM$(STR$(vIdx))
            tiraNew TC_READ_MEM, lhsDataPtr$ + ", " + lhsDescPtr$
          ELSE
            finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
            IF finalAddr$ = "" THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraAssign lhsDataPtr$, finalAddr$
          END IF

          rhsDataPtr$ = tiraGetStringData$(rhsVar$)
          rhsLen$ = tiraGetStringLen$(rhsVar$)

          minLen$ = tiraDimVar$("T", TYPE_LONG)
          tiraAssign minLen$, rhsLen$
          tiraClamp minLen$, "", LTRIM$(STR$(destLen))

          tiraMemcpy lhsDataPtr$, rhsDataPtr$, minLen$

          padLen$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_SUB, padLen$, LTRIM$(STR$(destLen)), minLen$
          skipPadLbl$ = tiraLabelCreateNew$("SKIP_PAD")
          tiraJmpCond "JLE", padLen$, "0", skipPadLbl$

          padAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADD, padAddr$, lhsDataPtr$, minLen$
          tiraMemSet padAddr$, "32", padLen$

          tiraLabel skipPadLbl$
        ELSE
          lhsDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
          IF hasField = 0 AND indicesStr$ = "" THEN
            tiraAssign lhsDescPtr$, "#" + LTRIM$(STR$(vIdx))
          ELSE
            finalAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
            IF finalAddr$ = "" THEN
              tira_Cancel
              EXIT FUNCTION
            END IF
            tiraNew TC_READ_MEM, lhsDescPtr$ + ", " + finalAddr$

            tiraEnsureStringAlloc lhsDescPtr$, finalAddr$
          END IF

          tiraCall "RT_STR_ASSIGN", 2, lhsDescPtr$ + ", " + rhsVar$
        END IF

      ELSE
        ' Scalar write
        IF hasIndex = 0 AND hasField = 0 THEN
          tiraAssign "#" + LTRIM$(STR$(vIdx)), rhsVar$
        ELSE
          destAddr$ = tiraFrontendCalcAddress$(RTRIM$(symbols(vIdx).RecordName), indicesStr$, udtOffset)
          IF destAddr$ = "" THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          sMode$ = RTRIM$(typeDb(targetType).TiraMode)
          IF sMode$ = "" THEN sMode$ = "8"

          tiraWriteMem destAddr$, rhsVar$, sMode$
        END IF
      END IF
    END IF

    tiraScheduleHeapReset
    tira_EndAndProcess

    parseAssign = 1
    EXIT FUNCTION
  END IF

END FUNCTION ' parseAssign

''''''''''''''''''''''''
FUNCTION parseAssignRouter (startIdx)

  ' This routing function serves as the gateway for implict typing
  ' By detecting the '=' assignment operator *before* the variable is resolved,
  ' we enable the backend (parseAssign) to evaluate the right-hand side first.
  ' This lookahead establishes the expected type (e.g., TYPE_STRING) so that
  ' when the left-hand implicit variable is finally registered, it perfectly
  ' inherits the nature of the data being assigned to it

  ' If the line starts with an identifier (variables, arrays, function names, labels) this function acts as
  ' a probe. It scans forward, cleanly skipping over array indices (1, 2) and UDT fields .X,
  ' looking for an = sign. If it finds one, the line goes to parseAssign. If it doesn't,
  ' it returns IMPLICIT_NOT_ASSIGN to tell parseStatement to try evaluating it as a subroutine call instead.

  DIM tempSuccess AS LONG
  DIM checkIdx AS LONG
  DIM pDepth AS LONG
  DIM tVal AS LONG
  DIM assignRes AS LONG

  tempSuccess = IMPLICIT_NOT_ASSIGN
  checkIdx = startIdx + 1

  ' Fast-fail lookahead: Skip over any array parentheses
  IF checkIdx < lineTokenCount THEN
    IF lineTokenVals(checkIdx) = 256 + ASC("(") THEN
      ff = findMatchingParen(checkIdx, lineTokenCount - 1)
      IF ff = 1 THEN
        checkIdx = returnedData2 + 1
      END IF
    END IF
  END IF

  ' Fast-fail lookahead: Skip over any number of UDT fields
  DO WHILE checkIdx < lineTokenCount
    IF lineTokenVals(checkIdx) = 256 + ASC(".") THEN
      checkIdx = checkIdx + 2 ' Skip the dot and the field name
    ELSE
      EXIT DO
    END IF
  LOOP

  ' Check if the resulting token is an equals sign
  IF checkIdx < lineTokenCount THEN
    IF lineTokenVals(checkIdx) = 256 + ASC("=") THEN
      ' We found an equals sign, and thus this is definitively an assignment
      assignRes = parseAssign(startIdx)

      IF assignRes = 0 OR compileError = 1 THEN
        tempSuccess = IMPLICIT_FAIL
        IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
      ELSE
        tempSuccess = IMPLICIT_SUCCESS
      END IF
      parseAssignRouter = tempSuccess
      EXIT FUNCTION
    END IF
  END IF

  ' No equals sign found. Return IMPLICIT_NOT_ASSIGN so the parser can try treating it as a SUB call.
  parseAssignRouter = tempSuccess

END FUNCTION ' parseAssignRouter

''''''''''''''''''''''''
FUNCTION parseIntrinsic$ (startIdx, endIdx, allowImplicit)

  DIM tVal AS LONG
  tVal = lineTokenVals(startIdx)

  SELECT CASE tVal

    CASE TOK_ABS
      parseIntrinsic$ = parse_ABS$(startIdx, endIdx, allowImplicit)

    CASE TOK_SGN
      parseIntrinsic$ = parse_SGN$(startIdx, endIdx, allowImplicit)

    CASE TOK_HEX
      parseIntrinsic$ = parse_HEX$(startIdx, endIdx, allowImplicit)

    CASE TOK_SPACE
      parseIntrinsic$ = parse_SPACE$(startIdx, endIdx, allowImplicit)

    CASE TOK_CHR
      parseIntrinsic$ = parse_CHR$(startIdx, endIdx, ALIM) ' Extra tolerance for allowing implicit with CHR

    CASE TOK_LEN
      parseIntrinsic$ = parse_LEN$(startIdx, endIdx, allowImplicit)

    CASE TOK_ASC
      parseIntrinsic$ = parse_ASC$(startIdx, endIdx, allowImplicit)

    CASE TOK_LTRIM
      parseIntrinsic$ = parse_LTRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_RTRIM
      parseIntrinsic$ = parse_RTRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_UCASE
      parseIntrinsic$ = parse_UCASE$(startIdx, endIdx, allowImplicit)

    CASE TOK_LCASE
      parseIntrinsic$ = parse_LCASE$(startIdx, endIdx, allowImplicit)

    CASE TOK_LEFT
      parseIntrinsic$ = parse_LEFT$(startIdx, endIdx, allowImplicit)

    CASE TOK_RIGHT
      parseIntrinsic$ = parse_RIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_STR
      parseIntrinsic$ = parse_STR$(startIdx, endIdx, allowImplicit)

    CASE TOK_VAL
      parseIntrinsic$ = parse_VAL$(startIdx, endIdx, allowImplicit)

    CASE TOK_MID
      parseIntrinsic$ = parse_MID$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKD
      parseIntrinsic$ = parse_MKD$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKL
      parseIntrinsic$ = parse_MKL$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKS
      parseIntrinsic$ = parse_MKS$(startIdx, endIdx, allowImplicit)

    CASE TOK_MKI
      parseIntrinsic$ = parse_MKI$(startIdx, endIdx, allowImplicit)

    CASE TOK_INT
      parseIntrinsic$ = parse_INT$(startIdx, endIdx, allowImplicit)

    CASE TOK_FIX
      parseIntrinsic$ = parse_FIX$(startIdx, endIdx, allowImplicit)

    CASE TOK_ATN
      parseIntrinsic$ = parse_ATN$(startIdx, endIdx, allowImplicit)

    CASE TOK_KEYDOWN
      parseIntrinsic$ = parse_KEYDOWN$(startIdx, endIdx, allowImplicit)

    CASE TOK_INKEY
      parseIntrinsic$ = parse_INKEY$(startIdx, endIdx, allowImplicit)

    CASE TOK_INPUT_STR
      parseIntrinsic$ = parse_INPUT_STR$(startIdx, endIdx, allowImplicit)

    CASE TOK_INSTR
      parseIntrinsic$ = parse_INSTR$(startIdx, endIdx, allowImplicit)

    CASE TOK_LBOUND
      parseIntrinsic$ = parse_LBOUND$(startIdx, endIdx, allowImplicit)

    CASE TOK_UBOUND
      parseIntrinsic$ = parse_UBOUND$(startIdx, endIdx, allowImplicit)

    CASE TOK_LOF
      parseIntrinsic$ = parse_LOF$(startIdx, endIdx, allowImplicit)

    CASE TOK_POINT
      parseIntrinsic$ = parse_POINT$(startIdx, endIdx, allowImplicit)

    CASE TOK_RGB32
      parseIntrinsic$ = parse_RGB32$(startIdx, endIdx, allowImplicit)

    CASE TOK_PEEK
      parseIntrinsic$ = parse_PEEK$(startIdx, endIdx, allowImplicit)

    CASE TOK_RND
      parseIntrinsic$ = parse_RND$(startIdx, endIdx, allowImplicit)

    CASE TOK_SIN
      parseIntrinsic$ = parse_SIN$(startIdx, endIdx, allowImplicit)

    CASE TOK_COS
      parseIntrinsic$ = parse_COS$(startIdx, endIdx, allowImplicit)

    CASE TOK_TIMER
      parseIntrinsic$ = parse_TIMER$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEINPUT
      parseIntrinsic$ = parse_MOUSEINPUT$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEX
      parseIntrinsic$ = parse_MOUSEX$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEY
      parseIntrinsic$ = parse_MOUSEY$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEBUTTON
      parseIntrinsic$ = parse_MOUSEBUTTON$(startIdx, endIdx, allowImplicit)

    CASE TOK_MOUSEWHEEL
      parseIntrinsic$ = parse_MOUSEWHEEL$(startIdx, endIdx, allowImplicit)

    CASE TOK_RGB
      parseIntrinsic$ = parse_RGB$(startIdx, endIdx, allowImplicit)

    CASE TOK_MEM
      parseIntrinsic$ = parse_MEM$(startIdx, endIdx, allowImplicit)

    CASE TOK_PALETTECOLOR
      parseIntrinsic$ = parse_PALETTECOLOR_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_RED32
      parseIntrinsic$ = parse_RED32$(startIdx, endIdx, allowImplicit)

    CASE TOK_GREEN32
      parseIntrinsic$ = parse_GREEN32$(startIdx, endIdx, allowImplicit)

    CASE TOK_BLUE32
      parseIntrinsic$ = parse_BLUE32$(startIdx, endIdx, allowImplicit)

    CASE TOK_STRINGFUNC
      parseIntrinsic$ = parse_STRINGFUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_FILEEXISTS
      parseIntrinsic$ = parse_FILEEXISTS$(startIdx, endIdx, allowImplicit)

    CASE TOK_FREEFILE
      parseIntrinsic$ = parse_FREEFILE$(startIdx, endIdx, allowImplicit)

    CASE TOK_EOF
      parseIntrinsic$ = parse_EOF$(startIdx, endIdx, allowImplicit)

    CASE TOK_KEYHIT
      parseIntrinsic$ = parse_KEYHIT$(startIdx, endIdx, allowImplicit)

    CASE TOK_CLIPBOARD
      parseIntrinsic$ = parse_CLIPBOARD_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICE
      parseIntrinsic$ = parse_DEVICE$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICES
      parseIntrinsic$ = parse_DEVICES$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEVICEINPUT
      parseIntrinsic$ = parse_DEVICEINPUT$(startIdx, endIdx, allowImplicit)

    CASE TOK_AXIS
      parseIntrinsic$ = parse_AXIS$(startIdx, endIdx, allowImplicit)

    CASE TOK_WHEEL
      parseIntrinsic$ = parse_WHEEL$(startIdx, endIdx, allowImplicit)

    CASE TOK_BUTTON
      parseIntrinsic$ = parse_BUTTON$(startIdx, endIdx, allowImplicit)

    CASE TOK_SNDOPEN
      ' Ignore _SNDOPEN by consuming its syntax and returning a dummy nonzero literal
      IF checkIntrinsicSyntax(startIdx, endIdx, "_SNDOPEN", 3) = 0 THEN
        parseIntrinsic$ = ""
        EXIT FUNCTION
      END IF
      exprIs.DataType = TYPE_LONG
      exprIs.IsTemp = 0
      parseIntrinsic$ = "1"

    CASE TOK_CVD
      parseIntrinsic$ = parse_CVD$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVI
      parseIntrinsic$ = parse_CVI$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVL
      parseIntrinsic$ = parse_CVL$(startIdx, endIdx, allowImplicit)

    CASE TOK_CVS
      parseIntrinsic$ = parse_CVS$(startIdx, endIdx, allowImplicit)

    CASE TOK_NEWIMAGE
      parseIntrinsic$ = parse_NEWIMAGE$(startIdx, endIdx, allowImplicit)

    CASE TOK_SCREENEXISTS
      parseIntrinsic$ = parse_SCREENEXISTS$(startIdx, endIdx, allowImplicit)

    CASE TOK_WINDOWHANDLE
      parseIntrinsic$ = parse_WINDOWHANDLE$(startIdx, endIdx, allowImplicit)

    CASE TOK_OFFSET
      parseIntrinsic$ = parse_OFFSET$(startIdx, endIdx, allowImplicit)

    CASE TOK_DESKTOPWIDTH
      parseIntrinsic$ = parse_DESKTOPWIDTH$(startIdx, endIdx, allowImplicit)

    CASE TOK_DESKTOPHEIGHT
      parseIntrinsic$ = parse_DESKTOPHEIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_HEIGHT_FUNC
      parseIntrinsic$ = parse_HEIGHT$(startIdx, endIdx, allowImplicit)

    CASE TOK_WIDTH_FUNC
      parseIntrinsic$ = parse_WIDTH$(startIdx, endIdx, allowImplicit)

    CASE TOK_TRIM
      parseIntrinsic$ = parse_TRIM$(startIdx, endIdx, allowImplicit)

    CASE TOK_DEST
      parseIntrinsic$ = parse_DEST_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_SOURCE
      parseIntrinsic$ = parse_SOURCE_FUNC$(startIdx, endIdx, allowImplicit)

    CASE TOK_COPYIMAGE
      parseIntrinsic$ = parse_COPYIMAGE$(startIdx, endIdx, allowImplicit)

    CASE TOK_INP
      parseIntrinsic$ = parse_INP$(startIdx, endIdx, allowImplicit)

    CASE 717 ' TOK_VARPTR
      parseIntrinsic$ = parse_VARPTR$(startIdx, endIdx, allowImplicit)

    CASE 718 ' TOK_VARSEG
      parseIntrinsic$ = parse_VARSEG$(startIdx, endIdx, allowImplicit)

    CASE ELSE
      throwCompilerError "UNIMPLEMENTED HOISTED INTRINSIC", ASIS, 0
      parseIntrinsic$ = ""

  END SELECT ' tVal

END FUNCTION ' parseIntrinsic$

''''''''''''''''''''''''
FUNCTION parseStatement (startIdx)

  DIM tempSuccess AS LONG
  DIM tVal AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM isDefFnSpace AS LONG
  DIM nameIdx AS LONG
  DIM subIdx AS LONG
  DIM hasEq AS LONG
  DIM eqIdx AS LONG
  DIM retVarIdx AS LONG
  DIM targetType AS LONG
  DIM assignRes AS LONG
  DIM vIdx AS LONG
  DIM isUnrecognized AS LONG
  DIM matchPosErr AS LONG
  DIM chunkStartErr AS LONG
  DIM chunkEndErr AS LONG
  DIM chPrevErr AS STRING * 1
  DIM chNextErr AS STRING * 1
  DIM inQuotesErr AS LONG
  DIM iScan AS LONG
  DIM chScan AS STRING * 1
  DIM isLineInput AS LONG
  DIM ifID_end AS LONG
  DIM ifID_false AS LONG
  DIM savedStackOffset AS LONG
  DIM parseFunctionResult AS LONG
  DIM wasStandardCommandParsed AS LONG
  DIM commandNameStr$

  tempSuccess = 1

  expectedSymType = TYPE_ANY

  firstTok$ = lineTokens$(startIdx)
  tVal = lineTokenVals(startIdx)
  isUnrecognized = 0

  ' Inserts an ON KEY polling checkpoint before a BASIC statement executes
  IF isCompilingRT <> 1 THEN
    IF rtIsUsed(RT_KEY_EVENT) <> 0 THEN
      tira_Start
      tiraCall "RT_KEY_EVENT", 0, ""
      tira_EndAndProcess
    END IF
  END IF

  IF compileError = 1 THEN
    parseStatement = 0
    EXIT FUNCTION
  END IF

  ' Handle loop structures that need their labels emitted BEFORE intrinsic hoisting
  IF tVal = TOK_DO THEN
    IF parse_DO(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "DO", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_WHILE THEN
    IF parse_WHILE(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "WHILE", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_CASE THEN
    IF parse_CASE(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "CASE", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  IF tVal = TOK_ELSEIF THEN
    IF parse_ELSEIF(startIdx) = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN throwCompilerError "ELSEIF", WITHFAILED, 0
    END IF
    parseStatement = tempSuccess
    EXIT FUNCTION
  END IF

  ' DEF establishes its routine frame and scope before hoisting its right-hand expression
  IF tVal <> TOK_DEF THEN
    hoistIntrinsics
  END IF
  IF compileError = 1 THEN
    parseStatement = 0
    EXIT FUNCTION
  END IF

  ' Restore the expected symbol type to a clean slate, as intrinsic evaluations
  ' may have leaked their implicit typing lookahead values into the global scope
  expectedSymType = TYPE_ANY

  ' Re-read first token in case it was an intrinsic that got hoisted!
  firstTok$ = lineTokens$(startIdx)
  tVal = lineTokenVals(startIdx)

  parseFunctionResult = 0
  wasStandardCommandParsed = 0

  IF tVal >= 512 AND tVal <= 1024 THEN
    wasStandardCommandParsed = voc(tVal).IsStandardCmd
  END IF

  SELECT CASE tVal

    CASE TOK_WIDTH, TOK_SNDOPEN, TOK_SNDPLAY, TOK_INCLUDE, TOK_SOUND:

      ' Ignored statements

    CASE TOK_STRINGSTRICT, TOK_EMERALD, TOK_CLASSIC, TOK_GLDEFINT, TOK_NOREF, TOK_GRAPHICS:
      ' Global preprocessor directives are completely handled by Pass Zero.
      ' We gracefully skip over them during the sequential emission pass.

    CASE TOK_STATIC_META:
      defaultArrayDynamic = 0

    CASE TOK_DYNAMIC_META:
      defaultArrayDynamic = 1

    CASE TOK_ASC:
      IF parse_ASC_Assign(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "ASC ASSIGN", WITHFAILED, 0
      END IF

    CASE TOK_MID:
      IF parse_MID_Assign(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "MID$ ASSIGN", WITHFAILED, 0
      END IF

    CASE TOK_DEFINT: parseFunctionResult = parse_DEFINT(startIdx)

    CASE TOK_BEEP: parseFunctionResult = parse_BEEP(startIdx)

    CASE TOK_CALL:
      subName$ = UCASE$(lineTokens$(startIdx + 1))
      ff = findSymbol(subName$)
      IF ff = 1 THEN
        vIdx = returnedData2
      ELSE
        vIdx = -1
      END IF
      IF parseSubCall(startIdx, 1, vIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "CALL", WITHFAILED, 0
      END IF

    CASE TOK_CASE: parseFunctionResult = parse_CASE(startIdx)

    CASE TOK_CIRCLE: parseFunctionResult = parse_CIRCLE(startIdx)

    CASE TOK_CLEAR: parseFunctionResult = parse_CLEAR(startIdx)

    CASE TOK_CLIPBOARD: parseFunctionResult = parse_CLIPBOARD_Assign(startIdx)

    CASE TOK_CLOSE: parseFunctionResult = parse_CLOSE(startIdx)

    CASE TOK_CLS: parseFunctionResult = parse_CLS(startIdx)

    CASE TOK_COLOR: parseFunctionResult = parse_COLOR(startIdx)

    CASE TOK_COMMON: parseFunctionResult = parse_COMMON(startIdx)

    CASE TOK_DEF:
      endIdx = lineTokenCount - 1

      IF endIdx >= startIdx + 1 THEN
        IF UCASE$(lineTokens$(startIdx + 1)) = "SEG" THEN

        ELSE
          IF endIdx < startIdx + 2 THEN
            throwCompilerError "MALFORMED DEF", ASIS, 0
            tempSuccess = 0
          ELSE
            defNameTok$ = lineTokens$(startIdx + 1)
            isDefFnSpace = 0
            IF UCASE$(defNameTok$) = "FN" THEN isDefFnSpace = 1

            IF isDefFnSpace = 0 AND LEFT$(defNameTok$, 2) <> "Fn" THEN
              throwCompilerError "DEF MUST BE FOLLOWED BY FN OR Fn*()", ASIS, 0
              tempSuccess = 0
            ELSE
              nameIdx = startIdx + 1
              subName$ = UCASE$(defNameTok$)

              IF isDefFnSpace = 1 THEN
                IF endIdx >= startIdx + 2 THEN
                  nameIdx = startIdx + 2
                  subName$ = "FN" + UCASE$(lineTokens$(startIdx + 2))
                ELSE
                  throwCompilerError "MALFORMED DEF", ASIS, 0
                  tempSuccess = 0
                END IF
              END IF

              IF tempSuccess = 1 THEN
                ff = findSubIndex(subName$)
                IF ff = 0 THEN
                  throwCompilerError "DEF NOT FOUND", ASIS, 0
                  tempSuccess = 0
                ELSE
                  subIdx = returnedData2

                  hasEq = 0
                  eqIdx = 0
                  ff = findNextTokenAtDepth0(nameIdx + 1, endIdx, 256 + ASC("="))
                  IF ff = 1 THEN
                    hasEq = 1
                    eqIdx = returnedData2
                  END IF

                  IF hasEq = 0 THEN
                    throwCompilerError "DEF MISSING =", ASIS, 0
                    tempSuccess = 0
                  ELSE
                    savedStackOffset = stack.currentStackOffset
                    currentScopeID = subs(subIdx).ScopeID
                    insideSub = 2
                    currentSubName$ = subName$

                    tira_Start
                    tiraJmp "@SKIP_ROUTINE_" + subName$
                    tiraSetSubOffset subIdx
                    tiraScheduleSubPrologue
                    tira_EndAndProcess

                    IF compileError = 1 THEN
                      tempSuccess = 0
                    ELSE
                      hoistIntrinsics

                      IF compileError = 1 THEN
                        tempSuccess = 0
                      ELSE
                        expectedSymType = TYPE_ANY
                        endIdx = lineTokenCount - 1

                        tira_Start

                        exprVar$ = tiraParseExpression$(eqIdx + 1, endIdx, 0)
                        IF exprVar$ = "" THEN
                          tira_Cancel
                          tempSuccess = 0
                        ELSE
                          retVarIdx = subs(subIdx).ReturnVarIdx
                          targetType = symbols(retVarIdx).DataType

                          IF targetType = TYPE_STRING THEN
                            throwCompilerErrorAndCancelTira "DEF FN CANNOT RETURN STRING", ASIS, 0
                            tempSuccess = 0
                          ELSE
                            targetVarName$ = "#" + LTRIM$(STR$(retVarIdx))
                            tiraAssign targetVarName$, exprVar$

                            tiraScheduleGC
                            tiraScheduleSubEpilogue
                            tiraLabel "@SKIP_ROUTINE_" + subName$
                            tira_EndAndProcess
                          END IF
                        END IF
                      END IF
                    END IF

                    currentScopeID = 0
                    insideSub = 0
                    currentSubName$ = ""

                    stack.currentStackOffset = savedStackOffset
                    ff = updateStackAlignment
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      ELSE
        throwCompilerError "MALFORMED DEF", ASIS, 0
        tempSuccess = 0
      END IF

    CASE TOK_DELAY: parseFunctionResult = parse_DELAY(startIdx)

    CASE TOK_DEST: parseFunctionResult = parse_DEST(startIdx)

    CASE TOK_DIM: parseFunctionResult = parse_DIM(startIdx)

    CASE TOK_DISPLAY: parseFunctionResult = parse_DISPLAY(startIdx)

    CASE TOK_DISPLAYI: parseFunctionResult = parse_DISPLAYI(startIdx)

    CASE TOK_DRAW:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "DRAW REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_DRAW(startIdx)

    CASE TOK_DO:
      ' Handled above to prevent structural breakage

    CASE TOK_ELSE:
      endIdx = lineTokenCount - 1

      IF ctrlCount = 0 THEN
        throwCompilerError "ELSE WITHOUT IF", ASIS, 0
        EXIT FUNCTION
      END IF
      IF ctrls(ctrlCount - 1).TYPE <> CTRL_IF THEN
        throwCompilerError "ELSE WITHOUT IF", ASIS, 0
        EXIT FUNCTION
      END IF

      ifID_end = ctrls(ctrlCount - 1).Patch1
      ifID_false = ctrls(ctrlCount - 1).Patch2

      falseLbl$ = "@IF_FALSE_" + LTRIM$(RTRIM$(STR$(ifID_false)))
      endLbl$ = "@IF_END_" + LTRIM$(RTRIM$(STR$(ifID_end)))

      tira_Start
      tiraScheduleHeapReset
      tiraJmp endLbl$
      tiraLabel falseLbl$
      tiraScheduleHeapReset
      tira_EndAndProcess

      ctrls(ctrlCount - 1).TYPE = CTRL_ELSE

    CASE TOK_END: parseFunctionResult = parse_END(startIdx)

    CASE TOK_EXIT: parseFunctionResult = parse_EXIT(startIdx)

    CASE TOK_FONT:
      IF parse_FONT(startIdx) = 0 OR compileError = 1 THEN
        tempSuccess = 0
        IF compileStatusMsg$ = "" THEN throwCompilerError "_FONT", WITHFAILED, 0
      END IF

    CASE TOK_FOR: parseFunctionResult = parse_FOR(startIdx)

    CASE TOK_FREEIMAGE: parseFunctionResult = parse_FREEIMAGE(startIdx)

    CASE TOK_FULLSCREEN: parseFunctionResult = parse_FULLSCREEN(startIdx)

    CASE TOK_FUNCTION:
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "MALFORMED FUNCTION", ASIS, 0
        tempSuccess = 0
      ELSE
        subName$ = UCASE$(lineTokens$(startIdx + 1))
        ff = findSubIndex(subName$)
        IF ff = 0 THEN
          throwCompilerError "FUNCTION NOT FOUND", ASIS, 0
          tempSuccess = 0
        ELSE
          subIdx = returnedData2
          currentScopeID = subs(subIdx).ScopeID
          insideSub = 2
          currentSubName$ = subName$

          tira_Start
          tiraJmp "@SKIP_ROUTINE_" + subName$
          tiraSetSubOffset subIdx
          tiraScheduleSubPrologue
          tira_EndAndProcess
        END IF
      END IF

    CASE TOK_GDOUBLE: parseFunctionResult = parse_GDOUBLE(startIdx)

    CASE TOK_GET: parseFunctionResult = parse_GET(startIdx)

    CASE TOK_GLOBAL: parseFunctionResult = parse_GLOBAL(startIdx)

    CASE TOK_GOSUB: parseFunctionResult = parse_GOSUB(startIdx)

    CASE TOK_GOTO: parseFunctionResult = parse_GOTO(startIdx)

    CASE TOK_IF: parseFunctionResult = parse_IF(startIdx)

    CASE TOK_INPUT: parseFunctionResult = parse_INPUT(startIdx)

    CASE TOK_KEY: parseFunctionResult = parse_KEY(startIdx)

    CASE TOK_KEYCLEAR: parseFunctionResult = parse_KEYCLEAR(startIdx)

    CASE TOK_KILL: parseFunctionResult = parse_KILL(startIdx)

    CASE TOK_LET:
      IF lineTokenVals(startIdx + 1) = TOK_ASC THEN
        IF parse_ASC_Assign(startIdx + 1) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "ASC ASSIGN", WITHFAILED, 0
        END IF
      ELSE
        IF lineTokenVals(startIdx + 1) = TOK_MID THEN
          IF parse_MID_Assign(startIdx + 1) = 0 OR compileError = 1 THEN
            tempSuccess = 0
            IF compileStatusMsg$ = "" THEN throwCompilerError "MID$ ASSIGN", WITHFAILED, 0
          END IF
        ELSE
          IF parseAssign(startIdx + 1) = 0 OR compileError = 1 THEN
            tempSuccess = 0
            IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
          END IF
        END IF
      END IF

    CASE TOK_LIMIT: parseFunctionResult = parse_LIMIT(startIdx)

    CASE TOK_MEMFILL: parseFunctionResult = parse_MEMFILL(startIdx)

    CASE TOK_MEMFREE: parseFunctionResult = parse_MEMFREE(startIdx)

    CASE TOK_LINE:
      isLineInput = 0
      IF startIdx + 1 <= lineTokenCount - 1 THEN
        IF lineTokenVals(startIdx + 1) = TOK_INPUT THEN
          isLineInput = 1
        END IF
      END IF

      IF isLineInput = 1 THEN
        IF parse_LINE_INPUT(startIdx) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "LINE INPUT", WITHFAILED, 0
        END IF
      ELSE
        IF cm.HasGraphics = 0 THEN
          throwCompilerError "LINE REQUIRES #GRAPHICS", ASIS, 0
          EXIT FUNCTION
        END IF
        IF parse_LINE(startIdx) = 0 OR compileError = 1 THEN
          tempSuccess = 0
          IF compileStatusMsg$ = "" THEN throwCompilerError "LINE", WITHFAILED, 0
        END IF
      END IF

    CASE TOK_LOCATE: parseFunctionResult = parse_LOCATE(startIdx)

    CASE TOK_THROWERR: parseFunctionResult = parse_THROWERR(startIdx)

    CASE TOK_LOOP: parseFunctionResult = parse_LOOP(startIdx)

    CASE TOK_NEXT: parseFunctionResult = parse_NEXT(startIdx)

    CASE TOK_ON: parseFunctionResult = parse_ON(startIdx)

    CASE TOK_OPEN: parseFunctionResult = parse_OPEN(startIdx)

    CASE TOK_OUT:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "OUT REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_OUT(startIdx)

    CASE TOK_PAINT:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PAINT REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PAINT(startIdx)

    CASE TOK_PALETTE: parseFunctionResult = parse_PALETTE(startIdx)

    CASE TOK_PALETTECOLOR: parseFunctionResult = parse_PALETTECOLOR(startIdx)

    CASE TOK_PCOPY:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PCOPY REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PCOPY(startIdx)

    CASE TOK_PLAY: parseFunctionResult = parse_PLAY(startIdx)

    CASE TOK_POKE: parseFunctionResult = parse_POKE_Compat(startIdx)

    CASE TOK_PRESET:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PRESET REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PRESET(startIdx)

    CASE TOK_PRINT: parseFunctionResult = parse_PRINT(startIdx)

    CASE TOK_PRINTSTRING: parseFunctionResult = parse_PRINTSTRING(startIdx)

    CASE TOK_PSET:
      IF cm.HasGraphics = 0 THEN
        throwCompilerError "PSET REQUIRES #GRAPHICS", ASIS, 0
        EXIT FUNCTION
      END IF
      parseFunctionResult = parse_PSET(startIdx)

    CASE TOK_PUT: parseFunctionResult = parse_PUT(startIdx)

    CASE TOK_PUTIMAGE: parseFunctionResult = parse_PUTIMAGE(startIdx)

    CASE TOK_RANDOMIZE: parseFunctionResult = parse_RANDOMIZE(startIdx)

    CASE TOK_READ: parseFunctionResult = parse_READ(startIdx)

    CASE TOK_REDIM: parseFunctionResult = parse_REDIM(startIdx)

    CASE TOK_RESTORE: parseFunctionResult = parse_RESTORE(startIdx)

    CASE TOK_RESUME: parseFunctionResult = parse_RESUME(startIdx)

    CASE TOK_RETURN: parseFunctionResult = parse_RETURN(startIdx)

    CASE TOK_RUN: parseFunctionResult = parse_RUN(startIdx)

    CASE TOK_SCREEN: parseFunctionResult = parse_SCREEN(startIdx)

    CASE TOK_SLEEP: parseFunctionResult = parse_SLEEP(startIdx)

    CASE TOK_SOURCE: parseFunctionResult = parse_SOURCE(startIdx)

    CASE TOK_SCREENICON: parseFunctionResult = parse_SCREENICON(startIdx)

    CASE TOK_SELECT: parseFunctionResult = parse_SELECT(startIdx)

    CASE TOK_SHELL: parseFunctionResult = parse_SHELL(startIdx)

    CASE TOK_STATIC_VAR: parseFunctionResult = parse_STATIC(startIdx)

    CASE TOK_STOP: parseFunctionResult = parse_STOP(startIdx)

    CASE TOK_SWAP: parseFunctionResult = parse_SWAP(startIdx)

    CASE TOK_SYSTEM: parseFunctionResult = parse_SYSTEM(startIdx)

    CASE TOK_STRING:
      endIdx = lineTokenCount - 1

      IF endIdx < startIdx + 1 THEN
        throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
        tempSuccess = 0
      ELSE
        vTok$ = lineTokens$(startIdx + 1)
        IF lineTokenVals(startIdx + 1) <> 0 THEN
          throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
          tempSuccess = 0
        ELSE
          vName$ = UCASE$(vTok$)

          ff = resolveSymbol(vName$)
          IF ff = 0 THEN
            tempSuccess = 0
          ELSE
            vIdx = returnedData2

            IF isCompilingRT = 0 AND cm.ClassicMode = 0 AND pass5.Mode = PASS5_MODE_DISCOVERY THEN
              IF symbols(vIdx).SubIndex = 0 THEN
                IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
                  throwCompilerError "NAME CLASH: ARRAY " + vName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + vName$, ASIS, 0
                  EXIT FUNCTION
                END IF
              END IF
            END IF

            IF endIdx >= startIdx + 2 THEN
              IF lineTokenVals(startIdx + 2) = 256 + ASC("=") THEN
                IF parseAssign(startIdx + 1) = 0 OR compileError = 1 THEN
                  tempSuccess = 0
                  IF compileStatusMsg$ = "" THEN throwCompilerError "ASSIGN", WITHFAILED, 0
                END IF
              ELSE
                throwCompilerError "EXPECTED =", ASIS, 0
                tempSuccess = 0
              END IF
            END IF
          END IF
        END IF
      END IF

    CASE TOK_SUB:
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "MALFORMED SUB", ASIS, 0
        tempSuccess = 0
      ELSE
        subName$ = UCASE$(lineTokens$(startIdx + 1))
        ff = findSubIndex(subName$)
        IF ff = 0 THEN
          throwCompilerError "SUB NOT FOUND", ASIS, 0
          tempSuccess = 0
        ELSE
          subIdx = returnedData2
          currentScopeID = subs(subIdx).ScopeID
          insideSub = 1
          currentSubName$ = subName$

          tira_Start
          tiraJmp "@SKIP_ROUTINE_" + subName$
          tiraSetSubOffset subIdx
          tiraScheduleSubPrologue
          tira_EndAndProcess
        END IF
      END IF

    CASE TOK_VIEW: parseFunctionResult = parse_VIEW(startIdx)

    CASE TOK_WAIT: parseFunctionResult = parse_WAIT(startIdx)

    CASE TOK_WEND: parseFunctionResult = parse_WEND(startIdx)

    CASE TOK_BLOAD: parseFunctionResult = parse_BLOAD(startIdx) ' TOK_BLOAD

    CASE TOK_BSAVE: parseFunctionResult = parse_BSAVE(startIdx) ' TOK_BSAVE

    CASE TOK_OP_EQUAL:
      tempSuccess = 0
      throwCompilerError "EXPECTED VARIABLE BEFORE =", ASIS, 0

    CASE TOK_OP_PLUS, TOK_OP_MINUS, TOK_OP_MUL, TOK_OP_DIV, TOK_OP_IDIV, TOK_OP_POW, TOK_OP_LESS, TOK_OP_GREATER, TOK_OP_LESS_EQUAL, TOK_OP_NOT_EQUAL:
      tempSuccess = 0
      throwCompilerError "EXPECTED STATEMENT, GOT OPERATOR", ASIS, 0

    CASE 0:
      IF LEN(firstTok$) > 0 THEN
        firstChar$ = LEFT$(firstTok$, 1)
        IF (firstChar$ >= "A" AND firstChar$ <= "Z") OR (firstChar$ >= "a" AND firstChar$ <= "z") OR firstChar$ = "!" OR firstChar$ = "_" THEN

          assignRes = parseAssignRouter(startIdx)
          IF assignRes <> IMPLICIT_NOT_ASSIGN THEN
            IF assignRes = IMPLICIT_FAIL THEN
              tempSuccess = 0
            END IF
          ELSE
            subName$ = UCASE$(firstTok$)
            ff = findSymbol(subName$)

            IF ff = 1 THEN
              vIdx = returnedData2
              IF symbols(vIdx).SubIndex <> 0 THEN
                IF parseSubCall(startIdx, 0, vIdx) = 0 OR compileError = 1 THEN
                  tempSuccess = 0
                  IF compileStatusMsg$ = "" THEN throwCompilerError "CALL", WITHFAILED, 0
                END IF
              ELSE
                tempSuccess = 0
                isUnrecognized = 1
              END IF
            ELSE
              tempSuccess = 0
              isUnrecognized = 1
            END IF
          END IF
        ELSE
          tempSuccess = 0
          IF firstChar$ = CHR$(34) THEN
            throwCompilerError "EXPECTED STATEMENT, GOT STRING LITERAL", ASIS, 0
          ELSE
            IF (firstChar$ >= "0" AND firstChar$ <= "9") OR firstChar$ = "." OR firstChar$ = "-" THEN
              throwCompilerError "EXPECTED STATEMENT, GOT NUMERIC LITERAL", ASIS, 0
            ELSE
              isUnrecognized = 1
            END IF
          END IF
        END IF
      ELSE
        tempSuccess = 0
        throwCompilerError "UNRECOGNIZED KEYWORD", ASIS, 0
      END IF

    CASE ELSE:
      tempSuccess = 0
      isUnrecognized = 1

  END SELECT ' tVal

  IF wasStandardCommandParsed = 1 THEN
    IF parseFunctionResult = 0 OR compileError = 1 THEN
      tempSuccess = 0
      IF compileStatusMsg$ = "" THEN
        commandNameStr$ = UCASE$(RTRIM$(retTokenText$(firstTok$)))
        throwCompilerError commandNameStr$, WITHFAILED, 0
      END IF
    END IF
  END IF

  IF isUnrecognized = 1 THEN
    errTokStr$ = retTokenText$(firstTok$)

    IF errTokStr$ <> "" THEN
      rawLineErr$ = editorText$(currentLineNumber)
      matchPosErr = 0
      inQuotesErr = 0
      FOR iScan = 1 TO LEN(rawLineErr$)
        chScan = MID$(rawLineErr$, iScan, 1)
        IF chScan = CHR$(34) THEN inQuotesErr = 1 - inQuotesErr
        IF inQuotesErr = 0 THEN
          IF MID$(rawLineErr$, iScan, LEN(errTokStr$)) = errTokStr$ THEN
            matchPosErr = iScan
            EXIT FOR
          END IF
        END IF
      NEXT

      IF matchPosErr > 0 THEN
        chunkStartErr = matchPosErr
        DO WHILE chunkStartErr > 1
          chPrevErr = MID$(rawLineErr$, chunkStartErr - 1, 1)
          IF chPrevErr = " " OR chPrevErr = CHR$(9) OR chPrevErr = ":" THEN EXIT DO
          chunkStartErr = chunkStartErr - 1
        LOOP
        chunkEndErr = matchPosErr
        DO WHILE chunkEndErr <= LEN(rawLineErr$)
          chNextErr = MID$(rawLineErr$, chunkEndErr, 1)
          IF chNextErr = " " OR chNextErr = CHR$(9) OR chNextErr = ":" THEN EXIT DO
          chunkEndErr = chunkEndErr + 1
        LOOP
        errTokStr$ = MID$(rawLineErr$, chunkStartErr, chunkEndErr - chunkStartErr)
      END IF
    END IF

    throwCompilerError "UNRECOGNIZED KEYWORD: '[" + errTokStr$ + "] RLE=" + rawLineErr$, ASIS, 0
  END IF

  IF tempSuccess = 0 OR compileError = 1 THEN
    EXIT FUNCTION
  END IF

  parseStatement = 1 ' Success

  ' Return 2 for routine boundaries that legitimately span a stack-offset change
  IF tVal = TOK_SUB OR tVal = TOK_FUNCTION THEN parseStatement = 2

  IF tVal = TOK_END THEN
    IF startIdx + 1 < lineTokenCount THEN
      IF lineTokenVals(startIdx + 1) = TOK_SUB OR lineTokenVals(startIdx + 1) = TOK_FUNCTION THEN parseStatement = 2
    END IF
  END IF

END FUNCTION ' parseStatement

''''''''''''''''''''''''
FUNCTION parseSubCall (startIdx, isExplicit, passVIdx)

  DIM targetType AS LONG
  DIM lhsUdtIndex AS LONG
  DIM argStartIdx AS LONG
  DIM vIdx AS LONG
  DIM subIdx AS LONG
  DIM endIdx AS LONG
  DIM tokIdx AS LONG
  DIM argIdx AS LONG
  DIM hasParens AS LONG
  DIM exprEndIdx AS LONG
  DIM hasExprEnd AS LONG
  DIM targetVarIdx AS LONG
  DIM formalVarIdx AS LONG
  DIM stageVarIdx AS LONG
  DIM addrStageVarIdx AS LONG
  DIM srcArgIdx AS LONG
  DIM srcArgDt AS LONG
  DIM tgtDescAddr$
  DIM argVIdx(16) AS LONG
  DIM argIsComplex(16) AS LONG
  DIM argDataType(16) AS LONG
  DIM argValue$(16)
  DIM argAddr$(16)
  DIM srcIsComplex AS LONG
  DIM iArg AS LONG
  DIM firstChar$
  DIM destDescPtr$
  DIM stageName$
  DIM addrStageName$

  endIdx = lineTokenCount - 1

  IF isExplicit = 1 THEN
    argStartIdx = startIdx + 2
  ELSE
    argStartIdx = startIdx + 1
  END IF

  IF passVIdx <> -1 THEN
    vIdx = passVIdx
    subName$ = RTRIM$(symbols(vIdx).RecordName)
  ELSE
    IF isExplicit = 1 THEN
      IF lineTokenCount < startIdx + 2 THEN
        throwCompilerError "EXPECTED SUB NAME", ASIS, 0
        EXIT FUNCTION
      END IF
      subName$ = UCASE$(lineTokens$(startIdx + 1))
    ELSE
      subName$ = UCASE$(lineTokens$(startIdx))
    END IF
    ff = resolveSymbol(subName$)
    IF ff = 0 THEN EXIT FUNCTION
    vIdx = returnedData2
  END IF

  subIdx = symbols(vIdx).SubIndex
  IF subIdx = 0 THEN
    throwCompilerError "SUB NOT FOUND", ASIS, 0
    EXIT FUNCTION
  END IF

  tokIdx = argStartIdx
  argIdx = 0

  hasParens = 0
  IF tokIdx <= endIdx THEN
    IF lineTokenVals(tokIdx) = 256 + ASC("(") THEN
      IF findMatchingParen(tokIdx, endIdx) = 1 THEN
        IF returnedData2 = endIdx THEN
          hasParens = 1
          tokIdx = tokIdx + 1
          endIdx = endIdx - 1
        END IF
      END IF
    END IF
  END IF

  tira_Start

  DO WHILE tokIdx <= endIdx
    hasExprEnd = 0
    exprEndIdx = 0
    IF findNextTokenAtDepth0(tokIdx, endIdx, 256 + ASC(",")) = 1 THEN
      hasExprEnd = 1
      exprEndIdx = returnedData2
    END IF
    IF hasExprEnd = 0 THEN
      exprEndIdx = endIdx + 1
    END IF

    IF tokIdx > exprEndIdx - 1 THEN
      throwCompilerErrorAndCancelTira "MISSING ARGUMENT", ASIS, 0
      EXIT FUNCTION
    END IF

    IF argIdx >= subs(subIdx).ArgCount THEN
      throwCompilerErrorAndCancelTira "TOO MANY ARGS FOR " + subName$, ASIS, 0
      EXIT FUNCTION
    END IF

    formalVarIdx = subArgVarIdx(subIdx, argIdx)
    targetType = symbols(formalVarIdx).DataType

    IF targetType = TYPE_UDT AND symbols(formalVarIdx).IsArray <> 2 THEN
      lhsUdtIndex = symbols(formalVarIdx).UDTIndex

      ' Evaluate and validate the right side UDT before the call boundary is staged
      rhsBase$ = tiraParseRhsUdtBase$(tokIdx, exprEndIdx - 1, lhsUdtIndex)
      IF rhsBase$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      argValue$(argIdx) = rhsBase$
      argDataType(argIdx) = TYPE_UDT
      argAddr$(argIdx) = rhsBase$

      ff = resolveSymbol(UCASE$(lineTokens$(tokIdx)))
      IF ff = 1 THEN
        argVIdx(argIdx) = returnedData2
      ELSE
        argVIdx(argIdx) = -1
      END IF

      IF tokIdx = exprEndIdx - 1 THEN
        argIsComplex(argIdx) = 0
      ELSE
        argIsComplex(argIdx) = 1
      END IF
    ELSE
      returnAddrVar = ""

      argVar$ = tiraParseExpression$(tokIdx, exprEndIdx - 1, ALIM)
      IF argVar$ = "" THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      argValue$(argIdx) = argVar$
      argDataType(argIdx) = exprIs.DataType
      argVIdx(argIdx) = shuntVal(0).VIdx
      argIsComplex(argIdx) = shuntVal(0).IsComplex
      argAddr$(argIdx) = returnAddrVar

      IF symbols(formalVarIdx).IsArray = 2 THEN
        srcArgIdx = argVIdx(argIdx)
        IF srcArgIdx = -1 THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
          EXIT FUNCTION
        END IF
        IF symbols(srcArgIdx).IsArray = 0 THEN
          throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
          EXIT FUNCTION
        END IF

        srcArgDt = symbols(srcArgIdx).DataType
        IF targetType <> TYPE_ANY THEN
          IF srcArgDt <> targetType THEN
            throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
            EXIT FUNCTION
          END IF

          IF targetType = TYPE_UDT THEN
            IF symbols(srcArgIdx).UDTIndex <> symbols(formalVarIdx).UDTIndex THEN
              throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
              EXIT FUNCTION
            END IF
          END IF
        END IF

      ELSE
        IF targetType = TYPE_STRING THEN
          IF argDataType(argIdx) <> TYPE_STRING THEN
            throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
            EXIT FUNCTION
          END IF
        ELSE
          IF argDataType(argIdx) = TYPE_STRING THEN
            throwCompilerErrorAndCancelTira "TYPE MISMATCH ARG " + LTRIM$(STR$(argIdx + 1)), ASIS, 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF

    argIdx = argIdx + 1
    tokIdx = exprEndIdx + 1
  LOOP

  IF argIdx < subs(subIdx).ArgCount THEN
    throwCompilerErrorAndCancelTira "TOO FEW ARGS FOR " + subName$, ASIS, 0
    EXIT FUNCTION
  END IF

  IF subs(subIdx).IsDll = 1 THEN
    argListDll$ = ""

    FOR iArg = 0 TO subs(subIdx).ArgCount - 1
      formalVarIdx = subArgVarIdx(subIdx, iArg)
      targetType = symbols(formalVarIdx).DataType
      argVar$ = argValue$(iArg)

      IF symbols(formalVarIdx).IsArray = 2 THEN
        descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
        tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + argVar$ + ", 12"

        descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
        tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
        tiraFatalError "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(iArg + 1))
        tiraLabel descriptorDimLowReady$

        descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
        tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
        tiraFatalError "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(iArg + 1))
        tiraLabel descriptorDimHighReady$

        IF symbols(formalVarIdx).NumDimensions > 0 THEN
          descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
          tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
          tiraFatalError "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(iArg + 1))
          tiraLabel descriptorDimMatchReady$
        END IF

        IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
        argListDll$ = argListDll$ + argVar$
      ELSE
        IF targetType = TYPE_STRING THEN
          dataPtrVar$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraNew TC_READ_MEM, dataPtrVar$ + ", " + argVar$
          IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
          argListDll$ = argListDll$ + dataPtrVar$
        ELSE
          IF argListDll$ <> "" THEN argListDll$ = argListDll$ + ", "
          argListDll$ = argListDll$ + argVar$
        END IF
      END IF
    NEXT

    tiraCall subName$, subs(subIdx).ArgCount, argListDll$
  ELSE
    ' Stage every argument only after all argument expressions have finished evaluating
    FOR iArg = 0 TO subs(subIdx).ArgCount - 1
      formalVarIdx = subArgVarIdx(subIdx, iArg)
      targetType = symbols(formalVarIdx).DataType
      stageVarIdx = retSubArgStageVarIdx(subIdx, iArg)
      IF stageVarIdx = 0 OR compileError = 1 THEN
        tira_Cancel
        EXIT FUNCTION
      END IF

      targetVarIdx = stageVarIdx
      targetVarName$ = "#" + LTRIM$(STR$(targetVarIdx))
      argVar$ = argValue$(iArg)

      IF cm.NoRef = 0 THEN
        IF symbols(formalVarIdx).IsArray = 2 OR (argIsComplex(iArg) <> 0 AND argAddr$(iArg) <> "") THEN
          addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, iArg)
          IF addrStageVarIdx = 0 OR compileError = 1 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))
          IF symbols(formalVarIdx).IsArray = 2 THEN
            tiraAssign addrStageName$, argVar$
          ELSE
            tiraAssign addrStageName$, argAddr$(iArg)
          END IF
        END IF
      END IF

      IF targetType = TYPE_UDT AND symbols(formalVarIdx).IsArray <> 2 THEN
        lhsBase$ = tiraDimVar$("T", TYPE_INTEGER64)
        tiraOp TC_ADDRESS_OF, lhsBase$, targetVarName$, ""
        tiraCopyUdtValue lhsBase$, argVar$, symbols(formalVarIdx).UDTIndex
      ELSE
        IF symbols(formalVarIdx).IsArray = 2 THEN
          srcArgIdx = argVIdx(iArg)

          ' Fetch the global staging descriptor address
          tgtDescAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADDRESS_OF, tgtDescAddr$, targetVarName$, ""

          ' Read the actual runtime dimension count from this argument descriptor
          descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
          tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + argVar$ + ", 12"

          descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
          tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
          tiraFatalError "INVALID ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(iArg + 1))
          tiraLabel descriptorDimLowReady$

          descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
          tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
          tiraFatalError "ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(iArg + 1))
          tiraLabel descriptorDimHighReady$

          IF symbols(formalVarIdx).NumDimensions > 0 THEN
            descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
            tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
            tiraFatalError "ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(iArg + 1))
            tiraLabel descriptorDimMatchReady$
          END IF

          ' Copy the complete source descriptor including every runtime dimension limit
          descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
          tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

          tiraMemcpy tgtDescAddr$, argVar$, descriptorByteSize$
        ELSE
          IF targetType = TYPE_STRING THEN
            tiraCall "RT_STR_ASSIGN", 2, targetVarName$ + ", " + argVar$
          ELSE
            tiraAssign targetVarName$, argVar$
          END IF
        END IF
      END IF
    NEXT

    tiraCall subName$, 0, ""
  END IF

  IF cm.NoRef = 0 AND subs(subIdx).IsDll = 0 THEN
    ' Apply QBasic Pass-By-Reference semantics using the Copy-In / Copy-Out architecture
    ' The callee writes its invocation-local parameters back to the staging symbols before returning
    FOR iArg = 0 TO subs(subIdx).ArgCount - 1
      IF byValTracker(subIdx, iArg).SubArg = 0 THEN
        formalVarIdx = subArgVarIdx(subIdx, iArg)
        stageVarIdx = retSubArgStageVarIdx(subIdx, iArg)
        IF stageVarIdx = 0 OR compileError = 1 THEN
          tira_Cancel
          EXIT FUNCTION
        END IF

        IF symbols(formalVarIdx).IsArray = 2 THEN
          addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, iArg)
          IF addrStageVarIdx = 0 OR compileError = 1 THEN
            tira_Cancel
            EXIT FUNCTION
          END IF

          addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))
          stageName$ = "#" + LTRIM$(STR$(stageVarIdx))

          stageAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
          tiraOp TC_ADDRESS_OF, stageAddr$, stageName$, ""

          ' Copy the returned staging descriptor back into the caller's original array descriptor
          descriptorDimCount$ = tiraDimVar$("T", TYPE_LONG)
          tiraNew TC_READ_MEM_OFFSET, descriptorDimCount$ + ", " + stageAddr$ + ", 12"

          descriptorDimLowReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_LOW")
          tiraJmpCond "JGE", descriptorDimCount$, "0", descriptorDimLowReady$
          tiraFatalError "INVALID RETURNED ARRAY DESCRIPTOR ARG " + LTRIM$(STR$(iArg + 1))
          tiraLabel descriptorDimLowReady$

          descriptorDimHighReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_HIGH")
          tiraJmpCond "JLE", descriptorDimCount$, "255", descriptorDimHighReady$
          tiraFatalError "RETURNED ARRAY DESCRIPTOR DIMENSION LIMIT ARG " + LTRIM$(STR$(iArg + 1))
          tiraLabel descriptorDimHighReady$

          IF symbols(formalVarIdx).NumDimensions > 0 THEN
            descriptorDimMatchReady$ = tiraLabelCreateNew$("ARG_DESC_DIM_MATCH")
            tiraJmpCond "JE", descriptorDimCount$, LTRIM$(STR$(symbols(formalVarIdx).NumDimensions)), descriptorDimMatchReady$
            tiraFatalError "RETURNED ARRAY DIMENSION MISMATCH ARG " + LTRIM$(STR$(iArg + 1))
            tiraLabel descriptorDimMatchReady$
          END IF

          descriptorByteSize$ = tiraDimVar$("T", TYPE_LONG)
          tiraOp TC_MUL, descriptorByteSize$, descriptorDimCount$, "8"
          tiraOp TC_ADD, descriptorByteSize$, descriptorByteSize$, "16"

          tiraMemcpy addrStageName$, stageAddr$, descriptorByteSize$
        ELSE
          srcArgIdx = argVIdx(iArg)
          srcIsComplex = argIsComplex(iArg)

          IF srcArgIdx <> -1 AND retByRefTypeCompatible(argDataType(iArg), symbols(formalVarIdx).DataType) = 1 THEN
            IF srcIsComplex = 0 THEN
              firstChar$ = LEFT$(RTRIM$(symbols(srcArgIdx).RecordName), 1)
              IF firstChar$ <> "!" THEN
                tiraEmitPassByRefCopyOut srcArgIdx, stageVarIdx
              END IF
            ELSE
              IF argAddr$(iArg) <> "" THEN
                addrStageVarIdx = retSubArgAddrStageVarIdx(subIdx, iArg)
                IF addrStageVarIdx = 0 OR compileError = 1 THEN
                  tira_Cancel
                  EXIT FUNCTION
                END IF

                addrStageName$ = "#" + LTRIM$(STR$(addrStageVarIdx))

                IF symbols(formalVarIdx).DataType = TYPE_STRING THEN
                  ' Copy the modified dynamic string back into the original target
                  destDescPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
                  tiraNew TC_READ_MEM, destDescPtr$ + ", " + addrStageName$

                  tiraEnsureStringAlloc destDescPtr$, addrStageName$

                  stageName$ = "#" + LTRIM$(STR$(stageVarIdx))
                  tiraCall "RT_STR_ASSIGN", 2, destDescPtr$ + ", " + stageName$
                ELSE
                  IF symbols(formalVarIdx).DataType = TYPE_UDT THEN
                    tgtBaseAddr$ = tiraDimVar$("T", TYPE_INTEGER64)
                    tiraOp TC_ADDRESS_OF, tgtBaseAddr$, "#" + LTRIM$(STR$(stageVarIdx)), ""
                    tiraCopyUdtValue addrStageName$, tgtBaseAddr$, symbols(formalVarIdx).UDTIndex
                  ELSE
                    stageName$ = "#" + LTRIM$(STR$(stageVarIdx))
                    sMode$ = RTRIM$(typeDb(argDataType(iArg)).TiraMode)
                    IF sMode$ = "" THEN sMode$ = "8"
                    tiraWriteMem addrStageName$, stageName$, sMode$
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  tiraScheduleHeapReset
  tira_EndAndProcess

  parseSubCall = 1

END FUNCTION ' parseSubCall

''''''''''''''''''''''''
FUNCTION parseTypeClause (startTokIdx, endIdx, isUdtContext AS LONG)

  returnExtraPrepare

  DIM tempTokIdx AS LONG
  DIM tType AS LONG
  DIM dtMapped AS LONG
  DIM uTok$
  DIM sizeTok$
  DIM isNum AS LONG
  DIM fixedLen AS LONG
  DIM tempType AS LONG
  DIM typeData AS LONG
  DIM chCheck$
  DIM hasAsterisk AS LONG

  tempTokIdx = startTokIdx
  tempType = TYPE_UNDEFINED
  typeData = 0

  IF tempTokIdx <= endIdx THEN
    IF lineTokenVals(tempTokIdx) = TOK_UNSIGNED THEN
      tempTokIdx = tempTokIdx + 1
      IF tempTokIdx <= endIdx THEN
        tType = lineTokenVals(tempTokIdx)
        dtMapped = retTypeFromToken(tType, 1)

        IF dtMapped <> TYPE_UNDEFINED THEN
          tempTokIdx = tempTokIdx + 1
          tempType = dtMapped
        ELSE
          throwCompilerError "EXPECTED _BYTE, INTEGER, LONG, OR _INTEGER64 BUT GOT " + CHR$(34) + retTokenText$(lineTokens$(tempTokIdx)) + CHR$(34), ASIS, 0
        END IF
      ELSE
        throwCompilerError "EXPECTED TYPE AFTER _UNSIGNED", ASIS, 0
      END IF
    ELSE
      tType = lineTokenVals(tempTokIdx)
      dtMapped = retTypeFromToken(tType, 0)

      IF dtMapped <> TYPE_UNDEFINED THEN
        tempTokIdx = tempTokIdx + 1
        tempType = dtMapped

        SELECT CASE tType

          CASE TOK_STRINGD
            IF tempTokIdx <= endIdx THEN
              IF lineTokenVals(tempTokIdx) = 256 + ASC("*") THEN
                throwCompilerError "STRINGD CANNOT HAVE * LENGTH", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            END IF

          CASE TOK_STRING
            hasAsterisk = 0
            IF tempTokIdx <= endIdx THEN
              IF lineTokenVals(tempTokIdx) = 256 + ASC("*") THEN hasAsterisk = 1
            END IF

            IF hasAsterisk = 1 THEN
              tempTokIdx = tempTokIdx + 1
              IF tempTokIdx <= endIdx THEN
                sizeTok$ = lineTokens$(tempTokIdx)
                isNum = 1
                FOR ii = 1 TO LEN(sizeTok$)
                  chCheck$ = MID$(sizeTok$, ii, 1)
                  IF chCheck$ < "0" OR chCheck$ > "9" THEN
                    isNum = 0
                    EXIT FOR
                  END IF
                NEXT
                IF isNum = 0 THEN
                  throwCompilerError "STRING LENGTH MUST BE CONSTANT", ASIS, 0
                  tempType = TYPE_UNDEFINED
                ELSE
                  fixedLen = VAL(sizeTok$)
                  typeData = fixedLen
                  tempTokIdx = tempTokIdx + 1
                END IF
              ELSE
                throwCompilerError "EXPECTED STRING LENGTH", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            ELSE
              IF cm.StringStrict = 1 AND isUdtContext = 0 THEN
                throwCompilerError "STRING REQUIRES * LENGTH (USE STRINGD FOR DYNAMIC)", ASIS, 0
                tempType = TYPE_UNDEFINED
              END IF
            END IF

        END SELECT ' tType

      ELSE
        IF tType = 0 OR tType = TOK_MEM THEN ' UDT Identifier Match
          IF tType = TOK_MEM THEN
            uTok$ = "_MEM"
          ELSE
            uTok$ = UCASE$(lineTokens$(tempTokIdx))
          END IF

          IF uTok$ = "_OFFSET" THEN
            tempTokIdx = tempTokIdx + 1
            tempType = TYPE_INTEGER64
          ELSE
            ff = findUdtIndex(uTok$)
            IF ff = 1 THEN
              typeData = returnedData2
              tempTokIdx = tempTokIdx + 1
              tempType = TYPE_UDT
            ELSE
              IF tType = TOK_MEM THEN
                throwCompilerError "UNSUPPORTED TYPE OR UNKNOWN UDT _MEM", ASIS, 0
              ELSE
                throwCompilerError "UNSUPPORTED TYPE OR UNKNOWN UDT " + CHR$(34) + lineTokens$(tempTokIdx) + CHR$(34), ASIS, 0
              END IF
            END IF
          END IF
        ELSE
          throwCompilerError "UNSUPPORTED TYPE " + CHR$(34) + retTokenText$(lineTokens$(tempTokIdx)) + CHR$(34), ASIS, 0
        END IF
      END IF
    END IF
  ELSE
    throwCompilerError "EXPECTED TYPE", ASIS, 0
  END IF

  return3 typeData
  return2 tempType
  parseTypeClause = tempTokIdx

END FUNCTION ' parseTypeClause

''''''''''''''
'' SUB pasteClipboardText (wStr$) ' This is found within Z_EMLINF.BLB
'
' Copies from clipboard into the editor

''''''''''''''''''''''''
SUB patch8 (wPos AS _UNSIGNED LONG)

  ' Calculates and patches an 8-bit short jump displacement
  ' Includes a safety check to prevent silent overflow crashes

  DIM patchOffset AS LONG

  patchOffset = stream.emitPos - (wPos + 1)

  IF patchOffset > 127 OR patchOffset < -128 THEN
    ESCAPETEXT "FATAL: 8-bit jump displacement out of bounds (" + LTRIM$(STR$(patchOffset)) + ") in patch8"
  END IF

  IF isMeasurePass = 1 THEN EXIT SUB

  intermediateCode(wPos) = patchOffset AND 255

END SUB ' patch8

''''''''''''''''''''''''
SUB patch32 (wPos AS LONG, wVal AS LONG)

  DIM uVal AS _UNSIGNED LONG
  DIM patchEnd AS _INTEGER64
  DIM previousByte AS LONG
  DIM previousByte2 AS LONG
  DIM isPatchField AS LONG

  patchEnd = wPos
  patchEnd = patchEnd + 3

  IF wPos <= 0 OR patchEnd >= stream.emitPos OR patchEnd >= MAX_CODE_SIZE THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 out of bounds", "OFFSET: " + LTRIM$(STR$(wPos)) + " | PATCH END: " + LTRIM$(STR$(patchEnd)) + " | EMITTED BYTES: " + LTRIM$(STR$(stream.emitPos))
    EXIT SUB
  END IF

  IF intermediateCode(wPos) <> 0 OR intermediateCode(wPos + 1) <> 0 OR intermediateCode(wPos + 2) <> 0 OR intermediateCode(wPos + 3) <> 0 THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 target was already patched or is not a placeholder", "OFFSET: " + LTRIM$(STR$(wPos))
    EXIT SUB
  END IF

  previousByte = intermediateCode(wPos - 1)
  previousByte2 = 0

  IF wPos >= 2 THEN
    previousByte2 = intermediateCode(wPos - 2)
  END IF

  isPatchField = 0

  IF (previousByte AND &HC7) = &H05 THEN
    isPatchField = 1
  END IF

  IF previousByte = &HE8 OR previousByte = &HE9 THEN
    isPatchField = 1
  END IF

  IF wPos >= 2 THEN
    IF previousByte2 = &H0F THEN
      IF previousByte >= &H80 AND previousByte <= &H8F THEN
        isPatchField = 1
      END IF
    END IF
  END IF

  IF isPatchField = 0 THEN
    ESCAPETEXT2 "COMPILER FAIL: patch32 target is not a recognized displacement field", "OFFSET: " + LTRIM$(STR$(wPos)) + " | PREVIOUS BYTE: $" + hexLen$(previousByte, 2) + " | SECOND PREVIOUS BYTE: $" + hexLen$(previousByte2, 2)
    EXIT SUB
  END IF

  uVal = wVal
  intermediateCode(wPos) = uVal AND 255
  intermediateCode(wPos + 1) = (uVal \ 256) AND 255
  intermediateCode(wPos + 2) = (uVal \ 65536) AND 255
  intermediateCode(wPos + 3) = (uVal \ 16777216) AND 255

END SUB ' patch32

''''''''''''''''''''''''
SUB prepareBinary

  ' Effectively the linker

  DIM prologueBoundary AS LONG
  DIM pOffEmit AS LONG
  DIM vIdx AS LONG
  DIM isBss AS LONG
  DIM varRVA AS LONG
  DIM actualVarOffset AS LONG
  DIM ripAfter AS LONG
  DIM disp AS LONG
  DIM iatConst AS LONG
  DIM mappedIdx AS LONG
  DIM iatEntryRVA AS LONG
  DIM targetOffset AS LONG
  DIM targetSubIdx AS LONG
  DIM targetOpcode AS LONG
  DIM bssRVA AS LONG
  DIM bssCurrent AS LONG
  DIM textVirtualSize AS LONG
  DIM wTextRawSize AS LONG
  DIM localIdataRVA AS LONG
  DIM descVA AS LONG
  DIM strVA AS LONG
  DIM strLen AS LONG
  DIM gfxBufTotalSize AS LONG
  DIM userCodeLen AS LONG
  DIM userPatchCount AS LONG
  DIM userIatPatchCount AS LONG
  DIM userGotoPatchCount AS LONG
  DIM userCallPatchCount AS LONG
  DIM userRtPatchCount AS LONG
  DIM userSubCount AS LONG
  DIM userSymbolCount AS LONG
  DIM mergedCodeSize AS _INTEGER64
  DIM layoutRemainder AS LONG
  DIM iLong AS _UNSIGNED LONG
  DIM i2Long AS _UNSIGNED LONG
  DIM i3Long AS _UNSIGNED LONG

  compileSaveTracker "MAPPING GLOBALS", 0, symbolCount, 1

  compilePass6GlobalMap
  IF compileError = 1 THEN EXIT SUB

  outputFileIdx = 0

  rwVar$ = " " ' Necessary

  userCodeLen = stream.emitPos
  compileSaveTracker "COPYING GENERATED CODE", 0, userCodeLen, 0
  REDIM userCode(userCodeLen + 1) AS _UNSIGNED _BYTE
  IF userCodeLen > 0 THEN
    FOR iLong = 0 TO userCodeLen - 1
      IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
        compileSaveTracker "COPYING GENERATED CODE", iLong + 1, userCodeLen, 0
      END IF

      userCode(iLong) = intermediateCode(iLong)
    NEXT
  END IF
  stream.emitPos = 0

  IF cm.HasGraphics = 0 THEN
    userPatchCount = patchCount
    userIatPatchCount = iatPatchCount
    userGotoPatchCount = gotoPatchCount
    userCallPatchCount = callPatchCount
    userRtPatchCount = rt.PatchCount
    userSubCount = subCount
    userSymbolCount = symbolCount

    compileSaveTracker "BUILDING PROLOGUE", 0, 0, 0
    emitPrologue
    IF compileError = 1 THEN EXIT SUB

    prologueBoundary = stream.emitPos

    ' Preflight the complete native-code image before copying the saved user code.
    ' Pass 5 only measured the runtime and user-code portion; prepareBinary adds
    ' the prologue and epilogue around it, so all three portions must fit.
    mergedCodeSize = prologueBoundary
    mergedCodeSize = mergedCodeSize + userCodeLen
    mergedCodeSize = mergedCodeSize + metrics.EpilogueSize

    IF mergedCodeSize > MAX_CODE_SIZE THEN
      throwCompilerErrorNoLineNum "GENERATED MACHINE CODE EXCEEDS MAX_CODE_SIZE"
      addStatusMsgContinuation "PROLOGUE: " + LTRIM$(STR$(prologueBoundary)) + " BYTES"
      addStatusMsgContinuation "RUNTIME + USER CODE: " + LTRIM$(STR$(userCodeLen)) + " BYTES"
      addStatusMsgContinuation "EPILOGUE: " + LTRIM$(STR$(metrics.EpilogueSize)) + " BYTES"
      addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(mergedCodeSize)) + " BYTES"
      addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
      addStatusMsgContinuation "OVER BY: " + LTRIM$(STR$(mergedCodeSize - MAX_CODE_SIZE)) + " BYTES"
      EXIT SUB
    END IF

    compileSaveTracker "SHIFTING OFFSETS", 0, 0, 0
    adjustAllPatchOffsets prologueBoundary, userPatchCount, userIatPatchCount, userGotoPatchCount, userCallPatchCount, userRtPatchCount, userSubCount, userSymbolCount

    IF userCodeLen > 0 THEN
      FOR iLong = 0 TO userCodeLen - 1
        IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
          compileSaveTracker "LINKING GENERATED CODE", iLong + 1, userCodeLen, 0
        END IF

        IF stream.emitPos >= MAX_CODE_SIZE THEN
          throwCompilerErrorNoLineNum "MACHINE CODE BUFFER OVERFLOW DURING LINK"
          addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
          addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
          EXIT SUB
        END IF

        intermediateCode(stream.emitPos) = userCode(iLong)
        stream.emitPos = stream.emitPos + 1
      NEXT
    END IF

  ELSE
    userPatchCount = patchCount
    userIatPatchCount = iatPatchCount
    userGotoPatchCount = gotoPatchCount
    userCallPatchCount = callPatchCount
    userRtPatchCount = rt.PatchCount
    userSubCount = subCount
    userSymbolCount = symbolCount

    compileSaveTracker "BUILDING WINDOW STARTUP", 0, 0, 0
    IF USE_DIB_SECTION = 1 THEN
      ESCAPETEXT "USE_DIB_SECTION SET TO 1, HARDWARE GRAPHICS NOT SUPPORTED YET"
    ELSE
      emitPrologueWindowSetup
    END IF
    IF compileError = 1 THEN EXIT SUB

    compileSaveTracker "BUILDING PROLOGUE", 0, 0, 0
    emitPrologue
    IF compileError = 1 THEN EXIT SUB

    prologueBoundary = stream.emitPos

    ' Preflight the complete native-code image before copying the saved user code.
    ' Pass 5 only measured the runtime and user-code portion; prepareBinary adds
    ' the prologue and epilogue around it, so all three portions must fit.
    mergedCodeSize = prologueBoundary
    mergedCodeSize = mergedCodeSize + userCodeLen
    mergedCodeSize = mergedCodeSize + metrics.EpilogueSize

    IF mergedCodeSize > MAX_CODE_SIZE THEN
      throwCompilerErrorNoLineNum "GENERATED MACHINE CODE EXCEEDS MAX_CODE_SIZE"
      addStatusMsgContinuation "PROLOGUE: " + LTRIM$(STR$(prologueBoundary)) + " BYTES"
      addStatusMsgContinuation "RUNTIME + USER CODE: " + LTRIM$(STR$(userCodeLen)) + " BYTES"
      addStatusMsgContinuation "EPILOGUE: " + LTRIM$(STR$(metrics.EpilogueSize)) + " BYTES"
      addStatusMsgContinuation "REQUIRED: " + LTRIM$(STR$(mergedCodeSize)) + " BYTES"
      addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
      addStatusMsgContinuation "OVER BY: " + LTRIM$(STR$(mergedCodeSize - MAX_CODE_SIZE)) + " BYTES"
      EXIT SUB
    END IF

    compileSaveTracker "SHIFTING OFFSETS", 0, 0, 0
    adjustAllPatchOffsets prologueBoundary, userPatchCount, userIatPatchCount, userGotoPatchCount, userCallPatchCount, userRtPatchCount, userSubCount, userSymbolCount

    IF userCodeLen > 0 THEN
      FOR iLong = 0 TO userCodeLen - 1
        IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
          compileSaveTracker "LINKING GENERATED CODE", iLong + 1, userCodeLen, 0
        END IF

        IF stream.emitPos >= MAX_CODE_SIZE THEN
          throwCompilerErrorNoLineNum "MACHINE CODE BUFFER OVERFLOW DURING LINK"
          addStatusMsgContinuation "WRITE POSITION: " + LTRIM$(STR$(stream.emitPos))
          addStatusMsgContinuation "LIMIT: " + LTRIM$(STR$(MAX_CODE_SIZE)) + " BYTES"
          EXIT SUB
        END IF

        intermediateCode(stream.emitPos) = userCode(iLong)
        stream.emitPos = stream.emitPos + 1
      NEXT
    END IF

  END IF

  compileSaveTracker "LAYING OUT IMAGE", 0, 0, 0

  ff = resolveSymbol("@END_PROGRAM")
  IF ff = 1 THEN
    vIdx = returnedData2
    symbols(vIdx).DataType = TYPE_LABEL
    symbols(vIdx).Offset = stream.emitPos
  END IF

  emitEpilogue
  IF compileError = 1 THEN EXIT SUB

  gfxBufTotalSize = GFX_BUFFER_ENTRIES * layout.GfxBufEntrySize

  textLayout.CodeOffset = PE_FILE_HEADER_OFFSET
  textLayout.CodeSize = stream.emitPos
  textLayout.StrBase = textLayout.CodeOffset + textLayout.CodeSize
  textLayout.VarBase = textLayout.StrBase + textLayout.TotalStrSize

  ' Keep the initialized global variable block naturally aligned
  layoutRemainder = textLayout.VarBase AND 7
  IF layoutRemainder <> 0 THEN
    textLayout.VarBase = textLayout.VarBase + (8 - layoutRemainder)
  END IF

  textLayout.DescBase = textLayout.VarBase + textLayout.TotalVarSize
  textLayout.DataPtrArrBase = textLayout.DescBase + textLayout.TotalDescSize

  textLayout.TotalSize = (textLayout.DataPtrArrBase + (dataItemCount * 8)) - textLayout.CodeOffset

  ff = resolveSymbol("!G_SYS_ARR_DATA_LIST")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.DataPtrArrBase - textLayout.VarBase

  ' Set up purely virtual BSS layout offsets
  bssCurrent = textLayout.TotalBssSize

  textLayout.GfxBufFrontBase = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufBackBase = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufPage2Base = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.GfxBufPage3Base = bssCurrent
  bssCurrent = bssCurrent + gfxBufTotalSize

  textLayout.HwndBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.FramebufFrontBase = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufBackBase = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufPage2Base = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.FramebufPage3Base = bssCurrent
  bssCurrent = bssCurrent + layout.FramebufSize

  textLayout.KbdBufBase = bssCurrent
  bssCurrent = bssCurrent + 256

  textLayout.KbdHeadBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.KbdTailBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.FileHandlesBase = bssCurrent
  bssCurrent = bssCurrent + 2048

  textLayout.KbdStateBase = bssCurrent
  bssCurrent = bssCurrent + 256

  textLayout.MouseBufBase = bssCurrent
  bssCurrent = bssCurrent + 8192

  textLayout.MouseHeadBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.MouseTailBase = bssCurrent
  bssCurrent = bssCurrent + 8

  textLayout.TotalBssSize = bssCurrent

  ' Force Internal Uninitialized Layout buffers natively into BSS
  ff = resolveSymbol("!G_GFX_ARR_BUFR_FRONT")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufFrontBase

  ff = resolveSymbol("!G_GFX_ARR_BUFR_BACK")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufBackBase

  ff = resolveSymbol("!G_GFX_ARR_BUFR_PAGE2")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufPage2Base

  ff = resolveSymbol("!G_GFX_ARR_BUFR_PAGE3")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.GfxBufPage3Base

  ff = resolveSymbol("!G_GFX_ARR_FRMB_FRONT")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufFrontBase

  ff = resolveSymbol("!G_GFX_ARR_FRMB_BACK")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufBackBase

  ff = resolveSymbol("!G_GFX_ARR_FRMB_PAGE2")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufPage2Base

  ff = resolveSymbol("!G_GFX_ARR_FRMB_PAGE3")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FramebufPage3Base

  ff = resolveSymbol("!G_WND_VAL_HWND")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.HwndBase

  ff = resolveSymbol("!G_INO_VAL_KBD_HEAD")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdHeadBase

  ff = resolveSymbol("!G_INO_VAL_KBD_TAIL")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdTailBase

  ff = resolveSymbol("!G_INO_ARR_KBD_BUF")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdBufBase

  ff = resolveSymbol("!G_INO_ARR_KBD_STATE")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.KbdStateBase

  ff = resolveSymbol("!G_FLS_ARR_HANDLES")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.FileHandlesBase

  ff = resolveSymbol("!G_INO_ARR_MOUSE_BUF")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseBufBase

  ff = resolveSymbol("!G_INO_VAL_MOUSE_HEAD")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseHeadBase

  ff = resolveSymbol("!G_INO_VAL_MOUSE_TAIL")
  IF ff = 1 THEN symbols(returnedData2).Offset = textLayout.MouseTailBase

  textVirtualSize = textLayout.TotalSize
  wTextRawSize = (((textVirtualSize) + PE_FILE_ALIGNMENT - 1) \ PE_FILE_ALIGNMENT) * PE_FILE_ALIGNMENT
  localIdataRVA = ((PE_TEXT_RVA + textVirtualSize + PE_SECTION_ALIGNMENT - 1) \ PE_SECTION_ALIGNMENT) * PE_SECTION_ALIGNMENT

  impTbl.baseRVA = localIdataRVA
  compileSaveTracker "BUILDING IMPORT TABLE", 0, 0, 0
  buildImportTable

  bssRVA = ((localIdataRVA + impTbl.idataRawSize + PE_SECTION_ALIGNMENT - 1) \ PE_SECTION_ALIGNMENT) * PE_SECTION_ALIGNMENT

  IF patchCount > 0 THEN
    FOR iLong = 0 TO patchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING VARIABLES", iLong + 1, patchCount, 0
      END IF

      pOffEmit = patches(iLong).Offset
      vIdx = patches(iLong).VarIdx

      ' Determine if variable was shunted to the uninitialized BSS section
      ' using strict explicit name matching.
      isBss = 0
      recName$ = RTRIM$(symbols(vIdx).RecordName)
      firstChar$ = LEFT$(recName$, 1)

      IF symbols(vIdx).IsArray > 0 AND firstChar$ <> "!" THEN
        isBss = 1
      ELSE
        SELECT CASE recName$

          CASE "!G_GFX_ARR_BUFR_FRONT", "!G_GFX_ARR_BUFR_BACK", "!G_GFX_ARR_BUFR_PAGE2", "!G_GFX_ARR_BUFR_PAGE3", "!G_GFX_ARR_FRMB_FRONT", "!G_GFX_ARR_FRMB_BACK", "!G_GFX_ARR_FRMB_PAGE2", "!G_GFX_ARR_FRMB_PAGE3", "!G_WND_VAL_HWND", "!G_INO_VAL_KBD_HEAD", "!G_INO_VAL_KBD_TAIL", "!G_INO_ARR_KBD_BUF", "!G_INO_ARR_KBD_STATE", "!G_FLS_ARR_HANDLES", "!G_INO_ARR_MOUSE_BUF", "!G_INO_VAL_MOUSE_HEAD", "!G_INO_VAL_MOUSE_TAIL"
            isBss = 1

        END SELECT
      END IF

      IF isBss = 1 THEN
        varRVA = bssRVA + symbols(vIdx).Offset
      ELSE
        actualVarOffset = textLayout.VarBase + symbols(vIdx).Offset
        varRVA = PE_TEXT_RVA + (actualVarOffset - PE_FILE_HEADER_OFFSET)
      END IF

      ripAfter = PE_TEXT_VA + pOffEmit + 4
      disp = (PE_IMAGE_BASE + varRVA) - ripAfter
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF iatPatchCount > 0 THEN
    FOR iLong = 0 TO iatPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING IMPORTS", iLong + 1, iatPatchCount, 0
      END IF

      pOffEmit = iatPatches(iLong).Offset
      iatConst = iatPatches(iLong).IATIdx

      IF iatConst >= 1000 THEN
        targetSubIdx = iatConst - 1000
        mappedIdx = subs(targetSubIdx).IatFlatIdx
      ELSE
        mappedIdx = impIatFlatIdx(iatConst)
      END IF

      iatEntryRVA = PE_IMAGE_BASE + impFlatIatRVA(mappedIdx)

      ripAfter = PE_TEXT_VA + pOffEmit + 4
      disp = iatEntryRVA - ripAfter

      patch32 pOffEmit, disp
    NEXT
  END IF

  IF gotoPatchCount > 0 THEN
    FOR iLong = 0 TO gotoPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING JUMPS", iLong + 1, gotoPatchCount, 0
      END IF

      pOffEmit = gotoPatches(iLong).Offset
      vIdx = gotoPatches(iLong).VarIdx
      targetOffset = symbols(vIdx).Offset

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF callPatchCount > 0 THEN
    FOR iLong = 0 TO callPatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING CALLS", iLong + 1, callPatchCount, 0
      END IF

      pOffEmit = callPatches(iLong).Offset
      targetSubIdx = callPatches(iLong).SubIndex

      targetOffset = subs(targetSubIdx).Offset

      IF targetOffset < prologueBoundary OR targetOffset >= stream.emitPos THEN
        targetName$ = RTRIM$(subs(targetSubIdx).RecordName)
        throwCompilerErrorNoLineNum "GPF FATAL: SUB " + targetName$ + " TARGET OUT OF BOUNDS"
        EXIT SUB
      END IF

      targetOpcode = intermediateCode(targetOffset)
      IF targetOpcode <> &H55 THEN
        targetName$ = RTRIM$(subs(targetSubIdx).RecordName)
        throwCompilerErrorNoLineNum "GPF FATAL: SUB " + targetName$ + " OFFSET DOES NOT POINT TO FUNCTION START"
        EXIT SUB
      END IF

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  IF rt.PatchCount > 0 THEN
    FOR iLong = 0 TO rt.PatchCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "PATCHING RUNTIMES", iLong + 1, rt.PatchCount, 0
      END IF

      pOffEmit = rtPatches(iLong).Offset
      targetOffset = rtOffset(rtPatches(iLong).Routine)

      IF targetOffset < prologueBoundary OR targetOffset >= stream.emitPos THEN
        rtMsg1$ = "GPF RT=" + LTRIM$(STR$(rtPatches(iLong).Routine)) + " OOB IX=" + LTRIM$(STR$(iLong)) + " CNT=" + LTRIM$(STR$(rt.PatchCount)) + " PRE=" + LTRIM$(STR$(userRtPatchCount))
        rtMsg2$ = "P=" + LTRIM$(STR$(pOffEmit)) + " T=" + LTRIM$(STR$(targetOffset)) + " RAW=" + LTRIM$(STR$(targetOffset - prologueBoundary)) + " PB=" + LTRIM$(STR$(prologueBoundary)) + " END=" + LTRIM$(STR$(stream.emitPos)) + " G=" + LTRIM$(STR$(cm.HasGraphics))
        ESCAPETEXT2 rtMsg1$, rtMsg2$
        EXIT SUB
      END IF

      targetOpcode = intermediateCode(targetOffset)
      IF targetOpcode <> &H55 AND targetOpcode <> &H53 THEN
        rtMsg1$ = "GPF RT=" + LTRIM$(STR$(rtPatches(iLong).Routine)) + " OP=$" + HEX$(targetOpcode) + " IX=" + LTRIM$(STR$(iLong)) + " CNT=" + LTRIM$(STR$(rt.PatchCount)) + " PRE=" + LTRIM$(STR$(userRtPatchCount))
        rtMsg2$ = "P=" + LTRIM$(STR$(pOffEmit)) + " T=" + LTRIM$(STR$(targetOffset)) + " RAW=" + LTRIM$(STR$(targetOffset - prologueBoundary)) + " PB=" + LTRIM$(STR$(prologueBoundary)) + " END=" + LTRIM$(STR$(stream.emitPos)) + " G=" + LTRIM$(STR$(cm.HasGraphics))
        ESCAPETEXT2 rtMsg1$, rtMsg2$
        EXIT SUB
      END IF

      disp = targetOffset - (pOffEmit + 4)
      patch32 pOffEmit, disp
    NEXT
  END IF

  compileSaveTracker "BUILDING EXECUTABLE", 0, 0, 0
  writePEHeader wTextRawSize, textVirtualSize, bssRVA

  IF stream.emitPos > 0 THEN
    FOR iLong = 0 TO stream.emitPos - 1
      IF (iLong AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING CODE", iLong + 1, stream.emitPos, 0
      END IF

      outputFile(outputFileIdx) = intermediateCode(iLong)
      outputFileIdx = outputFileIdx + 1
    NEXT
  END IF

  arrayPadUpTo textLayout.StrBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING STRINGS", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = 0 THEN
          IF strVarData$(iLong) <> "" THEN
            strData$ = strVarData$(iLong)
            strLen = LEN(strData$)

            FOR i2Long = 1 TO strLen
              IF (i2Long AND COMPILE_SAVE_BYTE_CHECK_MASK) = 0 THEN
                compileSaveTracker "WRITING STRING DATA", i2Long, strLen, 0
              END IF

              IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
              END IF

              outputFile(outputFileIdx) = ASC(MID$(strData$, i2Long, 1))
              outputFileIdx = outputFileIdx + 1
            NEXT

            IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
              ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
            END IF

            outputFile(outputFileIdx) = 0
            outputFileIdx = outputFileIdx + 1
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.VarBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING VARIABLES", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        recName$ = RTRIM$(symbols(iLong).RecordName)

        ' Ignore BSS mapped arrays so we don't accidentally write to
        ' the .text variable block.
        firstChar$ = LEFT$(recName$, 1)

        IF symbols(iLong).IsArray > 0 AND firstChar$ <> "!" THEN
        ELSE
          IF symbols(iLong).DataType = TYPE_DOUBLE AND floatVarData(iLong) <> 0 AND symbols(iLong).IsArray = 0 THEN
            arrayWrite64F floatVarData(iLong)
          ELSE
            IF symbols(iLong).DataType = TYPE_SINGLE AND floatVarData(iLong) <> 0 AND symbols(iLong).IsArray = 0 THEN
              arrayWrite32F floatVarData(iLong)
              arrayPadNumBytes 4, 0
            ELSE
              IF RTRIM$(symbols(iLong).RecordName) = "!G_SYS_ARR_FONT" THEN
                FOR iFY = 0 TO 127
                  FOR iFX = 0 TO 127
                    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                      ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
                    END IF

                    outputFile(outputFileIdx) = fontData(iFX, iFY)
                    outputFileIdx = outputFileIdx + 1
                  NEXT
                NEXT

                FOR iFY = 0 TO 255
                  FOR iFX = 0 TO 127
                    IF outputFileIdx >= MAX_OUTPUT_SIZE THEN
                      ESCAPETEXT "COMPILER FAIL: Output file buffer exceeded"
                    END IF

                    outputFile(outputFileIdx) = fontData16(iFX, iFY)
                    outputFileIdx = outputFileIdx + 1
                  NEXT
                NEXT
              ELSE
                IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = 0 THEN
                  descVA = textFileRVA(textLayout.DescBase + symbols(iLong).DescOffset)
                  arrayWrite32LE descVA
                  arrayWrite32LE 0
                ELSE
                  arrayPadNumBytes retSymbolByteSize(iLong), 0
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.DescBase, 0

  IF symbolCount > 0 THEN
    FOR iLong = 0 TO symbolCount - 1
      IF (iLong AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING DESCRIPTORS", iLong + 1, symbolCount, 0
      END IF

      IF (symbols(iLong).IsLocal = LOCAL_STANDARD AND symbols(iLong).IsShared = 0) OR symbols(iLong).DataType = TYPE_LABEL THEN
      ELSE
        IF symbols(iLong).DataType = TYPE_STRING AND symbols(iLong).IsArray = 0 THEN
          IF strVarData$(iLong) <> "" THEN
            strVA = textFileRVA(textLayout.StrBase + symbols(iLong).StrOffset)
            strLen = LEN(strVarData$(iLong))

            arrayWrite32LE strVA
            arrayWrite32LE 0
            arrayWrite32LE strLen
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
          ELSE
            strVA = textFileRVA(textLayout.StrBase)

            arrayWrite32LE strVA
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
            arrayWrite32LE 0
          END IF
        END IF
      END IF
    NEXT
  END IF

  arrayPadUpTo textLayout.DataPtrArrBase, 0

  IF dataItemCount > 0 THEN
    FOR i3Long = 0 TO dataItemCount - 1
      IF (i3Long AND COMPILE_SAVE_ITEM_CHECK_MASK) = 0 THEN
        compileSaveTracker "WRITING DATA", i3Long + 1, dataItemCount, 0
      END IF

      descVA = textFileRVA(textLayout.DescBase + symbols(dataItemDescIdx(i3Long)).DescOffset)
      arrayWrite32LE descVA
      arrayWrite32LE 0
    NEXT
  END IF

  arrayPadUpTo PE_FILE_HEADER_OFFSET + wTextRawSize, 0

  compileSaveTracker "WRITING IMPORTS", 0, 0, 0
  writeIdataSection wTextRawSize
  compileSaveTracker "FINALIZING EXECUTABLE", 0, 0, 0

  ' The BSS section guarantees we no longer need to physically inject
  ' padding zeros at the end of the file.

END SUB ' prepareBinary

''''''''''''''''''''''''
SUB PrintChr (wPosPixelsX, wPosPixelsY, wStr$, fgClr, bgClr, useTransparent)

  IF LEN(wStr$) <> 1 THEN
    ESCAPETEXT "COMPILER FAIL: Only send one character to PrintChr. Character string sent was '" + wStr$ + "'"
  END IF

  wTile = ASC(wStr$)

  offsetY = wTile \ 16
  offsetX = wTile AND 15

  FOR iy = 0 TO 7
    FOR ix = 0 TO 7
      drawPosX = (wPosPixelsX + ix)
      drawPosY = (wPosPixelsY + iy)

      wClr = fontData((offsetX * 8) + ix, (offsetY * 8) + iy)

      IF wClr = 0 THEN
        IF useTransparent = 0 THEN
          PSET (drawPosX, drawPosY), bgClr
        END IF
      ELSE
        IF wClr = 15 THEN
          PSET (drawPosX, drawPosY), fgClr
        ELSE
          PSET (drawPosX, drawPosY), wClr
        END IF
      END IF
    NEXT
  NEXT

END SUB ' PrintChr

''''''''''''''''''''''''
SUB PrintStr (wPosPixelsX, wPosPixelsY, wStr$, fgClr, bgClr, useTransparent)

  FOR ii = 1 TO LEN(wStr$)
    toSend$ = MID$(wStr$, ii, 1)
    PrintChr wPosPixelsX - 8 + (ii * 8), wPosPixelsY, toSend$, fgClr, bgClr, useTransparent
  NEXT

END SUB ' PrintStr

'' PrintTextLineWithBanners in library

''''''''''''''''''''''''
SUB processCompileState

  STATIC statusCompileStartSeconds AS DOUBLE
  DIM statusCompileElapsedSeconds AS DOUBLE
  DIM statusCompileHundredths AS _UNSIGNED LONG
  DIM statusCompileElapsedText$
  DIM compRes AS LONG
  DIM succMsg$
  DIM runCmd$

  SELECT CASE compileState

    CASE COMP_REFINE
      statusCompileStartSeconds = TIMER

      hasCode = 0
      IF editor.LastLine > 1 THEN
        hasCode = 1
      ELSE
        IF LTRIM$(RTRIM$(editorText$(1))) <> "" THEN hasCode = 1
      END IF

      IF hasCode = 0 THEN
        compileWrapUp
        statusMsgCount = 1
        editor.StatusScrollY = 1
        editor.StatusSelectedIndex = 0
        FOR ii = 1 TO 999
          statusMsg(ii).Text = ""
          statusMsg(ii).CodeLine = 0
        NEXT
        compileStatusMsg$ = ""
        EXIT SUB
      END IF

      compileError = 0
      refineCode 0, 1
      IF compileError = 1 THEN
        compileWrapUp
      ELSE
        addStatusMsg "COMPILING (PASS 1-4)..."
        compileState = COMP_COMPILE
        pass5.SubState = PASS5_STATE_START
      END IF

    CASE COMP_COMPILE

      SELECT CASE pass5.SubState

        CASE PASS5_STATE_START
          compRes = compile
          IF compRes = 1 THEN
            addStatusMsg "DISCOVERING SYMBOLS (PASS 5A)..."
            compilePass5Prepare PASS5_MODE_DISCOVERY

            IF compileError = 1 THEN
              compileWrapUp
            ELSE
              pass5.SubState = PASS5_STATE_DISCOVERY
            END IF
          ELSE
            compileWrapUp
          END IF

        CASE PASS5_STATE_DISCOVERY
          compilePass5ScanOrEmit
          IF compileError = 1 OR pass5.SUCCESS = 0 THEN
            compileWrapUp
          ELSE
            IF pass5.SubState = PASS5_STATE_COMPLETE THEN
              ' Pass 5A has discovered every source and TIRA symbol
              ' Finalize local offsets and frame sizes before measuring code
              compilePass5bLocalVariables

              IF compileError = 1 THEN
                compileWrapUp
                EXIT SUB
              END IF

              addStatusMsg "GENERATING CODE (PASS 5B)..."
              compilePass5Prepare PASS5_MODE_LAYOUT

              IF compileError = 1 THEN
                compileWrapUp
              ELSE
                pass5.SubState = PASS5_STATE_LAYOUT
              END IF
            END IF
          END IF

        CASE PASS5_STATE_LAYOUT
          pass5Trace 700
          pass5Trace 701
          compilePass5ScanOrEmit
          pass5Trace 702

          pass5Trace 703
          IF compileError = 1 OR pass5.SUCCESS = 0 THEN
            pass5Trace 704
            compileWrapUp
          ELSE
            pass5Trace 705

            IF pass5.SubState = PASS5_STATE_COMPLETE THEN
              pass5Trace 710

              ' Repeat local finalization when the layout scan exposes additional TIRA symbols
              pass5Trace 720
              IF symbolCount <> pass5.ScanStartSymbolCount THEN
                pass5Trace 721
                compilePass5bLocalVariables
                pass5Trace 722

                IF compileError = 1 THEN
                  pass5Trace 723
                  compileWrapUp
                  EXIT SUB
                END IF

                pass5Trace 724
                addStatusMsg "REGENERATING CODE (PASS 5B)..."
                pass5Trace 725

                pass5Trace 726
                compilePass5Prepare PASS5_MODE_LAYOUT
                pass5Trace 727

                IF compileError = 1 THEN
                  compileWrapUp
                ELSE
                  pass5.SubState = PASS5_STATE_LAYOUT
                END IF

                pass5Trace 729
                EXIT SUB
              END IF

              pass5Trace 730
              pass5Trace 731
              ff = compilePass5ScanStateStable
              pass5Trace 732

              pass5Trace 733
              IF ff = 0 THEN
                compileWrapUp
                EXIT SUB
              END IF
              pass5Trace 734

              pass5Trace 740
              addStatusMsg "SAVING FOR COMPILE..."
              compileState = COMP_SAVE
              pass5Trace 741
            END IF
          END IF

      END SELECT ' pass5.SubState

    CASE COMP_SAVE
      prepareBinary
      IF compileError = 0 THEN
        fileSaveBinary

        ' Only print SUCCESS and run the program if fileSaveBinary didn't throw a file lock error
        IF compileError = 0 THEN
          statusCompileElapsedSeconds = TIMER - statusCompileStartSeconds
          IF statusCompileElapsedSeconds < 0 THEN statusCompileElapsedSeconds = statusCompileElapsedSeconds + 86400

          statusCompileHundredths = INT((statusCompileElapsedSeconds * 100) + .5)
          statusCompileElapsedText$ = LTRIM$(STR$(statusCompileHundredths \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(statusCompileHundredths MOD 100)), 2)

          succMsg$ = "SUCCESS IN " + statusCompileElapsedText$ + "s (Prologue: " + LTRIM$(STR$(metrics.PrologueSize)) + "b, Epilogue: " + LTRIM$(STR$(metrics.EpilogueSize)) + "b)"
          addStatusMsg succMsg$

          runCmd$ = CHR$(34) + fileNameBase$ + ".exe" + CHR$(34)
          SHELL _DONTWAIT runCmd$
        END IF
      END IF

      compileWrapUp

  END SELECT ' compileState

END SUB ' processCompileState

''''''''''''''''''''''''
'' SUB processInput ' This is found within Z_EMLINF.BLB
'
' Process input for the IDE

''''''''''''''''''''''''
SUB rebuildSymbolScopeHash

  DIM clearMem AS _MEM
  DIM scopeIdx AS LONG

  ' Mark the scope index unavailable until every active symbol has been inserted
  symScopeIndexedSymbolCount = 0

  clearMem = _MEM(symScopeHash())
  _MEMFILL clearMem, clearMem.OFFSET, clearMem.SIZE, 255 AS _UNSIGNED _BYTE
  _MEMFREE clearMem

  FOR scopeIdx = 0 TO MAX_SUBS
    scopeSymbolHead(scopeIdx) = 0
    scopeSymbolTail(scopeIdx) = 0
  NEXT

  syncSymbolScopeIndex

  ' Matching counts certify that the index contains every currently active symbol
  symScopeIndexedSymbolCount = symbolCount

END SUB ' rebuildSymbolScopeHash

''''''''''''''''''''''''
SUB refineCode (targetLine AS LONG, isCompileClick AS LONG)

  DIM activeScope AS LONG

  DIM isVarFound AS LONG
  DIM foundVarIdx AS LONG
  DIM refineBaseHash AS LONG
  DIM refineActiveHash AS LONG
  DIM refineCheckIdx AS LONG

  DIM isDirStart AS LONG
  DIM newRawString AS STRING
  DIM newLen AS LONG
  DIM tempPart$
  DIM tempPartLen AS LONG

  DIM builtLine$
  DIM trimmedLine$
  DIM uTrimmed$
  DIM leadingSpaces AS LONG
  DIM sIdx AS LONG

  newRawString = SPACE$(16384)

  refCount = 0

  FOR ii = 0 TO SYMBOL_HASH_MASK
    refineScratchHash(ii) = -1
  NEXT

  IF targetLine = 0 THEN
    startLine = 1
    endLine = editor.LastLine
    uiSubCount = 0
    activeScope = 0
    scopeCounter = 0
    IF isCompileClick <> 1 THEN
      scanGlobalDirectives 0
    END IF
  ELSE
    startLine = targetLine
    endLine = targetLine

    ' Fast-scan upward to establish the correct scope context for the dirty line
    activeScope = 0
    scopeCounter = 0
    FOR iy = 1 TO startLine - 1
      uTemp$ = UCASE$(LTRIM$(RTRIM$(editorText$(iy))))
      IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
      IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
        activeScope = 0
      END IF
    NEXT
  END IF

  sysColor.focusBorder = 9

  FOR iy = startLine TO endLine
    currentLineNumber = iy
    checkEmergencyClose
    IF compileError = 1 THEN EXIT SUB

    curLine$ = editorText$(iy)
    tempLine$ = LTRIM$(RTRIM$(curLine$))

    uTemp$ = UCASE$(tempLine$)
    IF LEFT$(uTemp$, 4) = "SUB " OR LEFT$(uTemp$, 9) = "FUNCTION " THEN
      IF targetLine = 0 THEN
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      ELSE
        ' Make sure activeScope registers if the user specifically edited the SUB definition line itself
        scopeCounter = scopeCounter + 1
        activeScope = scopeCounter
      END IF
    END IF

    IF LEN(tempLine$) > 0 THEN
      newLen = 0
      ix = 1
      lineLen = LEN(curLine$)
      hasNonSpace = 0
      lastKwVal = 0

      parenDepth = 0

      isValidLine = 0
      IF INSTR(curLine$, "=") > 0 THEN isValidLine = 1
      firstIdent$ = ""

      FOR i_scan = 1 TO lineLen
        cAs = ASC(curLine$, i_scan)
        isDirScan = 0

        IF cAs = 35 OR cAs = 36 THEN ' # or $
          IF i_scan < lineLen THEN
            nAs = ASC(curLine$, i_scan + 1)
            IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirScan = 1
          END IF
        END IF

        IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirScan = 1 THEN
          tStart = i_scan
          FOR j_scan = i_scan TO lineLen
            c2As = ASC(curLine$, j_scan)
            IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (j_scan = i_scan AND (c2As = 35 OR c2As = 36)) THEN
              ' Continue scanning
            ELSE
              EXIT FOR
            END IF
          NEXT
          firstIdent$ = MID$(curLine$, tStart, j_scan - tStart)
          EXIT FOR
        END IF
      NEXT

      IF firstIdent$ <> "" THEN
        uFirst$ = UCASE$(firstIdent$)

        uIdentSearch$ = uFirst$
        IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
        IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
        IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
        IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
        IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
        IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
        IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
        IF uIdentSearch$ = "_STRINGD" THEN uIdentSearch$ = "STRINGD"
        IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
        IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

        ff = findKeywordIndex(uIdentSearch$)
        IF ff = 1 THEN isValidLine = 1
      END IF

      DO WHILE ix <= lineLen
        cAs = ASC(curLine$, ix)

        IF cAs = 32 OR cAs = 9 THEN
          IF hasNonSpace = 0 THEN
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = cAs
            ix = ix + 1
          ELSE
            IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
            newLen = newLen + 1
            ASC(newRawString, newLen) = 32
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              IF c2As = 32 OR c2As = 9 THEN
                ix = ix + 1
              ELSE
                EXIT DO
              END IF
            LOOP
          END IF
        ELSE
          hasNonSpace = 1

          IF cAs = 39 THEN ' '
            tempPart$ = MID$(curLine$, ix)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              FOR i2 = 1 TO tempPartLen
                ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
              NEXT
              newLen = newLen + tempPartLen
            END IF
            EXIT DO
          END IF

          IF cAs = 34 THEN ' "
            tStart = ix
            ix = ix + 1
            DO WHILE ix <= lineLen
              c2As = ASC(curLine$, ix)
              ix = ix + 1
              IF c2As = 34 THEN EXIT DO
            LOOP
            tempPart$ = MID$(curLine$, tStart, ix - tStart)
            tempPartLen = LEN(tempPart$)
            IF tempPartLen > 0 THEN
              IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              FOR i2 = 1 TO tempPartLen
                ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
              NEXT
              newLen = newLen + tempPartLen
            END IF
            lastKwVal = 0
          ELSE
            isDirStart = 0
            IF cAs = 35 OR cAs = 36 THEN ' # or $
              IF ix < lineLen THEN
                nAs = ASC(curLine$, ix + 1)
                IF (nAs >= 65 AND nAs <= 90) OR (nAs >= 97 AND nAs <= 122) THEN isDirStart = 1
              END IF
            END IF

            IF (cAs >= 65 AND cAs <= 90) OR (cAs >= 97 AND cAs <= 122) OR cAs = 95 OR isDirStart = 1 THEN
              tStart = ix
              DO WHILE ix <= lineLen
                c2As = ASC(curLine$, ix)
                IF (c2As >= 65 AND c2As <= 90) OR (c2As >= 97 AND c2As <= 122) OR (c2As >= 48 AND c2As <= 57) OR c2As = 95 OR (ix = tStart AND (c2As = 35 OR c2As = 36)) THEN
                  ix = ix + 1
                ELSE
                  EXIT DO
                END IF
              LOOP

              IF ix <= lineLen THEN
                c2As = ASC(curLine$, ix)
                IF c2As = 126 THEN ' ~
                  ix = ix + 1
                  IF ix <= lineLen THEN
                    c3As = ASC(curLine$, ix)
                    IF c3As = 38 THEN ' &
                      ix = ix + 1
                    END IF
                  END IF
                ELSE
                  IF c2As = 36 OR c2As = 35 OR c2As = 33 OR c2As = 38 OR c2As = 37 THEN
                    ix = ix + 1
                  END IF
                END IF
              END IF

              ident$ = MID$(curLine$, tStart, ix - tStart)
              uIdent$ = UCASE$(ident$)

              uIdentSearch$ = uIdent$
              IF uIdentSearch$ = "_BYTE" THEN uIdentSearch$ = "BYTE"
              IF uIdentSearch$ = "_INTEGER" THEN uIdentSearch$ = "INTEGER"
              IF uIdentSearch$ = "_LONG" THEN uIdentSearch$ = "LONG"
              IF uIdentSearch$ = "_INTEGER64" THEN uIdentSearch$ = "INTEGER64"
              IF uIdentSearch$ = "_SINGLE" THEN uIdentSearch$ = "SINGLE"
              IF uIdentSearch$ = "_DOUBLE" THEN uIdentSearch$ = "DOUBLE"
              IF uIdentSearch$ = "_STRING" THEN uIdentSearch$ = "STRING"
              IF uIdentSearch$ = "_STRINGD" THEN uIdentSearch$ = "STRINGD"
              IF uIdentSearch$ = "_UNSIGNED" THEN uIdentSearch$ = "UNSIGNED"
              IF uIdentSearch$ = "_ANY" THEN uIdentSearch$ = "ANY"

              ff = findKeywordIndex(uIdentSearch$)
              IF ff = 1 THEN
                isKey = 1
                kwVal = returnedData2
              ELSE
                isKey = 0
                kwVal = 0
              END IF

              IF isKey = 1 THEN
                tempPart$ = uIdent$
                tempPartLen = LEN(tempPart$)
                IF tempPartLen > 0 THEN
                  IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                  FOR i2 = 1 TO tempPartLen
                    ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
                  NEXT
                  newLen = newLen + tempPartLen
                END IF
                lastKwVal = kwVal
              ELSE
                ' Is Variable / Label / Sub Call
                IF lastKwVal = TOK_DEF THEN
                  IF UCASE$(LEFT$(ident$, 2)) = "FN" THEN
                    IF LEN(ident$) = 2 THEN
                      ident$ = "FN"
                    ELSE
                      ident$ = "Fn" + MID$(ident$, 3)
                    END IF
                  END IF
                END IF
                lastKwVal = 0

                isVarFound = 0
                foundVarIdx = 0

                refineBaseHash = hashString(uIdent$)
                refineActiveHash = (refineBaseHash + (activeScope * 257)) AND SYMBOL_HASH_MASK
                refineCheckIdx = refineScratchHash(refineActiveHash)

                DO WHILE refineCheckIdx <> -1
                  IF refineScratchScope(refineCheckIdx) = activeScope THEN
                    IF UCASE$(refineScratchName$(refineCheckIdx)) = uIdent$ THEN
                      foundVarIdx = refineCheckIdx
                      isVarFound = 1
                      EXIT DO
                    END IF
                  END IF
                  refineCheckIdx = refineScratchHashNext(refineCheckIdx)
                LOOP

                IF isVarFound = 0 AND activeScope > 0 THEN
                  refineCheckIdx = refineScratchHash(refineBaseHash)

                  DO WHILE refineCheckIdx <> -1
                    IF refineScratchScope(refineCheckIdx) = 0 THEN
                      IF UCASE$(refineScratchName$(refineCheckIdx)) = uIdent$ THEN
                        foundVarIdx = refineCheckIdx
                        isVarFound = 1
                        EXIT DO
                      END IF
                    END IF
                    refineCheckIdx = refineScratchHashNext(refineCheckIdx)
                  LOOP
                END IF

                IF isVarFound = 0 THEN
                  IF isValidLine = 1 THEN
                    IF refCount < MAX_SYMBOLS THEN
                      foundVarIdx = refCount
                      refineScratchName$(foundVarIdx) = ident$
                      refineScratchScope(foundVarIdx) = activeScope
                      refineScratchHashNext(foundVarIdx) = refineScratchHash(refineActiveHash)
                      refineScratchHash(refineActiveHash) = foundVarIdx
                      refCount = refCount + 1
                    END IF
                  END IF
                  tempPart$ = ident$
                ELSE
                  tempPart$ = refineScratchName$(foundVarIdx)
                END IF

                tempPartLen = LEN(tempPart$)
                IF tempPartLen > 0 THEN
                  IF newLen + tempPartLen > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
                  FOR i2 = 1 TO tempPartLen
                    ASC(newRawString, newLen + i2) = ASC(tempPart$, i2)
                  NEXT
                  newLen = newLen + tempPartLen
                END IF
              END IF
            ELSE
              ' Symbol
              IF newLen + 1 > LEN(newRawString) THEN newRawString = newRawString + SPACE$(16384)
              newLen = newLen + 1
              ASC(newRawString, newLen) = cAs

              ix = ix + 1
              lastKwVal = 0

              IF cAs = 40 THEN parenDepth = parenDepth + 1
              IF cAs = 41 THEN parenDepth = parenDepth - 1
            END IF
          END IF
        END IF
      LOOP

      builtLine$ = RTRIM$(LEFT$(newRawString, newLen))
      trimmedLine$ = LTRIM$(builtLine$)
      uTrimmed$ = UCASE$(trimmedLine$)

      IF trimmedLine$ <> "" THEN
        IF LEFT$(uTrimmed$, 4) = "SUB " OR LEFT$(uTrimmed$, 9) = "FUNCTION " THEN
          editorText$(iy) = trimmedLine$
        ELSE
          IF LEFT$(uTrimmed$, 7) = "END SUB" OR LEFT$(uTrimmed$, 12) = "END FUNCTION" THEN
            editorText$(iy) = trimmedLine$
          ELSE
            IF activeScope > 0 THEN
              IF LEFT$(trimmedLine$, 1) = "'" THEN
                editorText$(iy) = builtLine$
              ELSE
                leadingSpaces = 0
                FOR sIdx = 1 TO LEN(builtLine$)
                  IF MID$(builtLine$, sIdx, 1) = " " THEN
                    leadingSpaces = leadingSpaces + 1
                  ELSE
                    EXIT FOR
                  END IF
                NEXT

                IF leadingSpaces < editor.TabSize THEN
                  IF editor.TabSize > 0 THEN
                    editorText$(iy) = SPACE$(editor.TabSize) + trimmedLine$
                  ELSE
                    editorText$(iy) = trimmedLine$
                  END IF
                ELSE
                  editorText$(iy) = builtLine$
                END IF
              END IF
            ELSE
              editorText$(iy) = builtLine$
            END IF
          END IF
        END IF
      ELSE
        editorText$(iy) = ""
      END IF

      ' Only update global UI Sub list safely during a full sweep load to avoid visual glitches
      IF targetLine = 0 THEN
        testSub$ = LTRIM$(editorText$(iy))
        IF LEFT$(testSub$, 4) = "SUB " OR LEFT$(testSub$, 9) = "FUNCTION " THEN
          IF uiSubCount < MAX_UI_SUBS THEN
            IF LEFT$(testSub$, 4) = "SUB " THEN
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 5)))
            ELSE
              sName$ = LTRIM$(RTRIM$(MID$(testSub$, 10)))
            END IF

            cleanName$ = ""
            FOR nameIdx = 1 TO LEN(sName$)
              nameChar = ASC(sName$, nameIdx)
              IF (nameChar >= 65 AND nameChar <= 90) OR (nameChar >= 97 AND nameChar <= 122) OR (nameChar >= 48 AND nameChar <= 57) OR nameChar = 95 OR nameChar = 36 OR nameChar = 35 OR nameChar = 33 OR nameChar = 37 OR nameChar = 38 OR nameChar = 126 THEN
                cleanName$ = cleanName$ + CHR$(nameChar)
              ELSE
                EXIT FOR
              END IF
            NEXT
            sName$ = cleanName$

            uiSubName$(uiSubCount) = sName$
            uiSubLine(uiSubCount) = iy
            uiSubCount = uiSubCount + 1
          ELSE
            throwCompilerError "UI SUB LIMIT EXCEEDED", ASIS, 0
            EXIT SUB
          END IF
        END IF
      END IF

    ELSE
      editorText$(iy) = ""
    END IF

    IF LEFT$(uTemp$, 7) = "END SUB" OR LEFT$(uTemp$, 12) = "END FUNCTION" THEN
      activeScope = 0
    END IF
  NEXT

END SUB ' refineCode

''''''''''''''''''''''''
FUNCTION regClassicImplArrayIndiv (vIdx AS LONG, numDimensions AS LONG)

  DIM totalStaticElems AS _INTEGER64
  DIM staticStride AS _INTEGER64
  DIM implicitElementCount AS LONG
  DIM staticLayoutStart AS LONG

  IF cm.ClassicMode = 0 THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF vIdx < 0 OR vIdx >= symbolCount THEN
    throwCompilerError "INVALID IMPLICIT ARRAY SYMBOL", ASIS, 0
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF numDimensions < 1 OR numDimensions > 255 THEN
    throwCompilerError "INVALID IMPLICIT ARRAY DIMENSION COUNT", ASIS, 0
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
    IF symbols(vIdx).NumDimensions > 0 THEN
      IF symbols(vIdx).NumDimensions <> numDimensions THEN
        throwCompilerError "WRONG NUMBER OF DIMENSIONS", ASIS, 0
        regClassicImplArrayIndiv = 0
        EXIT FUNCTION
      END IF
    END IF

    regClassicImplArrayIndiv = 1
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).SubIndex <> 0 THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  IF symbols(vIdx).IsExplicit <> DECL_IMPLICIT AND symbols(vIdx).IsExplicit <> DECL_QUIET THEN
    regClassicImplArrayIndiv = 0
    EXIT FUNCTION
  END IF

  totalStaticElems = 1
  implicitElementCount = 11 - optionBaseValue

  ' QBASIC creates each implicit array dimension with bounds 0 TO 10
  ' OPTION BASE 1 changes the implicit lower bound while leaving the upper bound at 10
  FOR ii = 1 TO numDimensions
    IF totalStaticElems > PE_SIGNED_LAYOUT_MAX \ implicitElementCount THEN
      throwCompilerError "IMPLICIT ARRAY EXCEEDS STATIC ELEMENT LIMIT", ASIS, 0
      regClassicImplArrayIndiv = 0
      EXIT FUNCTION
    END IF
    totalStaticElems = totalStaticElems * implicitElementCount
  NEXT

  symbols(vIdx).IsArray = ARRAY_KIND_STATIC
  symbols(vIdx).Size = totalStaticElems
  symbols(vIdx).NumDimensions = numDimensions

  staticLayoutStart = retStaticArrayLayoutStart(vIdx, numDimensions)

  IF staticLayoutStart > 0 THEN
    staticStride = 1

    FOR ii = 1 TO numDimensions
      staticArrayDimensions(staticLayoutStart + ii - 1).LowerBound = optionBaseValue
      staticArrayDimensions(staticLayoutStart + ii - 1).ElementCount = implicitElementCount
      staticArrayDimensions(staticLayoutStart + ii - 1).Stride = staticStride

      IF ii < numDimensions THEN staticStride = staticStride * implicitElementCount
    NEXT
  END IF

  regClassicImplArrayIndiv = 1

END FUNCTION ' regClassicImplArrayIndiv

''''''''''''''''''''''''
SUB regClassicImplArrays

  DIM tokenIdx AS LONG
  DIM nameStartIdx AS LONG
  DIM statementStart AS LONG
  DIM statementToken AS LONG
  DIM parenDepth AS LONG
  DIM nameEndIdx AS LONG
  DIM parenStartIdx AS LONG
  DIM parenEndIdx AS LONG
  DIM scanIdx AS LONG
  DIM nestedDepth AS LONG
  DIM numDimensions AS LONG
  DIM vIdx AS LONG
  DIM skipStatement AS LONG
  DIM canStartName AS LONG
  DIM baseIsUdt AS LONG
  DIM isRoutineName AS LONG
  DIM hasSymbol AS LONG
  DIM hasScalarSyntax AS LONG
  DIM preserveBareArray AS LONG
  DIM isDeclarationStatement AS LONG
  DIM isDeclarationName AS LONG
  DIM declarationStartIdx AS LONG
  DIM declarationDepth AS LONG
  DIM declarationIsArray AS LONG
  DIM declarationConflict AS LONG
  DIM declarationUsesAlternate AS LONG
  DIM hasScalarDeclaration AS LONG
  DIM hasArrayDeclaration AS LONG
  DIM arrayDeclarationUsesAlternate AS LONG
  DIM hasGraphicsCommand AS LONG
  DIM graphicsCommandIdx AS LONG
  DIM graphicsCoordStartIdx AS LONG
  DIM graphicsTargetStartIdx AS LONG
  DIM graphicsDepth AS LONG
  DIM firstChar AS STRING * 1
  DIM arrayName$
  DIM implicitArrayName$
  DIM implicitScalarName$
  DIM declarationKey$
  DIM scalarDeclarations$
  DIM alternateScalarDeclarations$
  DIM arrayDeclarations$
  DIM alternateArrayDeclarations$

  IF lineTokenCount = 0 THEN EXIT SUB

  statementStart = 0
  parenDepth = 0
  tokenIdx = 0

  DO WHILE tokenIdx < lineTokenCount
    tVal = lineTokenVals(tokenIdx)

    IF tVal = 256 + ASC(":") AND parenDepth = 0 THEN
      statementStart = tokenIdx + 1
    ELSE
      IF tVal = TOK_OP_LPAREN THEN parenDepth = parenDepth + 1
      IF tVal = TOK_OP_RPAREN THEN
        IF parenDepth > 0 THEN parenDepth = parenDepth - 1
      END IF

      IF tVal = 0 THEN
        canStartName = 1
        IF tokenIdx > statementStart THEN
          IF lineTokenVals(tokenIdx - 1) = 256 + ASC(".") THEN canStartName = 0
        END IF

        firstChar = LEFT$(lineTokens$(tokenIdx), 1)
        IF (firstChar < "A" OR firstChar > "Z") AND (firstChar < "a" OR firstChar > "z") THEN canStartName = 0

        skipStatement = 0
        isDeclarationStatement = 0
        IF statementStart < lineTokenCount THEN
          statementToken = lineTokenVals(statementStart)

          SELECT CASE statementToken

            CASE TOK_DIM, TOK_REDIM, TOK_STATIC_VAR, TOK_COMMON, TOK_GLOBAL
              skipStatement = 1
              isDeclarationStatement = 1

            CASE TOK_DECLARE, TOK_DECLARE_META, TOK_SUB, TOK_FUNCTION
              skipStatement = 1

          END SELECT ' statementToken
        END IF

        isDeclarationName = 0
        IF canStartName = 1 AND isDeclarationStatement = 1 THEN
          declarationStartIdx = statementStart + 1

          IF declarationStartIdx < lineTokenCount THEN
            IF lineTokenVals(declarationStartIdx) = TOK_SHARED THEN declarationStartIdx = declarationStartIdx + 1
          END IF

          declarationDepth = 0
          IF declarationStartIdx < tokenIdx THEN
            FOR scanIdx = declarationStartIdx TO tokenIdx - 1
              IF lineTokenVals(scanIdx) = TOK_OP_LPAREN THEN declarationDepth = declarationDepth + 1
              IF lineTokenVals(scanIdx) = TOK_OP_RPAREN THEN
                IF declarationDepth > 0 THEN declarationDepth = declarationDepth - 1
              END IF
              IF lineTokenVals(scanIdx) = 256 + ASC(",") AND declarationDepth = 0 THEN declarationStartIdx = scanIdx + 1
            NEXT
          END IF

          IF declarationStartIdx = tokenIdx THEN isDeclarationName = 1
        END IF

        IF isDeclarationName = 1 THEN
          nameStartIdx = tokenIdx
          arrayName$ = UCASE$(lineTokens$(tokenIdx))
          nameEndIdx = tokenIdx

          DO WHILE nameEndIdx + 2 < lineTokenCount
            IF lineTokenVals(nameEndIdx + 1) = 256 + ASC(".") AND lineTokenVals(nameEndIdx + 2) = 0 THEN
              arrayName$ = arrayName$ + "." + UCASE$(lineTokens$(nameEndIdx + 2))
              nameEndIdx = nameEndIdx + 2
            ELSE
              EXIT DO
            END IF
          LOOP

          declarationIsArray = 0
          IF statementToken = TOK_REDIM THEN declarationIsArray = 1
          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN declarationIsArray = 1
          END IF

          declarationKey$ = "|" + arrayName$ + "|"
          declarationConflict = 0
          declarationUsesAlternate = 0

          IF findSymbol(arrayName$) THEN
            vIdx = returnedData2
            IF symbols(vIdx).SubIndex = 0 THEN
              IF declarationIsArray = 1 AND symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN declarationConflict = 1
              IF declarationIsArray = 0 AND symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN declarationConflict = 1
            END IF
          END IF

          IF declarationIsArray = 1 THEN
            IF INSTR(scalarDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
            IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
          ELSE
            IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
            IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN declarationConflict = 1
          END IF

          IF declarationConflict = 1 THEN
            IF cm.ClassicMode = 1 THEN
              lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              declarationUsesAlternate = 1
            ELSE
              IF declarationIsArray = 1 THEN
                throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO DECLARE ARRAY " + arrayName$ + "()", ASIS, 0
              ELSE
                throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO DECLARE SCALAR " + arrayName$, ASIS, 0
              END IF
              EXIT SUB
            END IF
          END IF

          IF declarationIsArray = 1 THEN
            IF declarationUsesAlternate = 1 THEN
              alternateArrayDeclarations$ = alternateArrayDeclarations$ + declarationKey$
            ELSE
              arrayDeclarations$ = arrayDeclarations$ + declarationKey$
            END IF
          ELSE
            IF declarationUsesAlternate = 1 THEN
              alternateScalarDeclarations$ = alternateScalarDeclarations$ + declarationKey$
            ELSE
              scalarDeclarations$ = scalarDeclarations$ + declarationKey$
            END IF
          END IF

          tokenIdx = nameEndIdx
          canStartName = 0
        END IF

        ' Array dimension bounds remain ordinary expression syntax
        IF isDeclarationStatement = 1 AND isDeclarationName = 0 THEN
          IF parenDepth > 0 THEN skipStatement = 0
        END IF

        IF canStartName = 1 AND skipStatement = 0 THEN
          nameStartIdx = tokenIdx
          arrayName$ = UCASE$(lineTokens$(tokenIdx))
          nameEndIdx = tokenIdx

          DO WHILE nameEndIdx + 2 < lineTokenCount
            IF lineTokenVals(nameEndIdx + 1) = 256 + ASC(".") AND lineTokenVals(nameEndIdx + 2) = 0 THEN
              baseIsUdt = 0
              IF findSymbol(arrayName$) THEN
                IF symbols(returnedData2).DataType = TYPE_UDT THEN baseIsUdt = 1
              END IF

              IF baseIsUdt = 1 THEN
                EXIT DO
              ELSE
                arrayName$ = arrayName$ + "." + UCASE$(lineTokens$(nameEndIdx + 2))
                nameEndIdx = nameEndIdx + 2
              END IF
            ELSE
              EXIT DO
            END IF
          LOOP

          tokenIdx = nameEndIdx
          declarationKey$ = "|" + arrayName$ + "|"

          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN
              parenStartIdx = nameEndIdx + 1
              ff = findMatchingParen(parenStartIdx, lineTokenCount - 1)
              IF ff = 0 THEN EXIT SUB
              parenEndIdx = returnedData2

              numDimensions = 0
              IF parenEndIdx > parenStartIdx + 1 THEN
                numDimensions = 1
                nestedDepth = 0

                FOR scanIdx = parenStartIdx + 1 TO parenEndIdx - 1
                  SELECT CASE lineTokenVals(scanIdx)

                    CASE TOK_OP_LPAREN
                      nestedDepth = nestedDepth + 1

                    CASE TOK_OP_RPAREN
                      IF nestedDepth > 0 THEN nestedDepth = nestedDepth - 1

                    CASE 256 + ASC(",")
                      IF nestedDepth = 0 THEN numDimensions = numDimensions + 1

                  END SELECT ' lineTokenVals(scanIdx)
                NEXT
              END IF

              vIdx = 0
              isRoutineName = 0
              hasSymbol = 0

              IF findSubIndexCanonical(arrayName$) THEN isRoutineName = 1

              IF isRoutineName = 0 THEN
                IF findSymbol(arrayName$) THEN
                  vIdx = returnedData2
                  hasSymbol = 1
                END IF

                hasScalarDeclaration = 0
                hasArrayDeclaration = 0
                arrayDeclarationUsesAlternate = 0

                IF INSTR(scalarDeclarations$, declarationKey$) > 0 THEN hasScalarDeclaration = 1
                IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN hasScalarDeclaration = 1
                IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN hasArrayDeclaration = 1
                IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN
                  hasArrayDeclaration = 1
                  arrayDeclarationUsesAlternate = 1
                END IF

                IF hasArrayDeclaration = 1 THEN
                  IF cm.ClassicMode = 1 THEN
                    IF arrayDeclarationUsesAlternate = 1 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                  END IF
                ELSE
                  IF numDimensions > 0 THEN
                    IF hasSymbol = 0 OR symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
                      IF cm.ClassicMode = 1 THEN
                        ' Keep CLASSIC scalar and array namespaces separate while preserving the source type suffix
                        lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                        implicitArrayName$ = UCASE$(lineTokens$(nameStartIdx))

                        IF nameEndIdx > nameStartIdx THEN
                          FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                            implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                          NEXT
                        END IF

                        expectedSymType = TYPE_ANY
                        ff = resolveSymbol(implicitArrayName$)
                        IF ff = 0 THEN EXIT SUB
                        vIdx = returnedData2
                        hasSymbol = 1
                      ELSE
                        IF hasSymbol = 1 OR hasScalarDeclaration = 1 THEN
                          throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + arrayName$ + "()", ASIS, 0
                        ELSE
                          throwCompilerError "UNDECLARED ARRAY " + arrayName$ + "()", ASIS, 0
                        END IF
                        EXIT SUB
                      END IF
                    END IF

                    IF cm.ClassicMode = 1 THEN
                      ff = regClassicImplArrayIndiv(vIdx, numDimensions)
                      IF compileError = 1 THEN EXIT SUB
                    END IF
                  ELSE
                    IF hasSymbol = 0 OR symbols(vIdx).IsArray = ARRAY_KIND_NONE THEN
                      implicitArrayName$ = UCASE$(retClassicImplicitArrayName$(lineTokens$(nameStartIdx)))

                      IF nameEndIdx > nameStartIdx THEN
                        FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                          implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                        NEXT
                      END IF

                      IF cm.ClassicMode = 1 THEN
                        IF findSymbol(implicitArrayName$) THEN
                          vIdx = returnedData2
                          IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                        END IF
                      ELSE
                        IF hasSymbol = 1 OR hasScalarDeclaration = 1 THEN
                          throwCompilerError "NAME CLASH: SCALAR " + arrayName$ + " ALREADY EXISTS; CANNOT ALSO USE ARRAY " + arrayName$ + "()", ASIS, 0
                        ELSE
                          throwCompilerError "UNDECLARED ARRAY " + arrayName$ + "()", ASIS, 0
                        END IF
                        EXIT SUB
                      END IF
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF

          ' QBASIC keeps a simple scalar and an array with the same source name in separate namespaces
          ' If the ordinary symbol is already an array, route a bare occurrence through the alternate CLASSIC name
          hasScalarSyntax = 1
          IF nameEndIdx + 1 < lineTokenCount THEN
            IF lineTokenVals(nameEndIdx + 1) = TOK_OP_LPAREN THEN hasScalarSyntax = 0
          END IF

          ' LBOUND and UBOUND take a bare array name, so those operands must retain the array namespace
          preserveBareArray = 0
          IF nameStartIdx >= 2 THEN
            IF lineTokenVals(nameStartIdx - 1) = TOK_OP_LPAREN THEN
              IF lineTokenVals(nameStartIdx - 2) = TOK_LBOUND OR lineTokenVals(nameStartIdx - 2) = TOK_UBOUND THEN preserveBareArray = 1
            END IF
          END IF

          ' Graphics GET and PUT also take a bare array name after their coordinate arguments
          IF preserveBareArray = 0 THEN
            hasGraphicsCommand = 0
            IF nameStartIdx > statementStart THEN
              FOR scanIdx = nameStartIdx - 1 TO statementStart STEP -1
                IF lineTokenVals(scanIdx) = TOK_GET OR lineTokenVals(scanIdx) = TOK_PUT THEN
                  graphicsCommandIdx = scanIdx
                  hasGraphicsCommand = 1
                  EXIT FOR
                END IF
              NEXT
            END IF

            IF hasGraphicsCommand = 1 THEN
              graphicsCoordStartIdx = graphicsCommandIdx + 1
              IF graphicsCoordStartIdx < lineTokenCount THEN
                IF lineTokenVals(graphicsCoordStartIdx) = TOK_STEP THEN graphicsCoordStartIdx = graphicsCoordStartIdx + 1
              END IF

              IF graphicsCoordStartIdx < nameStartIdx THEN
                IF lineTokenVals(graphicsCoordStartIdx) = TOK_OP_LPAREN THEN
                  graphicsTargetStartIdx = 0
                  graphicsDepth = 0

                  FOR scanIdx = graphicsCoordStartIdx TO nameStartIdx - 1
                    SELECT CASE lineTokenVals(scanIdx)

                      CASE TOK_OP_LPAREN
                        graphicsDepth = graphicsDepth + 1

                      CASE TOK_OP_RPAREN
                        IF graphicsDepth > 0 THEN graphicsDepth = graphicsDepth - 1

                      CASE 256 + ASC(",")
                        IF graphicsDepth = 0 THEN graphicsTargetStartIdx = scanIdx + 1

                    END SELECT ' lineTokenVals(scanIdx)
                  NEXT

                  IF graphicsTargetStartIdx = nameStartIdx THEN preserveBareArray = 1
                END IF
              END IF
            END IF
          END IF

          IF preserveBareArray = 1 AND cm.ClassicMode = 1 THEN
            hasSymbol = 0
            IF findSymbol(arrayName$) THEN
              vIdx = returnedData2
              IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN hasSymbol = 1
            END IF

            IF hasSymbol = 0 THEN
              implicitArrayName$ = UCASE$(retClassicImplicitArrayName$(lineTokens$(nameStartIdx)))

              IF nameEndIdx > nameStartIdx THEN
                FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                  implicitArrayName$ = implicitArrayName$ + retTokenText$(lineTokens$(scanIdx))
                NEXT
              END IF

              IF findSymbol(implicitArrayName$) THEN
                vIdx = returnedData2
                IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              END IF

              IF INSTR(alternateArrayDeclarations$, declarationKey$) > 0 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
            END IF
          END IF

          IF hasScalarSyntax = 1 AND preserveBareArray = 0 THEN
            IF findSymbol(arrayName$) THEN
              vIdx = returnedData2

              IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
                IF cm.ClassicMode = 1 THEN
                  lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                  implicitScalarName$ = UCASE$(lineTokens$(nameStartIdx))

                  IF nameEndIdx > nameStartIdx THEN
                    FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                      implicitScalarName$ = implicitScalarName$ + retTokenText$(lineTokens$(scanIdx))
                    NEXT
                  END IF

                  expectedSymType = TYPE_ANY
                  ff = resolveSymbol(implicitScalarName$)
                  IF ff = 0 THEN EXIT SUB

                  vIdx = returnedData2
                  IF symbols(vIdx).IsArray > ARRAY_KIND_NONE THEN
                    throwCompilerError "CLASSIC SCALAR NAMESPACE CLASH", ASIS, 0
                    EXIT SUB
                  END IF
                ELSE
                  throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + arrayName$, ASIS, 0
                  EXIT SUB
                END IF
              END IF
            ELSE
              IF INSTR(alternateScalarDeclarations$, declarationKey$) > 0 THEN
                IF cm.ClassicMode = 1 THEN lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
              ELSE
                IF INSTR(scalarDeclarations$, declarationKey$) = 0 THEN
                  IF INSTR(arrayDeclarations$, declarationKey$) > 0 THEN
                    IF cm.ClassicMode = 1 THEN
                      lineTokens$(nameStartIdx) = retClassicImplicitArrayName$(lineTokens$(nameStartIdx))
                      implicitScalarName$ = UCASE$(lineTokens$(nameStartIdx))

                      IF nameEndIdx > nameStartIdx THEN
                        FOR scanIdx = nameStartIdx + 1 TO nameEndIdx
                          implicitScalarName$ = implicitScalarName$ + retTokenText$(lineTokens$(scanIdx))
                        NEXT
                      END IF

                      expectedSymType = TYPE_ANY
                      ff = resolveSymbol(implicitScalarName$)
                      IF ff = 0 THEN EXIT SUB
                    ELSE
                      throwCompilerError "NAME CLASH: ARRAY " + arrayName$ + "() ALREADY EXISTS; CANNOT ALSO USE SCALAR " + arrayName$, ASIS, 0
                      EXIT SUB
                    END IF
                  END IF
                END IF
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF

    tokenIdx = tokenIdx + 1
  LOOP

END SUB ' regClassicImplArrays

''''''''''''''''''''''''
FUNCTION resolveSymbol (vName$)

  returnExtraPrepare

  DIM dType AS LONG
  DIM vIdx AS LONG
  DIM isExp AS LONG
  DIM charIdx AS LONG
  DIM conflictIdx AS LONG
  DIM roleStr$
  DIM secondChar$
  DIM isInternal AS LONG
  DIM isGlobalInternal AS LONG
  DIM isTempInternal AS LONG
  DIM searchName$

  searchName$ = UCASE$(vName$)

  IF LEN(searchName$) > 64 THEN
    throwCompilerError "ERROR: IDENTIFIER EXCEEDS 64 CHARACTER LIMIT", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 -1
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  IF searchName$ = "" THEN
    throwCompilerError "EXPECTED IDENTIFIER", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 -1
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  firstChar$ = LEFT$(searchName$, 1)

  IF firstChar$ = "_" THEN
    throwCompilerError "IDENTIFIERS CANNOT START WITH _", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 -1
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  isInternal = 0
  isGlobalInternal = 0
  isTempInternal = 0

  IF firstChar$ = "!" THEN
    isInternal = 1
    secondChar$ = MID$(searchName$, 2, 1)

    IF secondChar$ <> "G" AND secondChar$ <> "C" AND secondChar$ <> "T" AND secondChar$ <> "R" THEN
      throwCompilerError "INTERNAL VARIABLE MUST START WITH !G, !C, !T, OR !R IN " + searchName$, ASIS, 0
      return3 TYPE_UNDEFINED
      return2 -1
      resolveSymbol = 0
      EXIT FUNCTION
    END IF

    IF secondChar$ = "G" OR secondChar$ = "C" OR secondChar$ = "R" THEN
      IF MID$(searchName$, 3, 1) <> "_" THEN
        throwCompilerError "INTERNAL VARIABLE MUST HAVE _ AT POS 3 IN " + searchName$, ASIS, 0
        return3 TYPE_UNDEFINED
        return2 -1
        resolveSymbol = 0
        EXIT FUNCTION
      END IF
    END IF

    IF secondChar$ = "G" OR secondChar$ = "C" THEN
      isGlobalInternal = 1
    END IF

    IF secondChar$ = "T" THEN
      isTempInternal = 1
    END IF

    lastChar$ = RIGHT$(searchName$, 1)
    IF lastChar$ = "$" OR lastChar$ = "#" OR lastChar$ = "!" OR lastChar$ = "%" OR lastChar$ = "&" OR lastChar$ = "~" THEN
      ESCAPETEXT2 "FATAL in resolveSymbol", "Internal variable " + searchName$ + " cannot use legacy type suffix '" + lastChar$ + "'."
    END IF
  END IF

  IF findSymbolCanonical(searchName$) THEN
    vIdx = returnedData2
    return3 symbols(vIdx).DataType
    return2 vIdx
    resolveSymbol = 1
    EXIT FUNCTION
  END IF

  dType = TYPE_SINGLE
  isExp = DECL_IMPLICIT

  IF isInternal = 1 THEN
    isExp = DECL_EXPLICIT

    dType = TYPE_UNDEFINED

    IF isGlobalInternal = 1 THEN
      IF LEN(searchName$) >= 12 THEN
        roleStr$ = MID$(searchName$, 8, 4)

        SELECT CASE roleStr$

          CASE "DSC_", "PTR_", "IDX_", "FLG_", "VAL_", "V32_", "ARR_", "UDT_"
            dType = TYPE_INTEGER64
            IF roleStr$ = "DSC_" THEN dType = TYPE_STRING
            IF roleStr$ = "IDX_" OR roleStr$ = "FLG_" OR roleStr$ = "V32_" THEN dType = TYPE_LONG
            IF roleStr$ = "UDT_" THEN dType = TYPE_UDT
          CASE ELSE
            throwCompilerError "UNKNOWN HARDWARE ROLE IN INTERNAL VARIABLE " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 -1
            resolveSymbol = 0
            EXIT FUNCTION

        END SELECT ' roleStr$

        IF MID$(searchName$, 12, 1) = "_" THEN
          throwCompilerError "NAME SEGMENT CANNOT START WITH UNDERSCORE IN " + searchName$, ASIS, 0
          return3 TYPE_UNDEFINED
          return2 -1
          resolveSymbol = 0
          EXIT FUNCTION
        END IF

        IF LEN(searchName$) >= 13 THEN
          IF MID$(searchName$, 13, 1) = "_" THEN
            throwCompilerError "NAME SEGMENT CANNOT HAVE UNDERSCORE AT SECOND CHARACTER IN " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 -1
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        END IF

      ELSE
        throwCompilerError "GLOBAL INTERNAL MISSING NAME SEGMENT IN " + searchName$, ASIS, 0
        return3 TYPE_UNDEFINED
        return2 -1
        resolveSymbol = 0
        EXIT FUNCTION
      END IF
    ELSE
      dType = TYPE_INTEGER64
    END IF
  ELSE
    IF firstChar$ = "%" OR firstChar$ = "@" THEN
      dType = TYPE_LABEL
      isExp = DECL_EXPLICIT
    ELSE
      charIdx = ASC(firstChar$) - 65
      IF charIdx >= 0 AND charIdx <= 25 THEN
        IF defIntMap(charIdx) = 1 THEN dType = TYPE_INTEGER
      END IF
    END IF
  END IF

  suffix$ = ""
  lastTwo$ = RIGHT$(searchName$, 2)
  IF lastTwo$ = "&&" THEN
    dType = TYPE_INTEGER64
    suffix$ = "&&"
  ELSE
    IF lastTwo$ = "~&" THEN
      dType = TYPE_ULONG
      suffix$ = "~&"
    ELSE
      suffix$ = RIGHT$(searchName$, 1)
      SELECT CASE suffix$

        CASE "$"
          dType = TYPE_STRING

        CASE "#"
          dType = TYPE_DOUBLE

        CASE "!"
          dType = TYPE_SINGLE

        CASE "&"
          dType = TYPE_LONG

        CASE "%"
          dType = TYPE_INTEGER

        CASE "~"
          dType = TYPE_ULONG

        CASE ELSE
          suffix$ = ""
          IF expectedSymType <> TYPE_ANY AND isExp = DECL_IMPLICIT THEN
            dType = expectedSymType
          END IF

      END SELECT ' suffix$
    END IF
  END IF

  IF suffix$ = "$" THEN
    baseName$ = LEFT$(searchName$, LEN(searchName$) - 1)
    IF findSymbolCanonical(baseName$) THEN
      conflictIdx = returnedData2
      existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

      IF cm.ClassicMode = 1 THEN
        IF symbols(conflictIdx).DataType = TYPE_STRING THEN
          return3 TYPE_STRING
          return2 conflictIdx
          resolveSymbol = 1
          EXIT FUNCTION
        END IF
      ELSE
        IF cm.StringStrict = 0 THEN
          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
            return3 TYPE_STRING
            return2 conflictIdx
            resolveSymbol = 1
            EXIT FUNCTION
          ELSE
            throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            return3 TYPE_UNDEFINED
            return2 -1
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        ELSE
          IF symbols(conflictIdx).DataType = TYPE_STRING THEN
            throwCompilerError "NAME CLASH: UNSUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
          ELSE
            throwCompilerError "NNAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
          END IF
          return3 TYPE_UNDEFINED
          return2 -1
          resolveSymbol = 0
          EXIT FUNCTION
        END IF
      END IF
    END IF
  ELSE
    IF suffix$ = "" THEN
      IF findSymbolCanonical(searchName$ + "$") THEN
        conflictIdx = returnedData2
        existingName$ = RTRIM$(symbols(conflictIdx).RecordName)

        IF cm.ClassicMode = 0 THEN
          IF cm.StringStrict = 0 THEN
            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
              return3 TYPE_STRING
              return2 conflictIdx
              resolveSymbol = 1
              EXIT FUNCTION
            ELSE
              throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
              return3 TYPE_UNDEFINED
              return2 -1
              resolveSymbol = 0
              EXIT FUNCTION
            END IF
          ELSE
            IF symbols(conflictIdx).DataType = TYPE_STRING THEN
              throwCompilerError "NAME CLASH: SUFFIXED STRING VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            ELSE
              throwCompilerError "NAME CLASH: NUMERIC VERSION " + existingName$ + " ALREADY EXISTS; CANNOT ALSO USE " + searchName$, ASIS, 0
            END IF
            return3 TYPE_UNDEFINED
            return2 -1
            resolveSymbol = 0
            EXIT FUNCTION
          END IF
        END IF
      END IF
    END IF
  END IF

  IF symbolCount >= MAX_SYMBOLS THEN
    throwCompilerError "SYMBOL LIMIT", ASIS, 0
    return3 TYPE_UNDEFINED
    return2 -1
    resolveSymbol = 0
    EXIT FUNCTION
  END IF

  vIdx = symbolCount
  symbols(vIdx).RecordName = searchName$
  symbols(vIdx).DataType = dType
  symbols(vIdx).ScopeID = currentScopeID
  IF secondChar$ = "G" THEN symbols(vIdx).ScopeID = 0
  symbols(vIdx).IsShared = 0
  symbols(vIdx).IsArray = 0
  symbols(vIdx).Size = 1
  symbols(vIdx).NumDimensions = 0
  symbols(vIdx).Offset = 0
  symbols(vIdx).SubIndex = 0
  symbols(vIdx).UDTIndex = -1
  symbols(vIdx).IsExplicit = isExp
  symbols(vIdx).alreadyParsed = 0

  symbols(vIdx).IsLocal = LOCAL_GLOBAL

  IF currentScopeID > 0 THEN
    IF isGlobalInternal = 0 AND firstChar$ <> "%" AND firstChar$ <> "@" THEN
      symbols(vIdx).IsLocal = LOCAL_STANDARD
    END IF
  END IF

  symbols(vIdx).LocalOffset = 0
  symbols(vIdx).DescOffset = 0
  symbols(vIdx).StrOffset = 0
  symbols(vIdx).FixedStrLen = 0

  ' Map the new symbol into the hash table for future lookups
  symbolCount = symbolCount + 1
  indexSymbol vIdx

  return3 dType
  return2 vIdx
  resolveSymbol = 1

END FUNCTION ' resolveSymbol

''''''''''''''''''''''''
FUNCTION retByRefTypeCompatible (sourceType AS LONG, targetType AS LONG)

  compatible = 0

  IF sourceType = targetType THEN
    compatible = 1
  ELSE
    SELECT CASE sourceType

      CASE TYPE_BYTE
        IF targetType = TYPE_UBYTE THEN compatible = 1

      CASE TYPE_UBYTE
        IF targetType = TYPE_BYTE THEN compatible = 1

      CASE TYPE_INTEGER
        IF targetType = TYPE_UINTEGER THEN compatible = 1

      CASE TYPE_UINTEGER
        IF targetType = TYPE_INTEGER THEN compatible = 1

      CASE TYPE_LONG
        IF targetType = TYPE_ULONG THEN compatible = 1

      CASE TYPE_ULONG
        IF targetType = TYPE_LONG THEN compatible = 1

      CASE TYPE_INTEGER64
        IF targetType = TYPE_UINT64 THEN compatible = 1

      CASE TYPE_UINT64
        IF targetType = TYPE_INTEGER64 THEN compatible = 1

    END SELECT ' sourceType
  END IF

  retByRefTypeCompatible = compatible

END FUNCTION ' retByRefTypeCompatible

''''''''''''''''''''''''
FUNCTION retClassicImplicitArrayName$ (sourceName$)

  DIM baseName$
  DIM suffix$
  DIM lastChar$

  baseName$ = UCASE$(sourceName$)
  suffix$ = ""

  IF RIGHT$(baseName$, 2) = "~&" THEN
    suffix$ = "~&"
    baseName$ = LEFT$(baseName$, LEN(baseName$) - 2)
  ELSE
    lastChar$ = RIGHT$(baseName$, 1)

    SELECT CASE lastChar$

      CASE "$", "#", "!", "&", "%", "~"
        suffix$ = lastChar$
        baseName$ = LEFT$(baseName$, LEN(baseName$) - 1)

    END SELECT ' lastChar$
  END IF

  retClassicImplicitArrayName$ = baseName$ + "@" + suffix$

END FUNCTION ' retClassicImplicitArrayName$

''''''''''''''''''''''''
FUNCTION retCoordinateBoundaries (passStartIdx, passEndIdx)

  returnExtraPrepare

  DIM tempStart AS LONG
  DIM tempEnd AS LONG
  DIM cPos AS LONG

  tempStart = passStartIdx
  tempEnd = passEndIdx

  ' Strip surrounding parentheses if they exist to isolate the coordinate arguments
  IF lineTokenVals(tempStart) = 256 + ASC("(") THEN
    IF lineTokenVals(tempEnd) = 256 + ASC(")") THEN
      tempStart = tempStart + 1
      tempEnd = tempEnd - 1
    END IF
  END IF

  cPos = findComma(tempStart, tempEnd)

  return3 tempEnd
  return2 tempStart

  retCoordinateBoundaries = cPos

END FUNCTION ' retCoordinateBoundaries

''''''''''''''''''''''''
FUNCTION retEditorSelection$

  IF editor.SelectStartY < editor.CursorY OR (editor.SelectStartY = editor.CursorY AND editor.SelectStartX < editor.CursorX) THEN
    startY = editor.SelectStartY
    startX = editor.SelectStartX
    endY = editor.CursorY
    endX = editor.CursorX
  ELSE
    startY = editor.CursorY
    startX = editor.CursorX
    endY = editor.SelectStartY
    endX = editor.SelectStartX
  END IF

  IF startY = endY AND startX = endX THEN
    retEditorSelection$ = editorText$(editor.CursorY)
    EXIT FUNCTION
  END IF

  totalLen = 0
  FOR iy = startY TO endY
    curLine$ = editorText$(iy)
    IF startY = endY THEN
      totalLen = totalLen + (endX - startX)
    ELSE
      IF iy = startY THEN
        totalLen = totalLen + LEN(MID$(curLine$, startX + 1)) + 2
      ELSE
        IF iy = endY THEN
          totalLen = totalLen + endX
        ELSE
          totalLen = totalLen + LEN(curLine$) + 2
        END IF
      END IF
    END IF
  NEXT

  IF totalLen <= 0 THEN
    retEditorSelection$ = ""
    EXIT FUNCTION
  END IF

  outStr$ = SPACE$(totalLen)
  writePos = 1

  FOR iy = startY TO endY
    curLine$ = editorText$(iy)
    partStr$ = ""

    IF startY = endY THEN
      partStr$ = MID$(curLine$, startX + 1, endX - startX)
    ELSE
      IF iy = startY THEN
        partStr$ = MID$(curLine$, startX + 1) + CHR$(13) + CHR$(10)
      ELSE
        IF iy = endY THEN
          partStr$ = LEFT$(curLine$, endX)
        ELSE
          partStr$ = curLine$ + CHR$(13) + CHR$(10)
        END IF
      END IF
    END IF

    partLen = LEN(partStr$)
    IF partLen > 0 THEN
      MID$(outStr$, writePos, partLen) = partStr$
      writePos = writePos + partLen
    END IF
  NEXT

  retEditorSelection$ = outStr$

END FUNCTION ' retEditorSelection$

''''''''''''''''''''''''
FUNCTION retElementByteSize (vIdx)

  DIM dt AS LONG
  DIM elemSize AS LONG
  DIM fixedLen AS LONG
  DIM uIdx AS LONG

  dt = symbols(vIdx).DataType
  elemSize = 8

  SELECT CASE dt

    CASE TYPE_BYTE, TYPE_UBYTE: elemSize = 1
    CASE TYPE_INTEGER, TYPE_UINTEGER: elemSize = 2
    CASE TYPE_LONG, TYPE_ULONG, TYPE_SINGLE: elemSize = 4
    CASE TYPE_INTEGER64, TYPE_UINT64, TYPE_DOUBLE: elemSize = 8
    CASE TYPE_STRING
      fixedLen = retFixeSTRINGDLength(vIdx)
      IF fixedLen > 0 THEN
        elemSize = fixedLen
      ELSE
        elemSize = 8
      END IF
    CASE TYPE_UDT
      uIdx = symbols(vIdx).UDTIndex
      IF uIdx >= 0 THEN
        elemSize = udts(uIdx).TotalSize
      ELSE
        elemSize = 8
      END IF

  END SELECT ' dt

  retElementByteSize = elemSize

END FUNCTION ' retElementByteSize

''''''''''''''''''''''''
FUNCTION retFixeSTRINGDLength (vIdx)

  retFixeSTRINGDLength = symbols(vIdx).FixedStrLen

END FUNCTION ' retFixeSTRINGDLength

''''''''''''''''''''''''
FUNCTION retIatConstByName (wName$, isTira)

  tempRet = IAT_INVALID

  IF isTira = 1 THEN

    SELECT CASE wName$

      CASE "IAT_GETSTDHANDLE": tempRet = IAT_GETSTDHANDLE
      CASE "IAT_WRITEFILE": tempRet = IAT_WRITEFILE
      CASE "IAT_READFILE": tempRet = IAT_READFILE
      CASE "IAT_EXITPROCESS": tempRet = IAT_EXITPROCESS
      CASE "IAT_GETMODULEHANDLEA": tempRet = IAT_GETMODULEHANDLEA
      CASE "IAT_GETMODULEFILENAMEA": tempRet = IAT_GETMODULEFILENAMEA
      CASE "IAT_SETCONSOLEMODE": tempRet = IAT_SETCONSOLEMODE
      CASE "IAT_DEFWINDOWPROCA": tempRet = IAT_DEFWINDOWPROCA
      CASE "IAT_REGISTERCLASSEXA": tempRet = IAT_REGISTERCLASSEXA
      CASE "IAT_CREATEWINDOWEXA": tempRet = IAT_CREATEWINDOWEXA
      CASE "IAT_SHOWWINDOW": tempRet = IAT_SHOWWINDOW
      CASE "IAT_PEEKMESSAGEA": tempRet = IAT_PEEKMESSAGEA
      CASE "IAT_TRANSLATEMESSAGE": tempRet = IAT_TRANSLATEMESSAGE
      CASE "IAT_DISPATCHMESSAGEA": tempRet = IAT_DISPATCHMESSAGEA
      CASE "IAT_POSTQUITMESSAGE": tempRet = IAT_POSTQUITMESSAGE
      CASE "IAT_ADDVECTOREDEXCEPTIONHANDLER": tempRet = IAT_ADDVECTOREDEXCEPTIONHANDLER
      CASE "IAT_ADJUSTWINDOWRECTEX": tempRet = IAT_ADJUSTWINDOWRECTEX
      CASE "IAT_ATAN": tempRet = IAT_ATAN
      CASE "IAT_BEEP": tempRet = IAT_BEEP
      CASE "IAT_BEGINPAINT": tempRet = IAT_BEGINPAINT
