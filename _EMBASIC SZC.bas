'' SUB returnExtraPrepare ' This is found within Z_EMLINF.BLB
'
' Clears out returnF2data and returnF3data. Use at the top of any function that uses return2 or return3 process

''''''''''''''
'' SUB ZLOCATE (wX, wY) ' This is found within Z_EMLINF.BLB
'
' Effectively a LOCATE that starts at 0, 0, instead of 1, 1,

SUB ESCAPE (wVal)

  wStr3$ = " ($" + hexLen$(wVal, 2) + ")"
  wStr2$ = STR$(wVal)
  wStr$ = "PROGRAM ENDED WITH CODE:" + LTRIM$(wStr2$) + wStr3$
  ESCAPETEXT wStr$

END SUB ' ESCAPE

''''''''''''''''''''''''
SUB ESCAPE2 (wVal1, wVal2)

  wStr1$ = STR$(wVal1)
  wStr2$ = STR$(wVal2)

  wStr$ = "PROGRAM ENDED WITH CODES:" + LTRIM$(RTRIM$(wStr1$)) + "," + LTRIM$(RTRIM$(wStr2$)) + "  "

  ESCAPETEXT wStr$

END SUB ' ESCAPE2

