''''''''''''''''''''''''
FUNCTION tiraAllocTempMem$ (sizeStr$)

  tiraCheckActive ("tiraAllocTempMem$")

  DIM osPtrIdx AS LONG

  paddedSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, paddedSize$, sizeStr$, "7"
  tiraOp TC_AND, paddedSize$, paddedSize$, "-8"

  dataPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraAssign dataPtr$, "!G_MEM_PTR_TEMP_HEAP"
  tiraOp TC_SUB, dataPtr$, dataPtr$, paddedSize$

  skipUnderflowLbl$ = tiraLabelCreateNew$("TEMP_HEAP_OK")
  tiraJmpCond "JGE", dataPtr$, "!G_MEM_PTR_TEMP_BASE", skipUnderflowLbl$

  ' Fallback: Allocate from OS Heap (paddedSize + 8) directly to prevent overflow
  allocSize$ = tiraDimVar$("T", TYPE_INTEGER64)
  tiraOp TC_ADD, allocSize$, paddedSize$, "8"

  tiraCall "IAT_HEAPALLOC", 3, "!G_MEM_PTR_PROCESS_HEAP, 8, " + allocSize$
  osPtr$ = tiraDimVar$("T", TYPE_INTEGER64)
  osPtrIdx = returnedData2
  tiraGetRetId osPtrIdx

  skipOomLbl$ = tiraLabelCreateNew$("SPILL_OOM_SKIP")
  tiraJmpCond "JNE", osPtr$, "0", skipOomLbl$
  tiraFatalError "TEMPORARY HEAP OUT OF MEMORY"
  tiraLabel skipOomLbl$

  ' Link the massive OS allocation directly into the current execution scope's spill list
  tiraWriteMem osPtr$, "!G_MEM_PTR_SPILL_HEAD", "8"
  tiraAssign "!G_MEM_PTR_SPILL_HEAD", osPtr$

  tiraOp TC_ADD, dataPtr$, osPtr$, "8"

  skipUpdateLbl$ = tiraLabelCreateNew$("SKIP_HEAP_UPDATE")
  tiraJmp skipUpdateLbl$

  tiraLabel skipUnderflowLbl$
  tiraAssign "!G_MEM_PTR_TEMP_HEAP", dataPtr$
  tiraLabel skipUpdateLbl$

  ' Zero out the allocated memory block to prevent stale data contamination
  tiraMemSet dataPtr$, "0", paddedSize$

  tiraAllocTempMem$ = dataPtr$

END FUNCTION ' tiraAllocTempMem$

''''''''''''''''''''''''
FUNCTION tiraAllocTempMemId& (sizeType AS LONG, sizeVal AS _INTEGER64)

  tiraCheckActive ("tiraAllocTempMemId&")

  DIM paddedSizeIdx AS LONG
  DIM dataPtrIdx AS LONG
  DIM skipUnderflowLblIdx AS LONG
  DIM allocSizeIdx AS LONG
  DIM osPtrIdx AS LONG
  DIM skipOomLblIdx AS LONG
  DIM skipUpdateLblIdx AS LONG
  DIM tempHeapIdx AS LONG
  DIM tempBaseIdx AS LONG
  DIM processHeapIdx AS LONG
  DIM spillHeadIdx AS LONG
  DIM heapAllocIdx AS LONG

  ff = resolveSymbol("!G_MEM_PTR_TEMP_HEAP")
  tempHeapIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_TEMP_BASE")
  tempBaseIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_PROCESS_HEAP")
  processHeapIdx = returnedData2

  ff = resolveSymbol("!G_MEM_PTR_SPILL_HEAD")
  spillHeadIdx = returnedData2

  ff = resolveSymbol("IAT_HEAPALLOC")
  heapAllocIdx = returnedData2

  paddedSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, paddedSizeIdx, sizeType, sizeVal, TIRA_ARG_LITERAL, 7
  tiraOpId3 TC_AND, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_LITERAL, -8

  dataPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraAssignId dataPtrIdx, TIRA_ARG_SYMBOL, tempHeapIdx
  tiraOpId3 TC_SUB, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, paddedSizeIdx

  skipUnderflowLblIdx = tiraLabelCreateNewId&("TEMP_HEAP_OK")
  tiraJmpCondId JCC_JGE, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, tempBaseIdx, skipUnderflowLblIdx

  ' Fallback: Allocate from OS Heap (paddedSize + 8) directly to prevent overflow
  allocSizeIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, allocSizeIdx, TIRA_ARG_SYMBOL, paddedSizeIdx, TIRA_ARG_LITERAL, 8

  tiraCallId3 heapAllocIdx, TIRA_ARG_SYMBOL, processHeapIdx, TIRA_ARG_LITERAL, 8, TIRA_ARG_SYMBOL, allocSizeIdx
  osPtrIdx = tiraDimVarId&("T", TYPE_INTEGER64)
  tiraGetRetId osPtrIdx

  skipOomLblIdx = tiraLabelCreateNewId&("SPILL_OOM_SKIP")
  tiraJmpCondId JCC_JNE, TIRA_ARG_SYMBOL, osPtrIdx, TIRA_ARG_LITERAL, 0, skipOomLblIdx
  tiraFatalErrorId "TEMPORARY HEAP OUT OF MEMORY"
  tiraLabelId skipOomLblIdx

  ' Link the massive OS allocation directly into the current execution scope's spill list
  tiraWriteMemId TIRA_ARG_SYMBOL, osPtrIdx, TIRA_ARG_SYMBOL, spillHeadIdx, TIRA_ARG_LITERAL, 8
  tiraAssignId spillHeadIdx, TIRA_ARG_SYMBOL, osPtrIdx

  tiraOpId3 TC_ADD, TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_SYMBOL, osPtrIdx, TIRA_ARG_LITERAL, 8

  skipUpdateLblIdx = tiraLabelCreateNewId&("SKIP_HEAP_UPDATE")
  tiraJmpId skipUpdateLblIdx

  tiraLabelId skipUnderflowLblIdx
  tiraAssignId tempHeapIdx, TIRA_ARG_SYMBOL, dataPtrIdx
  tiraLabelId skipUpdateLblIdx

  ' Zero out the allocated memory block to prevent stale data contamination
  tiraMemSetId TIRA_ARG_SYMBOL, dataPtrIdx, TIRA_ARG_LITERAL, 0, TIRA_ARG_SYMBOL, paddedSizeIdx

  tiraAllocTempMemId& = dataPtrIdx

END FUNCTION ' tiraAllocTempMemId&

